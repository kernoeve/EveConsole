<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EveConsole</RootNamespace>
    <AssemblyName>EveConsole</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <Version>0.9.13</Version>
  </PropertyGroup>

  <!--
    ⚠️ Are we BUILDING FOR Windows? Not the same question as $(OS), which describes the
    machine running MSBuild. Cross-compiling a Linux artifact from a Windows box leaves
    $(OS) == Windows_NT, so conditioning on it put 198 MB of libvlc/win-x64 and win-x86
    binaries into the linux-x64 output — and would have dropped them from a Linux artifact
    built on Linux, so the two hosts disagreed about what they produced.

    The RuntimeIdentifier is the target. Empty means an ordinary local build, which follows
    the host.
  -->
  <PropertyGroup>
    <IsWindowsTarget Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOsPlatform('Windows'))</IsWindowsTarget>
    <IsWindowsTarget Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</IsWindowsTarget>
  </PropertyGroup>

  <!-- An .ico and a Win32 manifest mean nothing on Linux, and the SDK refuses the manifest
       outside a Windows build. Conditioned rather than deleted: the Windows release wants both. -->
  <PropertyGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <ApplicationIcon>Assets\ec.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- LibVLC's Windows binaries, and only for a Windows target. On Linux LibVLCSharp loads the
       system libvlc, so these are 198 MB of nothing. -->
  <ItemGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <!-- Avalonia's own colour picker, pinned to the same version as the rest of Avalonia.
         Added for the "Custom" option on ColorField; the curated palette covers the common
         cases and this covers everything else. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.2.3" />
    <PackageReference Include="KokoroSharp.CPU" Version="0.6.7" />
    <PackageReference Include="PiperSharp" Version="1.0.6" />

    <!-- MVVM / Reactive -->
    <PackageReference Include="ReactiveUI" Version="20.1.1" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />

    <!-- HTTP / JSON -->
    <PackageReference Include="System.Net.Http.Json" Version="9.0.0" />

    <!-- SQLite / EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- YAML (SDE parsing) -->
    <PackageReference Include="YamlDotNet" Version="15.1.2" />

    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />

    <!-- Audio playback for alarms and TTS.
         ⚠️ There is no VideoLAN.LibVLC.Linux on nuget — a comment here used to say to add
         one for Linux builds, and it has never existed. VideoLAN ships native packages for
         Windows, Android, iOS and macOS only; on Linux LibVLCSharp loads the system libvlc, so
         the distro package is the dependency (apt: libvlc-dev, or vlc). -->
    <PackageReference Include="LibVLCSharp" Version="3.9.1" />

    <!-- Cross-platform microphone recording (includes win-x64, linux-x64, osx runtimes) -->
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />

    <!-- Local Whisper STT.
         ⚠️ Whisper.net.Runtime.Linux does not exist either, and is not needed: the main
         runtime package already carries linux-x64, linux-arm and linux-arm64 natives. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />

    <!-- Charting -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.5" />
  </ItemGroup>

  <!-- Developer tooling lives under tools/ with its own project files. This csproj sits at the
       repo root and globs **/*.cs, so without these removals the tools would be compiled into
       the shipped application — a second Main, and code no user should ever receive. -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- ═══ Piper TTS binary — bundled at build time ══════════════════════════
       Downloads the Piper C++ binary from GitHub at developer build time.
       End users receive it as part of the normal application distribution
       and never download executable code at runtime.
       Only runs when piper.exe is not already present in the source tree.
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows'))">
    <Content Include="$(ProjectDir)Resources\piper\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>piper\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="DownloadPiperBinaryWindows" BeforeTargets="Build" Condition="$([MSBuild]::IsOsPlatform('Windows')) And !Exists('$(ProjectDir)Resources\piper\piper.exe')">
    <Message Text="[EveConsole] Downloading Piper TTS binary for Windows x64..." Importance="high" />
    <MakeDir Directories="$(ProjectDir)Resources\" />
    <Exec Command="powershell -NonInteractive -Command &quot;Invoke-WebRequest -Uri 'https://github.com/rhasspy/piper/releases/latest/download/piper_windows_amd64.zip' -OutFile '$(ProjectDir)Resources\piper_win_tmp.zip'&quot;" WorkingDirectory="$(ProjectDir)" ContinueOnError="true" />
    <Exec Command="powershell -NonInteractive -Command &quot;if (Test-Path '$(ProjectDir)Resources\piper_win_tmp.zip') { Expand-Archive -Path '$(ProjectDir)Resources\piper_win_tmp.zip' -DestinationPath '$(ProjectDir)Resources\' -Force; Remove-Item '$(ProjectDir)Resources\piper_win_tmp.zip' }&quot;" WorkingDirectory="$(ProjectDir)" ContinueOnError="true" />
    <Message Text="[EveConsole] Piper binary download complete." Importance="high" />
  </Target>

  <!-- ⚠️ The same binary, fetched the same way, for the other platform. Piper is a native
       executable rather than a nuget package, so each platform needs its own download; without
       this a Linux build has TTS code and nothing to run. ContinueOnError matches the Windows
       target: a failed download costs speech, not the build. -->
  <Target Name="DownloadPiperBinaryLinux" BeforeTargets="Build" Condition="$([MSBuild]::IsOsPlatform('Linux')) And !Exists('$(ProjectDir)Resources/piper/piper')">
    <Message Text="[EveConsole] Downloading Piper TTS binary for Linux x64..." Importance="high" />
    <MakeDir Directories="$(ProjectDir)Resources/" />
    <Exec Command="curl -fsSL -o '$(ProjectDir)Resources/piper_linux_tmp.tar.gz' https://github.com/rhasspy/piper/releases/latest/download/piper_linux_x86_64.tar.gz" WorkingDirectory="$(ProjectDir)" ContinueOnError="true" />
    <Exec Command="tar -xzf '$(ProjectDir)Resources/piper_linux_tmp.tar.gz' -C '$(ProjectDir)Resources/' &amp;&amp; rm -f '$(ProjectDir)Resources/piper_linux_tmp.tar.gz'" WorkingDirectory="$(ProjectDir)" ContinueOnError="true" />
    <Exec Command="chmod +x '$(ProjectDir)Resources/piper/piper'" WorkingDirectory="$(ProjectDir)" ContinueOnError="true" />
    <Message Text="[EveConsole] Piper binary download complete." Importance="high" />
  </Target>

</Project>
