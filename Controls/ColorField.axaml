<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EveConsole.Controls.ColorField">

  <Grid ColumnDefinitions="*,Auto">

    <!-- ⚠️ MinWidth, not just a star column. Three of these sit side by side in the posting
         dialog's by-state row, and a star column divides whatever is left — which was less than
         a seven-character hex value needs, so every one of them showed a truncated colour. The
         floor keeps the value readable however the dialog is squeezed. -->
    <TextBox x:Name="HexBox" Grid.Column="0" MinWidth="92"
             Watermark="#rrggbb"
             Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
             CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
             FontSize="12" Padding="8 5" />

    <!-- The swatch doubles as the preview: what is in the box, shown as the colour it is. A hex
         value is not something anyone can picture, and the whole point of this control is not
         having to leave the app to find out. -->
    <Button x:Name="PickButton" Grid.Column="1" Margin="6 0 0 0"
            Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
            CornerRadius="3" Padding="6 4" Cursor="Hand"
            ToolTip.Tip="Pick a colour">
      <Border x:Name="Preview" Width="28" Height="16" CornerRadius="2"
              Background="Transparent" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
      <Button.Flyout>
        <Flyout Placement="Bottom">
          <StackPanel Spacing="8" Width="228">
            <TextBlock Text="EVE MAIL COLOURS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <!-- Filled in code-behind: a fixed palette chosen to stay legible on EVE's dark mail
                 background, which is most of what makes a colour usable here. -->
            <WrapPanel x:Name="Swatches" />
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" x:Name="CustomButton" Content="Custom…"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                      BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                      Padding="6 3" FontSize="11" Cursor="Hand" Margin="0 0 3 0" />
              <Button Grid.Column="1" x:Name="ClearButton" Content="No colour"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                      Padding="6 3" FontSize="11" Cursor="Hand" Margin="3 0 0 0" />
            </Grid>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </Grid>
</UserControl>
