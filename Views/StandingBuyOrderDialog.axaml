<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.StandingBuyOrderDialog"
        Title="Standing Buy Order"
        Width="480" Height="470"
        MinWidth="480" MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="*,Auto" Margin="20">

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">

        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                   Text="Declare a buy order you intend to keep standing. EVE Console will report whether a matching live buy order exists at this location, and how much of it is left." />

        <!-- Item type -->
        <StackPanel Spacing="5">
          <TextBlock Text="ITEM TYPE" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <TextBox x:Name="ItemSearchBox"
                   Watermark="Search for item type…"
                   Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                   CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                   FontSize="12" Padding="8 5"
                   TextChanged="OnItemSearchChanged" />
          <Border x:Name="ItemResultsBorder"
                  Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3"
                  BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                  IsVisible="False" MaxHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ListBox x:Name="ItemResultsList"
                       Background="Transparent" BorderThickness="0"
                       SelectionChanged="OnItemSelected">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="10 5" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
          <TextBlock x:Name="ItemSelectedLabel" IsVisible="False"
                     FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Station / structure -->
        <StackPanel Spacing="5">
          <TextBlock Text="STATION / STRUCTURE" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <TextBox x:Name="StationSearchBox"
                   Watermark="Search for station or structure…"
                   Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                   CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                   FontSize="12" Padding="8 5"
                   TextChanged="OnStationSearchChanged" />
          <Border x:Name="StationResultsBorder"
                  Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3"
                  BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                  IsVisible="False" MaxHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ListBox x:Name="StationResultsList"
                       Background="Transparent" BorderThickness="0"
                       SelectionChanged="OnStationSelected">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="10 5" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
          <TextBlock x:Name="StationSelectedLabel" IsVisible="False"
                     FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
          <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                     Text="NPC stations, player structures and your corp's structures are all searchable." />
        </StackPanel>

        <TextBlock x:Name="ErrorLabel" IsVisible="False"
                   FontSize="11" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="10" Margin="0 16 0 0">
      <Button Content="Cancel" Click="OnCancel" Padding="18 6"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
      <Button x:Name="SaveButton" Content="Save" Click="OnSave" Padding="18 6"
              Background="{DynamicResource SurfaceHeaderBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource WarnSurfaceBrush}" BorderThickness="1" />
    </StackPanel>

  </Grid>
</Window>
