<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.CampaignsView"
             x:DataType="vm:CampaignsTabViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader"><Setter Property="FontSize" Value="10" /></Style>
    <Style Selector="TextBlock.running"><Setter Property="Foreground" Value="#DC2626" /></Style>
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="12 8" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Column="1" Text="{x:Static loc:MapText.CampaignsRegionLabel}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="12 0 8 0" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" MinWidth="180" FontSize="11" />
      </Grid>
    </Border>

    <!-- Fixed widths: a fill column pushes the ones after it off the grid once the tab is shown
         again. -->
    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" Background="{DynamicResource SurfaceBaseBrush}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{x:Static loc:MapText.ColCampaignState}" Width="90" SortMemberPath="Running" ClipboardContentBinding="{Binding State}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CampaignRowVm">
              <TextBlock Text="{Binding State}" VerticalAlignment="Center" Classes.running="{Binding Running}" FontWeight="SemiBold" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static loc:MapText.ColSystem}" Width="120" SortMemberPath="SystemLabel" ClipboardContentBinding="{Binding SystemLabel}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CampaignRowVm">
              <Button Classes="link" Command="{Binding OpenCommand}" ToolTip.Tip="{x:Static loc:MapText.TipOpenThisSystem}">
                <TextBlock Text="{Binding SystemLabel}" Classes="linktext" />
              </Button>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static loc:MapText.ColRegion}"         Binding="{Binding RegionLabel}" Width="140" />
        <DataGridTextColumn Header="{x:Static loc:MapText.ColCampaignWhen}"   Binding="{Binding When}"        Width="170" />
        <DataGridTextColumn Header="{x:Static loc:MapText.ColCampaignStart}"  Binding="{Binding Start}"       Width="300" />
        <DataGridTextColumn Header="{x:Static loc:MapText.ColCampaignKind}"   Binding="{Binding Kind}"        Width="150" />
        <DataGridTextColumn Header="{x:Static loc:MapText.ColCampaignDefender}" Binding="{Binding Defender}"  Width="200" />
        <DataGridTextColumn Header="{x:Static loc:MapText.ColCampaignScores}" Binding="{Binding Scores}"      Width="220" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
