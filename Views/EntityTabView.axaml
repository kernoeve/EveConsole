<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:svc="clr-namespace:EveConsole.Services"
             x:Class="EveConsole.Views.EntityTabView"
             x:DataType="vm:EntityTabViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14 12">

    <!-- Search. Nothing is listed until something is typed: there are 57,000 known
         characters, and an opening page of them would be noise. Unknown names fall
         through to an ESI search and are cached on the way back. -->
    <AutoCompleteBox Grid.Row="0"
                     Text="{Binding SearchText}"
                     SelectedItem="{Binding SelectedMatch}"
                     AsyncPopulator="{Binding Populator}"
                     ValueMemberBinding="{Binding Name}"
                     FilterMode="None"
                     MinimumPrefixLength="2"
                     MinimumPopulateDelay="0:0:0.35"
                     MaxDropDownHeight="320"
                     FontSize="12"
                     Watermark="Type at least two characters to search…">
      <AutoCompleteBox.ItemTemplate>
        <DataTemplate x:DataType="svc:EntityMatch">
          <Grid ColumnDefinitions="*,Auto" MinWidth="380">
            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5" Foreground="#ddd"/>
            <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="10" Foreground="#7a8896"
                       Margin="12 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="320"/>
          </Grid>
        </DataTemplate>
      </AutoCompleteBox.ItemTemplate>
    </AutoCompleteBox>

    <TextBlock Grid.Row="1" Text="{Binding SearchNote}" FontSize="10" Foreground="#aa7744"
               TextWrapping="Wrap" Margin="0 5 0 0"
               IsVisible="{Binding SearchNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <TextBlock Grid.Row="3" IsVisible="{Binding NoSelection}"
               Text="Search above and pick an entity to see its details."
               FontSize="12" Foreground="#555566"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

    <!-- ── General info: above the sub-tabs, so it stays visible on all of them ── -->
    <Border Grid.Row="2" IsVisible="{Binding HasSelection}"
            Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1" CornerRadius="4"
            Padding="12 10" Margin="0 8 0 0">
      <Grid ColumnDefinitions="Auto,*">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0 0 14 0" VerticalAlignment="Top">
          <Border Width="96" Height="96"
                  Background="#0d0d14" BorderBrush="#252530" BorderThickness="1" CornerRadius="3">
            <Image Source="{Binding Image}" Stretch="Uniform"/>
          </Border>

          <!-- Corp over alliance at half height, the same stack the killmail rows use. -->
          <StackPanel Margin="4 0 0 0" IsVisible="{Binding HasAffiliation}">
            <Border Width="46" Height="46" Background="#0d0d14" BorderBrush="#252530"
                    BorderThickness="1" CornerRadius="3" Margin="0 0 0 4">
              <Image Source="{Binding CorpLogo}" Stretch="Uniform"/>
            </Border>
            <Border Width="46" Height="46" Background="#0d0d14" BorderBrush="#252530"
                    BorderThickness="1" CornerRadius="3">
              <Image Source="{Binding AllianceLogo}" Stretch="Uniform"/>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Text="{Binding Name}"     FontSize="15" FontWeight="SemiBold" Foreground="#c8a84b"/>
          <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#7a8896" Margin="0 0 0 4"/>

          <!-- Facts wrap into columns so a tall list does not push the sub-tabs off screen. -->
          <ItemsControl ItemsSource="{Binding Facts}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="svc:EntityFact">
                <StackPanel Orientation="Horizontal" Width="300" Margin="0 2 14 2">
                  <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#666677"
                             Width="105" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Value}" FontSize="10" Foreground="#ccc"
                             IsVisible="{Binding IsPlain}"
                             TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                  <Button Content="{Binding Value}"
                          IsVisible="{Binding !IsPlain}"
                          Command="{Binding $parent[UserControl].((vm:EntityTabViewModel)DataContext).OpenFactCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          FontSize="10" Foreground="#c8a84b" Cursor="Hand"
                          HorizontalContentAlignment="Left" MaxWidth="190"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Sub-tabs ───────────────────────────────────────────────────────── -->
    <TabControl Grid.Row="3" IsVisible="{Binding HasSelection}" Margin="0 8 0 0"
                Padding="0" Background="Transparent">

      <!-- Multi-line, so it gets a tab of its own rather than crowding the header. -->
      <TabItem Header="Description" IsVisible="{Binding HasDescription}">
        <ScrollViewer Padding="6 10">
          <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#bbc"
                     TextWrapping="Wrap"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Kills / Losses" IsVisible="{Binding HasKills}">
        <Grid RowDefinitions="Auto,*" Margin="0 6">
          <TextBlock Grid.Row="0" Text="{Binding KillsStatus}" FontSize="10" Foreground="#555566"
                     Margin="4 0 0 6"/>
          <!-- The Killmail Browser's own row, from the shared template — same layout,
               ship render, logos and security colouring. -->
          <ListBox Grid.Row="1" ItemsSource="{Binding Kills}"
                   Background="Transparent" BorderThickness="0"
                   ItemTemplate="{StaticResource KillmailRowTemplate}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin"  Value="0" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#141420" />
              </Style>
            </ListBox.Styles>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding MembersHeader}" IsVisible="{Binding HasMembers}">
        <Grid RowDefinitions="Auto,*" Margin="4 6">
          <TextBlock Grid.Row="0" Text="{Binding MembersStatus}" FontSize="10" Foreground="#555566"
                     TextWrapping="Wrap" Margin="0 0 0 6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Members}" x:Name="MembersGrid"
                    IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                    Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent"
                    DoubleTapped="OnMemberDoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name"    Binding="{Binding Name}"     Width="320"/>
              <DataGridTextColumn Header="Details" Binding="{Binding Subtitle}" Width="*"/>
              <DataGridTextColumn Header="ID"      Binding="{Binding Id}"       Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding HistoryHeader}" IsVisible="{Binding HasHistory}">
        <Grid RowDefinitions="Auto,*" Margin="4 6">
          <TextBlock Grid.Row="0" Text="{Binding HistoryStatus}" FontSize="10" Foreground="#555566"
                     TextWrapping="Wrap" Margin="0 0 0 6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding History}"
                    IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                    Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent"
                    DoubleTapped="OnHistoryDoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{Binding $parent[UserControl].((vm:EntityTabViewModel)DataContext).HistoryEntityHeader}"
                                  Binding="{Binding Alliance}" Width="*"/>
              <DataGridTextColumn Header="From"     Binding="{Binding From}"     Width="130"/>
              <DataGridTextColumn Header="Until"    Binding="{Binding Until}"    Width="130"/>
              <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="130"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Stations" IsVisible="{Binding HasStations}">
        <Grid RowDefinitions="Auto,*" Margin="4 6">
          <TextBlock Grid.Row="0" Text="{Binding StationsStatus}" FontSize="10" Foreground="#555566" Margin="0 0 0 6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Stations}"
                    IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                    Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Station"  Binding="{Binding Name}"     Width="*"/>
              <DataGridTextColumn Header="System"   Binding="{Binding System}"   Width="130"/>
              <DataGridTextColumn Header="Region"   Binding="{Binding Region}"   Width="150"/>
              <DataGridTextColumn Header="Sec"      Binding="{Binding Security}" Width="60"/>
              <DataGridTextColumn Header="Agents"   Binding="{Binding Agents}"   Width="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="LP Offers" IsVisible="{Binding HasLpOffers}">
        <Grid RowDefinitions="Auto,*" Margin="4 6">
          <TextBlock Grid.Row="0" Text="{Binding LpOffersStatus}" FontSize="10" Foreground="#555566" Margin="0 0 0 6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding LpOffers}"
                    IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                    Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Item"     Binding="{Binding Item}"     Width="*"/>
              <DataGridTextColumn Header="Qty"      Binding="{Binding Quantity}" Width="80"/>
              <DataGridTextColumn Header="LP"       Binding="{Binding LpCost}"   Width="110"/>
              <DataGridTextColumn Header="ISK"      Binding="{Binding IskCost}"  Width="130"/>
              <DataGridTextColumn Header="Requires" Binding="{Binding Required}" Width="300"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Faction Warfare" IsVisible="{Binding HasWarfare}">
        <Grid RowDefinitions="Auto,*" Margin="4 6">
          <TextBlock Grid.Row="0" Text="{Binding WarfareStatus}" FontSize="10" Foreground="#555566" Margin="0 0 0 6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Warfare}"
                    IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                    Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="System"    Binding="{Binding System}"    Width="150"/>
              <DataGridTextColumn Header="Region"    Binding="{Binding Region}"    Width="170"/>
              <DataGridTextColumn Header="Role"      Binding="{Binding Role}"      Width="90"/>
              <DataGridTextColumn Header="Contested" Binding="{Binding Contested}" Width="110"/>
              <DataGridTextColumn Header="Points"    Binding="{Binding Points}"    Width="90"/>
              <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Intel Reports" IsVisible="{Binding HasIntel}">
        <Grid RowDefinitions="Auto,*" Margin="4 6">
          <TextBlock Grid.Row="0" Text="{Binding IntelStatus}" FontSize="10" Foreground="#555566"
                     TextWrapping="Wrap" Margin="0 0 0 6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Intel}"
                    IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                    Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="When"     Binding="{Binding When}"     Width="130"/>
              <DataGridTextColumn Header="System"   Binding="{Binding System}"   Width="130"/>
              <DataGridTextColumn Header="Ship"     Binding="{Binding Ship}"     Width="160"/>
              <DataGridTextColumn Header="Channel"  Binding="{Binding Channel}"  Width="140"/>
              <DataGridTextColumn Header="Reporter" Binding="{Binding Reporter}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
