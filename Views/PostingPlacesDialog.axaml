<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="using:EveConsole.ViewModels"
        x:Class="EveConsole.Views.PostingPlacesDialog"
        x:DataType="vm:PostingPlacesViewModel"
        Title="{x:Static loc:SalesText.PlacesTitle}"
        Width="900" Height="620" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <!-- Where a posting's items come from: any step of the tree — a station, an owner there, a
       hangar or division, a container at any depth — added to the list on the right. The posting
       lists whatever those places hold whenever it is rendered. -->
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto,*" Margin="16">

    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{x:Static loc:SalesText.PlacesNote}" FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextDimBrush}" Margin="0 0 0 10" />

    <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBox Text="{Binding Filter}" Watermark="{x:Static loc:SalesText.PlacesFilterWatermark}" FontSize="11" Margin="6"
                 Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />
        <TreeView Grid.Row="1" ItemsSource="{Binding Nodes}" SelectedItem="{Binding Selected}" DoubleTapped="OnTreeDoubleTapped"
                  Background="{DynamicResource SurfacePanelBrush}" FontSize="11">
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:PlaceNodeVm">
              <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" />
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="11" Margin="8 6"
                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
    </Border>

    <Button Grid.Row="1" Grid.Column="1" Command="{Binding AddCommand}" Content="{x:Static loc:SalesText.PlacesAdd}"
            VerticalAlignment="Center" Margin="10 0"
            Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource GoodBrush}"
            BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1" Padding="12 4" FontSize="11" />

    <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="{x:Static loc:SalesText.PlacesChosen}" FontSize="11" FontWeight="SemiBold" Margin="8 6"
                   Foreground="{DynamicResource AccentBrush}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Chosen}" Margin="6 0 6 6">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlaceChoiceVm">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 2">
                  <TextBlock Text="{Binding Path}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <Button Grid.Column="1" Click="OnUp" Content="▲" ToolTip.Tip="{x:Static loc:SalesText.MoveUp}" Margin="6 0 0 0"
                          Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextMutedBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="6 1" FontSize="10" />
                  <Button Grid.Column="2" Click="OnDown" Content="▼" ToolTip.Tip="{x:Static loc:SalesText.MoveDown}" Margin="4 0 0 0"
                          Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextMutedBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="6 1" FontSize="10" />
                  <Button Grid.Column="3" Click="OnRemove" Content="{x:Static loc:SalesText.Remove}" Margin="4 0 0 0"
                          Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                          BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1" Padding="6 1" FontSize="10" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 12 0 0">
      <Button Click="OnCancel" Content="{x:Static loc:CommonText.Cancel}"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="14 4" FontSize="11" />
      <Button Click="OnSave" Content="{x:Static loc:SalesText.PlacesSave}"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1" Padding="14 4" FontSize="11" />
    </StackPanel>
  </Grid>
</Window>
