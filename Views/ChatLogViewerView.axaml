<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.ChatLogViewerView"
             x:DataType="vm:ChatLogViewerViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="TextBlock.fl">
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelAltBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="10 6" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Chat Log" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="fl" Text="From" />
          <TextBox Text="{Binding DateFrom}" Watermark="yyyy-MM-dd" Width="120" />
          <TextBlock Classes="fl" Text="Thru" />
          <TextBox Text="{Binding DateThru}" Watermark="(now)" Width="120" />
          <TextBlock Classes="fl" Text="Find" />
          <TextBox Text="{Binding Search}" Watermark="sender or text…" Width="190" />
          <CheckBox IsChecked="{Binding HideSystemMessages}" Content="Hide system" FontSize="11"
                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <Button Command="{Binding RefreshCommand}" Content="Refresh" FontSize="10" Padding="8 2"
                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="240,4,*">

      <!-- Channels with activity in the selected window -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceBaseBrush}">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="{Binding ChannelStatus}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                     Margin="10 8 10 4" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Channels}"
                   SelectedItem="{Binding SelectedChannel}"
                   Background="Transparent" BorderThickness="0" FontSize="11">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatChannelRowVm">
                <TextBlock Text="{Binding Display}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Rectangle Grid.Column="1" Fill="{DynamicResource SurfaceHoverBrush}" />

      <DataGrid Grid.Column="2" ItemsSource="{Binding Rows}"
                AutoGenerateColumns="False" IsReadOnly="True" RowHeight="22"
                CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                Background="{DynamicResource SurfaceBaseBrush}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time"     Binding="{Binding Time}"     Width="145" />
          <DataGridTextColumn Header="Sender"   Binding="{Binding Sender}"   Width="170" />
          <DataGridTextColumn Header="Message"  Binding="{Binding Message}"  Width="*"   />
          <DataGridTextColumn Header="Listener" Binding="{Binding Listener}" Width="140" />
        </DataGrid.Columns>
      </DataGrid>

    </Grid>
  </Grid>
</UserControl>
