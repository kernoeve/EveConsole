<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:m="clr-namespace:EveConsole.Models"
             x:Class="EveConsole.Views.CorpStructuresView"
             x:DataType="vm:CorpStructuresViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader"><Setter Property="FontSize" Value="10" /></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="4 0" /></Style>

    <!-- Running low, then critical or out: the status colours, on the fuel figures only. -->
    <Style Selector="TextBlock.soon">     <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></Style>
    <Style Selector="TextBlock.critical"> <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                                          <Setter Property="FontWeight" Value="SemiBold" /></Style>

    <!-- A section of the detail panel: a header strip over a panel. -->
    <Style Selector="Border.section">
      <Setter Property="Background"      Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius"    Value="4" />
      <Setter Property="ClipToBounds"    Value="True" />
    </Style>
    <Style Selector="Border.sectionHead">
      <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}" />
      <Setter Property="Padding"    Value="10 5" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize"   Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize"   Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize"     Value="11" />
      <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize"     Value="10" />
      <Setter Property="Foreground"   Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <Grid ColumnDefinitions="Auto,8,Auto,16,Auto,12,Auto,Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{x:Static loc:CorpText.CorporationLabel}" FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding Corps}" SelectedItem="{Binding SelectedCorp}"
                  Width="220" FontSize="11">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:Corporation">
              <TextBlock Text="{Binding Name}" FontSize="11" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Grid.Column="4" Text="{Binding Search}" Width="220" FontSize="11"
                 Watermark="{x:Static loc:CorpText.CsSearchHint}" />
        <CheckBox Grid.Column="6" IsChecked="{Binding ShowUpwell}" Content="{x:Static loc:CorpText.CsShowUpwell}"
                  FontSize="11" Margin="0 0 12 0" />
        <CheckBox Grid.Column="7" IsChecked="{Binding ShowTowers}" Content="{x:Static loc:CorpText.CsShowTowers}"
                  FontSize="11" />
        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="12" Margin="16 0 0 0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding Status}"  FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
        </StackPanel>
        <Button Grid.Column="9" Command="{Binding RefreshCommand}" Content="{x:Static loc:CorpText.Refresh}"
                Padding="12 4" FontSize="11" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,5,460">

      <!-- ── The list ─────────────────────────────────────────────── -->
      <!-- Fixed widths: a fill column pushes the ones after it off the grid once the tab is shown
           again. Templated columns name their clipboard text — they copy blank otherwise. -->
      <DataGrid Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                IsVisible="{Binding HasRows}" AutoGenerateColumns="False" IsReadOnly="True"
                RowHeight="26" CanUserReorderColumns="False" SelectionMode="Single"
                Background="{DynamicResource SurfaceBaseBrush}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="30" CanUserSort="False" ClipboardContentBinding="{Binding TypeName}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:CorpStructureRowVm">
                <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{x:Static loc:CorpText.CsColName}"     Binding="{Binding Name}"         Width="260" />
          <DataGridTextColumn Header="{x:Static loc:CorpText.CsColType}"     Binding="{Binding TypeName}"     Width="150" />
          <DataGridTextColumn Header="{x:Static loc:CorpText.CsColSystem}"   Binding="{Binding Location}"     Width="120" SortMemberPath="Location" />
          <DataGridTextColumn Header="{x:Static loc:CorpText.CsColRegion}"   Binding="{Binding Region}"       Width="120" />
          <DataGridTextColumn Header="{x:Static loc:CorpText.CsColState}"    Binding="{Binding StateText}"    Width="130" />
          <DataGridTextColumn Header="{x:Static loc:CorpText.CsColServices}" Binding="{Binding ServicesText}" Width="70" />
          <DataGridTemplateColumn Header="{x:Static loc:CorpText.CsColFuelLeft}" Width="110"
                                  SortMemberPath="RunsOutSort" ClipboardContentBinding="{Binding FuelLeft}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:CorpStructureRowVm">
                <TextBlock Text="{Binding FuelLeft}" VerticalAlignment="Center"
                           Classes.soon="{Binding IsSoon}" Classes.critical="{Binding IsCritical}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{x:Static loc:CorpText.CsColRunsOut}"  Binding="{Binding RunsOutText}"  Width="130" SortMemberPath="RunsOutSort" />
          <DataGridTextColumn Header="{x:Static loc:CorpText.CsColBlocksPerDay}" Binding="{Binding PerDay}"       Width="90"  SortMemberPath="PerDaySort" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Column="0" Text="{Binding EmptyText}" IsVisible="{Binding !HasRows}"
                 FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />

      <GridSplitter Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}" ResizeDirection="Columns" />

      <!-- ── The chosen structure ─────────────────────────────────── -->
      <ScrollViewer Grid.Column="2" Background="{DynamicResource SurfaceBaseBrush}">
        <StackPanel Margin="12" Spacing="10" IsVisible="{Binding HasDetail}">

          <Grid ColumnDefinitions="Auto,12,*">
            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="4" ClipToBounds="True"
                    Background="{DynamicResource SurfacePanelBrush}">
              <Image Source="{Binding DetailRender}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
              <SelectableTextBlock Text="{Binding DetailTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrightBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DetailSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Grid>

          <!-- Status: state, fuel, timers. -->
          <Border Classes="section">
            <StackPanel>
              <Border Classes="sectionHead"><TextBlock Classes="sectionTitle" Text="{x:Static loc:CorpText.CsSectionStatus}" /></Border>
              <ItemsControl ItemsSource="{Binding StatusFields}" Margin="10 6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CorpStructureField">
                    <Grid ColumnDefinitions="140,*" Margin="0 2">
                      <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}"
                                 Classes.soon="{Binding IsSoon}" Classes.critical="{Binding IsCritical}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Fuel: each fuel in the bay, its burn and when it runs out. -->
          <Border Classes="section">
            <StackPanel>
              <Border Classes="sectionHead"><TextBlock Classes="sectionTitle" Text="{x:Static loc:CorpText.CsSectionFuel}" /></Border>
              <StackPanel Margin="10 6" Spacing="4">
                <Grid ColumnDefinitions="22,*,70,64,80" IsVisible="{Binding HasFuel}">
                  <TextBlock Grid.Column="1" Classes="note" Text="{x:Static loc:CorpText.CsColFuel}" />
                  <TextBlock Grid.Column="2" Classes="note" Text="{x:Static loc:CorpText.CsColOnHand}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Classes="note" Text="{x:Static loc:CorpText.CsColPerDay}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Classes="note" Text="{x:Static loc:CorpText.CsColLasts}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding FuelRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CorpFuelRowVm">
                      <StackPanel Margin="0 2">
                        <Grid ColumnDefinitions="22,*,70,64,80">
                          <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Left" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding Name}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="value" Text="{Binding OnHand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Classes="value" Text="{Binding PerDay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Classes="value" Text="{Binding Lasts}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Classes.soon="{Binding IsSoon}" Classes.critical="{Binding IsCritical}" />
                        </Grid>
                        <TextBlock Classes="note" Margin="22 0 0 0">
                          <Run Text="{Binding RunsOut}" />
                          <Run Text="  " />
                          <Run Text="{Binding Source}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="note" Text="{Binding FuelNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Services, each with its state. -->
          <Border Classes="section" IsVisible="{Binding HasServices}">
            <StackPanel>
              <Border Classes="sectionHead"><TextBlock Classes="sectionTitle" Text="{x:Static loc:CorpText.CsSectionServices}" /></Border>
              <ItemsControl ItemsSource="{Binding Services}" Margin="10 6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CorpServiceVm">
                    <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                      <TextBlock Grid.Column="0" Classes="value" Text="{Binding Name}" />
                      <Border Grid.Column="1" CornerRadius="3" Padding="7 1"
                              Background="{DynamicResource GoodSurfaceBrush}" IsVisible="{Binding IsOnline}">
                        <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" />
                      </Border>
                      <Border Grid.Column="1" CornerRadius="3" Padding="7 1"
                              Background="{DynamicResource BadSurfaceBrush}" IsVisible="{Binding !IsOnline}">
                        <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Fit, band by band. -->
          <Border Classes="section">
            <StackPanel>
              <Border Classes="sectionHead"><TextBlock Classes="sectionTitle" Text="{x:Static loc:CorpText.CsSectionFit}" /></Border>
              <StackPanel Margin="10 6" Spacing="6">
                <ItemsControl ItemsSource="{Binding FitGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CorpFitGroupVm">
                      <StackPanel Margin="0 0 0 6">
                        <TextBlock Classes="label" Text="{Binding Title}" FontWeight="SemiBold" Margin="0 0 0 2" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CorpFitItemVm">
                              <Grid ColumnDefinitions="22,*,Auto" Margin="0 1">
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding Name}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                  <TextBlock Classes="note" Text="{x:Static loc:CorpText.CsByHand}" IsVisible="{Binding ByHand}" />
                                  <TextBlock Classes="value" Text="{Binding Quantity}" IsVisible="{Binding HasQuantity}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="note" Text="{Binding FitNote}" IsVisible="{Binding HasFitNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Moon drilling: the extraction, and what a Metenox holds. -->
          <Border Classes="section" IsVisible="{Binding HasMoon}">
            <StackPanel>
              <Border Classes="sectionHead"><TextBlock Classes="sectionTitle" Text="{x:Static loc:CorpText.CsSectionMoon}" /></Border>
              <StackPanel Margin="10 6" Spacing="4">
                <ItemsControl ItemsSource="{Binding MoonFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CorpStructureField">
                      <Grid ColumnDefinitions="140,*" Margin="0 2">
                        <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding MoonBay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CorpFitItemVm">
                      <Grid ColumnDefinitions="22,*,Auto" Margin="0 1">
                        <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding Quantity}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- A tower's settings. -->
          <Border Classes="section" IsVisible="{Binding HasTower}">
            <StackPanel>
              <Border Classes="sectionHead"><TextBlock Classes="sectionTitle" Text="{x:Static loc:CorpText.CsSectionTower}" /></Border>
              <StackPanel Margin="10 6">
                <ItemsControl ItemsSource="{Binding TowerFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CorpStructureField">
                      <Grid ColumnDefinitions="200,*" Margin="0 2">
                        <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="note" Text="{x:Static loc:CorpText.CsTowerSettingsNone}"
                           IsVisible="{Binding !HasTowerSettings}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Where it is. -->
          <Border Classes="section">
            <StackPanel>
              <Border Classes="sectionHead"><TextBlock Classes="sectionTitle" Text="{x:Static loc:CorpText.CsSectionLocation}" /></Border>
              <ItemsControl ItemsSource="{Binding LocationFields}" Margin="10 6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CorpStructureField">
                    <Grid ColumnDefinitions="140,*" Margin="0 2">
                      <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
