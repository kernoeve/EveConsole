<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.ConfirmDialog"
        Width="420"
        MinWidth="340"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d12"
        CanResize="False"
        SizeToContent="Height">

  <Grid RowDefinitions="*,Auto,Auto">

    <TextBlock Grid.Row="0"
               x:Name="MessageText"
               TextWrapping="Wrap"
               Foreground="#ccc"
               FontSize="13"
               Margin="20 20 20 16" />

    <!-- Hidden unless the caller asked for a typed confirmation. -->
    <StackPanel Grid.Row="1" x:Name="ConfirmPanel" IsVisible="False"
                Margin="20 0 20 12" Spacing="4">
      <TextBlock x:Name="ConfirmPrompt" Foreground="#cc7766" FontSize="12" TextWrapping="Wrap" />
      <TextBox   x:Name="ConfirmBox" FontSize="13" />
    </StackPanel>

    <Border Grid.Row="2" Background="#0d0d12" Padding="16 12">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button Content="No"  Click="OnNo"  Padding="20 5" />
        <Button Content="Yes" Click="OnYes" Padding="20 5" x:Name="YesButton" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
