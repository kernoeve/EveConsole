<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.ExternalLinkDialog"
        Title="Open in browser?"
        Width="460"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}"
        CanResize="False"
        SizeToContent="Height">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto">

    <TextBlock Grid.Row="0"
               Text="This link opens a website in your browser."
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextPrimaryBrush}"
               FontSize="13"
               Margin="20 20 20 10" />

    <!-- The address itself, selectable so it can be checked or copied before anything opens.
         Word-wrapped rather than trimmed: a deceptive link hides its real host past the part
         that fits, and the end of the address is exactly the part worth seeing. -->
    <Border Grid.Row="1"
            Background="{DynamicResource SurfaceHoverBrush}"
            CornerRadius="3"
            Padding="10 8"
            Margin="20 0 20 14">
      <SelectableTextBlock x:Name="UrlText"
                           TextWrapping="Wrap"
                           FontFamily="Consolas, Menlo, monospace"
                           FontSize="12"
                           Foreground="{DynamicResource TextBrightBrush}" />
    </Border>

    <CheckBox Grid.Row="2"
              x:Name="DontAskBox"
              Content="Don't ask me again"
              FontSize="12"
              Margin="20 0 20 14" />

    <Border Grid.Row="3" Background="{DynamicResource SurfaceBaseBrush}" Padding="16 12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Cancel" Click="OnCancel" Padding="20 5" IsCancel="True" />
        <Button Content="Open"   Click="OnOpen"   Padding="20 5" IsDefault="True" x:Name="OpenButton" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
