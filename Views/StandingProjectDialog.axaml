<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        x:Class="EveConsole.Views.StandingProjectDialog"
        Title="{x:Static loc:CorpText.TitleStandingProject}"
        Width="480" Height="520"
        MinWidth="480" MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="*,Auto" Margin="20">

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">

        <!-- Project Type -->
        <StackPanel Spacing="5">
          <TextBlock Text="{x:Static loc:CorpText.ProjectTypeLabel}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <ComboBox x:Name="TypeCombo"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    FontSize="12" HorizontalAlignment="Stretch"
                    SelectionChanged="OnTypeChanged">
            <ComboBoxItem Content="{x:Static loc:CorpText.DeliverItem}" Tag="deliver_item" />
            <ComboBoxItem Content="{x:Static loc:CorpText.DestroyNpc}"  Tag="destroy_npc" />
          </ComboBox>
        </StackPanel>

        <!-- ── Deliver Item panel ───────────────────────────────── -->
        <StackPanel x:Name="DeliverPanel" Spacing="12">

          <StackPanel Spacing="5">
            <TextBlock Text="{x:Static loc:CorpText.ItemTypeLabel}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <TextBox x:Name="ItemSearchBox"
                     Watermark="{x:Static loc:CorpText.HintSearchForItemType}"
                     Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                     CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="12" Padding="8 5"
                     TextChanged="OnItemSearchChanged" />
            <Border x:Name="ItemResultsBorder"
                    Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    IsVisible="False" MaxHeight="160">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="ItemResultsList"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnItemSelected">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="10 5" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Border>
            <TextBlock x:Name="ItemSelectedLabel"
                       FontSize="11" Foreground="{DynamicResource GoodBrush}" IsVisible="False" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="{x:Static loc:CorpText.DestinationStationStructureLabel}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <TextBox x:Name="StationSearchBox"
                     Watermark="{x:Static loc:CorpText.HintSearchForStationOrStructure}"
                     Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                     CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="12" Padding="8 5"
                     TextChanged="OnStationSearchChanged" />
            <Border x:Name="StationResultsBorder"
                    Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    IsVisible="False" MaxHeight="160">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="StationResultsList"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnStationSelected">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="10 5" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Border>
            <TextBlock x:Name="StationSelectedLabel"
                       FontSize="11" Foreground="{DynamicResource GoodBrush}" IsVisible="False" />
          </StackPanel>

        </StackPanel>

        <!-- ── Destroy NPC panel ──────────────────────────────── -->
        <StackPanel x:Name="DestroyPanel" Spacing="12" IsVisible="False">

          <!-- Scope selector -->
          <StackPanel Spacing="5">
            <TextBlock Text="{x:Static loc:CorpText.ScopeLabel}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <StackPanel Spacing="4">
              <RadioButton x:Name="ScopeSystem" Content="{x:Static loc:CorpText.SpecificSystem}"
                           GroupName="Scope" IsChecked="True"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                           Checked="OnScopeChanged" />
              <RadioButton x:Name="ScopeRegionAdm" Content="{x:Static loc:CorpText.AllSystemsInA}"
                           GroupName="Scope"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                           Checked="OnScopeChanged" />
              <RadioButton x:Name="ScopeConstAdm" Content="{x:Static loc:CorpText.AllSystemsInA2}"
                           GroupName="Scope"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                           Checked="OnScopeChanged" />
              <RadioButton x:Name="ScopeAllianceSov" Content="{x:Static loc:CorpText.AllSystemsWhereAn}"
                           GroupName="Scope"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                           Checked="OnScopeChanged" />
            </StackPanel>
          </StackPanel>

          <!-- Specific System -->
          <StackPanel x:Name="SystemPanel" Spacing="5">
            <TextBlock Text="{x:Static loc:CorpText.SolarSystemLabel}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <TextBox x:Name="SystemSearchBox"
                     Watermark="{x:Static loc:CorpText.HintSearchForSolarSystem}"
                     Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                     CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="12" Padding="8 5"
                     TextChanged="OnSystemSearchChanged" />
            <Border x:Name="SystemResultsBorder"
                    Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    IsVisible="False" MaxHeight="130">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="SystemResultsList"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnSystemSelected">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="10 5" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Border>
            <TextBlock x:Name="SystemSelectedLabel"
                       FontSize="11" Foreground="{DynamicResource GoodBrush}" IsVisible="False" />
          </StackPanel>

          <!-- Region ADM -->
          <StackPanel x:Name="RegionPanel" Spacing="5" IsVisible="False">
            <TextBlock Text="{x:Static loc:CorpText.RegionLabel}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <TextBox x:Name="RegionSearchBox"
                     Watermark="{x:Static loc:CorpText.HintSearchForRegion}"
                     Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                     CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="12" Padding="8 5"
                     TextChanged="OnRegionSearchChanged" />
            <Border x:Name="RegionResultsBorder"
                    Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    IsVisible="False" MaxHeight="130">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="RegionResultsList"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnRegionSelected">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="10 5" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Border>
            <TextBlock x:Name="RegionSelectedLabel"
                       FontSize="11" Foreground="{DynamicResource GoodBrush}" IsVisible="False" />
            <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0">
              <TextBlock Grid.Column="0" Text="{x:Static loc:CorpText.MinAdmLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" Margin="0 0 10 0" />
              <NumericUpDown x:Name="RegionAdmBox"
                             Grid.Column="1"
                             Value="4.0" Minimum="0" Maximum="6" Increment="0.5"
                             FormatString="F1"
                             ShowButtonSpinner="True"
                             FontSize="12"
                             Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
          </StackPanel>

          <!-- Constellation ADM -->
          <StackPanel x:Name="ConstPanel" Spacing="5" IsVisible="False">
            <TextBlock Text="{x:Static loc:CorpText.ConstellationLabel}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <TextBox x:Name="ConstSearchBox"
                     Watermark="{x:Static loc:CorpText.HintSearchForConstellation}"
                     Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                     CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="12" Padding="8 5"
                     TextChanged="OnConstSearchChanged" />
            <Border x:Name="ConstResultsBorder"
                    Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    IsVisible="False" MaxHeight="130">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="ConstResultsList"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnConstSelected">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="10 5" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Border>
            <TextBlock x:Name="ConstSelectedLabel"
                       FontSize="11" Foreground="{DynamicResource GoodBrush}" IsVisible="False" />
            <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0">
              <TextBlock Grid.Column="0" Text="{x:Static loc:CorpText.MinAdmLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" Margin="0 0 10 0" />
              <NumericUpDown x:Name="ConstAdmBox"
                             Grid.Column="1"
                             Value="4.0" Minimum="0" Maximum="6" Increment="0.5"
                             FormatString="F1"
                             ShowButtonSpinner="True"
                             FontSize="12"
                             Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
          </StackPanel>

          <!-- Alliance sovereignty. Same min-ADM rule as the region and constellation scopes:
               the alliance chooses WHICH systems are in scope, the ADM chooses which of those
               currently need something doing. -->
          <StackPanel x:Name="AlliancePanel" Spacing="5" IsVisible="False">
            <TextBlock Text="{x:Static loc:CorpText.AllianceLabel}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <ComboBox x:Name="AllianceCombo"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
            <TextBlock x:Name="AllianceEmptyLabel"
                       Text="{x:Static loc:CorpText.NoAllianceFoundOnNote}"
                       FontSize="11" Foreground="{DynamicResource WarnBrush}" IsVisible="False" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0">
              <TextBlock Grid.Column="0" Text="{x:Static loc:CorpText.MinAdmLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" Margin="0 0 10 0" />
              <NumericUpDown x:Name="AllianceAdmBox"
                             Grid.Column="1"
                             Value="4.0" Minimum="0" Maximum="6" Increment="0.5"
                             FormatString="F1"
                             ShowButtonSpinner="True"
                             FontSize="12"
                             Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
            <TextBlock Text="{x:Static loc:CorpText.EverySystemThisAllianceNote}"
                       FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0 2 0 0" />
          </StackPanel>

        </StackPanel>

        <!-- Validation hint -->
        <TextBlock x:Name="ValidationHint"
                   FontSize="11" Foreground="{DynamicResource BadBrush}"
                   IsVisible="False" />

      </StackPanel>
    </ScrollViewer>

    <!-- Buttons -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,8,Auto" Margin="0 16 0 0">
      <Button Grid.Column="1" x:Name="CancelButton"
              Content="{x:Static loc:CorpText.Cancel}"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              Padding="18 6" FontSize="12"
              Click="OnCancelClick" />
      <Button Grid.Column="3" x:Name="SaveButton"
              Content="{x:Static loc:CorpText.Save}"
              Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
              BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1"
              Padding="18 6" FontSize="12"
              Click="OnSaveClick" />
    </Grid>

  </Grid>
</Window>
