<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.OverviewCustomizeWindow"
        x:DataType="vm:OverviewCustomizeViewModel"
        Title="Customize Overview" Width="820" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d12">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="Overview Layout" FontSize="15" FontWeight="SemiBold"
               Foreground="#c8a84b" Margin="0 0 0 4" />

    <!-- Grid size -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0 8 0 12"
                VerticalAlignment="Center">
      <TextBlock Text="Grid size —" Foreground="#aaaacc" VerticalAlignment="Center" FontSize="12" />
      <TextBlock Text="Rows" Foreground="#888899" VerticalAlignment="Center" FontSize="12" />
      <NumericUpDown Value="{Binding Rows}" Minimum="1" Maximum="12" Increment="1"
                     FormatString="0" Width="110" />
      <TextBlock Text="Columns" Foreground="#888899" VerticalAlignment="Center" FontSize="12" />
      <NumericUpDown Value="{Binding Cols}" Minimum="1" Maximum="12" Increment="1"
                     FormatString="0" Width="110" />
    </StackPanel>

    <!-- Body: section palette (left) + grid preview (right) -->
    <Grid Grid.Row="2" ColumnDefinitions="190,12,*">

      <!-- Palette of sections not yet on the grid -->
      <Border Grid.Column="0" BorderBrush="#1e1e2a" BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Sections" FontSize="12" FontWeight="SemiBold"
                     Foreground="#888899" Margin="0 0 0 8" />
          <TextBlock DockPanel.Dock="Bottom" Text="Drag a section onto the grid to add it."
                     FontSize="10" Foreground="#556" TextWrapping="Wrap" Margin="0 8 0 0" />
          <ItemsControl x:Name="Palette" ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OverviewSectionEditVm">
                <Border IsVisible="{Binding !Enabled}"
                        Background="#161622" BorderBrush="#2a2a3a" BorderThickness="1"
                        CornerRadius="3" Padding="10 8" Margin="0 0 0 6"
                        Cursor="Hand" PointerPressed="OnPalettePressed">
                  <TextBlock Text="{Binding Title}" Foreground="#ccccdd" FontSize="12" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- Grid preview / editor (rendered in code-behind) -->
      <Border Grid.Column="2" BorderBrush="#1e1e2a" BorderThickness="1" CornerRadius="4"
              Padding="6" Background="#0a0a0e">
        <Canvas x:Name="EditorCanvas" Background="Transparent" ClipToBounds="True" />
      </Border>

    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0 12 0 0">
      <Button Content="Cancel" Click="OnCancel"
              FontSize="12" Padding="14 6"
              Background="#1a1a28" Foreground="#ccccdd" BorderBrush="#2a2a3a" BorderThickness="1" />
      <Button Content="Apply" Click="OnApply"
              FontSize="12" Padding="14 6"
              Background="#2a2210" Foreground="#c8a84b" BorderBrush="#3a2c10" BorderThickness="1" />
    </StackPanel>

  </Grid>
</Window>
