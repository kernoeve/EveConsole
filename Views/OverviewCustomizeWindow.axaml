<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.OverviewCustomizeWindow"
        x:DataType="vm:OverviewCustomizeViewModel"
        Title="{x:Static loc:OverviewText.TitleCustomizeOverview}" Width="820" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="{x:Static loc:OverviewText.OverviewLayout}" FontSize="15" FontWeight="SemiBold"
               Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 4" />

    <!-- Which layout is being edited, its name, and Add and Delete. Its own DataContext, set in code:
         the rest of the window is the chosen layout's grid. -->
    <StackPanel Grid.Row="1" x:Name="LayoutBar" x:DataType="vm:OverviewLayoutsEditVm" Orientation="Horizontal" Spacing="8" Margin="0 8 0 0">
      <TextBlock Text="{x:Static loc:OverviewText.LayoutLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12" />
      <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding Selected}" MinWidth="180" FontSize="12">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OverviewLayoutEntryVm">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{x:Static loc:OverviewText.LayoutName}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="12" Margin="8 0 0 0" />
      <TextBox Text="{Binding Selected.Name}" IsEnabled="{Binding !Selected.IsDefault}" Width="180" FontSize="12" />
      <Button Content="{x:Static loc:OverviewText.LayoutAdd}" Command="{Binding AddCommand}" FontSize="12" Padding="12 4"
              ToolTip.Tip="{x:Static loc:OverviewText.TipLayoutAdd}" />
      <Button Content="{x:Static loc:OverviewText.LayoutDelete}" Command="{Binding DeleteCommand}" FontSize="12" Padding="12 4" />
    </StackPanel>

    <!-- Grid size -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0 8 0 12"
                VerticalAlignment="Center">
      <TextBlock Text="{x:Static loc:OverviewText.GridSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12" />
      <TextBlock Text="{x:Static loc:OverviewText.Rows}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="12" />
      <NumericUpDown Value="{Binding Rows}" Minimum="1" Maximum="25" Increment="1"
                     FormatString="0" Width="110" />
      <TextBlock Text="{x:Static loc:OverviewText.Columns}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="12" />
      <NumericUpDown Value="{Binding Cols}" Minimum="1" Maximum="25" Increment="1"
                     FormatString="0" Width="110" />
    </StackPanel>

    <!-- Body: section palette (left) + grid preview (right) -->
    <Grid Grid.Row="3" ColumnDefinitions="190,12,*">

      <!-- Palette of sections not yet on the grid -->
      <Border Grid.Column="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:OverviewText.Sections}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0 0 0 8" />
          <TextBlock DockPanel.Dock="Bottom" Text="{x:Static loc:OverviewText.DragASectionOntoNote}"
                     FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0 8 0 0" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Palette" ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverviewSectionEditVm">
                  <Border IsVisible="{Binding !Enabled}"
                          Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                          CornerRadius="3" Padding="10 8" Margin="0 0 0 6"
                          Cursor="Hand" PointerPressed="OnPalettePressed">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Grid preview / editor (rendered in code-behind) -->
      <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"
              Padding="6" Background="{DynamicResource SurfaceBaseBrush}">
        <Canvas x:Name="EditorCanvas" Background="Transparent" ClipToBounds="True" />
      </Border>

    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0 12 0 0">
      <Button Content="{x:Static loc:OverviewText.Cancel}" Click="OnCancel"
              FontSize="12" Padding="14 6"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
      <Button Content="{x:Static loc:OverviewText.Apply}" Click="OnApply"
              FontSize="12" Padding="14 6"
              Background="{DynamicResource WarnSurfaceBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1" />
    </StackPanel>

  </Grid>
</Window>
