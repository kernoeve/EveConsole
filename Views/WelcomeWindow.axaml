<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:views="using:EveConsole.Views"
        x:Class="EveConsole.Views.WelcomeWindow"
        Title="{x:Static loc:ShellText.TitleWelcomeToEveConsole}"
        Icon="avares://EveConsole/Assets/ec.ico"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <StackPanel Margin="36 30 36 26" Spacing="0">

    <!-- Two-tone app name, wherever the language puts it (see WelcomeWindow.axaml.cs).
         ⚠️ The runs on one line, touching: a line break between them is drawn as a space. -->
    <TextBlock HorizontalAlignment="Center" Margin="0 0 0 6"
               FontSize="22" FontWeight="Bold"
               Foreground="{DynamicResource TextBrightBrush}"><Run Text="{x:Static views:WelcomeWindow.HeadingBefore}" /><Run Text="EVE " /><Run Text="Console" Foreground="{DynamicResource AccentBrush}" /><Run Text="{x:Static views:WelcomeWindow.HeadingAfter}" /></TextBlock>

    <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0 18 0 20" />

    <!-- Data download notice -->
    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"
               Margin="0 0 0 16"
               Text="{x:Static loc:ShellText.EveConsoleIsDownloadingNote}" />

    <!-- Restart advice. Several tools read their reference data once, when they are first
         opened, so a tool opened before the import finishes can hold an empty picture of the
         game for the rest of the session. Restarting is the reliable way to clear that, and
         saying so here costs a sentence; leaving it out costs a confused first impression. -->
    <TextBlock FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" LineHeight="20"
               Margin="0 0 0 16"
               Text="{x:Static loc:ShellText.OnceThatFinishesRestartNote}" />

    <!-- ESI setup notice -->
    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"
               Margin="0 0 0 4"
               Text="{x:Static loc:ShellText.ToPullInYourNote}" />

    <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0 22 0 18" />

    <Button x:Name="OkButton"
            Content="{x:Static loc:ShellText.GetStarted}"
            HorizontalAlignment="Center"
            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource SurfaceBaseBrush}"
            FontWeight="SemiBold" FontSize="13"
            Padding="22 8"
            Click="OnOkClick" />

  </StackPanel>

</Window>
