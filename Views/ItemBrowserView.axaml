<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:conv="clr-namespace:EveConsole.Views"
             xmlns:collections="clr-namespace:Avalonia.Collections;assembly=Avalonia.Controls.DataGrid"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EveConsole.Views.ItemBrowserView"
             x:DataType="vm:ItemBrowserViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <!-- Root Grid: row 0 = main content, row 1 = status bar (guaranteed no overlap) -->
  <Grid RowDefinitions="*,Auto">

    <!-- Status bar -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBaseBrush}" Padding="12 4" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
    </Border>

    <!-- Main content: left tree + right detail -->
    <Grid Grid.Row="0" ColumnDefinitions="280,1,*">

      <!-- ── Left: nav toolbar + search + tree/results ───────────────────── -->
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource SurfaceBaseBrush}">

        <!-- Back / Forward toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="6 5"
                BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Command="{Binding GoBackCommand}"
                    ToolTip.Tip="Go back"
                    Width="26" Height="22" Padding="2 0"
                    FontSize="14" FontWeight="SemiBold"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="3"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="&#x2190;" />
            <Button Command="{Binding GoForwardCommand}"
                    ToolTip.Tip="Go forward"
                    Width="26" Height="22" Padding="2 0"
                    FontSize="14" FontWeight="SemiBold"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="3"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="&#x2192;" />
          </StackPanel>
        </Border>

        <!-- Search box -->
        <Border Grid.Row="1" Background="{DynamicResource SurfacePanelBrush}" Padding="10 8" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
          <TextBox Text="{Binding SearchText}"
                   Watermark="Search items…"
                   Background="{DynamicResource SurfaceRaisedBrush}"
                   BorderBrush="{DynamicResource BorderDefaultBrush}"
                   BorderThickness="1"
                   CornerRadius="3"
                   FontSize="12"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   CaretBrush="{DynamicResource AccentBrush}"
                   Padding="8 5" />
        </Border>

        <!-- Loading indicator -->
        <TextBlock Grid.Row="2"
                   IsVisible="{Binding IsLoading}"
                   Text="Loading categories…"
                   FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                   Margin="12 8" />

        <!-- Fill area: tree OR search results, both fill row 3 -->
        <Grid Grid.Row="3">

          <TreeView x:Name="ItemTree"
                    IsVisible="{Binding IsBrowsing}"
                    ItemsSource="{Binding RootGroups}"
                    SelectedItem="{Binding SelectedNode}"
                    Background="Transparent"
                    BorderThickness="0">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <!-- Binds IsExpanded so code can expand ancestor nodes programmatically -->
                <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                <Setter Property="Padding"    Value="2 2" />
                <Setter Property="FontSize"   Value="12" />
              </Style>
              <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}" />
              </Style>
            </TreeView.Styles>
          </TreeView>

          <ListBox IsVisible="{Binding IsSearching}"
                   ItemsSource="{Binding SearchResults}"
                   SelectedItem="{Binding SelectedResult}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10 5" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TypeSearchResult">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding GroupPath}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </Grid>

      </Grid>

      <!-- Vertical divider -->
      <Rectangle Grid.Column="1" Fill="{DynamicResource BorderSubtleBrush}" />

      <!-- ── Right: item info ───────────────────────────────────────────── -->
      <Grid Grid.Column="2">

        <!-- Empty state -->
        <TextBlock IsVisible="{Binding NoItem}"
                   Text="Select an item from the tree or search to view its details."
                   Foreground="{DynamicResource TextFaintBrush}" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="40" />

        <!-- Item info -->
        <Grid IsVisible="{Binding HasItem}" RowDefinitions="Auto,*">

          <!-- Header -->
          <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="16 12"
                  BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
            <Grid ColumnDefinitions="72,*" DataContext="{Binding SelectedItem}">

              <!-- Icon -->
              <Border Grid.Column="0" Width="64" Height="64" CornerRadius="4"
                      Background="{DynamicResource SurfaceRaisedBrush}" ClipToBounds="True" Margin="0 0 14 0">
                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
              </Border>

              <!-- Name + path + stats -->
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrightBrush}" />
                <TextBlock Text="{Binding GroupPath}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0 4 0 0">
                  <StackPanel Orientation="Horizontal" Spacing="4"
                              IsVisible="{Binding VolumeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="Volume:" FontSize="12" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Text="{Binding VolumeText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4"
                              IsVisible="{Binding MarketValueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding MarketValueLabel}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Text="{Binding MarketValueText}"  FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4"
                              IsVisible="{Binding HasBuildCost}">
                    <TextBlock Text="Build Cost:" FontSize="12" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Text="{Binding BuildCostText}"
                               FontSize="12" Foreground="{DynamicResource AccentBrush}"
                               IsVisible="{Binding BuildCostText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource BorderStrongBrush}"
                               IsVisible="{Binding BuildCostText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4"
                              IsVisible="{Binding ReprocessedValueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="Reproc Value:" FontSize="12" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Text="{Binding ReprocessedValueText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

            </Grid>
          </Border>

          <!-- Tabs -->
          <!-- ⚠️ BorderThickness 0. The TabControl draws its own rule beneath the tab strip and
               the header Border above already draws one — two lines bracketing the tabs where one
               belongs. The header's is kept; the selected tab's gold underline is what marks the
               tab, and it reads better without a second full-width rule beneath it. -->
          <TabControl Grid.Row="1"
                      x:Name="ItemDetailTabs"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectedIndex="{Binding SelectedDetailTabIndex}"
                      SelectionChanged="OnDetailTabChanged">
            <TabControl.Styles>
              <!-- ⚠️ No bottom border here. Fluent draws its own selected-tab pipe, so adding a
                   BorderThickness underline on top of it gives the tab two lines. Colour only. -->
              <Style Selector="TabItem">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                <Setter Property="Padding" Value="12 8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Margin" Value="0" />
              </Style>
              <Style Selector="TabItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Style>
              <Style Selector="TabItem:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
              </Style>
            </TabControl.Styles>

            <!-- Description tab -->
            <TabItem Header="Description">
              <ScrollViewer Padding="20 16">
                <TextBlock Text="{Binding SelectedItem.Description}"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20" />
              </ScrollViewer>
            </TabItem>

            <!-- Attributes tab -->
            <TabItem Header="Attributes">
              <ScrollViewer Padding="16 12">
                <StackPanel Spacing="12">

                  <ItemsControl ItemsSource="{Binding SelectedItem.TypeStats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AttrDisplayVm">
                        <Grid ColumnDefinitions="*,Auto" Margin="4 3">
                          <TextBlock Grid.Column="0" Text="{Binding Name}"
                                     FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                     FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Rectangle IsVisible="{Binding SelectedItem.HasDogmaAttrs}" Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="4 6" />
                  <ItemsControl IsVisible="{Binding SelectedItem.HasDogmaAttrs}" ItemsSource="{Binding SelectedItem.DogmaAttrs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AttrGroupVm">
                        <StackPanel Margin="0 6 0 0">
                          <TextBlock
                            IsVisible="{Binding CategoryName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Text="{Binding CategoryName}"
                            FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}"
                            Margin="4 0 0 2" />
                          <ItemsControl ItemsSource="{Binding Attrs}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AttrDisplayVm">
                                <Grid ColumnDefinitions="*,Auto" Margin="4 2">
                                  <TextBlock Grid.Column="0" Text="{Binding Name}"
                                             FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                  <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                             FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Right" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- Requirements tab: skills needed to use/build this item -->
            <TabItem Header="Requirements">
              <ScrollViewer Padding="16 12">
                <StackPanel Spacing="6">
                  <ItemsControl ItemsSource="{Binding SelectedItem.Requirements}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BpSkillVm">
                        <Grid ColumnDefinitions="*,Auto" Margin="4 3">
                          <Button Grid.Column="0" x:CompileBindings="False"
                                  Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                  CommandParameter="{Binding SkillTypeId}"
                                  Background="Transparent" BorderThickness="0"
                                  Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SkillName}"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextDecorations="Underline" />
                          </Button>
                          <TextBlock Grid.Column="1" Text="{Binding LevelRoman}"
                                     FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                     HorizontalAlignment="Right" MinWidth="20" TextAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock IsVisible="{Binding !SelectedItem.HasRequirements}"
                             Text="No skill requirements."
                             FontSize="12" Foreground="{DynamicResource TextFaintBrush}" FontStyle="Italic" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- Required For tab: only relevant when this item is itself a skill -->
            <TabItem Header="Required For" IsVisible="{Binding SelectedItem.IsSkill}">
              <Grid RowDefinitions="Auto,*">

                <!-- Level selector (I - V) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4"
                            Margin="16 12 16 8">
                  <StackPanel.Styles>
                    <Style Selector="Button.levelbtn">
                      <Setter Property="Width" Value="34" />
                      <Setter Property="Padding" Value="0 6" />
                      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                      <Setter Property="Foreground" Value="{DynamicResource SurfaceRaisedBrush}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="Button.levelbtn.haveitems">
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceRaisedBrush}" />
                    </Style>
                    <Style Selector="Button.levelbtn.active">
                      <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}" />
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Style>
                  </StackPanel.Styles>
                  <Button Classes="levelbtn" Classes.haveitems="{Binding HasItemsAtLevel1}" Classes.active="{Binding IsRequiredForLevel1}"
                          Content="I"   Command="{Binding SetRequiredForLevelCommand}" CommandParameter="1" />
                  <Button Classes="levelbtn" Classes.haveitems="{Binding HasItemsAtLevel2}" Classes.active="{Binding IsRequiredForLevel2}"
                          Content="II"  Command="{Binding SetRequiredForLevelCommand}" CommandParameter="2" />
                  <Button Classes="levelbtn" Classes.haveitems="{Binding HasItemsAtLevel3}" Classes.active="{Binding IsRequiredForLevel3}"
                          Content="III" Command="{Binding SetRequiredForLevelCommand}" CommandParameter="3" />
                  <Button Classes="levelbtn" Classes.haveitems="{Binding HasItemsAtLevel4}" Classes.active="{Binding IsRequiredForLevel4}"
                          Content="IV"  Command="{Binding SetRequiredForLevelCommand}" CommandParameter="4" />
                  <Button Classes="levelbtn" Classes.haveitems="{Binding HasItemsAtLevel5}" Classes.active="{Binding IsRequiredForLevel5}"
                          Content="V"   Command="{Binding SetRequiredForLevelCommand}" CommandParameter="5" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="16 0 16 12">
                  <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding RequiredForGroups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RequiredForGroupVm">
                          <StackPanel Spacing="2" Margin="0 0 0 10">
                            <TextBlock Text="{Binding CategoryName}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" Margin="4 0 0 2" />
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RequiredForItemVm">
                                  <Button x:CompileBindings="False"
                                          Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                          CommandParameter="{Binding TypeId}"
                                          Background="Transparent" BorderThickness="0"
                                          Padding="4 3" Cursor="Hand" HorizontalContentAlignment="Left"
                                          HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding ItemName}"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextDecorations="Underline" />
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock IsVisible="{Binding !HasRequiredForGroups}"
                               Text="Nothing requires this skill at this level."
                               FontSize="12" Foreground="{DynamicResource TextFaintBrush}" FontStyle="Italic" />
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>

            <!-- Industry tab -->
            <TabItem Header="Industry">
              <ScrollViewer Padding="16 12">
                <StackPanel Spacing="0">

                  <!-- ══ BLUEPRINT / REACTION FORMULA view ════════════════════ -->
                  <StackPanel IsVisible="{Binding SelectedItem.IsBlueprint}" Spacing="0">

                    <!-- Activity selector tabs -->
                    <ListBox x:CompileBindings="False"
                             ItemsSource="{Binding SelectedItem.BlueprintDetail.Activities}"
                             SelectedItem="{Binding SelectedBpActivity}"
                             IsVisible="{Binding SelectedItem.BlueprintDetail.HasMultipleActivities}"
                             SelectionMode="Single"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0 0 0 2">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding"         Value="14 8" />
                          <Setter Property="Foreground"      Value="{DynamicResource TextFaintBrush}" />
                          <Setter Property="FontSize"        Value="12" />
                          <Setter Property="Background"      Value="Transparent" />
                          <Setter Property="BorderThickness" Value="0 0 0 2" />
                          <Setter Property="BorderBrush"     Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                          <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                          <Setter Property="Foreground"  Value="{DynamicResource AccentBrush}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                          <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                          <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding ActivityLabel}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Rectangle Height="1" Fill="{DynamicResource SurfaceRaisedBrush}" Margin="0 0 0 16" />

                    <!-- Outcome / Products -->
                    <StackPanel x:CompileBindings="False"
                                IsVisible="{Binding SelectedBpActivity.HasProducts}"
                                Spacing="6" Margin="0 0 0 20">
                      <TextBlock Text="OUTCOME" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" Margin="0 0 0 2" />
                      <ItemsControl ItemsSource="{Binding SelectedBpActivity.Products}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:BpProductVm">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="4 3">
                              <Button Grid.Column="0"
                                      x:CompileBindings="False"
                                      Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                      CommandParameter="{Binding ProductTypeId}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="0" Cursor="Hand"
                                      HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProductName}"
                                           FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           TextDecorations="Underline" />
                              </Button>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding QuantityText, StringFormat=×{0}}"
                                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center" Margin="10 0 0 0" />
                              <TextBlock Grid.Column="2"
                                         IsVisible="{Binding HasProbability}"
                                         Text="{Binding ProbabilityText}"
                                         FontSize="11" Foreground="{DynamicResource WarnBrush}"
                                         VerticalAlignment="Center" Margin="8 0 0 0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- Required Skills -->
                    <StackPanel x:CompileBindings="False"
                                IsVisible="{Binding SelectedBpActivity.HasSkills}"
                                Spacing="6" Margin="0 0 0 20">
                      <TextBlock Text="REQUIRED SKILLS" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" Margin="0 0 0 2" />
                      <ItemsControl ItemsSource="{Binding SelectedBpActivity.Skills}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:BpSkillVm">
                            <Grid ColumnDefinitions="*,Auto" Margin="4 3">
                              <Button Grid.Column="0" x:CompileBindings="False"
                                      Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                      CommandParameter="{Binding SkillTypeId}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SkillName}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextDecorations="Underline" />
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding LevelRoman}"
                                         FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                         HorizontalAlignment="Right" MinWidth="20" TextAlignment="Right" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- Input Materials -->
                    <StackPanel x:CompileBindings="False"
                                IsVisible="{Binding SelectedBpActivity.HasMaterials}"
                                Spacing="6">
                      <TextBlock Text="INPUT MATERIALS" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" Margin="0 0 0 2" />
                      <ItemsControl ItemsSource="{Binding SelectedBpActivity.Materials}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:BlueprintMatVm">
                            <Grid ColumnDefinitions="*,Auto" Margin="4 3">
                              <Button Grid.Column="0" x:CompileBindings="False"
                                      Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                      CommandParameter="{Binding MaterialTypeId}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding MaterialName}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextDecorations="Underline" />
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=×{0:N0}}"
                                         FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                  </StackPanel>

                  <!-- ══ REGULAR ITEM view ════════════════════════════════════ -->
                  <StackPanel IsVisible="{Binding SelectedItem.IsNotBlueprint}" Spacing="20">

                    <TextBlock IsVisible="{Binding !SelectedItem.HasIndustry}"
                               Text="No blueprint data available for this item."
                               FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                               Margin="4 8" />

                    <!-- Produced By -->
                    <StackPanel IsVisible="{Binding SelectedItem.HasProducedBy}" Spacing="8">
                      <TextBlock Text="PRODUCED BY" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextDimBrush}" LetterSpacing="1" />
                      <ItemsControl ItemsSource="{Binding SelectedItem.ProducedBy}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:BlueprintVm">
                            <Border Background="{DynamicResource SurfacePanelBrush}" CornerRadius="4" Padding="12 10" Margin="0 4">
                              <StackPanel Spacing="8">
                                <!-- Blueprint name — click to navigate to the blueprint item -->
                                <Button x:CompileBindings="False"
                                        Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                        CommandParameter="{Binding BlueprintTypeId}"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                  <TextBlock Text="{Binding BlueprintName}"
                                             FontSize="13" FontWeight="SemiBold"
                                             Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline" />
                                </Button>
                                <TextBlock Text="Required Materials:" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                                <ItemsControl ItemsSource="{Binding Materials}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BlueprintMatVm">
                                      <Grid ColumnDefinitions="*,Auto" Margin="8 2">
                                        <Button Grid.Column="0" x:CompileBindings="False"
                                                Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                                CommandParameter="{Binding MaterialTypeId}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                          <TextBlock Text="{Binding MaterialName}"
                                                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextDecorations="Underline" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=×{0:N0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- Produced by reprocessing. For a great many items this is the ONLY way they
                         are made: nothing on Helium Isotopes said they come out of Clear Icicle. -->
                    <StackPanel IsVisible="{Binding SelectedItem.HasReprocessedFrom}" Spacing="8">
                      <TextBlock Text="PRODUCED BY REPROCESSING" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextDimBrush}" LetterSpacing="1" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                                 Text="Reprocess one batch of these and this item is among what comes back. Each row is judged against its own ceiling — 90.6% for ore, ice and moon ore, 55% for everything else — so the amounts are the best case, not the SDE's 100% figures." />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Show:" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ReprocessSourceFilters}"
                                  SelectedItem="{Binding SelectedReprocessSourceFilter}"
                                  MinWidth="110" FontSize="11"
                                  ToolTip.Tip="Ore includes ice and moon ore — everything in the Asteroid category. Non Ore is the rest: modules, ships, salvage and the like."/>
                      </StackPanel>
                      <TextBlock IsVisible="{Binding ReprocessedFromFilteredEmpty}"
                                 Text="None of that kind yields this item."
                                 FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextFaintBrush}"/>
                      <ItemsControl ItemsSource="{Binding ReprocessedFromShown}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ReprocessSourceVm">
                            <Grid ColumnDefinitions="*,Auto" Margin="4 3">
                              <Button Grid.Column="0"
                                      x:CompileBindings="False"
                                      Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                      CommandParameter="{Binding SourceTypeId}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SourceName}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextDecorations="Underline" />
                              </Button>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                          VerticalAlignment="Center">
                                <TextBlock Text="{Binding BatchText}" FontSize="11"
                                           Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Text="{Binding RateText}" FontSize="11" MinWidth="42"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Text="{Binding YieldText}" FontSize="12" MinWidth="72"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- What this item yields when reprocessed. One rate for the section, because
                         it is one item going in; the caption names it. -->
                    <StackPanel IsVisible="{Binding SelectedItem.HasReprocessedTo}" Spacing="8">
                      <TextBlock Text="REPROCESSES TO" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextDimBrush}" LetterSpacing="1" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                                 Text="{Binding SelectedItem.RefineRateText, StringFormat='What one batch returns at {0}, the best this item can be refined at — a rigged Tatara in nullsec with the skills and implants for it. Ore, ice and moon ore top out at 90.6%; everything else is scrapmetal, where 55% is the ceiling however good the structure. Your own refine will return less.'}" />
                      <ItemsControl ItemsSource="{Binding SelectedItem.ReprocessedTo}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ReprocessOutputVm">
                            <Grid ColumnDefinitions="*,Auto" Margin="4 3">
                              <Button Grid.Column="0"
                                      x:CompileBindings="False"
                                      Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                      CommandParameter="{Binding OutputTypeId}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding OutputName}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextDecorations="Underline" />
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding YieldText}"
                                         FontSize="12" MinWidth="72" TextAlignment="Right"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- Used In -->
                    <StackPanel IsVisible="{Binding SelectedItem.HasUsedIn}" Spacing="8">
                      <TextBlock Text="USED IN MANUFACTURING" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextDimBrush}" LetterSpacing="1" />
                      <ItemsControl ItemsSource="{Binding SelectedItem.UsedIn}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MaterialUseVm">
                            <Grid ColumnDefinitions="*,Auto" Margin="4 3">
                              <Button Grid.Column="0"
                                      x:CompileBindings="False"
                                      Command="{Binding $parent[UserControl].DataContext.NavigateToItemCommand}"
                                      CommandParameter="{Binding BlueprintTypeId}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding BlueprintName}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextDecorations="Underline" />
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding ProductName}"
                                         FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                  </StackPanel>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- Assets tab: every stack of this one item the app knows of, grouped by where it is
                 or by who holds it. The rows are the Asset Browser's own, filtered to the type. -->
            <TabItem Header="Assets">
              <Grid RowDefinitions="Auto,6,Auto,8,*" Margin="16 12">

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Group by:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                             VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding AssetGroupOptions}"
                            SelectedItem="{Binding SelectedAssetGroup}"
                            MinWidth="110" FontSize="11"/>
                  <TextBlock Text="Scope:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                             VerticalAlignment="Center" Margin="10 0 0 0"/>
                  <ComboBox ItemsSource="{Binding AssetScopeOptions}"
                            SelectedItem="{Binding SelectedAssetScope}"
                            MinWidth="220" FontSize="11"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="{Binding AssetsSummary}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>

                <DataGrid Grid.Row="4" ItemsSource="{Binding AssetsView}" IsVisible="{Binding HasAssets}"
                          IsReadOnly="True" AutoGenerateColumns="False" FontSize="11"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          Background="Transparent" GridLinesVisibility="None"
                          RowBackground="Transparent">
                  <DataGrid.Styles>
                    <!-- Group header: the location or the owner once, with what its stacks add up to,
                         and the expander that folds it away — the Station Needs retemplate. ⚠️
                         PART_ExpanderButton must keep its name: the grid finds it by that name to
                         collapse and expand the group. The name here is plain text; the header knows
                         only its key, so the column on each row carries the link. -->
                    <Style Selector="DataGridRowGroupHeader">
                      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                      <Setter Property="MinHeight"  Value="26"/>
                      <Setter Property="Template">
                        <ControlTemplate x:DataType="collections:DataGridCollectionViewGroup">
                          <Border Background="{TemplateBinding Background}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 1">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="6 0"
                                        VerticalAlignment="Center">
                              <ToggleButton Name="PART_ExpanderButton" Width="12" Height="12"
                                            Theme="{DynamicResource FluentDataGridRowGroupExpanderButtonTheme}"
                                            Background="Transparent" BorderThickness="0"/>
                              <TextBlock Text="{Binding Key}" FontSize="12" FontWeight="SemiBold"
                                         Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                              <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                         Text="{Binding Items, Converter={x:Static conv:ItemAssetGroupConverter.Instance}}"/>
                            </StackPanel>
                          </Border>
                        </ControlTemplate>
                      </Setter>
                    </Style>
                  </DataGrid.Styles>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Location" Width="2*" SortMemberPath="Location" ClipboardContentBinding="{Binding Location}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ItemAssetRowVm">
                          <Panel Margin="6 0">
                            <Button Classes="link" Click="OnOpenAssetLocation" IsVisible="{Binding HasLocationLink}"
                                    ToolTip.Tip="Open this location">
                              <TextBlock Text="{Binding Location}" FontSize="11" TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <TextBlock Text="{Binding Location}" IsVisible="{Binding !HasLocationLink}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </Panel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Owner" Width="170" SortMemberPath="Owner" ClipboardContentBinding="{Binding Owner}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ItemAssetRowVm">
                          <Panel Margin="6 0">
                            <Button Classes="link" Click="OnOpenAssetOwner" IsVisible="{Binding HasOwnerLink}"
                                    ToolTip.Tip="Open in the entity browser">
                              <TextBlock Text="{Binding Owner}" FontSize="11" TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <TextBlock Text="{Binding Owner}" IsVisible="{Binding !HasOwnerLink}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </Panel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Qty" Width="90" SortMemberPath="Quantity" ClipboardContentBinding="{Binding QuantityText}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ItemAssetRowVm">
                          <TextBlock Text="{Binding QuantityText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- ⚠️ FontSize on each text column: a DataGridTextColumn does not take the
                         grid's FontSize, it has its own larger default — the templated columns
                         around these set 11 on their TextBlocks. -->
                    <DataGridTextColumn Header="Container" Binding="{Binding Container}" Width="1.5*" FontSize="11"/>
                    <DataGridTextColumn Header="Flag"      Binding="{Binding Flag}"      Width="110"  FontSize="11"/>
                    <DataGridTemplateColumn Header="Value" Width="90" SortMemberPath="Value" ClipboardContentBinding="{Binding ValueText}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ItemAssetRowVm">
                          <TextBlock Text="{Binding ValueText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="System" Width="120" SortMemberPath="SolarSystem" ClipboardContentBinding="{Binding SolarSystem}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ItemAssetRowVm">
                          <Panel Margin="6 0">
                            <Button Classes="link" Click="OnOpenAssetSystem" IsVisible="{Binding HasSystemLink}"
                                    ToolTip.Tip="Open this system">
                              <TextBlock Text="{Binding SolarSystem}" FontSize="11" TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <TextBlock Text="{Binding SolarSystem}" IsVisible="{Binding !HasSystemLink}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </Panel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Sec" Width="46" SortMemberPath="Security" ClipboardContentBinding="{Binding SecurityText}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ItemAssetRowVm">
                          <TextBlock Text="{Binding SecurityText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                     TextAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="120" FontSize="11"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <!-- LP Store tab — hidden unless some NPC corporation sells this item -->
            <TabItem Header="LP Store" IsVisible="{Binding HasLpOffers}">
              <Grid RowDefinitions="Auto,8,*" Margin="16 12">

                <TextBlock Grid.Row="0" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                           Text="Offered by the loyalty point stores below. An item can be sold by several corporations at different rates — the one worth using is whichever you hold LP with. Your balance is the highest any single character holds."/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding LpOffers}"
                          IsReadOnly="True" AutoGenerateColumns="False" FontSize="11"
                          Background="Transparent" GridLinesVisibility="None"
                          RowBackground="Transparent">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Corporation" Width="220" SortMemberPath="CorporationName" ClipboardContentBinding="{Binding CorporationName}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LpOfferVm">
                          <Button Classes="link" Click="OnOpenLpCorp" Padding="0"
                                  HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                  ToolTip.Tip="Open this corporation in NPC Entities">
                            <TextBlock Text="{Binding CorporationName}" FontSize="11"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Qty" Width="60" SortMemberPath="Quantity" ClipboardContentBinding="{Binding QuantityText}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LpOfferVm">
                          <TextBlock Text="{Binding QuantityText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="LP Cost" Width="110" SortMemberPath="LpCost" ClipboardContentBinding="{Binding LpText}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LpOfferVm">
                          <TextBlock Text="{Binding LpText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                     TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ISK Cost" Width="140" SortMemberPath="IskCost" ClipboardContentBinding="{Binding IskText}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LpOfferVm">
                          <TextBlock Text="{Binding IskText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Your LP" Width="110" SortMemberPath="LpHeld" ClipboardContentBinding="{Binding HeldText}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LpOfferVm">
                          <TextBlock Text="{Binding HeldText}" FontSize="11"
                                     Foreground="{Binding HeldColor}"
                                     TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="LP Est. Value" Width="130" SortMemberPath="IskPerLp" ClipboardContentBinding="{Binding IskPerLpText}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LpOfferVm">
                          <TextBlock Text="{Binding IskPerLpText}" FontSize="11"
                                     Foreground="{Binding IskPerLpColor}"
                                     TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"
                                     ToolTip.Tip="Item value less ISK and required items, per LP, both reduced to a single unit."/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- FontSize on each: text columns ignore the grid's (see the Assets grid). -->
                    <DataGridTextColumn Header="Required Items" Binding="{Binding RequiredText}" Width="*"  FontSize="11"/>
                    <DataGridTextColumn Header="AK" Binding="{Binding AkText}" Width="80" FontSize="11"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <!-- Market Orders tab -->
            <TabItem Header="Market Orders">
              <Grid RowDefinitions="Auto,8,*,8,*" Margin="16 12">

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Source:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                             VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding MarketConfigs}"
                            SelectedItem="{Binding SelectedMarketConfig}"
                            MinWidth="200" />
                  <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoadingOrders}" />
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.RowSpan="5"
                           IsVisible="{Binding !HasMarketConfigs}"
                           Text="No ESI market sources configured. Add an ESI Region or ESI Structure source in Settings → Market."
                           FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="32" />

                <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding HasMarketConfigs}">
                  <TextBlock Grid.Row="0" Text="SELL ORDERS" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource BadBrush}" LetterSpacing="1" Margin="0 0 0 4" />
                  <DataGrid Grid.Row="1"
                            ItemsSource="{Binding SellOrders}"
                            CanUserSortColumns="True"
                            CanUserResizeColumns="True"
                            IsReadOnly="True"
                            RowHeight="22"
                            AutoGenerateColumns="False">
                    <DataGrid.Styles>
                      <Style Selector="DataGridCell TextBlock">
                        <Setter Property="FontSize" Value="10" />
                      </Style>
                      <Style Selector="DataGridCell">
                        <Setter Property="Padding" Value="4 0 4 0" />
                      </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Qty"
                                          Binding="{ReflectionBinding VolumeRemainText}"
                                          SortMemberPath="VolumeRemain"
                                          Width="80" />
                      <DataGridTextColumn Header="Price (ISK)"
                                          Binding="{ReflectionBinding PriceText}"
                                          SortMemberPath="Price"
                                          Width="130" />
                      <DataGridTemplateColumn Header="Location" SortMemberPath="LocationName" Width="*" ClipboardContentBinding="{Binding LocationName}">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="vm:OrderRowVm">
                            <Panel>
                              <Button Classes="link" Click="OnOpenOrderLocation"
                                      IsVisible="{Binding HasLocationLink}"
                                      ToolTip.Tip="Open this station or structure">
                                <TextBlock Text="{Binding LocationName}" Classes="linktext"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </Button>
                              <TextBlock Text="{Binding LocationName}" IsVisible="{Binding !HasLocationLink}"
                                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Panel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Sec" SortMemberPath="Security" Width="55" ClipboardContentBinding="{ReflectionBinding SecurityText}">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{ReflectionBinding SecurityText}"
                                       Foreground="{ReflectionBinding SecurityColor}"
                                       ToolTip.Tip="{ReflectionBinding SecurityTip}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Expires"
                                          Binding="{ReflectionBinding ExpiresText}"
                                          SortMemberPath="Expires"
                                          Width="90" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>

                <Grid Grid.Row="4" RowDefinitions="Auto,*" IsVisible="{Binding HasMarketConfigs}">
                  <TextBlock Grid.Row="0" Text="BUY ORDERS" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource GoodBrush}" LetterSpacing="1" Margin="0 0 0 4" />
                  <DataGrid Grid.Row="1"
                            ItemsSource="{Binding BuyOrders}"
                            CanUserSortColumns="True"
                            CanUserResizeColumns="True"
                            IsReadOnly="True"
                            RowHeight="22"
                            AutoGenerateColumns="False">
                    <DataGrid.Styles>
                      <Style Selector="DataGridCell TextBlock">
                        <Setter Property="FontSize" Value="10" />
                      </Style>
                      <Style Selector="DataGridCell">
                        <Setter Property="Padding" Value="4 0 4 0" />
                      </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Qty"
                                          Binding="{ReflectionBinding VolumeRemainText}"
                                          SortMemberPath="VolumeRemain"
                                          Width="80" />
                      <DataGridTextColumn Header="Price (ISK)"
                                          Binding="{ReflectionBinding PriceText}"
                                          SortMemberPath="Price"
                                          Width="130" />
                      <DataGridTextColumn Header="Range"
                                          Binding="{ReflectionBinding RangeDisplay}"
                                          SortMemberPath="Range"
                                          Width="90" />
                      <DataGridTextColumn Header="Min Qty"
                                          Binding="{ReflectionBinding MinVolumeText}"
                                          SortMemberPath="MinVolume"
                                          Width="75" />
                      <DataGridTemplateColumn Header="Location" SortMemberPath="LocationName" Width="*" ClipboardContentBinding="{Binding LocationName}">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="vm:OrderRowVm">
                            <Panel>
                              <Button Classes="link" Click="OnOpenOrderLocation"
                                      IsVisible="{Binding HasLocationLink}"
                                      ToolTip.Tip="Open this station or structure">
                                <TextBlock Text="{Binding LocationName}" Classes="linktext"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </Button>
                              <TextBlock Text="{Binding LocationName}" IsVisible="{Binding !HasLocationLink}"
                                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Panel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Sec" SortMemberPath="Security" Width="55" ClipboardContentBinding="{ReflectionBinding SecurityText}">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{ReflectionBinding SecurityText}"
                                       Foreground="{ReflectionBinding SecurityColor}"
                                       ToolTip.Tip="{ReflectionBinding SecurityTip}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Expires"
                                          Binding="{ReflectionBinding ExpiresText}"
                                          SortMemberPath="Expires"
                                          Width="90" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>

              </Grid>
            </TabItem>

            <!-- Price History tab -->
            <TabItem Header="Price History"
                     IsVisible="{Binding HasPriceHistoryRegions}">
              <Grid RowDefinitions="Auto,8,*" Margin="16 12">

                <!-- Header row: region picker + period picker + loading indicator -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Region:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                             VerticalAlignment="Center" />
                  <ComboBox x:CompileBindings="False"
                            ItemsSource="{Binding HistoryRegions}"
                            SelectedItem="{Binding SelectedHistoryRegion}"
                            MinWidth="180">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RegionName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="Period:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                             VerticalAlignment="Center" />
                  <ComboBox x:CompileBindings="False"
                            ItemsSource="{Binding PeriodOptions}"
                            SelectedItem="{Binding SelectedPeriod}"
                            MinWidth="130">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoadingHistory}" />
                </StackPanel>

                <!-- Empty state -->
                <TextBlock Grid.Row="2"
                           IsVisible="{Binding HistoryIsEmpty}"
                           Text="No price history available for this item in the selected region."
                           FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="32" />

                <!-- Chart / Grid tabs -->
                <TabControl Grid.Row="2"
                            IsVisible="{Binding !HistoryIsEmpty}"
                            Background="Transparent">
                  <TabControl.Styles>
                    <!-- Colour only — Fluent's own pipe is the underline. -->
                    <Style Selector="TabItem">
                      <Setter Property="FontSize" Value="12" />
                      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                      <Setter Property="Padding" Value="10 6" />
                      <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="TabItem:selected">
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </Style>
                  </TabControl.Styles>

                  <TabItem Header="Chart">
                    <lvc:CartesianChart Series="{Binding HistorySeries}"
                                        XAxes="{Binding HistoryXAxes}"
                                        YAxes="{Binding HistoryYAxes}"
                                        LegendPosition="Top"
                                        TooltipPosition="Top"
                                        EasingFunction="{x:Null}"
                                        Background="Transparent" />
                  </TabItem>

                  <TabItem Header="Grid">
                    <DataGrid x:CompileBindings="False"
                              ItemsSource="{Binding HistoryRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Date"       Binding="{ReflectionBinding Date}"                                    Width="115" />
                        <DataGridTextColumn Header="Volume"     Binding="{ReflectionBinding Volume,    StringFormat=N0}"              Width="120" SortMemberPath="Volume" />
                        <DataGridTextColumn Header="Avg Price"  Binding="{ReflectionBinding Average,   StringFormat=N2}"              Width="140" SortMemberPath="Average" />
                        <DataGridTextColumn Header="High"       Binding="{ReflectionBinding Highest,   StringFormat=N2}"              Width="140" SortMemberPath="Highest" />
                        <DataGridTextColumn Header="Low"        Binding="{ReflectionBinding Lowest,    StringFormat=N2}"              Width="140" SortMemberPath="Lowest" />
                        <DataGridTextColumn Header="Orders"     Binding="{ReflectionBinding OrderCount}"                              Width="95"  SortMemberPath="OrderCount" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>

                </TabControl>

              </Grid>
            </TabItem>

            <!-- Derived History tab -->
            <TabItem Header="Derived History">
              <Grid RowDefinitions="Auto,8,*" Margin="16 12">

                <!-- Header row: period picker + loading indicator -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Period:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                             VerticalAlignment="Center" />
                  <ComboBox x:CompileBindings="False"
                            ItemsSource="{Binding PeriodOptions}"
                            SelectedItem="{Binding SelectedDerivedPeriod}"
                            MinWidth="130">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoadingDerived}" />
                </StackPanel>

                <!-- Empty state -->
                <TextBlock Grid.Row="2"
                           IsVisible="{Binding DerivedIsEmpty}"
                           Text="No derived price history recorded for this item yet. A daily snapshot of market, build, contract and reprocessed value is captured automatically as prices refresh."
                           FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="32" />

                <!-- Chart -->
                <lvc:CartesianChart Grid.Row="2"
                                    IsVisible="{Binding !DerivedIsEmpty}"
                                    Series="{Binding DerivedSeries}"
                                    XAxes="{Binding DerivedXAxes}"
                                    YAxes="{Binding DerivedYAxes}"
                                    LegendPosition="Top"
                                    TooltipPosition="Top"
                                    EasingFunction="{x:Null}"
                                    Background="Transparent" />

              </Grid>
            </TabItem>

          </TabControl>
        </Grid>
      </Grid>

    </Grid>
  </Grid>

</UserControl>
