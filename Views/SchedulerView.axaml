<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:svc="clr-namespace:EveConsole.Services"
             x:Class="EveConsole.Views.SchedulerView"
             x:DataType="vm:SchedulerViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin" Value="2 0 0 2" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
      <Setter Property="Margin" Value="0 0 0 6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InfoSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12 4" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceHeaderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7 1" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,1,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <StackPanel Spacing="5">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Grid.Column="0" Classes="tool" Command="{Binding NewCommand}" Content="{x:Static loc:AlarmsText.NewTask}" />
        <Button Grid.Column="1" Classes="tool" Command="{Binding RefreshCommand}"
                Content="{x:Static loc:AlarmsText.Refresh}" Margin="8 0 0 0" />
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="16 0 0 0" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3" Text="{x:Static loc:AlarmsText.TimesAreEveTime}" FontSize="10.5"
                   Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="12 0 0 0" />
      </Grid>
        <TextBlock Text="{x:Static loc:AlarmsText.EarlyDevelopmentThisToolNote}"
                   FontSize="10.5" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="1 0 0 0" />
      </StackPanel>
    </Border>

    <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtleBrush}" />

    <Grid Grid.Row="2" ColumnDefinitions="300,1,*">

      <!-- ── Left: the tasks ────────────────────────────────────────────── -->
      <ListBox Grid.Column="0" ItemsSource="{Binding Tasks}"
               SelectedItem="{Binding SelectedTask}"
               Background="{DynamicResource SurfaceBaseBrush}" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScheduledTaskRowVm">
            <Grid ColumnDefinitions="Auto,*" Margin="0 3">
              <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" IsHitTestVisible="False"
                        VerticalAlignment="Top" Margin="0 2 6 0" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Schedule}" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding LastRunText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" />
                <TextBlock Text="{Binding LastResult}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Rectangle Grid.Column="1" Fill="{DynamicResource BorderSubtleBrush}" />

      <!-- ── Right: the editor, then a fixed action bar ──────────────────── -->
      <Grid Grid.Column="2" RowDefinitions="*,Auto">

        <TextBlock Grid.Row="0" IsVisible="{Binding !HasEditor}"
                   Text="{x:Static loc:AlarmsText.SelectATaskOrCreate}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource TextFaintBrush}" />

        <ScrollViewer Grid.Row="0" IsVisible="{Binding HasEditor}">
          <!-- Margin on the content, not padding on the ScrollViewer: padding is not counted in
               the scrollable extent, so the last thing in the panel stays clipped.

               Every task has a name, a switch and a time; what it then DOES is one choice among
               several, and only that choice's own fields belong below the rule. Laying the whole
               editor out as one task type's form is what made a second type awkward to add. -->
          <StackPanel Spacing="14" Margin="16 14 16 16">

            <!-- ══ Common: every task has these ═══════════════════════════ -->

            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Margin="0 0 12 0">
                  <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.NameLabel}" />
                  <TextBox Text="{Binding Name}" Watermark="{x:Static loc:AlarmsText.HintWhatDoesThisTaskDo}" />
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Content="{x:Static loc:AlarmsText.Enabled}"
                          VerticalAlignment="Bottom" Margin="0 0 0 5" />
              </Grid>

              <!-- Its own line under the name. Sharing the row with the name put it against the
                   right edge, where it was the first thing to go when the pane narrowed. -->
              <StackPanel Width="260" HorizontalAlignment="Left">
                <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.TaskTypeLabel}" />
                <ComboBox ItemsSource="{Binding TaskTypes}" SelectedItem="{Binding SelectedTaskType}"
                          HorizontalAlignment="Stretch" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="{x:Static loc:AlarmsText.WhenLabel}" Margin="0" />

              <!-- One row: the kind, then whatever that kind needs. Hidden panels take no
                   space, so the row closes up rather than leaving gaps. -->
              <StackPanel Orientation="Horizontal" Spacing="12">

                <StackPanel Width="180">
                  <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.RepeatsLabel}" />
                  <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Interval -->
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsInterval}">
                  <StackPanel Width="120">
                    <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.EveryLabel}" />
                    <NumericUpDown Value="{Binding IntervalValue}" Minimum="1" Maximum="9999"
                                   Increment="1" FormatString="0" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10"
                              VerticalAlignment="Bottom" Margin="0 0 0 6">
                    <RadioButton GroupName="unit" IsChecked="{Binding IntervalInMinutes}"
                                 Content="{x:Static loc:AlarmsText.Minutes}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <RadioButton GroupName="unit" IsChecked="{Binding IntervalInHours}"
                                 Content="{x:Static loc:AlarmsText.Hours}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                </StackPanel>

                <!-- Weekly -->
                <StackPanel IsVisible="{Binding IsWeekly}">
                  <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.OnTheseDaysLabel}" />
                  <ItemsControl ItemsSource="{Binding Days}" Margin="0 4 0 0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DayChoice">
                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}"
                                  Margin="0 0 10 0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Monthly -->
                <StackPanel Width="110" IsVisible="{Binding IsMonthly}">
                  <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.DayOfMonthLabel}" />
                  <NumericUpDown Value="{Binding DayOfMonth}" Minimum="1" Maximum="31"
                                 Increment="1" FormatString="0" FontSize="11" />
                </StackPanel>

                <!-- Yearly -->
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsYearly}">
                  <StackPanel Width="150">
                    <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.MonthLabel}" />
                    <ComboBox ItemsSource="{Binding MonthNames}" SelectedItem="{Binding MonthOfYear}"
                              HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Width="110">
                    <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.DayLabel}" />
                    <NumericUpDown Value="{Binding DayOfMonth}" Minimum="1" Maximum="31"
                                   Increment="1" FormatString="0" FontSize="11" />
                  </StackPanel>
                </StackPanel>

                <!-- Time of day -->
                <!-- The zone belongs on the field, not only in the corner of the toolbar: this is
                     the one control whose meaning changes with it. -->
                <StackPanel Width="125" IsVisible="{Binding HasClock}">
                  <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.AtHhMmEveLabel}" />
                  <TextBox Text="{Binding TimeOfDay}" Watermark="00:01" />
                </StackPanel>

                <CheckBox IsVisible="{Binding CanSkipIfMissed}" IsChecked="{Binding SkipIfMissed}"
                          Content="{x:Static loc:AlarmsText.SkipIfTheApp}"
                          VerticalAlignment="Bottom" Margin="0 0 0 6" />
              </StackPanel>

              <TextBlock Classes="hint" Text="{Binding ScheduleHint}" MaxWidth="820"
                         HorizontalAlignment="Left" />
            </StackPanel>

            <!-- ══ The rule, and below it only what this task type needs ══ -->
            <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0 2" />

            <!-- ── Post to Slack ──────────────────────────────────────────── -->
            <StackPanel Spacing="14" IsVisible="{Binding IsSlackPost}">

              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="{x:Static loc:AlarmsText.PostToLabel}" Margin="0" />
                <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination}"
                          Width="340" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:SlackDestination">
                      <TextBlock Text="{Binding Label}" FontSize="11" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="hint"
                           Text="{x:Static loc:AlarmsText.SlackAndDiscordDestinationsNote}" />

                <CheckBox IsChecked="{Binding SkipIfNoDynamicContent}" Margin="0 4 0 0"
                          Content="{x:Static loc:AlarmsText.DoNotPostIf}" />
                <TextBlock Classes="hint" MaxWidth="560" HorizontalAlignment="Left"
                           Text="{x:Static loc:AlarmsText.OffTheMessageGoesNote}" />
              </StackPanel>

              <StackPanel Spacing="10">

                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Classes="section" Text="{x:Static loc:AlarmsText.MessageLabel}" Margin="0"
                             VerticalAlignment="Center" />
                  <!-- One picker and one Add, rather than a button per section type: the list of
                       types is going to keep growing, and a row of buttons does not. -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                              HorizontalAlignment="Left" Margin="16 0 0 0">
                    <ComboBox ItemsSource="{Binding SectionTypes}"
                              SelectedItem="{Binding SelectedSectionType}" Width="180" />
                    <Button Classes="small" Content="{x:Static loc:AlarmsText.AddSection}" Padding="10 3"
                            Command="{Binding AddSectionCommand}" />
                    <Button Classes="small" Content="{x:Static loc:AlarmsText.Preview2}" Padding="10 3"
                            Command="{Binding PreviewCommand}"
                            ToolTip.Tip="{x:Static loc:AlarmsText.TipRendersTheSectionsAs}" />
                  </StackPanel>
                </Grid>

                <!-- Sections on the left, what they come out as on the right. -->
                <Grid ColumnDefinitions="*,14,*">

                  <StackPanel Grid.Column="0" Spacing="8">

                    <TextBlock Classes="hint" IsVisible="{Binding !Blocks.Count}"
                               Text="{x:Static loc:AlarmsText.NothingToSayYetNote}" />

                    <ItemsControl ItemsSource="{Binding Blocks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageBlockVm">
                          <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                  CornerRadius="3" Padding="10 8" Margin="0 0 0 8">
                            <StackPanel Spacing="8">

                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Heading}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                  <Button Classes="small" Content="↑"
                                          Command="{Binding $parent[ItemsControl].((vm:SchedulerViewModel)DataContext).MoveUpCommand}"
                                          CommandParameter="{Binding}" />
                                  <Button Classes="small" Content="↓"
                                          Command="{Binding $parent[ItemsControl].((vm:SchedulerViewModel)DataContext).MoveDownCommand}"
                                          CommandParameter="{Binding}" />
                                  <Button Classes="small" Content="✕" Foreground="{DynamicResource BadBrush}"
                                          Command="{Binding $parent[ItemsControl].((vm:SchedulerViewModel)DataContext).RemoveCommand}"
                                          CommandParameter="{Binding}" />
                                </StackPanel>
                              </Grid>

                              <!-- Static text -->
                              <TextBox IsVisible="{Binding IsText}" Text="{Binding Text}"
                                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                       Watermark="{x:Static loc:AlarmsText.HintWhatToSaySlack}" />

                              <!-- Whose figures. Top 10, Monthly and Standing Projects all need one. -->
                              <Grid ColumnDefinitions="*,150" IsVisible="{Binding NeedsCorp}">
                                <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                  <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.CorpLabel}" />
                                  <ComboBox ItemsSource="{Binding Corps}" SelectedItem="{Binding Corp}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" IsVisible="{Binding NeedsMonth}">
                                  <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.MonthLabel}" />
                                  <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding Month}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                              </Grid>

                              <TextBlock Classes="hint" IsVisible="{Binding NeedsMonth}"
                                         Text="{Binding MonthsBackText}" />

                              <!-- Top 10: which lists -->
                              <StackPanel IsVisible="{Binding IsTop10}" Spacing="4">
                                <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.ListsToIncludeLabel}" />
                                <ItemsControl ItemsSource="{Binding Categories}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryChoice">
                                      <CheckBox IsChecked="{Binding Selected}" Content="{Binding Title}"
                                                Margin="0 0 12 0" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <CheckBox IsChecked="{Binding HideIsk}" Margin="0 4 0 0"
                                          Content="{x:Static loc:AlarmsText.ShowOnlyTheShare}" />
                                <TextBlock Classes="hint"
                                           Text="{x:Static loc:AlarmsText.EachListPrintsTheNote}" />
                              </StackPanel>

                              <!-- Charts: whose figures, and a word about where they can go -->
                          <StackPanel IsVisible="{Binding IsChart}" Spacing="6">
                            <TextBlock Classes="hint"
                                       Text="{x:Static loc:AlarmsText.TwelveMonthsOfTrendsNote}" />
                            <Border IsVisible="{Binding ShowWebhookChartWarning}"
                                    Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource WarnSurfaceBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="8 6">
                              <TextBlock FontSize="10.5" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                         Text="{x:Static loc:AlarmsText.ThisSectionWillNotNote}" />
                            </Border>
                          </StackPanel>

                          <!-- Sale posting: which one -->
                              <StackPanel IsVisible="{Binding IsSale}" Spacing="4">
                                <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.PostingLabel}" />
                                <ComboBox ItemsSource="{Binding Postings}" SelectedItem="{Binding Posting}"
                                          HorizontalAlignment="Stretch" />
                                <TextBlock Classes="hint"
                                           Text="{x:Static loc:AlarmsText.PricedAndCountedExactlyNote}" />
                              </StackPanel>

                              <!-- Standing projects: which type, then which of them -->
                              <StackPanel IsVisible="{Binding IsProjects}" Spacing="6">
                                <Grid ColumnDefinitions="180,10,220" HorizontalAlignment="Left">
                                  <StackPanel Grid.Column="0">
                                    <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.ProjectTypeLabel}" />
                                    <ComboBox ItemsSource="{Binding ProjectTypes}"
                                              SelectedItem="{Binding ProjectType}"
                                              HorizontalAlignment="Stretch" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2">
                                    <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.ReportLabel}" />
                                    <ComboBox ItemsSource="{Binding ReportFilters}"
                                              SelectedItem="{Binding ProjectFilter}"
                                              HorizontalAlignment="Stretch" />
                                  </StackPanel>
                                </Grid>

                                <TextBlock Classes="hint"
                                           Text="{x:Static loc:AlarmsText.MissingIsAnythingNoNote}" />

                                <Grid ColumnDefinitions="*,12,Auto">
                                  <StackPanel Grid.Column="0">
                                    <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.SectionTitleLabel}" />
                                    <TextBox Text="{Binding SectionTitle}"
                                             Watermark="{x:Static loc:AlarmsText.HintNoTitle}" />
                                  </StackPanel>
                                  <CheckBox Grid.Column="2" IsChecked="{Binding ShowHeaders}"
                                            Content="{x:Static loc:AlarmsText.ColumnHeaders}"
                                            VerticalAlignment="Bottom" Margin="0 0 0 5" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                  <CheckBox IsChecked="{Binding ShowIskLeft}" Content="{x:Static loc:AlarmsText.IskLeftColumn}" />
                                  <CheckBox IsChecked="{Binding ShowLastCompleted}" Content="{x:Static loc:AlarmsText.LastCompletedColumn}" />
                                </StackPanel>

                                <TextBlock Classes="hint" Text="{Binding ProjectsNote}"
                                           IsVisible="{Binding ProjectsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <StackPanel IsVisible="{Binding Projects.Count}" Spacing="4">
                                  <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="flabel"
                                               Text="{x:Static loc:AlarmsText.ProjectsToIncludeLabel}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Left" Margin="12 0 0 2">
                                      <Button Classes="small" Content="{x:Static loc:AlarmsText.All}"  Command="{Binding SelectAllCommand}" />
                                      <Button Classes="small" Content="{x:Static loc:AlarmsText.None}" Command="{Binding SelectNoneCommand}" />
                                    </StackPanel>
                                  </Grid>
                                  <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:ProjectChoice">
                                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}"
                                                  Margin="0 0 0 1" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <TextBlock Classes="hint"
                                             Text="{x:Static loc:AlarmsText.OneRowPerProjectNote}" />
                                </StackPanel>
                              </StackPanel>

                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Preview -->
                  <Border Grid.Column="2" Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1" CornerRadius="3" Padding="10 8"
                          VerticalAlignment="Top" MinHeight="120">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.PreviewLabel}" />
                      <TextBlock Classes="hint" IsVisible="{Binding !HasPreview}"
                                 Text="{x:Static loc:AlarmsText.PressPreviewToRenderNote}" />
                      <!-- Its own horizontal scroll: a fenced table is monospace and as wide as
                           its widest row, and wrapping one would destroy the columns it is made of. -->
                      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto"
                                    MaxHeight="620" IsVisible="{Binding HasPreview}">
                        <SelectableTextBlock Text="{Binding PreviewText}"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                      </ScrollViewer>
                    </StackPanel>
                  </Border>

                </Grid>
              </StackPanel>

            </StackPanel>

            <!-- ── Raise an alert ─────────────────────────────────────────── -->
            <StackPanel Spacing="8" IsVisible="{Binding IsRaiseAlert}">
              <TextBlock Classes="section" Text="{x:Static loc:AlarmsText.AlertLabel}" Margin="0" />

              <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.HeadlineLabel}" />
                <TextBox Text="{Binding AlertTitle}"
                         Watermark="{x:Static loc:AlarmsText.HintLeaveEmptyToUse}" />
              </StackPanel>

              <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Classes="flabel" Text="{x:Static loc:AlarmsText.TextLabel}" />
                <TextBox Text="{Binding AlertText}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="170" Watermark="{x:Static loc:AlarmsText.HintWhatTheAlertShouldSay}" />
              </StackPanel>

              <TextBlock Classes="hint" MaxWidth="820" HorizontalAlignment="Left"
                         Text="{x:Static loc:AlarmsText.ShowsOnTheOverviewNote}" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- Action bar. Outside the scroll region so Save is never something to scroll for.

             The status line belongs beside the buttons, not only in the toolbar. Everything here
             refuses quietly when something is missing, and a refusal read from the far side of a
             wide screen is a button that looks broken. -->
        <Border Grid.Row="1" IsVisible="{Binding HasEditor}"
                Background="{DynamicResource SurfaceBaseBrush}" Padding="16 8"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0">
          <Grid ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
              <Button Classes="tool" Content="{x:Static loc:AlarmsText.Save}"    Command="{Binding SaveCommand}" />
              <Button Classes="tool" Content="{x:Static loc:AlarmsText.DiscardChanges}" Command="{Binding DiscardCommand}"
                      ToolTip.Tip="{x:Static loc:AlarmsText.TipPutsTheEditorBack}" />
              <Button Classes="tool" Content="{x:Static loc:AlarmsText.Preview2}" Command="{Binding PreviewCommand}"
                      IsVisible="{Binding CanPreview}" />
              <Button Classes="tool" Content="{Binding RunLabel}" Command="{Binding RunNowCommand}"
                      ToolTip.Tip="{x:Static loc:AlarmsText.TipRunsWhatIsOn}" />
              <Button Content="{x:Static loc:AlarmsText.Delete}" Command="{Binding DeleteCommand}"
                      Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource BadBrush}" BorderBrush="{DynamicResource BadSurfaceBrush}"
                      BorderThickness="1" Padding="12 4" FontSize="11" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="14 0 0 0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>

      </Grid>
    </Grid>
  </Grid>
</UserControl>
