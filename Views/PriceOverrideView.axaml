<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.PriceOverrideView"
             x:DataType="vm:PriceOverrideViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,1,Auto,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">

        <Button Grid.Column="0"
                Command="{Binding AddCommand}"
                Content="{x:Static loc:IndustryText.AddType}"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                Padding="12 4" FontSize="11" />

        <Button Grid.Column="1"
                Command="{Binding DeleteSelectedCommand}"
                Content="{x:Static loc:IndustryText.Remove}"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource BadBrush}"
                BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1"
                Padding="12 4" FontSize="11" Margin="8 0 0 0" />

        <Button Grid.Column="2"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding !Busy}"
                Content="{x:Static loc:IndustryText.SaveRecalculate}"
                Background="{DynamicResource SurfaceHeaderBrush}" Foreground="{DynamicResource GoodBrush}"
                BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1"
                Padding="12 4" FontSize="11" Margin="8 0 0 0" />

        <TextBlock Grid.Column="3"
                   Text="{Binding Status}"
                   FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="16 0 0 0"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtleBrush}" />

    <!-- ── Help banner ──────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBaseBrush}" Padding="12 6"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource SurfaceHoverBrush}">
      <TextBlock FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                 Text="{x:Static loc:IndustryText.LeaveACellBlankNote}" />
    </Border>

    <!-- ── Data grid ─────────────────────────────────────────────────── -->
    <DataGrid Grid.Row="3"
              x:Name="MainGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              AutoGenerateColumns="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              IsReadOnly="False"
              Background="{DynamicResource SurfaceBaseBrush}"
              RowBackground="{DynamicResource SurfaceBaseBrush}"
              GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}"
              HeadersVisibility="Column"
              FontSize="11"
              RowHeight="25"
              BorderThickness="0"
              KeyDown="OnGridKeyDown">

      <DataGrid.Styles>
        <Style Selector="DataGridColumnHeader">
          <Setter Property="Background"                Value="{DynamicResource SurfacePanelBrush}" />
          <Setter Property="Foreground"                Value="{DynamicResource TextFaintBrush}" />
          <Setter Property="FontSize"                  Value="10" />
          <Setter Property="FontWeight"                Value="SemiBold" />
          <Setter Property="Padding"                   Value="6 6 2 6" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="BorderBrush"               Value="{DynamicResource BorderSubtleBrush}" />
          <Setter Property="BorderThickness"           Value="0 0 1 1" />
        </Style>
        <Style Selector="DataGridCell">
          <Setter Property="Padding"         Value="6 0" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="FontSize"        Value="11" />
          <Setter Property="MinHeight"       Value="0" />
        </Style>
        <Style Selector="DataGridRow">
          <Setter Property="MinHeight" Value="25" />
        </Style>
      </DataGrid.Styles>

      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColType}" SortMemberPath="TypeName" IsReadOnly="True" Width="2*" ClipboardContentBinding="{Binding TypeName}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PriceOverrideRow">
              <Panel>
                <Button Classes="link" Click="OnOpenRowItem" IsVisible="{Binding HasItemLink}"
                        ToolTip.Tip="{x:Static loc:IndustryText.TipOpenInTheItemBrowser}">
                  <TextBlock Text="{Binding TypeName}" Classes="linktext"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static loc:IndustryText.ColTypeId}" Binding="{Binding TypeId}"
                            IsReadOnly="True" Width="Auto" />
        <DataGridTextColumn Header="{x:Static loc:IndustryText.ColBuildCost}" Binding="{Binding BuildCostText}"
                            Width="*" />
        <DataGridTextColumn Header="{x:Static loc:IndustryText.ColMarketValue}" Binding="{Binding MarketValueText}"
                            Width="*" />
        <DataGridTextColumn Header="{x:Static loc:IndustryText.ColContractValuePerRunFor}"
                            Binding="{Binding ContractValueText}" Width="1.4*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
