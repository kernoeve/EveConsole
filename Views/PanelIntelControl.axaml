<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.PanelIntelControl"
             x:DataType="vm:PanelIntelVm">
  <UserControl.Styles>
    <Style Selector="Button.icon">
      <Setter Property="Background"      Value="Transparent" />
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius"    Value="3" />
      <Setter Property="Padding"         Value="5 3" />
      <Setter Property="MinHeight"       Value="0" />
      <Setter Property="Cursor"          Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background"      Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding"         Value="0" />
      <Setter Property="MinHeight"       Value="0" />
      <Setter Property="Cursor"          Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.systemRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.systemRow:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style>
    <Style Selector="Border.systemRow.open"><Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" /></Style>
    <!-- Fresh news within five jumps lights the system's line up. A look only: sound is the alarms' job. -->
    <Style Selector="Border.line.fresh"><Setter Property="Background" Value="{DynamicResource WarnSurfaceBrush}" /></Style>
    <Style Selector="Border.stripe.clear"><Setter Property="Background" Value="{DynamicResource GoodBrush}" /></Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Margin" Value="0 4 0 2" />
    </Style>
  </UserControl.Styles>

  <!-- Live intel within the control's range of the character in this monitor's client: one row per
       system with hostiles in it, nearest first. Threats only: blue and light blue are left out. A row
       opens, clicked, to the pilots there and then the system's reports, kills and camp lines. Read only;
       nothing here types, and nothing reaches the game. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="8 5 8 5">
      <ComboBox HorizontalAlignment="Left" FontSize="11" MinHeight="0" Padding="6 2" MaxWidth="170"
                ItemsSource="{Binding Names}" SelectedItem="{Binding SelectedName}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ClipToBounds="True">
        <TextBlock Text="{Binding WhereText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding RangeText}" FontSize="11" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="{x:Static loc:IntelText.TipRange}" />
      <!-- Paste Local or d-scan: the Intel tool's Paste tab, with this character and system chosen. -->
      <Button Grid.Column="3" Classes="icon" Command="{Binding PasteCommand}" IsVisible="{Binding CanPaste}"
              ToolTip.Tip="{x:Static loc:IntelText.TipPaste}">
        <Path Data="M4,1 H10 A1,1 0 0 1 11,2 V9 A1,1 0 0 1 10,10 H4 A1,1 0 0 1 3,9 V2 A1,1 0 0 1 4,1 Z M1,3 V11 A1,1 0 0 0 2,12 H8"
              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" Width="12" Height="13" />
      </Button>
      <Button Grid.Column="4" Classes="icon" Command="{Binding OpenToolCommand}" IsVisible="{Binding CanOpenTool}"
              ToolTip.Tip="{x:Static loc:IntelText.TipOpenTool}">
        <Path Data="M7 1h4v4M11 1L5.5 6.5M9 7v4H1V3h4" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" Width="12" Height="12" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Margin="10 6" Spacing="4" IsVisible="{Binding HasNote}">
      <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
      <Button Classes="link" Command="{Binding OpenChatLogSettingsCommand}" IsVisible="{Binding NoteOpensChatLogs}">
        <TextBlock Text="{x:Static loc:IntelText.PanelOpenChatLogs}" FontSize="11" TextDecorations="Underline"
                   Foreground="{DynamicResource InfoBrush}" />
      </Button>
    </StackPanel>
    <!-- Its own row: the note can never be drawn over a row of the list. -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                  BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:IntelSystemLineVm">
            <Border Classes="systemRow" Classes.open="{Binding IsOpen}"
                    Tapped="OnRowTapped" ContextRequested="OnRowContext">
              <Grid ColumnDefinitions="3,*">
                <Border Classes="stripe" Classes.clear="{Binding IsClear}" Background="{Binding TierBrush}"
                        ToolTip.Tip="{Binding StandingsTip}" />
                <StackPanel Grid.Column="1">
                  <Border Classes="line" Classes.fresh="{Binding IsFresh}">
                    <views:IntelSystemLine Margin="5 2 8 2" Opacity="{Binding Opacity}" />
                  </Border>
                  <!-- Opened: the pilots there, then the system's reports, kills and camp lines. -->
                  <StackPanel IsVisible="{Binding IsOpen}" Margin="10 0 8 6">
                    <TextBlock Classes="section" Text="{x:Static loc:IntelText.SectionPilots}" IsVisible="{Binding HasPilots}" />
                    <ItemsControl ItemsSource="{Binding Pilots}" IsVisible="{Binding HasPilots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IntelHostilePilotVm">
                          <views:IntelHostileLine PictureSize="20" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="section" Text="{x:Static loc:IntelText.SectionEvents}" IsVisible="{Binding HasEvents}" />
                    <ItemsControl ItemsSource="{Binding Events}" IsVisible="{Binding HasEvents}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IntelEventRowVm">
                          <views:IntelEventRow />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Text="{Binding Footer}" FontSize="10" TextWrapping="Wrap" Margin="10 5"
               Foreground="{DynamicResource TextFaintBrush}" />
  </Grid>
</UserControl>
