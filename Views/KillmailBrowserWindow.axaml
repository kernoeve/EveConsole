<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveConsole.Views"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.KillmailBrowserWindow"
        x:DataType="vm:KillmailBrowserViewModel"
        Title="Killmails"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource SurfaceBaseBrush}">
  <views:KillmailBrowserView DataContext="{Binding}" />
</Window>
