<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EveConsole.ViewModels"
             x:Class="EveConsole.Views.StoresView"
             x:DataType="vm:StoresViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Toolbar -->
    <Border Grid.Row="0" Background="#0d0d12" Padding="10 6"
            BorderThickness="0 0 0 1" BorderBrush="#1e1e2a">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
        <Button Grid.Column="0" Command="{Binding AddStoreCommand}" Content="+ Add Store"
                Background="#1a1a28" Foreground="#c8a84b"
                BorderBrush="#3a3020" BorderThickness="1" Padding="12 4" FontSize="11" />
        <Button Grid.Column="1" Command="{Binding DeleteStoreCommand}" Content="Delete"
                Background="#2a1010" Foreground="#aa4444"
                BorderBrush="#3a2020" BorderThickness="1" Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        <Button Grid.Column="2" Command="{Binding CheckMailCommand}" Content="Check Mail Now"
                Background="#1a1a28" Foreground="#5599aa"
                BorderBrush="#2a3a44" BorderThickness="1" Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        <Button Grid.Column="3" Command="{Binding RefreshCommand}" Content="Refresh"
                Background="#1a1a28" Foreground="#5599aa"
                BorderBrush="#2a3a44" BorderThickness="1" Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="11" Foreground="#666677"
                   VerticalAlignment="Center" Margin="16 0 0 0" TextWrapping="NoWrap" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">

      <!-- Store list -->
      <Border Grid.Column="0" Background="#0d0d12" BorderThickness="0 0 1 0" BorderBrush="#1e1e2a">
        <ListBox ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StoreRowVm">
              <StackPanel Spacing="1" Margin="0 2">
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#c8c8d8" />
                <TextBlock Text="{Binding CharacterName}" FontSize="10" Foreground="#666677" />
                <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="#5599aa" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" Spacing="14" IsVisible="{Binding HasSelection}">

          <!-- Settings -->
          <Border Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
            <StackPanel Spacing="10">
              <TextBlock Text="Store" FontSize="13" FontWeight="SemiBold" Foreground="#c8a84b" />

              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" FontSize="11"
                           Foreground="#888899" VerticalAlignment="Center" Margin="0 0 0 6" />
                <!-- LostFocus, not the default per-keystroke: every change writes to the
                     database, and a store name typed at speed would be a dozen writes. -->
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding StoreName, UpdateSourceTrigger=LostFocus}"
                         FontSize="11" Background="#1a1a28" Foreground="#c8c8d8"
                         BorderBrush="#2a2a3a" Margin="0 0 0 6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Character" FontSize="11"
                           Foreground="#888899" VerticalAlignment="Center" Margin="0 0 0 6" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CharacterOptions}"
                          SelectedItem="{Binding StoreCharacter}" FontSize="11" MinWidth="220"
                          HorizontalAlignment="Left"
                          Background="#1a1a28" Foreground="#c8c8d8" BorderBrush="#2a2a3a"
                          Margin="0 0 0 6" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Price list" FontSize="11"
                           Foreground="#888899" VerticalAlignment="Center" Margin="0 0 0 6" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PostingOptions}"
                          SelectedItem="{Binding StorePosting}" FontSize="11" MinWidth="220"
                          HorizontalAlignment="Left"
                          Background="#1a1a28" Foreground="#c8c8d8" BorderBrush="#2a2a3a"
                          Margin="0 0 0 6" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Serve" FontSize="11"
                           Foreground="#888899" VerticalAlignment="Center" Margin="0 0 0 6" />
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding PolicyOptions}"
                          SelectedItem="{Binding SenderPolicy}" FontSize="11" MinWidth="120"
                          HorizontalAlignment="Left"
                          Background="#1a1a28" Foreground="#c8c8d8" BorderBrush="#2a2a3a"
                          Margin="0 0 0 6" />

                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding StoreEnabled}"
                          Content="Open — read and answer mail" FontSize="11" Foreground="#c8c8d8" />
              </Grid>

              <!-- An order filled from the shelf has no job behind it, so nothing else would ever
                   give it a date. Blank reads as "no idea" when the truth is "as soon as someone
                   writes the contract". -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox IsChecked="{Binding AutoEstimate}"
                          Content="Give in-stock orders an expected date" FontSize="11"
                          Foreground="#c8c8d8" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding AutoEstimateDays}" Minimum="0" Maximum="60"
                               Increment="1" FormatString="0" Width="88" FontSize="11"
                               IsEnabled="{Binding AutoEstimate}"
                               Background="#1a1a28" Foreground="#c8c8d8" BorderBrush="#2a2a3a" />
                <TextBlock Text="day(s) from the order" FontSize="11" Foreground="#888899"
                           VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock FontSize="10" Foreground="#666677" TextWrapping="Wrap"
                         Text="Buyers put the command in the mail SUBJECT: PRICES, ORDER, STATUS or CANCEL. An ORDER body is one item per line, as &quot;2 x Hulk&quot;. STATUS and CANCEL need the order reference from the confirmation." />
            </StackPanel>
          </Border>

          <!-- Stats -->
          <Border Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
            <Grid ColumnDefinitions="*,*,*,*">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Inquiries" FontSize="10" Foreground="#666677" />
                <TextBlock Text="{Binding StatInquiries}" FontSize="18" Foreground="#c8a84b" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Active orders" FontSize="10" Foreground="#666677" />
                <TextBlock Text="{Binding StatActive}" FontSize="18" Foreground="#5599aa" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="Completed" FontSize="10" Foreground="#666677" />
                <TextBlock Text="{Binding StatCompleted}" FontSize="18" Foreground="#4a8a5a" />
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="2">
                <TextBlock Text="Cancelled" FontSize="10" Foreground="#666677" />
                <TextBlock Text="{Binding StatCancelled}" FontSize="18" Foreground="#aa4444" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Allow list -->
          <Border Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
            <StackPanel Spacing="8">
              <TextBlock Text="Who may order" FontSize="13" FontWeight="SemiBold" Foreground="#c8a84b" />
              <TextBlock FontSize="10" Foreground="#666677" TextWrapping="Wrap"
                         Text="Used when Serve is set to List. A sender matches by their own name, their corporation, or their alliance. Names are resolved against ids the app has already seen." />

              <Grid ColumnDefinitions="Auto,*,Auto">
                <ComboBox Grid.Column="0" ItemsSource="{Binding SenderKinds}"
                          SelectedItem="{Binding SenderKind}" FontSize="11" MinWidth="110"
                          Background="#1a1a28" Foreground="#c8c8d8" BorderBrush="#2a2a3a" />
                <!-- ⚠️ AsyncPopulator, not ItemsSource: the name cache holds 267,000 characters
                     and 39,000 corporations, and handing the box that list would have it lay out
                     every one. FilterMode must be None — the populator has already narrowed the
                     list, and letting the box filter again would drop matches it never got. -->
                <AutoCompleteBox Grid.Column="1"
                                 AsyncPopulator="{Binding SenderPopulator}"
                                 SelectedItem="{Binding SenderMatch}"
                                 Text="{Binding SenderName}"
                                 ValueMemberBinding="{Binding Name}"
                                 FilterMode="None" MinimumPrefixLength="2"
                                 Watermark="Type two letters of the name…"
                                 FontSize="11" Background="#1a1a28" Foreground="#c8c8d8"
                                 BorderBrush="#2a2a3a" Margin="8 0" />
                <Button Grid.Column="2" Command="{Binding AddSenderCommand}" Content="Add"
                        Background="#0d1a12" Foreground="#4a8a5a"
                        BorderBrush="#1e3a28" BorderThickness="1" Padding="12 4" FontSize="11" />
              </Grid>

              <DataGrid ItemsSource="{Binding Senders}" SelectedItem="{Binding SelectedSender}"
                        AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160"
                        Background="Transparent" HeadersVisibility="Column" FontSize="11">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                  <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StoreSenderRowVm">
                        <Button Click="OnRemoveSender" Content="Remove"
                                Background="#2a1010" Foreground="#aa4444"
                                BorderBrush="#3a2020" BorderThickness="1"
                                Padding="6 1" FontSize="10" Cursor="Hand" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <!-- Messages -->
          <Border Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
            <StackPanel Spacing="8">
              <TextBlock Text="Messages" FontSize="13" FontWeight="SemiBold" Foreground="#c8a84b" />
              <DataGrid ItemsSource="{Binding Mails}" AutoGenerateColumns="False" IsReadOnly="True"
                        MinHeight="240" MaxHeight="460"
                        Background="Transparent" HeadersVisibility="Column" FontSize="11">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="When"      Binding="{Binding When}"      Width="130" />
                  <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80" />
                  <DataGridTextColumn Header="Who"       Binding="{Binding Party}"     Width="150" />
                  <DataGridTextColumn Header="Command"   Binding="{Binding Command}"   Width="80" />
                  <DataGridTextColumn Header="Subject"   Binding="{Binding Subject}"   Width="*" />
                  <DataGridTextColumn Header="Order"     Binding="{Binding OrderRef}"  Width="80" />
                  <DataGridTextColumn Header="Outcome"   Binding="{Binding Outcome}"   Width="80" />
                  <!-- Wrapped, not truncated: the note is where a rejection explains itself, and
                       an ellipsis in the one column that says why is the column doing nothing. -->
                  <DataGridTemplateColumn Header="Note" Width="320">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StoreMailRowVm">
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                   FontSize="11" Margin="4 2" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
