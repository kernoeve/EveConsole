<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.TradeOpportunitiesView"
             x:DataType="vm:TradeOpportunitiesViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="RowHeight" Value="22" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="4 0 4 0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- ── Controls bar ─────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceBaseBrush}" Padding="12 10"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
     <StackPanel Spacing="10">
      <DockPanel>

        <Button DockPanel.Dock="Right"
                Content="{x:Static loc:MarketText.Calculate}"
                Command="{Binding CalculateCommand}"
                Padding="18 6"
                Background="{DynamicResource BorderSubtleBrush}"
                Foreground="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}"
                BorderThickness="1"
                FontSize="12" />

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

          <ComboBox ItemsSource="{Binding ModeOptions}"
                    SelectedItem="{Binding SelectedMode}"
                    Width="230" FontSize="12"
                    Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource AccentBrush}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:TradeModeOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{x:Static loc:MarketText.From}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <!-- Both boxes name each station as the interface does, and find it by that name or by
               its English (StationFilter, which makes the filter mode Custom). Nothing is saved
               from them but the pick itself. -->
          <AutoCompleteBox ItemsSource="{Binding Stations}"
                           SelectedItem="{Binding SourceStation}"
                           ValueMemberBinding="{Binding DisplayName}"
                           ItemFilter="{Binding StationFilter}"
                           MinimumPrefixLength="0"
                           Watermark="{x:Static loc:MarketText.HintTypeToFilter}"
                           Width="220" FontSize="12"
                           Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
            <AutoCompleteBox.ItemTemplate>
              <DataTemplate DataType="vm:StationOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </AutoCompleteBox.ItemTemplate>
          </AutoCompleteBox>

          <TextBlock Text="{x:Static loc:MarketText.To}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <AutoCompleteBox ItemsSource="{Binding Stations}"
                           SelectedItem="{Binding DestinationStation}"
                           ValueMemberBinding="{Binding DisplayName}"
                           ItemFilter="{Binding StationFilter}"
                           MinimumPrefixLength="0"
                           Watermark="{x:Static loc:MarketText.HintTypeToFilter}"
                           Width="220" FontSize="12"
                           Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
            <AutoCompleteBox.ItemTemplate>
              <DataTemplate DataType="vm:StationOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </AutoCompleteBox.ItemTemplate>
          </AutoCompleteBox>

          <TextBlock Text="{x:Static loc:MarketText.CargoM}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding CargoM3}" Width="90" FontSize="12"
                   Watermark="{x:Static loc:MarketText.HintNoLimit}"
                   Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />

          <TextBlock Text="{x:Static loc:MarketText.IskCap}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding IskCap}" Width="110" FontSize="12"
                   Watermark="{x:Static loc:MarketText.HintNoLimit}"
                   Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />

          <TextBlock Text="{x:Static loc:MarketText.Min30dIskVol}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding MinIskVolume}" Width="110" FontSize="12"
                   Watermark="{x:Static loc:MarketText.HintNoFilter}"
                   Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />

          <TextBlock Text="{x:Static loc:MarketText.Min30dUnitVol}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding MinUnitVolume}" Width="110" FontSize="12"
                   Watermark="{x:Static loc:MarketText.HintNoFilter}"
                   Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- Each buy capped at what the destination sold in this many days; empty for no cap. -->
          <TextBlock Text="{x:Static loc:MarketText.CapDaysLabel}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:MarketText.TipCapDays}" />
          <TextBox Text="{Binding CapDays}" Width="70" FontSize="12"
                   Watermark="{x:Static loc:MarketText.HintNoLimit}" ToolTip.Tip="{x:Static loc:MarketText.TipCapDays}"
                   Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />

        </StackPanel>
      </DockPanel>

      <!-- ── Excluded market groups ─────────────────────────────────────────── -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Static loc:MarketText.ExcludeGroups}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                   VerticalAlignment="Center" />

        <ItemsControl ItemsSource="{Binding ExcludedMarketGroups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ExcludedMarketGroupVm">
              <Border Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                      CornerRadius="3" Padding="6 3" Margin="0 0 6 4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Button x:CompileBindings="False"
                          Content="✕"
                          Command="{Binding $parent[UserControl].DataContext.RemoveExcludedGroupCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource BadBrush}" FontSize="10" Padding="0"
                          Cursor="Hand" VerticalAlignment="Center"
                          ToolTip.Tip="{x:Static loc:MarketText.TipRemoveThisExclusion}" />
                  <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="{x:Static loc:MarketText.AddGroup}"
                Command="{Binding AddExcludedGroupCommand}"
                Padding="8 3" FontSize="11"
                Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource InfoBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
      </StackPanel>

      <!-- ── Name filter: narrows the list as typed, no recalculation ───────── -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Static loc:CommonText.ItemNameFilterLabel}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                   VerticalAlignment="Center" />
        <TextBox Text="{Binding NameFilter.Text}" Width="260" FontSize="12"
                 Watermark="{x:Static loc:CommonText.ItemNameFilterHint}"
                 ToolTip.Tip="{x:Static loc:CommonText.TipItemNameFilter}"
                 Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding NameFilter.Shown}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                   VerticalAlignment="Center" />
      </StackPanel>

     </StackPanel>
    </Border>

    <!-- ── Summary footer ───────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SurfaceInputBrush}" Padding="12 8"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 1 0 0">
      <DockPanel>
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                   VerticalAlignment="Center" />

        <StackPanel DockPanel.Dock="Right"
                    IsVisible="{Binding HasSummary}"
                    Orientation="Horizontal" Spacing="4">

          <Border Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  CornerRadius="3" Padding="10 4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{x:Static loc:MarketText.VolumeLabel}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"
                         FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SummaryVolume}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  CornerRadius="3" Padding="10 4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{x:Static loc:MarketText.CostLabel}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"
                         FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SummaryCost}" FontSize="12" Foreground="{DynamicResource InfoBrush}" />
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  CornerRadius="3" Padding="10 4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{x:Static loc:MarketText.ProfitLabel}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"
                         FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SummaryProfit}" FontSize="12" Foreground="{DynamicResource GoodBrush}" />
            </StackPanel>
          </Border>

        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Results area ───────────────────────────────────────────────────────── -->
    <Grid>

    <!-- ResultsView, not Results: the name filter narrows what the grid shows through it. -->
    <DataGrid x:CompileBindings="False"
              ItemsSource="{Binding ResultsView}"
              DoubleTapped="OnGridDoubleTapped"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              CanUserReorderColumns="False"
              ClipboardCopyMode="None">

      <DataGrid.Columns>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColItem}" Width="*" MinWidth="150" SortMemberPath="TypeName" ClipboardContentBinding="{Binding TypeName}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Panel>
                <Button Classes="link" Click="OnOpenItem" IsVisible="{Binding HasItemLink}"
                        ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheItemBrowser}">
                  <TextBlock Text="{Binding TypeName}" Classes="linktext"
                             TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColSellPrice}" Width="110" SortMemberPath="BestSell" ClipboardContentBinding="{Binding BestSellDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding BestSellDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColDestPrice}" Width="110" SortMemberPath="DestPrice" ClipboardContentBinding="{Binding DestPriceDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DestPriceDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColProfitUnit}" Width="110" SortMemberPath="ProfitPerUnit" ClipboardContentBinding="{Binding ProfitUnitDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ProfitUnitDisplay}"
                         Foreground="{DynamicResource GoodBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColProfitM}" Width="100" SortMemberPath="ProfitPerM3" ClipboardContentBinding="{Binding ProfitM3Display}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ProfitM3Display}"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColQty}" Width="80" SortMemberPath="Quantity" ClipboardContentBinding="{Binding QuantityDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding QuantityDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColVolumeM2}" Width="100" SortMemberPath="TotalVolume" ClipboardContentBinding="{Binding TotalVolumeDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding TotalVolumeDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColTotalCost}" Width="110" SortMemberPath="TotalCost" ClipboardContentBinding="{Binding TotalCostDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding TotalCostDisplay}"
                         Foreground="{DynamicResource InfoBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColTotalProfit}" Width="110" SortMemberPath="TotalProfit" ClipboardContentBinding="{Binding TotalProfitDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding TotalProfitDisplay}"
                         Foreground="{DynamicResource GoodBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- What the destination's region traded over 30 days: how much room a sell order has. -->
        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColDestUnitsSold30d}" Width="140" SortMemberPath="DestUnitVol30d" ClipboardContentBinding="{Binding DestUnitVol30dDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DestUnitVol30dDisplay}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColDestIskSold30d}" Width="140" SortMemberPath="DestIskVol30d" ClipboardContentBinding="{Binding DestIskVol30dDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DestIskVol30dDisplay}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>

    <!-- Calculating overlay — shown while the scan is running -->
    <Border IsVisible="{Binding IsCalculating}"
            Background="#a0000000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="6"
            Padding="36 24">
      <StackPanel HorizontalAlignment="Center" Spacing="14">
        <ProgressBar IsIndeterminate="True"
                     Width="240" Height="3"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource SurfaceRaisedBrush}" />
        <TextBlock Text="{x:Static loc:MarketText.ScanningForTradeOpportunities}"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center"
                   MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>

    </Grid>

  </DockPanel>

</UserControl>
