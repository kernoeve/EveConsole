<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:ctl="clr-namespace:EveConsole.Controls"
             xmlns:svc="clr-namespace:EveConsole.Services"
             x:Class="EveConsole.Views.StructureBrowserView"
             x:DataType="vm:StructureBrowserViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="AutoCompleteBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0 0 6 0" />
    </Style>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin" Value="2 0 0 1" />
    </Style>

    <!-- Applied at this level so the viewer's grids match the list rather than each grid
         restating it — the cells inherit a much larger default otherwise. -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="6 6 2 6" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0 0 1 1" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="6 0" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <!-- List and viewer share the vertical space evenly; the splitter moves it. -->
  <Grid RowDefinitions="Auto,1,Auto,1,*,4,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <Button Grid.Column="0" Command="{Binding RefreshCommand}" Content="{x:Static loc:MapText.Refresh}"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}"
                BorderThickness="1" Padding="12 4" FontSize="11" />
        <Button Grid.Column="1" Command="{Binding ResolveCommand}" IsEnabled="{Binding !Busy}"
                Content="{x:Static loc:MapText.ResolveViaEsi}" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1" Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        <Button Grid.Column="2" Command="{Binding OpenAddCommand}" IsEnabled="{Binding !Busy}"
                Content="{x:Static loc:MapText.AddById}" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        <Button Grid.Column="3" Command="{Binding ClearFilters}" Content="{x:Static loc:MapText.ClearFilters}"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1" Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        <CheckBox Grid.Column="4" IsChecked="{Binding ShowUnknown}"
                  Content="{x:Static loc:MapText.ShowUnknown}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                  VerticalAlignment="Center" Margin="14 0 0 0" />
        <TextBlock Grid.Column="5" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="16 0 0 0"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtleBrush}" />

    <!-- ── Filter bar (autocomplete text fields) ───────────────────────── -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBaseBrush}" Padding="10 6">
      <Grid ColumnDefinitions="*,*,*,*,*,*">
        <StackPanel Grid.Column="0">
          <TextBlock Classes="flabel" Text="{x:Static loc:MapText.RegionLabel}" />
          <AutoCompleteBox Text="{Binding RegionText}" ItemsSource="{Binding RegionSuggestions}"
                           FilterMode="Contains" MinimumPrefixLength="0" Watermark="{x:Static loc:MapText.HintAny}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="flabel" Text="{x:Static loc:MapText.ConstellationLabel}" />
          <AutoCompleteBox Text="{Binding ConstellationText}" ItemsSource="{Binding ConstellationSuggestions}"
                           FilterMode="Contains" MinimumPrefixLength="0" Watermark="{x:Static loc:MapText.HintAny}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="flabel" Text="{x:Static loc:MapText.SystemLabel}" />
          <AutoCompleteBox Text="{Binding SystemText}" ItemsSource="{Binding SystemSuggestions}"
                           FilterMode="Contains" MinimumPrefixLength="0" Watermark="{x:Static loc:MapText.HintAny}" />
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Classes="flabel" Text="{x:Static loc:MapText.TypeLabel}" />
          <AutoCompleteBox Text="{Binding TypeText}" ItemsSource="{Binding TypeSuggestions}"
                           FilterMode="Contains" MinimumPrefixLength="0" Watermark="{x:Static loc:MapText.HintAny}" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Classes="flabel" Text="{x:Static loc:MapText.CorpLabel}" />
          <AutoCompleteBox Text="{Binding CorpText}" ItemsSource="{Binding CorpSuggestions}"
                           FilterMode="Contains" MinimumPrefixLength="0" Watermark="{x:Static loc:MapText.HintAny}" />
        </StackPanel>
        <StackPanel Grid.Column="5">
          <TextBlock Classes="flabel" Text="{x:Static loc:MapText.AllianceLabel}" />
          <AutoCompleteBox Text="{Binding AllianceText}" ItemsSource="{Binding AllianceSuggestions}"
                           FilterMode="Contains" MinimumPrefixLength="0" Watermark="{x:Static loc:MapText.HintAny}" />
        </StackPanel>
      </Grid>
    </Border>

    <Rectangle Grid.Row="3" Fill="{DynamicResource BorderSubtleBrush}" />

    <!-- ── Grid ────────────────────────────────────────────────────────── -->
    <DataGrid Grid.Row="4"
                ItemsSource="{Binding Rows}"
                AutoGenerateColumns="False"
                CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                IsReadOnly="True"
                SelectedItem="{Binding Selected, Mode=TwoWay}"
                Background="{DynamicResource SurfaceBaseBrush}" RowBackground="{DynamicResource SurfaceBaseBrush}"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}"
                HeadersVisibility="Column" FontSize="11" RowHeight="24" BorderThickness="0">
        <DataGrid.Styles>
          <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6 6 2 6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0 0 1 1" />
          </Style>
          <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="6 0" />
            <Setter Property="FontSize" Value="11" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
          <DataGridTextColumn Header="{x:Static loc:MapText.ColStructure}" Binding="{Binding Name}" Width="2*" />
          <DataGridTemplateColumn Header="{x:Static loc:MapText.ColType}" SortMemberPath="TypeName" Width="*" ClipboardContentBinding="{Binding TypeName}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructureRow">
                <Panel>
                  <Button Classes="link" Click="OnOpenRowType" IsVisible="{Binding HasTypeLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheItemBrowser}">
                    <TextBlock Text="{Binding TypeName}" Classes="linktext"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasTypeLink}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static loc:MapText.ColSystem}" SortMemberPath="SystemName" Width="*" ClipboardContentBinding="{Binding SystemName}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructureRow">
                <Panel>
                  <Button Classes="link" Click="OnOpenRowSystem" IsVisible="{Binding HasSystemLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenOnTheMap}">
                    <TextBlock Text="{Binding SystemName}" Classes="linktext"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <TextBlock Text="{Binding SystemName}" IsVisible="{Binding !HasSystemLink}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static loc:MapText.ColConstellation}" SortMemberPath="Constellation" Width="*" ClipboardContentBinding="{Binding Constellation}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructureRow">
                <Panel>
                  <Button Classes="link" Click="OnOpenRowConstellation" IsVisible="{Binding HasConstellationLink}" ToolTip.Tip="{x:Static loc:MapText.TipFrameThisConstellationOnThe}">
                    <TextBlock Text="{Binding Constellation}" Classes="linktext"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <TextBlock Text="{Binding Constellation}" IsVisible="{Binding !HasConstellationLink}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static loc:MapText.ColRegion}" SortMemberPath="Region" Width="*" ClipboardContentBinding="{Binding Region}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructureRow">
                <Panel>
                  <Button Classes="link" Click="OnOpenRowRegion" IsVisible="{Binding HasRegionLink}" ToolTip.Tip="{x:Static loc:MapText.TipFrameThisRegionOnThe}">
                    <TextBlock Text="{Binding Region}" Classes="linktext"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <TextBlock Text="{Binding Region}" IsVisible="{Binding !HasRegionLink}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static loc:MapText.ColCorp}" SortMemberPath="CorpName" Width="1.4*" ClipboardContentBinding="{Binding CorpName}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructureRow">
                <Panel>
                  <Button Classes="link" Click="OnOpenRowCorp" IsVisible="{Binding HasCorpLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheEntityBrowser}">
                    <TextBlock Text="{Binding CorpName}" Classes="linktext"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <TextBlock Text="{Binding CorpName}" IsVisible="{Binding !HasCorpLink}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{x:Static loc:MapText.ColAlliance}" SortMemberPath="AllianceName" Width="1.4*" ClipboardContentBinding="{Binding AllianceName}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructureRow">
                <Panel>
                  <Button Classes="link" Click="OnOpenRowAlliance" IsVisible="{Binding HasAllianceLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheEntityBrowser}">
                    <TextBlock Text="{Binding AllianceName}" Classes="linktext"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <TextBlock Text="{Binding AllianceName}" IsVisible="{Binding !HasAllianceLink}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{x:Static loc:MapText.ColNearest}" Binding="{Binding NearestCelestial}" Width="*" />
          <DataGridTextColumn Header="{x:Static loc:MapText.ColStatus}" Binding="{Binding StatusText}" Width="Auto" />
        </DataGrid.Columns>
      </DataGrid>

    <GridSplitter Grid.Row="5" Height="4" Background="{DynamicResource BorderSubtleBrush}"
                  HorizontalAlignment="Stretch" ResizeDirection="Rows" />

    <!-- ── Viewer for the selected structure ─────────────────────────── -->
    <Border Grid.Row="6" Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0">

      <Panel>
        <TextBlock Text="{x:Static loc:MapText.SelectAStructureAboveNote}"
                   FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasSelection}" />

        <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasSelection}" Margin="12 8">

          <!-- Header: identity and provenance -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
            <StackPanel Grid.Column="0" Spacing="1">
              <TextBlock Text="{Binding Selected.Name}" FontSize="13"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <!-- ⚠️ System and region live on this line rather than on the Details tab. The
                   fields there are the editable record — an AutoCompleteBox and a ComboBox — and
                   a control you type into is not one you navigate from. This line was already the
                   read-only summary, so it is where a link belongs. -->
              <StackPanel Orientation="Horizontal" Spacing="0">
                <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center">
                  <Run Text="{x:Static loc:MapText.LocationId}" /><Run Text=" " />
                  <Run Text="{Binding Selected.StructureId}" />
                  <Run Text="  ·  " />
                  <Run Text="{Binding Provenance}" />
                </TextBlock>
                <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding Selected.HasSystemLink}" />
                <Button Classes="link" Click="OnOpenSelectedSystem"
                        IsVisible="{Binding Selected.HasSystemLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenOnTheMap}">
                  <TextBlock Text="{Binding Selected.SystemName}" Classes="linktext"
                             FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                </Button>
                <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding Selected.HasRegionLink}" />
                <Button Classes="link" Click="OnOpenSelectedRegion"
                        IsVisible="{Binding Selected.HasRegionLink}"
                        ToolTip.Tip="{x:Static loc:MapText.TipFrameThisRegionOnThe}">
                  <TextBlock Text="{Binding Selected.Region}" Classes="linktext"
                             FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                </Button>
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding DetailStatus}"
                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          </Grid>

          <TabControl Grid.Row="1">

            <!-- ── Details: the editable record ────────────────────── -->
            <TabItem Header="{x:Static loc:MapText.TabDetails}">
              <ScrollViewer Margin="4 8 4 0">
                <Grid ColumnDefinitions="Auto,*">

                <!-- Hull render, so the type is recognisable at a glance rather than read. -->
                <Border Grid.Column="0" Width="200" Height="200" Margin="0 0 18 0"
                        Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="4"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        VerticalAlignment="Top">
                  <!-- The render is the one place the structure's type appears read-only, so it
                       carries the Item Browser link; the TYPE ComboBox beside it is for editing.
                       Panel because a Border takes a single child and this needs both states. -->
                  <Panel>
                    <Button Classes="link" Click="OnOpenSelectedType"
                            IsVisible="{Binding Selected.HasTypeLink}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheItemBrowser}">
                      <Image Source="{Binding TypeRender}" Stretch="Uniform" Margin="6" />
                    </Button>
                    <Image Source="{Binding TypeRender}" Stretch="Uniform" Margin="6"
                           IsVisible="{Binding !Selected.HasTypeLink}" />
                  </Panel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="8" MaxWidth="620" HorizontalAlignment="Left">

                  <StackPanel>
                    <TextBlock Classes="flabel" Text="{x:Static loc:MapText.NameLabel}" />
                    <TextBox Text="{Binding EditName}" FontSize="11.5"
                             IsEnabled="{Binding CanEditIdentity}" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0 0 6 0">
                      <TextBlock Classes="flabel" Text="{x:Static loc:MapText.SystemLabel}" />
                      <!-- ⚠️ AsyncPopulator, not ItemsSource. Handing this box all ~8,500 systems
                           made it lay out every one of them and hung the tool. FilterMode must be
                           None: the populator has already narrowed the list, and letting the box
                           filter again would drop matches it never received. -->
                      <AutoCompleteBox AsyncPopulator="{Binding SystemPopulator}"
                                       SelectedItem="{Binding EditSystem}"
                                       Text="{Binding EditSystemText}"
                                       ValueMemberBinding="{Binding Label}"
                                       FilterMode="None" MinimumPrefixLength="2"
                                       IsEnabled="{Binding CanEditIdentity}"
                                       Margin="0" FontSize="11.5"
                                       Watermark="{x:Static loc:MapText.HintTypeTwoLettersOf}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6 0 0 0">
                      <TextBlock Classes="flabel" Text="{x:Static loc:MapText.TypeLabel}" />
                      <ComboBox ItemsSource="{Binding TypeOptions}"
                                SelectedItem="{Binding EditType}"
                                IsEnabled="{Binding CanEditIdentity}"
                                FontSize="11.5" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:PickOption">
                            <TextBlock Text="{Binding Label}" FontSize="11.5" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <!-- Notes sits outside the identity gate on purpose: ESI never supplies it, so
                       there is nothing for a hand-written note to be overwritten by. -->
                  <StackPanel>
                    <TextBlock Classes="flabel" Text="{x:Static loc:MapText.NotesLabel}" />
                    <TextBox Text="{Binding EditNotes}" FontSize="11.5"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             Watermark="{x:Static loc:MapText.HintAccessNotesWhoTo}" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static loc:MapText.Save}" Click="OnSaveDetail"
                            Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}"
                            BorderThickness="1" Padding="16 4" FontSize="11" />
                    <Button Content="{x:Static loc:MapText.PullFromEsi}" Command="{Binding PullFromEsiCommand}"
                            IsEnabled="{Binding !Busy}"
                            Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" Padding="16 4" FontSize="11"
                            ToolTip.Tip="{x:Static loc:MapText.TipAsksEsiAboutThis}" />
                  </StackPanel>

                  <TextBlock Text="{Binding EditLockReason}"
                             IsVisible="{Binding !CanEditIdentity}"
                             FontSize="10" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" />
                  <!-- A value nobody can verify does not get the same grey as one ESI returned. -->
                  <TextBlock Text="{Binding EveRefNote}"
                             IsVisible="{Binding EveRefNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{x:Static loc:MapText.LocationIdCannotBeNote}"
                             FontSize="10" Foreground="{DynamicResource TextFaintBrush}" />

                </StackPanel>
                </Grid>
              </ScrollViewer>
            </TabItem>

            <!-- ── Fitting ─────────────────────────────────────────── -->
            <!-- Ring on the left, list on the right: the ring says what is empty at a glance,
                 the list is what you read when you want the names. -->
            <TabItem Header="{x:Static loc:MapText.TabFitting}">
              <Grid ColumnDefinitions="*,340">

                <Grid Grid.Column="0" RowDefinitions="*,Auto">
                  <Panel Grid.Row="0">
                    <ctl:FittingCanvas Slots="{Binding FittingSlots}"
                                       HullRender="{Binding TypeRender}"
                                       IsReadOnly="{Binding FittingReadOnly}"
                                       SlotClickedCommand="{Binding SlotClickedCommand}" />

                    <!-- Module picker, over the ring so the slot being filled stays in view -->
                    <Border IsVisible="{Binding PickerOpen}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="380" MaxHeight="340"
                            Background="#f00e0e16" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12">
                      <Grid RowDefinitions="Auto,Auto,*,Auto">

                        <TextBlock Grid.Row="0" Text="{Binding PickerTitle}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   Margin="0 0 0 6" />

                        <TextBox Grid.Row="1" Text="{Binding ModuleFilter}" FontSize="11"
                                 Watermark="{x:Static loc:MapText.HintFilterModules}" Margin="0 0 0 6" />

                        <ListBox Grid.Row="2" ItemsSource="{Binding ModuleOptions}"
                                 SelectedItem="{Binding SelectedModule}"
                                 Background="Transparent" BorderThickness="0">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:FittingOption">
                              <StackPanel Spacing="0" Margin="0 1">
                                <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding GroupName}" FontSize="9.5" Foreground="{DynamicResource TextDimBrush}" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0 8 0 0">
                          <Button Content="{x:Static loc:MapText.Fit}" Command="{Binding FitModuleCommand}"
                                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}"
                                  BorderThickness="1" Padding="16 4" FontSize="11" />
                          <Button Content="{x:Static loc:MapText.ClearSlot}" Command="{Binding ClearSlotCommand}"
                                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource BadBrush}" BorderBrush="{DynamicResource BadSurfaceBrush}"
                                  BorderThickness="1" Padding="12 4" FontSize="11" />
                          <Button Content="{x:Static loc:MapText.Cancel}" Command="{Binding CancelPickerCommand}"
                                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                  BorderThickness="1" Padding="12 4" FontSize="11" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Panel>

                  <TextBlock Grid.Row="1" Text="{Binding FittingSourceText}"
                             FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                             HorizontalAlignment="Center" Margin="0 2 0 6" />
                </Grid>

                <DataGrid Grid.Column="1" ItemsSource="{Binding Fitting}" AutoGenerateColumns="False"
                          IsReadOnly="True" RowHeight="22"
                          Background="{DynamicResource SurfaceBaseBrush}" RowBackground="{DynamicResource SurfaceBaseBrush}" BorderThickness="1 0 0 0"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:MapText.ColSlot}"   Binding="{Binding Slot}"     Width="100" />
                    <DataGridTemplateColumn Header="{x:Static loc:MapText.ColModule}" SortMemberPath="TypeName" Width="*" ClipboardContentBinding="{Binding TypeName}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FittingRow">
                          <Panel>
                            <Button Classes="link" Click="OnOpenFittingItem" IsVisible="{Binding HasItemLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheItemBrowser}">
                              <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Panel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static loc:MapText.ColFrom}"   Binding="{Binding Source}"   Width="70" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <!-- ── Assets ──────────────────────────────────────────── -->
            <TabItem Header="{x:Static loc:MapText.TabAssets}">
              <DataGrid ItemsSource="{Binding Assets}" AutoGenerateColumns="False"
                        IsReadOnly="True" RowHeight="22"
                        Background="{DynamicResource SurfaceBaseBrush}" RowBackground="{DynamicResource SurfaceBaseBrush}" BorderThickness="0"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{x:Static loc:MapText.ColItem}" SortMemberPath="TypeName" Width="*" ClipboardContentBinding="{Binding TypeName}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StructureAssetRow">
                        <Panel>
                          <Button Classes="link" Click="OnOpenAssetItem" IsVisible="{Binding HasItemLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheItemBrowser}">
                            <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{x:Static loc:MapText.ColContainer}" Binding="{Binding Container}" Width="200" />
                  <DataGridTextColumn Header="{x:Static loc:MapText.ColWhere}"     Binding="{Binding Location}"  Width="170" />
                  <DataGridTextColumn Header="{x:Static loc:MapText.ColQty}"       Binding="{Binding QuantityText}" SortMemberPath="Quantity"
                                      Width="90" CellStyleClasses="num" />
                  <DataGridTemplateColumn Header="{x:Static loc:MapText.ColOwner}" SortMemberPath="Owner" Width="130" ClipboardContentBinding="{Binding Owner}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StructureAssetRow">
                        <Panel>
                          <Button Classes="link" Click="OnOpenAssetOwner" IsVisible="{Binding HasOwnerLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheEntityBrowser}">
                            <TextBlock Text="{Binding Owner}" Classes="linktext"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="{Binding Owner}" IsVisible="{Binding !HasOwnerLink}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>

            <!-- ── Cargo ───────────────────────────────────────────── -->
            <TabItem Header="{x:Static loc:MapText.TabCargo}">
              <DataGrid ItemsSource="{Binding Cargo}" AutoGenerateColumns="False"
                        IsReadOnly="True" RowHeight="22"
                        Background="{DynamicResource SurfaceBaseBrush}" RowBackground="{DynamicResource SurfaceBaseBrush}" BorderThickness="0"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}">
                <!-- No owner column: it is always the corp that owns the structure. -->
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{x:Static loc:MapText.ColItem}" SortMemberPath="TypeName" Width="*" ClipboardContentBinding="{Binding TypeName}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StructureAssetRow">
                        <Panel>
                          <Button Classes="link" Click="OnOpenAssetItem" IsVisible="{Binding HasItemLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheItemBrowser}">
                            <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{x:Static loc:MapText.ColContainer}" Binding="{Binding Container}" Width="220" />
                  <DataGridTextColumn Header="{x:Static loc:MapText.ColQty}"       Binding="{Binding QuantityText}" SortMemberPath="Quantity"
                                      Width="110" CellStyleClasses="num" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>

            <!-- ── Fuel ────────────────────────────────────────────── -->
            <TabItem Header="{x:Static loc:MapText.TabFuel}">
              <DataGrid ItemsSource="{Binding Fuel}" AutoGenerateColumns="False"
                        IsReadOnly="True" RowHeight="22"
                        Background="{DynamicResource SurfaceBaseBrush}" RowBackground="{DynamicResource SurfaceBaseBrush}" BorderThickness="0"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{x:Static loc:MapText.ColItem}" SortMemberPath="TypeName" Width="*" ClipboardContentBinding="{Binding TypeName}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StructureAssetRow">
                        <Panel>
                          <Button Classes="link" Click="OnOpenAssetItem" IsVisible="{Binding HasItemLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheItemBrowser}">
                            <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{x:Static loc:MapText.ColQty}"  Binding="{Binding QuantityText}" SortMemberPath="Quantity"
                                      Width="140" CellStyleClasses="num" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>

            <!-- ── Fighters ────────────────────────────────────────── -->
            <TabItem Header="{x:Static loc:MapText.TabFighters}">
              <DataGrid ItemsSource="{Binding Fighters}" AutoGenerateColumns="False"
                        IsReadOnly="True" RowHeight="22"
                        Background="{DynamicResource SurfaceBaseBrush}" RowBackground="{DynamicResource SurfaceBaseBrush}" BorderThickness="0"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{x:Static loc:MapText.ColFighter}" SortMemberPath="TypeName" Width="*" ClipboardContentBinding="{Binding TypeName}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StructureAssetRow">
                        <Panel>
                          <Button Classes="link" Click="OnOpenAssetItem" IsVisible="{Binding HasItemLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheItemBrowser}">
                            <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{x:Static loc:MapText.ColWhere}"   Binding="{Binding Location}" Width="180" />
                  <DataGridTextColumn Header="{x:Static loc:MapText.ColQty}"     Binding="{Binding QuantityText}" SortMemberPath="Quantity"
                                      Width="110" CellStyleClasses="num" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>

            <!-- ── Industry jobs ───────────────────────────────────── -->
            <TabItem Header="{x:Static loc:MapText.TabIndustryJobs}">
              <Grid RowDefinitions="Auto,*">

                <!-- Filters. Defaulted to the last 90 days: a structure running a while holds
                     thousands of delivered jobs and the recent ones are what anyone wants. -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="8 6" Margin="0 0 0 4"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel>
                      <TextBlock Classes="flabel" Text="{x:Static loc:MapText.EndsFromLabel}" />
                      <TextBox Text="{Binding JobFrom}" Width="110" FontSize="11"
                               Watermark="yyyy-mm-dd" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Classes="flabel" Text="{x:Static loc:MapText.EndsThruLabel}" />
                      <TextBox Text="{Binding JobThru}" Width="110" FontSize="11"
                               Watermark="{x:Static loc:MapText.HintAny}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Classes="flabel" Text="{x:Static loc:MapText.StatusLabel}" />
                      <ComboBox ItemsSource="{Binding JobStatuses}"
                                SelectedItem="{Binding JobStatus}"
                                Width="140" FontSize="11" />
                    </StackPanel>
                    <TextBlock Text="{Binding JobCountText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Bottom" Margin="4 0 0 5" />
                  </StackPanel>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False"
                          IsReadOnly="True" RowHeight="22"
                          Background="{DynamicResource SurfaceBaseBrush}" RowBackground="{DynamicResource SurfaceBaseBrush}" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:MapText.ColActivity}" Binding="{Binding Activity}" Width="130" />
                    <DataGridTemplateColumn Header="{x:Static loc:MapText.ColProduct}" SortMemberPath="Product" Width="*" ClipboardContentBinding="{Binding Product}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:StructureJobRow">
                          <Panel>
                            <Button Classes="link" Click="OnOpenJobProduct" IsVisible="{Binding HasProductLink}" ToolTip.Tip="{x:Static loc:MapText.TipOpenInTheItemBrowser}">
                              <TextBlock Text="{Binding Product}" Classes="linktext"
                                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding Product}" IsVisible="{Binding !HasProductLink}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Panel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static loc:MapText.ColRuns}"     Binding="{Binding Runs}"     Width="70" />
                    <DataGridTextColumn Header="{x:Static loc:MapText.ColStatus}"   Binding="{Binding Status}"   Width="100" />
                    <DataGridTextColumn Header="{x:Static loc:MapText.ColEnds}"     Binding="{Binding EndDate}"  Width="140" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

          </TabControl>
        </Grid>
      </Panel>
    </Border>

    <!-- ── Add by location ID ────────────────────────────────────────────
         Over the whole tool rather than beside the toolbar: the look-up result needs room to
         read, and it is a two-step action that wants finishing before anything else. -->
    <Border Grid.Row="0" Grid.RowSpan="7" IsVisible="{Binding AddOpen}"
            Background="#cc07070b">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              CornerRadius="4" Padding="18 16" Width="460">
        <StackPanel Spacing="10">

          <TextBlock Text="{x:Static loc:MapText.AddAStructureByLocation}" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                     Text="{x:Static loc:MapText.StructuresNormallyArriveOnNote}" />

          <StackPanel>
            <TextBlock Classes="flabel" Text="{x:Static loc:MapText.LocationIdLabel}" />
            <TextBox Text="{Binding AddIdText}" FontSize="12" Watermark="e.g. 1035466617946" />
          </StackPanel>

          <TextBlock Text="{Binding AddStatus}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding AddStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                  CornerRadius="3" Padding="10 8"
                  IsVisible="{Binding AddPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding AddPreview}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:MapText.Cancel}" Command="{Binding CancelAddCommand}"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" Padding="14 4" FontSize="11" />
            <Button Content="{x:Static loc:MapText.LookUp}" Command="{Binding LookupAddCommand}"
                    IsEnabled="{Binding !Busy}"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentSurfaceBrush}"
                    BorderThickness="1" Padding="14 4" FontSize="11" />
            <!-- Enabled only after a look-up, and only for the ID the panel is describing. -->
            <Button Content="{x:Static loc:MapText.Add}" Command="{Binding CommitAddCommand}"
                    IsEnabled="{Binding AddCanCommit}"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}"
                    BorderThickness="1" Padding="20 4" FontSize="11" />
          </StackPanel>

        </StackPanel>
      </Border>
    </Border>

  </Grid>
</UserControl>
