<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.StructureBrowserView"
             x:DataType="vm:StructureBrowserViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="Expander">
      <Setter Property="Margin" Value="0 0 0 4" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#c8a84b" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#bbb" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4 0 0 0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,1,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#12121a" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="#1e1e2a">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">
        <Button Grid.Column="0" Command="{Binding RefreshCommand}" Content="Refresh"
                Background="#1a1a28" Foreground="#5599aa" BorderBrush="#2a3a44"
                BorderThickness="1" Padding="12 4" FontSize="11" />
        <Button Grid.Column="1" Command="{Binding ResolveCommand}" IsEnabled="{Binding !Busy}"
                Content="Resolve via ESI" Background="#1a1a28" Foreground="#c8a84b"
                BorderBrush="#3a3020" BorderThickness="1" Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        <Button Grid.Column="2" Command="{Binding ClearFilters}" Content="Clear Filters"
                Background="#1a1a28" Foreground="#888" BorderBrush="#2a2a3a"
                BorderThickness="1" Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11" Foreground="#666677"
                   VerticalAlignment="Center" Margin="16 0 0 0"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="#1e1e2a" />

    <Grid Grid.Row="2" ColumnDefinitions="220,1,*">

      <!-- ── Filters ─────────────────────────────────────────────────── -->
      <ScrollViewer Grid.Column="0" Background="#0b0b10" Padding="8 8">
        <StackPanel Spacing="2">
          <TextBlock Text="FILTERS" FontSize="10" FontWeight="SemiBold"
                     Foreground="#555566" Margin="2 0 0 6" />

          <Expander Header="Region" IsExpanded="True">
            <ItemsControl ItemsSource="{Binding RegionFilters}" MaxHeight="150">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StructureFilterOption">
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Expander Header="Constellation">
            <ItemsControl ItemsSource="{Binding ConstellationFilters}" MaxHeight="150">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StructureFilterOption">
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Expander Header="System">
            <ScrollViewer MaxHeight="180">
              <ItemsControl ItemsSource="{Binding SystemFilters}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StructureFilterOption">
                  <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>

          <Expander Header="Type">
            <ItemsControl ItemsSource="{Binding TypeFilters}" MaxHeight="150">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StructureFilterOption">
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Expander Header="Corp">
            <ScrollViewer MaxHeight="180">
              <ItemsControl ItemsSource="{Binding CorpFilters}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StructureFilterOption">
                  <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>

          <Expander Header="Alliance">
            <ScrollViewer MaxHeight="180">
              <ItemsControl ItemsSource="{Binding AllianceFilters}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StructureFilterOption">
                  <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <Rectangle Grid.Column="1" Fill="#1e1e2a" />

      <!-- ── Grid ────────────────────────────────────────────────────── -->
      <DataGrid Grid.Column="2"
                ItemsSource="{Binding Rows}"
                AutoGenerateColumns="False"
                CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                IsReadOnly="True"
                Background="#0d0d12" RowBackground="#0d0d12"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                HeadersVisibility="Column" FontSize="11" RowHeight="24" BorderThickness="0">
        <DataGrid.Styles>
          <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#12121a" />
            <Setter Property="Foreground" Value="#555566" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6 6 2 6" />
            <Setter Property="BorderBrush" Value="#1e1e2a" />
            <Setter Property="BorderThickness" Value="0 0 1 1" />
          </Style>
          <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="6 0" />
            <Setter Property="FontSize" Value="11" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Structure" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="*" />
          <DataGridTextColumn Header="System" Binding="{Binding SystemName}" Width="*" />
          <DataGridTextColumn Header="Constellation" Binding="{Binding Constellation}" Width="*" />
          <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="*" />
          <DataGridTextColumn Header="Corp" Binding="{Binding CorpName}" Width="1.4*" />
          <DataGridTextColumn Header="Alliance" Binding="{Binding AllianceName}" Width="1.4*" />
          <DataGridTextColumn Header="Nearest" Binding="{Binding NearestCelestial}" Width="*" />
          <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>
