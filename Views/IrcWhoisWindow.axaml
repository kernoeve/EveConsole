<!-- Who someone on IRC is, as the server says (WHOIS). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.IrcWhoisWindow"
        x:DataType="vm:IrcWhoisVm"
        Title="{Binding Title}"
        Width="460" Height="360" MinWidth="340" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16 12">
    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 0 0 10" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="{x:Static loc:IrcText.WhoisAsking}" IsVisible="{Binding IsAsking}" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:IrcWhoisRow">
              <Grid ColumnDefinitions="150,*" Margin="0 0 0 6">
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="2" Content="{x:Static loc:SettingsText.Close}" Click="OnClose" HorizontalAlignment="Right" Margin="0 10 0 0" FontSize="12" />
  </Grid>
</Window>
