<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="EveConsole.Views.ContractsView"
             x:DataType="vm:ContractsViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize"   Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <TabControl Background="{DynamicResource SurfaceBaseBrush}" SelectedIndex="{Binding TabIndex}">

    <!-- ══ Tab 1: Corporation & Personal ═══════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:MarketText.TabCorporationPersonal}">
      <Grid DataContext="{Binding Owned}" x:DataType="vm:OwnedContractsViewModel"
            RowDefinitions="Auto,*">

        <!-- Filter bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1"
                Padding="12 8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Scope: the contracts from, to, or accepted by the party chosen — every
                 character and personal corporation together by default. -->
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.ScopeLabel}" />
            <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}"
                      MinWidth="230" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.StatusLabel}" />
            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"
                      MinWidth="120" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.AssigneeLabel}" />
            <ComboBox ItemsSource="{Binding Assignees}" SelectedItem="{Binding SelectedAssignee}"
                      MinWidth="170" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.AcceptorLabel}" />
            <ComboBox ItemsSource="{Binding Acceptors}" SelectedItem="{Binding SelectedAcceptor}"
                      MinWidth="170" FontSize="11" VerticalAlignment="Center" />
            <Button Command="{Binding RefreshCommand}" Content="{x:Static loc:MarketText.Refresh}"
                    FontSize="11" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Classes="flabel" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>

        <!-- Grid + detail -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,600">
          <DataGrid Grid.Column="0" x:Name="OwnedGrid"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow}"
                    AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
                    CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                    Background="{DynamicResource SurfaceBaseBrush}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#"        Binding="{Binding ContractId}" Width="80" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColType}"     Binding="{Binding TypeLabel}"  Width="110" />
              <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColStatus}" Width="100" SortMemberPath="Status" ClipboardContentBinding="{Binding Status}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContractRowVm">
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                               FontSize="11" Margin="6 0" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColContents}" Width="*" SortMemberPath="Contents" ClipboardContentBinding="{Binding Contents}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContractRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenContents" IsVisible="{Binding HasContentsLink}"
                              ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheItemBrowser}">
                        <TextBlock Text="{Binding Contents}" Classes="linktext"
                                   TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding Contents}" IsVisible="{Binding !HasContentsLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- From: whose contract it is — the corporation when issued on its behalf, else the character; the character who clicked is in the tooltip. -->
              <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColFrom}" Width="150" SortMemberPath="From" ClipboardContentBinding="{Binding From}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContractRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenFrom" IsVisible="{Binding HasFromLink}"
                              ToolTip.Tip="{Binding FromTip}">
                        <TextBlock Text="{Binding From}" Classes="linktext"
                                   TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding From}" IsVisible="{Binding !HasFromLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColAssignee}" Width="140" SortMemberPath="Assignee" ClipboardContentBinding="{Binding Assignee}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContractRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenAssignee" IsVisible="{Binding HasAssigneeLink}"
                              ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheEntityBrowser}">
                        <TextBlock Text="{Binding Assignee}" Classes="linktext"
                                   TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding Assignee}" IsVisible="{Binding !HasAssigneeLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColAcceptor}" Binding="{Binding Acceptor}" Width="140" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColPrice}"    Binding="{Binding Price}"  SortMemberPath="PriceRaw"  Width="90" CellStyleClasses="num" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColReward}"   Binding="{Binding Reward}" SortMemberPath="RewardRaw" Width="90" CellStyleClasses="num" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColIssued}"   Binding="{Binding DateIssued}"  SortMemberPath="DateIssuedRaw"  Width="130" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColExpires}"  Binding="{Binding DateExpires}" SortMemberPath="DateExpiresRaw" Width="130" />
            </DataGrid.Columns>
          </DataGrid>

          <GridSplitter Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}" Width="4" />

          <Panel Grid.Column="2" Background="{DynamicResource SurfaceBaseBrush}">
            <ContentControl Content="{Binding Detail}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ContractDetailVm">
                  <views:ContractDetailView />
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <TextBlock Text="{x:Static loc:MarketText.SelectAContractToNote}"
                       IsVisible="{Binding Detail, Converter={x:Static conv:ObjectConverters.IsNull}}"
                       FontSize="12" Foreground="{DynamicResource BorderStrongBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.Row="1" IsVisible="{Binding IsLoading}" Background="#99000000">
          <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </TabItem>

    <!-- ══ Tab 2: Public ═══════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:MarketText.TabPublic}">
      <Grid DataContext="{Binding Public}" x:DataType="vm:PublicContractsViewModel"
            RowDefinitions="Auto,*,Auto">

        <!-- Filter bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1"
                Padding="12 8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.ShowLabel}" />
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                      MinWidth="100" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.ContractLabel}" />
            <ComboBox ItemsSource="{Binding ContractTypeOptions}" SelectedItem="{Binding SelectedContractType}"
                      MinWidth="120" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.RegionLabel}" />
            <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}"
                      MinWidth="180" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.CategoryLabel}" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                      MinWidth="180" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.ItemLabel}" />
            <TextBox Text="{Binding TypeFilter, Mode=TwoWay}" Watermark="{x:Static loc:MarketText.HintTypeName}"
                     FontSize="11" Width="160" Height="24"
                     Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="5 2"
                     VerticalAlignment="Center" />
            <Button Command="{Binding ClearFiltersCommand}" Content="{x:Static loc:MarketText.Clear}"
                    FontSize="10" Padding="8 2" Height="24"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    VerticalAlignment="Center" />
            <TextBlock Classes="flabel" Text="{x:Static loc:MarketText.SortLabel}" />
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                      MinWidth="150" FontSize="11" VerticalAlignment="Center" />
            <Button Command="{Binding RefreshCommand}" Content="{x:Static loc:MarketText.Refresh}"
                    FontSize="11" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Classes="flabel" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>

        <!-- Grid + detail -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,600">
          <DataGrid Grid.Column="0"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow}"
                    AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
                    CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                    Background="{DynamicResource SurfaceBaseBrush}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#"        Binding="{Binding ContractId}" Width="80" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColType}"     Binding="{Binding TypeLabel}"  Width="110" />
              <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColStatus}" Width="90" ClipboardContentBinding="{Binding Status}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContractRowVm">
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                               FontSize="11" Margin="6 0" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColContents}" Width="*" SortMemberPath="Contents" ClipboardContentBinding="{Binding Contents}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContractRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenContents" IsVisible="{Binding HasContentsLink}"
                              ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheItemBrowser}">
                        <TextBlock Text="{Binding Contents}" Classes="linktext"
                                   TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding Contents}" IsVisible="{Binding !HasContentsLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColRegion}"   Binding="{Binding Region}"     Width="140" />
              <!-- From: whose contract it is — the corporation when issued on its behalf, else the character; the character who clicked is in the tooltip. -->
              <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColFrom}" Width="150" SortMemberPath="From" ClipboardContentBinding="{Binding From}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContractRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenFrom" IsVisible="{Binding HasFromLink}"
                              ToolTip.Tip="{Binding FromTip}">
                        <TextBlock Text="{Binding From}" Classes="linktext"
                                   TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding From}" IsVisible="{Binding !HasFromLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColPrice}"    Binding="{Binding Price}"  SortMemberPath="PriceRaw"  Width="90" CellStyleClasses="num" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColReward}"   Binding="{Binding Reward}" SortMemberPath="RewardRaw" Width="90" CellStyleClasses="num" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColVolM}"   Binding="{Binding Volume}"     Width="80" CellStyleClasses="num" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColIssued}"   Binding="{Binding DateIssued}"  SortMemberPath="DateIssuedRaw"  Width="130" />
              <DataGridTextColumn Header="{x:Static loc:MarketText.ColExpires}"  Binding="{Binding DateExpires}" SortMemberPath="DateExpiresRaw" Width="130" />
            </DataGrid.Columns>
          </DataGrid>

          <GridSplitter Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}" Width="4" />

          <Panel Grid.Column="2" Background="{DynamicResource SurfaceBaseBrush}">
            <ContentControl Content="{Binding Detail}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ContractDetailVm">
                  <views:ContractDetailView />
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <TextBlock Text="{x:Static loc:MarketText.SelectAContractToNote}"
                       IsVisible="{Binding Detail, Converter={x:Static conv:ObjectConverters.IsNull}}"
                       FontSize="12" Foreground="{DynamicResource BorderStrongBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.Row="1" IsVisible="{Binding IsLoading}" Background="#99000000">
          <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Pager -->
        <Border Grid.Row="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0"
                Padding="12 6">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <Button Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanPrev}"
                    Content="{x:Static loc:MarketText.First}" FontSize="11" Padding="8 2" />
            <Button Command="{Binding PrevPageCommand}"  IsEnabled="{Binding CanPrev}"
                    Content="{x:Static loc:MarketText.Prev}"  FontSize="11" Padding="8 2" />
            <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="12 0" MinWidth="220"
                       TextAlignment="Center" />
            <Button Command="{Binding NextPageCommand}"  IsEnabled="{Binding CanNext}"
                    Content="{x:Static loc:MarketText.Next}"  FontSize="11" Padding="8 2" />
            <Button Command="{Binding LastPageCommand}"  IsEnabled="{Binding CanNext}"
                    Content="{x:Static loc:MarketText.Last}"  FontSize="11" Padding="8 2" />
          </StackPanel>
        </Border>
      </Grid>
    </TabItem>

  </TabControl>
</UserControl>
