<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveCortex.Views"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.AssetBrowserWindow"
        x:DataType="vm:AssetBrowserViewModel"
        Title="Asset Browser"
        Width="1400" Height="800"
        MinWidth="900" MinHeight="500"
        Background="#0d0d12">
  <views:AssetBrowserView DataContext="{Binding}" />
</Window>
