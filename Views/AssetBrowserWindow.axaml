<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:views="clr-namespace:EveConsole.Views"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.AssetBrowserWindow"
        x:DataType="vm:AssetBrowserViewModel"
        Title="{x:Static loc:AssetsText.TitleAssetBrowser}"
        Width="1400" Height="800"
        MinWidth="900" MinHeight="500"
        Background="{DynamicResource SurfaceBaseBrush}">
  <views:AssetBrowserView DataContext="{Binding}" />
</Window>
