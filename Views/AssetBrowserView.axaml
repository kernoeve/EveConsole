<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.AssetBrowserView"
             x:DataType="vm:AssetBrowserViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ── Filter bar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="8 6"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
      <Grid ColumnDefinitions="*,Auto">

        <StackPanel x:Name="FilterRowsPanel"
                    Grid.Column="0"
                    Orientation="Vertical"
                    Spacing="4"
                    VerticalAlignment="Center" />

        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    Spacing="4"
                    Margin="8 0 0 0"
                    VerticalAlignment="Top">
          <Button Content="Apply"
                  Click="OnApplyFilterClick"
                  HorizontalAlignment="Stretch"
                  Padding="12 3"
                  Background="{DynamicResource BorderSubtleBrush}"
                  Foreground="{DynamicResource AccentBrush}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource AccentSurfaceBrush}"
                  FontSize="11" />
          <Button Content="Clear"
                  Click="OnClearFilterClick"
                  HorizontalAlignment="Stretch"
                  Padding="12 3"
                  FontSize="11" />
          <Button x:Name="AddFilterButton"
                  Content="+ Filter"
                  Click="OnAddFilterClick"
                  HorizontalAlignment="Stretch"
                  Padding="12 3"
                  Foreground="{DynamicResource InfoBrush}"
                  FontSize="11" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- ── Tab control ───────────────────────────────────────────────────── -->
    <TabControl Grid.Row="1"
                x:Name="ContentTabs"
                SelectionChanged="OnTabChanged"
                Background="{DynamicResource SurfaceBaseBrush}"
                Padding="0">

      <TabItem Header="Detailed View">
        <DataGrid x:Name="AssetGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="24"
                  ClipboardCopyMode="None"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CellPointerPressed="OnDetailCellPointerPressed"
                  DoubleTapped="OnAssetGridDoubleTapped"
                  KeyDown="OnGridKeyDown" />
      </TabItem>

      <TabItem Header="By Location">
        <DataGrid x:Name="LocationGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="24"
                  ClipboardCopyMode="None"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CellPointerPressed="OnAggCellPointerPressed"
                  KeyDown="OnGridKeyDown" />
      </TabItem>

      <TabItem Header="By System">
        <DataGrid x:Name="SystemGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="24"
                  ClipboardCopyMode="None"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CellPointerPressed="OnAggCellPointerPressed"
                  KeyDown="OnGridKeyDown" />
      </TabItem>

      <TabItem Header="By Region">
        <DataGrid x:Name="RegionGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="24"
                  ClipboardCopyMode="None"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CellPointerPressed="OnAggCellPointerPressed"
                  KeyDown="OnGridKeyDown" />
      </TabItem>

    </TabControl>

    <!-- ── Status bar ─────────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceInputBrush}" Padding="12 6">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Content="Load More"
                IsVisible="{Binding HasMore}"
                Click="OnLoadMoreClick"
                Padding="14 4"
                Background="{DynamicResource BorderSubtleBrush}"
                Foreground="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}"
                Margin="8 0 0 0"
                FontSize="11" />
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextFaintBrush}"
                   FontSize="11"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

  </Grid>

</UserControl>
