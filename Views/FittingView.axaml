<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EveConsole.ViewModels"
             xmlns:fit="using:EveConsole.Services.Fitting"
             xmlns:ctl="using:EveConsole.Controls"
             xmlns:views="using:EveConsole.Views"
             x:Class="EveConsole.Views.FittingView"
             x:DataType="vm:FittingViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin"     Value="0 14 0 4" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize"   Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    </Style>
    <Style Selector="TextBlock.line">
      <Setter Property="FontSize"   Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.over">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Minimum"  Value="0" />
      <Setter Property="Maximum"  Value="1" />
      <Setter Property="Height"   Value="4" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ProgressBar.over">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding"  Value="10 4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- Module state: grey when off, plain when online, lit when active, warm when overheated. -->
    <Style Selector="Button.state">
      <Setter Property="Width"    Value="40" />
      <Setter Property="Padding"  Value="0 2" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.state.off">
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="Button.state.active">
      <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
    </Style>
    <Style Selector="Button.state.heated">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="Button.heat">
      <Setter Property="Width"    Value="30" />
      <Setter Property="Padding"  Value="0 2" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.heat.on">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="Button.remove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6 0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- A fit's tab: the name, a dot when it has unsaved changes, and a close button. -->
    <Style Selector="Border.fittab">
      <Setter Property="Padding" Value="10 5 4 5" />
      <Setter Property="Margin" Value="0 0 2 0" />
      <Setter Property="CornerRadius" Value="3 3 0 0" />
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1 1 1 0" />
    </Style>
    <Style Selector="Border.fittab.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.tabtitle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.fittab.selected Button.tabtitle">
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,*" Background="{DynamicResource SurfaceBaseBrush}">

    <!-- ══ Finder ═══════════════════════════════════════════════════════════ -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0 0 1 0" Padding="10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Items" FontWeight="SemiBold" FontSize="13"
                   Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 8" />
        <ComboBox DockPanel.Dock="Top" ItemsSource="{x:Static vm:FittingViewModel.KindFilters}"
                  SelectedItem="{Binding KindFilter}" HorizontalAlignment="Stretch" Margin="0 0 0 6" />
        <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" Watermark="Search by name or group…" Margin="0 0 0 6" />
        <CheckBox DockPanel.Dock="Top" IsChecked="{Binding FitsOnly}" Content="Only what fits this hull"
                  FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 0 0 6" />
        <!-- Set by clicking an empty slot on the ring. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasFinderSlot}" Margin="0 0 0 6" Padding="8 3"
                Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="3">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding FinderSlotText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="remove" Content="✕" Command="{Binding ClearFinderSlotCommand}"
                    ToolTip.Tip="Show every slot" />
          </Grid>
        </Border>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,6,*" Margin="0 6 0 0">
          <Button Grid.Column="0" Classes="tool" Content="Add to fit" Command="{Binding AddSelectedCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="2" Classes="tool" Content="Add to cargo" Command="{Binding AddToCargoCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Put the selected item in the cargo hold — anything can be carried" />
        </Grid>
        <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}"
                 DoubleTapped="OnResultDoubleTapped"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="fit:CatalogEntry">
              <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding GroupName}">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding SlotLabel}" FontSize="10" Margin="8 0 0 0"
                           Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>


    <!-- ══ Fits, one tab each ═══════════════════════════════════════════════ -->
    <DockPanel Grid.Column="1">

      <!-- The tabs: every hull picked and every fit opened gets its own. -->
      <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    Margin="14 8 14 0" IsVisible="{Binding HasTab}">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FitTabViewModel">
              <Border Classes="fittab" Classes.selected="{Binding IsSelected}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Classes="tabtitle" Content="{Binding TabTitle}" MaxWidth="220"
                          Command="{Binding SelectCommand}" />
                  <TextBlock Text="•" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                             IsVisible="{Binding TabDirty}" ToolTip.Tip="Changed since it was opened or saved" />
                  <Button Classes="remove" Content="✕" FontSize="10" Command="{Binding CloseCommand}" ToolTip.Tip="Close this fit" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0 1 0 0" Padding="14 8 14 0">
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 6">
          <Button Classes="tool" Content="Paste EFT…"       Command="{Binding ImportEftCommand}" Margin="0 0 6 4" />
          <Button Classes="tool" Content="From the game…"   Command="{Binding ImportEsiCommand}" Margin="0 0 6 4"
                  ToolTip.Tip="Open one of your characters' or corporations' saved fittings" />
          <Button Classes="tool" Content="Copy EFT"         Command="{Binding CopyEftCommand}"   Margin="0 0 6 4" />
          <Button Classes="tool" Content="Save…"           Command="{Binding SaveCommand}"      Margin="0 0 12 4"
                  ToolTip.Tip="Save in EVE Console, or to a character's fittings in the game" />
          <ComboBox ItemsSource="{Binding SavedFits}" SelectedItem="{Binding SelectedSaved}" PlaceholderText="Saved fits…"
                    MinWidth="200" Margin="0 0 6 4" FontSize="11" />
          <Button Classes="tool" Content="Delete" Command="{Binding DeleteSavedCommand}" Margin="0 0 0 4"
                  ToolTip.Tip="Delete the saved fit chosen in the list" />
        </WrapPanel>
      </Border>

      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" Margin="14 4 14 8" />

      <Panel>
        <TextBlock Text="Pick a hull from Items (Hulls), or paste or open a fit. Each opens in its own tab."
                   IsVisible="{Binding !HasTab}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ContentControl Content="{Binding SelectedTab}" IsVisible="{Binding HasTab}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:FitTabViewModel">
              <views:FitTabView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
