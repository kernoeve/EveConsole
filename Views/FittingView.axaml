<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EveConsole.ViewModels"
             xmlns:fit="using:EveConsole.Services.Fitting"
             xmlns:ctl="using:EveConsole.Controls"
             xmlns:views="using:EveConsole.Views"
             x:Class="EveConsole.Views.FittingView"
             x:DataType="vm:FittingViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin"     Value="0 14 0 4" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize"   Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    </Style>
    <Style Selector="TextBlock.line">
      <Setter Property="FontSize"   Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.over">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Minimum"  Value="0" />
      <Setter Property="Maximum"  Value="1" />
      <Setter Property="Height"   Value="4" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ProgressBar.over">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding"  Value="10 4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- Module state: grey when off, plain when online, lit when active, warm when overheated. -->
    <Style Selector="Button.state">
      <Setter Property="Width"    Value="40" />
      <Setter Property="Padding"  Value="0 2" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.state.off">
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="Button.state.active">
      <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
    </Style>
    <Style Selector="Button.state.heated">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="Button.heat">
      <Setter Property="Width"    Value="30" />
      <Setter Property="Padding"  Value="0 2" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.heat.on">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
    </Style>
    <!-- Numbers are typed; spinner arrows only crowd the boxes. -->
    <Style Selector="NumericUpDown">
      <Setter Property="ShowButtonSpinner" Value="False" />
    </Style>
    <!-- A fighter ability: lit when on. Damage abilities in the accent, the rest plainer. -->
    <Style Selector="ToggleButton.ability">
      <Setter Property="Padding" Value="7 1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="ToggleButton.ability:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.ability.damage:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.remove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6 0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*" Background="{DynamicResource SurfaceBaseBrush}">

    <!-- ══ Items: what goes on a fit. Hidden with the button on the new-fit bar. ══ -->
    <Border Grid.Column="0" Width="300" IsVisible="{Binding FinderVisible}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0 0 1 0" Padding="10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Items" FontWeight="SemiBold" FontSize="13"
                   Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 8" />
        <ComboBox DockPanel.Dock="Top" ItemsSource="{x:Static vm:FittingViewModel.KindFilters}"
                  SelectedItem="{Binding KindFilter}" HorizontalAlignment="Stretch" Margin="0 0 0 6" />
        <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" Watermark="Search by name or group…" Margin="0 0 0 6" />
        <CheckBox DockPanel.Dock="Top" IsChecked="{Binding FitsOnly}" Content="Only what fits this hull"
                  FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 0 0 6" />
        <!-- Set by clicking an empty slot on the ring. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasFinderSlot}" Margin="0 0 0 6" Padding="8 3"
                Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="3">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding FinderSlotText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="remove" Content="✕" Command="{Binding ClearFinderSlotCommand}"
                    ToolTip.Tip="Show every slot" />
          </Grid>
        </Border>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,6,*" Margin="0 6 0 0">
          <Button Grid.Column="0" Classes="tool" Content="Add to fit" Command="{Binding AddSelectedCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="2" Classes="tool" Content="Add to cargo" Command="{Binding AddToCargoCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Put the selected item in the cargo hold — anything can be carried" />
        </Grid>
        <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}"
                 DoubleTapped="OnResultDoubleTapped"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="fit:CatalogEntry">
              <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding GroupName}">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding SlotLabel}" FontSize="10" Margin="8 0 0 0"
                           Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>


    <!-- ══ Fits: one tab each, on one side or two ══════════════════════════ -->
    <DockPanel Grid.Column="1">

      <!-- Ways to start a fit. Each opens a new tab on the side last clicked. -->
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0 0 0 1" Padding="10 8 10 4">
        <WrapPanel Orientation="Horizontal">
          <ToggleButton Classes="tool" IsChecked="{Binding FinderVisible}" Margin="0 0 12 4" Padding="8 4"
                        Background="{DynamicResource SurfaceRaisedBrush}" FontSize="11"
                        ToolTip.Tip="Show or hide the item list">
            <TextBlock Text="☰ Items" />
          </ToggleButton>
          <TextBlock Text="NEW FIT" Classes="section" Margin="0 0 8 4" VerticalAlignment="Center" />
          <AutoCompleteBox x:Name="HullPicker" Width="260" Margin="0 0 6 4" FontSize="12"
                           Watermark="Hull — type a name or class…"
                           ItemsSource="{Binding Hulls}" FilterMode="Custom" ItemFilter="{Binding HullFilter}"
                           MinimumPrefixLength="1" MaxDropDownHeight="420"
                           ValueMemberBinding="{Binding Name, x:DataType=fit:CatalogEntry}"
                           SelectionChanged="OnHullPicked">
            <AutoCompleteBox.ItemTemplate>
              <DataTemplate x:DataType="fit:CatalogEntry">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontSize="10" Margin="10 0 0 0"
                             Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </AutoCompleteBox.ItemTemplate>
          </AutoCompleteBox>
          <Button Classes="tool" Content="Paste EFT…"     Command="{Binding ImportEftCommand}" Margin="0 0 6 4" />
          <Button Classes="tool" Content="From the game…" Command="{Binding ImportEsiCommand}" Margin="0 0 12 4"
                  ToolTip.Tip="Open one of your characters' or corporations' saved fittings" />
          <ComboBox ItemsSource="{Binding SavedFits}" SelectedItem="{Binding SelectedSaved}" PlaceholderText="Saved fits…"
                    MinWidth="200" Margin="0 0 6 4" FontSize="11" ToolTip.Tip="Open a fit saved in EVE Console" />
          <Button Classes="tool" Content="Delete" Command="{Binding DeleteSavedCommand}" Margin="0 0 0 4"
                  ToolTip.Tip="Delete the saved fit chosen in the list" />
        </WrapPanel>
      </Border>

      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" Margin="14 4 14 8" />

      <Panel>
        <TextBlock Text="Start a fit from a hull, paste one, or open one from the game or your saved fits. Each opens in its own tab."
                   IsVisible="{Binding !HasTab}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="40 0"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- One side, or two halves while the right one holds a tab. -->
        <Grid x:Name="Sides" ColumnDefinitions="*,0" IsVisible="{Binding HasTab}">
          <views:FitPaneView Grid.Column="0" DataContext="{Binding LeftPane}" />
          <Border Grid.Column="1" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1 0 0 0"
                  IsVisible="{Binding IsSplit}">
            <views:FitPaneView DataContext="{Binding RightPane}" />
          </Border>
        </Grid>

        <!-- While a tab is dragged with only one side open: drop it on the right half to open a second. -->
        <Grid ColumnDefinitions="*,*" IsVisible="{Binding ShowSplitDropZone}">
          <Border Grid.Column="1" x:Name="SplitDropZone" DragDrop.AllowDrop="True" Margin="0 34 0 0"
                  Background="{DynamicResource SurfaceOverlayBrush}" BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="2" CornerRadius="4">
            <TextBlock Text="Drop here to see two fits side by side" FontSize="14"
                       Foreground="{DynamicResource TextBrightBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
