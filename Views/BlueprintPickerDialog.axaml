<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.BlueprintPickerDialog"
        Title="Add Items From Blueprint"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}"
        CanResize="False">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="14">

    <!-- Blueprint search -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0 0 0 8">
      <TextBlock Text="BLUEPRINT (search by product name)"
                 FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
      <TextBox x:Name="SearchBox"
               Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
               BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="6 4"
               Watermark="Type to search…"
               TextChanged="OnSearchChanged" />
      <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              CornerRadius="2" MaxHeight="160"
              x:Name="ResultsBorder" IsVisible="False">
        <ListBox x:Name="ResultsListBox"
                 Background="Transparent"
                 SelectionChanged="OnResultSelected">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ProductName}"
                         FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Padding="4 2" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <TextBlock x:Name="SelectedBlueprintText"
                 FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                 IsVisible="False" />
    </StackPanel>

    <!-- ME / Runs -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0 0 0 10">
      <StackPanel Grid.Column="0" Spacing="4" Margin="0 0 6 0">
        <TextBlock Text="ME LEVEL" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
        <NumericUpDown x:Name="MeBox"
                       Value="10" Minimum="0" Maximum="25" Increment="1"
                       Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4" Margin="6 0 0 0">
        <TextBlock Text="RUNS" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
        <NumericUpDown x:Name="RunsBox"
                       Value="1" Minimum="1" Maximum="999999" Increment="1"
                       Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />
      </StackPanel>
    </Grid>

    <!-- Scope / Park -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0 0 0 10">
      <StackPanel Grid.Column="0" Spacing="4" Margin="0 0 6 0">
        <TextBlock Text="MATERIALS FROM" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
        <ComboBox x:Name="ScopeBox"
                  SelectedIndex="0"
                  Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem Content="This Blueprint" />
          <ComboBoxItem Content="Whole Chain" />
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4" Margin="6 0 0 0">
        <TextBlock Text="INDY PARK (whole chain)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
        <ComboBox x:Name="ParkBox"
                  Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                  HorizontalAlignment="Stretch" />
      </StackPanel>
    </Grid>

    <!-- Error -->
    <TextBlock x:Name="ErrorText" Grid.Row="3"
               FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
               IsVisible="False" Margin="0 0 0 6" />

    <!-- OK / Cancel -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"
                VerticalAlignment="Bottom" HorizontalAlignment="Right">
      <Button x:Name="OkButton" Content="ADD ITEMS"
              Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource SurfaceBaseBrush}"
              FontWeight="SemiBold" FontSize="12"
              Padding="14 6" Click="OnOkClick" />
      <Button Content="CANCEL"
              Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextMutedBrush}"
              FontSize="12" Padding="14 6"
              Click="OnCancelClick" />
    </StackPanel>

  </Grid>

</Window>
