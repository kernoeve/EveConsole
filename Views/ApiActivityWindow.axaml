<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        xmlns:views="clr-namespace:EveConsole.Views"
        x:Class="EveConsole.Views.ApiActivityWindow"
        x:DataType="vm:ApiActivityViewModel"
        Title="Background Processes"
        Width="900" Height="560"
        MinWidth="640" MinHeight="340"
        Background="{DynamicResource SurfaceBaseBrush}">

  <!-- The Background Processes tool on its own, for the tray: the monitoring view without the
       application around it. In the main window the same view is a tab under Data / Logs. -->
  <views:BackgroundProcessesView />

</Window>
