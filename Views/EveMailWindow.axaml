<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveCortex.Views"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.EveMailWindow"
        x:DataType="vm:EveMailViewModel"
        Title="Eve Mail"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        Background="#0d0d12">
  <views:EveMailView DataContext="{Binding}" />
</Window>
