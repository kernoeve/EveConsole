<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             xmlns:loc="using:EveConsole.Localization"
             x:Class="EveConsole.Views.IntelHostileLine"
             x:DataType="vm:IntelHostilePilotVm">
  <!-- One hostile pilot in a system's details, where there is room for names: their portrait and name, their
       alliance (or corporation) logo and name, their hull's icon and name, a kill mark when they were on a kill
       here, and how long since they were seen. Pictures are a fixed size (PictureSize: about 20 on the panel, 24
       on the Board), with a placeholder holding the space while they load. -->
  <UserControl.Styles>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Path.flag">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="3,Auto,1.3*,1.3*,1.2*,30,40" ColumnSpacing="6" Margin="0 2" Opacity="{Binding Opacity}"
        Background="Transparent">
    <Border Background="{Binding TierBrush}" Margin="0 2" />

    <Border Grid.Column="1" CornerRadius="20" ClipToBounds="True" VerticalAlignment="Center"
            Width="{Binding $parent[views:IntelHostileLine].PictureSize}" Height="{Binding $parent[views:IntelHostileLine].PictureSize}"
            Background="{DynamicResource SurfacePanelAltBrush}">
      <Image Source="{Binding Pilot.Picture}" />
    </Border>
    <Button Grid.Column="2" Classes="link" Click="OnOpenPicture" DataContext="{Binding Pilot}" ToolTip.Tip="{x:Static loc:IntelText.TipOpenPilot}">
      <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextBrightBrush}" />
    </Button>

    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasGroup}" ClipToBounds="True"
                ToolTip.Tip="{Binding GroupTip}">
      <Border CornerRadius="3" ClipToBounds="True" VerticalAlignment="Center" Background="{DynamicResource SurfacePanelAltBrush}"
              Width="{Binding $parent[views:IntelHostileLine].PictureSize}" Height="{Binding $parent[views:IntelHostileLine].PictureSize}">
        <Image Source="{Binding Group.Picture}" />
      </Border>
      <Button Classes="link" Click="OnOpenPicture" DataContext="{Binding Group}">
        <TextBlock Text="{Binding Text}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasHull}" ClipToBounds="True">
      <Border CornerRadius="3" ClipToBounds="True" VerticalAlignment="Center" Background="{DynamicResource SurfacePanelAltBrush}"
              Width="{Binding $parent[views:IntelHostileLine].PictureSize}" Height="{Binding $parent[views:IntelHostileLine].PictureSize}">
        <Image Source="{Binding Hull.Picture}" />
      </Border>
      <Button Classes="link" Click="OnOpenPicture" DataContext="{Binding Hull}" ToolTip.Tip="{x:Static loc:IntelText.TipOpenHull}">
        <TextBlock Text="{Binding Text}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
      <Panel Background="Transparent" IsVisible="{Binding OnKill}" ToolTip.Tip="{x:Static loc:IntelText.TipOnKill}">
        <Path Classes="flag" Stroke="{DynamicResource BadBrush}" Data="M6,2 A4,4 0 1 1 5.99,2 Z M6,0 V3.5 M6,8.5 V12 M0,6 H3.5 M8.5,6 H12" />
      </Panel>
      <Panel Background="Transparent" IsVisible="{Binding NoVisual}" ToolTip.Tip="{x:Static loc:IntelText.FlagNoVisual}">
        <Path Classes="flag" Stroke="{DynamicResource InfoBrush}"
              Data="M0.5,6 Q6,0.5 11.5,6 Q6,11.5 0.5,6 Z M6,4.5 A1.5,1.5 0 1 1 5.99,4.5 Z M1.5,10.5 L10.5,1.5" />
      </Panel>
    </StackPanel>
    <Border Grid.Column="6" CornerRadius="3" Padding="4 0" VerticalAlignment="Center" MinWidth="34"
            Background="{DynamicResource SurfacePanelAltBrush}" ToolTip.Tip="{Binding TimeTip}">
      <TextBlock Text="{Binding AgeText}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </Border>
  </Grid>
</UserControl>
