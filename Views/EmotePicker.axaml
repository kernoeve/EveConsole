<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:views="using:EveConsole.Views"
             x:Class="EveConsole.Views.EmotePicker"
             x:DataType="views:EmotePicker"
             Width="404" Height="340">

  <UserControl.Styles>
    <Style Selector="ListBox#RowList ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#RowList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#RowList ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.cell"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" /><Setter Property="Padding" Value="4" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <TextBox x:Name="SearchBox" Grid.Row="0" Margin="4 2 4 6" FontSize="12" Watermark="{x:Static loc:JabberText.EmoteSearchHint}" />

    <TextBlock x:Name="Nothing" Grid.Row="1" IsVisible="False" Text="{x:Static loc:JabberText.EmoteNoneFound}" FontSize="11"
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />

    <!-- Rows of pictures, so a pack of a thousand stays virtualized. -->
    <ListBox x:Name="RowList" Grid.Row="1" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="views:EmotePickRow">
          <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:EmotePickCell">
                <Button Classes="cell" Click="OnPick" PointerEntered="OnCellEnter" PointerExited="OnCellLeave" ToolTip.Tip="{Binding Tip}">
                  <views:EmoteView Emote="{Binding Item.Emote}" Box="32" Still="True" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="Hovered" Grid.Row="2" Margin="6 4 6 0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
  </Grid>
</UserControl>
