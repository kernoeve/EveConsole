<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EveConsole.Views.IncomeExpenseView"
             x:DataType="vm:IncomeExpenseViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="Auto,*,*" Margin="0">

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="12 8" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1"
            IsVisible="{Binding ShowHeader}">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="{x:Static loc:FinanceText.IncomeExpense}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                   VerticalAlignment="Center" Margin="0 0 12 0" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <!-- Income (left) + Expenses (right) -->
    <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="12 10 12 6">

      <Border Grid.Column="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
              CornerRadius="4" Padding="12 10">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 6">
            <TextBlock Text="{x:Static loc:FinanceText.IncomeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" />
            <TextBlock Grid.Column="1" Text="{Binding IncomeTotal}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" />
          </Grid>
          <ScrollViewer Grid.Row="1" x:Name="IncomeList" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding IncomeRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IncomeExpenseRowVm">
                  <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8 0 0 0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
              CornerRadius="4" Padding="12 10">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 6">
            <TextBlock Text="{x:Static loc:FinanceText.ExpensesLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" />
            <TextBlock Grid.Column="1" Text="{Binding ExpenseTotal}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BadBrush}" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ExpenseRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IncomeExpenseRowVm">
                  <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8 0 0 0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>

    <!-- Daily income / expense / cashflow -->
    <Border Grid.Row="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
            CornerRadius="4" Margin="12 0 12 12" Padding="10 8" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <!-- ⚠️ The legend is ours, in the title row, not the chart's. On the Overview card this
             panel is barely a hundred pixels tall: the chart's own legend took a third of that,
             and with the chart's old 150 px minimum it was drawn over the title (on macOS, whose
             larger default text made it plain). The colours are the series' own, from
             IncomeExpenseViewModel's Line(...) calls; change them together. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0 0 0 6">
          <TextBlock Text="{x:Static loc:FinanceText.DailyIncomeExpenseCashflow}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="16 0 8 0" ClipToBounds="True"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Width="10" Height="2" Background="#70AD47" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static loc:FinanceText.SeriesIncome}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Width="10" Height="2" Background="#E05252" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static loc:FinanceText.SeriesExpense}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Width="10" Height="3" Background="#C8A84B" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static loc:FinanceText.SeriesCashflow}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding NetTotal, StringFormat={x:Static loc:FinanceText.FmtNet}}" FontSize="11"
                     FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        </Grid>
        <lvc:CartesianChart Grid.Row="1" MinHeight="90"
                            Series="{Binding Series}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            LegendPosition="Hidden"
                            TooltipPosition="Top"
                            EasingFunction="{x:Null}"
                            Background="Transparent" />
      </Grid>
    </Border>

  </Grid>
</UserControl>
