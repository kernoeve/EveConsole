<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveCortex.Views"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.NetWorthWindow"
        x:DataType="vm:NetWorthViewModel"
        Title="Net Worth"
        Width="1100" Height="700"
        MinWidth="700" MinHeight="500"
        Background="#0d0d12">
  <views:NetWorthView DataContext="{Binding}" />
</Window>
