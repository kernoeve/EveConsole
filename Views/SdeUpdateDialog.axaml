<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.SdeUpdateDialog"
        x:DataType="vm:SdeViewModel"
        Title="{x:Static loc:SettingsText.TitleEveStaticDataUpdate}"
        Width="480" Height="370"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <StackPanel Margin="24" Spacing="14">

    <!-- ── Phase 1: Prompt (hidden once import starts) ── -->
    <StackPanel x:Name="PromptPanel" Spacing="14">

      <TextBlock Text="{x:Static loc:SettingsText.ANewerEveStaticNote}"
                 FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />

      <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.LoadedLabel}"
                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0 0 0 4" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LoadedBuild}"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0 0 0 4" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.LatestLabel}"
                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestBuild}"
                   Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Content="{x:Static loc:SettingsText.UpdateNow}" Click="OnUpdateNow" Padding="16 5" />
        <Button Content="{x:Static loc:SettingsText.Later}"      Click="OnLater"     Padding="16 5" />
      </StackPanel>

    </StackPanel>

    <!-- ── Phase 2: Running (shown while IsBusy) ── -->
    <StackPanel x:Name="ProgressPanel" IsVisible="False" Spacing="10">

      <TextBlock Text="{x:Static loc:SettingsText.UpdatingEveStaticData}"
                 FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />

      <ProgressBar Value="{Binding Fraction}"
                   Minimum="0" Maximum="1"
                   Height="8" />

      <TextBlock Text="{Binding StatusText}"
                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                 TextWrapping="Wrap" />

    </StackPanel>

    <!-- ── Phase 3: Done ── -->
    <StackPanel x:Name="DonePanel" IsVisible="False" Spacing="10">

      <TextBlock Text="{x:Static loc:SettingsText.SdeUpdateComplete}"
                 FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />

      <TextBlock Text="{Binding StatusText}"
                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                 TextWrapping="Wrap" />

      <Button Content="{x:Static loc:SettingsText.Close}" Click="OnClose"
              HorizontalAlignment="Right" Padding="16 5" />

    </StackPanel>

    <!-- ── Divider ── -->
    <Rectangle Height="1" Fill="{DynamicResource SurfaceHoverBrush}" Margin="0 4" />

    <!-- ── Hoboleaks section ── -->
    <StackPanel Spacing="10">

      <TextBlock Text="{x:Static loc:SettingsText.HoboleaksComplement}"
                 FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" />

      <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                 Text="{x:Static loc:SettingsText.BlueprintsReprocessingCompressionAndNote}" />

      <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.LoadedLabel}"
                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0 0 0 4" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HoboImportedAt}"
                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0 0 0 4" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.LatestLabel}"
                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HoboLatest}"
                   Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
      </Grid>

      <!-- Hobo progress (visible while running) -->
      <StackPanel x:Name="HoboProgressPanel" IsVisible="False" Spacing="6">
        <ProgressBar Value="{Binding HoboFraction}" Minimum="0" Maximum="1" Height="6" />
        <TextBlock Text="{Binding HoboStatusText}"
                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <Button x:Name="HoboImportButton"
              Content="{x:Static loc:SettingsText.ImportFromHoboleaks}"
              Click="OnHoboImport"
              IsEnabled="{Binding !HoboIsBusy}"
              HorizontalAlignment="Left"
              Padding="14 5"
              FontSize="11" />

    </StackPanel>

  </StackPanel>
</Window>
