<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveCortex.Views"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.EsiExplorerWindow"
        x:DataType="vm:EsiExplorerViewModel"
        Title="ESI Data Explorer"
        Width="1200" Height="700"
        MinWidth="800" MinHeight="500"
        Background="#0d0d12">
  <views:EsiExplorerView DataContext="{Binding}" />
</Window>
