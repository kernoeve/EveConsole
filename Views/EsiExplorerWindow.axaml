<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveConsole.Views"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.EsiExplorerWindow"
        x:DataType="vm:EsiExplorerViewModel"
        Title="ESI Data Explorer"
        Width="1200" Height="700"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource SurfaceBaseBrush}">
  <views:EsiExplorerView DataContext="{Binding}" />
</Window>
