<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.FitSelectorWindow"
        x:CompileBindings="False"
        Title="Add Items From Fit"
        Width="800" Height="600"
        MinWidth="600" MinHeight="440"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d12">

  <Window.Styles>

    <!-- TreeView chrome -->
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4 4" />
    </Style>

    <!-- TreeViewItem defaults -->
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
      <Setter Property="Foreground" Value="#c8c8d8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="2 2" />
    </Style>

    <!-- Selected item highlight -->
    <Style Selector="TreeViewItem:selected > /template/ Border#PART_Header">
      <Setter Property="Background" Value="#1a2a3a" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TreeViewItem:pointerover > /template/ Border#PART_Header">
      <Setter Property="Background" Value="#15202c" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover > /template/ Border#PART_Header">
      <Setter Property="Background" Value="#1e3040" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="14">

    <!-- ── Group selector ───────────────────────────────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0 0 0 10">
      <TextBlock Grid.Column="0"
                 Text="ADD TO GROUP:" FontSize="10" FontWeight="SemiBold"
                 Foreground="#555566" LetterSpacing="1"
                 VerticalAlignment="Center" Margin="0 0 10 0" />
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding Groups}"
                SelectedItem="{Binding SelectedGroup}"
                Background="#131320" BorderBrush="#2a2a3a" Foreground="#c8c8d8"
                FontSize="12" HorizontalAlignment="Left" MinWidth="220">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding GroupName}" FontSize="12" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- ── Tree + detail panel ──────────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="*,5,300">

      <!-- Tree view -->
      <Border Grid.Column="0"
              Background="#080810" BorderBrush="#1a1a28" BorderThickness="1"
              CornerRadius="3">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0"
                     Text="FITS" FontSize="10" FontWeight="SemiBold"
                     Foreground="#555566" LetterSpacing="1" Margin="8 8 8 4" />

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <TreeView ItemsSource="{Binding RootNodes}"
                      SelectedItem="{Binding SelectedNode}">
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:FitTreeNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 1">
                    <!-- Colored dot badge: only shown for Fit leaf nodes -->
                    <Ellipse IsVisible="{Binding IsFit}"
                             Width="8" Height="8"
                             Fill="{Binding SourceBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="#c8c8d8" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Drag splitter -->
      <GridSplitter Grid.Column="1"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    Background="#1a1a28" />

      <!-- Fit detail panel -->
      <Border Grid.Column="2"
              Background="#080810" BorderBrush="#1a1a28" BorderThickness="1"
              CornerRadius="3">
        <Grid RowDefinitions="Auto,Auto,*">

          <TextBlock Grid.Row="0"
                     Text="FIT CONTENTS" FontSize="10" FontWeight="SemiBold"
                     Foreground="#555566" LetterSpacing="1" Margin="8 8 8 2" />

          <!-- Source badge row when a fit is selected -->
          <StackPanel Grid.Row="1"
                      IsVisible="{Binding HasSelectedFit}"
                      Orientation="Horizontal" Spacing="6" Margin="8 0 8 6">
            <Ellipse Width="8" Height="8"
                     Fill="{Binding SelectedNode.SourceBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedNode.SourceBadge}"
                       FontSize="10" Foreground="#888899" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedNode.Entry.OwnerName}"
                       FontSize="10" Foreground="#666677" VerticalAlignment="Center" />
          </StackPanel>

          <ScrollViewer Grid.Row="2" Padding="8 0 8 8">
            <ItemsControl ItemsSource="{Binding DetailLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:FitDetailLine">
                  <TextBlock Text="{Binding Text}"
                             FontSize="11"
                             Foreground="{Binding Foreground}"
                             FontWeight="{Binding FontWeight}"
                             Margin="{Binding Margin}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>

    <!-- ── Bottom bar: status + buttons ────────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0 10 0 0">
      <TextBlock Grid.Column="0"
                 Text="{Binding StatusText}"
                 FontSize="11" Foreground="#555566"
                 VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1"
              Content="Cancel" Click="OnCancelClick"
              Background="#1a1a28" Foreground="#888899"
              BorderBrush="#2a2a3a" BorderThickness="1"
              Padding="14 6" Margin="0 0 8 0" />
      <Button Grid.Column="2"
              Content="Add Items" Click="OnConfirmClick"
              IsEnabled="{Binding CanConfirm}"
              Background="#1a2030" Foreground="#c8a84b"
              BorderBrush="#3a3020" BorderThickness="1"
              Padding="14 6" />
    </Grid>

  </Grid>
</Window>
