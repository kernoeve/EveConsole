<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="using:EveConsole.Views"
             x:Class="EveConsole.Views.PanelDmControl"
             x:DataType="vm:PanelDmVm"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="ListBox.lines ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox.lines ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox.lines ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#PeopleList ListBoxItem"><Setter Property="Padding" Value="6 4" /><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector=":is(TextBlock).deleted"><Setter Property="FontStyle" Value="Italic" /><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /></Style>
    <Style Selector="Ellipse.dot"><Setter Property="Width" Value="7" /><Setter Property="Height" Value="7" /><Setter Property="Fill" Value="{DynamicResource TextFaintBrush}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Ellipse.dot.green"><Setter Property="Fill" Value="{DynamicResource GoodBrush}" /></Style>
    <Style Selector="Ellipse.dot.amber"><Setter Property="Fill" Value="{DynamicResource WarnBrush}" /></Style>
    <Style Selector="Border.count"><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="5 0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Background" Value="{DynamicResource WarnBrush}" /></Style>
    <Style Selector="Border.count TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource SurfaceBaseBrush}" /></Style>
  </UserControl.Styles>

  <!-- Who on the left, by name only; their conversation in the rest. -->
  <Grid ColumnDefinitions="150,*">
    <Border Grid.Column="0" Background="{DynamicResource SurfacePanelBrush}">
      <Panel>
        <TextBlock IsVisible="{Binding HasNoPeople}" Text="{x:Static loc:MessagesText.NoConversations}" TextWrapping="Wrap" Margin="8"
                   FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
        <ListBox x:Name="PeopleList" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessagesConversationVm">
              <Grid ColumnDefinitions="12,*,Auto" ToolTip.Tip="{Binding Where}">
                <Ellipse Classes="dot" Classes.green="{Binding DotGreen}" Classes.amber="{Binding DotAmber}" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Border Grid.Column="2" Classes="count" IsVisible="{Binding HasUnread}" Margin="4 0 0 0"><TextBlock Text="{Binding UnreadText}" /></Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </Border>

    <TextBlock Grid.Column="1" IsVisible="{Binding ShowNothingOpen}" Text="{x:Static loc:MessagesText.NothingOpen}" TextWrapping="Wrap"
               TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" FontSize="11"
               Foreground="{DynamicResource TextFaintBrush}" />

    <!-- ⚠️ Shown from outside: on the grid itself, this would be asked of the conversation, not of the control. -->
    <Panel Grid.Column="1" IsVisible="{Binding HasConversation}">
      <Grid DataContext="{Binding Conversation}" x:DataType="vm:MessagesTabVm" RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="10 5" Background="{DynamicResource SurfaceHeaderBrush}">
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Where}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>

        <ListBox x:Name="LineList" Classes="lines" Grid.Row="1" ItemsSource="{Binding Lines}" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessagesLineVm">
              <Grid ColumnDefinitions="Auto,*" Margin="8 3" Background="Transparent">
                <views:AvatarView Of="{Binding Avatar}" Size="22" VerticalAlignment="Top" Margin="0 2 8 0" />
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" />
                    <TextBlock Text="{Binding When}" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                  </StackPanel>
                  <views:EmoteTextBlock Body="{Binding Body}" Emotes="{Binding Emotes}" Classes.deleted="{Binding IsDeleted}"
                                        TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2">
          <TextBlock Text="{Binding TypingText}" IsVisible="{Binding IsSomeoneTyping}" FontSize="10" Margin="8 2 8 0" Foreground="{DynamicResource TextFaintBrush}" />
          <TextBlock Text="{Binding CannotSend}" IsVisible="{Binding HasCannotSend}" TextWrapping="Wrap" FontSize="11" Margin="8 2 8 0" Foreground="{DynamicResource WarnBrush}" />
          <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" FontSize="11" Margin="8 2 8 0" Foreground="{DynamicResource BadBrush}" />
          <Grid ColumnDefinitions="*,Auto" Margin="6 4">
            <TextBox x:Name="DraftBox" Text="{Binding Draft}" IsEnabled="{Binding CanSend}" AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="90"
                     FontSize="12" Watermark="{x:Static loc:JabberText.MessageHint}" />
            <Button Grid.Column="1" Content="{x:Static loc:JabberText.Send}" Command="{Binding SendCommand}" Margin="6 0 0 0"
                    VerticalAlignment="Bottom" FontSize="12" />
          </Grid>
        </StackPanel>
      </Grid>
    </Panel>
  </Grid>
</UserControl>
