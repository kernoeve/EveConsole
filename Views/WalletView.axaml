<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveCortex.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EveCortex.Views.WalletView"
             x:DataType="vm:WalletViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background"  Value="#12121a" />
      <Setter Property="Foreground"  Value="#555566" />
      <Setter Property="FontSize"    Value="10" />
      <Setter Property="FontWeight"  Value="SemiBold" />
      <Setter Property="Padding"     Value="6 5 2 5" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="0 0 0 1"
            Padding="12 8">
      <Grid ColumnDefinitions="Auto,16,Auto,*,Auto,12,Auto">

        <!-- Owner picker -->
        <TextBlock Grid.Column="0" Text="Owner:" FontSize="12" Foreground="#888899"
                   VerticalAlignment="Center" />
        <ComboBox Grid.Column="2"
                  ItemsSource="{Binding Owners}"
                  SelectedItem="{Binding SelectedOwner}"
                  MinWidth="220" FontSize="12"
                  VerticalAlignment="Center" />

        <!-- Period picker -->
        <ComboBox Grid.Column="4"
                  ItemsSource="{Binding Periods}"
                  SelectedItem="{Binding SelectedPeriod}"
                  MinWidth="140" FontSize="12"
                  VerticalAlignment="Center" />

        <!-- Refresh -->
        <Button Grid.Column="6"
                Command="{Binding RefreshCommand}"
                Content="↻ Refresh"
                FontSize="12"
                VerticalAlignment="Center" />

      </Grid>
    </Border>

    <!-- ── Balance bar ────────────────────────────────────────────────────── -->
    <Border Grid.Row="1" Background="#0d0d12" BorderBrush="#1e1e2a" BorderThickness="0 0 0 1"
            Padding="14 6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="Balance:" FontSize="11" Foreground="#555566"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="{Binding BalanceText}"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="#c8a84b"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ── Status overlay + tabs ─────────────────────────────────────────── -->
    <Grid Grid.Row="2">

      <TabControl Background="#0d0d12">

        <!-- ════ Overview ══════════════════════════════════════════════════ -->
        <TabItem Header="Overview">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,16,*" Margin="12 12 12 12">

              <!-- Income pie -->
              <Border Grid.Column="0" Background="#0d0d12" CornerRadius="3"
                      BorderBrush="#1e1e2a" BorderThickness="1" Padding="10 8">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Income" FontSize="11" FontWeight="SemiBold"
                               Foreground="#555566" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding IncomeTotalText}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#c8a84b" VerticalAlignment="Center" />
                  </Grid>
                  <lvc:PieChart IsVisible="{Binding HasIncomeData}"
                                Series="{Binding IncomeSeries}"
                                Height="220"
                                LegendPosition="Right"
                                LegendTextSize="10"
                                Background="Transparent" />
                  <TextBlock IsVisible="{Binding !HasIncomeData}"
                             Text="No income data for this period."
                             FontSize="11" Foreground="#444455"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0 60" />
                </StackPanel>
              </Border>

              <!-- Expenses pie -->
              <Border Grid.Column="2" Background="#0d0d12" CornerRadius="3"
                      BorderBrush="#1e1e2a" BorderThickness="1" Padding="10 8">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Expenses" FontSize="11" FontWeight="SemiBold"
                               Foreground="#555566" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ExpenseTotalText}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#c8a84b" VerticalAlignment="Center" />
                  </Grid>
                  <lvc:PieChart IsVisible="{Binding HasExpenseData}"
                                Series="{Binding ExpenseSeries}"
                                Height="220"
                                LegendPosition="Right"
                                LegendTextSize="10"
                                Background="Transparent" />
                  <TextBlock IsVisible="{Binding !HasExpenseData}"
                             Text="No expense data for this period."
                             FontSize="11" Foreground="#444455"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0 60" />
                </StackPanel>
              </Border>

            </Grid>
          </ScrollViewer>
        </TabItem>

        <!-- ════ Journal ═══════════════════════════════════════════════════ -->
        <TabItem Header="Journal">
          <Grid RowDefinitions="Auto,*,Auto">
            <!-- Filter bar -->
            <Border Grid.Row="0" Background="#0d111a" BorderBrush="#1e1e2a" BorderThickness="0 0 0 1"
                    Padding="8 5">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Type:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <TextBox Text="{Binding JournalTypeFilter, Mode=TwoWay}"
                         Watermark="filter…" FontSize="11" Width="130" Height="22"
                         Background="#12121a" Foreground="#c8c8d8" BorderBrush="#2a2a3a" Padding="5 2" />
                <TextBlock Text="Owner:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <TextBox Text="{Binding JournalOwnerFilter, Mode=TwoWay}"
                         Watermark="filter…" FontSize="11" Width="120" Height="22"
                         Background="#12121a" Foreground="#c8c8d8" BorderBrush="#2a2a3a" Padding="5 2" />
                <TextBlock Text="Div:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <TextBox Text="{Binding JournalDivFilter, Mode=TwoWay}"
                         Watermark="filter…" FontSize="11" Width="90" Height="22"
                         Background="#12121a" Foreground="#c8c8d8" BorderBrush="#2a2a3a" Padding="5 2" />
                <TextBlock Text="From:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <CalendarDatePicker SelectedDate="{Binding JournalFromDate, Mode=TwoWay}"
                                    FontSize="11" Width="120" Height="22" />
                <TextBlock Text="Thru:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <CalendarDatePicker SelectedDate="{Binding JournalThruDate, Mode=TwoWay}"
                                    FontSize="11" Width="120" Height="22" />
                <Button Content="Clear" Command="{Binding ClearJournalFiltersCommand}"
                        FontSize="10" Padding="8 2" Height="22"
                        Background="#1a1a2a" Foreground="#888899"
                        BorderBrush="#2a2a3a" BorderThickness="1"
                        VerticalAlignment="Center" />
                <TextBlock Text="Sort:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding JournalSortOptions}" SelectedItem="{Binding SelectedJournalSort}"
                          FontSize="11" MinWidth="150" Height="22" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <DataGrid Grid.Row="1"
                      x:Name="JournalGrid"
                      ItemsSource="{Binding JournalRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="24"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date"        Binding="{Binding DateText}"    Width="130" />
                <DataGridTextColumn Header="Type"        Binding="{Binding RefTypeText}" Width="180" />
                <DataGridTemplateColumn Header="Amount"  Width="110" SortMemberPath="AmountRaw">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WalletJournalRowVm">
                      <TextBlock Text="{Binding AmountText}"
                                 Foreground="{Binding AmountColor}"
                                 HorizontalAlignment="Right"
                                 Margin="8 0"
                                 VerticalAlignment="Center"
                                 FontSize="12" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Balance"     Binding="{Binding BalanceText}" SortMemberPath="BalanceRaw" Width="110" />
                <DataGridTextColumn Header="Owner"       Binding="{Binding OwnerText}"   Width="140" />
                <DataGridTextColumn Header="Div"         Binding="{Binding DivisionText}" Width="100" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Background="#0d111a" BorderBrush="#1e1e2a" BorderThickness="0 1 0 0" Padding="8 5">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Button Command="{Binding JournalPager.FirstPageCommand}" IsEnabled="{Binding JournalPager.CanPrev}" Content="⏮ First" FontSize="11" Padding="8 2" />
                <Button Command="{Binding JournalPager.PrevPageCommand}"  IsEnabled="{Binding JournalPager.CanPrev}" Content="◀ Prev"  FontSize="11" Padding="8 2" />
                <TextBlock Text="{Binding JournalPager.PageInfo}" FontSize="11" Foreground="#aab" VerticalAlignment="Center" Margin="12 0" MinWidth="200" TextAlignment="Center" />
                <Button Command="{Binding JournalPager.NextPageCommand}"  IsEnabled="{Binding JournalPager.CanNext}" Content="Next ▶"  FontSize="11" Padding="8 2" />
                <Button Command="{Binding JournalPager.LastPageCommand}"  IsEnabled="{Binding JournalPager.CanNext}" Content="Last ⏭"  FontSize="11" Padding="8 2" />
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <!-- ════ Market Transactions ═══════════════════════════════════════ -->
        <TabItem Header="Market Transactions">
          <Grid RowDefinitions="Auto,*,Auto">
            <!-- Filter bar -->
            <Border Grid.Row="0" Background="#0d111a" BorderBrush="#1e1e2a" BorderThickness="0 0 0 1"
                    Padding="8 5">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Item:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <TextBox Text="{Binding TxnItemFilter, Mode=TwoWay}"
                         Watermark="filter…" FontSize="11" Width="160" Height="22"
                         Background="#12121a" Foreground="#c8c8d8" BorderBrush="#2a2a3a" Padding="5 2" />
                <TextBlock Text="B/S:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding DirectionOptions}"
                          SelectedItem="{Binding TxnDirectionFilter, Mode=TwoWay}"
                          FontSize="11" Width="70" Height="22" />
                <TextBlock Text="Location:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <TextBox Text="{Binding TxnLocationFilter, Mode=TwoWay}"
                         Watermark="filter…" FontSize="11" Width="150" Height="22"
                         Background="#12121a" Foreground="#c8c8d8" BorderBrush="#2a2a3a" Padding="5 2" />
                <TextBlock Text="Owner:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <TextBox Text="{Binding TxnOwnerFilter, Mode=TwoWay}"
                         Watermark="filter…" FontSize="11" Width="120" Height="22"
                         Background="#12121a" Foreground="#c8c8d8" BorderBrush="#2a2a3a" Padding="5 2" />
                <TextBlock Text="Div:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <TextBox Text="{Binding TxnDivFilter, Mode=TwoWay}"
                         Watermark="filter…" FontSize="11" Width="90" Height="22"
                         Background="#12121a" Foreground="#c8c8d8" BorderBrush="#2a2a3a" Padding="5 2" />
                <Button Content="Clear" Command="{Binding ClearTxnFiltersCommand}"
                        FontSize="10" Padding="8 2" Height="22"
                        Background="#1a1a2a" Foreground="#888899"
                        BorderBrush="#2a2a3a" BorderThickness="1"
                        VerticalAlignment="Center" />
                <TextBlock Text="Sort:" FontSize="11" Foreground="#555566" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding TxnSortOptions}" SelectedItem="{Binding SelectedTxnSort}"
                          FontSize="11" MinWidth="150" Height="22" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <DataGrid Grid.Row="1"
                      x:Name="TxnGrid"
                      ItemsSource="{Binding TransactionRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="24"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date"       Binding="{Binding DateText}"  Width="130" />
                <DataGridTextColumn Header="Item"       Binding="{Binding TypeName}"  Width="220" />
                <DataGridTextColumn Header="Qty"        Binding="{Binding Quantity}"  SortMemberPath="QuantityRaw"  Width="80" />
                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice}" SortMemberPath="UnitPriceRaw" Width="110" />
                <DataGridTemplateColumn Header="Total"  Width="120" SortMemberPath="TotalRaw">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WalletTransactionRowVm">
                      <TextBlock Text="{Binding Total}"
                                 Foreground="{Binding TotalColor}"
                                 HorizontalAlignment="Right"
                                 Margin="8 0"
                                 VerticalAlignment="Center"
                                 FontSize="12" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="B/S"        Binding="{Binding Direction}"    Width="50" />
                <DataGridTextColumn Header="Location"   Binding="{Binding LocationName}" Width="200" />
                <DataGridTextColumn Header="Owner"      Binding="{Binding OwnerText}"    Width="140" />
                <DataGridTextColumn Header="Div"        Binding="{Binding DivisionText}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Background="#0d111a" BorderBrush="#1e1e2a" BorderThickness="0 1 0 0" Padding="8 5">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Button Command="{Binding TxnPager.FirstPageCommand}" IsEnabled="{Binding TxnPager.CanPrev}" Content="⏮ First" FontSize="11" Padding="8 2" />
                <Button Command="{Binding TxnPager.PrevPageCommand}"  IsEnabled="{Binding TxnPager.CanPrev}" Content="◀ Prev"  FontSize="11" Padding="8 2" />
                <TextBlock Text="{Binding TxnPager.PageInfo}" FontSize="11" Foreground="#aab" VerticalAlignment="Center" Margin="12 0" MinWidth="200" TextAlignment="Center" />
                <Button Command="{Binding TxnPager.NextPageCommand}"  IsEnabled="{Binding TxnPager.CanNext}" Content="Next ▶"  FontSize="11" Padding="8 2" />
                <Button Command="{Binding TxnPager.LastPageCommand}"  IsEnabled="{Binding TxnPager.CanNext}" Content="Last ⏭"  FontSize="11" Padding="8 2" />
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <!-- ════ Divisions (corp only) ══════════════════════════════════════ -->
        <TabItem Header="Divisions" IsVisible="{Binding ShowDivisions}">
          <DataGrid ItemsSource="{Binding DivisionRows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    RowHeight="28"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#"         Binding="{Binding Division}"    Width="50" />
              <DataGridTextColumn Header="Name"      Binding="{Binding Name}"        Width="200" />
              <DataGridTextColumn Header="Balance"   Binding="{Binding BalanceText}" Width="160" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

      </TabControl>

      <!-- Loading overlay -->
      <Border IsVisible="{Binding IsLoading}"
              Background="#99000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="{Binding StatusText}"
                     FontSize="13" Foreground="#aaaacc"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

    </Grid>

  </Grid>
</UserControl>
