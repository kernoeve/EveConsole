<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.SalesTrackerView"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="vm:SalesTrackerViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" />
      <Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>

    <!-- A link in a grid cell. The button carries no chrome, so the row still reads as a row.
         ⚠️ No Foreground, matching the killmail tool and the system page: a link keeps whatever
         colour its column already had. In a grid where nearly every name is clickable, colouring
         them all would say nothing about which ones matter. The cursor and the hover underline
         carry the affordance instead, and at rest the row looks exactly as it did. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Header + filters -->
    <Border Grid.Row="0" Background="#0d0d12" Padding="10 6" BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Sales Tracker" FontSize="13" FontWeight="SemiBold" Foreground="#c8a84b"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#888899"
                     VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <StackPanel.Styles>
            <Style Selector="TextBlock.fl">
              <Setter Property="Foreground" Value="#555566" /><Setter Property="FontSize" Value="11" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="TextBox">
              <Setter Property="Background" Value="#131320" /><Setter Property="BorderBrush" Value="#2a2a3a" />
              <Setter Property="Foreground" Value="#ccccdd" /><Setter Property="FontSize" Value="11" />
            </Style>
            <Style Selector="ComboBox">
              <Setter Property="Background" Value="#131320" /><Setter Property="BorderBrush" Value="#2a2a3a" />
              <Setter Property="Foreground" Value="#ccccdd" /><Setter Property="FontSize" Value="11" />
            </Style>
          </StackPanel.Styles>
          <TextBlock Classes="fl" Text="From" />
          <TextBox Text="{Binding DateFrom}" Watermark="yyyy-MM-dd" Width="105" />
          <TextBlock Classes="fl" Text="Thru" />
          <TextBox Text="{Binding DateThru}" Watermark="yyyy-MM-dd" Width="105" />
          <TextBlock Classes="fl" Text="Owner" Margin="8 0 0 0" />
          <ComboBox ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedOwner}" MinWidth="140" />
          <TextBlock Classes="fl" Text="Sale Type" Margin="8 0 0 0" />
          <ComboBox ItemsSource="{Binding SaleTypeOptions}" SelectedItem="{Binding SelectedType}" MinWidth="110" />
          <TextBlock Classes="fl" Text="Profit based on" Margin="8 0 0 0" />
          <ComboBox ItemsSource="{Binding ProfitBasisOptions}" SelectedItem="{Binding SelectedProfitBasis}" MinWidth="90" />
          <CheckBox IsChecked="{Binding ShowNotForProfit}" Content="Show not for profit"
                    FontSize="11" Foreground="#999" Margin="12 0 0 0" VerticalAlignment="Center"
                    ToolTip.Tip="Include sales marked as not for profit. They count everywhere on this screen when shown: the summaries, the charts and the grid all follow this box." />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ⚠️ The filter row stays outside the tabs. It governs both of them, and a filter that
         lived on one tab would look like it applied to that tab only. -->
    <TabControl Grid.Row="1" Padding="0" Background="Transparent">

    <TabItem Header="Summary" FontSize="12">
      <Grid RowDefinitions="190,Auto,*">

    <!-- Rollups: Top Buyers / By Market Group / By Item (grouped over the filtered sales) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,8,*,8,*" Margin="10 8 10 0">

      <Border Grid.Column="0" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Top Buyers" FontSize="11" FontWeight="SemiBold"
                     Foreground="#c8a84b" Margin="10 6 10 4" />
          <DataGrid Grid.Row="1" ItemsSource="{Binding TopBuyers}" AutoGenerateColumns="False"
                    IsReadOnly="True" RowHeight="20" CanUserSortColumns="True" Background="Transparent">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Buyer" SortMemberPath="Name" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:GroupRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenGroup" IsVisible="{Binding HasLink}"
                              ToolTip.Tip="Open in the entity browser">
                        <TextBlock Text="{Binding Name}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="ISK"   Binding="{Binding Amount}" SortMemberPath="AmountRaw" Width="Auto" CellStyleClasses="num" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Profit by Market Group" FontSize="11" FontWeight="SemiBold"
                     Foreground="#c8a84b" Margin="10 6 10 4" />
          <DataGrid Grid.Row="1" ItemsSource="{Binding MarketGroups}" AutoGenerateColumns="False"
                    IsReadOnly="True" RowHeight="20" CanUserSortColumns="True" Background="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Group"  Binding="{Binding Name}"      Width="*" />
              <DataGridTextColumn Header="Profit" Binding="{Binding Profit}"    SortMemberPath="ProfitRaw" Width="Auto" CellStyleClasses="num" />
              <DataGridTextColumn Header="%"      Binding="{Binding ProfitPct}" Width="Auto" CellStyleClasses="num" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Profit by Item" FontSize="11" FontWeight="SemiBold"
                     Foreground="#c8a84b" Margin="10 6 10 4" />
          <DataGrid Grid.Row="1" ItemsSource="{Binding TopItems}" AutoGenerateColumns="False"
                    IsReadOnly="True" RowHeight="20" CanUserSortColumns="True" Background="Transparent">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Item" SortMemberPath="Name" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ProfitGroupRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenProfitGroup" IsVisible="{Binding HasLink}"
                              ToolTip.Tip="Open in the Item Browser">
                        <TextBlock Text="{Binding Name}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Profit" Binding="{Binding Profit}"    SortMemberPath="ProfitRaw" Width="Auto" CellStyleClasses="num" />
              <DataGridTextColumn Header="%"      Binding="{Binding ProfitPct}" Width="Auto" CellStyleClasses="num" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

    </Grid>

        <!-- Granularity sits with the charts it governs, not on the filter row: the filter row
             decides which sales are counted, this decides how they are bucketed. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" Margin="10 10 10 4">
          <TextBlock Grid.Column="0" Text="Chart by" VerticalAlignment="Center"
                     FontSize="11" Foreground="#555566" Margin="0 0 8 0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Grains}" SelectedItem="{Binding Grain}"
                    FontSize="11" MinWidth="100" Background="#131320" Foreground="#ccccdd"
                    BorderBrush="#2a2a3a" />
          <TextBlock Grid.Column="3" Text="{Binding UncostedNote}" FontSize="10"
                     Foreground="#8a6a2e" VerticalAlignment="Center"
                     HorizontalAlignment="Right" TextWrapping="NoWrap" />
        </Grid>

        <!-- ⚠️ Two charts, because margin is a percentage. Sharing an axis with figures in the
             billions would flatten it to the zero line and make it unreadable. -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,8,*" Margin="10 0 10 10">
          <Border Grid.Column="0" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="10 8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Costs, sales and profit" FontSize="11"
                         FontWeight="SemiBold" Foreground="#c8a84b" Margin="0 0 0 6" />
              <lvc:CartesianChart Series="{Binding IskSeries}"
                                  XAxes="{Binding ChartXAxes}" YAxes="{Binding IskYAxes}"
                                  LegendPosition="Top" TooltipPosition="Top"
                                  EasingFunction="{x:Null}" Background="Transparent" />
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="10 8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Margin" FontSize="11"
                         FontWeight="SemiBold" Foreground="#c8a84b" Margin="0 0 0 6" />
              <lvc:CartesianChart Series="{Binding MarginSeries}"
                                  XAxes="{Binding ChartXAxes}" YAxes="{Binding MarginYAxes}"
                                  TooltipPosition="Top"
                                  EasingFunction="{x:Null}" Background="Transparent" />
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="Detail" FontSize="12">
    <DataGrid x:Name="SalesGrid" ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              SelectionMode="Extended"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              DoubleTapped="OnRowDoubleTapped"
              Background="#0d0d12">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Mark as not for profit" Click="OnMarkNotForProfit" />
          <MenuItem Header="Restore to profit"      Click="OnRestoreToProfit" />
          <Separator />
          <!-- Built when the menu opens: the label list grows as things are tagged, and one
               populated at startup would offer yesterday's. -->
          <MenuItem x:Name="AddLabelMenu"    Header="Add label" />
          <MenuItem x:Name="RemoveLabelMenu" Header="Remove label" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="" Binding="{Binding NotForProfitMark}" Width="24"
                            CanUserSort="False" />
        <DataGridTextColumn Header="Date / Time"  Binding="{Binding WhenText}" SortMemberPath="WhenSort" Width="130" />
        <DataGridTextColumn Header="Type"         Binding="{Binding Kind}"     Width="80" />
        <!-- Owner, Location, Buyer and Item(s) are links: each one names something with a page of
             its own, and a sale is mostly a set of pointers at those four things. A row whose id
             is missing renders the same text without the button rather than a dead link. -->
        <DataGridTemplateColumn Header="Owner" SortMemberPath="Owner" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenOwner" IsVisible="{Binding HasOwnerLink}"
                        ToolTip.Tip="Open in the entity browser">
                  <TextBlock Text="{Binding Owner}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Owner}" IsVisible="{Binding !HasOwnerLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Location" SortMemberPath="Location" Width="220">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenLocation" IsVisible="{Binding HasLocationLink}"
                        ToolTip.Tip="Open this station or structure">
                  <TextBlock Text="{Binding Location}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Location}" IsVisible="{Binding !HasLocationLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Buyer" SortMemberPath="Buyer" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenBuyer" IsVisible="{Binding HasBuyerLink}"
                        ToolTip.Tip="Open in the entity browser">
                  <TextBlock Text="{Binding Buyer}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Buyer}" IsVisible="{Binding !HasBuyerLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Item(s)" SortMemberPath="Items" Width="220">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenItem" IsVisible="{Binding HasItemLink}"
                        ToolTip.Tip="Open in the Item Browser">
                  <TextBlock Text="{Binding Items}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Items}" IsVisible="{Binding !HasItemLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Units"        Binding="{Binding Units}"    Width="90"  CellStyleClasses="num" />
        <DataGridTextColumn Header="Total Sale"   Binding="{Binding Total}"    SortMemberPath="TotalRaw"     Width="110" CellStyleClasses="num" />
        <DataGridTextColumn Header="Build Price"  Binding="{Binding Build}"    SortMemberPath="BuildRaw"     Width="110" CellStyleClasses="num" />
        <DataGridTextColumn Header="Market Price" Binding="{Binding Market}"   SortMemberPath="MarketRaw"    Width="110" CellStyleClasses="num" />
        <DataGridTemplateColumn Header="Profit" SortMemberPath="ProfitRaw" Width="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <TextBlock Text="{Binding Profit}" Foreground="{Binding ProfitBrush}" FontSize="11"
                         HorizontalAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Profit %" SortMemberPath="ProfitPctRaw" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <TextBlock Text="{Binding ProfitPct}" Foreground="{Binding ProfitBrush}" FontSize="11"
                         HorizontalAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Read-only chips, same colours as the Order Tracker: one tag looks the same wherever
             it appears. Added and removed by right-click. -->
        <DataGridTemplateColumn Header="Labels" Width="180">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <ItemsControl ItemsSource="{Binding LabelChips}" Margin="0 2" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding Fill}" BorderBrush="{Binding Stroke}"
                            BorderThickness="1" CornerRadius="2" Padding="5 0"
                            Margin="0 1 3 1" ToolTip.Tip="{Binding Text}">
                      <TextBlock Text="{Binding Text}" FontSize="10" Foreground="{Binding Ink}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- The contract behind the sale, carrying its description where it has one. Blank on
             market rows. Opens in the Contracts tool, the same jump the Order Tracker offers. -->
        <DataGridTemplateColumn Header="Contract" SortMemberPath="Contract" Width="220">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenContract" IsVisible="{Binding HasContractLink}"
                        ToolTip.Tip="{Binding Contract}">
                  <TextBlock Text="{Binding Contract}" Classes="linktext"
                             TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Contract}" IsVisible="{Binding !HasContractLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    </TabItem>

    </TabControl>
  </Grid>
</UserControl>
