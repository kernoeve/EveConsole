<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:controls="using:EveConsole.Controls"
             x:Class="EveConsole.Views.SalesTrackerView"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="vm:SalesTrackerViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>

    <!-- A link in a grid cell. The button carries no chrome, so the row still reads as a row.
         ⚠️ No Foreground, matching the killmail tool and the system page: a link keeps whatever
         colour its column already had. In a grid where nearly every name is clickable, colouring
         them all would say nothing about which ones matter. The cursor and the hover underline
         carry the affordance instead, and at rest the row looks exactly as it did. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- By period: a wash over each group of columns, matching the band of headings above them,
         and the period and total lines set apart from the splits under them. -->
    <Style Selector="DataGridCell.ga"><Setter Property="Background" Value="{DynamicResource ColumnGroupABrush}" /></Style>
    <Style Selector="DataGridCell.gb"><Setter Property="Background" Value="{DynamicResource ColumnGroupBBrush}" /></Style>
    <Style Selector="DataGridCell.gc"><Setter Property="Background" Value="{DynamicResource ColumnGroupCBrush}" /></Style>
    <Style Selector="DataGridCell.gs"><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" /><Setter Property="BorderThickness" Value="1 0 0 0" /></Style>
    <Style Selector="DataGrid.periods DataGridRow.period TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    </Style>
    <Style Selector="DataGrid.periods DataGridRow.period /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SurfacePanelAltBrush}" />
    </Style>
    <Style Selector="DataGrid.periods DataGridRow.split TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="DataGrid.periods DataGridRow.total TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    </Style>
    <Style Selector="DataGrid.periods DataGridRow.total /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SurfaceHeaderBrush}" />
    </Style>
    <Style Selector="Border.kpi">
      <Setter Property="Background"      Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius"    Value="4" />
      <Setter Property="Padding"         Value="10 6" />
    </Style>
    <Style Selector="Border.kpi TextBlock.k">
      <Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="Border.kpi TextBlock.v">
      <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    </Style>
    <Style Selector="Border.kpi TextBlock.s">
      <Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Header + filters -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="10 6" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{x:Static loc:SalesText.SalesTracker2}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <StackPanel.Styles>
            <Style Selector="TextBlock.fl">
              <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="FontSize" Value="11" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="TextBox">
              <Setter Property="Background" Value="{DynamicResource SurfacePanelAltBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="11" />
            </Style>
            <Style Selector="ComboBox">
              <Setter Property="Background" Value="{DynamicResource SurfacePanelAltBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="11" />
            </Style>
          </StackPanel.Styles>
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.From}" />
          <TextBox Text="{Binding DateFrom}" Watermark="yyyy-MM-dd" Width="105" />
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.Thru}" />
          <TextBox Text="{Binding DateThru}" Watermark="yyyy-MM-dd" Width="105" />
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.Owner}" Margin="8 0 0 0" />
          <ComboBox ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedOwner}" MinWidth="140" />
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.SaleType}" Margin="8 0 0 0" />
          <ComboBox ItemsSource="{Binding SaleTypeOptions}" SelectedItem="{Binding SelectedType}" MinWidth="110" />
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.ProfitBasedOn}" Margin="8 0 0 0" />
          <ComboBox ItemsSource="{Binding ProfitBasisOptions}" SelectedItem="{Binding SelectedProfitBasis}" MinWidth="90" />
          <CheckBox IsChecked="{Binding ShowNotForProfit}" Content="{x:Static loc:SalesText.ShowNotForProfit}"
                    FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="12 0 0 0" VerticalAlignment="Center"
                    ToolTip.Tip="{x:Static loc:SalesText.TipIncludeSalesMarkedAs}" />

          <!-- Item groups: market groups the whole tracker is narrowed to, each a chip to remove. -->
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.ItemGroups}" Margin="12 0 0 0"
                     ToolTip.Tip="{x:Static loc:SalesText.TipItemGroups}" />
          <ItemsControl ItemsSource="{Binding ItemGroups}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ItemGroupFilter">
                <Border Background="{DynamicResource SurfaceSelectedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8 1 2 1">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Classes="link" Click="OnRemoveItemGroup" Padding="4 0" ToolTip.Tip="{x:Static loc:SalesText.TipRemoveItemGroup}">
                      <TextBlock Text="×" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{x:Static loc:SalesText.AddItemGroup}" Click="OnAddItemGroup" FontSize="11" Padding="8 2"
                  VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:SalesText.TipItemGroups}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ⚠️ The filter row stays outside the tabs. It governs both of them, and a filter that
         lived on one tab would look like it applied to that tab only. -->
    <TabControl Grid.Row="1" Padding="0" Background="Transparent">

    <TabItem Header="{x:Static loc:SalesText.TabSummary}" FontSize="12">
      <Grid RowDefinitions="190,Auto,Auto,*">

    <!-- Rollups: profit by buyer / by market group / by item, grouped over the filtered sales
         and ranked by the profit. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,8,*,8,*" Margin="10 8 10 0">

      <Border Grid.Column="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="{x:Static loc:SalesText.ProfitByBuyer}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" Margin="10 6 10 4" />
          <DataGrid Grid.Row="1" ItemsSource="{Binding TopBuyers}" AutoGenerateColumns="False"
                    IsReadOnly="True" RowHeight="20" CanUserSortColumns="True" Background="Transparent">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:GroupRowVm">
                    <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColBuyer}" SortMemberPath="Name" Width="*" ClipboardContentBinding="{Binding Name}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:GroupRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenGroup" IsVisible="{Binding HasLink}"
                              ToolTip.Tip="{x:Static loc:SalesText.TipOpenInTheEntityBrowser}">
                        <TextBlock Text="{Binding Name}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{x:Static loc:SalesText.ColSales}"  Binding="{Binding Sales}"  SortMemberPath="SalesRaw"  Width="Auto" CellStyleClasses="num" />
              <DataGridTextColumn Header="{x:Static loc:SalesText.ColProfit}" Binding="{Binding Profit}" SortMemberPath="ProfitRaw" Width="Auto" CellStyleClasses="num" />
              <DataGridTextColumn Header="%"      Binding="{Binding Share}"  SortMemberPath="ShareRaw"  Width="Auto" CellStyleClasses="num" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="{x:Static loc:SalesText.ProfitByMarketGroup}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" Margin="10 6 10 4" />
          <DataGrid Grid.Row="1" ItemsSource="{Binding MarketGroups}" AutoGenerateColumns="False"
                    IsReadOnly="True" RowHeight="20" CanUserSortColumns="True" Background="Transparent">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:GroupRowVm">
                    <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{x:Static loc:SalesText.ColGroup}"  Binding="{Binding Name}"   Width="*" />
              <DataGridTextColumn Header="{x:Static loc:SalesText.ColSales}"  Binding="{Binding Sales}"  SortMemberPath="SalesRaw"  Width="Auto" CellStyleClasses="num" />
              <DataGridTextColumn Header="{x:Static loc:SalesText.ColProfit}" Binding="{Binding Profit}" SortMemberPath="ProfitRaw" Width="Auto" CellStyleClasses="num" />
              <DataGridTextColumn Header="%"      Binding="{Binding Share}"  SortMemberPath="ShareRaw"  Width="Auto" CellStyleClasses="num" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="{x:Static loc:SalesText.ProfitByItem}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" Margin="10 6 10 4" />
          <DataGrid Grid.Row="1" ItemsSource="{Binding TopItems}" AutoGenerateColumns="False"
                    IsReadOnly="True" RowHeight="20" CanUserSortColumns="True" Background="Transparent">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:GroupRowVm">
                    <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColItem}" SortMemberPath="Name" Width="*" ClipboardContentBinding="{Binding Name}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:GroupRowVm">
                    <Panel>
                      <Button Classes="link" Click="OnOpenGroup" IsVisible="{Binding HasLink}"
                              ToolTip.Tip="{x:Static loc:SalesText.TipOpenInTheItemBrowser}">
                        <TextBlock Text="{Binding Name}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                      </Button>
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasLink}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{x:Static loc:SalesText.ColSales}"  Binding="{Binding Sales}"  SortMemberPath="SalesRaw"  Width="Auto" CellStyleClasses="num" />
              <DataGridTextColumn Header="{x:Static loc:SalesText.ColProfit}" Binding="{Binding Profit}" SortMemberPath="ProfitRaw" Width="Auto" CellStyleClasses="num" />
              <DataGridTextColumn Header="%"      Binding="{Binding Share}"  SortMemberPath="ShareRaw"  Width="Auto" CellStyleClasses="num" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

    </Grid>

        <!-- Under each list, the same profit as a pie: the ten largest slices and the rest as one. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,8,*,8,*" Margin="10 8 10 0">
          <Border Grid.Column="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
            <Panel>
              <lvc:PieChart IsVisible="{Binding HasBuyerPie}" Series="{Binding BuyerPie}"
                            LegendPosition="Right" LegendTextSize="9" Background="Transparent" Height="170" />
              <TextBlock IsVisible="{Binding !HasBuyerPie}" Text="{x:Static loc:SalesText.NoProfitToShow}" FontSize="11" FontStyle="Italic"
                         Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
            <Panel>
              <lvc:PieChart IsVisible="{Binding HasGroupPie}" Series="{Binding GroupPie}"
                            LegendPosition="Right" LegendTextSize="9" Background="Transparent" Height="170" />
              <TextBlock IsVisible="{Binding !HasGroupPie}" Text="{x:Static loc:SalesText.NoProfitToShow}" FontSize="11" FontStyle="Italic"
                         Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Border>
          <Border Grid.Column="4" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
            <Panel>
              <lvc:PieChart IsVisible="{Binding HasItemPie}" Series="{Binding ItemPie}"
                            LegendPosition="Right" LegendTextSize="9" Background="Transparent" Height="170" />
              <TextBlock IsVisible="{Binding !HasItemPie}" Text="{x:Static loc:SalesText.NoProfitToShow}" FontSize="11" FontStyle="Italic"
                         Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Border>
        </Grid>

        <!-- Granularity sits with the charts it governs, not on the filter row: the filter row
             decides which sales are counted, this decides how they are bucketed. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" Margin="10 10 10 4">
          <TextBlock Grid.Column="0" Text="{x:Static loc:SalesText.ChartBy}" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0 0 8 0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Grains}" SelectedItem="{Binding Grain}"
                    FontSize="11" MinWidth="100" Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" />
          <TextBlock Grid.Column="3" Text="{Binding UncostedNote}" FontSize="10"
                     Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"
                     HorizontalAlignment="Right" TextWrapping="NoWrap" />
        </Grid>

        <!-- ⚠️ Two charts, because margin is a percentage. Sharing an axis with figures in the
             billions would flatten it to the zero line and make it unreadable. -->
        <Grid Grid.Row="3" ColumnDefinitions="2*,8,*" Margin="10 0 10 10">
          <Border Grid.Column="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="10 8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:SalesText.CostsSalesAndProfit}" FontSize="11"
                         FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 6" />
              <lvc:CartesianChart Series="{Binding IskSeries}"
                                  XAxes="{Binding ChartXAxes}" YAxes="{Binding IskYAxes}"
                                  LegendPosition="Top" TooltipPosition="Top"
                                  EasingFunction="{x:Null}" Background="Transparent" />
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="10 8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:SalesText.Margin}" FontSize="11"
                         FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 6" />
              <lvc:CartesianChart Series="{Binding MarginSeries}"
                                  XAxes="{Binding ChartXAxes}" YAxes="{Binding MarginYAxes}"
                                  TooltipPosition="Top"
                                  EasingFunction="{x:Null}" Background="Transparent" />
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <!-- By period: totals per period, split one way, with for profit and not for profit side by
         side on every line, and the units sold by group period over period. -->
    <TabItem Header="{x:Static loc:SalesText.TabPeriods}" FontSize="12">
      <Grid RowDefinitions="Auto,Auto,Auto,2*,Auto,Auto,*,Auto" Margin="10 8 10 8">
        <Grid.Styles>
          <Style Selector="TextBlock.fl">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfacePanelAltBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="11" />
          </Style>
        </Grid.Styles>

        <WrapPanel Grid.Row="0" Orientation="Horizontal">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > :is(Control)"><Setter Property="Margin" Value="0 0 8 4" /></Style>
          </WrapPanel.Styles>
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.PeriodRowsBy}" />
          <ComboBox ItemsSource="{Binding Grains}" SelectedItem="{Binding PeriodGrain}" MinWidth="90" />
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.SplitBy}" Margin="8 0 8 4" />
          <ComboBox ItemsSource="{Binding SplitOptions}" SelectedItem="{Binding SelectedSplit}" MinWidth="110" />
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.ShareBy}" Margin="8 0 8 4"
                     ToolTip.Tip="{x:Static loc:SalesText.TipShareBy}" />
          <ComboBox ItemsSource="{Binding ShareOptions}" SelectedItem="{Binding SelectedShare}" MinWidth="90" />
          <Button Content="{x:Static loc:SalesText.CopyAsText}" Click="OnCopyPeriods" FontSize="11" Padding="10 3" Margin="16 0 8 4"
                  ToolTip.Tip="{x:Static loc:SalesText.TipCopyAsText}" />
          <Button Content="{x:Static loc:SalesText.ExportCsv}" Click="OnExportPeriods" FontSize="11" Padding="10 3" />
        </WrapPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0 4 0 8">
          <Border Classes="kpi" Margin="0 0 6 0">
            <StackPanel Spacing="1"><TextBlock Classes="k" Text="{x:Static loc:SalesText.KpiUnits}" />
              <TextBlock Classes="v" Text="{Binding Kpis.Sales}" /><TextBlock Classes="s" Text="{Binding Kpis.SalesSub}" /></StackPanel>
          </Border>
          <Border Classes="kpi" Margin="0 0 6 0">
            <StackPanel Spacing="1"><TextBlock Classes="k" Text="{x:Static loc:SalesText.KpiForProfit}" />
              <TextBlock Classes="v" Text="{Binding Kpis.ForProfit}" /><TextBlock Classes="s" Text="{Binding Kpis.ForProfitSub}" /></StackPanel>
          </Border>
          <Border Classes="kpi" Margin="0 0 6 0">
            <StackPanel Spacing="1"><TextBlock Classes="k" Text="{x:Static loc:SalesText.KpiNotForProfit}" />
              <TextBlock Classes="v" Text="{Binding Kpis.NotForProfit}" /><TextBlock Classes="s" Text="{Binding Kpis.NotForProfitSub}" /></StackPanel>
          </Border>
          <Border Classes="kpi">
            <StackPanel Spacing="1"><TextBlock Classes="k" Text="{x:Static loc:SalesText.KpiShare}" />
              <TextBlock Classes="v" Text="{Binding Kpis.Share}" /><TextBlock Classes="s" Text="{Binding Kpis.ShareSub}" /></StackPanel>
          </Border>
        </UniformGrid>

        <controls:DataGridColumnGroups Grid.Row="2" x:Name="PeriodBand" />
        <DataGrid Grid.Row="3" x:Name="PeriodGrid" Classes="periods" ItemsSource="{Binding PeriodRows}"
                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24" SelectionMode="Extended"
                  CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                  Background="{DynamicResource SurfacePanelBrush}" LoadingRow="OnPeriodLoadingRow">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColPeriod}" Width="190" ClipboardContentBinding="{Binding Label}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PeriodRowVm">
                  <TextBlock Text="{Binding Label}" Margin="{Binding Indent}" VerticalAlignment="Center" Padding="6 0" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColUnits}"   Binding="{Binding Units}"   Width="64"  CellStyleClasses="num ga gs" />
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColSaleIsk}" Binding="{Binding SaleIsk}" Width="110" CellStyleClasses="num ga" />
            <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColFpShare}" Width="130" CellStyleClasses="ga" ClipboardContentBinding="{Binding Share}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PeriodRowVm">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6 0">
                    <Border Width="60" Height="7" CornerRadius="3" Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Center">
                      <Border Width="{Binding ShareBar}" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource GoodBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Share}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColUnits}"   Binding="{Binding FpUnits}"     Width="64"  CellStyleClasses="num gb gs" />
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColSaleIsk}" Binding="{Binding FpSaleIsk}"   Width="110" CellStyleClasses="num gb" />
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColCost}"    Binding="{Binding FpCost}"      Width="110" CellStyleClasses="num gb" />
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColProfit}"  Binding="{Binding FpProfit}"    Width="100" CellStyleClasses="num gb" />
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColProfit2}" Binding="{Binding FpProfitPct}" Width="84" CellStyleClasses="num gb" />
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColUnits}"   Binding="{Binding NfpUnits}"    Width="64"  CellStyleClasses="num gc gs" />
            <DataGridTextColumn Header="{x:Static loc:SalesText.ColSaleIsk}" Binding="{Binding NfpSaleIsk}"  Width="110" CellStyleClasses="num gc" />
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0 12 0 6">
          <TextBlock Text="{x:Static loc:SalesText.UnitsSold}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.CountBy}" Margin="8 0 0 0" />
          <ComboBox ItemsSource="{Binding CountByOptions}" SelectedItem="{Binding SelectedCountBy}" MinWidth="110" />
          <TextBlock Classes="fl" Text="{x:Static loc:SalesText.UnitsNote}" Margin="8 0 0 0" />
        </StackPanel>
        <Border Grid.Row="5" />
        <DataGrid Grid.Row="6" x:Name="UnitGrid" ItemsSource="{Binding UnitRows}"
                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24" SelectionMode="Extended"
                  CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                  Background="{DynamicResource SurfacePanelBrush}" />

        <TextBlock Grid.Row="7" Text="{x:Static loc:SalesText.PeriodsNote}" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0 8 0 0" />
      </Grid>
    </TabItem>

    <TabItem Header="{x:Static loc:SalesText.TabDetail}" FontSize="12">
    <DataGrid x:Name="SalesGrid" ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              SelectionMode="Extended"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              DoubleTapped="OnRowDoubleTapped"
              Background="{DynamicResource SurfaceBaseBrush}">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{x:Static loc:SalesText.MenuMarkAsNotForProfit}" Click="OnMarkNotForProfit" />
          <MenuItem Header="{x:Static loc:SalesText.MenuRestoreToProfit}"      Click="OnRestoreToProfit" />
          <Separator />
          <!-- Built when the menu opens: the label list grows as things are tagged, and one
               populated at startup would offer yesterday's. -->
          <MenuItem x:Name="AddLabelMenu"    Header="{x:Static loc:SalesText.MenuAddLabel}" />
          <MenuItem x:Name="RemoveLabelMenu" Header="{x:Static loc:SalesText.MenuRemoveLabel}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="" Binding="{Binding NotForProfitMark}" Width="24"
                            CanUserSort="False" />
        <DataGridTextColumn Header="{x:Static loc:SalesText.ColDateTime}"  Binding="{Binding WhenText}" SortMemberPath="WhenSort" Width="130" />
        <DataGridTextColumn Header="{x:Static loc:SalesText.ColType}"         Binding="{Binding Kind}"     Width="80" />
        <!-- Owner, Location, Buyer and Item(s) are links: each one names something with a page of
             its own, and a sale is mostly a set of pointers at those four things. A row whose id
             is missing renders the same text without the button rather than a dead link. -->
        <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColOwner}" SortMemberPath="Owner" Width="150" ClipboardContentBinding="{Binding Owner}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenOwner" IsVisible="{Binding HasOwnerLink}"
                        ToolTip.Tip="{x:Static loc:SalesText.TipOpenInTheEntityBrowser}">
                  <TextBlock Text="{Binding Owner}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Owner}" IsVisible="{Binding !HasOwnerLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColLocation}" SortMemberPath="Location" Width="220" ClipboardContentBinding="{Binding Location}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenLocation" IsVisible="{Binding HasLocationLink}"
                        ToolTip.Tip="{x:Static loc:SalesText.TipOpenThisStationOrStructure}">
                  <TextBlock Text="{Binding Location}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Location}" IsVisible="{Binding !HasLocationLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColBuyer}" SortMemberPath="Buyer" Width="150" ClipboardContentBinding="{Binding Buyer}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenBuyer" IsVisible="{Binding HasBuyerLink}"
                        ToolTip.Tip="{x:Static loc:SalesText.TipOpenInTheEntityBrowser}">
                  <TextBlock Text="{Binding Buyer}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Buyer}" IsVisible="{Binding !HasBuyerLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColItemS}" SortMemberPath="Items" Width="220" ClipboardContentBinding="{Binding Items}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenItem" IsVisible="{Binding HasItemLink}"
                        ToolTip.Tip="{x:Static loc:SalesText.TipOpenInTheItemBrowser}">
                  <TextBlock Text="{Binding Items}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Items}" IsVisible="{Binding !HasItemLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static loc:SalesText.ColUnits}"        Binding="{Binding Units}"    Width="90"  CellStyleClasses="num" />
        <DataGridTextColumn Header="{x:Static loc:SalesText.ColTotalSale}"   Binding="{Binding Total}"    SortMemberPath="TotalRaw"     Width="110" CellStyleClasses="num" />
        <DataGridTextColumn Header="{x:Static loc:SalesText.ColBuildPrice}"  Binding="{Binding Build}"    SortMemberPath="BuildRaw"     Width="110" CellStyleClasses="num" />
        <DataGridTextColumn Header="{x:Static loc:SalesText.ColMarketPrice}" Binding="{Binding Market}"   SortMemberPath="MarketRaw"    Width="110" CellStyleClasses="num" />
        <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColProfit}" SortMemberPath="ProfitRaw" Width="110" ClipboardContentBinding="{Binding Profit}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <TextBlock Text="{Binding Profit}" Foreground="{Binding ProfitBrush}" FontSize="11"
                         HorizontalAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColProfit2}" SortMemberPath="ProfitPctRaw" Width="90" ClipboardContentBinding="{Binding ProfitPct}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <TextBlock Text="{Binding ProfitPct}" Foreground="{Binding ProfitBrush}" FontSize="11"
                         HorizontalAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Read-only chips, same colours as the Order Tracker: one tag looks the same wherever
             it appears. Added and removed by right-click. -->
        <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColLabels}" Width="180" ClipboardContentBinding="{Binding Labels}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <ItemsControl ItemsSource="{Binding LabelChips}" Margin="0 2" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding Fill}" BorderBrush="{Binding Stroke}"
                            BorderThickness="1" CornerRadius="2" Padding="5 0"
                            Margin="0 1 3 1" ToolTip.Tip="{Binding Text}">
                      <TextBlock Text="{Binding Text}" FontSize="10" Foreground="{Binding Ink}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- The contract behind the sale, carrying its description where it has one. Blank on
             market rows. Opens in the Contracts tool, the same jump the Order Tracker offers. -->
        <DataGridTemplateColumn Header="{x:Static loc:SalesText.ColContract}" SortMemberPath="Contract" Width="220" ClipboardContentBinding="{Binding Contract}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenContract" IsVisible="{Binding HasContractLink}"
                        ToolTip.Tip="{Binding Contract}">
                  <TextBlock Text="{Binding Contract}" Classes="linktext"
                             TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Contract}" IsVisible="{Binding !HasContractLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    </TabItem>

    </TabControl>
  </Grid>
</UserControl>
