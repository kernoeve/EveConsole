<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.SplashWindow"
        Width="900" Height="360"
        Icon="avares://EveConsole/Assets/ec.ico"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#0d0d10">

  <Grid>

    <!-- Background art -->
    <Image Source="avares://EveConsole/Assets/splash_background.png"
           Stretch="UniformToFill"
           HorizontalAlignment="Center"
           VerticalAlignment="Center" />

    <!-- Bottom gradient so text stays legible over the artwork -->
    <Rectangle VerticalAlignment="Bottom" Height="200">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0.0" Color="#00000000" />
          <GradientStop Offset="0.6" Color="#CC0d0d10" />
          <GradientStop Offset="1.0" Color="#FF0d0d10" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Content overlay -->
    <DockPanel Margin="48 0 48 28">

      <!-- Progress section pinned to bottom -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatusText"
                     Grid.Column="0"
                     Text="Initializing…"
                     FontSize="11" Foreground="#555566"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText"
                     Grid.Column="1"
                     Text=""
                     FontSize="11" Foreground="#3a3a4a"
                     VerticalAlignment="Center" />
        </Grid>
        <!-- Progress track -->
        <Grid Height="2" Background="#1a1a24">
          <Rectangle x:Name="ProgressFill"
                     HorizontalAlignment="Left"
                     Fill="#c8a84b"
                     Height="2"
                     Width="0" />
        </Grid>
      </StackPanel>

      <!-- The app name, which sits at the TOP of the splash.
           ⚠️ Reads as bottom-docked and is not. As the DockPanel's LAST child it takes the panel's
           LastChildFill, so the Dock is ignored, the block fills whatever the progress section
           left, and its content renders at the top of that space. Which is why the margin that
           positions the name is the TOP one — changing the bottom margin moves nothing. -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="3" Margin="0 14 0 18">
        <!-- Two-tone name: EVE in white, Console in amber -->
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="EVE "
                     FontSize="34" FontWeight="Bold"
                     Foreground="#e8e8ec"
                     LetterSpacing="10" />
          <TextBlock Text="Console"
                     FontSize="34" FontWeight="Bold"
                     Foreground="#c8a84b"
                     LetterSpacing="10" />
        </StackPanel>
        <TextBlock x:Name="SubVersionText"
                   Text=""
                   FontSize="11" Foreground="#555566"
                   HorizontalAlignment="Left" />
      </StackPanel>

    </DockPanel>
  </Grid>

</Window>
