<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.StandingBuyOrdersView"
             x:DataType="vm:StandingBuyOrdersViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" />
      <Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="FontSize" Value="10" /><Setter Property="Padding" Value="10 3" />
      <Setter Property="Background" Value="#1a1a2a" /><Setter Property="Foreground" Value="#888899" />
      <Setter Property="BorderBrush" Value="#2a2a3a" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Background="#0d0d12" Padding="10 6"
            BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Standing Buy Orders" FontSize="13" FontWeight="SemiBold"
                     Foreground="#c8a84b" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                     Foreground="#888899" VerticalAlignment="Center" />
        </Grid>

        <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                   Text="Buy orders you intend to keep standing at a station or structure. Each is matched against your characters' and corporations' live buy orders." />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="tool" Content="Add"     Command="{Binding AddCommand}" />
          <Button Classes="tool" Content="Edit"    Command="{Binding EditCommand}" />
          <Button Classes="tool" Content="Delete"  Command="{Binding DeleteCommand}" />
          <Button Classes="tool" Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              Background="#0d0d12">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Status" Width="80" SortMemberPath="Status">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
              <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Item" SortMemberPath="TypeName" Width="220">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenRowItem" IsVisible="{Binding HasItemLink}" ToolTip.Tip="Open in the Item Browser">
                  <TextBlock Text="{Binding TypeName}" Classes="linktext"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Location" SortMemberPath="LocationName" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenRowLocation" IsVisible="{Binding HasLocationLink}" ToolTip.Tip="Open this station or structure">
                  <TextBlock Text="{Binding LocationName}" Classes="linktext"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding LocationName}" IsVisible="{Binding !HasLocationLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Held by" Width="180" SortMemberPath="Owner">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
              <!-- Linked only where a single owner holds the order; an aggregated "3 owners" cell
                   names nobody to open, so it stays plain and keeps its breakdown tooltip. -->
              <Panel>
                <Button Classes="link" Click="OnOpenRowOwner" IsVisible="{Binding HasOwnerLink}"
                        ToolTip.Tip="Open in the entity browser">
                  <TextBlock Text="{Binding Owner}" Classes="linktext" FontSize="11"
                             Foreground="#c8c8d8" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Owner}" IsVisible="{Binding !HasOwnerLink}"
                           FontSize="11" Foreground="#c8c8d8"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding OwnerTooltip}" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Our bid" Width="150" SortMemberPath="Price">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
              <TextBlock Text="{Binding Price}" FontSize="11" Foreground="{Binding PriceColor}"
                         VerticalAlignment="Center" ToolTip.Tip="{Binding PriceTooltip}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Station best bid" Width="150" SortMemberPath="StationBid">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
              <TextBlock Text="{Binding StationBid}" FontSize="11" Foreground="{Binding StationBidColor}"
                         VerticalAlignment="Center" ToolTip.Tip="{Binding PriceTooltip}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Remaining"  Binding="{Binding Remaining}"    Width="150" />
        <DataGridTextColumn Header="%"          Binding="{Binding RemainingPct}" Width="70"  />
        <DataGridTemplateColumn Header="Expires" Width="180" SortMemberPath="Expiry">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
              <TextBlock Text="{Binding Expiry}" FontSize="11"
                         Foreground="{Binding ExpiryColor}" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Note"       Binding="{Binding Note}"         Width="320" />
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
