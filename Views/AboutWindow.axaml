<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.AboutWindow"
        Title="About EVE Console"
        Icon="avares://EveConsole/Assets/ec.ico"
        Width="470"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Window.Styles>
    <!-- The link treatment the character, killmail and corp activity views already use: no button
         chrome at all, with the cursor and the hover underline carrying the affordance. Defined
         here because that style is local to CharacterView rather than app-wide. -->
    <Style Selector="Button.link">
      <Setter Property="Background"      Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding"         Value="0" />
      <Setter Property="MinHeight"       Value="0" />
      <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="40 32 40 28" Spacing="0">

    <!-- Logo. The wordmark is part of the artwork, which is why no text title follows it: the
         name was being set twice, once inside the image and again underneath. -->
    <Image Source="avares://EveConsole/Assets/logo.png"
           Width="240" Height="240"
           HorizontalAlignment="Center"
           RenderOptions.BitmapInterpolationMode="HighQuality"
           Margin="0 0 0 14" />

    <!-- Version -->
    <TextBlock x:Name="VersionText"
               Text=""
               FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
               HorizontalAlignment="Center"
               Margin="0 0 0 24" />

    <!-- Divider -->
    <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0 0 0 20" />

    <!-- Description -->
    <TextBlock Text="An EVE Online industrial companion for production planning, asset tracking, market pricing, and character management."
               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
               TextWrapping="Wrap"
               TextAlignment="Center"
               LineHeight="20"
               Margin="0 0 0 20" />

    <!-- Where to go next. Tag carries the URL so one handler serves all three. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0 0 0 22">
      <Button Classes="link" Tag="https://eveconsole.com" Click="OnLinkClick"
              ToolTip.Tip="eveconsole.com">
        <TextBlock Text="Website" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
      </Button>
      <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource BorderStrongBrush}" />
      <Button Classes="link" Tag="https://docs.eveconsole.com" Click="OnLinkClick"
              ToolTip.Tip="docs.eveconsole.com">
        <TextBlock Text="Documentation" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
      </Button>
      <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource BorderStrongBrush}" />
      <Button Classes="link" Tag="https://discord.gg/H6NaAjJMar" Click="OnLinkClick"
              ToolTip.Tip="Community chat and support">
        <TextBlock Text="Discord" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
      </Button>
    </StackPanel>

    <!-- Divider -->
    <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0 0 0 16" />

    <!-- CCP trademark notice -->
    <TextBlock FontSize="11" Foreground="{DynamicResource BorderStrongBrush}"
               TextWrapping="Wrap"
               TextAlignment="Center"
               LineHeight="17">
      EVE Online and the EVE logo are the registered trademarks of CCP hf.
      EVE Console is not affiliated with or endorsed by CCP hf.
    </TextBlock>

    <!-- Close button -->
    <Button Content="Close"
            HorizontalAlignment="Center"
            Padding="28 6"
            Margin="0 24 0 0"
            Click="OnCloseClick" />

  </StackPanel>

</Window>
