<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             xmlns:models="clr-namespace:EveConsole.Models"
             xmlns:wl="clr-namespace:EveConsole.Services.Worklist"
             xmlns:conv="clr-namespace:EveConsole.Views"
             xmlns:collections="clr-namespace:Avalonia.Collections;assembly=Avalonia.Controls.DataGrid"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EveConsole.Views.WorklistView"
             x:DataType="vm:WorklistViewModel">

  <UserControl.Resources>
    <conv:NullableDecimalToPositiveDoubleConverter x:Key="PctConv" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="10" /></Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Margin"     Value="0 0 8 3" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <TabControl Padding="0" Background="Transparent" SelectedIndex="{Binding OuterTabIndex}">
    <TabItem Header="{x:Static loc:WorklistText.TabWorklist}">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14 12">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0 0 0 8">
      <TextBlock Text="{x:Static loc:WorklistText.Worklist}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                 VerticalAlignment="Center"/>
      <!-- No status line here. Everything it said — ready, blocked, waiting — is in the strip
           immediately below, in larger type, and a second copy beside Refresh was one more place
           for the same numbers to be read and reconciled. -->
      <Button Content="{x:Static loc:WorklistText.Refresh}" Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsLoading}" FontSize="11" Padding="10 4"/>
      <!-- When the run happened. The rows carry their own data age, but nothing said when the list
           itself was last built. -->
      <TextBlock Text="{Binding RefreshedText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding Errors}" IsVisible="{Binding HasErrors}"
               FontSize="10" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" Margin="0 0 0 8"/>

    <StackPanel Grid.Row="2" Spacing="6" Margin="0 0 0 8">

      <!-- The strip: one headline figure, then chips.
           ⚠️ Every figure here is counted off the run, not off the rows below, so the filters and
           the two checkboxes leave it alone. That is the point: it says how much is blocked
           without making you show the blocked ones.
           ⚠️ Counts only. Every per-kind total — tasks, value, volume — is on that kind's group
           header a few pixels below, so carrying them here printed the same figures twice. And
           ready appears once, as the headline; the state chips are blocked and waiting only. -->
      <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              CornerRadius="3" Padding="16 12">
        <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">

          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ReadyCountText}" FontSize="30" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrightBrush}"/>
            <TextBlock Text="{x:Static loc:WorklistText.ReadyNow}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 2 0 0"/>
          </StackPanel>

          <Rectangle Width="1" Fill="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="0 2"/>

          <ItemsControl ItemsSource="{Binding KindSummary}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="20"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SummaryStatVm">
                <StackPanel>
                  <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                             Margin="0 1 0 0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

      <!-- Sat with the filters rather than up beside Refresh, because that is what they are: two
           more controls over which rows appear. The counts are of what each governs across the
           whole run, so they say how much is behind the toggle whether it is on or off. -->
      <StackPanel Orientation="Horizontal" Spacing="14">
        <CheckBox Content="{Binding NotReadyLabel}" IsChecked="{Binding ShowNotReady}"
                  ToolTip.Tip="{x:Static loc:WorklistText.TipIncludeWorkThatCannot}"
                  FontSize="11" VerticalAlignment="Center"/>
        <CheckBox Content="{Binding SnoozedLabel}" IsChecked="{Binding ShowSnoozed}"
                  ToolTip.Tip="{x:Static loc:WorklistText.TipIncludeItemsHiddenBy}"
                  FontSize="11" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- ⚠️ One row, with each control naming itself. Labels above doubled the height of the
           filter band, and two adjacent controls were both labelled "Task" — one narrows the kind,
           the other searches the text. They are now Type and Search. -->
      <Grid ColumnDefinitions="80,90,230,150,190,190,230,Auto,*">
        <ComboBox Grid.Column="0" ItemsSource="{Binding StateOptions}"
                  SelectedItem="{Binding StateFilter}" FontSize="11"
                  PlaceholderText="{x:Static loc:WorklistText.HintState}" HorizontalAlignment="Stretch" Margin="0 0 2 0"
                  ToolTip.Tip="{x:Static loc:WorklistText.TipReadyBlockedOrWaiting}"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding TaskOptions}"
                  SelectedItem="{Binding TaskFilter}" FontSize="11"
                  PlaceholderText="{x:Static loc:WorklistText.HintType}" HorizontalAlignment="Stretch" Margin="0 0 2 0"
                  ToolTip.Tip="{x:Static loc:WorklistText.TipBuyHaulJobAndThe}"/>
        <TextBox  Grid.Column="2" Text="{Binding DescriptionFilter}" FontSize="11"
                  Watermark="{x:Static loc:WorklistText.HintSearchTask}" Margin="0 0 2 0"/>
        <ComboBox Grid.Column="3" ItemsSource="{Binding CharacterOptions}"
                  SelectedItem="{Binding CharacterFilter}" FontSize="11"
                  PlaceholderText="{x:Static loc:WorklistText.HintCharacter}" HorizontalAlignment="Stretch" Margin="0 0 2 0"/>
        <ComboBox Grid.Column="4" ItemsSource="{Binding SourceOptions}"
                  SelectedItem="{Binding SourceFilter}" FontSize="11"
                  PlaceholderText="{x:Static loc:WorklistText.HintSource}" HorizontalAlignment="Stretch" Margin="0 0 2 0"/>
        <ComboBox Grid.Column="5" ItemsSource="{Binding DestOptions}"
                  SelectedItem="{Binding DestFilter}" FontSize="11"
                  PlaceholderText="{x:Static loc:WorklistText.HintDestination}" HorizontalAlignment="Stretch" Margin="0 0 2 0"/>
        <TextBox  Grid.Column="6" Text="{Binding NoteFilter}" FontSize="11"
                  Watermark="{x:Static loc:WorklistText.HintSearchNote}" Margin="0 0 2 0"
                  ToolTip.Tip="{x:Static loc:WorklistText.TipSearchesTheDetailThe}"/>
        <Button   Grid.Column="7" Content="{x:Static loc:WorklistText.Clear}" Command="{Binding ClearFiltersCommand}"
                  IsVisible="{Binding HasFilters}"
                  FontSize="11" Padding="8 3" Background="Transparent"
                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Cursor="Hand"/>
      </Grid>
    </StackPanel>

    <!-- The explanation, in full, exactly when someone is asking why the list is empty. It sits
         in the same cell as the grid rather than above it, so it costs nothing when there are rows. -->
    <TextBlock Grid.Row="3" IsVisible="{Binding !Rows.Count}"
               Text="{x:Static vm:WorklistViewModel.HelpText}"
               FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" MaxWidth="520"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

    <DataGrid LoadingRow="OnRowLoading" UnloadingRow="OnRowUnloading" Grid.Row="3" ItemsSource="{Binding RowsView}"
              IsReadOnly="True" AutoGenerateColumns="False" FontSize="12"
              Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">

      <!-- ⚠️ A resource, not a style. DataGridDetailsPresenter takes its background straight from
           this brush in the stock template, so `Selector="DataGridRow /template/
           DataGridDetailsPresenter"` never wins — the template's own value is not something a
           style can override. Left at the theme default it paints a grey several steps lighter
           than the grid across the full width of the expanded row, while the manifest panel
           inside is narrow and left-aligned, so the grey read as a selection highlight rather
           than as an expanded detail. -->

      <DataGrid.Styles>
        <!-- Group header: the task name once, with its count and total, instead of a Task column
             repeating the name on every row.
             ⚠️ Retemplated rather than styled, because the stock template renders at 15px with a
             32px minimum and its own indent — three times the weight of the rows it heads. The
             ToggleButton must keep the name PART_ExpanderButton: the grid finds collapse/expand by
             that name, and renaming it leaves a header that looks right and does nothing. -->

        <!-- Snooze is a per-row action, revealed on hover. Opacity, not IsVisible: hiding it would
             let the column collapse and the grid would twitch as the pointer moved. -->
        <Style Selector="Button.snooze">
          <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="DataGridRow:pointerover Button.snooze">
          <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Right-aligned figures deserve right-aligned headers, or the label sits away from the
             digits it names. -->
        <Style Selector="DataGridColumnHeader.num">
          <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style Selector="DataGridRowGroupHeader">
          <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="MinHeight"  Value="34"/>
          <Setter Property="Template">
            <ControlTemplate x:DataType="collections:DataGridCollectionViewGroup">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 1">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="6 0"
                            VerticalAlignment="Center">
                  <!-- DynamicResource: the theme lives in the DataGrid's own dictionary, merged
                       through Application.Styles, which a parse-time StaticResource lookup from
                       here cannot be relied on to see. -->
                  <ToggleButton Name="PART_ExpanderButton" Width="12" Height="12"
                                Theme="{DynamicResource FluentDataGridRowGroupExpanderButtonTheme}"
                                Background="Transparent" BorderThickness="0"/>
                  <!-- The name still leads, but the figures are read too, so they are only one
                       step down rather than the footnote they were. -->
                  <TextBlock Text="{Binding Key}" FontSize="16" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                             Text="{Binding Items, Converter={x:Static conv:GroupTotalConverter.Instance},
                                             ConverterParameter=Count}"/>
                  <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                             Text="{Binding Items, Converter={x:Static conv:GroupTotalConverter.Instance},
                                             ConverterParameter=Volume}"/>
                  <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                             Text="{Binding Items, Converter={x:Static conv:GroupTotalConverter.Instance},
                                             ConverterParameter=Value}"/>
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>

        <!-- The expander is a glyph, not a button: the default chrome draws a filled box on hover
             and press, which reads as a selected cell sitting in the corner of the row. -->
        <Style Selector="Button.expander /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.expander:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
      </DataGrid.Styles>

      <!-- The manifest for tasks that carry several items. Shown only while the row's own +/- is
           pressed; single-item tasks have no manifest and never expand. -->
      <!-- The manifest for tasks that carry several items.
           ⚠️ Sizes to its contents. It was a fixed 300 + 110 grid, so a one-item haul drew a
           410px panel with the name at one end and the quantity stranded at the other, reading
           as a broken layout rather than a short list. Now the name column takes what it needs
           and the quantity sits against it, with a minimum so a list of short names still lines
           up its figures. -->
      <DataGrid.Columns>

        <!-- State, as the row's leading edge rather than a column of words.
             With blocked and waiting hidden — the default — a State column reads "Ready" on every
             one of 147 rows, which is a column that says nothing in the position that costs most.
             As a bar it is read peripherally: you notice the amber and red, and the rest recedes.
             The text is still available on hover, and the filter dropdown above still names it. -->
        <DataGridTemplateColumn Header="" Width="4" CanUserSort="False" CanUserResize="False" ClipboardContentBinding="{Binding ReadinessText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <Border Background="{Binding ReadinessBarColor}" Width="3"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      ToolTip.Tip="{Binding ReadinessText}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- What kind of work this is, drawn rather than spelled out. The rows group by kind, but
             that header is gone the moment the list is sorted on something else, and a shape is
             read faster than a word when scanning. Stroked rather than filled so it stays legible
             at row height and takes its weight from the theme. -->
        <DataGridTemplateColumn Header="" Width="22" CanUserResize="False"
                                SortMemberPath="KindSort" ClipboardContentBinding="{Binding KindGlyphTip}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <Path Data="{Binding KindGlyph, Converter={x:Static views:PathGeometryConverter.Instance}}"
                    Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.15"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding KindGlyphTip}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Expander. Only drawn where there is a manifest, so an empty cell reads as "this task
             is the one item named in the description" rather than as a control that does nothing. -->
        <DataGridTemplateColumn Header="" Width="24" CanUserSort="False" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <Panel>
                <Button Classes="expander" Click="OnManifestToggle"
                        IsVisible="{Binding CanExpand}"
                        Content="{Binding ExpandGlyph}" FontSize="14" FontWeight="Bold"
                        Padding="0" Width="16" Height="16" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="{x:Static loc:WorklistText.TipShowWhatThisTask}"/>

                <!-- ⚠️ A popup, NOT RowDetails, and the difference is the whole point. A drawer
                     inside a row makes rows wildly different heights, and the DataGrid prices
                     every row it has not realised from a single average of them; it also reuses
                     a row between an open one and a closed one and measures it before the
                     drawer has caught up. Both are why scrolling up used to stick and jump.
                     See tools/gridsim. Floating the detail leaves every row one height, so
                     there is nothing left to estimate wrongly.
                
                     ⚠️ Light dismiss with a TwoWay binding, so clicking away puts the glyph
                     back. The flag still lives on the ITEM, not the row: the grid recycles
                     rows, and a popup keyed to the row would open against whatever item
                     landed in it next. -->
                <Popup IsOpen="{Binding IsExpanded}" Closed="OnDetailClosed" DetachedFromVisualTree="OnDetailDetached"
                       Placement="BottomEdgeAlignedLeft"
                       HorizontalOffset="-70"
                       IsLightDismissEnabled="True">
                  <!-- ⚠️ A ceiling, with the scrolling inside it. A blueprint list ran the
                       full height of the screen and off the bottom of it. -->
                  <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                  <!-- ⚠️ No height constraint here, deliberately. Three attempts to cure the scroll
                       flicker by controlling this box all failed — a 320px cap, shorter panels, and a
                       fixed 220px drawer — which between them rule out the size of the details as the
                       cause. Leaving it natural until the mechanism is actually known beats carrying a
                       constraint that costs the look and buys nothing. -->
                  <Border Margin="70 0 0 8" Padding="12 8"
                          Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                          CornerRadius="3" HorizontalAlignment="Left" MinWidth="260">
                    <StackPanel Spacing="8">

                      <!-- ⚠️ What put the task on the list, above the detail of it. On a job or a purchase
                           this is the whole answer to "why am I being asked for this" — the stock level it
                           is filling, the orders behind it, and the arithmetic between them — and it was
                           only ever readable by hovering the marker. -->
                      <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                 FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                 TextWrapping="Wrap" MaxWidth="720"/>

                      <Grid ColumnDefinitions="Auto,Auto">

                      <StackPanel Grid.Column="0" Spacing="5" Margin="0 0 28 0"
                                  IsVisible="{Binding HasWaitingJobs}">
                        <TextBlock Text="{x:Static loc:WorklistText.WaitingOnThisLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"/>
                        <ItemsControl ItemsSource="{Binding WaitingJobs}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorklistWaitingJobVm">
                              <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                            Margin="0 0 24 0">
                                  <Image Source="{Binding Icon}" Width="18" Height="18"
                                         VerticalAlignment="Center"/>
                                  <Panel>
                                    <Button Classes="link" Click="OnOpenWaitingJob" IsVisible="{Binding HasItemLink}"
                                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenInTheItemBrowser}">
                                      <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                                 FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                               FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                  </Panel>
                                </StackPanel>

                                <!-- ⚠️ Says which of the two it is rather than ticking only the good case.
                                     A blank beside a job reads as "not checked yet"; naming what it is
                                     still short of is the difference between a promise and a fact. -->
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                           FontSize="13" MinWidth="176" TextAlignment="Right"
                                           Foreground="{Binding StatusColor}"
                                           ToolTip.Tip="{Binding StatusTip}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding HasLines}">
                        <TextBlock Text="{x:Static loc:WorklistText.ManifestLabel}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"/>
                        <ItemsControl ItemsSource="{Binding Lines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorklistLineVm">
                              <!-- Count, then value, then volume — each in its own fixed column so the
                                   figures line up down the list rather than drifting with name length.
                                   Value and volume are dimmer than the count: the count is what the task
                                   is about, the other two are what it costs to do. -->
                              <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 2">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                            Margin="0 0 24 0">
                                  <Image Source="{Binding Icon}" Width="18" Height="18"
                                         VerticalAlignment="Center"/>
                                  <Panel>
                                    <Button Classes="link" Click="OnOpenLineItem" IsVisible="{Binding HasItemLink}"
                                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenInTheItemBrowser}">
                                      <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                                 FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                               FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                  </Panel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N0}}"
                                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                           MinWidth="60" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                           FontSize="14" Foreground="{DynamicResource TextDimBrush}"
                                           MinWidth="76" TextAlignment="Right" Margin="16 0 0 0"/>
                                <TextBlock Grid.Column="3" Text="{Binding VolumeText}"
                                           FontSize="14" Foreground="{DynamicResource TextDimBrush}"
                                           MinWidth="76" TextAlignment="Right" Margin="16 0 0 0"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                    </Grid>
                    </StackPanel>
                  </Border>
                  </ScrollViewer>
                </Popup>
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Sort here to get back to the tool's own ranking after sorting on anything else. -->
        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" FontSize="12" Width="44"
                            IsReadOnly="True"/>

        <!-- No Task column: it is the group header now. -->

        <!-- What the row is about, in a picture. ⚠️ The type shown differs by kind and is chosen
             to be the SUBJECT rather than anything the task merely touches: a buy shows what is
             being bought, a job shows what it produces rather than its blueprint or a material,
             and a corporation project shows what has to be delivered. Every one of those comes
             from the same TypeId the name link uses, so the picture and the link cannot disagree.
             Rows with no type — a haul of several things, a skill queue — leave the cell empty
             rather than showing a placeholder that would read as a kind of its own. -->
        <DataGridTemplateColumn Header="" Width="30" IsReadOnly="True" CanUserSort="False"
                                CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image Source="{Binding Icon}" Width="24" Height="24"
                     VerticalAlignment="Center" HorizontalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- The task itself, drawn per kind.
             ⚠️ One cell rather than the Description / Character / Location 1 / Location 2 / Note
             columns it replaces. A DataGrid has one column set for every row, so those five had to
             satisfy all four kinds at once and none of them well: Character was an em dash on every
             Haul row, Location 2 was blank on every Buy and Job row, and Description read
             "1 item(s)" where the actual content sat in Note. Each kind now shows what that kind
             is about. What is lost is sorting on those five as columns — the filter row above still
             narrows by character, source and destination, and #, Value and Volume remain sortable. -->
        <!-- ⚠️ Sorts on TaskSortText, not Title. A haul row shows its route rather than its title,
             so sorting on the title ordered those rows by text nobody can see — which reads as no
             ordering at all. The Overview's sections were fixed this way already; the tool's own
             grid kept the old path. -->
        <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColTask}" Width="*" SortMemberPath="TaskSortText" ClipboardContentBinding="{Binding RouteText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <Panel VerticalAlignment="Center">

                <!-- Haul: where from, where to, and how much of it. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHaul}">
                  <TextBlock Text="{Binding RouteText}" Foreground="{DynamicResource TextBrightBrush}" FontSize="16"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RouteText}"/>
                  <!-- How many items are on the run: it decides whether this is a quick courier
                       trip or a packing job, so it sits with the route rather than under it. -->
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Job: what is being made, by whom, and where — one line, like the rest. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsJob}">
                  <!-- ⚠️ The name links but does not LOOK like a link: same brush and size it had.
                       It is the row's headline, and underlining the biggest text on every row
                       would turn a plan into a page of hyperlinks. -->
                  <Panel>
                    <Button Classes="link" Click="OnOpenRowItem" IsVisible="{Binding HasItemLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisItem}">
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrightBrush}" FontSize="16"
                                 TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding Title}" IsVisible="{Binding !HasItemLink}"
                               Foreground="{DynamicResource TextBrightBrush}" FontSize="16"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                  </Panel>
                  <!-- The efficiency the materials were planned at. Sits with the station and the
                       character because it is the same sort of fact — context for the job rather
                       than part of its name. Manufacturing only; see BlueprintMeText. -->
                  <TextBlock Text="{Binding BlueprintMeText}" IsVisible="{Binding HasBlueprintMe}"
                             Foreground="{DynamicResource TextMutedBrush}" FontSize="14" VerticalAlignment="Center"
                             ToolTip.Tip="{x:Static loc:WorklistText.TipMaterialAndTimeEfficiency}"/>
                  <Panel>
                    <Button Classes="link" Click="OnOpenLocation" IsVisible="{Binding HasLocationLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisStationOrStructure}">
                      <TextBlock Text="{Binding LocationName}" Classes="linktext"
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding LocationName}" IsVisible="{Binding !HasLocationLink}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Panel>
                  <Panel>
                    <Button Classes="link" Click="OnOpenCharacter" IsVisible="{Binding HasCharacterLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenInTheEntityBrowser}">
                      <TextBlock Text="{Binding CharacterName}" Classes="linktext"
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="14"/>
                    </Button>
                    <TextBlock Text="{Binding CharacterName}" IsVisible="{Binding !HasCharacterLink}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                  </Panel>
                </StackPanel>

                <!-- Buy: what to buy, where, and who places it. The reasoning is a paragraph, so
                     it lives on the marker rather than on the row. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBuy}">
                  <Panel>
                    <Button Classes="link" Click="OnOpenRowItem" IsVisible="{Binding HasItemLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisItem}">
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrightBrush}" FontSize="16"
                                 TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding Title}" IsVisible="{Binding !HasItemLink}"
                               Foreground="{DynamicResource TextBrightBrush}" FontSize="16"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                  </Panel>
                  <Panel>
                    <Button Classes="link" Click="OnOpenLocation" IsVisible="{Binding HasLocationLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisStationOrStructure}">
                      <TextBlock Text="{Binding LocationName}" Classes="linktext"
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding LocationName}" IsVisible="{Binding !HasLocationLink}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Panel>
                  <Panel>
                    <Button Classes="link" Click="OnOpenCharacter" IsVisible="{Binding HasCharacterLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenInTheEntityBrowser}">
                      <TextBlock Text="{Binding CharacterName}" Classes="linktext"
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="14"/>
                    </Button>
                    <TextBlock Text="{Binding CharacterName}" IsVisible="{Binding !HasCharacterLink}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                  </Panel>
                </StackPanel>

                <!-- Reprocessing and decompressing: what to do, and the one station to do it at.
                     No character, because the action needs whoever is already there rather than a
                     particular pilot. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRefining}">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrightBrush}" FontSize="16"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                  <Panel>
                    <Button Classes="link" Click="OnOpenLocation" IsVisible="{Binding HasLocationLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisStationOrStructure}">
                      <TextBlock Text="{Binding LocationName}" Classes="linktext"
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding LocationName}" IsVisible="{Binding !HasLocationLink}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Panel>
                </StackPanel>

                <!-- Corp projects, asset safety, skill queues: no shared shape between them, so
                     they keep the plain title. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOther}">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrightBrush}" FontSize="16"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                  <!-- Skill-queue rows land here and name a character; corp projects and asset
                       safety do not, and their link simply never shows. -->
                  <Panel IsVisible="{Binding HasCharacterLink}">
                    <Button Classes="link" Click="OnOpenCharacter"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenInTheEntityBrowser}">
                      <TextBlock Text="{Binding CharacterName}" Classes="linktext"
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="14"/>
                    </Button>
                  </Panel>
                </StackPanel>

              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- The reasoning, behind a marker. It runs to a paragraph on a buy — what it feeds, what
             is on hand, what is on order — worth reading on the one row you are looking at and
             not worth printing on the other hundred and forty. Red when there is a note attached,
             since that is the case that wants noticing rather than seeking out. -->
        <DataGridTemplateColumn Header="" Width="26" CanUserSort="False" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <TextBlock Text="&#x24D8;" FontSize="16"
                         IsVisible="{Binding HasDetailTip}"
                         Foreground="{Binding ReadinessBarColor}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding DetailTip}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- The planner's sort keys, in the order it applies them. Hidden again now the ordering
             question they were switched on for is answered. They explain an ordering that cannot
             be audited from the outside and there is no column picker, so bringing them back
             means clearing IsVisible on the six columns below and rebuilding — worth doing the
             moment "why is this above that" comes up, because nothing else can answer it.
             ⚠️ SortPriority is NOT debug-only — the row order itself sorts on it, since the
             stamped priority and the one the planner used are different numbers. -->
        <DataGridTextColumn Binding="{Binding DbgPriority}" FontSize="11" Width="55"
                            CellStyleClasses="num" Header="{x:Static loc:WorklistText.ColPrio}" IsVisible="False" />
        <DataGridTextColumn Binding="{Binding DbgFinal}" FontSize="11" Width="50"
                            CellStyleClasses="num" Header="{x:Static loc:WorklistText.ColFin}" IsVisible="False" />
        <DataGridTextColumn Binding="{Binding DbgBlocked}" FontSize="11" Width="55"
                            CellStyleClasses="num" Header="{x:Static loc:WorklistText.ColBlkd}" IsVisible="False" />
        <DataGridTextColumn Binding="{Binding DbgCoverage}" FontSize="11" Width="65"
                            CellStyleClasses="num" Header="{x:Static loc:WorklistText.ColCover}" IsVisible="False" />
        <DataGridTextColumn Binding="{Binding DbgSeq}" FontSize="11" Width="50"
                            CellStyleClasses="num" Header="{x:Static loc:WorklistText.ColSeq}" IsVisible="False" />

        <!-- How many stopped tasks this row would release: the key that separates hauls and
             purchases from each other, blank on everything else. Hidden alongside the keys above,
             but ⚠️ the VALUE is not diagnostic — it is the fourth sort key, and it also raises the
             priority a haul or purchase inherits. Switch it on with them when asking why one
             delivery or market order outranks another. Sorted on the number so 9 does not
             outrank 50. -->
        <DataGridTextColumn Binding="{Binding UnblocksText}" FontSize="11" Width="70"
                            SortMemberPath="Unblocks" CellStyleClasses="num" Header="{x:Static loc:WorklistText.ColFrees}" IsVisible="False" />

        <!-- Value and Volume: the two figures worth comparing across every kind, and the pair a
             hauler and a buyer each reach for. Blank rather than zero when unpriced — a science
             job has no stored blueprint value per ME level. -->
        <DataGridTextColumn Binding="{Binding ValueText}" FontSize="12" Width="100"
                            CellStyleClasses="num" SortMemberPath="Value">
          <DataGridTextColumn.Header>
            <TextBlock Text="{x:Static loc:WorklistText.Value}" HorizontalAlignment="Right"/>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding VolumeText}" FontSize="12" Width="110"
                            CellStyleClasses="num" SortMemberPath="VolumeRaw">
          <DataGridTextColumn.Header>
            <TextBlock Text="{x:Static loc:WorklistText.Volume}" HorizontalAlignment="Right"/>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>

        <DataGridTemplateColumn Header="" Width="80">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <!-- Shown on row hover. A button on all 166 rows is a lot of permanent chrome for
                   an action taken on one of them; Opacity rather than IsVisible so the column does
                   not resize as the pointer moves down the list. -->
              <Button Content="{x:Static loc:WorklistText.Snooze}" Classes="snooze"
                      Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).SnoozeCommand}"
                      CommandParameter="{Binding Key}"
                      FontSize="11" Padding="6 2" Background="Transparent"
                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Cursor="Hand"
                      ToolTip.Tip="{x:Static loc:WorklistText.TipHideThisItemFor8}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>
  </Grid>
    </TabItem>

    <!-- ════ Station Needs ══════════════════════════════════════════════════════
         What each station wants and which demand is asking for it. The worklist
         says what to do; this says why, which is what gets asked when a
         suggestion looks wrong. -->
    <TabItem Header="{x:Static loc:WorklistText.TabStationNeeds}">
      <Grid RowDefinitions="Auto,Auto,*" Margin="14 12">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0 0 0 8">
          <TextBlock Text="{x:Static loc:WorklistText.StationNeeds}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <Button Content="{x:Static loc:WorklistText.Refresh}" Command="{Binding RefreshNeedsCommand}"
                  IsEnabled="{Binding !NeedsLoading}" FontSize="11" Padding="10 4"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding NeedsStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid LoadingRow="OnRowLoading" UnloadingRow="OnRowUnloading" Grid.Row="2" ItemsSource="{Binding NeedsView}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                  CanUserSortColumns="True"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <DataGrid.Styles>
            <Style Selector="DataGridCell TextBlock">
              <Setter Property="FontSize" Value="10" />
            </Style>

            <!-- Group header: the station once, with what its rows add up to, rather than the
                 Station column repeating it on every line. Same retemplate as the task grid above
                 — see that comment for why the stock template is replaced rather than styled, and
                 why PART_ExpanderButton must keep its name.
                 ⚠️ The station name here is deliberately plain. The header is a
                 DataGridCollectionViewGroup and knows only its key string, not the row behind it,
                 so it has no id to open; the Station column on each row carries the link. -->
            <Style Selector="DataGridRowGroupHeader">
              <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="MinHeight"  Value="28"/>
              <Setter Property="Template">
                <ControlTemplate x:DataType="collections:DataGridCollectionViewGroup">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 1">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="6 0"
                                VerticalAlignment="Center">
                      <ToggleButton Name="PART_ExpanderButton" Width="12" Height="12"
                                    Theme="{DynamicResource FluentDataGridRowGroupExpanderButtonTheme}"
                                    Background="Transparent" BorderThickness="0"/>
                      <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                 Text="{Binding Items, Converter={x:Static conv:GroupTotalConverter.Instance},
                                                 ConverterParameter=Count}"/>
                    </StackPanel>
                  </Border>
                </ControlTemplate>
              </Setter>
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <!-- ⚠️ A dash rather than an empty cell when nothing itemised the need. Blank reads
                 as "the feature is broken"; a dash says "asked, and there is nothing to show". -->
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColWhy}" Width="46" MinWidth="34" CanUserSort="False" ClipboardContentBinding="{Binding Glyph}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <Panel>
                    <!-- ⚠️ Sized like the Item Contention expander, box and all. Capping the
                         height at 20 to stop the bigger glyph dragging every row taller cropped
                         the glyph instead: the line box the character is drawn in is taller than
                         its ink, so clipping the box clips the triangle. A square button with no
                         padding holds it whole. -->
                    <Panel>
                      <Button Classes="expander" Click="OnNeedToggle"
                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                              Padding="0" Width="24" Height="24" MinWidth="0" MinHeight="0"
                              FontSize="20" Foreground="{DynamicResource TextMutedBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsVisible="{Binding HasDrivers}" Content="{Binding Glyph}"
                              ToolTip.Tip="{x:Static loc:WorklistText.TipWhatIsAskingForThis}"/>

                      <!-- ⚠️ A popup, NOT RowDetails, and the difference is the whole point. A drawer
                           inside a row makes rows wildly different heights, and the DataGrid prices
                           every row it has not realised from a single average of them; it also reuses
                           a row between an open one and a closed one and measures it before the
                           drawer has caught up. Both are why scrolling up used to stick and jump.
                           See tools/gridsim. Floating the detail leaves every row one height, so
                           there is nothing left to estimate wrongly.
                      
                           ⚠️ Light dismiss with a TwoWay binding, so clicking away puts the glyph
                           back. The flag still lives on the ITEM, not the row: the grid recycles
                           rows, and a popup keyed to the row would open against whatever item
                           landed in it next. -->
                      <Popup IsOpen="{Binding IsExpanded}" Closed="OnDetailClosed" DetachedFromVisualTree="OnDetailDetached"
                             Placement="BottomEdgeAlignedLeft"
                             IsLightDismissEnabled="True">
                        <!-- ⚠️ A ceiling, with the scrolling inside it. A blueprint list ran the
                             full height of the screen and off the bottom of it. -->
                        <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 1"
                                Padding="24 6 8 8" IsVisible="{Binding HasDrivers}">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static loc:WorklistText.AskedForByLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"/>
                            <ItemsControl ItemsSource="{Binding Drivers}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NeedDriverRowVm">
                                  <Grid ColumnDefinitions="240,110,*" Margin="0 1">
                                    <Panel Grid.Column="0">
                                      <Button Classes="link" Click="OnOpenNeedDriver" IsVisible="{Binding HasLink}"
                                              ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisItem}">
                                        <TextBlock Text="{Binding Driver}" Classes="linktext" FontSize="10"/>
                                      </Button>
                                      <TextBlock Text="{Binding Driver}" IsVisible="{Binding !HasLink}"
                                                 FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Panel>
                                    <TextBlock Grid.Column="1" Text="{Binding Qty}" FontSize="10"
                                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="10"
                                               Foreground="{DynamicResource TextDimBrush}"/>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        </ScrollViewer>
                      </Popup>
                    </Panel>
                    <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" Margin="6 0"
                               VerticalAlignment="Center" IsVisible="{Binding !HasDrivers}"
                               ToolTip.Tip="{x:Static loc:WorklistText.TipNothingItemisedThisNeed}"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColStation}" Width="230" SortMemberPath="Station" ClipboardContentBinding="{Binding Station}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenNeedStation" IsVisible="{Binding HasStationLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisStationOrStructure}">
                      <TextBlock Text="{Binding Station}" Classes="linktext"
                                 TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding Station}" IsVisible="{Binding !HasStationLink}"
                               ToolTip.Tip="{Binding Station}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColItem}" Width="230" SortMemberPath="Item" ClipboardContentBinding="{Binding Item}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenNeedItem" IsVisible="{Binding HasItemLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenInTheItemBrowser}">
                      <TextBlock Text="{Binding Item}" Classes="linktext"
                                 TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding Item}" IsVisible="{Binding !HasItemLink}"
                               ToolTip.Tip="{Binding Item}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColTotal}"   Binding="{Binding Total}"  SortMemberPath="TotalRaw"  Width="110"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColOnHand}" Binding="{Binding OnHand}" SortMemberPath="OnHandRaw" Width="110"/>

            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColShort}" Width="110" SortMemberPath="ShortRaw" ClipboardContentBinding="{Binding Short}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <TextBlock Text="{Binding Short}" Foreground="{Binding ShortColor}"
                             FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColShortValue}"  Binding="{Binding ShortValue}"
                                SortMemberPath="ShortValueRaw"  Width="100"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColShortVolume}" Binding="{Binding ShortVolume}"
                                SortMemberPath="ShortVolumeRaw" Width="110"/>

            <!-- The breakdown. These four always add back to Total. -->
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColOrderJobs}"       Binding="{Binding OrderJobs}" SortMemberPath="OrderJobsRaw" Width="110"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColJobs}"             Binding="{Binding Jobs}"      SortMemberPath="JobsRaw"      Width="110"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColInventoryLevels}" Binding="{Binding InvLevels}" SortMemberPath="InvLevelsRaw" Width="120"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColStationLevels}"   Binding="{Binding StnLevels}" SortMemberPath="StnLevelsRaw" Width="*"/>
          </DataGrid.Columns>

          <!-- The third level: what is asking for this item HERE. A need is a number until you
               know what it is for, and "what is this for" is asked of one row at a time — so it
               opens under the row rather than taking a column that would be empty on most of
               them. -->
        </DataGrid>
      </Grid>
    </TabItem>

    <!-- ════ Item Needs ═════════════════════════════════════════════════════════
         The same needs read the other way round: each item once, and every station
         waiting on it beneath. Station Needs answers "what does this place want";
         this answers "who is waiting on this, and how much do I need in total". -->
    <TabItem Header="{x:Static loc:WorklistText.TabItemNeeds}">
      <Grid RowDefinitions="Auto,Auto,*" Margin="14 12">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0 0 0 8">
          <TextBlock Text="{x:Static loc:WorklistText.ItemNeeds}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <Button Content="{x:Static loc:WorklistText.Refresh}" Command="{Binding RefreshNeedsCommand}"
                  IsEnabled="{Binding !NeedsLoading}" FontSize="11" Padding="10 4"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding NeedsStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid LoadingRow="OnRowLoading" UnloadingRow="OnRowUnloading" Grid.Row="2" ItemsSource="{Binding ItemNeedsView}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                  CanUserSortColumns="True"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <DataGrid.Styles>
            <Style Selector="DataGridCell TextBlock">
              <Setter Property="FontSize" Value="10" />
            </Style>

            <!-- Group header: the station once, with what its rows add up to, rather than the
                 Station column repeating it on every line. Same retemplate as the task grid above
                 — see that comment for why the stock template is replaced rather than styled, and
                 why PART_ExpanderButton must keep its name.
                 ⚠️ The item name here is deliberately plain. The header is a
                 DataGridCollectionViewGroup and knows only its key string, not the row behind it,
                 so it has no id to open; the Item column on each row carries the link. -->
            <Style Selector="DataGridRowGroupHeader">
              <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="MinHeight"  Value="28"/>
              <Setter Property="Template">
                <ControlTemplate x:DataType="collections:DataGridCollectionViewGroup">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 1">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="6 0"
                                VerticalAlignment="Center">
                      <ToggleButton Name="PART_ExpanderButton" Width="12" Height="12"
                                    Theme="{DynamicResource FluentDataGridRowGroupExpanderButtonTheme}"
                                    Background="Transparent" BorderThickness="0"/>
                      <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                 Text="{Binding Items, Converter={x:Static conv:GroupTotalConverter.Instance},
                                                 ConverterParameter=Count}"/>
                    </StackPanel>
                  </Border>
                </ControlTemplate>
              </Setter>
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <!-- ⚠️ A dash rather than an empty cell when nothing itemised the need. Blank reads
                 as "the feature is broken"; a dash says "asked, and there is nothing to show". -->
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColWhy}" Width="46" MinWidth="34" CanUserSort="False" ClipboardContentBinding="{Binding Glyph}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <Panel>
                    <!-- ⚠️ Sized like the Item Contention expander, box and all. Capping the
                         height at 20 to stop the bigger glyph dragging every row taller cropped
                         the glyph instead: the line box the character is drawn in is taller than
                         its ink, so clipping the box clips the triangle. A square button with no
                         padding holds it whole. -->
                    <Panel>
                      <Button Classes="expander" Click="OnNeedToggle"
                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                              Padding="0" Width="24" Height="24" MinWidth="0" MinHeight="0"
                              FontSize="20" Foreground="{DynamicResource TextMutedBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsVisible="{Binding HasDrivers}" Content="{Binding Glyph}"
                              ToolTip.Tip="{x:Static loc:WorklistText.TipWhatIsAskingForThis}"/>

                      <!-- ⚠️ A popup, NOT RowDetails, and the difference is the whole point. A drawer
                           inside a row makes rows wildly different heights, and the DataGrid prices
                           every row it has not realised from a single average of them; it also reuses
                           a row between an open one and a closed one and measures it before the
                           drawer has caught up. Both are why scrolling up used to stick and jump.
                           See tools/gridsim. Floating the detail leaves every row one height, so
                           there is nothing left to estimate wrongly.
                      
                           ⚠️ Light dismiss with a TwoWay binding, so clicking away puts the glyph
                           back. The flag still lives on the ITEM, not the row: the grid recycles
                           rows, and a popup keyed to the row would open against whatever item
                           landed in it next. -->
                      <Popup IsOpen="{Binding IsExpanded}" Closed="OnDetailClosed" DetachedFromVisualTree="OnDetailDetached"
                             Placement="BottomEdgeAlignedLeft"
                             IsLightDismissEnabled="True">
                        <!-- ⚠️ A ceiling, with the scrolling inside it. A blueprint list ran the
                             full height of the screen and off the bottom of it. -->
                        <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 1"
                                Padding="24 6 8 8" IsVisible="{Binding HasDrivers}">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static loc:WorklistText.AskedForByLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"/>
                            <ItemsControl ItemsSource="{Binding Drivers}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NeedDriverRowVm">
                                  <Grid ColumnDefinitions="240,110,*" Margin="0 1">
                                    <Panel Grid.Column="0">
                                      <Button Classes="link" Click="OnOpenNeedDriver" IsVisible="{Binding HasLink}"
                                              ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisItem}">
                                        <TextBlock Text="{Binding Driver}" Classes="linktext" FontSize="10"/>
                                      </Button>
                                      <TextBlock Text="{Binding Driver}" IsVisible="{Binding !HasLink}"
                                                 FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Panel>
                                    <TextBlock Grid.Column="1" Text="{Binding Qty}" FontSize="10"
                                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" Margin="0 0 12 0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="10"
                                               Foreground="{DynamicResource TextDimBrush}"/>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        </ScrollViewer>
                      </Popup>
                    </Panel>
                    <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" Margin="6 0"
                               VerticalAlignment="Center" IsVisible="{Binding !HasDrivers}"
                               ToolTip.Tip="{x:Static loc:WorklistText.TipNothingItemisedThisNeed}"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColStation}" Width="230" SortMemberPath="Station" ClipboardContentBinding="{Binding Station}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenNeedStation" IsVisible="{Binding HasStationLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisStationOrStructure}">
                      <TextBlock Text="{Binding Station}" Classes="linktext"
                                 TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding Station}" IsVisible="{Binding !HasStationLink}"
                               ToolTip.Tip="{Binding Station}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColItem}" Width="230" SortMemberPath="Item" ClipboardContentBinding="{Binding Item}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenNeedItem" IsVisible="{Binding HasItemLink}"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipOpenInTheItemBrowser}">
                      <TextBlock Text="{Binding Item}" Classes="linktext"
                                 TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding Item}" IsVisible="{Binding !HasItemLink}"
                               ToolTip.Tip="{Binding Item}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColTotal}"   Binding="{Binding Total}"  SortMemberPath="TotalRaw"  Width="110"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColOnHand}" Binding="{Binding OnHand}" SortMemberPath="OnHandRaw" Width="110"/>

            <!-- ⚠️ Item Needs only. This tab asks what still has to be MADE, so production
                 counts; Station Needs asks what a station holds against what it wants, and a
                 job three days from delivering does not fill a hangar today. -->
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColInBuild}" Binding="{Binding InBuild}"
                                SortMemberPath="InBuildRaw" Width="110"/>
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColShort}" Width="110" SortMemberPath="ShortAfterBuildRaw" ClipboardContentBinding="{Binding ShortAfterBuild}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <TextBlock Text="{Binding ShortAfterBuild}" Foreground="{Binding ShortColor}"
                             FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColShortValue}"  Binding="{Binding ShortValue}"
                                SortMemberPath="ShortValueRaw"  Width="100"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColShortVolume}" Binding="{Binding ShortVolume}"
                                SortMemberPath="ShortVolumeRaw" Width="110"/>

            <!-- The breakdown. These four always add back to Total. -->
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColOrderJobs}"       Binding="{Binding OrderJobs}" SortMemberPath="OrderJobsRaw" Width="110"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColJobs}"             Binding="{Binding Jobs}"      SortMemberPath="JobsRaw"      Width="110"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColInventoryLevels}" Binding="{Binding InvLevels}" SortMemberPath="InvLevelsRaw" Width="120"/>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColStationLevels}"   Binding="{Binding StnLevels}" SortMemberPath="StnLevelsRaw" Width="*"/>
          </DataGrid.Columns>

          <!-- The third level: what is asking for this item HERE. A need is a number until you
               know what it is for, and "what is this for" is asked of one row at a time — so it
               opens under the row rather than taking a column that would be empty on most of
               them. -->
        </DataGrid>
      </Grid>
    </TabItem>


    <!-- ════ Bottlenecks ═════════════════════════════════════════════════════════
         What is stopping the list from moving, and what each remedy would actually
         buy. Three different ceilings, reported apart because they are not
         interchangeable: an account does nothing for a shortage of originals, and
         neither helps if the material never arrived. -->
    <TabItem Header="{x:Static loc:WorklistText.TabBottlenecks}">
      <Grid RowDefinitions="Auto,Auto,*" Margin="14 12">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0 0 0 8">
          <TextBlock Text="{x:Static loc:WorklistText.Bottlenecks}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <Button Content="{x:Static loc:WorklistText.Refresh}" Command="{Binding RefreshBottlenecksCommand}"
                  IsEnabled="{Binding !BottlenecksLoading}" FontSize="11" Padding="10 4"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding BottleneckStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>


        <!-- Three questions, three tabs. Slots and blueprints are different ceilings with
             different remedies, and reading them as one list invited exactly the mistake the
             Summary will exist to prevent: buying capacity for a shortage of prints. -->
        <TabControl Grid.Row="2" Padding="0">

          <TabItem Header="{x:Static loc:WorklistText.TabSummary}" FontSize="12">
            <!-- ⚠️ Not a grid. Everything here is already available as figures on the other four
                 tabs; what is missing is the sentence that says which of them matters, and a
                 table would hand the reader the same sorting problem in a fifth place. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0 10 14 14" Spacing="14">

                <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:WorklistText.WhatToDoInNote}"/>

                <ItemsControl ItemsSource="{Binding Observations}">
                  <!-- ⚠️ UniformGrid, not two bound halves. It fills left to right and then
                       down, which keeps the ranked order readable across the pair; splitting
                       the list into a left half and a right half would put the second-most
                       important finding at the top of the right column, and the reader would
                       have to know that to read it in order. -->
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ObservationVm">
                      <!-- ⚠️ A card, with the accent as a filled bar rather than a border side.
                           A Border carries one brush for all four sides, so an accent rule and a
                           card outline cannot be the same element — nesting a filled column
                           inside the card is what lets the primary finding be marked without
                           tinting its whole outline. -->
                      <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                              CornerRadius="4" Margin="0 0 24 18">
                        <Grid ColumnDefinitions="3,*">
                          <Border Grid.Column="0" Background="{Binding RuleColor}"
                                  CornerRadius="3 0 0 3"/>
                          <StackPanel Grid.Column="1" Margin="14 12 14 12" Spacing="6">
                          <TextBlock Text="{Binding Marker}" FontSize="10" FontWeight="SemiBold"
                                     Foreground="{Binding MarkerColor}" LetterSpacing="1"/>
                          <TextBlock Text="{Binding Headline}" FontSize="15" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Body}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                     TextWrapping="Wrap" LineHeight="19"/>

                          <ItemsControl ItemsSource="{Binding Points}" IsVisible="{Binding HasPoints}"
                                        Margin="0 4 0 0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ObservationPointVm">
                                <Grid ColumnDefinitions="24,*" Margin="0 0 0 4">
                                  <!-- The item's picture where the line is about one, the bullet
                                       where it is not: a slot finding names no item. -->
                                  <TextBlock Grid.Column="0" Text="·" FontSize="14"
                                             IsVisible="{Binding !HasIcon}"
                                             Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Top"/>
                                  <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18"
                                         IsVisible="{Binding HasIcon}" HorizontalAlignment="Left"
                                         VerticalAlignment="Top" Margin="0 1 0 0"/>
                                  <!-- ⚠️ The whole line, not just the name inside it. The finding
                                       is written as one sentence about one item, and picking the
                                       name back out of it would mean splitting prose on a dash. The
                                       link style adds a cursor and a hover underline and leaves the
                                       colour alone, so a bullet still reads as a bullet. -->
                                  <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13"
                                             IsVisible="{Binding !HasItem}"
                                             Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                  <Button Grid.Column="1" Classes="link" Click="OnOpenPoint"
                                          IsVisible="{Binding HasItem}" Padding="0"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisItemIn}">
                                    <TextBlock Text="{Binding Text}" FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                  </Button>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding !Observations.Count}"
                           Text="{x:Static loc:WorklistText.NothingIsHoldingTheNote}"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{x:Static loc:WorklistText.TabSlots}" FontSize="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="16" Margin="0 8 0 0">
            <!-- ── Slots ──────────────────────────────────────────────────── -->
            <StackPanel Spacing="6">
              <TextBlock Text="{x:Static loc:WorklistText.SlotsLabel}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"/>
              <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                         Text="{x:Static loc:WorklistText.SlotsAreBandwidthNotNote}"/>

              <ItemsControl ItemsSource="{Binding SlotPressure}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SlotPressureRowVm">
                    <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12 10" Margin="0 0 0 8">
                      <StackPanel Spacing="8">

                        <Grid ColumnDefinitions="170,*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Pool}" FontSize="13"
                                     FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Headline}" FontSize="11"
                                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Utilised}" FontSize="16"
                                     Foreground="{Binding UtilisedColor}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{x:Static loc:WorklistText.Capacity}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                            <TextBlock Text="{Binding Capacity}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{x:Static loc:WorklistText.InUse}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                            <TextBlock Text="{Binding InUse}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock Text="{x:Static loc:WorklistText.Free}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                            <TextBlock Text="{Binding Free}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="3" Spacing="1">
                            <TextBlock Text="{x:Static loc:WorklistText.WaitingOnASlot}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                            <TextBlock Text="{Binding Waiting}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="4" Spacing="1">
                            <TextBlock Text="{x:Static loc:WorklistText.Blocked}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                            <TextBlock Text="{Binding Blocked}" FontSize="12" Foreground="{DynamicResource BadBrush}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="5" Spacing="1">
                            <TextBlock Text="{x:Static loc:WorklistText.DaysToCatchUp}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                            <TextBlock Text="{Binding ClearDays}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                            <!-- kept -->
                          </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Remedies}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="wl:SlotRemedy">
                              <Grid ColumnDefinitions="320,110,230,*" Margin="0 2">
                                <TextBlock Grid.Column="0" Text="{Binding Action}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0 0 10 0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Gain}" FontSize="11"
                                           Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="{Binding Effect}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="10"
                                           Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>


          <TabItem Header="{x:Static loc:WorklistText.TabItemContention}" FontSize="12">
            <!-- Notes fixed at the top, the list takes the rest. -->
            <Grid RowDefinitions="Auto,*" Margin="0 8 0 0">
              <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="{x:Static loc:WorklistText.MaterialsLabel}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"/>
                <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:WorklistText.MaterialsThePipelineRunsNote}"/>
              </StackPanel>

              <DataGrid LoadingRow="OnRowLoading" UnloadingRow="OnRowUnloading" Grid.Row="1" ItemsSource="{Binding ItemShortages}" IsReadOnly="True"
                        AutoGenerateColumns="False" FontSize="11"
                        Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
                <DataGrid.Columns>
                  <!-- Expander. Only drawn where there are tasks to show, so an empty cell reads
                       as "nothing to open" rather than as a control that does nothing. -->
                  <DataGridTemplateColumn Header="" Width="24" CanUserSort="False" CanUserResize="False" ClipboardContentBinding="{Binding Glyph}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ItemShortageRowVm">
                        <Panel>
                          <Button Classes="expander" Click="OnShortageToggle"
                                  IsVisible="{Binding HasTasks}"
                                  Content="{Binding Glyph}" FontSize="20"
                                  Padding="0" Width="24" Height="24" MinWidth="0" MinHeight="0"
                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                                  Cursor="Hand"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 3 0 0"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  ToolTip.Tip="{x:Static loc:WorklistText.TipShowTheTasksBehindThese}"/>

                          <!-- ⚠️ A popup, NOT RowDetails, and the difference is the whole point.
                               A drawer inside a row makes rows wildly different heights, and the
                               DataGrid prices every row it has not realised from a single average
                               of them; it also reuses a row between an open one and a closed one
                               and measures it before the drawer has caught up. Both are why
                               scrolling up used to stick and jump. See tools/gridsim. Floating the
                               detail leaves every row the same height, so there is nothing left to
                               estimate wrongly.

                               ⚠️ Light dismiss with a TwoWay binding, so clicking away puts the
                               glyph back. The flag still lives on the ITEM, not the row: the grid
                               recycles rows, and a popup keyed to the row would open against
                               whatever item landed in it next. -->
                          <Popup IsOpen="{Binding IsExpanded}" Closed="OnDetailClosed" DetachedFromVisualTree="OnDetailDetached"
                                 Placement="BottomEdgeAlignedLeft"
                                 IsLightDismissEnabled="True">
                            <!-- ⚠️ A ceiling, with the scrolling inside it. A blueprint list ran the
                                 full height of the screen and off the bottom of it. -->
                            <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                            <Border Padding="10 7" MinWidth="720"
                                    Background="{DynamicResource SurfaceBaseBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="3">
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShortageTaskRowVm">
                                      <Grid ColumnDefinitions="90,70,320,*" Margin="0 1">
                                        <TextBlock Grid.Column="0" Text="{Binding Role}" FontSize="10"
                                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Top" Margin="0 3 0 0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="10"
                                                   Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                                    Margin="{Binding Indent}" VerticalAlignment="Center">
                                          <Image Source="{Binding Icon}" Width="14" Height="14"
                                                 IsVisible="{Binding HasIcon}" VerticalAlignment="Center"/>
                                          <TextBlock Text="{Binding Title}" FontSize="10"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Why}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            </ScrollViewer>
                          </Popup>
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Width="230" ClipboardContentBinding="{Binding Item}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Material}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipTheItemThatRan}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ItemShortageRowVm">
                        <Grid ColumnDefinitions="Auto,*">
                          <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18"
                                 Margin="0 0 6 0" VerticalAlignment="Center"/>
                          <Panel Grid.Column="1">
                            <Button Classes="link" Click="OnOpenShortageItem" IsVisible="{Binding HasLink}"
                                    ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisItem}">
                              <TextBlock Text="{Binding Item}" Classes="linktext"/>
                            </Button>
                            <TextBlock Text="{Binding Item}" IsVisible="{Binding !HasLink}"
                                       VerticalAlignment="Center"/>
                          </Panel>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn     Binding="{Binding Used}"    Width="75">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Used}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipConsumedPerDayOver}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn     Binding="{Binding Made}"    Width="75">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Made}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipProducedPerDayOver}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Width="75" ClipboardContentBinding="{Binding Balance}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Balance}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipMadePerUnitConsumed}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ItemShortageRowVm">
                        <TextBlock Text="{Binding Balance}" Foreground="{Binding BalanceColor}"
                                   VerticalAlignment="Top" Margin="0 3 0 0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn    Binding="{Binding Level}"   Width="70">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Level}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhatTheInventoryLevels}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn  Binding="{Binding OnHand}"  Width="80">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.OnHand}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipUnitsTheIndustryScope}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Width="80" ClipboardContentBinding="{Binding Need}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Need}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhatTheWorkOn}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ItemShortageRowVm">
                        <TextBlock Text="{Binding Need}" Foreground="{Binding NeedColor}"
                                   VerticalAlignment="Top" Margin="0 3 0 0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn    Binding="{Binding Cover}"   Width="65">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Cover}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipTheLevelMeasuredIn}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn    Binding="{Binding Surge}"   Width="60">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Surge}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipHowMuchHarderThis}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn Binding="{Binding Blocking}" Width="75">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Blocking}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipTasksThisShortageIs}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn  Binding="{Binding MakeRunning}" Width="70">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Running}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipJobsMakingThisItem}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn    Binding="{Binding MakeReady}"   Width="60">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Ready}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipTasksToMakeThis}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn  Binding="{Binding MakeWaiting}" Width="70">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Waiting}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipTasksToMakeThis2}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Width="60" ClipboardContentBinding="{Binding MakeBlocked}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Stuck}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipTasksToMakeThis3}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ItemShortageRowVm">
                        <TextBlock Text="{Binding MakeBlocked}" Foreground="{Binding MakeBlockedColor}"
                                   VerticalAlignment="Top" Margin="0 3 0 0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Width="110" ClipboardContentBinding="{Binding Verdict}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Verdict}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhatTheRowAmounts}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ItemShortageRowVm">
                        <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictColor}"
                                   VerticalAlignment="Top" Margin="0 3 0 0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- Wraps, and the row grows to fit. A DataGridTextColumn cannot wrap at all, so the whole
                       sentence sat on one clipped line and the half worth reading - what to do
                       about the shortage - was the half off the right edge. -->
                  <DataGridTemplateColumn Width="*" MinWidth="260"
                                          CanUserSort="False" ClipboardContentBinding="{Binding Advice}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Suggestion}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhatIsHappeningAnd}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ItemShortageRowVm">
                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="0 3 4 3"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="{x:Static loc:WorklistText.TabBpoFormula}" FontSize="12">
            <!-- A grid, not a stack in a scroller: the notes above it are three fixed lines and
                 everything left over belongs to the list. -->
            <Grid RowDefinitions="Auto,*" Margin="0 8 0 0">
            <StackPanel Grid.Row="0" Spacing="6">
              <TextBlock Text="{x:Static loc:WorklistText.BlueprintsLabel}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"/>
              <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                         Text="{x:Static loc:WorklistText.ABlueprintBottleneckIsNote}"/>
            </StackPanel>

              <DataGrid LoadingRow="OnRowLoading" UnloadingRow="OnRowUnloading" Grid.Row="1" ItemsSource="{Binding PrintPressure}" IsReadOnly="True"
                        AutoGenerateColumns="False" FontSize="11"
                        Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">

                <!-- The tasks the counts are made of, same shape as Item Contention. -->
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="24" MinWidth="24"
                                          CanUserSort="False" CanUserResize="False" ClipboardContentBinding="{Binding Glyph}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PrintPressureRowVm">
                        <Panel>
                          <Button Classes="expander" Click="OnPrintToggle"
                                  IsVisible="{Binding HasTasks}"
                                  Content="{Binding Glyph}" FontSize="20"
                                  Padding="0" Width="24" Height="24" MinWidth="0" MinHeight="0"
                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                                  Cursor="Hand"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  ToolTip.Tip="{x:Static loc:WorklistText.TipShowTheTasksBehindThese}"/>

                          <!-- ⚠️ A popup, NOT RowDetails, and the difference is the whole point. A drawer
                               inside a row makes rows wildly different heights, and the DataGrid prices
                               every row it has not realised from a single average of them; it also reuses
                               a row between an open one and a closed one and measures it before the
                               drawer has caught up. Both are why scrolling up used to stick and jump.
                               See tools/gridsim. Floating the detail leaves every row one height, so
                               there is nothing left to estimate wrongly.
                          
                               ⚠️ Light dismiss with a TwoWay binding, so clicking away puts the glyph
                               back. The flag still lives on the ITEM, not the row: the grid recycles
                               rows, and a popup keyed to the row would open against whatever item
                               landed in it next. -->
                          <Popup IsOpen="{Binding IsExpanded}" Closed="OnDetailClosed" DetachedFromVisualTree="OnDetailDetached"
                                 Placement="BottomEdgeAlignedLeft"
                                 IsLightDismissEnabled="True">
                            <!-- ⚠️ A ceiling, with the scrolling inside it. A blueprint list ran the
                                 full height of the screen and off the bottom of it. -->
                            <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                            <Border Margin="20 0 0 6" Padding="10 7" IsVisible="{Binding HasTasks}"
                                    Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="3" HorizontalAlignment="Left" MinWidth="560">
                              <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ShortageTaskRowVm">
                                    <Grid ColumnDefinitions="90,70,320,*" Margin="0 1">
                                      <TextBlock Grid.Column="0" Text="{Binding Role}" FontSize="10"
                                                 Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Top" Margin="0 3 0 0"/>
                                      <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="10"
                                                 Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                                  Margin="{Binding Indent}" VerticalAlignment="Center">
                                        <!-- Fixed slot, drawn or not — the picture arrives after the grid
                                             has sized the row, so it must not change the size when it does. -->
                                        <Image Source="{Binding Icon}" Width="14" Height="14"
                                               IsVisible="{Binding HasIcon}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                      </StackPanel>
                                      <TextBlock Grid.Column="3" Text="{Binding Why}" FontSize="10"
                                                 Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Border>
                            </ScrollViewer>
                          </Popup>
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Width="220" ClipboardContentBinding="{Binding Product}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Product}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhatThisBlueprintOr}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PrintPressureRowVm">
                        <Grid ColumnDefinitions="Auto,*">
                          <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18"
                                 Margin="0 0 6 0" VerticalAlignment="Center"/>
                          <Panel Grid.Column="1">
                            <Button Classes="link" Click="OnOpenPrintProduct" IsVisible="{Binding HasLink}"
                                    ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisItem}">
                              <TextBlock Text="{Binding Product}" Classes="linktext"/>
                            </Button>
                            <TextBlock Text="{Binding Product}" IsVisible="{Binding !HasLink}"
                                       VerticalAlignment="Center"/>
                          </Panel>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn     Binding="{Binding Cycle}"    Width="70">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Cycle}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipHowLongOneRun}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn       Binding="{Binding Prints}"  Width="55">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="BPO" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipOriginalsOwnedCopiesAre}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn Binding="{Binding Busy}"     Width="75">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Installed}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipHowManyOfThose}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn   Binding="{Binding Capacity}"    Width="85">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Ceiling}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipUnitsADayThe}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn      Binding="{Binding Demand}"      Width="85">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Made}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipUnitsADayActually}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn Binding="{Binding Used}" Width="60" Foreground="{DynamicResource TextDimBrush}">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Used}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipShareOfEachOriginals}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Width="75" ClipboardContentBinding="{Binding Cover}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.AllBusy}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipShareOfTheLast}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PrintPressureRowVm">
                        <TextBlock Text="{Binding Cover}" Foreground="{Binding CoverColor}"
                                   VerticalAlignment="Top" Margin="0 3 0 0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Binding="{Binding Rank}" Width="70" Foreground="{DynamicResource TextDimBrush}">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Rank}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhereThisSitsAmong}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn Binding="{Binding Recent}" Width="55" Foreground="{DynamicResource TextDimBrush}">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.ColRecent30d}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipTheSameAllBusy}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Width="70" ClipboardContentBinding="{Binding Trend}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Trend}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhetherTheRecentSqueeze}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PrintPressureRowVm">
                        <TextBlock Text="{Binding Trend}" Foreground="{Binding TrendColor}"
                                   VerticalAlignment="Top" Margin="0 3 0 0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Binding="{Binding WithOneMore}" Width="85">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.N1Print}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhatTheCeilingBecomes}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn  Binding="{Binding Wanted}"  Width="65">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Queued}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipJobsForThisProduct}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn Binding="{Binding Blocked}" Width="95">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.BlockedNow}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipJobsHeldUpBy}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTextColumn Binding="{Binding Blocking}" Width="75">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Blocking}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipTasksWaitingOnWhat}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Width="80" ClipboardContentBinding="{Binding Verdict}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Verdict}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhatTheRowAmounts2}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PrintPressureRowVm">
                        <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictColor}"
                                   VerticalAlignment="Top" Margin="0 3 0 0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- Wraps, and the row grows to fit; see the Item Contention grid. -->
                  <DataGridTemplateColumn Width="*" MinWidth="260"
                                          CanUserSort="False" ClipboardContentBinding="{Binding Advice}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Suggestion}" Background="Transparent" ToolTip.Tip="{x:Static loc:WorklistText.TipWhatIsHappeningAnd2}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PrintPressureRowVm">
                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="0 3 4 3"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>


          <TabItem Header="{x:Static loc:WorklistText.TabHauling}" FontSize="12">
            <Grid RowDefinitions="Auto,*" Margin="0 8 0 0">
              <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="{x:Static loc:WorklistText.TripsLabel}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"/>
                <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:WorklistText.JobsStoppedForWantNote}"/>

                <!-- ⚠️ Above the grid, not in it. One row per stopped job is right for "what is
                     stuck" and cannot say "these four are one errand" — the same trip appears
                     four times with nothing marking them as the same delivery. -->
                <Border IsVisible="{Binding HasSharedTrips}" Margin="0 4 0 0" Padding="10 7"
                        Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="3" HorizontalAlignment="Left">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static loc:WorklistText.OneTripSeveralJobsLabel}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" LetterSpacing="1"/>
                    <ItemsControl ItemsSource="{Binding SharedTrips}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                     TextWrapping="Wrap" Margin="0 1"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <DataGrid LoadingRow="OnRowLoading" UnloadingRow="OnRowUnloading" Grid.Row="1" ItemsSource="{Binding HaulPressures}" IsReadOnly="True"
                        AutoGenerateColumns="False" FontSize="11"
                        Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">

                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="24" MinWidth="24"
                                          CanUserSort="False" CanUserResize="False" ClipboardContentBinding="{Binding Glyph}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:HaulPressureRowVm">
                        <Panel>
                          <Button Classes="expander" Click="OnHaulToggle"
                                  IsVisible="{Binding HasTasks}"
                                  Content="{Binding Glyph}" FontSize="20"
                                  Padding="0" Width="24" Height="24" MinWidth="0" MinHeight="0"
                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                                  Cursor="Hand"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  ToolTip.Tip="{x:Static loc:WorklistText.TipShowTheTasksBehindThese}"/>

                          <!-- ⚠️ A popup, NOT RowDetails, and the difference is the whole point. A drawer
                               inside a row makes rows wildly different heights, and the DataGrid prices
                               every row it has not realised from a single average of them; it also reuses
                               a row between an open one and a closed one and measures it before the
                               drawer has caught up. Both are why scrolling up used to stick and jump.
                               See tools/gridsim. Floating the detail leaves every row one height, so
                               there is nothing left to estimate wrongly.
                          
                               ⚠️ Light dismiss with a TwoWay binding, so clicking away puts the glyph
                               back. The flag still lives on the ITEM, not the row: the grid recycles
                               rows, and a popup keyed to the row would open against whatever item
                               landed in it next. -->
                          <Popup IsOpen="{Binding IsExpanded}" Closed="OnDetailClosed" DetachedFromVisualTree="OnDetailDetached"
                                 Placement="BottomEdgeAlignedLeft"
                                 IsLightDismissEnabled="True">
                            <!-- ⚠️ A ceiling, with the scrolling inside it. A blueprint list ran the
                                 full height of the screen and off the bottom of it. -->
                            <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                            <Border Margin="20 0 0 6" Padding="10 7" IsVisible="{Binding HasTasks}"
                                    Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="3" HorizontalAlignment="Left" MinWidth="900">
                              <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ShortageTaskRowVm">
                                    <Grid ColumnDefinitions="70,70,240,*" Margin="0 1">
                                      <TextBlock Grid.Column="0" Text="{Binding Role}" FontSize="10"
                                                 Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                      <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="10"
                                                 Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                                  Margin="{Binding Indent}" VerticalAlignment="Center">
                                        <!-- Fixed slot, drawn or not — the picture arrives after the grid
                                             has sized the row, so it must not change the size when it does. -->
                                        <Image Source="{Binding Icon}" Width="14" Height="14"
                                               IsVisible="{Binding HasIcon}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                      </StackPanel>
                                      <TextBlock Grid.Column="3" Text="{Binding Why}" FontSize="10" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Border>
                            </ScrollViewer>
                          </Popup>
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Width="250" ClipboardContentBinding="{Binding Task}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Job}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipTheStoppedJobIt}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:HaulPressureRowVm">
                        <Grid ColumnDefinitions="Auto,*">
                          <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18"
                                 Margin="0 0 6 0" VerticalAlignment="Center"/>
                          <Panel Grid.Column="1">
                            <Button Classes="link" Click="OnOpenHaulItem" IsVisible="{Binding HasItemLink}"
                                    ToolTip.Tip="{x:Static loc:WorklistText.TipOpenWhatThisJobMakes}">
                              <TextBlock Text="{Binding Task}" Classes="linktext"/>
                            </Button>
                            <TextBlock Text="{Binding Task}" IsVisible="{Binding !HasItemLink}"
                                       VerticalAlignment="Center"/>
                          </Panel>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Width="230" ClipboardContentBinding="{Binding Station}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.WaitingAt}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipWhereTheJobWould}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:HaulPressureRowVm">
                        <Panel>
                          <Button Classes="link" Click="OnOpenHaulStation" IsVisible="{Binding HasStationLink}"
                                  ToolTip.Tip="{x:Static loc:WorklistText.TipOpenThisStation}">
                            <TextBlock Text="{Binding Station}" Classes="linktext"/>
                          </Button>
                          <TextBlock Text="{Binding Station}" IsVisible="{Binding !HasStationLink}"
                                     VerticalAlignment="Center"/>
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTextColumn Binding="{Binding Blocking}" Width="80">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Blocking}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipJobsStoppedBehindThis}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>

                  <DataGridTextColumn Binding="{Binding Items}" Width="65">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Items}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipDistinctItemTypesThis}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>

                  <DataGridTextColumn Binding="{Binding Volume}" Width="90">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Volume}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipCubicMetresThisJob}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>

                  <DataGridTextColumn Binding="{Binding Sources}" Width="80">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Stops}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipStopsAHaulerWould}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>

                  <DataGridTextColumn Binding="{Binding Hauls}" Width="70">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Hauls}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipHaulsAlreadyOnThe}"/>
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>

                  <DataGridTemplateColumn Width="120" ClipboardContentBinding="{Binding Verdict}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Verdict}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipWhatTheRowAmounts2}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:HaulPressureRowVm">
                        <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictColor}"
                                   VerticalAlignment="Top" Margin="0 3 0 0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Width="*" MinWidth="260" CanUserSort="False" ClipboardContentBinding="{Binding Advice}">
                    <DataGridTemplateColumn.Header>
                      <TextBlock Text="{x:Static loc:WorklistText.Suggestion}" Background="Transparent"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipWhatIsHappeningAnd2}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:HaulPressureRowVm">
                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="0 3 4 3"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </TabItem>
    <!-- ════ Final Products ═════════════════════════════
         What all the work above is for. Every other tab is about what to do next; this one is
         the record of what that work produced — each job whose output is something the operation
         sells, with what it cost and what it was worth on the day it landed. -->
    <TabItem Header="{x:Static loc:WorklistText.TabFinalProducts}">
      <Grid Margin="10" RowDefinitions="Auto,*,8,260"
            DataContext="{Binding FinalProductsVm}" x:DataType="vm:WorklistFinalProductsViewModel">

        <!-- Filters -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
              Margin="0 0 0 8">
          <TextBlock Grid.Column="0" Text="{x:Static loc:WorklistText.Completed}" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0 0 8 0" />
          <TextBox Grid.Column="1" Text="{Binding From}" Watermark="{x:Static loc:WorklistText.HintFromYyyyMmDd}"
                   FontSize="11" MinWidth="120" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                   BorderBrush="{DynamicResource BorderDefaultBrush}" />
          <TextBox Grid.Column="2" Text="{Binding Thru}" Watermark="{x:Static loc:WorklistText.HintThruYyyyMmDd}"
                   FontSize="11" MinWidth="120" Margin="6 0 0 0" Background="{DynamicResource SurfaceRaisedBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />

          <!-- What the output is worth. A shop selling at a fixed margin over cost never sees the
               market price, so valuing its work by one describes somebody else's business. -->
          <TextBlock Grid.Column="3" Text="{x:Static loc:WorklistText.ValueAt}" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="16 0 8 0" />
          <ComboBox Grid.Column="4" ItemsSource="{Binding Valuations}"
                    SelectedItem="{Binding Valuation}"
                    FontSize="11" MinWidth="120" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" />

          <!-- ⚠️ Wide enough for the DIGITS: a NumericUpDown spends most of its width on the two
               spinner buttons. Hidden rather than disabled when the market is being quoted — a
               greyed box invites a click that does nothing. -->
          <NumericUpDown Grid.Column="5" Value="{Binding OverBuildPercent}"
                         IsVisible="{Binding IsOverBuild}"
                         Minimum="0" Maximum="1000" Increment="1" FormatString="0"
                         Width="120" FontSize="11" Margin="6 0 0 0"
                         Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />

          <TextBlock Grid.Column="6" Text="{x:Static loc:WorklistText.ChartBy}" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="16 0 8 0" />
          <ComboBox Grid.Column="7" ItemsSource="{Binding Grains}" SelectedItem="{Binding Grain}"
                    FontSize="11" MinWidth="100" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" />

          <Button Grid.Column="8" Command="{Binding RefreshCommand}" Content="{x:Static loc:WorklistText.Refresh}"
                  FontSize="11" Padding="12 4" Margin="16 0 0 0"
                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />

          <TextBlock Grid.Column="9" Text="{Binding StatusText}" FontSize="11"
                     Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                     HorizontalAlignment="Right" Margin="16 0 0 0" />
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                  Background="Transparent" HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColItem}"   Binding="{Binding Item}"   Width="*" />
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColWhy}"    Binding="{Binding Source}" Width="120" />
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColStatus}" Binding="{Binding Status}" Width="90" />
            <!-- Sorted on the number: 9 does not outrank 50. -->
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColUnits}"  Binding="{Binding UnitsText}"
                                SortMemberPath="Units" Width="90" CellStyleClasses="num" />
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColStarted}" Binding="{Binding StartedText}" Width="100" />
            <!-- ⚠️ Sorted on the tick count, not the text: the column shows a date, and two jobs
                 finishing on one day are not interchangeable. -->
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColCompleted}" Binding="{Binding CompletedText}"
                                SortMemberPath="CompletedSort" Width="110" />
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColBuildCost}" Binding="{Binding BuildText}"
                                SortMemberPath="BuildCost" Width="120" CellStyleClasses="num" />
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColMarketValue}" Binding="{Binding MarketText}"
                                SortMemberPath="MarketValue" Width="120" CellStyleClasses="num" />
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColPotentialProfit}" Width="130"
                                    SortMemberPath="PotentialProfit" CellStyleClasses="num" ClipboardContentBinding="{Binding ProfitText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FinalProductJobVm">
                  <TextBlock Text="{Binding ProfitText}" Foreground="{Binding ProfitColor}"
                             VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColPotential}" Binding="{Binding ProfitPct}"
                                SortMemberPath="ProfitPctRaw" Width="90" CellStyleClasses="num" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- The grid's own figures, summed into the chosen bucket. Side by side because the
             question is whether profit follows value or diverges from it. -->
        <Grid Grid.Row="3" ColumnDefinitions="*,10,*">
          <Border Grid.Column="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="10 8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:WorklistText.MarketValue}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" Margin="0 0 0 6" />
              <lvc:CartesianChart Series="{Binding MarketSeries}"
                                  XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                  TooltipPosition="Top" EasingFunction="{x:Null}"
                                  Background="Transparent" />
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="10 8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:WorklistText.PotentialProfit}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" Margin="0 0 0 6" />
              <lvc:CartesianChart Series="{Binding ProfitSeries}"
                                  XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                  TooltipPosition="Top" EasingFunction="{x:Null}"
                                  Background="Transparent" />
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <!-- ════ Config ═════════════════════════════════════════════════════════════
         Everything that sets the tool up, behind one tab so the two tabs that are
         read every session are not buried among seven that are set once. -->
    <TabItem Header="{x:Static loc:WorklistText.TabConfig}">
    <TabControl Padding="0" Background="Transparent">

    <!-- First, because what the tool raises at all is the question you answer before any of the
         detail below matters. -->
    <TabItem Header="{x:Static loc:WorklistText.TabSources}">
      <ScrollViewer>
        <StackPanel Margin="14 12" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static loc:WorklistText.Sources}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                       Text="{x:Static loc:WorklistText.ASourceThatIsNote}"/>
            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorklistToggleVm">
                  <StackPanel Margin="0 6 0 0">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" FontSize="11"/>
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                               Margin="24 0 0 0" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static loc:WorklistText.StandingBuyOrdersWhatTo}" FontSize="12"
                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                       Text="{x:Static loc:WorklistText.WhichConditionsBecomeTasksNote}"/>
            <ItemsControl ItemsSource="{Binding Conditions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorklistToggleVm">
                  <StackPanel Margin="0 6 0 0">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" FontSize="11"/>
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                               Margin="24 0 0 0" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{x:Static loc:WorklistText.TabMarket}">
      <!-- x:DataType scoped to the market alts VM so the bindings below compile against it rather
           than silently falling back to reflection against the parent. The buy location is the
           exception: it belongs to the industry settings, so it reaches up to that view model
           explicitly. It sits here because it is a market decision — where purchases are raised,
           and therefore which of the alts below ends up doing them. -->
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding MarketAltsVm}" x:DataType="vm:WorklistMarketAltsViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="{x:Static loc:WorklistText.WhereShortfallsAreBoughtNote}"/>

        <StackPanel Grid.Row="1" Spacing="4" HorizontalAlignment="Left" Margin="0 0 0 4"
                    x:CompileBindings="False">
          <TextBlock Text="{x:Static loc:WorklistText.BuyShortfallsAt}" Classes="fieldLabel"/>
          <!-- The list and the box name each station as the screen does (ValueMemberBinding); a
               pick saves the result's English, and nothing reads the box's text back. So do the
               other station boxes on these tabs. -->
          <AutoCompleteBox Width="260"
                           Text="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).IndustryVm.BuyLocationText}"
                           SelectedItem="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).IndustryVm.SelectedBuyLocation}"
                           ValueMemberBinding="{Binding DisplayName}"
                           AsyncPopulator="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).IndustryVm.LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="{x:Static loc:WorklistText.HintTradeHub}"
                           ToolTip.Tip="{x:Static loc:WorklistText.TipWherePurchasesAreRaised}"/>
          <TextBlock Text="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).IndustryVm.BuyWarning}"
                     IsVisible="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).IndustryVm.HasBuyWarning}"
                     FontSize="10" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" MaxWidth="560"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,180,180,Auto" RowDefinitions="Auto,Auto" Margin="0 0 0 6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:WorklistText.StationOrStructure}" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:WorklistText.Character}"           Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static loc:WorklistText.Note}"                Classes="fieldLabel"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" x:CompileBindings="False"
                           Text="{Binding LocationText}"
                           SelectedItem="{Binding SelectedLocation}"
                           ValueMemberBinding="{Binding DisplayName}"
                           AsyncPopulator="{Binding LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="{x:Static loc:WorklistText.HintStationOrStructure}"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Characters}"
                    SelectedItem="{Binding SelectedCharacter}"
                    PlaceholderText="{x:Static loc:WorklistText.HintCharacter2}" HorizontalAlignment="Stretch"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding Note}" Watermark="{x:Static loc:WorklistText.HintOptional}"/>
          <Button Grid.Row="1" Grid.Column="3" Content="{x:Static loc:WorklistText.Add}" Command="{Binding AddCommand}"
                  FontSize="11" Padding="10 4"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="5" ItemsSource="{Binding MarketAlts}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColLocation}" Binding="{Binding LocationName}" FontSize="10" Width="*"
                                IsReadOnly="True"/>

            <!-- Character and note edit in place and save on change. The station does not: it is
                 the row's identity, and repointing it is what the form above is for. -->
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColCharacter}" Width="200" SortMemberPath="CharacterName" IsReadOnly="True" ClipboardContentBinding="{Binding CharacterName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketAltRow">
                  <ComboBox ItemsSource="{Binding CharacterOptions}"
                            SelectedItem="{Binding Character, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColNote}" Width="220" SortMemberPath="Note" IsReadOnly="True" ClipboardContentBinding="{Binding Note}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketAltRow">
                  <TextBox Text="{Binding Note, Mode=TwoWay}" Watermark="{x:Static loc:WorklistText.HintOptional}"
                           FontSize="10" Background="Transparent" BorderThickness="0"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketAltRow">
                  <Button Content="{x:Static loc:WorklistText.Remove}"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).MarketAltsVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <TabItem Header="{x:Static loc:WorklistText.TabInventoryRules}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding RulesVm}" x:DataType="vm:WorklistInvRulesViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="{x:Static loc:WorklistText.WhenAGroupDropsNote}"/>

        <!-- Labels above the fields rather than watermarks: both percentages default to 100,
             and a watermark only shows while a field is empty, so they were two bare numbers. -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*,90,120,120,Auto"
              RowDefinitions="Auto,Auto" Margin="0 0 0 6">

          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:WorklistText.InventoryGroup}" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:WorklistText.StationOrStructure}" Classes="fieldLabel"
                     IsVisible="{Binding NeedsLocation}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:WorklistText.Site}" Classes="fieldLabel"
                     IsVisible="{Binding !NeedsLocation}"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static loc:WorklistText.Action}" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static loc:WorklistText.TriggerBelow}" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="4" Text="{x:Static loc:WorklistText.FillUpTo}"  Classes="fieldLabel"/>

          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                    PlaceholderText="{x:Static loc:WorklistText.HintPickAGroup}" HorizontalAlignment="Stretch"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0" Classes="selectall" x:CompileBindings="False"
                           Text="{Binding LocationText}"
                           SelectedItem="{Binding SelectedLocation}"
                           ValueMemberBinding="{Binding DisplayName}"
                           AsyncPopulator="{Binding LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="{x:Static loc:WorklistText.HintTypeTwoCharacters}"
                           IsVisible="{Binding NeedsLocation}"/>
          <!-- A Build rule runs wherever the park assigns the job, so there is nothing to pick. -->
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0 0 8 0" FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     IsVisible="{Binding !NeedsLocation}"
                     Text="{x:Static loc:WorklistText.DecidedByTheIndyNote}"/>
          <ComboBox Grid.Row="1" Grid.Column="2" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="{x:Static loc:WorklistText.TipBuyPlacesAMarket}"/>
          <TextBox Grid.Row="1" Grid.Column="3" Margin="0 0 8 0" FontSize="11" Text="{Binding Threshold}"
                   ToolTip.Tip="{x:Static loc:WorklistText.TipRaiseATaskWhen}"/>
          <TextBox Grid.Row="1" Grid.Column="4" Margin="0 0 8 0" FontSize="11" Text="{Binding Fill}"
                   ToolTip.Tip="{x:Static loc:WorklistText.TipFillBackUpTo}"/>
          <Button Grid.Row="1" Grid.Column="5" Content="{x:Static loc:WorklistText.AddRule}" Command="{Binding AddCommand}"
                  FontSize="11" Padding="10 4"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <!-- Amber, like the park and buy warnings on the Other tab: the rule is saved and valid,
             it just cannot produce work anybody can do. -->
        <TextBlock Grid.Row="3" Text="{Binding AltWarning}" IsVisible="{Binding HasAltWarning}"
                   FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Rules}"
                  IsReadOnly="False" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <!-- Editable in place. Each cell is a live control rather than a click-to-edit one, so a
               rule can be corrected where it is read, and every change saves immediately. -->
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColGroup}" Width="200" SortMemberPath="GroupName" IsReadOnly="True" ClipboardContentBinding="{Binding GroupName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <ComboBox ItemsSource="{Binding GroupOptions}"
                            SelectedItem="{Binding Group, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColAction}" Width="80" SortMemberPath="Action" IsReadOnly="True" ClipboardContentBinding="{Binding Action}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <ComboBox ItemsSource="{Binding ActionOptions}"
                            SelectedItem="{Binding Action, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipBuyPlacesAMarket}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColTriggerBelow}" Width="110" SortMemberPath="Threshold" IsReadOnly="True" ClipboardContentBinding="{Binding Threshold, Converter={StaticResource PctConv}}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <NumericUpDown Value="{Binding Threshold, Mode=TwoWay, Converter={StaticResource PctConv}}"
                                 Minimum="0.1" Maximum="10000" Increment="5" FormatString="0.#"
                                 ShowButtonSpinner="False" FontSize="10"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipRaiseATaskWhen}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColFillTo}" Width="100" SortMemberPath="Fill" IsReadOnly="True" ClipboardContentBinding="{Binding Fill, Converter={StaticResource PctConv}}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <NumericUpDown Value="{Binding Fill, Mode=TwoWay, Converter={StaticResource PctConv}}"
                                 Minimum="0.1" Maximum="10000" Increment="5" FormatString="0.#"
                                 ShowButtonSpinner="False" FontSize="10"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 ToolTip.Tip="{x:Static loc:WorklistText.TipFillBackUpTo}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- FINAL — what the operation sells or flies, as opposed to a group held so the
                 next thing can be built. Work that unblocks a final product outranks work that
                 only refills a buffer, and nothing in the data can tell them apart: the answer
                 is per operation, hulls here and rigs or modules elsewhere. -->
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColFinal}" Width="60" SortMemberPath="IsFinal"
                                    IsReadOnly="False" ClipboardContentBinding="{Binding IsFinal}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <CheckBox IsChecked="{Binding IsFinal, Mode=TwoWay}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipThisGroupIsSold}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- The station is picked, never typed: the id is what the tool matches on, so a
                 free-typed name would leave the rule pointing at the station it used to mean.
                 Unlike the other cells this one is click-to-edit rather than a live control.
                 An AutoCompleteBox whose Text is bound to a value that changes underneath it
                 reads the change as typing, runs its populator and opens its dropdown — which
                 is what covered whole rows in floating boxes, Build rows included. Existing only
                 while the cell is actually being edited removes the problem at the source.
                 Shown, sorted and copied as the screen names the station (LocationShown); the rule
                 saves LocationName, the English. -->
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColLocation}" Width="*" SortMemberPath="LocationShown" IsReadOnly="False" ClipboardContentBinding="{Binding LocationShown}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <Panel>
                    <TextBlock IsVisible="{Binding NeedsLocation}" Text="{Binding LocationShown}"
                               FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               ToolTip.Tip="{x:Static loc:WorklistText.TipDoubleClickToChangeThe}"/>
                    <TextBlock IsVisible="{Binding !NeedsLocation}" Text="{Binding LocationDisplay}"
                               FontSize="10" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <Panel>
                    <!-- No Text binding at all, so nothing can be mistaken for typing. -->
                    <AutoCompleteBox x:CompileBindings="False" IsVisible="{Binding NeedsLocation}"
                                     SelectedItem="{Binding PickedLocation, Mode=TwoWay}"
                                     ValueMemberBinding="{Binding DisplayName}"
                                     AsyncPopulator="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).RulesVm.LocationPopulator}"
                                     FilterMode="None" MinimumPrefixLength="2"
                                     MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                                     FontSize="10" Watermark="{x:Static loc:WorklistText.HintTypeTwoCharacters}"
                                     VerticalAlignment="Center"/>
                    <TextBlock IsVisible="{Binding !NeedsLocation}" Text="{Binding LocationDisplay}"
                               FontSize="10" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static loc:WorklistText.ColCharacter}" Binding="{Binding AltText}" FontSize="10" Width="160"
                                IsReadOnly="True"/>
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <Button Content="{x:Static loc:WorklistText.Remove}"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).RulesVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <TabItem Header="{x:Static loc:WorklistText.TabStationLevels}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding StationLevelsVm}" x:DataType="vm:WorklistStationLevelsViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="{x:Static loc:WorklistText.WhereEachGroupsStockNote}"/>

        <Grid Grid.Row="1" ColumnDefinitions="240,*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0 0 0 6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:WorklistText.InventoryGroup}"     Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:WorklistText.StationOrStructure}" Classes="fieldLabel"/>
          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                    PlaceholderText="{x:Static loc:WorklistText.HintGroup}" HorizontalAlignment="Stretch"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0" Classes="selectall" x:CompileBindings="False"
                           Text="{Binding LocationText}"
                           SelectedItem="{Binding SelectedLocation}"
                           ValueMemberBinding="{Binding DisplayName}"
                           AsyncPopulator="{Binding LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="{x:Static loc:WorklistText.HintNeedNotBeInThe}"/>
          <CheckBox Grid.Row="1" Grid.Column="2" Content="{x:Static loc:WorklistText.AcceptsSurplus}" FontSize="11"
                    Margin="0 0 8 0" IsChecked="{Binding AcceptsSurplus}"
                    ToolTip.Tip="{x:Static loc:WorklistText.TipSpareStockOfThis}"/>
          <Button Grid.Row="1" Grid.Column="3" Content="{x:Static loc:WorklistText.Add}" Command="{Binding AddCommand}"
                  FontSize="11" Padding="10 4"/>
        </Grid>

        <!-- How far a station may drift before anything moves. Without a band, a level held to
             the unit raises a haul for every handful consumed. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,20,Auto,Auto,*" Margin="0 0 0 8">
          <TextBlock Grid.Column="0" Text="{x:Static loc:WorklistText.RestockWhenBelowLevelBy}" Classes="fieldLabel"
                     VerticalAlignment="Center" Margin="0 0 6 0"/>
          <NumericUpDown Grid.Column="1" Value="{Binding RestockBand, Mode=TwoWay}"
                         Minimum="0" Maximum="100" Increment="5" FormatString="0.#"
                         ShowButtonSpinner="False" Width="70" FontSize="11"
                         ToolTip.Tip="{x:Static loc:WorklistText.TipAStationIsLeft}"/>
          <TextBlock Grid.Column="3" Text="{x:Static loc:WorklistText.SweepSurplusWhenAboveLevel}" Classes="fieldLabel"
                     VerticalAlignment="Center" Margin="0 0 6 0"/>
          <NumericUpDown Grid.Column="4" Value="{Binding SurplusBand, Mode=TwoWay}"
                         Minimum="0" Maximum="100" Increment="5" FormatString="0.#"
                         ShowButtonSpinner="False" Width="70" FontSize="11"
                         ToolTip.Tip="{x:Static loc:WorklistText.TipExcessIsLeftWhere}"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Levels}"
                  IsReadOnly="False" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <!-- Editable in place, saving on change, as on the Inventory Rules tab. -->
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColInventoryGroup}" Width="240" SortMemberPath="GroupName" IsReadOnly="True" ClipboardContentBinding="{Binding GroupName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <ComboBox ItemsSource="{Binding GroupOptions}"
                            SelectedItem="{Binding Group, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Click-to-edit, as on the Inventory Rules tab and for the same reason. Shown, sorted
                 and copied as the screen names the station; the level saves the English. -->
            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColStation}" Width="*" SortMemberPath="LocationShown" IsReadOnly="False" ClipboardContentBinding="{Binding LocationShown}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <TextBlock Text="{Binding LocationShown}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center"
                             ToolTip.Tip="{x:Static loc:WorklistText.TipDoubleClickToChangeThe}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <AutoCompleteBox x:CompileBindings="False"
                                   SelectedItem="{Binding PickedLocation, Mode=TwoWay}"
                                   ValueMemberBinding="{Binding DisplayName}"
                                   AsyncPopulator="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).StationLevelsVm.LocationPopulator}"
                                   FilterMode="None" MinimumPrefixLength="2"
                                   MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                                   FontSize="10" Watermark="{x:Static loc:WorklistText.HintTypeTwoCharacters}"
                                   VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColAcceptsSurplus}" Width="120" SortMemberPath="AcceptsSurplus" IsReadOnly="True" ClipboardContentBinding="{Binding AcceptsSurplus}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <CheckBox IsChecked="{Binding AcceptsSurplus, Mode=TwoWay}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static loc:WorklistText.TipSpareStockOfThis}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <Button Content="{x:Static loc:WorklistText.Remove}"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).StationLevelsVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <!-- Last: the settings here are set once and then left, unlike the tabs above them. Which
         characters may be given jobs lives on Settings → Characters. -->
    <TabItem Header="{x:Static loc:WorklistText.TabOther}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="14 12" Spacing="18"
            DataContext="{Binding IndustryVm}" x:DataType="vm:WorklistIndustryViewModel">

        <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                   Text="{x:Static loc:WorklistText.WhereIndustryWorkIsNote}"/>

        <!-- ── Industry ──────────────────────────────────────────────────── -->
        <TextBlock Text="{x:Static loc:WorklistText.Industry}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>

        <Grid ColumnDefinitions="240,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{x:Static loc:WorklistText.PlanAgainstPark}" Classes="fieldLabel"/>
            <TextBlock Text="{Binding ParkResolvedText}" Classes="fieldLabel" Foreground="{DynamicResource TextMutedBrush}"/>
          </StackPanel>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:WorklistText.MaxJobLengthManufacturing}" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static loc:WorklistText.Reactions}" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static loc:WorklistText.Science}" Classes="fieldLabel"/>

          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 16 0" FontSize="11"
                    ItemsSource="{Binding Parks}" SelectedItem="{Binding SelectedPark}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="{x:Static loc:WorklistText.TipDefaultFollowsWhicheverPark}"/>
          <TextBox Grid.Row="1" Grid.Column="1" Width="70" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding MaxJobDaysMfg}"
                   ToolTip.Tip="{x:Static loc:WorklistText.TipDaysAShortfallNeeding}"/>
          <TextBox Grid.Row="1" Grid.Column="2" Width="70" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding MaxJobDaysRxn}"
                   ToolTip.Tip="{x:Static loc:WorklistText.TipDaysReactionsAreSet}"/>
          <TextBox Grid.Row="1" Grid.Column="3" Width="70" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding MaxJobDaysSci}"
                   ToolTip.Tip="{x:Static loc:WorklistText.TipDaysCoveringCopyingAnd}"/>
          <TextBlock Grid.Row="1" Grid.Column="4" Text="{x:Static loc:WorklistText.Days}" Classes="fieldLabel"
                     VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="{Binding ParkWarning}" IsVisible="{Binding HasParkWarning}"
                   FontSize="10" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>

        <!-- ── Asset Scope ───────────────────────────────────────────────── -->
        <TextBlock Text="{x:Static loc:WorklistText.AssetScope}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>

        <Grid ColumnDefinitions="130,240,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:WorklistText.CountMaterial}" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:WorklistText.RegionSystem}" Classes="fieldLabel"/>

          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="{x:Static loc:WorklistText.TipHowFarToLook}"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Margin="0 0 16 0"
                           IsEnabled="{Binding NeedsScopePlace}"
                           Text="{Binding ScopePlaceText}"
                           SelectedItem="{Binding SelectedScopePlace}"
                           AsyncPopulator="{Binding ScopePlacePopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="{x:Static loc:WorklistText.HintTypeTwoCharacters}"/>
          <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                    Content="{x:Static loc:WorklistText.IncludeNonPersonalCorpAssets}" FontSize="11"
                    IsChecked="{Binding IncludeNonPersonalCorps}"
                    ToolTip.Tip="{x:Static loc:WorklistText.TipOffByDefaultOnly}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 10 0 0"
                     Text="{x:Static loc:WorklistText.AlsoCountTheseStations}" Classes="fieldLabel"/>
          <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
            <AutoCompleteBox Width="290" x:CompileBindings="False"
                             Text="{Binding ExtraStationText}"
                             SelectedItem="{Binding SelectedExtraStation}"
                             ValueMemberBinding="{Binding DisplayName}"
                             AsyncPopulator="{Binding LocationPopulator}"
                             FilterMode="None" MinimumPrefixLength="2"
                             MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                             FontSize="11" Watermark="{x:Static loc:WorklistText.HintJitaAmarr}"
                             ToolTip.Tip="{x:Static loc:WorklistText.TipTradeHubsYouImport}"/>
            <Button Content="{x:Static loc:WorklistText.Add}" Command="{Binding AddScopeStationCommand}" FontSize="11" Padding="10 4"/>
          </StackPanel>
          <ItemsControl Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" ItemsSource="{Binding ScopeStations}"
                        Margin="8 0 0 0" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScopeStationRow">
                <Button Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).IndustryVm.DeleteScopeStationCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding LocationName}" ToolTip.Tip="{x:Static loc:WorklistText.TipClickToRemoveFromThe}"
                        FontSize="9" Padding="6 2" Margin="0 0 4 4" Cursor="Hand"
                        Background="Transparent" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"/>

        <!-- ── Corp Projects ─────────────────────────────────────────────── -->
        <!-- Its own view model, reached explicitly because the panel around it is bound to the
             industry settings. -->
        <TextBlock Text="{x:Static loc:WorklistText.CorpProjects}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>

        <StackPanel Spacing="6" x:CompileBindings="False"
                    DataContext="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).CorpAltsVm}">
          <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                     Text="{x:Static loc:WorklistText.StandingProjectsAreDefinedNote}"/>

          <Grid ColumnDefinitions="*,200,200,Auto" RowDefinitions="Auto,Auto" Margin="0 0 0 6">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:WorklistText.Corporation}" Classes="fieldLabel"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:WorklistText.MaintainedBy}" Classes="fieldLabel"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static loc:WorklistText.Note}" Classes="fieldLabel"/>
            <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                      ItemsSource="{Binding Corps}" SelectedItem="{Binding SelectedCorp}"
                      PlaceholderText="{x:Static loc:WorklistText.HintPickACorporation}" HorizontalAlignment="Stretch"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0" FontSize="11"
                      ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                      PlaceholderText="{x:Static loc:WorklistText.HintCharacter2}" HorizontalAlignment="Stretch"/>
            <TextBox Grid.Row="1" Grid.Column="2" Margin="0 0 8 0" FontSize="11"
                     Text="{Binding Note}" Watermark="{x:Static loc:WorklistText.HintOptional}"/>
            <Button Grid.Row="1" Grid.Column="3" Content="{x:Static loc:WorklistText.Add}" Command="{Binding AddCommand}"
                    FontSize="11" Padding="10 4"/>
          </Grid>

          <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" Margin="0 0 0 8"/>

          <DataGrid ItemsSource="{Binding Alts}" MinHeight="140" MaxHeight="320"
                    IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                    Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static loc:WorklistText.ColCorporation}" Binding="{Binding CorporationName}" FontSize="10" Width="*"
                                  IsReadOnly="True"/>

              <!-- Character and note edit in place and save on change, as on Market. -->
              <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColCharacter}" Width="200" SortMemberPath="CharacterName" IsReadOnly="True" ClipboardContentBinding="{Binding CharacterName}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CorpAltRow">
                    <ComboBox ItemsSource="{Binding CharacterOptions}"
                              SelectedItem="{Binding Character, Mode=TwoWay}"
                              FontSize="10" Background="Transparent" BorderThickness="0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="{x:Static loc:WorklistText.ColNote}" Width="220" SortMemberPath="Note" IsReadOnly="True" ClipboardContentBinding="{Binding Note}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CorpAltRow">
                    <TextBox Text="{Binding Note, Mode=TwoWay}" Watermark="{x:Static loc:WorklistText.HintOptional}"
                             FontSize="10" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CorpAltRow">
                    <Button Content="{x:Static loc:WorklistText.Remove}"
                            Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).CorpAltsVm.DeleteCommand}"
                            CommandParameter="{Binding}"
                            FontSize="9" Padding="6 2" Background="Transparent"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Cursor="Hand"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>

      </StackPanel>
      </ScrollViewer>
    </TabItem>

    </TabControl>
    </TabItem>

  </TabControl>
</UserControl>
