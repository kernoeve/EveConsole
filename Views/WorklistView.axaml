<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:models="clr-namespace:EveConsole.Models"
             xmlns:wl="clr-namespace:EveConsole.Services.Worklist"
             xmlns:conv="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.WorklistView"
             x:DataType="vm:WorklistViewModel">

  <UserControl.Resources>
    <conv:NullableDecimalToPositiveDoubleConverter x:Key="PctConv" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="10" /></Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="Foreground" Value="#7a8896" />
      <Setter Property="Margin"     Value="0 0 8 3" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" />
      <Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
  </UserControl.Styles>

  <TabControl Padding="0" Background="Transparent" SelectedIndex="{Binding OuterTabIndex}">
    <TabItem Header="Worklist">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14 12">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0 0 0 8">
      <TextBlock Text="Worklist" FontSize="15" FontWeight="SemiBold" Foreground="#c8a84b"
                 VerticalAlignment="Center"/>
      <Button Content="Refresh" Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsLoading}" FontSize="11" Padding="10 4"/>
      <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#7a8896"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding Errors}" IsVisible="{Binding HasErrors}"
               FontSize="10" Foreground="#c85a5a" TextWrapping="Wrap" Margin="0 0 0 8"/>

    <StackPanel Grid.Row="2" Spacing="6" Margin="0 0 0 8">

      <!-- Summary. Six equal sections, height fixed to the tallest of the five stat lists —
           Haul, at five lines — so the panel never grows. The character list is the one that
           would, so it scrolls inside that height instead. All of it is computed from the
           filtered rows, so it describes what is on screen rather than the whole run. -->
      <Grid ColumnDefinitions="*,*,*,*,*,*" Height="104">
        <Grid.Styles>
          <Style Selector="Border.stat">
            <Setter Property="Background"      Value="#12121a"/>
            <Setter Property="BorderBrush"     Value="#252530"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="2"/>
            <Setter Property="Padding"         Value="8 6"/>
            <Setter Property="Margin"          Value="0 0 4 0"/>
          </Style>
          <Style Selector="TextBlock.statHead">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#c8a84b"/>
            <Setter Property="Margin"     Value="0 0 0 3"/>
          </Style>
          <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#666677"/>
          </Style>
          <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#c8c8d8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
          </Style>
        </Grid.Styles>

        <Border Grid.Column="0" Classes="stat">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="statHead" Text="Buy"/>
            <ItemsControl ItemsSource="{Binding BuySummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryStatVm">
                  <Grid ColumnDefinitions="*,Auto" Margin="0 1">
                    <TextBlock Grid.Column="0" Classes="statLabel" Text="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Classes="stat">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="statHead" Text="Haul"/>
            <ItemsControl ItemsSource="{Binding HaulSummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryStatVm">
                  <Grid ColumnDefinitions="*,Auto" Margin="0 1">
                    <TextBlock Grid.Column="0" Classes="statLabel" Text="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Classes="stat">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="statHead" Text="Manufacturing"/>
            <ItemsControl ItemsSource="{Binding MfgSummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryStatVm">
                  <Grid ColumnDefinitions="*,Auto" Margin="0 1">
                    <TextBlock Grid.Column="0" Classes="statLabel" Text="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <Border Grid.Column="3" Classes="stat">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="statHead" Text="Reactions"/>
            <ItemsControl ItemsSource="{Binding RxnSummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryStatVm">
                  <Grid ColumnDefinitions="*,Auto" Margin="0 1">
                    <TextBlock Grid.Column="0" Classes="statLabel" Text="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <Border Grid.Column="4" Classes="stat">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="statHead" Text="Science"/>
            <ItemsControl ItemsSource="{Binding SciSummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryStatVm">
                  <Grid ColumnDefinitions="*,Auto" Margin="0 1">
                    <TextBlock Grid.Column="0" Classes="statLabel" Text="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- The long one. Scrolls rather than setting the panel's height. -->
        <Border Grid.Column="5" Classes="stat" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="statHead" Text="By character"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <!-- Right padding clears the scrollbar, which Avalonia floats over the content
                   rather than reserving space for — without it the counts sit underneath it. -->
              <ItemsControl ItemsSource="{Binding CharSummary}" Padding="0 0 12 0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SummaryStatVm">
                    <Grid ColumnDefinitions="*,Auto" Margin="0 1">
                      <TextBlock Grid.Column="0" Classes="statLabel" Text="{Binding Label}"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                      <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding Value}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <TextBlock FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                 Text="Items are rebuilt from live data each refresh — one disappears once the work is done. Detection runs off polled ESI data, so each row shows how old the data behind it is. The summary above follows the filters."/>

      <!-- Sat with the filters rather than up beside Refresh, because that is what they are: two
           more controls over which rows appear. The counts are of what each governs across the
           whole run, so they say how much is behind the toggle whether it is on or off. -->
      <StackPanel Orientation="Horizontal" Spacing="14">
        <CheckBox Content="{Binding NotReadyLabel}" IsChecked="{Binding ShowNotReady}"
                  ToolTip.Tip="Include work that cannot be started yet, with the reason."
                  FontSize="11" VerticalAlignment="Center"/>
        <CheckBox Content="{Binding SnoozedLabel}" IsChecked="{Binding ShowSnoozed}"
                  ToolTip.Tip="Include items hidden by the snooze button until their snooze expires."
                  FontSize="11" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Column widths match the grid's so each control sits under what it filters. Volume and
           Age have none: one is a computed size and the other a timestamp, and neither is a
           thing you look for by name. -->
      <Grid ColumnDefinitions="68,72,90,230,130,190,190,*,Auto">
        <ComboBox Grid.Column="1" ItemsSource="{Binding StateOptions}"
                  SelectedItem="{Binding StateFilter}" FontSize="10"
                  HorizontalAlignment="Stretch" Margin="0 0 2 0"/>
        <ComboBox Grid.Column="2" ItemsSource="{Binding TaskOptions}"
                  SelectedItem="{Binding TaskFilter}" FontSize="10"
                  HorizontalAlignment="Stretch" Margin="0 0 2 0"/>
        <TextBox  Grid.Column="3" Text="{Binding DescriptionFilter}" FontSize="10"
                  Watermark="contains…" Margin="0 0 2 0"/>
        <ComboBox Grid.Column="4" ItemsSource="{Binding CharacterOptions}"
                  SelectedItem="{Binding CharacterFilter}" FontSize="10"
                  HorizontalAlignment="Stretch" Margin="0 0 2 0"/>
        <ComboBox Grid.Column="5" ItemsSource="{Binding SourceOptions}"
                  SelectedItem="{Binding SourceFilter}" FontSize="10"
                  HorizontalAlignment="Stretch" Margin="0 0 2 0"/>
        <ComboBox Grid.Column="6" ItemsSource="{Binding DestOptions}"
                  SelectedItem="{Binding DestFilter}" FontSize="10"
                  HorizontalAlignment="Stretch" Margin="0 0 2 0"/>
        <TextBox  Grid.Column="7" Text="{Binding NoteFilter}" FontSize="10"
                  Watermark="contains…" Margin="100 0 2 0"
                  ToolTip.Tip="Searches the detail, the blocked reason and the snooze line together — everything the Note column shows."/>
        <Button   Grid.Column="8" Content="Clear" Command="{Binding ClearFiltersCommand}"
                  IsVisible="{Binding HasFilters}"
                  FontSize="10" Padding="8 3" Background="Transparent"
                  BorderBrush="#252530" BorderThickness="1" Cursor="Hand"/>
      </Grid>
    </StackPanel>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}"
              IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
              Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent"
              AreRowDetailsFrozen="False" RowDetailsVisibilityMode="Collapsed">

      <DataGrid.Styles>
        <!-- The expander is a glyph, not a button: the default chrome draws a filled box on hover
             and press, which reads as a selected cell sitting in the corner of the row. -->
        <Style Selector="Button.expander /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.expander:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="TextElement.Foreground" Value="#c8a84b"/>
        </Style>
      </DataGrid.Styles>

      <!-- The manifest for tasks that carry several items. Shown only while the row's own +/- is
           pressed; single-item tasks have no manifest and never expand. -->
      <DataGrid.RowDetailsTemplate>
        <DataTemplate x:DataType="vm:WorklistRowVm">
          <Border Margin="34 2 0 6" Padding="8 6"
                  Background="#12121a" BorderBrush="#252530" BorderThickness="1"
                  CornerRadius="2" HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="wl:WorklistLine">
                  <Grid ColumnDefinitions="300,110" Margin="0 1">
                    <TextBlock Grid.Column="0" Text="{Binding TypeName}" FontSize="10" Foreground="#c8c8d8"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N0}}"
                               FontSize="10" Foreground="#7a8896" HorizontalAlignment="Right"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </DataTemplate>
      </DataGrid.RowDetailsTemplate>

      <DataGrid.Columns>

        <!-- Expander. Only drawn where there is a manifest, so an empty cell reads as "this task
             is the one item named in the description" rather than as a control that does nothing. -->
        <DataGridTemplateColumn Header="" Width="24" CanUserSort="False" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <Button Classes="expander" Click="OnManifestToggle"
                      IsVisible="{Binding HasLines}"
                      Content="{Binding ExpandGlyph}" FontSize="11" FontWeight="Bold"
                      Padding="0" Width="16" Height="16" MinWidth="0" MinHeight="0"
                      Background="Transparent" BorderThickness="0" Foreground="#7a8896" Cursor="Hand"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="Show the items on this task"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Sort here to get back to the tool's own ranking after sorting on anything else. -->
        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" FontSize="10" Width="44"
                            IsReadOnly="True"/>

        <DataGridTemplateColumn Header="State" Width="72" SortMemberPath="ReadinessText">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <TextBlock Text="{Binding ReadinessText}" Foreground="{Binding ReadinessColor}"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="Task"        Binding="{Binding KindText}"        FontSize="10" Width="90"/>
        <!-- Templated rather than a text column purely for the tooltip: the column is too narrow
             for a long item name, and the run count is at the far end where it gets clipped. -->
        <DataGridTemplateColumn Header="Description" Width="230" SortMemberPath="Title">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Title}"
                         FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Character"   Binding="{Binding CharacterName}"   FontSize="10" Width="130"/>
        <DataGridTextColumn Header="Location 1 (Source)" Binding="{Binding LocationName}"    FontSize="10" Width="190"/>
        <DataGridTextColumn Header="Location 2 (Dest)"   Binding="{Binding DestinationName}" FontSize="10" Width="190"/>
        <DataGridTextColumn Header="Volume"      Binding="{Binding VolumeText}"      FontSize="10" Width="100"/>

        <DataGridTemplateColumn Header="Note" Width="*" SortMemberPath="Detail">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Detail}" Foreground="#c8c8d8" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Note}" Foreground="#c85a5a"
                           IsVisible="{Binding HasNote}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SnoozeText}" Foreground="#666677"
                           IsVisible="{Binding IsSnoozed}"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Age" Width="120" SortMemberPath="AgeText">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding AgeText}"     Foreground="#7a8896"/>
                <TextBlock Text="{Binding DataAgeText}" Foreground="#555566" FontSize="9"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="" Width="80">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:WorklistRowVm">
              <Button Content="Snooze"
                      Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).SnoozeCommand}"
                      CommandParameter="{Binding Key}"
                      FontSize="9" Padding="6 2" Background="Transparent"
                      BorderBrush="#252530" BorderThickness="1" Cursor="Hand"
                      ToolTip.Tip="Hide this item for 8 hours"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>
  </Grid>
    </TabItem>

    <!-- ════ Station Needs ══════════════════════════════════════════════════════
         What each station wants and which demand is asking for it. The worklist
         says what to do; this says why, which is what gets asked when a
         suggestion looks wrong. -->
    <TabItem Header="Station Needs">
      <Grid RowDefinitions="Auto,Auto,*" Margin="14 12">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0 0 0 8">
          <TextBlock Text="Station Needs" FontSize="15" FontWeight="SemiBold"
                     Foreground="#c8a84b" VerticalAlignment="Center"/>
          <Button Content="Refresh" Command="{Binding RefreshNeedsCommand}"
                  IsEnabled="{Binding !NeedsLoading}" FontSize="11" Padding="10 4"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding NeedsStatus}" FontSize="10" Foreground="#7a8896"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Needs}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                  CanUserSortColumns="True"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <DataGrid.Styles>
            <Style Selector="DataGridCell TextBlock">
              <Setter Property="FontSize" Value="10" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Station" Width="230" SortMemberPath="Station">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <TextBlock Text="{Binding Station}" ToolTip.Tip="{Binding Station}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Item" Width="230" SortMemberPath="Item">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <TextBlock Text="{Binding Item}" ToolTip.Tip="{Binding Item}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Total"   Binding="{Binding Total}"  SortMemberPath="TotalRaw"  Width="110"/>
            <DataGridTextColumn Header="On hand" Binding="{Binding OnHand}" SortMemberPath="OnHandRaw" Width="110"/>

            <DataGridTemplateColumn Header="Short" Width="110" SortMemberPath="ShortRaw">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationNeedRowVm">
                  <TextBlock Text="{Binding Short}" Foreground="{Binding ShortColor}"
                             FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Short value"  Binding="{Binding ShortValue}"
                                SortMemberPath="ShortValueRaw"  Width="100"/>
            <DataGridTextColumn Header="Short volume" Binding="{Binding ShortVolume}"
                                SortMemberPath="ShortVolumeRaw" Width="110"/>

            <!-- The breakdown. These four always add back to Total. -->
            <DataGridTextColumn Header="Order jobs"       Binding="{Binding OrderJobs}" SortMemberPath="OrderJobsRaw" Width="110"/>
            <DataGridTextColumn Header="Jobs"             Binding="{Binding Jobs}"      SortMemberPath="JobsRaw"      Width="110"/>
            <DataGridTextColumn Header="Inventory levels" Binding="{Binding InvLevels}" SortMemberPath="InvLevelsRaw" Width="120"/>
            <DataGridTextColumn Header="Station levels"   Binding="{Binding StnLevels}" SortMemberPath="StnLevelsRaw" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <!-- ════ Config ═════════════════════════════════════════════════════════════
         Everything that sets the tool up, behind one tab so the two tabs that are
         read every session are not buried among seven that are set once. -->
    <TabItem Header="Config">
    <TabControl Padding="0" Background="Transparent">

    <TabItem Header="Market Alts">
      <!-- x:DataType scoped to the market alts VM so the bindings below compile against it rather
           than silently falling back to reflection against the parent. -->
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding MarketAltsVm}" x:DataType="vm:WorklistMarketAltsViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="Which character maintains orders at each station. Items route through these, so a station with no alt assigned produces blocked items that name no owner."/>

        <Grid Grid.Row="1" ColumnDefinitions="*,180,180,Auto" RowDefinitions="Auto,Auto" Margin="0 0 0 6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Station or structure" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Character"           Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="Note"                Classes="fieldLabel"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0"
                           Text="{Binding LocationText}"
                           SelectedItem="{Binding SelectedLocation}"
                           AsyncPopulator="{Binding LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="Station or structure…"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Characters}"
                    SelectedItem="{Binding SelectedCharacter}"
                    PlaceholderText="Character…" HorizontalAlignment="Stretch"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding Note}" Watermark="optional"/>
          <Button Grid.Row="1" Grid.Column="3" Content="Add / Update" Command="{Binding AddCommand}"
                  FontSize="11" Padding="10 4"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="10" Foreground="#7a8896"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding MarketAlts}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" FontSize="10" Width="*"
                                IsReadOnly="True"/>

            <!-- Character and note edit in place and save on change. The station does not: it is
                 the row's identity, and repointing it is what the form above is for. -->
            <DataGridTemplateColumn Header="Character" Width="200" SortMemberPath="CharacterName" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketAltRow">
                  <ComboBox ItemsSource="{Binding CharacterOptions}"
                            SelectedItem="{Binding Character, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Note" Width="220" SortMemberPath="Note" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketAltRow">
                  <TextBox Text="{Binding Note, Mode=TwoWay}" Watermark="optional"
                           FontSize="10" Background="Transparent" BorderThickness="0"
                           Foreground="#c8c8d8" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketAltRow">
                  <Button Content="Remove"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).MarketAltsVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="#252530" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <TabItem Header="Corp Projects">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding CorpAltsVm}" x:DataType="vm:WorklistCorpAltsViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="Standing projects are defined in Corp Activity; the only thing the worklist needs is who maintains them. Projects belong to a corporation, so this routes by corporation rather than by station. Only corporations that actually have standing projects are listed."/>

        <Grid Grid.Row="1" ColumnDefinitions="*,200,200,Auto" RowDefinitions="Auto,Auto" Margin="0 0 0 6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Corporation" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Maintained by" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="Note" Classes="fieldLabel"/>
          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Corps}" SelectedItem="{Binding SelectedCorp}"
                    PlaceholderText="Pick a corporation…" HorizontalAlignment="Stretch"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                    PlaceholderText="Character…" HorizontalAlignment="Stretch"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding Note}" Watermark="optional"/>
          <Button Grid.Row="1" Grid.Column="3" Content="Add / Update" Command="{Binding AddCommand}"
                  FontSize="11" Padding="10 4"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="10" Foreground="#7a8896"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Alts}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Corporation" Binding="{Binding CorporationName}" FontSize="10" Width="*"
                                IsReadOnly="True"/>

            <!-- Character and note edit in place and save on change, as on Market Alts. -->
            <DataGridTemplateColumn Header="Character" Width="200" SortMemberPath="CharacterName" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:CorpAltRow">
                  <ComboBox ItemsSource="{Binding CharacterOptions}"
                            SelectedItem="{Binding Character, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Note" Width="220" SortMemberPath="Note" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:CorpAltRow">
                  <TextBox Text="{Binding Note, Mode=TwoWay}" Watermark="optional"
                           FontSize="10" Background="Transparent" BorderThickness="0"
                           Foreground="#c8c8d8" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:CorpAltRow">
                  <Button Content="Remove"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).CorpAltsVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="#252530" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <TabItem Header="Inventory Rules">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding RulesVm}" x:DataType="vm:WorklistInvRulesViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="When a group drops below the threshold, there should be a buy order at that station. Several rules can point at one group — below 100% order locally, below 75% also order at the hub — and they stack rather than replace each other. Who places the order comes from the station's market alt."/>

        <!-- Labels above the fields rather than watermarks: both percentages default to 100,
             and a watermark only shows while a field is empty, so they were two bare numbers. -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*,90,120,120,Auto"
              RowDefinitions="Auto,Auto" Margin="0 0 0 6">

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Inventory group" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Station or structure" Classes="fieldLabel"
                     IsVisible="{Binding NeedsLocation}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Site" Classes="fieldLabel"
                     IsVisible="{Binding !NeedsLocation}"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="Action" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Trigger below (%)" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="4" Text="Fill up to (%)"  Classes="fieldLabel"/>

          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                    PlaceholderText="Pick a group…" HorizontalAlignment="Stretch"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0"
                           Text="{Binding LocationText}"
                           SelectedItem="{Binding SelectedLocation}"
                           AsyncPopulator="{Binding LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="Type two characters…"
                           IsVisible="{Binding NeedsLocation}"/>
          <!-- A Build rule runs wherever the park assigns the job, so there is nothing to pick. -->
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0 0 8 0" FontSize="10" Foreground="#666677"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     IsVisible="{Binding !NeedsLocation}"
                     Text="Decided by the Indy Park on the Industry tab"/>
          <ComboBox Grid.Row="1" Grid.Column="2" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="Buy places a market order for the shortfall; Build starts a job for it"/>
          <TextBox Grid.Row="1" Grid.Column="3" Margin="0 0 8 0" FontSize="11" Text="{Binding Threshold}"
                   ToolTip.Tip="Raise a task when stock falls below this share of the group target"/>
          <TextBox Grid.Row="1" Grid.Column="4" Margin="0 0 8 0" FontSize="11" Text="{Binding Fill}"
                   ToolTip.Tip="Fill back up to this share of the group target"/>
          <Button Grid.Row="1" Grid.Column="5" Content="Add rule" Command="{Binding AddCommand}"
                  FontSize="11" Padding="10 4"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="10" Foreground="#7a8896"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Rules}"
                  IsReadOnly="False" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <!-- Editable in place. Each cell is a live control rather than a click-to-edit one, so a
               rule can be corrected where it is read, and every change saves immediately. -->
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Group" Width="200" SortMemberPath="GroupName" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <ComboBox ItemsSource="{Binding GroupOptions}"
                            SelectedItem="{Binding Group, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Action" Width="80" SortMemberPath="Action" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <ComboBox ItemsSource="{Binding ActionOptions}"
                            SelectedItem="{Binding Action, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            ToolTip.Tip="Buy places a market order for the shortfall; Build starts a job for it"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Trigger below (%)" Width="110" SortMemberPath="Threshold" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <NumericUpDown Value="{Binding Threshold, Mode=TwoWay, Converter={StaticResource PctConv}}"
                                 Minimum="0.1" Maximum="10000" Increment="5" FormatString="0.#"
                                 ShowButtonSpinner="False" FontSize="10"
                                 Background="Transparent" BorderThickness="0" Foreground="#c8c8d8"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 ToolTip.Tip="Raise a task when stock falls below this share of the group target"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Fill to (%)" Width="100" SortMemberPath="Fill" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <NumericUpDown Value="{Binding Fill, Mode=TwoWay, Converter={StaticResource PctConv}}"
                                 Minimum="0.1" Maximum="10000" Increment="5" FormatString="0.#"
                                 ShowButtonSpinner="False" FontSize="10"
                                 Background="Transparent" BorderThickness="0" Foreground="#c8c8d8"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 ToolTip.Tip="Fill back up to this share of the group target"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- The station is picked, never typed: the id is what the tool matches on, so a
                 free-typed name would leave the rule pointing at the station it used to mean.
                 Unlike the other cells this one is click-to-edit rather than a live control.
                 An AutoCompleteBox whose Text is bound to a value that changes underneath it
                 reads the change as typing, runs its populator and opens its dropdown — which
                 is what covered whole rows in floating boxes, Build rows included. Existing only
                 while the cell is actually being edited removes the problem at the source. -->
            <DataGridTemplateColumn Header="Location" Width="*" SortMemberPath="LocationName" IsReadOnly="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <Panel>
                    <TextBlock IsVisible="{Binding NeedsLocation}" Text="{Binding LocationName}"
                               FontSize="10" Foreground="#c8c8d8" VerticalAlignment="Center"
                               ToolTip.Tip="Double-click to change the station"/>
                    <TextBlock IsVisible="{Binding !NeedsLocation}" Text="{Binding LocationDisplay}"
                               FontSize="10" Foreground="#666677" VerticalAlignment="Center"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <Panel>
                    <!-- No Text binding at all, so nothing can be mistaken for typing. -->
                    <AutoCompleteBox x:CompileBindings="False" IsVisible="{Binding NeedsLocation}"
                                     SelectedItem="{Binding PickedLocation, Mode=TwoWay}"
                                     ValueMemberBinding="{Binding Name}"
                                     AsyncPopulator="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).RulesVm.LocationPopulator}"
                                     FilterMode="None" MinimumPrefixLength="2"
                                     MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                                     FontSize="10" Watermark="Type two characters…"
                                     VerticalAlignment="Center"/>
                    <TextBlock IsVisible="{Binding !NeedsLocation}" Text="{Binding LocationDisplay}"
                               FontSize="10" Foreground="#666677" VerticalAlignment="Center"/>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Character" Binding="{Binding AltText}" FontSize="10" Width="160"
                                IsReadOnly="True"/>
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:InvRuleRow">
                  <Button Content="Remove"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).RulesVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="#252530" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <TabItem Header="Station Levels">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding StationLevelsVm}" x:DataType="vm:WorklistStationLevelsViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="Where each group's stock should live. This distributes material rather than demanding more of it — the Inventory Rules already set the quantity — so it raises hauling only, never a buy or a build. Tick Accepts surplus for the station spare stock should collect at when nothing else needs it."/>

        <Grid Grid.Row="1" ColumnDefinitions="240,*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0 0 0 6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Inventory group"     Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Station or structure" Classes="fieldLabel"/>
          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                    PlaceholderText="Group…" HorizontalAlignment="Stretch"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0"
                           Text="{Binding LocationText}"
                           SelectedItem="{Binding SelectedLocation}"
                           AsyncPopulator="{Binding LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="Need not be in the park…"/>
          <CheckBox Grid.Row="1" Grid.Column="2" Content="Accepts surplus" FontSize="11"
                    Margin="0 0 8 0" IsChecked="{Binding AcceptsSurplus}"
                    ToolTip.Tip="Spare stock of this group collects here when no station needs it."/>
          <Button Grid.Row="1" Grid.Column="3" Content="Add / Update" Command="{Binding AddCommand}"
                  FontSize="11" Padding="10 4"/>
        </Grid>

        <!-- How far a station may drift before anything moves. Without a band, a level held to
             the unit raises a haul for every handful consumed. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,20,Auto,Auto,*" Margin="0 0 0 8">
          <TextBlock Grid.Column="0" Text="Restock when below level by (%)" Classes="fieldLabel"
                     VerticalAlignment="Center" Margin="0 0 6 0"/>
          <NumericUpDown Grid.Column="1" Value="{Binding RestockBand, Mode=TwoWay}"
                         Minimum="0" Maximum="100" Increment="5" FormatString="0.#"
                         ShowButtonSpinner="False" Width="70" FontSize="11"
                         ToolTip.Tip="A station is left alone until it falls this far under its level, then is filled all the way back up. Zero restocks on any shortfall at all."/>
          <TextBlock Grid.Column="3" Text="Sweep surplus when above level by (%)" Classes="fieldLabel"
                     VerticalAlignment="Center" Margin="0 0 6 0"/>
          <NumericUpDown Grid.Column="4" Value="{Binding SurplusBand, Mode=TwoWay}"
                         Minimum="0" Maximum="100" Increment="5" FormatString="0.#"
                         ShowButtonSpinner="False" Width="70" FontSize="11"
                         ToolTip.Tip="Excess is left where it is until a station is this far over its level, then drained back down to it. Zero sweeps any excess at all."/>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="10" Foreground="#7a8896"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Levels}"
                  IsReadOnly="False" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <!-- Editable in place, saving on change, as on the Inventory Rules tab. -->
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Inventory group" Width="240" SortMemberPath="GroupName" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <ComboBox ItemsSource="{Binding GroupOptions}"
                            SelectedItem="{Binding Group, Mode=TwoWay}"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Click-to-edit, as on the Inventory Rules tab and for the same reason. -->
            <DataGridTemplateColumn Header="Station" Width="*" SortMemberPath="LocationName" IsReadOnly="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <TextBlock Text="{Binding LocationName}" FontSize="10" Foreground="#c8c8d8"
                             VerticalAlignment="Center"
                             ToolTip.Tip="Double-click to change the station"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <AutoCompleteBox x:CompileBindings="False"
                                   SelectedItem="{Binding PickedLocation, Mode=TwoWay}"
                                   ValueMemberBinding="{Binding Name}"
                                   AsyncPopulator="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).StationLevelsVm.LocationPopulator}"
                                   FilterMode="None" MinimumPrefixLength="2"
                                   MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                                   FontSize="10" Watermark="Type two characters…"
                                   VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Accepts surplus" Width="120" SortMemberPath="AcceptsSurplus" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <CheckBox IsChecked="{Binding AcceptsSurplus, Mode=TwoWay}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip.Tip="Spare stock of this group collects here when no station needs it."/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StationLevelRow">
                  <Button Content="Remove"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).StationLevelsVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="#252530" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <TabItem Header="Industry">
      <!-- No ScrollViewer: it gives the DataGrid unbounded width, which breaks star sizing and
           pushes the last column out of view. The final * row fills the tab instead. -->
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding IndustryVm}" x:DataType="vm:WorklistIndustryViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="Which characters may be given jobs, and on what. Slots on alts in corps that never run industry are not available for work, so this is opt-in. Jobs go to the least capable character who can run them, keeping the high-skill alts free for the work only they can do."/>

        <Grid Grid.Row="1" ColumnDefinitions="240,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto" Margin="0 0 0 8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Plan against park" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Max job length — manufacturing" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="reactions" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="science" Classes="fieldLabel"/>

          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 16 0" FontSize="11"
                    ItemsSource="{Binding Parks}" SelectedItem="{Binding SelectedPark}"
                    PlaceholderText="Pick a park…" HorizontalAlignment="Stretch"/>
          <TextBox Grid.Row="1" Grid.Column="1" Width="70" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding MaxJobDaysMfg}"
                   ToolTip.Tip="Days. A shortfall needing longer is split into several jobs, which can run on different slots and characters. Blank for no limit — only the blueprint's own run cap then applies."/>
          <TextBox Grid.Row="1" Grid.Column="2" Width="70" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding MaxJobDaysRxn}"
                   ToolTip.Tip="Days. Reactions are set apart from manufacturing because they are usually run in shorter, continuous cycles."/>
          <TextBox Grid.Row="1" Grid.Column="3" Width="70" Margin="0 0 8 0" FontSize="11"
                   Text="{Binding MaxJobDaysSci}"
                   ToolTip.Tip="Days, covering copying and invention. This is what decides when one multi-run invention batch becomes two: a batch yields nothing until it ends, and a single attempt on a capital blueprint is already about eight days, so a manufacturing-sized limit would force one attempt per job and spend a science slot on each."/>
          <TextBlock Grid.Row="1" Grid.Column="4" Text="days" Classes="fieldLabel"
                     VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ParkWarning}" IsVisible="{Binding HasParkWarning}"
                   FontSize="10" Foreground="#c8a84b" TextWrapping="Wrap" Margin="0 0 0 10"/>

        <!-- Where material is looked for, and where what is missing gets bought. -->
        <Grid Grid.Row="3" ColumnDefinitions="130,240,Auto,260" RowDefinitions="Auto,Auto,Auto,Auto"
              Margin="0 0 0 6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Count material" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Region / system" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Buy shortfalls at" Classes="fieldLabel"/>

          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="How far to look when deciding a job is short of something. Stock outside this counts as not owned, so it raises a purchase rather than a haul."/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Margin="0 0 16 0"
                           IsEnabled="{Binding NeedsScopePlace}"
                           Text="{Binding ScopePlaceText}"
                           SelectedItem="{Binding SelectedScopePlace}"
                           AsyncPopulator="{Binding ScopePlacePopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="Type two characters…"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="3"
                           Text="{Binding BuyLocationText}"
                           SelectedItem="{Binding SelectedBuyLocation}"
                           AsyncPopulator="{Binding LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="Trade hub…"
                           ToolTip.Tip="Where purchases are raised, and whose market alt gets them. Blueprints are left unassigned — a BPO or BPC comes from contracts, not a market order."/>

          <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0 8 0 0"
                    Content="Count other corporations' assets" FontSize="11"
                    IsChecked="{Binding IncludeNonPersonalCorps}"
                    ToolTip.Tip="Off by default. Only corporations flagged personal on the Corporations tab count as material — authorising a character in a large alliance corp otherwise hands the tool that corp's entire hangar, none of which is yours."/>

          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 8 0 0"
                     Text="Also count these stations" Classes="fieldLabel"/>
          <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
            <AutoCompleteBox Width="290"
                             Text="{Binding ExtraStationText}"
                             SelectedItem="{Binding SelectedExtraStation}"
                             AsyncPopulator="{Binding LocationPopulator}"
                             FilterMode="None" MinimumPrefixLength="2"
                             MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                             FontSize="11" Watermark="Jita, Amarr…"
                             ToolTip.Tip="Trade hubs you import through. Stock waiting in one of these is stock you have, so it should not raise a second purchase."/>
            <Button Content="Add" Command="{Binding AddScopeStationCommand}" FontSize="11" Padding="10 4"/>
          </StackPanel>
          <ItemsControl Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" ItemsSource="{Binding ScopeStations}"
                        Margin="8 0 0 0" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScopeStationRow">
                <Button Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).IndustryVm.DeleteScopeStationCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding LocationName}" ToolTip.Tip="Click to remove from the scope"
                        FontSize="9" Padding="6 2" Margin="0 0 4 4" Cursor="Hand"
                        Background="Transparent" BorderBrush="#252530" BorderThickness="1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding BuyWarning}" IsVisible="{Binding HasBuyWarning}"
                   FontSize="10" Foreground="#c8a84b" TextWrapping="Wrap" Margin="0 0 0 10"/>

        <!-- Slots only. What a character may build is a scheduling choice; what material is
             available is the asset scope's business and applies to every character alike. -->
        <Grid Grid.Row="5" ColumnDefinitions="200,Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto" Margin="0 8 0 6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Character" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Slots used for" Classes="fieldLabel"/>
          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 12 0" FontSize="11"
                    ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                    PlaceholderText="Character…" HorizontalAlignment="Stretch"/>
          <CheckBox Grid.Row="1" Grid.Column="1" Content="Manufacturing" IsChecked="{Binding Manufacturing}" FontSize="11" Margin="0 0 8 0"/>
          <CheckBox Grid.Row="1" Grid.Column="2" Content="Reactions"     IsChecked="{Binding Reactions}"     FontSize="11" Margin="0 0 8 0"/>
          <CheckBox Grid.Row="1" Grid.Column="3" Content="Science"       IsChecked="{Binding Science}"       FontSize="11" Margin="0 0 12 0"/>
          <Button   Grid.Row="1" Grid.Column="4" Content="Add / Update" Command="{Binding AddCommand}"
                    FontSize="11" Padding="10 4"/>
        </Grid>

        <TextBlock Grid.Row="6" Text="{Binding Status}" FontSize="10" Foreground="#7a8896"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="7" ItemsSource="{Binding Chars}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Character" Binding="{Binding CharacterName}" FontSize="10" Width="200"
                                IsReadOnly="True"/>

            <!-- Editable in place, saving on change. -->
            <DataGridTemplateColumn Header="Slots used for" Width="260" SortMemberPath="Activities" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:IndyCharRow">
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <CheckBox Content="Mfg"  IsChecked="{Binding Manufacturing, Mode=TwoWay}" FontSize="10"
                              MinHeight="0" ToolTip.Tip="Manufacturing"/>
                    <CheckBox Content="Rxn"  IsChecked="{Binding Reactions, Mode=TwoWay}"     FontSize="10"
                              MinHeight="0" ToolTip.Tip="Reactions"/>
                    <CheckBox Content="Sci"  IsChecked="{Binding Science, Mode=TwoWay}"       FontSize="10"
                              MinHeight="0" ToolTip.Tip="Science — copying, research, invention"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Free / total" Binding="{Binding Slots}" FontSize="10" Width="*"
                                IsReadOnly="True"/>
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:IndyCharRow">
                  <Button Content="Remove"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).IndustryVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="#252530" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <TabItem Header="Order Rules">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14 12"
            DataContext="{Binding OrderRulesVm}" x:DataType="vm:WorklistOrderRulesViewModel">

        <TextBlock Grid.Row="0" FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                   Margin="0 0 0 10"
                   Text="Plans your pending customer orders and buys what they are short of. Quantities already built or already in production are subtracted first, then the rest is planned against the park — so its facilities and rigs decide how much material a build really needs."/>

        <Grid Grid.Row="1" ColumnDefinitions="240,*,Auto" RowDefinitions="Auto,Auto" Margin="0 0 0 6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Plan against park" Classes="fieldLabel"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Buy at" Classes="fieldLabel"/>
          <ComboBox Grid.Row="1" Grid.Column="0" Margin="0 0 8 0" FontSize="11"
                    ItemsSource="{Binding Parks}" SelectedItem="{Binding SelectedPark}"
                    PlaceholderText="Pick a park…" HorizontalAlignment="Stretch"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Margin="0 0 8 0"
                           Text="{Binding LocationText}"
                           SelectedItem="{Binding SelectedLocation}"
                           AsyncPopulator="{Binding LocationPopulator}"
                           FilterMode="None" MinimumPrefixLength="2"
                           MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                           FontSize="11" Watermark="Type two characters…"/>
          <Button Grid.Row="1" Grid.Column="2" Content="Add rule" Command="{Binding AddCommand}"
                  FontSize="11" Padding="10 4"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="10" Foreground="#7a8896"
                   TextWrapping="Wrap" Margin="0 0 0 8"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Rules}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="10"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Park"      Binding="{Binding ParkName}"     FontSize="10" Width="240"/>
            <DataGridTextColumn Header="Buy at"    Binding="{Binding LocationName}" FontSize="10" Width="*"/>
            <DataGridTextColumn Header="Character" Binding="{Binding AltText}"      FontSize="10" Width="160"/>
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:OrderRuleRow">
                  <Button Content="Remove"
                          Command="{Binding $parent[UserControl].((vm:WorklistViewModel)DataContext).OrderRulesVm.DeleteCommand}"
                          CommandParameter="{Binding}"
                          FontSize="9" Padding="6 2" Background="Transparent"
                          BorderBrush="#252530" BorderThickness="1" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <TabItem Header="Sources">
      <ScrollViewer>
        <StackPanel Margin="14 12" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

          <StackPanel Spacing="6">
            <TextBlock Text="Sources" FontSize="12" FontWeight="SemiBold" Foreground="#c8a84b"/>
            <TextBlock FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                       Text="A source that is off is skipped entirely — it costs no queries rather than running and having its output discarded."/>
            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorklistToggleVm">
                  <StackPanel Margin="0 6 0 0">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" FontSize="11"/>
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#555566"
                               Margin="24 0 0 0" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Standing buy orders — what to raise" FontSize="12"
                       FontWeight="SemiBold" Foreground="#c8a84b"/>
            <TextBlock FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                       Text="Which conditions become tasks. Each is a different job, so they switch independently."/>
            <ItemsControl ItemsSource="{Binding Conditions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorklistToggleVm">
                  <StackPanel Margin="0 6 0 0">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" FontSize="11"/>
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#555566"
                               Margin="24 0 0 0" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    </TabControl>
    </TabItem>

  </TabControl>
</UserControl>
