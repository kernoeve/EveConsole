<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.ContractDetailView"
             x:DataType="vm:ContractDetailVm"
             x:CompileBindings="True">

  <UserControl.Styles>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0 0 0 4" />
    </Style>
    <Style Selector="TextBlock.val">
      <Setter Property="FontSize"   Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0 0 0 4" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 4 2 4" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <!-- The item lists, offered and requested: the grid as it was, twice, with the totals row
         that ends each set apart in weight and ground. -->
    <Style Selector="DataGrid.items">
      <Setter Property="AutoGenerateColumns"   Value="False" />
      <Setter Property="IsReadOnly"            Value="True" />
      <Setter Property="HeadersVisibility"     Value="Column" />
      <Setter Property="RowHeight"             Value="22" />
      <Setter Property="MaxHeight"             Value="320" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserResizeColumns"  Value="True" />
      <Setter Property="CanUserSortColumns"    Value="False" />
      <Setter Property="Background"            Value="{DynamicResource SurfaceBaseBrush}" />
      <Setter Property="GridLinesVisibility"   Value="Horizontal" />
    </Style>
    <Style Selector="DataGrid.items DataGridRow.total TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGrid.items DataGridRow.total /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SurfacePanelBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12 10" Spacing="8">

      <!-- Header -->
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrightBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BorderStrongBrush}" />
          <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{Binding StatusColor}" />
          <TextBlock Text="{Binding Availability}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
          <TextBlock Text="{Binding ContractId, StringFormat='#{0}'}" FontSize="10"
                     Foreground="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Parties -->
      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="Issuer" />
        <Panel Grid.Row="0" Grid.Column="1">
          <Button Classes="link" Click="OnOpenIssuer" IsVisible="{Binding HasIssuerLink}"
                  ToolTip.Tip="Open in the entity browser">
            <TextBlock Text="{Binding Issuer}" Classes="val linktext" Margin="0" />
          </Button>
          <TextBlock Text="{Binding Issuer}" Classes="val" IsVisible="{Binding !HasIssuerLink}" />
        </Panel>
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="Assignee" />
        <Panel Grid.Row="1" Grid.Column="1">
          <Button Classes="link" Click="OnOpenAssignee" IsVisible="{Binding HasAssigneeLink}"
                  ToolTip.Tip="Open in the entity browser">
            <TextBlock Text="{Binding Assignee}" Classes="val linktext" Margin="0" />
          </Button>
          <TextBlock Text="{Binding Assignee}" Classes="val" IsVisible="{Binding !HasAssigneeLink}" />
        </Panel>
        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="Acceptor" />
        <Panel Grid.Row="2" Grid.Column="1">
          <Button Classes="link" Click="OnOpenAcceptor" IsVisible="{Binding HasAcceptorLink}"
                  ToolTip.Tip="Open in the entity browser">
            <TextBlock Text="{Binding Acceptor}" Classes="val linktext" Margin="0" />
          </Button>
          <TextBlock Text="{Binding Acceptor}" Classes="val" IsVisible="{Binding !HasAcceptorLink}" />
        </Panel>
      </Grid>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Value -->
      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="Price" />
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="val" Text="{Binding Price}" Foreground="{DynamicResource AccentBrush}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="Reward"
                   IsVisible="{Binding HasReward}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" Text="{Binding Reward}"
                   Foreground="{DynamicResource GoodBrush}" IsVisible="{Binding HasReward}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="Collateral"
                   IsVisible="{Binding HasCollateral}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="val" Text="{Binding Collateral}"
                   IsVisible="{Binding HasCollateral}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="lbl" Text="Buyout"
                   IsVisible="{Binding HasBuyout}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Classes="val" Text="{Binding Buyout}"
                   IsVisible="{Binding HasBuyout}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="lbl" Text="Volume" />
        <TextBlock Grid.Row="4" Grid.Column="1" Classes="val" Text="{Binding Volume}" />
      </Grid>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Locations -->
      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="From" />
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="val" Text="{Binding StartLocation}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="To"
                   IsVisible="{Binding IsCourier}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" Text="{Binding EndLocation}"
                   IsVisible="{Binding IsCourier}" />
      </Grid>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Dates -->
      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="Issued" />
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="val" Text="{Binding DateIssued}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="Expires" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" Text="{Binding DateExpired}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="Accepted" />
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="val" Text="{Binding DateAccepted}" />
        <TextBlock Grid.Row="3" Grid.Column="0" Classes="lbl" Text="Completed" />
        <TextBlock Grid.Row="3" Grid.Column="1" Classes="val" Text="{Binding DateCompleted}" />
      </Grid>

      <!-- No items stored: a pull on request, and what ESI answered. -->
      <StackPanel Spacing="4" IsVisible="{Binding !HasItems}" Margin="0 4 0 0">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Pull items from ESI" Command="{Binding PullItemsAsync}" IsEnabled="{Binding CanPull}"
                  FontSize="11" Padding="10 3"
                  ToolTip.Tip="Ask every endpoint this contract has for its items, once more, and say what each answered." />
          <TextBlock Text="{Binding PullMessage}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </StackPanel>
      </StackPanel>

      <!-- Items, in two lists: what the issuer offers and what they ask for. Each row carries
           the item's picture and what the line is worth at market and to build, and each list
           ends in a totals row — the same columns summed, set apart by the row style. -->
      <StackPanel Spacing="4" IsVisible="{Binding HasOffered}">
        <TextBlock Text="Offered" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" Margin="0 4 0 0" />
        <DataGrid ItemsSource="{Binding Offered}" Classes="items" LoadingRow="OnLoadingRow">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Item" Width="*" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding TypeName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenItem" IsVisible="{Binding HasItemLink}"
                            ToolTip.Tip="Open in the Item Browser">
                      <TextBlock Text="{Binding TypeName}" Classes="linktext" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                               FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Qty"          Binding="{Binding Quantity}"    Width="Auto" CellStyleClasses="num" />
            <DataGridTemplateColumn Header="Market value" Width="110" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding MarketValue}" CellStyleClasses="num">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <TextBlock Text="{Binding MarketValue}" ToolTip.Tip="{Binding MarketTip}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Build value" Width="110" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding BuildValue}" CellStyleClasses="num">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <TextBlock Text="{Binding BuildValue}" ToolTip.Tip="{Binding BuildTip}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="Auto" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>

      <StackPanel Spacing="4" IsVisible="{Binding HasRequested}">
        <TextBlock Text="Requested" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}" Margin="0 4 0 0" />
        <DataGrid ItemsSource="{Binding Requested}" Classes="items" LoadingRow="OnLoadingRow">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Item" Width="*" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding TypeName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenItem" IsVisible="{Binding HasItemLink}"
                            ToolTip.Tip="Open in the Item Browser">
                      <TextBlock Text="{Binding TypeName}" Classes="linktext" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                               FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Qty"          Binding="{Binding Quantity}"    Width="Auto" CellStyleClasses="num" />
            <DataGridTemplateColumn Header="Market value" Width="110" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding MarketValue}" CellStyleClasses="num">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <TextBlock Text="{Binding MarketValue}" ToolTip.Tip="{Binding MarketTip}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Build value" Width="110" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding BuildValue}" CellStyleClasses="num">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <TextBlock Text="{Binding BuildValue}" ToolTip.Tip="{Binding BuildTip}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="Auto" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
