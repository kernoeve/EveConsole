<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.ContractDetailView"
             x:DataType="vm:ContractDetailVm"
             x:CompileBindings="True">

  <UserControl.Styles>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0 0 0 4" />
    </Style>
    <Style Selector="TextBlock.val">
      <Setter Property="FontSize"   Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0 0 0 4" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 4 2 4" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <!-- The item lists, offered and requested: the grid as it was, twice, with the totals row
         that ends each set apart in weight and ground. -->
    <Style Selector="DataGrid.items">
      <Setter Property="AutoGenerateColumns"   Value="False" />
      <Setter Property="IsReadOnly"            Value="True" />
      <Setter Property="HeadersVisibility"     Value="Column" />
      <Setter Property="RowHeight"             Value="22" />
      <Setter Property="MaxHeight"             Value="320" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserResizeColumns"  Value="True" />
      <Setter Property="CanUserSortColumns"    Value="False" />
      <Setter Property="Background"            Value="{DynamicResource SurfaceBaseBrush}" />
      <Setter Property="GridLinesVisibility"   Value="Horizontal" />
    </Style>
    <Style Selector="DataGrid.items DataGridRow.total TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGrid.items DataGridRow.total /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SurfacePanelBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12 10" Spacing="8">

      <!-- Header -->
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrightBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BorderStrongBrush}" />
          <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{Binding StatusColor}" />
          <TextBlock Text="{Binding Availability}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
          <TextBlock Text="{Binding ContractId, StringFormat='#{0}'}" FontSize="10"
                     Foreground="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Parties -->
      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Issuer}" />
        <!-- Each name with its portrait or logo; a grid, not a horizontal stack, so a long name
             still wraps. -->
        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*">
          <Image Grid.Column="0" Source="{Binding IssuerIcon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0 0 6 4"
                 IsVisible="{Binding IssuerIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Panel Grid.Column="1">
            <Button Classes="link" Click="OnOpenIssuer" IsVisible="{Binding HasIssuerLink}"
                    ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheEntityBrowser}">
              <TextBlock Text="{Binding Issuer}" Classes="val linktext" Margin="0" />
            </Button>
            <TextBlock Text="{Binding Issuer}" Classes="val" IsVisible="{Binding !HasIssuerLink}" />
          </Panel>
        </Grid>
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Assignee}" />
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*">
          <Image Grid.Column="0" Source="{Binding AssigneeIcon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0 0 6 4"
                 IsVisible="{Binding AssigneeIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Panel Grid.Column="1">
            <Button Classes="link" Click="OnOpenAssignee" IsVisible="{Binding HasAssigneeLink}"
                    ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheEntityBrowser}">
              <TextBlock Text="{Binding Assignee}" Classes="val linktext" Margin="0" />
            </Button>
            <TextBlock Text="{Binding Assignee}" Classes="val" IsVisible="{Binding !HasAssigneeLink}" />
          </Panel>
        </Grid>
        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Acceptor}" />
        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*">
          <Image Grid.Column="0" Source="{Binding AcceptorIcon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0 0 6 4"
                 IsVisible="{Binding AcceptorIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Panel Grid.Column="1">
            <Button Classes="link" Click="OnOpenAcceptor" IsVisible="{Binding HasAcceptorLink}"
                    ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheEntityBrowser}">
              <TextBlock Text="{Binding Acceptor}" Classes="val linktext" Margin="0" />
            </Button>
            <TextBlock Text="{Binding Acceptor}" Classes="val" IsVisible="{Binding !HasAcceptorLink}" />
          </Panel>
        </Grid>
      </Grid>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Value -->
      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Price}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="val" Text="{Binding Price}" Foreground="{DynamicResource AccentBrush}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Reward}"
                   IsVisible="{Binding HasReward}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" Text="{Binding Reward}"
                   Foreground="{DynamicResource GoodBrush}" IsVisible="{Binding HasReward}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Collateral}"
                   IsVisible="{Binding HasCollateral}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="val" Text="{Binding Collateral}"
                   IsVisible="{Binding HasCollateral}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Buyout}"
                   IsVisible="{Binding HasBuyout}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Classes="val" Text="{Binding Buyout}"
                   IsVisible="{Binding HasBuyout}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Volume}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Classes="val" Text="{Binding Volume}" />
      </Grid>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Locations -->
      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.From}" />
        <!-- Each place with its station's or structure's picture. -->
        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*">
          <Image Grid.Column="0" Source="{Binding StartIcon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0 0 6 4"
                 IsVisible="{Binding StartIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Column="1" Classes="val" Text="{Binding StartLocation}" />
        </Grid>
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.To}"
                   IsVisible="{Binding IsCourier}" />
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*" IsVisible="{Binding IsCourier}">
          <Image Grid.Column="0" Source="{Binding EndIcon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0 0 6 4"
                 IsVisible="{Binding EndIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Column="1" Classes="val" Text="{Binding EndLocation}" />
        </Grid>
      </Grid>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Dates -->
      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Issued}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="val" Text="{Binding DateIssued}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Expires}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" Text="{Binding DateExpired}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Accepted}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="val" Text="{Binding DateAccepted}" />
        <TextBlock Grid.Row="3" Grid.Column="0" Classes="lbl" Text="{x:Static loc:MarketText.Completed}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Classes="val" Text="{Binding DateCompleted}" />
      </Grid>

      <!-- No items stored: a pull on request, and what ESI answered. Never on a courier: ESI
           does not list a courier's cargo. -->
      <StackPanel Spacing="4" IsVisible="{Binding ShowsPull}" Margin="0 4 0 0">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="{x:Static loc:MarketText.PullItemsFromEsi}" Command="{Binding PullItemsAsync}" IsEnabled="{Binding CanPull}"
                  FontSize="11" Padding="10 3"
                  ToolTip.Tip="{x:Static loc:MarketText.TipAskEveryEndpointThis}" />
          <TextBlock Text="{Binding PullMessage}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </StackPanel>
      </StackPanel>

      <!-- A courier we made: its cargo, entered by hand — quantities edited in place, lines taken
           off, and lines added or put in place of the lot from text pasted out of the game. Saved
           as it is changed. -->
      <StackPanel Spacing="6" Margin="0 6 0 0" IsVisible="{Binding HasCargo}">
        <StackPanel Spacing="6" DataContext="{Binding Cargo}" x:DataType="vm:CourierCargoVm">
          <TextBlock Text="{x:Static loc:MarketText.CourierCargoTitle}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource GoodBrush}" />
          <TextBlock Text="{x:Static loc:MarketText.CourierCargoNote}" FontSize="10" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFaintBrush}" />

          <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CourierCargoRowVm">
                <Grid ColumnDefinitions="24,*,110,90,Auto" Margin="0 1">
                  <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="link" Click="OnOpenCargoItem"
                          ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheItemBrowser}">
                    <TextBlock Text="{Binding TypeName}" Classes="linktext" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <NumericUpDown Grid.Column="2" Value="{Binding Quantity, Mode=TwoWay}" Minimum="0" Increment="1"
                                 FormatString="N0" ShowButtonSpinner="False" FontSize="11" Margin="6 0"
                                 ToolTip.Tip="{x:Static loc:MarketText.TipCourierCargoQuantity}" />
                  <TextBlock Grid.Column="3" Text="{Binding VolumeText}" FontSize="11" TextAlignment="Right"
                             VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                  <Button Grid.Column="4" Content="✕" FontSize="10" Padding="6 1" Margin="8 0 0 0" Click="OnRemoveCargo"
                          ToolTip.Tip="{x:Static loc:MarketText.TipCourierCargoRemove}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{x:Static loc:MarketText.CourierCargoEmpty}" FontSize="11" IsVisible="{Binding !HasRows}"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding TotalsText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />

          <TextBox Text="{Binding PasteText}" AcceptsReturn="True" TextWrapping="NoWrap" Height="90" FontSize="11"
                   Watermark="{x:Static loc:MarketText.CourierCargoPasteHint}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static loc:MarketText.CourierCargoAdd}" Command="{Binding AddPastedAsync}"
                    FontSize="11" Padding="10 3" ToolTip.Tip="{x:Static loc:MarketText.TipCourierCargoAdd}" />
            <Button Content="{x:Static loc:MarketText.CourierCargoReplace}" Command="{Binding ReplacePastedAsync}"
                    FontSize="11" Padding="10 3" ToolTip.Tip="{x:Static loc:MarketText.TipCourierCargoReplace}" />
            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Items, in two lists: what the issuer offers and what they ask for. Each row carries
           the item's picture and what the line is worth at market and to build, and each list
           ends in a totals row — the same columns summed, set apart by the row style. -->
      <StackPanel Spacing="4" IsVisible="{Binding HasOffered}">
        <TextBlock Text="{x:Static loc:MarketText.Offered}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" Margin="0 4 0 0" />
        <DataGrid ItemsSource="{Binding Offered}" Classes="items" LoadingRow="OnLoadingRow">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColItem}" Width="*" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding TypeName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenItem" IsVisible="{Binding HasItemLink}"
                            ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheItemBrowser}">
                      <TextBlock Text="{Binding TypeName}" Classes="linktext" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                               FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static loc:MarketText.ColQty}"          Binding="{Binding Quantity}"    Width="Auto" CellStyleClasses="num" />
            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColMarketValue}" Width="110" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding MarketValue}" CellStyleClasses="num">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <TextBlock Text="{Binding MarketValue}" ToolTip.Tip="{Binding MarketTip}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColBuildValue}" Width="110" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding BuildValue}" CellStyleClasses="num">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <TextBlock Text="{Binding BuildValue}" ToolTip.Tip="{Binding BuildTip}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static loc:MarketText.ColDetails}" Binding="{Binding Details}" Width="Auto" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>

      <StackPanel Spacing="4" IsVisible="{Binding HasRequested}">
        <TextBlock Text="{x:Static loc:MarketText.Requested}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}" Margin="0 4 0 0" />
        <DataGrid ItemsSource="{Binding Requested}" Classes="items" LoadingRow="OnLoadingRow">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColItem}" Width="*" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding TypeName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenItem" IsVisible="{Binding HasItemLink}"
                            ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheItemBrowser}">
                      <TextBlock Text="{Binding TypeName}" Classes="linktext" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                               FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static loc:MarketText.ColQty}"          Binding="{Binding Quantity}"    Width="Auto" CellStyleClasses="num" />
            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColMarketValue}" Width="110" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding MarketValue}" CellStyleClasses="num">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <TextBlock Text="{Binding MarketValue}" ToolTip.Tip="{Binding MarketTip}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColBuildValue}" Width="110" x:DataType="vm:ContractItemRowVm" ClipboardContentBinding="{Binding BuildValue}" CellStyleClasses="num">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ContractItemRowVm">
                  <TextBlock Text="{Binding BuildValue}" ToolTip.Tip="{Binding BuildTip}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static loc:MarketText.ColDetails}" Binding="{Binding Details}" Width="Auto" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
