<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.UnsavedFitDialog"
        Title="Unsaved changes"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
    <TextBlock Text="Save them before continuing?" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="14 6" Click="OnCancel" />
      <Button Content="Don't save"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource BadBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="14 6" Click="OnDiscard" />
      <Button Content="Save…"
              Background="{DynamicResource SurfaceSelectedBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1" Padding="14 6" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>
