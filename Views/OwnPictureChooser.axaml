<!-- "Your picture" on a Jabber account or a Mumble server: a file, an EVE portrait, or none. Sent when chosen. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.OwnPictureChooser"
             x:DataType="vm:OwnPictureVm">
  <StackPanel Spacing="6">
    <TextBlock Text="{x:Static loc:JabberText.PictureTitle}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0 10 0 0" />
    <Grid ColumnDefinitions="Auto,*">
      <views:AvatarView Of="{Binding Preview}" Size="48" VerticalAlignment="Top" Margin="0 2 12 0" />
      <StackPanel Grid.Column="1" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static loc:JabberText.PictureChoose}" Click="OnChooseFile" IsEnabled="{Binding CanUse}" FontSize="12" />
          <Button Content="{x:Static loc:JabberText.PictureRemove}" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanUse}" FontSize="12" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPortraits}">
          <TextBlock Text="{x:Static loc:JabberText.PictureUseEve}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          <ComboBox ItemsSource="{Binding Portraits}" SelectedItem="{Binding Portrait}" IsEnabled="{Binding CanUse}" MinWidth="200" FontSize="12">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:IrcPortraitChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBlock Text="{x:Static loc:JabberText.PictureNote}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" />
        <TextBlock Text="{x:Static loc:JabberText.PictureNotConnected}" IsVisible="{Binding !CanChange}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" />
        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" />
        <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource GoodBrush}" />
        <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
