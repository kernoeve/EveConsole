<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:conv="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.InvLevelView"
             x:DataType="vm:InvLevelViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Resources>
    <conv:NullableDecimalToPositiveIntConverter x:Key="IntConv" />
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,1,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">

        <Button Grid.Column="0"
                Command="{Binding AddGroupCommand}"
                Content="+ Add Group"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                Padding="12 4" FontSize="11" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8 0 0 0">
          <Button Command="{Binding AddCollectionCommand}"
                  Content="+ Collection"
                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                  BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1"
                  Padding="12 4" FontSize="11" />
          <Button Command="{Binding ImportCollectionCommand}"
                  Content="Import Collection"
                  ToolTip.Tip="Read a collection from a file. It always comes in as a new collection, never merged into an existing one."
                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                  BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1"
                  Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        </StackPanel>

        <Button Grid.Column="2"
                Command="{Binding RefreshCommand}"
                Content="Refresh"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                Padding="12 4" FontSize="11" Margin="8 0 0 0" />

        <TextBlock Grid.Column="3"
                   Text="{Binding StatusText}"
                   FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="16 0 0 0" />
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtleBrush}" />

    <!-- ── Data grid ─────────────────────────────────────────────────── -->
    <DataGrid Grid.Row="2"
              x:Name="MainGrid"
              ItemsSource="{Binding GridRows}"
              SelectedItem="{Binding SelectedRow}"
              AutoGenerateColumns="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              Sorting="OnGridSorting"
              IsReadOnly="False"
              Classes="tinted"
              Background="{DynamicResource SurfaceBaseBrush}"
              RowBackground="{DynamicResource SurfaceBaseBrush}"
              GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}"
              HeadersVisibility="Column"
              FontSize="11"
              RowHeight="25"
              BorderThickness="0"
              KeyDown="OnGridKeyDown">

      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open in Item Browser"
                    Command="{Binding OpenInItemBrowserCommand}"
                    IsEnabled="{Binding IsItemRowSelected}" />
          <Separator />
          <MenuItem Header="Add Items From Fit"
                    Command="{Binding AddFromFitCommand}" />
          <MenuItem Header="Add Items From Market Group"
                    Command="{Binding AddFromMarketGroupCommand}" />
          <MenuItem Header="Add Items From Blueprint"
                    Command="{Binding AddFromBlueprintCommand}" />
          <Separator />
          <MenuItem Header="Delete Item"
                    Command="{Binding DeleteSelectedItemCommand}"
                    IsEnabled="{Binding IsItemRowSelected}" />
        </ContextMenu>
      </DataGrid.ContextMenu>

      <DataGrid.Styles>
        <Style Selector="DataGridColumnHeader">
          <Setter Property="Background"                Value="{DynamicResource SurfacePanelBrush}" />
          <Setter Property="Foreground"                Value="{DynamicResource TextFaintBrush}" />
          <Setter Property="FontSize"                  Value="10" />
          <Setter Property="FontWeight"                Value="SemiBold" />
          <Setter Property="Padding"                   Value="6 6 2 6" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="BorderBrush"               Value="{DynamicResource BorderSubtleBrush}" />
          <Setter Property="BorderThickness"           Value="0 0 1 1" />
        </Style>
        <Style Selector="DataGridCell">
          <Setter Property="Padding"         Value="0" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="ClipToBounds"    Value="False" />
          <Setter Property="FontSize"        Value="11" />
          <Setter Property="MinHeight"       Value="0" />
        </Style>
        <Style Selector="DataGridRow">
          <Setter Property="MinHeight" Value="25" />
          <!-- Per-row tint: base colour for collection/group/item rows, orange/red when an item
               is under target. Bound (not set on LoadingRow) so it updates live as stock changes. -->
          <Setter Property="Background" Value="{Binding RowBackground}" />
        </Style>
      </DataGrid.Styles>

      <DataGrid.Columns>

        <!-- GROUP / ITEM / COLLECTION -->
        <DataGridTemplateColumn Header="GROUP / ITEM" Width="*" MinWidth="360" Tag="TypeName"
                                IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Canvas x:CompileBindings="False" ClipToBounds="False" Height="25">

                <!-- Collection row: toggle + name + action buttons -->
                <StackPanel IsVisible="{Binding IsCollection}" Orientation="Horizontal" Spacing="6"
                            Canvas.Left="4" Canvas.Top="2">
                  <Button Command="{Binding ToggleCommand}"
                          Content="{Binding ExpanderIcon}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource InfoBrush}" Padding="2 0" FontSize="11"
                          VerticalAlignment="Center" Cursor="Hand" />
                  <TextBlock Text="{Binding CollectionName}"
                             FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                  <Button Command="{Binding ExpandAllCommand}"
                          Content="+"
                          ToolTip.Tip="Expand all groups"
                          Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1"
                          Padding="6 2" FontSize="11" VerticalAlignment="Center" Cursor="Hand" Margin="6 0 0 0" />
                  <Button Command="{Binding CollapseAllCommand}"
                          Content="−"
                          ToolTip.Tip="Collapse all groups"
                          Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1"
                          Padding="6 2" FontSize="11" VerticalAlignment="Center" Cursor="Hand" />
                  <Button Command="{Binding RenameCommand}"
                          Content="Rename"
                          IsVisible="{Binding !IsSynthetic}"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                          Padding="8 2" FontSize="10" VerticalAlignment="Center" Cursor="Hand" />
                  <Button Command="{Binding ExportCommand}"
                          Content="Export"
                          IsVisible="{Binding !IsSynthetic}"
                          ToolTip.Tip="Save this collection's groups, scopes and item targets to a file."
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                          Padding="8 2" FontSize="10" VerticalAlignment="Center" Cursor="Hand"
                          Margin="6 0 0 0" />
                  <Button Command="{Binding DeleteCommand}"
                          Content="Delete"
                          IsVisible="{Binding !IsSynthetic}"
                          Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                          BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1"
                          Padding="8 2" FontSize="10" VerticalAlignment="Center" Cursor="Hand" />
                </StackPanel>

                <!-- Group row: toggle + name + multiplier + action buttons + scope/locality -->
                <StackPanel IsVisible="{Binding IsGroup}" Orientation="Horizontal" Spacing="6"
                            Canvas.Left="20" Canvas.Top="2">
                  <Button Command="{Binding ToggleCommand}"
                          Content="{Binding ExpanderIcon}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextMutedBrush}" Padding="2 0" FontSize="11"
                          VerticalAlignment="Center" Cursor="Hand" />
                  <TextBlock Text="{Binding GroupName}"
                             FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="×" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                             VerticalAlignment="Center" Margin="6 0 0 0" />
                  <NumericUpDown x:CompileBindings="False"
                                 Value="{Binding Multiplier, Converter={StaticResource IntConv}}"
                                 Minimum="1" Maximum="9999"
                                 ShowButtonSpinner="False"
                                 Width="52" Height="20" MinHeight="0" FontSize="11"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Button Command="{Binding AddItemCommand}"
                          Content="+ Item"
                          Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource GoodBrush}"
                          BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1"
                          Padding="8 2" FontSize="10" VerticalAlignment="Center" Cursor="Hand" Margin="4 0 0 0" />
                  <Button Command="{Binding EditCommand}"
                          Content="Edit"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                          Padding="8 2" FontSize="10" VerticalAlignment="Center" Cursor="Hand" />
                  <Button Command="{Binding DeleteCommand}"
                          Content="Delete"
                          Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                          BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1"
                          Padding="8 2" FontSize="10" VerticalAlignment="Center" Cursor="Hand" />
                  <!-- ScopeDisplay split so the location name can link while the scope word stays
                       plain. Where it goes depends on the scope: the region, the system, or the
                       station or structure. An "Everywhere" group has no location, so it falls
                       back to the joined string and nothing is clickable. -->
                  <StackPanel Orientation="Horizontal" Spacing="0" Margin="8 0 0 0">
                    <Button Classes="link" Click="OnOpenGroupLocation"
                            IsVisible="{Binding HasLocationLink}"
                            ToolTip.Tip="Open this location">
                      <TextBlock Text="{Binding LocationName}" Classes="linktext"
                                 FontSize="10" Foreground="{DynamicResource InfoBrush}" />
                    </Button>
                    <TextBlock Text="{Binding ScopeDisplay}" IsVisible="{Binding !HasLocationLink}"
                               FontSize="10" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScopeSuffix}" IsVisible="{Binding HasLocationLink}"
                               FontSize="10" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding IncludeSummary}"
                             FontSize="10" Foreground="{DynamicResource InfoBrush}"
                             VerticalAlignment="Center" Margin="4 0 0 0" />
                </StackPanel>

                <!-- Item row. ⚠️ Canvas.Left/Top go on the Button, not the inner TextBlock: the
                     Canvas positions its direct children, and leaving them on the text would
                     stack every item name at the origin. -->
                <Button IsVisible="{Binding IsItem}" Classes="link" Click="OnOpenItem"
                        Canvas.Left="32" Canvas.Top="5"
                        ToolTip.Tip="Open in the Item Browser">
                  <TextBlock Text="{Binding TypeName}" Classes="linktext"
                             FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Button>
              </Canvas>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- TARGET -->
        <DataGridTemplateColumn Header="TARGET" Width="90" MinWidth="90" Tag="TargetQty" IsReadOnly="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <NumericUpDown x:CompileBindings="False"
                             IsVisible="{Binding IsItem}"
                             Value="{Binding TargetQty, Converter={StaticResource IntConv}}"
                             Minimum="1" Maximum="999999999"
                             ShowButtonSpinner="False"
                             FontSize="11"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             HorizontalAlignment="Stretch" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- TGT TOTAL (target × multiplier) -->
        <DataGridTemplateColumn Header="TGT TOTAL" Width="95" MinWidth="95" Tag="TargetTotal" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding TargetTotalText}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- AVAIL -->
        <DataGridTemplateColumn Header="AVAIL" Width="85" MinWidth="85" Tag="Available" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding AvailableText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- DIFF -->
        <DataGridTemplateColumn Header="DIFF" Width="80" MinWidth="80" Tag="Diff" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding DiffText}"
                         Foreground="{Binding DiffColor}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- % -->
        <DataGridTemplateColumn Header="%" Width="82" MinWidth="82" Tag="DiffPct" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding DiffPctText}"
                         Foreground="{Binding DiffColor}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- ASSETS -->
        <DataGridTemplateColumn Header="ASSETS" Width="85" MinWidth="85" Tag="AssetsQty" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding AssetsText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- IND JOBS -->
        <DataGridTemplateColumn Header="IND JOBS" Width="85" MinWidth="85" Tag="IndustryJobs" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding IndustryJobsText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- BUY ORDERS -->
        <DataGridTemplateColumn Header="BUY ORDERS" Width="90" MinWidth="90" Tag="BuyOrders" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding BuyOrdersText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- MARKET PRICE -->
        <DataGridTemplateColumn Header="MKT PRICE" Width="95" MinWidth="95" Tag="MarketPrice" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding MarketPriceText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- BUILD PRICE -->
        <DataGridTemplateColumn Header="BUILD PRICE" Width="95" MinWidth="95" Tag="BuildPrice" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding BuildPriceText}"
                         Foreground="{DynamicResource GoodBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- VOLUME -->
        <DataGridTemplateColumn Header="VOLUME (m³)" Width="90" MinWidth="90" Tag="Volume" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding VolumeText}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
