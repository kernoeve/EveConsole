<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:conv="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.InvLevelView"
             x:DataType="vm:InvLevelViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Resources>
    <conv:NullableDecimalToPositiveIntConverter x:Key="IntConv" />
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,1,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">

        <Button Grid.Column="0"
                Command="{Binding AddGroupCommand}"
                Content="{x:Static loc:AssetsText.AddGroup}"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                Padding="12 4" FontSize="11" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8 0 0 0">
          <Button Command="{Binding AddCollectionCommand}"
                  Content="{x:Static loc:AssetsText.Collection}"
                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                  BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1"
                  Padding="12 4" FontSize="11" />
          <Button Command="{Binding ImportCollectionCommand}"
                  Content="{x:Static loc:AssetsText.ImportCollection}"
                  ToolTip.Tip="{x:Static loc:AssetsText.TipReadACollectionFrom}"
                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                  BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1"
                  Padding="12 4" FontSize="11" Margin="8 0 0 0" />
        </StackPanel>

        <Button Grid.Column="2"
                Command="{Binding RefreshCommand}"
                Content="{x:Static loc:AssetsText.Refresh}"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                Padding="12 4" FontSize="11" Margin="8 0 0 0" />

        <TextBlock Grid.Column="3"
                   Text="{Binding StatusText}"
                   FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="16 0 0 0" />
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtleBrush}" />

    <!-- ── Data grid ─────────────────────────────────────────────────── -->
    <DataGrid Grid.Row="2"
              x:Name="MainGrid"
              ItemsSource="{Binding GridRows}"
              SelectedItem="{Binding SelectedRow}"
              AutoGenerateColumns="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              Sorting="OnGridSorting"
              IsReadOnly="False"
              Classes="tinted"
              Background="{DynamicResource SurfaceBaseBrush}"
              RowBackground="{DynamicResource SurfaceBaseBrush}"
              GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="{DynamicResource SurfaceHoverBrush}"
              HeadersVisibility="Column"
              FontSize="11"
              RowHeight="25"
              BorderThickness="0"
              KeyDown="OnGridKeyDown">

      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{x:Static loc:AssetsText.MenuOpenInItemBrowser}"
                    Command="{Binding OpenInItemBrowserCommand}"
                    IsEnabled="{Binding IsItemRowSelected}" />
          <MenuItem Header="{x:Static loc:MarketText.MenuAddToStandingBuyOrders}"
                    Command="{Binding AddToStandingBuyOrdersCommand}"
                    IsEnabled="{Binding IsItemRowSelected}" />
          <Separator />
          <MenuItem Header="{x:Static loc:AssetsText.MenuAddItemsFromFit}"
                    Command="{Binding AddFromFitCommand}" />
          <MenuItem Header="{x:Static loc:AssetsText.MenuAddItemsFromMarketGroup}"
                    Command="{Binding AddFromMarketGroupCommand}" />
          <MenuItem Header="{x:Static loc:AssetsText.MenuAddItemsFromBlueprint}"
                    Command="{Binding AddFromBlueprintCommand}" />
          <Separator />
          <MenuItem Header="{x:Static loc:AssetsText.MenuDeleteItem}"
                    Command="{Binding DeleteSelectedItemCommand}"
                    IsEnabled="{Binding IsItemRowSelected}" />
        </ContextMenu>
      </DataGrid.ContextMenu>

      <DataGrid.Styles>
        <Style Selector="DataGridColumnHeader">
          <Setter Property="Background"                Value="{DynamicResource SurfacePanelBrush}" />
          <Setter Property="Foreground"                Value="{DynamicResource TextFaintBrush}" />
          <Setter Property="FontSize"                  Value="10" />
          <Setter Property="FontWeight"                Value="SemiBold" />
          <Setter Property="Padding"                   Value="6 6 2 6" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="BorderBrush"               Value="{DynamicResource BorderSubtleBrush}" />
          <Setter Property="BorderThickness"           Value="0 0 1 1" />
        </Style>
        <Style Selector="DataGridCell">
          <Setter Property="Padding"         Value="0" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="ClipToBounds"    Value="False" />
          <Setter Property="FontSize"        Value="11" />
          <Setter Property="MinHeight"       Value="0" />
        </Style>
        <Style Selector="DataGridRow">
          <Setter Property="MinHeight" Value="25" />
          <!-- Per-row tint: base colour for collection/group/item rows, orange/red when an item
               is under target. Bound (not set on LoadingRow) so it updates live as stock changes. -->
          <Setter Property="Background" Value="{Binding RowBackground}" />
        </Style>

        <!-- A header's actions menu: always there, small and quiet, brighter under the pointer. -->
        <Style Selector="Button.rowmenu">
          <Setter Property="Content"         Value="⋯" />
          <Setter Property="Background"      Value="{DynamicResource SurfaceRaisedBrush}" />
          <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius"    Value="3" />
          <Setter Property="Padding"         Value="6 -2 6 1" />
          <Setter Property="MinHeight"       Value="0" />
          <Setter Property="Height"          Value="18" />
          <Setter Property="FontSize"        Value="13" />
          <Setter Property="FontWeight"      Value="Bold" />
          <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}" />
          <Setter Property="Cursor"          Value="Hand" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rowmenu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background"  Value="{DynamicResource SurfaceHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- The bar in the % cell: a track the width of the cell, filled to how much of the
             target is on hand. -->
        <Style Selector="ProgressBar.cover">
          <Setter Property="Minimum"       Value="0" />
          <Setter Property="Maximum"       Value="100" />
          <Setter Property="MinWidth"      Value="0" />
          <Setter Property="MinHeight"     Value="0" />
          <Setter Property="Height"        Value="17" />
          <Setter Property="Margin"        Value="3 0" />
          <Setter Property="CornerRadius"  Value="2" />
          <!-- An outlined, empty track: a filled one sat too close to the dark fills to tell an
               80% bar from a full one. -->
          <Setter Property="Background"      Value="Transparent" />
          <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </DataGrid.Styles>

      <DataGrid.Columns>

        <!-- GROUP / ITEM / COLLECTION -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColGroupItem}" Width="*" MinWidth="360" Tag="TypeName"
                                IsReadOnly="True" ClipboardContentBinding="{Binding CollectionName}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <!-- ⚠️ Clipped to the column: header rows carry totals now, and a long group line
                   (name, multiplier, scope, sources) drawn past the column covered them. -->
              <Canvas x:CompileBindings="False" ClipToBounds="True" Height="25">

                <!-- Collection row: toggle + name + action buttons -->
                <StackPanel IsVisible="{Binding IsCollection}" Orientation="Horizontal" Spacing="6"
                            Canvas.Left="4" Canvas.Top="2">
                  <Button Command="{Binding ToggleCommand}"
                          Content="{Binding ExpanderIcon}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource InfoBrush}" Padding="2 0" FontSize="11"
                          VerticalAlignment="Center" Cursor="Hand" />
                  <TextBlock Text="{Binding CollectionName}"
                             FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                  <!-- One ⋯ for the actions, shown on mouse-over: a row of buttons ran past the column
                       and over the totals. -->
                  <StackPanel VerticalAlignment="Center">
                    <Button Classes="rowmenu" ToolTip.Tip="{x:Static loc:AssetsText.InvTipActions}">
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                          <MenuItem Header="{x:Static loc:AssetsText.TipExpandAllGroups}"   Command="{Binding ExpandAllCommand}" />
                          <MenuItem Header="{x:Static loc:AssetsText.TipCollapseAllGroups}" Command="{Binding CollapseAllCommand}" />
                          <Separator IsVisible="{Binding !IsSynthetic}" />
                          <MenuItem Header="{x:Static loc:AssetsText.Rename}" Command="{Binding RenameCommand}" IsVisible="{Binding !IsSynthetic}" />
                          <MenuItem Header="{x:Static loc:AssetsText.Export}" Command="{Binding ExportCommand}" IsVisible="{Binding !IsSynthetic}"
                                    ToolTip.Tip="{x:Static loc:AssetsText.TipSaveThisCollectionsGroups}" />
                          <MenuItem Header="{x:Static loc:AssetsText.Delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsSynthetic}"
                                    Foreground="{DynamicResource BadBrush}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </StackPanel>

                <!-- Group row: toggle + name + multiplier + action buttons + scope/locality -->
                <StackPanel IsVisible="{Binding IsGroup}" Orientation="Horizontal" Spacing="6"
                            Canvas.Left="20" Canvas.Top="2">
                  <Button Command="{Binding ToggleCommand}"
                          Content="{Binding ExpanderIcon}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextMutedBrush}" Padding="2 0" FontSize="11"
                          VerticalAlignment="Center" Cursor="Hand" />
                  <TextBlock Text="{Binding GroupName}"
                             FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <StackPanel VerticalAlignment="Center">
                    <Button Classes="rowmenu" ToolTip.Tip="{x:Static loc:AssetsText.InvTipActions}">
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                          <MenuItem Header="{x:Static loc:AssetsText.InvMenuAddItem}" Command="{Binding AddItemCommand}" />
                          <MenuItem Header="{x:Static loc:AssetsText.Edit}"           Command="{Binding EditCommand}" />
                          <Separator />
                          <MenuItem Header="{x:Static loc:AssetsText.Delete}"         Command="{Binding DeleteCommand}"
                                    Foreground="{DynamicResource BadBrush}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <TextBlock Text="×" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                             VerticalAlignment="Center" Margin="6 0 0 0" />
                  <NumericUpDown x:CompileBindings="False"
                                 Value="{Binding Multiplier, Converter={StaticResource IntConv}}"
                                 Minimum="1" Maximum="9999"
                                 ShowButtonSpinner="False"
                                 Width="52" Height="20" MinHeight="0" FontSize="11"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                  <!-- ScopeDisplay split so the location name can link while the scope word stays
                       plain. Where it goes depends on the scope: the region, the system, or the
                       station or structure. An "Everywhere" group has no location, so it falls
                       back to the joined string and nothing is clickable. -->
                  <StackPanel Orientation="Horizontal" Spacing="0" Margin="8 0 0 0">
                    <Button Classes="link" Click="OnOpenGroupLocation"
                            IsVisible="{Binding HasLocationLink}"
                            ToolTip.Tip="{x:Static loc:AssetsText.TipOpenThisLocation}">
                      <TextBlock Text="{Binding LocationDisplay}" Classes="linktext"
                                 FontSize="10" Foreground="{DynamicResource InfoBrush}" />
                    </Button>
                    <TextBlock Text="{Binding ScopeDisplay}" IsVisible="{Binding !HasLocationLink}"
                               FontSize="10" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScopeSuffix}" IsVisible="{Binding HasLocationLink}"
                               FontSize="10" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding IncludeSummary}"
                             FontSize="10" Foreground="{DynamicResource InfoBrush}"
                             VerticalAlignment="Center" Margin="4 0 0 0" />
                </StackPanel>

                <!-- Item row. ⚠️ Canvas.Left/Top go on the Button, not the inner TextBlock: the
                     Canvas positions its direct children, and leaving them on the text would
                     stack every item name at the origin. -->
                <Button IsVisible="{Binding IsItem}" Classes="link" Click="OnOpenItem"
                        Canvas.Left="32" Canvas.Top="2"
                        ToolTip.Tip="{x:Static loc:AssetsText.TipOpenInTheItemBrowser}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Sized to the row rather than the source: the image is fetched at 32 and
                         drawn at 18, so it stays sharp on a scaled display. No placeholder while
                         it loads — an empty box that fills in reads worse than a name that gains
                         a picture. -->
                    <Image Source="{Binding Icon}" Width="18" Height="18"
                           VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayName}" Classes="linktext"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Button>
              </Canvas>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- TARGET -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColTarget}" Width="90" MinWidth="90" Tag="TargetQty" IsReadOnly="False" ClipboardContentBinding="{Binding TargetQty, Converter={StaticResource IntConv}}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <NumericUpDown x:CompileBindings="False"
                             IsVisible="{Binding IsItem}"
                             Value="{Binding TargetQty, Converter={StaticResource IntConv}}"
                             Minimum="1" Maximum="999999999"
                             ShowButtonSpinner="False"
                             FontSize="11"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             HorizontalAlignment="Stretch"
                             TextAlignment="Right"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             MinHeight="0" Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- TGT TOTAL (target × multiplier) -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColTgtTotal}" Width="95" MinWidth="95" Tag="TargetTotal" IsReadOnly="True" ClipboardContentBinding="{Binding TargetTotalText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding TargetTotalText}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- AVAIL -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColAvail}" Width="85" MinWidth="85" Tag="Available" IsReadOnly="True" ClipboardContentBinding="{Binding AvailableText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding AvailableText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- DIFF -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColDiff}" Width="80" MinWidth="80" Tag="Diff" IsReadOnly="True" ClipboardContentBinding="{Binding DiffText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding DiffText}"
                         Foreground="{Binding DiffColor}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- % -->
        <!-- The bar: filled to how much of the target is on hand, coloured by how short. An item
             shows its own; a group or collection header shows its items' average and how many
             are short — expanded or folded, it is the header that says whether to look inside. -->
        <DataGridTemplateColumn Header="%" Width="95" MinWidth="90" Tag="DiffPct" IsReadOnly="True" ClipboardContentBinding="{Binding DiffPctText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid x:CompileBindings="False">
                <ProgressBar Classes="cover"
                             IsVisible="{Binding HasCover}"
                             Value="{Binding CoverPct}"
                             Foreground="{Binding CoverBrush}" />
                <TextBlock IsVisible="{Binding IsItem}"
                           Text="{Binding DiffPctText}"
                           Foreground="{Binding DiffColor}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Padding="7 0" />
                <TextBlock IsVisible="{Binding !IsItem}"
                           Text="{Binding ShortText}"
                           Foreground="{Binding ShortBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Padding="7 0" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- ASSETS -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColAssets}" Width="85" MinWidth="85" Tag="AssetsQty" IsReadOnly="True" ClipboardContentBinding="{Binding AssetsText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding AssetsText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- IND JOBS -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColIndJobs}" Width="85" MinWidth="85" Tag="IndustryJobs" IsReadOnly="True" ClipboardContentBinding="{Binding IndustryJobsText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding IndustryJobsText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- BUY ORDERS -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColBuyOrders}" Width="90" MinWidth="90" Tag="BuyOrders" IsReadOnly="True" ClipboardContentBinding="{Binding BuyOrdersText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding BuyOrdersText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- CONTRACTS -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColContracts}" Width="90" MinWidth="90" Tag="Contracts" IsReadOnly="True" ClipboardContentBinding="{Binding ContractsText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding ContractsText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- SELL ORDERS -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColSellOrders}" Width="90" MinWidth="90" Tag="SellOrders" IsReadOnly="True" ClipboardContentBinding="{Binding SellOrdersText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding SellOrdersText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- CONTRACTS SELLING -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColContractsSelling}" Width="90" MinWidth="90" Tag="ContractsSelling" IsReadOnly="True" ClipboardContentBinding="{Binding ContractsSellingText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding ContractsSellingText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- MARKET PRICE -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColMktPrice}" Width="119" MinWidth="119" Tag="MarketPrice" IsReadOnly="True" ClipboardContentBinding="{Binding MarketPriceText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding MarketPriceText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- BUILD PRICE -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColBuildPrice}" Width="119" MinWidth="119" Tag="BuildPrice" IsReadOnly="True" ClipboardContentBinding="{Binding BuildPriceText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding BuildPriceText}"
                         Foreground="{DynamicResource GoodBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- VOLUME -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColVolumeM}" Width="113" MinWidth="113" Tag="Volume" IsReadOnly="True" ClipboardContentBinding="{Binding VolumeText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         IsVisible="{Binding IsItem}"
                         Text="{Binding VolumeText}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- VOLUME - TARGET / AVAIL / DIFF: the unit volume times each, in m³ -->
        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColVolTarget}" Width="145" MinWidth="125" Tag="VolumeTarget" IsReadOnly="True" ClipboardContentBinding="{Binding VolumeTargetText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding VolumeTargetText}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColVolAvail}" Width="145" MinWidth="125" Tag="VolumeAvailable" IsReadOnly="True" ClipboardContentBinding="{Binding VolumeAvailableText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding VolumeAvailableText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:AssetsText.ColVolDiff}" Width="145" MinWidth="125" Tag="VolumeDiff" IsReadOnly="True" ClipboardContentBinding="{Binding VolumeDiffText}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock x:CompileBindings="False"
                         Text="{Binding VolumeDiffText}"
                         Foreground="{Binding DiffColor}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Padding="4 0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
