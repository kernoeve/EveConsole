<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.KillmailBrowserView"
             x:DataType="vm:KillmailBrowserViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <Grid ColumnDefinitions="560,4,*">

    <!-- ── Left pane: filters + list ──────────────────────────────── -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto">

      <!-- Filter bar -->
      <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1"
              Padding="8 6">
        <StackPanel Spacing="5">
          <!-- Character + Corp (any corp, not just tracked ones) + Refresh -->
          <Grid ColumnDefinitions="*,4,*,8,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding FilterChar, Mode=TwoWay}"
                     Watermark="Character…" FontSize="11" Height="22"
                     Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="5 2" />
            <TextBox Grid.Column="2"
                     Text="{Binding FilterCorp, Mode=TwoWay}"
                     Watermark="Corp…" FontSize="11" Height="22"
                     Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="5 2" />
            <Button Grid.Column="4"
                    Content="Refresh" Command="{Binding RefreshCommand}"
                    FontSize="10" Padding="8 2" Height="22"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource GoodBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    VerticalAlignment="Center" />
          </Grid>

          <!-- Date range -->
          <Grid ColumnDefinitions="Auto,*,8,Auto,*">
            <TextBlock Grid.Column="0" Text="From:" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                       VerticalAlignment="Center" Margin="0 0 4 0" />
            <CalendarDatePicker Grid.Column="1"
                                SelectedDate="{Binding FilterFrom, Mode=TwoWay}"
                                FontSize="11" Height="22" />
            <TextBlock Grid.Column="3" Text="Thru:" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                       VerticalAlignment="Center" Margin="0 0 4 0" />
            <CalendarDatePicker Grid.Column="4"
                                SelectedDate="{Binding FilterThru, Mode=TwoWay}"
                                FontSize="11" Height="22" />
          </Grid>

          <!-- Ship/System filters + clear -->
          <Grid ColumnDefinitions="*,4,*,8,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding FilterShip, Mode=TwoWay}"
                     Watermark="Ship…" FontSize="11" Height="22"
                     Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="5 2" />
            <TextBox Grid.Column="2"
                     Text="{Binding FilterSystem, Mode=TwoWay}"
                     Watermark="System/Region…" FontSize="11" Height="22"
                     Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="5 2" />
            <Button Grid.Column="4"
                    Content="Clear" Command="{Binding ClearFiltersCommand}"
                    FontSize="10" Padding="8 2" Height="22"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Kill list (zkillboard style) -->
      <ListBox Grid.Row="1"
               ItemsSource="{Binding KillmailRows}"
               SelectedItem="{Binding SelectedKillmail, Mode=TwoWay}"
               Background="{DynamicResource SurfaceBaseBrush}"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding"     Value="0" />
            <Setter Property="Background"  Value="Transparent" />
            <Setter Property="Cursor"      Value="Hand" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <StaticResource ResourceKey="KillmailRowTemplate" />
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Load more (paged — the underlying table can hold 100K+ rows now) -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0"
              Padding="8 6" IsVisible="{Binding HasMore}">
        <Button Content="Load More"
                Command="{Binding LoadMoreCommand}"
                IsEnabled="{Binding !IsLoadingMore}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                FontSize="11" Padding="8 4"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="3" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0"
              Padding="8 4">
        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusColor}" />
      </Border>

    </Grid>

    <!-- ── Splitter ───────────────────────────────────────────────── -->
    <GridSplitter Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

    <!-- ── Right pane: killmail detail ───────────────────────────── -->
    <Grid Grid.Column="2">

      <!-- Empty state -->
      <TextBlock IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"
                 Text="Select a killmail to view details."
                 FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <!-- Detail panel -->
      <Grid IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
            RowDefinitions="Auto,*">

        <!-- ── Header (full width) ──────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1"
                Padding="12 10">
          <Grid ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0" ColumnDefinitions="64,8,64,8,32,8,*">
              <Image Grid.Column="0"
                     Source="{Binding Detail.ShipRender}"
                     Width="64" Height="64" Stretch="Uniform"
                     VerticalAlignment="Center"
                     ToolTip.Tip="{Binding Detail.ShipName}" />

              <Image Grid.Column="2"
                     Source="{Binding Detail.VictimPortrait}"
                     Width="64" Height="64" Stretch="Uniform"
                     VerticalAlignment="Center"
                     ToolTip.Tip="{Binding Detail.VictimName}" />

              <!-- Corp over alliance, each half the portrait's height -->
              <StackPanel Grid.Column="4" Spacing="0" VerticalAlignment="Center">
                <Image Source="{Binding Detail.VictimCorpLogo}"
                       Width="32" Height="32" Stretch="Uniform"
                       ToolTip.Tip="{Binding Detail.VictimCorp}" />
                <Image Source="{Binding Detail.VictimAllianceLogo}"
                       Width="32" Height="32" Stretch="Uniform"
                       ToolTip.Tip="{Binding Detail.VictimAlliance}" />
              </StackPanel>

              <StackPanel Grid.Column="6" Spacing="2" VerticalAlignment="Center">
                <Button Command="{Binding $parent[UserControl].DataContext.OpenInItemBrowserCommand}"
                        CommandParameter="{Binding Detail.VictimShipTypeId}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Left" Cursor="Hand"
                        ToolTip.Tip="Open in Item Browser">
                  <TextBlock Text="{Binding Detail.ShipName}"
                             FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                             TextDecorations="Underline" />
                </Button>
                <Button Content="{Binding Detail.VictimName}" Command="{Binding Detail.OpenVictimCommand}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Left" Cursor="Hand"
                        FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Content="{Binding Detail.VictimCorp}" Command="{Binding Detail.OpenVictimCorpCommand}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Left" Cursor="Hand"
                        FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                <Button Content="{Binding Detail.VictimAlliance}" Command="{Binding Detail.OpenVictimAllianceCommand}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Left" Cursor="Hand"
                        FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                        IsVisible="{Binding Detail.VictimAlliance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="0" Margin="0 2 0 0">
                  <TextBlock Text="{Binding Detail.TimeText}" FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" />
                  <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" />
                  <Button Command="{Binding $parent[UserControl].DataContext.OpenSystemMapCommand}"
                          CommandParameter="{Binding Detail.SystemId}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalContentAlignment="Left" Cursor="Hand"
                          ToolTip.Tip="Open on the Universe map">
                    <TextBlock Text="{Binding Detail.SystemText}" FontSize="10"
                               Foreground="{DynamicResource TextDimBrush}" TextDecorations="Underline" />
                  </Button>
                </StackPanel>
                <TextBlock Text="{Binding Detail.LocationText}" FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                           IsVisible="{Binding Detail.LocationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
            <!-- ISK summary — every TextBlock right-aligned individually, not just the
                 containing StackPanel, so differing text widths (e.g. "0 ISK") don't
                 leave the actual numbers looking left/center-aligned. -->
            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="16 0 0 0">
              <StackPanel Spacing="1" HorizontalAlignment="Right">
                <TextBlock Text="DESTROYED" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Detail.DestroyedText}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
              </StackPanel>
              <StackPanel Spacing="1" HorizontalAlignment="Right">
                <TextBlock Text="DROPPED" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Detail.DroppedText}" FontSize="12" Foreground="{DynamicResource GoodBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
              </StackPanel>
              <StackPanel Spacing="1" HorizontalAlignment="Right">
                <TextBlock Text="TOTAL" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Detail.TotalIskText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ── Body: items left, attackers right ────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="*,1,220">

          <!-- Items (scrollable) -->
          <ScrollViewer Grid.Column="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Detail.SlotGroups}" Margin="8 8 8 16">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:KillmailSlotGroupVm">
                  <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3"
                          Margin="0 0 0 4">
                    <StackPanel>
                      <Border Background="{DynamicResource SurfacePanelBrush}" Padding="8 3">
                        <TextBlock Text="{Binding GroupName}"
                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" />
                      </Border>
                      <!-- One implicit sub-group (empty name, no sub-header) for every
                           slot except Cargo Hold, which is split by market group so a
                           large cargo/blueprint-library list stays organised. -->
                      <ItemsControl ItemsSource="{Binding SubGroups}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:KillmailSubGroupVm">
                            <StackPanel>
                              <Border Background="{DynamicResource SurfaceHeaderBrush}" Padding="8 2"
                                      IsVisible="{Binding SubGroupName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding SubGroupName}"
                                           FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" />
                              </Border>
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:KillmailItemVm">
                                    <Grid ColumnDefinitions="20,*,72,72,90" Margin="8 2 8 2" MinHeight="20">
                                      <Image Grid.Column="0"
                                             Source="{Binding Icon}"
                                             Width="18" Height="18"
                                             Stretch="Uniform"
                                             VerticalAlignment="Center"
                                             Margin="0 0 2 0" />
                                      <Button Grid.Column="1"
                                              Command="{Binding $parent[UserControl].DataContext.OpenInItemBrowserCommand}"
                                              CommandParameter="{Binding TypeId}"
                                              Background="Transparent" BorderThickness="0" Padding="0"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              Cursor="Hand" ToolTip.Tip="Open in Item Browser">
                                        <TextBlock Text="{Binding TypeName}"
                                                   FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextDecorations="Underline" />
                                      </Button>
                                      <TextBlock Grid.Column="2" Text="{Binding QtyDestroyed}"
                                                 FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Right" />
                                      <TextBlock Grid.Column="3" Text="{Binding QtyDropped}"
                                                 FontSize="10" Foreground="{DynamicResource GoodBrush}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Right" />
                                      <TextBlock Grid.Column="4" Text="{Binding EstValueText}"
                                                 FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Right" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Vertical divider -->
          <Border Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}" />

          <!-- Attackers (scrollable) -->
          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1"
                    Padding="8 4">
              <TextBlock Text="ATTACKERS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" />
            </Border>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Detail.Attackers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:KillmailAttackerVm">
                    <Border BorderBrush="{DynamicResource SurfaceHoverBrush}" BorderThickness="0 0 0 1" Padding="4 4">
                      <Grid ColumnDefinitions="40,24,*,Auto">

                        <!-- Portrait (full row height) -->
                        <Image Grid.Column="0"
                               Source="{Binding Portrait}"
                               Width="40" Height="48"
                               Stretch="UniformToFill"
                               VerticalAlignment="Top"
                               ToolTip.Tip="{Binding CharName}"
                               Margin="0 0 4 0" />

                        <!-- Ship icon (top) + Weapon/drone icon (bottom) -->
                        <Grid Grid.Column="1" RowDefinitions="24,24" Margin="0 0 4 0"
                              VerticalAlignment="Top">
                          <Image Grid.Row="0" Source="{Binding ShipIcon}"
                                 Width="24" Height="24" Stretch="Uniform"
                                 ToolTip.Tip="{Binding ShipName}" />
                          <Image Grid.Row="1" Source="{Binding WeaponIcon}"
                                 Width="24" Height="24" Stretch="Uniform"
                                 ToolTip.Tip="{Binding WeaponName}" />
                        </Grid>

                        <!-- Name / Corp / Alliance / Ship -->
                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Top">
                          <Button Content="{Binding CharName}" Command="{Binding OpenCharCommand}"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  HorizontalContentAlignment="Left" Cursor="Hand"
                                  FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                          <Button Content="{Binding CorpName}" Command="{Binding OpenCorpCommand}"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  HorizontalContentAlignment="Left" Cursor="Hand"
                                  FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                          <Button Content="{Binding AllianceName}" Command="{Binding OpenAllianceCommand}"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  HorizontalContentAlignment="Left" Cursor="Hand"
                                  FontSize="9" Foreground="{DynamicResource TextDimBrush}"
                                  IsVisible="{Binding AllianceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="{Binding ShipName}"
                                     FontSize="9" Foreground="{DynamicResource TextFaintBrush}" FontStyle="Italic"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding ShipName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Role label + damage -->
                        <StackPanel Grid.Column="3" Spacing="2" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="4 0 0 0">
                          <TextBlock Text="{Binding RoleLabel}"
                                     FontSize="9" FontWeight="SemiBold"
                                     Foreground="{Binding RoleColor}"
                                     HorizontalAlignment="Right"
                                     IsVisible="{Binding RoleLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="{Binding DamageText}"
                                     FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                     HorizontalAlignment="Right" />
                        </StackPanel>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

        </Grid>
      </Grid>

      <!-- Loading overlay -->
      <Border IsVisible="{Binding IsLoading}"
              Background="#99000000">
        <TextBlock Text="Loading…" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

    </Grid>
  </Grid>
</UserControl>
