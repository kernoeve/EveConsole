<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EveConsole.Controls"
        x:Class="EveConsole.Views.OrderEditDialog"
        Title="Add Order"
        Width="420" Height="680"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBox, NumericUpDown, ComboBox">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelAltBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" /><Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto" Margin="20">

    <!-- Scrolled, so a field added here can never push Save off the bottom of the window. -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="10" Margin="0 0 4 0">

      <TextBlock Classes="lbl" Text="ITEM TYPE" />
      <TextBlock x:Name="SelectedTypeText" Text="(none selected)" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
      <TextBox x:Name="SearchBox" Watermark="Start typing item name…"
               CornerRadius="3" CaretBrush="{DynamicResource AccentBrush}" Padding="8 5" TextChanged="OnSearchChanged" />
      <Border x:Name="ResultsBox" IsVisible="False"
              Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Height="120">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                   SelectionChanged="OnResultSelected">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10 5" /></Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" /></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Border>

      <Grid ColumnDefinitions="*,12,*">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Classes="lbl" Text="UNITS" />
          <NumericUpDown x:Name="UnitsBox" Value="1" Minimum="1" Maximum="999999999"
                         Increment="1" ShowButtonSpinner="True" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="5">
          <TextBlock Classes="lbl" Text="PURCHASE PRICE (TOTAL)" />
          <NumericUpDown x:Name="PriceBox" Value="0" Minimum="0" Maximum="1000000000000000"
                         Increment="1000000" FormatString="N0" ShowButtonSpinner="False" />
        </StackPanel>
      </Grid>

      <!-- Buyer: a picked character or corporation, same search-and-pick shape as the item type
           above. ⚠️ The typed text is still kept when nothing is picked, so an order for somebody
           the search cannot reach is still recordable — and every order made while this was free
           text keeps its name and shows it here on edit. -->
      <StackPanel Spacing="5">
        <TextBlock Classes="lbl" Text="BUYER" />
        <TextBlock x:Name="SelectedBuyerText" Text="(none selected)" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
        <TextBox x:Name="BuyerBox" Watermark="Start typing a character or corporation…"
                 CornerRadius="3" CaretBrush="{DynamicResource AccentBrush}" Padding="8 5" TextChanged="OnBuyerSearchChanged" />
        <Border x:Name="BuyerResultsBox" IsVisible="False"
                Background="{DynamicResource SurfacePanelBrush}" CornerRadius="3" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Height="110">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="BuyerResultsList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnBuyerSelected">
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10 5" /></Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Classes="lbl" Text="ESTIMATED DATE" />
        <TextBox x:Name="EstDateBox" Watermark="yyyy-MM-dd" Padding="8 5" />
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Classes="lbl" Text="COMPLETED DATE" />
        <TextBox x:Name="CompletedBox" Watermark="yyyy-MM-dd" Padding="8 5" />
        <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                   Text="Set automatically: today when you mark an order completed or cancelled, or the date the linked contract was accepted. Override it here if the real date differs." />
      </StackPanel>

      <CheckBox x:Name="PriorityBox" FontSize="11"
                Content="Priority — put this order and everything it needs at the top"
                ToolTip.Tip="Outranks every other order regardless of estimated date, along with the jobs, purchases and hauls that serve it."/>

      <StackPanel Spacing="5">
        <TextBlock Classes="lbl" Text="CONTRACT" />
        <TextBox x:Name="ContractBox" Watermark="contract id, if the match missed it" Padding="8 5" />
        <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                   Text="Normally filled in automatically. Type an id here when the contract cannot be matched — usually because its item list differs from the order. Clearing it removes the link." />
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Classes="lbl" Text="LABELS" />
        <ctl:LabelsBox x:Name="LabelsField" />
        <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                   Text="Free tags for grouping orders — a corp programme, a customer, a shipment. Type anything; if it does not exist yet, pressing Enter creates it. The Order Tracker can filter on them." />
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Classes="lbl" Text="STATUS" />
        <ComboBox x:Name="StatusBox" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem>Pending</ComboBoxItem>
          <ComboBoxItem>Completed</ComboBoxItem>
          <ComboBoxItem>Canceled</ComboBoxItem>
        </ComboBox>
      </StackPanel>

    </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0 14 0 0">
      <TextBlock Grid.Column="0" x:Name="HintText" Text="Select an item type above."
                 Foreground="{DynamicResource BorderStrongBrush}" FontSize="11" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Cancel" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="14 6" Margin="0 0 8 0" Click="OnCancel" />
      <Button Grid.Column="2" x:Name="OkButton" Content="Save" Background="{DynamicResource SurfaceSelectedBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1" Padding="14 6" IsEnabled="False" Click="OnSave" />
    </Grid>

  </Grid>
</Window>
