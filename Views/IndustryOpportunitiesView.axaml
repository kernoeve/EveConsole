<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveCortex.ViewModels"
             x:Class="EveCortex.Views.IndustryOpportunitiesView"
             x:DataType="vm:IndustryOpportunitiesViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="RowHeight" Value="22" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="4 0 4 0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="10" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- ── Controls bar ─────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="#0d0d12" Padding="12 10"
            BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
     <StackPanel Spacing="10">
      <DockPanel>

        <Button DockPanel.Dock="Right"
                Content="Calculate"
                Command="{Binding CalculateCommand}"
                Padding="18 6"
                Background="#1e1e28"
                Foreground="#c8a84b"
                BorderBrush="#3a3020"
                BorderThickness="1"
                FontSize="12" />

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

          <ComboBox ItemsSource="{Binding ModeOptions}"
                    SelectedItem="{Binding SelectedMode}"
                    Width="220" FontSize="12"
                    Background="#131320" BorderBrush="#2a2a3a" Foreground="#c8a84b">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:IndustryModeOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="Price at" Foreground="#555566" FontSize="11"
                     VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding MarketConfigs}"
                    SelectedItem="{Binding SelectedConfig}"
                    Width="220" FontSize="12"
                    Background="#131320" BorderBrush="#2a2a3a" Foreground="#ccccdd">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:IndustryMarketConfig">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="Min 30d ISK Vol" Foreground="#555566" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding MinIskVolume}" Width="110" FontSize="12"
                   Watermark="No filter"
                   Background="#131320" BorderBrush="#2a2a3a" Foreground="#ccccdd" />

          <TextBlock Text="Min 30d Unit Vol" Foreground="#555566" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding MinUnitVolume}" Width="110" FontSize="12"
                   Watermark="No filter"
                   Background="#131320" BorderBrush="#2a2a3a" Foreground="#ccccdd" />

          <CheckBox IsChecked="{Binding SkipFactionItems}"
                    Content="Skip faction"
                    Foreground="#ccccdd" FontSize="11"
                    VerticalAlignment="Center" />

          <CheckBox IsChecked="{Binding BpoOnly}"
                    Content="BPO only"
                    Foreground="#ccccdd" FontSize="11"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Only items whose blueprint is a buyable BPO, or is invented from one (e.g. T2 from a T1 BPO). Excludes faction/limited-run items built from BPCs with no obtainable BPO, whose contract cost we can't account for." />

        </StackPanel>
      </DockPanel>

      <!-- ── Excluded market groups ─────────────────────────────────────────── -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Exclude Groups" Foreground="#555566" FontSize="11"
                   VerticalAlignment="Center" />

        <ItemsControl ItemsSource="{Binding ExcludedMarketGroups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ExcludedMarketGroupVm">
              <Border Background="#131320" BorderBrush="#2a2a3a" BorderThickness="1"
                      CornerRadius="3" Padding="6 3" Margin="0 0 6 4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Button x:CompileBindings="False"
                          Content="✕"
                          Command="{Binding $parent[UserControl].DataContext.RemoveExcludedGroupCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="#cc6666" FontSize="10" Padding="0"
                          Cursor="Hand" VerticalAlignment="Center"
                          ToolTip.Tip="Remove this exclusion" />
                  <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#ccccdd"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="+ Add Group"
                Command="{Binding AddExcludedGroupCommand}"
                Padding="8 3" FontSize="11"
                Background="#131320" Foreground="#8899cc"
                BorderBrush="#2a2a3a" BorderThickness="1" />
      </StackPanel>

     </StackPanel>
    </Border>

    <!-- ── Status footer ────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom"
            Background="#111117" Padding="12 8"
            BorderBrush="#1c1c28" BorderThickness="0 1 0 0">
      <TextBlock Text="{Binding StatusText}"
                 Foreground="#555566" FontSize="11"
                 VerticalAlignment="Center" />
    </Border>

    <!-- ── Results area ───────────────────────────────────────────────────────── -->
    <Grid>

    <DataGrid x:CompileBindings="False"
              ItemsSource="{Binding Results}"
              DoubleTapped="OnGridDoubleTapped"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              CanUserReorderColumns="False"
              ClipboardCopyMode="None">

      <DataGrid.Columns>

        <DataGridTextColumn Header="Item" Binding="{Binding TypeName}" Width="*"
                            MinWidth="150" />

        <DataGridTemplateColumn Header="Build Cost" Width="110" SortMemberPath="BuildCost">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding BuildCostDisplay}"
                         Foreground="#5b9bd5"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Sell Price" Width="110" SortMemberPath="SellPrice">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SellPriceDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Profit / Unit" Width="110" SortMemberPath="ProfitPerUnit">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ProfitUnitDisplay}"
                         Foreground="#70ad47"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Margin" Width="80" SortMemberPath="Margin">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding MarginDisplay}"
                         Foreground="#c8a84b"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Build Time" Width="100" SortMemberPath="BuildSeconds">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding BuildTimeDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Slot Days" Width="90" SortMemberPath="SlotDays">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SlotDaysDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Profit / Slot Day" Width="130" SortMemberPath="ProfitPerSlotDay">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ProfitPerSlotDayDisplay}"
                         Foreground="#70ad47" FontWeight="SemiBold"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>

    <!-- Calculating overlay — shown while the scan is running -->
    <Border IsVisible="{Binding IsCalculating}"
            Background="#a0000000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="6"
            Padding="36 24">
      <StackPanel HorizontalAlignment="Center" Spacing="14">
        <ProgressBar IsIndeterminate="True"
                     Width="240" Height="3"
                     Foreground="#c8a84b"
                     Background="#333344" />
        <TextBlock Text="Scanning for industry opportunities…"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="#c8a84b"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11" Foreground="#888899"
                   HorizontalAlignment="Center"
                   MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>

    </Grid>

  </DockPanel>

</UserControl>
