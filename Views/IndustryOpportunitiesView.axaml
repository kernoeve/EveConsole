<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.IndustryOpportunitiesView"
             x:DataType="vm:IndustryOpportunitiesViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="RowHeight" Value="22" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="4 0 4 0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- ── Controls bar ─────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceBaseBrush}" Padding="12 10"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
     <StackPanel Spacing="10">
      <DockPanel>

        <Button DockPanel.Dock="Right"
                Content="{x:Static loc:IndustryText.Calculate}"
                Command="{Binding CalculateCommand}"
                Padding="18 6"
                Background="{DynamicResource BorderSubtleBrush}"
                Foreground="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}"
                BorderThickness="1"
                FontSize="12" />

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

          <ComboBox ItemsSource="{Binding ModeOptions}"
                    SelectedItem="{Binding SelectedMode}"
                    Width="220" FontSize="12"
                    Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource AccentBrush}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:IndustryModeOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{x:Static loc:IndustryText.PriceAt}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding MarketConfigs}"
                    SelectedItem="{Binding SelectedConfig}"
                    Width="220" FontSize="12"
                    Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:IndustryMarketConfig">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{x:Static loc:IndustryText.Min30dIskVol}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding MinIskVolume}" Width="110" FontSize="12"
                   Watermark="{x:Static loc:IndustryText.HintNoFilter}"
                   Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />

          <TextBlock Text="{x:Static loc:IndustryText.Min30dUnitVol}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding MinUnitVolume}" Width="110" FontSize="12"
                   Watermark="{x:Static loc:IndustryText.HintNoFilter}"
                   Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />

          <CheckBox IsChecked="{Binding SkipFactionItems}"
                    Content="{x:Static loc:IndustryText.SkipFaction}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                    VerticalAlignment="Center" />

          <CheckBox IsChecked="{Binding BpoOnly}"
                    Content="{x:Static loc:IndustryText.SkipNonBpoTraceableItems}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{x:Static loc:IndustryText.TipOnlyItemsWhoseBlueprint}" />

        </StackPanel>
      </DockPanel>

      <!-- ── Excluded market groups ─────────────────────────────────────────── -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Static loc:IndustryText.ExcludeGroups}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                   VerticalAlignment="Center" />

        <ItemsControl ItemsSource="{Binding ExcludedMarketGroups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ExcludedMarketGroupVm">
              <Border Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                      CornerRadius="3" Padding="6 3" Margin="0 0 6 4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Button x:CompileBindings="False"
                          Content="✕"
                          Command="{Binding $parent[UserControl].DataContext.RemoveExcludedGroupCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource BadBrush}" FontSize="10" Padding="0"
                          Cursor="Hand" VerticalAlignment="Center"
                          ToolTip.Tip="{x:Static loc:IndustryText.TipRemoveThisExclusion}" />
                  <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="{x:Static loc:IndustryText.AddGroup}"
                Command="{Binding AddExcludedGroupCommand}"
                Padding="8 3" FontSize="11"
                Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource InfoBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
      </StackPanel>

      <!-- ── Name filter: narrows the list as typed, no recalculation ───────── -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Static loc:CommonText.ItemNameFilterLabel}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                   VerticalAlignment="Center" />
        <TextBox Text="{Binding NameFilter.Text}" Width="260" FontSize="12"
                 Watermark="{x:Static loc:CommonText.ItemNameFilterHint}"
                 ToolTip.Tip="{x:Static loc:CommonText.TipItemNameFilter}"
                 Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding NameFilter.Shown}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                   VerticalAlignment="Center" />
      </StackPanel>

     </StackPanel>
    </Border>

    <!-- ── Status footer ────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SurfaceInputBrush}" Padding="12 8"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 1 0 0">
      <TextBlock Text="{Binding StatusText}"
                 Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                 VerticalAlignment="Center" />
    </Border>

    <!-- ── Results area ───────────────────────────────────────────────────────── -->
    <Grid>

    <!-- ResultsView, not Results: the sort lives there, so it survives the tab being left. -->
    <DataGrid x:CompileBindings="False"
              ItemsSource="{Binding ResultsView}"
              DoubleTapped="OnGridDoubleTapped"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              CanUserReorderColumns="False"
              ClipboardCopyMode="None">

      <DataGrid.Columns>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColItem}" SortMemberPath="TypeName" Width="*" ClipboardContentBinding="{Binding TypeName}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:IndustryRow">
              <Panel>
                <Button Classes="link" Click="OnOpenRowItem" IsVisible="{Binding HasItemLink}"
                        ToolTip.Tip="{x:Static loc:IndustryText.TipOpenInTheItemBrowser}">
                  <TextBlock Text="{Binding TypeName}" Classes="linktext" FontSize="10"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}" FontSize="10"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColBuildCost}" Width="110" SortMemberPath="BuildCost" ClipboardContentBinding="{Binding BuildCostDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding BuildCostDisplay}"
                         Foreground="{DynamicResource InfoBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColSellPrice}" Width="110" SortMemberPath="SellPrice" ClipboardContentBinding="{Binding SellPriceDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SellPriceDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColProfitUnit}" Width="110" SortMemberPath="ProfitPerUnit" ClipboardContentBinding="{Binding ProfitUnitDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ProfitUnitDisplay}"
                         Foreground="{DynamicResource GoodBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColMargin}" Width="80" SortMemberPath="Margin" ClipboardContentBinding="{Binding MarginDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding MarginDisplay}"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColBuildTime}" Width="100" SortMemberPath="BuildSeconds" ClipboardContentBinding="{Binding BuildTimeDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding BuildTimeDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColSlotDays}" Width="90" SortMemberPath="SlotDays" ClipboardContentBinding="{Binding SlotDaysDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SlotDaysDisplay}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColProfitSlotDay}" Width="130" SortMemberPath="ProfitPerSlotDay" ClipboardContentBinding="{Binding ProfitPerSlotDayDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ProfitPerSlotDayDisplay}"
                         Foreground="{DynamicResource GoodBrush}" FontWeight="SemiBold"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColUnitsSold30d}" Width="105" SortMemberPath="UnitVol30d" ClipboardContentBinding="{Binding UnitVol30dDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding UnitVol30dDisplay}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{x:Static loc:IndustryText.ColIskSold30d}" Width="110" SortMemberPath="IskVol30d" ClipboardContentBinding="{Binding IskVol30dDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding IskVol30dDisplay}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Right" Padding="0 0 8 0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>

    <!-- Calculating overlay — shown while the scan is running -->
    <Border IsVisible="{Binding IsCalculating}"
            Background="#a0000000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="6"
            Padding="36 24">
      <StackPanel HorizontalAlignment="Center" Spacing="14">
        <ProgressBar IsIndeterminate="True"
                     Width="240" Height="3"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource SurfaceRaisedBrush}" />
        <TextBlock Text="{x:Static loc:IndustryText.ScanningForIndustryOpportunities}"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center"
                   MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>

    </Grid>

  </DockPanel>

</UserControl>
