<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveCortex.ViewModels"
             xmlns:m="clr-namespace:EveCortex.Models"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EveCortex.Views.CorpActivityView"
             x:DataType="vm:CorpActivityViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="RowHeight" Value="22" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="4 0 4 0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,1,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#12121a" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="#1e1e2a">
      <Grid ColumnDefinitions="Auto,12,Auto,*,Auto">

        <TextBlock Grid.Column="0" Text="Corporation:" FontSize="11"
                   Foreground="#888899" VerticalAlignment="Center" />

        <ComboBox Grid.Column="2"
                  ItemsSource="{Binding Corps}"
                  SelectedItem="{Binding SelectedCorp}"
                  Width="220" FontSize="11"
                  Background="#1a1a28" Foreground="#c8c8d8"
                  BorderBrush="#2a2a3a" BorderThickness="1">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:Corporation">
              <TextBlock Text="{Binding Name}" FontSize="11" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Column="3"
                   Text="{Binding Status}"
                   FontSize="11" Foreground="#666677"
                   VerticalAlignment="Center" Margin="16 0 0 0" />

        <Button Grid.Column="4"
                Command="{Binding RefreshCommand}"
                Content="Refresh"
                Background="#1a1a28" Foreground="#5599aa"
                BorderBrush="#2a3a44" BorderThickness="1"
                Padding="12 4" FontSize="11" />

      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="#1e1e2a" />

    <!-- ── Content ──────────────────────────────────────────────────── -->
    <TabControl Grid.Row="2"
                SelectedIndex="{Binding SelectedOuterTabIndex}"
                Background="#0d0d12"
                BorderThickness="0">

      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize"    Value="11" />
          <Setter Property="Foreground"  Value="#888899" />
          <Setter Property="Background"  Value="Transparent" />
          <Setter Property="Padding"     Value="14 6" />
        </Style>
        <Style Selector="TabItem:selected">
          <Setter Property="Foreground" Value="#c8a84b" />
        </Style>
      </TabControl.Styles>

      <!-- ══ Activity 24h ═══════════════════════════════════════════ -->
      <TabItem Header="ACTIVITY (24H)">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

          <!-- Summary bar -->
          <Border Grid.Row="0" Background="#12121a" Padding="10 8 10 6"
                  BorderBrush="#1e1e2a" BorderThickness="0 0 0 1">
            <StackPanel Orientation="Horizontal" Spacing="24">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="PLAYERS ACTIVE:" FontSize="10" FontWeight="SemiBold" Foreground="#555566" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Activity24hPlayerCountText}" FontSize="11" Foreground="#c8c8d8" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="INCOME:" FontSize="10" FontWeight="SemiBold" Foreground="#555566" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Activity24hIncomeText}" FontSize="11" Foreground="#6aaa88" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="EXPENSES:" FontSize="10" FontWeight="SemiBold" Foreground="#555566" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Activity24hExpenseText}" FontSize="11" Foreground="#cc7766" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Three activity grids side by side -->
          <Grid Grid.Row="1" ColumnDefinitions="*,1,*,1,*" Height="275">

            <!-- Ratting -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
              <Border Grid.Row="0" Background="#12121a" Padding="8 5 8 4"
                      BorderBrush="#1e1e2a" BorderThickness="0 0 0 1">
                <TextBlock Text="RATTING" FontSize="10" FontWeight="SemiBold" Foreground="#6aaa88"/>
              </Border>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Activity24hRatters}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        Background="#0d0d12" RowBackground="#0d0d12"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                        HeadersVisibility="Column" FontSize="10" BorderThickness="0">
                <DataGrid.Styles>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background"  Value="#12121a" />
                    <Setter Property="Foreground"  Value="#555566" />
                    <Setter Property="FontSize"    Value="10" />
                    <Setter Property="FontWeight"  Value="SemiBold" />
                    <Setter Property="Padding"     Value="4 3 2 3" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="CHARACTER" Binding="{Binding Name}"      Width="*"   />
                  <DataGridTextColumn Header="VALUE"     Binding="{Binding ValueText}" Width="90"  />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

            <Border Grid.Column="1" Background="#1e1e2a"/>

            <!-- Industry -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
              <Border Grid.Row="0" Background="#12121a" Padding="8 5 8 4"
                      BorderBrush="#1e1e2a" BorderThickness="0 0 0 1">
                <TextBlock Text="INDUSTRY" FontSize="10" FontWeight="SemiBold" Foreground="#c8a84b"/>
              </Border>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Activity24hIndustry}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        Background="#0d0d12" RowBackground="#0d0d12"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                        HeadersVisibility="Column" FontSize="10" BorderThickness="0">
                <DataGrid.Styles>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background"  Value="#12121a" />
                    <Setter Property="Foreground"  Value="#555566" />
                    <Setter Property="FontSize"    Value="10" />
                    <Setter Property="FontWeight"  Value="SemiBold" />
                    <Setter Property="Padding"     Value="4 3 2 3" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="CHARACTER" Binding="{Binding Name}"      Width="*"   />
                  <DataGridTextColumn Header="VALUE"     Binding="{Binding ValueText}" Width="90"  />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

            <Border Grid.Column="3" Background="#1e1e2a"/>

            <!-- Mining -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*">
              <Border Grid.Row="0" Background="#12121a" Padding="8 5 8 4"
                      BorderBrush="#1e1e2a" BorderThickness="0 0 0 1">
                <TextBlock Text="MINING" FontSize="10" FontWeight="SemiBold" Foreground="#6688cc"/>
              </Border>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Activity24hMiners}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        Background="#0d0d12" RowBackground="#0d0d12"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                        HeadersVisibility="Column" FontSize="10" BorderThickness="0">
                <DataGrid.Styles>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background"  Value="#12121a" />
                    <Setter Property="Foreground"  Value="#555566" />
                    <Setter Property="FontSize"    Value="10" />
                    <Setter Property="FontWeight"  Value="SemiBold" />
                    <Setter Property="Padding"     Value="4 3 2 3" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="CHARACTER" Binding="{Binding Name}"      Width="*"   />
                  <DataGridTextColumn Header="VALUE"     Binding="{Binding ValueText}" Width="90"  />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

          </Grid>

          <!-- Kills/Losses header -->
          <Border Grid.Row="2" Background="#12121a" Padding="10 6 10 4"
                  BorderBrush="#1e1e2a" BorderThickness="0 1 0 1">
            <TextBlock Text="RECENT KILLS &amp; LOSSES" FontSize="10" FontWeight="SemiBold" Foreground="#cc7766"/>
          </Border>

          <!-- Killmail list (zkillboard style) -->
          <ListBox Grid.Row="3" Name="Kill24hList"
                   ItemsSource="{Binding Activity24hKills}"
                   Background="#0d0d12" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding"    Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor"     Value="Hand" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="#1a1a30" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#141420" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:Activity24hKillRowVm">
                <Border BorderBrush="#1a1a26" BorderThickness="0 0 0 1">
                  <Grid ColumnDefinitions="70,50,*,160,160" Margin="4 4 4 4">

                    <!-- Date / Time / ISK -->
                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Margin="0 0 6 0">
                      <TextBlock Text="{Binding DateText}"
                                 FontSize="10" Foreground="#888899" />
                      <TextBlock Text="{Binding TimeText}"
                                 FontSize="10" Foreground="#c8c8d8" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding TotalIskText}"
                                 FontSize="10" Foreground="#c8a84b"
                                 IsVisible="{Binding TotalIskText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- Ship render -->
                    <Image Grid.Column="1"
                           Source="{Binding ShipRender}"
                           Width="48" Height="48"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding ShipName}"
                           Margin="0 0 6 0" />

                    <!-- System / Constellation / Region -->
                    <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" Margin="0 0 6 0">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{Binding SecurityText}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding SecurityColor}" />
                        <TextBlock Text="{Binding SystemName}"
                                   FontSize="10" Foreground="#c8c8d8" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Text="{Binding ConstellationName}"
                                 FontSize="9" Foreground="#888899"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding ConstellationName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding RegionName}"
                                 FontSize="9" Foreground="#666677"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding RegionName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- Victim: logo + name/corp/alliance -->
                    <Grid Grid.Column="3" ColumnDefinitions="32,*" Margin="0 0 4 0">
                      <Image Grid.Column="0"
                             Source="{Binding VictimLogo}"
                             Width="32" Height="32"
                             Stretch="Uniform"
                             VerticalAlignment="Center"
                             ToolTip.Tip="{Binding VictimAlliance}"
                             Margin="0 0 4 0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VictimName}"
                                   FontSize="10" Foreground="#c8c8d8" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding VictimCorp}"
                                   FontSize="9" Foreground="#888899"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding VictimAlliance}"
                                   FontSize="9" Foreground="#666677"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding VictimAlliance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Grid>

                    <!-- Final blow: logo + name/corp/alliance -->
                    <Grid Grid.Column="4" ColumnDefinitions="32,*">
                      <Image Grid.Column="0"
                             Source="{Binding FbLogo}"
                             Width="32" Height="32"
                             Stretch="Uniform"
                             VerticalAlignment="Center"
                             ToolTip.Tip="{Binding FbAlliance}"
                             Margin="0 0 4 0" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FbName}"
                                   FontSize="10" Foreground="#c8c8d8" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FbCorp}"
                                   FontSize="9" Foreground="#888899"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FbAlliance}"
                                   FontSize="9" Foreground="#666677"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding FbAlliance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Grid>

                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </Grid>
      </TabItem>

      <!-- ══ Monthly Activity ═══════════════════════════════════════ -->
      <TabItem Header="MONTHLY ACTIVITY">
        <Grid RowDefinitions="*,Auto,240,Auto,240" Margin="0">

          <!-- Activity grid -->
          <DataGrid Grid.Row="0"
                    ItemsSource="{Binding MonthlyActivityRows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    Background="#0d0d12"
                    RowBackground="#0d0d12"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#1a1a26"
                    HeadersVisibility="Column"
                    FontSize="10"
                    CanUserSortColumns="True"
                    BorderThickness="0">
            <DataGrid.Styles>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="Background"  Value="#12121a" />
                <Setter Property="Foreground"  Value="#555566" />
                <Setter Property="FontSize"    Value="10" />
                <Setter Property="FontWeight"  Value="SemiBold" />
                <Setter Property="Padding"     Value="4 3 2 3" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="MONTH"         Binding="{Binding Month}"            Width="90"  />
              <DataGridTextColumn Header="TOTAL INCOME"  Binding="{Binding TotalIncomeText}"  SortMemberPath="TotalIncomeRaw"   Width="110" />
              <DataGridTextColumn Header="TOTAL EXPENSE" Binding="{Binding TotalExpenseText}" SortMemberPath="TotalExpenseRaw"  Width="120" />
              <DataGridTextColumn Header="RATTING TAX"   Binding="{Binding RattingTaxText}"   SortMemberPath="RattingTaxRaw"    Width="105" />
              <DataGridTextColumn Header="INDUSTRY TAX"  Binding="{Binding IndustryTaxText}"  SortMemberPath="IndustryTaxRaw"   Width="105" />
              <DataGridTextColumn Header="PROJ PAYOUTS"  Binding="{Binding ProjPayoutsText}"  SortMemberPath="ProjPayoutsRaw"   Width="110" />
              <DataGridTextColumn Header="UNITS MINED"   Binding="{Binding UnitsMinedText}"   SortMemberPath="UnitsMinedRaw"    Width="100" />
              <DataGridTextColumn Header="KILLS"          Binding="{Binding KillsText}"         SortMemberPath="KillsRaw"         Width="65"  />
              <DataGridTextColumn Header="LOSSES"         Binding="{Binding LossesText}"        SortMemberPath="LossesRaw"        Width="65"  />
              <DataGridTextColumn Header="PLAYERS ACTIVE" Binding="{Binding PlayersActiveText}" SortMemberPath="PlayersActiveRaw" Width="110" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- ISK trends header -->
          <Border Grid.Row="1" Background="#12121a" Padding="10 6 10 4"
                  BorderBrush="#1e1e2a" BorderThickness="0 1 0 0">
            <TextBlock Text="ISK TRENDS (billions)"
                       FontSize="10" FontWeight="SemiBold" Foreground="#6aaa88" />
          </Border>

          <!-- ISK line chart -->
          <lvc:CartesianChart Grid.Row="2"
                              Series="{Binding MonthlyIskSeries}"
                              XAxes="{Binding MonthlyXAxes}"
                              YAxes="{Binding MonthlyIskYAxes}"
                              LegendPosition="Top"
                              TooltipPosition="Top"
                              EasingFunction="{x:Null}"
                              Background="Transparent"
                              Margin="4 0 4 4" />

          <!-- Count trends header -->
          <Border Grid.Row="3" Background="#12121a" Padding="10 6 10 4"
                  BorderBrush="#1e1e2a" BorderThickness="0 1 0 0">
            <TextBlock Text="ACTIVITY TRENDS (kills/losses — left axis; units mined — right axis)"
                       FontSize="10" FontWeight="SemiBold" Foreground="#c8a84b" />
          </Border>

          <!-- Activity count line chart (YAxes[0]=kills/losses, YAxes[1]=units mined) -->
          <lvc:CartesianChart Grid.Row="4"
                              Series="{Binding MonthlyCountSeries}"
                              XAxes="{Binding MonthlyXAxes}"
                              YAxes="{Binding MonthlyCountAndMineYAxes}"
                              LegendPosition="Top"
                              TooltipPosition="Top"
                              EasingFunction="{x:Null}"
                              Background="Transparent"
                              Margin="4 0 4 4" />

        </Grid>
      </TabItem>

      <!-- ══ Income ══════════════════════════════════════════════════ -->
      <TabItem Header="INCOME">
        <Grid RowDefinitions="Auto,*">

          <!-- Period picker (shared) -->
          <Border Grid.Row="0" Background="#12121a" Padding="10 6 10 4"
                  BorderBrush="#1e1e2a" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
              <TextBlock Grid.Column="0" Text="INCOME BY TYPE"
                         FontSize="10" FontWeight="SemiBold" Foreground="#6aaa88"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Period:" FontSize="10" Foreground="#555566"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding TaxPeriods}"
                        SelectedItem="{Binding SelectedIncomePeriod}"
                        MinWidth="120" FontSize="11"
                        Background="#1a1a28" Foreground="#c8c8d8"
                        BorderBrush="#2a2a3a" BorderThickness="1" />
            </Grid>
          </Border>

          <!-- Inner Summary / Detail tabs -->
          <TabControl Grid.Row="1">
            <TabControl.Styles>
              <Style Selector="TabItem">
                <Setter Property="FontSize"   Value="10" />
                <Setter Property="Foreground" Value="#666677" />
                <Setter Property="Padding"    Value="12 5" />
              </Style>
              <Style Selector="TabItem:selected">
                <Setter Property="Foreground" Value="#8899cc" />
              </Style>
            </TabControl.Styles>

            <TabItem Header="SUMMARY">
              <Grid RowDefinitions="*,Auto,300">
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding IncomeTypeRows}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#0d0d12" RowBackground="#0d0d12"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                          HeadersVisibility="Column" FontSize="10"
                          CanUserSortColumns="True" BorderThickness="0">
                  <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                      <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                      <Setter Property="FontSize"   Value="10" /><Setter Property="FontWeight"  Value="SemiBold" />
                      <Setter Property="Padding"    Value="4 3 2 3" />
                    </Style>
                  </DataGrid.Styles>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="TYPE"   Binding="{Binding TypeName}"   Width="*" />
                    <DataGridTextColumn Header="COUNT"  Binding="{Binding CountText}"  Width="75" />
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" SortMemberPath="AmountRaw" Width="120" />
                  </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#12121a" Padding="10 6 10 4"
                        BorderBrush="#1e1e2a" BorderThickness="0 1 0 0">
                  <TextBlock Text="INCOME BY TYPE" FontSize="10" FontWeight="SemiBold" Foreground="#6aaa88" />
                </Border>
                <lvc:CartesianChart Grid.Row="2"
                                    Series="{Binding IncomeSeries}" XAxes="{Binding IncomeXAxes}" YAxes="{Binding IncomeYAxes}"
                                    TooltipPosition="Top" EasingFunction="{x:Null}" Background="Transparent" Margin="4 0 4 4" />
              </Grid>
            </TabItem>

            <TabItem Header="DETAIL">
              <DataGrid ItemsSource="{Binding IncomeDetailRows}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        Background="#0d0d12" RowBackground="#0d0d12"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                        HeadersVisibility="Column" FontSize="10"
                        CanUserSortColumns="True" BorderThickness="0">
                <DataGrid.Styles>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                    <Setter Property="FontSize"   Value="10" /><Setter Property="FontWeight"  Value="SemiBold" />
                    <Setter Property="Padding"    Value="4 3 2 3" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="DATE"   Binding="{Binding DateText}"   Width="90"  />
                  <DataGridTextColumn Header="TIME"   Binding="{Binding TimeText}"   Width="60"  />
                  <DataGridTextColumn Header="TYPE"   Binding="{Binding TypeName}"   Width="160" />
                  <DataGridTextColumn Header="NAME"   Binding="{Binding Name}"       Width="*"   />
                  <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" Width="110" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>

        </Grid>
      </TabItem>

      <!-- ══ Expense ══════════════════════════════════════════════════ -->
      <TabItem Header="EXPENSE">
        <Grid RowDefinitions="Auto,*" Margin="0">

          <!-- Period picker (shared) -->
          <Border Grid.Row="0" Background="#12121a" Padding="10 6 10 4"
                  BorderBrush="#1e1e2a" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
              <TextBlock Grid.Column="0" Text="EXPENSES BY TYPE"
                         FontSize="10" FontWeight="SemiBold" Foreground="#cc7766"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Period:" FontSize="10" Foreground="#555566"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding TaxPeriods}"
                        SelectedItem="{Binding SelectedExpensePeriod}"
                        MinWidth="120" FontSize="11"
                        Background="#1a1a28" Foreground="#c8c8d8"
                        BorderBrush="#2a2a3a" BorderThickness="1" />
            </Grid>
          </Border>

          <!-- Inner Summary / Detail tabs -->
          <TabControl Grid.Row="1">
            <TabControl.Styles>
              <Style Selector="TabItem">
                <Setter Property="FontSize"   Value="10" />
                <Setter Property="Foreground" Value="#666677" />
                <Setter Property="Padding"    Value="12 5" />
              </Style>
              <Style Selector="TabItem:selected">
                <Setter Property="Foreground" Value="#8899cc" />
              </Style>
            </TabControl.Styles>

            <TabItem Header="SUMMARY">
              <Grid RowDefinitions="*,Auto,300">
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding ExpenseTypeRows}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#0d0d12" RowBackground="#0d0d12"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                          HeadersVisibility="Column" FontSize="10"
                          CanUserSortColumns="True" BorderThickness="0">
                  <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                      <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                      <Setter Property="FontSize"   Value="10" /><Setter Property="FontWeight"  Value="SemiBold" />
                      <Setter Property="Padding"    Value="4 3 2 3" />
                    </Style>
                  </DataGrid.Styles>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="TYPE"   Binding="{Binding TypeName}"   Width="*" />
                    <DataGridTextColumn Header="COUNT"  Binding="{Binding CountText}"  Width="75" />
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" SortMemberPath="AmountRaw" Width="120" />
                  </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#12121a" Padding="10 6 10 4"
                        BorderBrush="#1e1e2a" BorderThickness="0 1 0 0">
                  <TextBlock Text="EXPENSES BY TYPE" FontSize="10" FontWeight="SemiBold" Foreground="#cc7766" />
                </Border>
                <lvc:CartesianChart Grid.Row="2"
                                    Series="{Binding ExpenseSeries}" XAxes="{Binding ExpenseXAxes}" YAxes="{Binding ExpenseYAxes}"
                                    TooltipPosition="Top" EasingFunction="{x:Null}" Background="Transparent" Margin="4 0 4 4" />
              </Grid>
            </TabItem>

            <TabItem Header="DETAIL">
              <DataGrid ItemsSource="{Binding ExpenseDetailRows}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        Background="#0d0d12" RowBackground="#0d0d12"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                        HeadersVisibility="Column" FontSize="10"
                        CanUserSortColumns="True" BorderThickness="0">
                <DataGrid.Styles>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                    <Setter Property="FontSize"   Value="10" /><Setter Property="FontWeight"  Value="SemiBold" />
                    <Setter Property="Padding"    Value="4 3 2 3" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="DATE"   Binding="{Binding DateText}"   Width="90"  />
                  <DataGridTextColumn Header="TIME"   Binding="{Binding TimeText}"   Width="60"  />
                  <DataGridTextColumn Header="TYPE"   Binding="{Binding TypeName}"   Width="160" />
                  <DataGridTextColumn Header="NAME"   Binding="{Binding Name}"       Width="*"   />
                  <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" Width="110" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>

        </Grid>
      </TabItem>

      <!-- ══ Ratting Taxes ════════════════════════════════════════════ -->
      <TabItem Header="RATTING TAXES">
        <Grid RowDefinitions="Auto,*" Margin="0">

          <!-- Period picker (shared) -->
          <Border Grid.Row="0" Background="#12121a" Padding="10 6 10 4"
                  BorderBrush="#1e1e2a" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
              <TextBlock Grid.Column="0" Text="RATTING TAX"
                         FontSize="10" FontWeight="SemiBold" Foreground="#6aaa88"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Period:" FontSize="10" Foreground="#555566"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding TaxPeriods}"
                        SelectedItem="{Binding SelectedRattingPeriod}"
                        MinWidth="120" FontSize="11"
                        Background="#1a1a28" Foreground="#c8c8d8"
                        BorderBrush="#2a2a3a" BorderThickness="1" />
            </Grid>
          </Border>

          <!-- Inner Summary / Detail tabs -->
          <TabControl Grid.Row="1">
            <TabControl.Styles>
              <Style Selector="TabItem">
                <Setter Property="FontSize"   Value="10" />
                <Setter Property="Foreground" Value="#666677" />
                <Setter Property="Padding"    Value="12 5" />
              </Style>
              <Style Selector="TabItem:selected">
                <Setter Property="Foreground" Value="#8899cc" />
              </Style>
            </TabControl.Styles>

            <TabItem Header="SUMMARY">
              <Grid RowDefinitions="*,Auto,230">
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding RattingTaxRows}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#0d0d12" RowBackground="#0d0d12"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                          HeadersVisibility="Column" FontSize="10" BorderThickness="0">
                  <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                      <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                      <Setter Property="FontSize"   Value="10" /><Setter Property="FontWeight"  Value="SemiBold" />
                      <Setter Property="Padding"    Value="4 3 2 3" />
                    </Style>
                  </DataGrid.Styles>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#"      Binding="{Binding Rank}"   Width="40"  />
                    <DataGridTextColumn Header="NAME"   Binding="{Binding Name}"   Width="*"   />
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#12121a" Padding="10 6 10 4"
                        BorderBrush="#1e1e2a" BorderThickness="0 1 0 0">
                  <TextBlock Text="DAILY RATTING TAX" FontSize="10" FontWeight="SemiBold" Foreground="#6aaa88" />
                </Border>
                <lvc:CartesianChart Grid.Row="2"
                                    Series="{Binding RattingDailySeries}" XAxes="{Binding RattingDailyXAxes}" YAxes="{Binding RattingDailyYAxes}"
                                    LegendPosition="Top" TooltipPosition="Top" EasingFunction="{x:Null}" Background="Transparent" Margin="4 0 4 4" />
              </Grid>
            </TabItem>

            <TabItem Header="DETAIL">
              <DataGrid ItemsSource="{Binding RattingDetailRows}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        Background="#0d0d12" RowBackground="#0d0d12"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1a1a26"
                        HeadersVisibility="Column" FontSize="10"
                        CanUserSortColumns="True" BorderThickness="0">
                <DataGrid.Styles>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                    <Setter Property="FontSize"   Value="10" /><Setter Property="FontWeight"  Value="SemiBold" />
                    <Setter Property="Padding"    Value="4 3 2 3" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="DATE"   Binding="{Binding DateText}"   Width="90"  />
                  <DataGridTextColumn Header="TIME"   Binding="{Binding TimeText}"   Width="60"  />
                  <DataGridTextColumn Header="TYPE"   Binding="{Binding TypeName}"   Width="160" />
                  <DataGridTextColumn Header="NAME"   Binding="{Binding Name}"       Width="*"   />
                  <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" Width="110" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>

        </Grid>
      </TabItem>

      <!-- ══ Industry Taxes ════════════════════════════════════════════ -->
