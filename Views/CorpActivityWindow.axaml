<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveCortex.Views"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.CorpActivityWindow"
        x:DataType="vm:CorpActivityViewModel"
        Title="Corp Activity"
        Width="1400" Height="900"
        MinWidth="1000" MinHeight="600"
        Background="#0d0d12">
  <views:CorpActivityView DataContext="{Binding}" />
</Window>
