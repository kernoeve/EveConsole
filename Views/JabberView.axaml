<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:jab="clr-namespace:EveConsole.Services.Jabber"
             x:Class="EveConsole.Views.JabberView"
             x:DataType="vm:JabberViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="Ellipse.dot"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Fill" Value="{DynamicResource TextFaintBrush}" /></Style>
    <Style Selector="Ellipse.dot.green"><Setter Property="Fill" Value="{DynamicResource GoodBrush}" /></Style>
    <Style Selector="Ellipse.dot.amber"><Setter Property="Fill" Value="{DynamicResource WarnBrush}" /></Style>
    <Style Selector="Ellipse.dot.red"><Setter Property="Fill" Value="{DynamicResource BadBrush}" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0 8 0 3" /></Style>
    <Style Selector="TextBlock.note"><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="FontSize" Value="10" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0 3 0 0" /></Style>
    <Style Selector="TextBox"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Button"><Setter Property="FontSize" Value="12" /></Style>
    <!-- Plain lists: a chat is not a stack of selectable cards. -->
    <Style Selector="ListBox#MessageList ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#MessageList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#MessageList ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#Rows ListBoxItem"><Setter Property="Padding" Value="8 3" /><Setter Property="MinHeight" Value="0" /></Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="270,4,*">

    <!-- ── Servers, rooms and people ─────────────────────────────────── -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Background="{DynamicResource SurfacePanelBrush}">
      <Button Grid.Row="0" Content="{x:Static loc:JabberText.AddServer}" Command="{Binding AddAccountCommand}" Margin="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

      <ListBox x:Name="Rows" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:JabberRowVm">
            <Grid>
              <TextBlock IsVisible="{Binding IsHeading}" Text="{Binding ShownText}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" Margin="2 6 0 0" />

              <Grid IsVisible="{Binding !IsHeading}" ColumnDefinitions="14,*,Auto">
                <Ellipse Grid.Column="0" Classes="dot" Classes.green="{Binding DotGreen}" Classes.amber="{Binding DotAmber}" Classes.red="{Binding DotRed}"
                         IsVisible="{Binding HasDot}" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" Orientation="Vertical">
                  <TextBlock Text="{Binding ShownText}" FontSize="12" TextTrimming="CharacterEllipsis"
                             FontWeight="{Binding IsAccount, Converter={x:Static vm:JabberBold.Convert}}"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding ShownDetail}" IsVisible="{Binding HasDetail}" FontSize="10" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFaintBrush}" ToolTip.Tip="{Binding ShownDetail}" />
                </StackPanel>
                <Border Grid.Column="2" IsVisible="{Binding HasUnread}" CornerRadius="8" Padding="6 0" Margin="6 0 0 0" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceSelectedBrush}" Classes.alert="{Binding ShownAlert}">
                  <TextBlock Text="{Binding UnreadText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="2" Margin="8" Spacing="4">
        <CheckBox IsChecked="{Binding SoundOn}" FontSize="11" Content="{x:Static loc:JabberText.SoundOption}" />
        <TextBlock Classes="label" Text="{x:Static loc:JabberText.HistoryDays}" TextWrapping="Wrap" />
        <NumericUpDown Value="{Binding HistoryDays}" Minimum="0" Maximum="36500" Increment="1" FormatString="0" FontSize="11" HorizontalAlignment="Left" Width="120" />
      </StackPanel>
    </Grid>

    <GridSplitter Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" />

    <!-- ── The pane on the right ─────────────────────────────────────── -->
    <Grid Grid.Column="2" RowDefinitions="*,Auto">

      <!-- Nothing set up yet -->
      <StackPanel Grid.Row="0" IsVisible="{Binding ShowWelcome}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="420">
        <TextBlock Text="{x:Static loc:JabberText.Welcome}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        <Button Content="{x:Static loc:JabberText.AddServer}" Command="{Binding AddAccountCommand}" HorizontalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Row="0" IsVisible="{Binding ShowNothing}" Text="{x:Static loc:JabberText.PickSomething}"
                 VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />

      <!-- The account editor -->
      <ScrollViewer Grid.Row="0" IsVisible="{Binding IsEditingAccount}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20 14" MaxWidth="520" HorizontalAlignment="Left" Width="520">
          <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelName}" />
          <TextBox Text="{Binding EditName}" />
          <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelAddress}" />
          <TextBox Text="{Binding EditAddress}" />
          <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelPassword}" />
          <TextBox Text="{Binding EditPassword}" PasswordChar="●" />
          <TextBlock Classes="note" Text="{x:Static loc:JabberText.PasswordKeep}" IsVisible="{Binding EditIsExisting}" />
          <TextBlock Classes="note" Text="{Binding PasswordNote}" />
          <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelHost}" />
          <TextBox Text="{Binding EditHost}" />
          <TextBlock Classes="note" Text="{x:Static loc:JabberText.HostNote}" />
          <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelPort}" />
          <NumericUpDown Value="{Binding EditPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" Width="130" HorizontalAlignment="Left" />
          <CheckBox IsChecked="{Binding EditDirectTls}" Content="{x:Static loc:JabberText.LabelDirectTls}" Margin="0 8 0 0" />
          <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelNickname}" />
          <TextBox Text="{Binding EditNickname}" />
          <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelResource}" />
          <TextBox Text="{Binding EditResource}" />
          <CheckBox IsChecked="{Binding EditAutoConnect}" Content="{x:Static loc:JabberText.LabelAutoConnect}" Margin="0 10 0 0" />
          <TextBlock Classes="note" Text="{x:Static loc:JabberText.AutoConnectNote}" />
          <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelAlertWords}" />
          <TextBox Text="{Binding EditAlertWords}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 14 0 0">
            <Button Content="{x:Static loc:JabberText.Save}" Command="{Binding SaveAccountCommand}" />
            <Button Content="{x:Static loc:JabberText.Cancel}" Command="{Binding CancelEditCommand}" />
            <Button Content="{x:Static loc:JabberText.Delete}" Command="{Binding DeleteAccountCommand}" IsVisible="{Binding EditIsExisting}" Margin="24 0 0 0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- A server -->
      <ScrollViewer Grid.Row="0" IsVisible="{Binding ShowAccount}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20 14" Spacing="6" MaxWidth="620" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
          <TextBlock Text="{Binding AccountState}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0 6 0 0" />
          <TextBlock Classes="note" Text="{Binding AccountDetail}" />

          <Border IsVisible="{Binding HasCertificateProblem}" Background="{DynamicResource WarnSurfaceBrush}" CornerRadius="4" Padding="10" Margin="0 6">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CertificateText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
              <Button Content="{x:Static loc:JabberText.TrustCertificate}" Command="{Binding TrustCertificateCommand}" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 6">
            <Button Content="{x:Static loc:JabberText.Connect}" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" />
            <Button Content="{x:Static loc:JabberText.Disconnect}" Command="{Binding DisconnectCommand}" IsVisible="{Binding !CanConnect}" />
            <Button Content="{x:Static loc:JabberText.Edit}" Command="{Binding EditAccountCommand}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsConnected}" Spacing="6">
            <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelStatus}" />
            <ComboBox ItemsSource="{Binding ShowChoices}" SelectedItem="{Binding ChosenShow}" Width="240">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JabberShowChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 8 0 0">
              <Button Content="{x:Static loc:JabberText.JoinRoom}" Command="{Binding BeginJoinCommand}" />
              <Button Content="{x:Static loc:JabberText.AddContact}" Command="{Binding BeginAddContactCommand}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsJoining}" Margin="0 8 0 0">
              <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelRoom}" />
              <TextBox Text="{Binding JoinRoom}" />
              <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelNickname}" />
              <TextBox Text="{Binding JoinNick}" />
              <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelPassword}" />
              <TextBox Text="{Binding JoinPassword}" PasswordChar="●" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 10 0 0">
                <Button Content="{x:Static loc:JabberText.Join}" Command="{Binding JoinRoomCommand}" />
                <Button Content="{x:Static loc:JabberText.BrowseRooms}" Command="{Binding BrowseRoomsCommand}" />
                <Button Content="{x:Static loc:JabberText.Cancel}" Command="{Binding CancelJoinCommand}" />
              </StackPanel>
              <ListBox ItemsSource="{Binding BrowsedRooms}" SelectedItem="{Binding BrowsedRoom}" MaxHeight="240" Margin="0 8 0 0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="jab:XmppRoomInfo">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12" />
                      <TextBlock Text="{Binding Jid}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsAddingContact}" Margin="0 8 0 0">
              <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelAddressOnly}" />
              <TextBox Text="{Binding ContactAddress}" />
              <TextBlock Classes="label" Text="{x:Static loc:JabberText.LabelName}" />
              <TextBox Text="{Binding ContactName}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 10 0 0">
                <Button Content="{x:Static loc:JabberText.Add}" Command="{Binding AddContactCommand}" />
                <Button Content="{x:Static loc:JabberText.Cancel}" Command="{Binding CancelAddContactCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Someone asking to be a contact -->
      <StackPanel Grid.Row="0" IsVisible="{Binding ShowRequest}" Margin="20 14" Spacing="8">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMutedBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static loc:JabberText.Accept}" Command="{Binding AcceptRequestCommand}" />
          <Button Content="{x:Static loc:JabberText.Decline}" Command="{Binding DenyRequestCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- A conversation -->
      <Grid Grid.Row="0" IsVisible="{Binding ShowConversation}" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="14 8" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowOccupants}">
                <TextBlock Text="{x:Static loc:JabberText.LabelRoomAlert}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                <ComboBox ItemsSource="{Binding AlertChoices}" SelectedItem="{Binding ChosenAlert}" FontSize="11" Width="230">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:JabberAlertChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{x:Static loc:JabberText.LeaveRoom}" Command="{Binding LeaveRoomCommand}" />
              </StackPanel>
              <Button Content="{x:Static loc:JabberText.RemoveContact}" Command="{Binding RemoveContactCommand}" IsVisible="{Binding IsContactOpen}" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">
          <Button Grid.Row="0" Content="{x:Static loc:JabberText.LoadEarlier}" Command="{Binding LoadEarlierCommand}" IsVisible="{Binding HasEarlier}"
                  HorizontalAlignment="Center" Margin="0 6" FontSize="11" />
          <!-- A ListBox, not an ItemsControl in a scroller: long histories must stay virtualized. -->
          <ListBox x:Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}" Background="Transparent" SelectionMode="Single"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:JabberMessageVm">
                <StackPanel Margin="14 4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Sender}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource InfoBrush}" Classes.me="{Binding IsOutgoing}" />
                    <TextBlock Text="{Binding When}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Classes="link" Content="{Binding}" Click="OnOpenLink" Padding="0" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InfoBrush}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Who is in the room -->
        <ListBox Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowOccupants}" ItemsSource="{Binding Occupants}" Width="180" Background="{DynamicResource SurfacePanelBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:JabberOccupantVm">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Classes="dot" Classes.green="{Binding DotGreen}" Classes.amber="{Binding DotAmber}" Classes.red="{Binding DotRed}" />
                <TextBlock Text="{Binding Nick}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="{Binding Role}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
          <TextBlock Text="{Binding TypingText}" IsVisible="{Binding IsSomeoneTyping}" FontSize="11" Margin="14 2 14 0" Foreground="{DynamicResource TextFaintBrush}" />
          <Grid ColumnDefinitions="*,Auto" Margin="10 6">
            <TextBox x:Name="DraftBox" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                     Watermark="{x:Static loc:JabberText.MessageHint}" />
            <Button Grid.Column="1" Content="{x:Static loc:JabberText.Send}" Command="{Binding SendCommand}" Margin="8 0 0 0" VerticalAlignment="Bottom" />
          </Grid>
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="1" IsVisible="{Binding HasStatus}" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11" Margin="14 4"
                 Foreground="{DynamicResource BadBrush}" />
    </Grid>
  </Grid>
</UserControl>
