<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveCortex.Views.AddItemDialog"
        Title="Add Item"
        Width="400" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d12">

  <Grid RowDefinitions="*,Auto" Margin="20">

    <StackPanel Grid.Row="0" Spacing="14">

      <TextBlock Text="SEARCH FOR ITEM" FontSize="10" FontWeight="SemiBold"
                 Foreground="#555566" LetterSpacing="1" />

      <TextBox x:Name="SearchBox"
               Watermark="Start typing item name…"
               Background="#1a1a28" BorderBrush="#2a2a3a" BorderThickness="1"
               CornerRadius="3" Foreground="#e8e8f0" CaretBrush="#c8a84b"
               FontSize="12" Padding="8 5"
               TextChanged="OnSearchChanged" />

      <Border Background="#12121a" CornerRadius="3"
              BorderBrush="#1e1e2a" BorderThickness="1" Height="200">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ListBox x:Name="ResultsList"
                   Background="Transparent" BorderThickness="0"
                   SelectionChanged="OnResultSelected">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10 6" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="#1a2030" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#c8c8d8" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Border>

      <StackPanel Spacing="5">
        <TextBlock Text="TARGET QUANTITY" FontSize="10" FontWeight="SemiBold"
                   Foreground="#555566" LetterSpacing="1" />
        <NumericUpDown x:Name="QtyBox"
                       Value="1" Minimum="1" Maximum="999999"
                       Increment="1" ShowButtonSpinner="True"
                       Width="140" FontSize="12"
                       Background="#131320" BorderBrush="#2a2a3a"
                       Foreground="#c8c8d8" />
      </StackPanel>

    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0 12 0 0">
      <TextBlock Grid.Column="0" x:Name="HintText"
                 Text="Select an item from the list above."
                 Foreground="#444455" FontSize="11"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Cancel"
              Background="#1a1a28" Foreground="#888899"
              BorderBrush="#2a2a3a" BorderThickness="1"
              Padding="14 6" Margin="0 0 8 0"
              Click="OnCancelClick" />
      <Button Grid.Column="2" x:Name="OkButton"
              Content="Add"
              Background="#1a2030" Foreground="#c8a84b"
              BorderBrush="#3a3020" BorderThickness="1"
              Padding="14 6" IsEnabled="False"
              Click="OnOkClick" />
    </Grid>

  </Grid>
</Window>
