<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveCortex.Views"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.ItemBrowserWindow"
        x:DataType="vm:ItemBrowserViewModel"
        Title="Item Browser"
        Width="1000" Height="680"
        MinWidth="720" MinHeight="480"
        Background="#0d0d12">
  <views:ItemBrowserView DataContext="{Binding}" />
</Window>
