<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="using:EveConsole.Views"
             x:Class="EveConsole.Views.MessagesView"
             x:DataType="vm:MessagesViewModel">

  <UserControl.Styles>
    <Style Selector="Ellipse.dot"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="Fill" Value="{DynamicResource TextFaintBrush}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Ellipse.dot.green"><Setter Property="Fill" Value="{DynamicResource GoodBrush}" /></Style>
    <Style Selector="Ellipse.dot.amber"><Setter Property="Fill" Value="{DynamicResource WarnBrush}" /></Style>
    <Style Selector="ListBox#TabList"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#TabList ListBoxItem"><Setter Property="Padding" Value="10 5" /><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector="ListBox#ConversationList ListBoxItem"><Setter Property="Padding" Value="8 5" /><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector="ListBox#PeopleList ListBoxItem"><Setter Property="Padding" Value="8 5" /><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector="ListBox.lines ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox.lines ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox.lines ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Border.count"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="6 0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Background" Value="{DynamicResource WarnBrush}" /></Style>
    <Style Selector="Border.count TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource SurfaceBaseBrush}" /></Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*">

    <!-- ── Every saved conversation ──────────────────────────────────────── -->
    <Grid Grid.Column="0" Width="290" RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowList}" Background="{DynamicResource SurfacePanelBrush}">
      <StackPanel Grid.Row="0" Margin="8" Spacing="6">
        <StackPanel Spacing="6" IsVisible="{Binding ShowSaved}">
          <Button Content="{x:Static loc:MessagesText.NewConversation}" Command="{Binding NewConversationCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" />
          <TextBlock Text="{x:Static loc:MessagesText.AllConversations}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox Text="{Binding Search}" Watermark="{x:Static loc:MessagesText.SearchHint}" FontSize="11" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsFinding}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Static loc:MessagesText.NewConversation}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Grid.Column="1" Content="{x:Static loc:JabberText.Cancel}" Command="{Binding CancelNewConversationCommand}" FontSize="11" />
          </Grid>
          <TextBox x:Name="FindBox" Text="{Binding FindWords}" Watermark="{x:Static loc:MessagesText.FindHint}" FontSize="11" />
          <TextBlock Text="{Binding FindNote}" IsVisible="{Binding HasFindNote}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
        </StackPanel>
      </StackPanel>

      <!-- Who is online now, on everything connected. -->
      <ListBox x:Name="PeopleList" Grid.Row="1" IsVisible="{Binding IsFinding}" ItemsSource="{Binding People}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MessagesPersonVm">
            <Grid ColumnDefinitions="14,*" Background="Transparent" Tapped="OnPersonTapped">
              <Ellipse Classes="dot" Classes.green="{Binding DotGreen}" Classes.amber="{Binding DotAmber}" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Where}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="{Binding Where}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="1" IsVisible="{Binding ShowNoSaved}" Text="{x:Static loc:MessagesText.NoConversations}" TextWrapping="Wrap" Margin="12" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
      <ListBox x:Name="ConversationList" Grid.Row="1" IsVisible="{Binding ShowSaved}" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MessagesConversationVm">
            <Grid ColumnDefinitions="14,*,Auto">
              <Ellipse Classes="dot" Classes.green="{Binding DotGreen}" Classes.amber="{Binding DotAmber}" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Where}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="{Binding Where}" />
                <TextBlock Text="{Binding LastText}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFaintBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="6 0 0 0" Spacing="3">
                <TextBlock Text="{Binding LastAt}" FontSize="9" HorizontalAlignment="Right" Foreground="{DynamicResource TextFaintBrush}" />
                <Border Classes="count" IsVisible="{Binding HasUnread}" HorizontalAlignment="Right"><TextBlock Text="{Binding UnreadText}" /></Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <CheckBox Grid.Row="2" IsChecked="{Binding SoundOn}" Margin="8" FontSize="11" Content="{x:Static loc:MessagesText.SoundOption}" />
    </Grid>

    <!-- ── The conversations open, a tab each ────────────────────────────── -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Background="{DynamicResource SurfaceHeaderBrush}">
        <Button Content="{x:Static loc:MessagesText.ToggleList}" Command="{Binding ToggleListCommand}" Margin="6 4" FontSize="11" VerticalAlignment="Center" />
        <ListBox x:Name="TabList" Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessagesTabVm">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Classes="dot" Classes.green="{Binding DotGreen}" Classes.amber="{Binding DotAmber}" />
                <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="{Binding Where}" />
                <Border Classes="count" IsVisible="{Binding HasUnread}"><TextBlock Text="{Binding UnreadText}" /></Border>
                <Button Content="×" Click="OnCloseTab" Padding="4 0" FontSize="13" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:MessagesText.CloseTab}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <TextBlock Grid.Row="1" IsVisible="{Binding ShowNothingOpen}" Text="{x:Static loc:MessagesText.NothingOpen}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />

      <!-- One conversation, the same whichever service it is on. -->
      <!-- ⚠️ Shown from outside: on the grid itself, this would be asked of the tab, not of the tool, and always show. -->
      <Panel Grid.Row="1" IsVisible="{Binding HasTab}">
      <Grid DataContext="{Binding SelectedTab}" x:DataType="vm:MessagesTabVm" RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Padding="14 8" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding Where}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding StatusLine}" IsVisible="{Binding HasStatusLine}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFaintBrush}" ToolTip.Tip="{Binding StatusLine}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="{x:Static loc:JabberText.AddContact}" Command="{Binding AddContactCommand}" IsVisible="{Binding CanAddContact}" />
              <Button Content="{x:Static loc:JabberText.RemoveContact}" Command="{Binding RemoveContactCommand}" IsVisible="{Binding CanRemoveContact}" />
            </StackPanel>
          </Grid>
        </Border>

        <Button Grid.Row="1" Content="{x:Static loc:JabberText.LoadEarlier}" Command="{Binding LoadEarlierCommand}" IsVisible="{Binding HasEarlier}" HorizontalAlignment="Center" Margin="0 6" FontSize="11" />

        <!-- A ListBox, not an ItemsControl in a scroller: long histories must stay virtualized. -->
        <ListBox x:Name="LineList" Classes="lines" Grid.Row="2" ItemsSource="{Binding Lines}" Background="Transparent" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessagesLineVm">
              <StackPanel Margin="14 4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Sender}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" />
                  <TextBlock Text="{Binding When}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
                <views:EmoteTextBlock Body="{Binding Body}" Emotes="{Binding Emotes}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Content="{Binding}" Click="OnOpenLink" Padding="0" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InfoBrush}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3">
          <TextBlock Text="{Binding TypingText}" IsVisible="{Binding IsSomeoneTyping}" FontSize="11" Margin="14 2 14 0" Foreground="{DynamicResource TextFaintBrush}" />
          <TextBlock Text="{Binding SendingFile}" IsVisible="{Binding IsSendingFile}" FontSize="11" Margin="14 2 14 0" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" FontSize="11" Margin="14 2 14 0" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding CannotSend}" IsVisible="{Binding HasCannotSend}" TextWrapping="Wrap" FontSize="11" Margin="14 2 14 0" Foreground="{DynamicResource WarnBrush}" />
          <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" FontSize="11" Margin="14 2 14 0" Foreground="{DynamicResource BadBrush}" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="10 6">
            <TextBox x:Name="DraftBox" Text="{Binding Draft}" IsEnabled="{Binding CanSend}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" Watermark="{x:Static loc:JabberText.MessageHint}" />
            <views:EmoteButton x:Name="EmoteBox" Grid.Column="1" Emotes="{Binding Emotes}" IsEnabled="{Binding CanSend}" Margin="4 0 0 0" VerticalAlignment="Bottom" />
            <Button Grid.Column="2" Content="{x:Static loc:JabberText.AttachFile}" Click="OnAttach" IsVisible="{Binding CanAttach}" IsEnabled="{Binding !IsSendingFile}" ToolTip.Tip="{x:Static loc:JabberText.AttachTip}" Margin="8 0 0 0" VerticalAlignment="Bottom" />
            <Button Grid.Column="3" Content="{x:Static loc:JabberText.Send}" Command="{Binding SendCommand}" Margin="8 0 0 0" VerticalAlignment="Bottom" />
          </Grid>
        </StackPanel>
      </Grid>
      </Panel>
    </Grid>
  </Grid>
</UserControl>
