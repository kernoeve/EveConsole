<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.PanelIntelLineContent"
             x:DataType="vm:PanelIntelVm">
  <UserControl.Styles>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    </Style>
    <!-- Fresh news within five jumps lights the line up. A look only: sound is the alarms' job. -->
    <Style Selector="Border.chip.fresh">
      <Setter Property="Background" Value="{DynamicResource BadSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background"      Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding"         Value="4 2" />
      <Setter Property="MinHeight"       Value="0" />
      <Setter Property="Cursor"          Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- The character, then the nearest live threat to them, then how many more; clicked, the full
       list drops down. The two icons are buttons, so clicking them doesn't drop it. -->
  <DockPanel LastChildFill="True" Background="Transparent">
    <TextBlock DockPanel.Dock="Left" Text="{Binding LineName}" FontSize="11" FontWeight="SemiBold" Margin="0 0 10 0"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"
               Foreground="{DynamicResource TextBrightBrush}" />
    <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding OpenToolCommand}" IsVisible="{Binding CanOpenTool}"
            ToolTip.Tip="{x:Static loc:IntelText.TipOpenTool}">
      <Path Data="M7 1h4v4M11 1L5.5 6.5M9 7v4H1V3h4" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" Width="12" Height="12" />
    </Button>
    <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding PasteCommand}" IsVisible="{Binding CanPaste}"
            ToolTip.Tip="{x:Static loc:IntelText.TipPaste}">
      <Path Data="M4,1 H10 A1,1 0 0 1 11,2 V9 A1,1 0 0 1 10,10 H4 A1,1 0 0 1 3,9 V2 A1,1 0 0 1 4,1 Z M1,3 V11 A1,1 0 0 0 2,12 H8"
            Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" Width="12" Height="13" />
    </Button>
    <!-- Drawn, not a ▾ character: not every font has one. -->
    <Path DockPanel.Dock="Right" Data="M0,0 L8,0 L4,5 Z" Width="8" Height="5" Margin="8 0 4 0" VerticalAlignment="Center"
          Fill="{DynamicResource TextMutedBrush}" />

    <Panel ClipToBounds="True">
      <TextBlock Text="{Binding LineEmptyText}" IsVisible="{Binding !HasNearest}" FontSize="11" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
      <!-- The nearest system, in the same form as the list's line; then how many more. -->
      <DockPanel LastChildFill="True" IsVisible="{Binding HasNearest}">
        <TextBlock DockPanel.Dock="Right" Text="{Binding MoreShort}" IsVisible="{Binding HasMore}" FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="8 0 0 0" ToolTip.Tip="{Binding MoreText}" Background="Transparent"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <Border Classes="chip" Classes.fresh="{Binding IsFresh}" BorderThickness="1"
                CornerRadius="3" Padding="0 0 4 0" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Grid ColumnDefinitions="3,*" DataContext="{Binding Nearest}" x:DataType="vm:IntelSystemLineVm">
            <Border Width="3" Background="{Binding TierBrush}" Margin="0 1" />
            <views:IntelSystemLine Grid.Column="1" Margin="4 0 0 0" />
          </Grid>
        </Border>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
