<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.PanelMumbleControl">
  <UserControl.Styles>
    <StyleInclude Source="avares://EveConsole/Views/MumbleStyles.axaml" />
  </UserControl.Styles>

  <!-- One server's Mumble control. Both modes start with the same line; the list mode adds the
       channel under it. -->
  <Grid x:Name="Layout" RowDefinitions="Auto,*">
    <!-- The line: the same bar as the toolbar's, or the server's state while it isn't connected.
         In the single line mode, who is talking shows in a window of its own next to this one
         (PanelTalkPopup). -->
    <!-- ⚠️ Left, not centred: the talk window opens from the control's left edge and must line up with it. -->
    <StackPanel x:Name="Line" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
      <!-- Connect, or disconnect (also stops trying to reconnect): the server's power, from here. -->
      <Button x:Name="Power" Classes="icon" IsVisible="False" Click="OnPower">
        <Path x:Name="PowerIcon" Data="M6 1v5M3.3 3a4 4 0 1 0 5.4 0" StrokeThickness="1.3" Width="12" Height="12"
              Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
      </Button>
      <Panel VerticalAlignment="Center">
        <views:MumbleServerBar x:Name="Bar" ShowsWhere="True" ShowsConnected="True" IsVisible="False" VerticalAlignment="Center" />
        <TextBlock x:Name="LineState" FontSize="11" VerticalAlignment="Center" Margin="4 0"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDimBrush}" />
      </Panel>
    </StackPanel>

    <!-- List: everyone in the channel, the current and recent talkers floating to the top. -->
    <ScrollViewer x:Name="ListMode" Grid.Row="1" IsVisible="False" Margin="6 4" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ListUsers">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MumbleOverlayLine">
            <!-- Right-click: the same person menu as the channel tree's. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 1" Background="Transparent" ContextRequested="OnPersonMenu">
              <Ellipse Classes="talker" Classes.channel="{Binding TalksChannel}" Classes.shout="{Binding TalksShout}" Classes.direct="{Binding TalksDirect}" Width="8" Height="8" VerticalAlignment="Center" />
              <views:AvatarView Of="{Binding Avatar}" Size="18" VerticalAlignment="Center" />
              <TextBlock Classes="talker" Classes.channel="{Binding TalksChannel}" Classes.shout="{Binding TalksShout}" Classes.direct="{Binding TalksDirect}" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
              <Path Classes="state" IsVisible="{Binding IsMuted}" Data="M6 1a2 2 0 0 0-2 2v3a2 2 0 0 0 4 0V3a2 2 0 0 0-2-2zM3 6a3 3 0 0 0 6 0M6 9v2M4 11h4M1.5 1.5l9 9" ToolTip.Tip="{x:Static loc:MumbleText.FlagMuted}" />
              <Path Classes="state" IsVisible="{Binding IsDeaf}" Data="M2 7V6a4 4 0 0 1 8 0v1M2 7v2a1 1 0 0 0 2 0V7a1 1 0 0 0-2 0zM10 7v2a1 1 0 0 1-2 0V7a1 1 0 0 1 2 0zM1.5 1.5l9 9" ToolTip.Tip="{x:Static loc:MumbleText.FlagDeaf}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
