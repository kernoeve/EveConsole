<!-- An IRC channel's settings (modes) and its lists, for an operator. Only what the server says it has is offered. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.IrcChannelSettingsWindow"
        x:DataType="vm:IrcChannelSettingsVm"
        Title="{Binding Title}"
        Width="560" Height="580" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.note"><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="FontSize" Value="11" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0 10 0 3" /></Style>
    <Style Selector="TextBox, Button, CheckBox"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8 3" /></Style>
  </Window.Styles>

  <Window.Resources>
    <!-- One list: who is on it and who put them there, taken off a line at a time; a mask added below. -->
    <DataTemplate x:Key="ModeList" x:DataType="vm:IrcModeListVm">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="note" Text="{Binding Note}" Margin="0 0 0 6" />
        <Panel Grid.Row="1">
          <ListBox ItemsSource="{Binding Entries}" Background="{DynamicResource SurfacePanelBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:IrcModeListEntryVm">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Text="{Binding Mask}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding SetBy}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="8 0" />
                  <Button Grid.Column="2" Content="{x:Static loc:IrcText.ModeListRemove}" Click="OnRemoveEntry" FontSize="11" Padding="8 2" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{x:Static loc:IrcText.ModeListLoading}" IsVisible="{Binding IsLoading}" Margin="10" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{x:Static loc:IrcText.ModeListEmpty}" IsVisible="{Binding IsEmpty}" Margin="10" Foreground="{DynamicResource TextMutedBrush}" />
        </Panel>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0 8 0 0">
          <TextBox Text="{Binding NewMask}" Watermark="{x:Static loc:IrcText.ModeListMaskHint}" MinHeight="26" Padding="6 3" />
          <Button Grid.Column="1" Content="{x:Static loc:IrcText.ModeListAdd}" Click="OnAddEntry" IsEnabled="{Binding CanAdd}" Margin="6 0 0 0" />
        </Grid>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16 12 16 12">
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Classes="note" Text="{x:Static loc:IrcText.ChannelSettingsNote}" />
      <TextBlock Classes="note" Text="{x:Static loc:IrcText.ChannelSettingsNotRead}" IsVisible="{Binding NotKnown}" Foreground="{DynamicResource WarnBrush}" />
    </StackPanel>

    <TabControl x:Name="Tabs" Grid.Row="1" Margin="0 8 0 0" Padding="0 6 0 0" SelectionChanged="OnTabChanged">
      <!-- ── On-or-off settings, settings with a value, the key ──────────── -->
      <TabItem Header="{x:Static loc:IrcText.ChannelSettingsTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0 0 10 8">
            <ItemsControl ItemsSource="{Binding Flags}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IrcModeFlagVm">
                  <CheckBox IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Tip}" Margin="0 1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Text="{Binding Letter, StringFormat='+{0}'}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Values}" IsVisible="{Binding HasValues}" Margin="0 8 0 0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IrcModeValueVm">
                  <Grid ColumnDefinitions="*,140" Margin="0 2">
                    <CheckBox IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Tip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Text="{Binding Letter, StringFormat='+{0}'}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                    </CheckBox>
                    <TextBox Grid.Column="1" Text="{Binding Value}" IsEnabled="{Binding IsOn}" MinHeight="26" Padding="6 3" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding HasKeyMode}" Margin="0 10 0 0" Spacing="4">
              <Grid ColumnDefinitions="*,200">
                <CheckBox IsChecked="{Binding KeyOn}" ToolTip.Tip="{x:Static loc:IrcText.ModeKeyTip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Static loc:IrcText.ModeKey}" />
                    <TextBlock Text="+k" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </CheckBox>
                <TextBox Grid.Column="1" Text="{Binding NewKey}" IsEnabled="{Binding KeyOn}" PasswordChar="•" RevealPassword="{Binding #ShowKey.IsChecked}"
                         Watermark="{x:Static loc:IrcText.ModeKeyHint}" MinHeight="26" Padding="6 3" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="note" Text="{Binding KeyNote}" />
                <CheckBox x:Name="ShowKey" Grid.Column="1" Content="{x:Static loc:IrcText.ModeKeyShow}" FontSize="11" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static loc:IrcText.ModeListBans}" IsVisible="{Binding HasBans}" Tag="b">
        <ContentControl Content="{Binding Bans}" ContentTemplate="{StaticResource ModeList}" />
      </TabItem>
      <TabItem Header="{x:Static loc:IrcText.ModeListExceptions}" IsVisible="{Binding HasExceptions}" Tag="e">
        <ContentControl Content="{Binding Exceptions}" ContentTemplate="{StaticResource ModeList}" />
      </TabItem>
      <TabItem Header="{x:Static loc:IrcText.ModeListInvites}" IsVisible="{Binding HasInviteExceptions}" Tag="I">
        <ContentControl Content="{Binding InviteExceptions}" ContentTemplate="{StaticResource ModeList}" />
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0 10 0 0">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource WarnBrush}" />
      <Button Grid.Column="1" Content="{x:Static loc:IrcText.ChannelSettingsSave}" Click="OnSave" IsEnabled="{Binding !IsBusy}" Classes="accent" Margin="8 0 0 0" />
      <Button Grid.Column="2" Content="{x:Static loc:IrcText.ChannelSettingsClose}" Click="OnClose" Margin="8 0 0 0" />
    </Grid>
  </Grid>

</Window>
