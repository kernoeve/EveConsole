<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveConsole.Views"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.TradeOpportunitiesWindow"
        x:DataType="vm:TradeOpportunitiesViewModel"
        Title="Trade Opportunities"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        Background="#0d0d12">
  <views:TradeOpportunitiesView DataContext="{Binding}" />
</Window>
