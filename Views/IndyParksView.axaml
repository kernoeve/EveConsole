<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:services="clr-namespace:EveConsole.Services"
             x:Class="EveConsole.Views.IndyParksView"
             x:DataType="vm:IndyParksViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="220,1,*">

    <!-- ── Left: park list ──────────────────────────────────────────────── -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*" Background="{DynamicResource SurfaceBaseBrush}">

      <!-- Toolbar -->
      <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="10 8" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="INDY PARKS" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" Margin="2 0 0 4" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Command="{Binding AddParkCommand}"
                    Content="+ New Park"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                    Padding="10 4" FontSize="11" />
            <Button Click="OnImportClick"
                    Content="Import"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="10 4" FontSize="11" />
            <Button Command="{Binding DeleteParkCommand}"
                    Content="Delete"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource BadBrush}"
                    BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1"
                    Padding="10 4" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Park list -->
      <ListBox Grid.Row="1"
               ItemsSource="{Binding Parks}"
               SelectedItem="{Binding SelectedPark}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12 8" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IndyParkListItem">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="★" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                         IsVisible="{Binding IsDefault}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- Divider -->
    <Rectangle Grid.Column="1" Fill="{DynamicResource BorderSubtleBrush}" />

    <!-- ── Right: park detail ────────────────────────────────────────────── -->
    <Grid Grid.Column="2">

      <!-- No park selected -->
      <TextBlock IsVisible="{Binding SelectedPark, Converter={x:Static ObjectConverters.IsNull}}"
                 Text="Create or select an Indy Park from the list."
                 Foreground="{DynamicResource TextFaintBrush}" FontSize="13"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <!-- Park detail.
           The park name and the structures toolbar sit outside the scroller. Add Structure is the
           button you reach for while looking at the bottom of a long park, and scrolling to the top
           to press it and back down again to see the result was most of the trip. -->
      <Grid IsVisible="{Binding SelectedPark, Converter={x:Static ObjectConverters.IsNotNull}}"
            RowDefinitions="Auto,*" Margin="24 20">
        <StackPanel Grid.Row="0" Spacing="20">

          <!-- Park name + export -->
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="PARK NAME" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Command="{Binding SetDefaultParkCommand}"
                        Content="★ Set Default"
                        Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                        Padding="10 4" FontSize="11" />
                <Button Click="OnExportClick"
                        Content="Export Park"
                        Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="10 4" FontSize="11" />
              </StackPanel>
            </Grid>
            <TextBox Text="{Binding ParkName}"
                     Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                     CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="14" Padding="10 6" MaxWidth="400"
                     HorizontalAlignment="Left" />
          </StackPanel>

          <!-- Structures toolbar. Pinned; the list itself is in the scroller below. -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="STRUCTURES" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" VerticalAlignment="Center" />

              <!-- Bulk add. Building a park a row at a time is the slow part of setting one up,
                   and the real fitting arrives with the link, so rigs need no retyping. -->
              <AutoCompleteBox Grid.Row="0" Grid.Column="2" Width="170" Margin="0 0 6 0"
                               Text="{Binding BulkSystemText}"
                               SelectedItem="{Binding BulkSystem}"
                               AsyncPopulator="{Binding SystemPopulator}"
                               FilterMode="None" MinimumPrefixLength="2"
                               MinimumPopulateDelay="0:0:0.35" MaxDropDownHeight="300"
                               FontSize="11" Watermark="System…" />
              <CheckBox Grid.Row="0" Grid.Column="3" Content="Skip moon refineries" Margin="0 0 6 0"
                        IsChecked="{Binding SkipMoonRefineries}" FontSize="11"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Athanors and Tataras anchored to a moon are usually moon mining, not industry" />
              <Button Grid.Row="0" Grid.Column="4" Command="{Binding AddAllInSystemCommand}"
                      Content="+ Add Missing In System" Margin="0 0 6 0"
                      ToolTip.Tip="Adds the industrial structures in that system this park does not already have. Structures already linked here are counted and left alone, so pressing it again after adding one by hand creates no duplicates."
                      Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                      BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                      Padding="10 4" FontSize="11" />
              <Button Grid.Row="0" Grid.Column="5" Command="{Binding AddStructureCommand}"
                      Content="+ Add Structure"
                      Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                      BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                      Padding="10 4" FontSize="11" />

              <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Text="{Binding BulkStatus}"
                         FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0 6 0 0"
                         IsVisible="{Binding BulkStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0 14 0 0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="28">

            <ItemsControl x:CompileBindings="False" ItemsSource="{Binding Structures}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StructureVm">
                  <Border Background="{DynamicResource SurfacePanelBrush}" CornerRadius="4" Padding="14 12"
                          Margin="0 0 0 8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                      <!-- Row 0: Name + Type + Default + Remove button -->
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 0 0 10">
                        <TextBox Grid.Column="0" Text="{Binding DisplayName}"
                                 Watermark="Structure name…"
                                 Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                 CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                 FontSize="13" FontWeight="SemiBold" Padding="8 4" />
                        <ComboBox Grid.Column="1"
                                  SelectedItem="{Binding StructureTypeLabel}"
                                  ItemsSource="{x:Static vm:IndyParksViewModel.StructureTypeLabels}"
                                  MinWidth="120" Margin="8 0 0 0" FontSize="12"
                                  Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsDefaultFacility}"
                                  Content="Default" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                  VerticalAlignment="Center" Margin="10 0 0 0"
                                  ToolTip.Tip="Catch-all facility. Items no category assignment covers are planned here with no rig bonus, so the calculation completes instead of failing. Only one facility per park." />
                        <Button Grid.Column="3" x:CompileBindings="False"
                                Command="{Binding $parent[UserControl].DataContext.RemoveStructureCommand}"
                                CommandParameter="{Binding}"
                                Content="✕" Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                                BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1"
                                Padding="6 4" Margin="8 0 0 0" FontSize="11" />
                      </Grid>

                      <!-- Row 1: System + Security -->
                      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0 0 0 10">
                        <TextBox Grid.Column="0" Text="{Binding SystemName}"
                                 Watermark="Solar system…"
                                 Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                 CornerRadius="3" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                 FontSize="12" Padding="8 4" />
                        <ComboBox Grid.Column="1"
                                  SelectedItem="{Binding SecurityLabel}"
                                  ItemsSource="{x:Static vm:IndyParksViewModel.SecurityLabels}"
                                  MinWidth="110" Margin="8 0 0 0" FontSize="12"
                                  Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </Grid>

                      <!-- Row 2: Tax percentage -->
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6"
                                  Margin="0 0 0 10" VerticalAlignment="Center">
                        <TextBlock Text="Tax Percentage:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center" />
                        <NumericUpDown x:CompileBindings="False"
                                       Value="{Binding FacilityTax}"
                                       Minimum="0" Maximum="100" Increment="0.1"
                                       FormatString="{}{0:0.##}"
                                       MinWidth="80" FontSize="12"
                                       Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="%" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center" />
                      </StackPanel>

                      <!-- Row 3: Link to the real in-game facility.
                           Set by hand — nothing is inferred. Industry jobs running at
                           the linked facility are checked against the rigs below. -->
                      <StackPanel Grid.Row="3" Spacing="4" Margin="0 0 0 10">
                        <TextBlock Text="ACTUAL FACILITY" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BorderStrongBrush}" LetterSpacing="1" />

                        <Grid ColumnDefinitions="*,Auto">
                          <!-- Linked: the name opens the facility. Unlinked: FacilityLinkText is
                               the "not linked" hint, which is not a place and stays plain text. -->
                          <Panel Grid.Column="0">
                            <Button Classes="link" Click="OnOpenFacility"
                                    IsVisible="{Binding HasFacilityLink}"
                                    ToolTip.Tip="Open this station or structure">
                              <TextBlock Text="{Binding FacilityLinkText}" Classes="linktext"
                                         FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                         TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding FacilityLinkText}"
                                       IsVisible="{Binding !HasFacilityLink}"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </Panel>
                          <Button Grid.Column="1" x:CompileBindings="False"
                                  Command="{Binding $parent[UserControl].DataContext.UnlinkFacilityCommand}"
                                  CommandParameter="{Binding}"
                                  Content="Unlink" FontSize="10" Padding="8 2" Margin="8 0 0 0"
                                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                  IsVisible="{Binding RealStructureId, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Grid.Column="0" Text="{Binding FacilitySearch}"
                                   Watermark="Search station or structure to link…"
                                   Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                   CornerRadius="3" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                   FontSize="11" Padding="8 4" />
                          <Button Grid.Column="1" x:CompileBindings="False"
                                  Command="{Binding $parent[UserControl].DataContext.SearchFacilityCommand}"
                                  CommandParameter="{Binding}"
                                  Content="Search" FontSize="10" Padding="10 3" Margin="8 0 0 0"
                                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
                        </Grid>

                        <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="3" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" MaxHeight="120"
                                IsVisible="{Binding FacilityResults.Count}">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FacilityResults}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:SdeStationResult">
                                  <Button x:CompileBindings="False"
                                          Command="{Binding $parent[UserControl].DataContext.LinkFacilityCommand}"
                                          CommandParameter="{Binding}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Background="Transparent" BorderThickness="0" Padding="8 3">
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Border>
                      </StackPanel>

                      <!-- Row 4: Rig slots -->
                      <StackPanel Grid.Row="4" Spacing="6">
                        <TextBlock Text="RIGS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BorderStrongBrush}" LetterSpacing="1" />
                        <ItemsControl ItemsSource="{Binding RigSlots}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RigSlotVm">
                              <Grid ColumnDefinitions="Auto,Auto,*" Margin="0 3">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SlotIndex, StringFormat='Slot {0}:'}"
                                           FontSize="11" Foreground="{DynamicResource BorderStrongBrush}"
                                           VerticalAlignment="Center" MinWidth="48" />
                                <!-- The fitted rig's icon, and the only way into the Item Browser
                                     for it: the name itself lives inside the ComboBox, where it
                                     is a selection rather than something you can click through.
                                     Collapses to nothing on an empty slot. -->
                                <Button Grid.Column="1" Classes="link" Click="OnOpenRig"
                                        IsVisible="{Binding HasRig}" Margin="0 0 4 0"
                                        ToolTip.Tip="Open in the Item Browser">
                                  <Image Source="{Binding Icon}" Width="20" Height="20"
                                         Stretch="Uniform" VerticalAlignment="Center" />
                                </Button>
                                <!-- Locked when the game reports this structure's fitting: an
                                     edit here would be reverted by the next sweep. -->
                                <ComboBox Grid.Column="2" x:CompileBindings="False"
                                          IsEnabled="{Binding $parent[ItemsControl].DataContext.FittingEditable}"
                                          ItemsSource="{Binding AvailableRigs}"
                                          SelectedItem="{Binding Selected}"
                                          PlaceholderText="— empty —"
                                          FontSize="11"
                                          Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextSecondaryBrush}">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SdeRigOption">
                                      <TextBlock Text="{Binding Name}" FontSize="11" />
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Row 5: Service modules.
                           A list rather than slots: a structure has several service slots but
                           which one holds what changes nothing, so there is no slot to show. -->
                      <StackPanel Grid.Row="5" Spacing="6" Margin="0 10 0 0">
                        <TextBlock Text="SERVICE MODULES" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BorderStrongBrush}" LetterSpacing="1" />

                        <ItemsControl ItemsSource="{Binding Services}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceModuleVm">
                              <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                                <Panel Grid.Column="0">
                                  <Button Classes="link" Click="OnOpenServiceModule"
                                          IsVisible="{Binding HasItemLink}"
                                          ToolTip.Tip="Open in the Item Browser">
                                    <TextBlock Text="{Binding Name}" Classes="linktext" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                  </Button>
                                  <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasItemLink}"
                                             FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                             VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis" />
                                </Panel>
                                <Button Grid.Column="1" x:CompileBindings="False"
                                        IsEnabled="{Binding Owner.FittingEditable}"
                                        Command="{Binding $parent[UserControl].DataContext.RemoveServiceCommand}"
                                        CommandParameter="{Binding}"
                                        Content="✕" FontSize="10" Padding="6 1" Margin="8 0 0 0"
                                        Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                                        BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding FittingEditable}">
                          <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding AvailableServices}"
                                    SelectedItem="{Binding ServiceToAdd}"
                                    PlaceholderText="— add a service module —"
                                    FontSize="11"
                                    Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextSecondaryBrush}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:SdeRigOption">
                                <TextBlock Text="{Binding Name}" FontSize="11" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Button Grid.Column="1" x:CompileBindings="False"
                                  Command="{Binding $parent[UserControl].DataContext.AddServiceCommand}"
                                  CommandParameter="{Binding}"
                                  Content="Add" FontSize="10" Padding="10 3" Margin="8 0 0 0"
                                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
                        </Grid>
                      </StackPanel>

                      <!-- Row 6: who owns this fitting -->
                      <TextBlock Grid.Row="6" Text="{Binding FittingSourceText}"
                                 IsVisible="{Binding FittingSourceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                                 Margin="0 8 0 0" />

                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Production assignments section -->
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="PRODUCTION ASSIGNMENTS" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" VerticalAlignment="Center" />
              <Button Grid.Column="1" Command="{Binding AutoAssignCommand}"
                      Content="Auto-assign from rigs"
                      Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                      BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                      Padding="10 4" FontSize="11"
                      ToolTip.Tip="Fills empty categories from each structure's rigs. Existing choices are left alone." />
            </Grid>
            <TextBlock Text="Assign which structure handles each production category."
                       FontSize="11" Foreground="{DynamicResource BorderStrongBrush}" />
            <TextBlock Text="{Binding AutoAssignStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding AutoAssignStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Background="{DynamicResource SurfacePanelBrush}" CornerRadius="4" Padding="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
              <ItemsControl x:CompileBindings="False" ItemsSource="{Binding Assignments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:CompileBindings="False" x:DataType="vm:CategoryAssignmentVm">
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1" Padding="14 8">
                      <Grid ColumnDefinitions="220,*">
                        <TextBlock Grid.Column="0" Text="{Binding CategoryLabel}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StructureOptions}"
                                  SelectedItem="{Binding Selected}"
                                  PlaceholderText="— not assigned —"
                                  FontSize="12"
                                  Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock x:CompileBindings="False"
                                         Text="{Binding DisplayHeader, FallbackValue='— not assigned —'}"
                                         FontSize="12" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <!-- Item exceptions section -->
          <StackPanel Spacing="10">
            <TextBlock Text="ITEM EXCEPTIONS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
            <TextBlock Text="Override the category assignment for a specific item."
                       FontSize="11" Foreground="{DynamicResource BorderStrongBrush}" />

            <!-- Search box -->
            <TextBox Text="{Binding ItemSearchText}"
                     Watermark="Search for an item to add exception…"
                     Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                     CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="12" Padding="8 5" />

            <!-- Search results dropdown -->
            <Border IsVisible="{Binding ItemSearchResults.Count}"
                    Background="{DynamicResource SurfacePanelBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    MaxHeight="200">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:CompileBindings="False" ItemsSource="{Binding ItemSearchResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Button x:CompileBindings="False"
                              Command="{Binding $parent[UserControl].DataContext.AddItemExceptionCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent" BorderThickness="0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="12 6" Cursor="Hand">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <!-- Exceptions list -->
            <Border IsVisible="{Binding ItemExceptions.Count}"
                    Background="{DynamicResource SurfacePanelBrush}" CornerRadius="4" Padding="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
              <ItemsControl x:CompileBindings="False" ItemsSource="{Binding ItemExceptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:CompileBindings="False" x:DataType="vm:ItemExceptionVm">
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1" Padding="14 8">
                      <Grid ColumnDefinitions="220,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding TypeName}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StructureOptions}"
                                  SelectedItem="{Binding Selected}"
                                  PlaceholderText="— not assigned —"
                                  FontSize="12"
                                  Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock x:CompileBindings="False"
                                         Text="{Binding DisplayHeader, FallbackValue='— not assigned —'}"
                                         FontSize="12" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" x:CompileBindings="False"
                                Command="{Binding $parent[UserControl].DataContext.RemoveItemExceptionCommand}"
                                CommandParameter="{Binding}"
                                Content="✕" Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                                BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1"
                                Padding="6 4" Margin="8 0 0 0" FontSize="11" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

  </Grid>
</UserControl>
