<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveCortex.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="EveCortex.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" />
      <Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#555566" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.dhdr">
      <Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,2*,4,1*,Auto">

    <!-- Filter bar -->
    <Border Grid.Row="0" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="0 0 0 1" Padding="12 8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="flabel" Text="Character:" />
        <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                  MinWidth="150" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Classes="flabel" Text="Type:" />
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                  MinWidth="180" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Classes="flabel" Text="Sender:" />
        <ComboBox ItemsSource="{Binding SenderTypes}" SelectedItem="{Binding SelectedSenderType}"
                  MinWidth="120" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Classes="flabel" Text="From:" />
        <CalendarDatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" FontSize="11" Width="120" Height="24" />
        <TextBlock Classes="flabel" Text="Thru:" />
        <CalendarDatePicker SelectedDate="{Binding ThruDate, Mode=TwoWay}" FontSize="11" Width="120" Height="24" />
        <TextBlock Classes="flabel" Text="Sort:" />
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                  MinWidth="150" FontSize="11" VerticalAlignment="Center" />
        <CheckBox IsChecked="{Binding ShowUnreadOnly}" Content="Unread only"
                  FontSize="11" Foreground="#aab" VerticalAlignment="Center" />
        <Button Command="{Binding ClearFiltersCommand}" Content="Clear" FontSize="10" Padding="8 2" Height="24"
                Background="#1a1a2a" Foreground="#888899" BorderBrush="#2a2a3a" BorderThickness="1"
                VerticalAlignment="Center" />
        <TextBlock Text="{Binding UnreadText}" FontSize="11" FontWeight="SemiBold" Foreground="#c8a84b"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" Classes="flabel" Foreground="#888899" />
      </StackPanel>
    </Border>

    <!-- Grid -->
    <DataGrid Grid.Row="1"
              ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
              Background="#0d0d12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Date"        Binding="{Binding DateText}"   Width="130" />
        <DataGridTextColumn Header="Type"        Binding="{Binding TypeLabel}"  Width="220" />
        <DataGridTextColumn Header="Character"   Binding="{Binding Character}"  Width="150" />
        <DataGridTextColumn Header="Sender"      Binding="{Binding Sender}"     Width="160" />
        <DataGridTextColumn Header="Sender Type" Binding="{Binding SenderType}" Width="100" />
        <DataGridTextColumn Header="Read"        Binding="{Binding ReadText}"   Width="70" />
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" Background="#1e1e2a" />

    <!-- Detail (selected row) -->
    <Border Grid.Row="3" Background="#0b0b10" BorderBrush="#1e1e2a" BorderThickness="0 1 0 0">
      <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding Detail, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <StackPanel Margin="12 8" Spacing="6" DataContext="{Binding Detail}"
                      x:DataType="vm:NotificationDetailVm">
            <!-- Top section: icon (portrait / logo / structure) + title + meta, matching the
                 Overview notifications list. -->
            <Grid ColumnDefinitions="Auto,*">
              <Panel Grid.Column="0" Width="40" Height="40" Margin="0 0 10 0" VerticalAlignment="Top">
                <Border IsVisible="{Binding HasIcon}" Width="40" Height="40"
                        CornerRadius="3" ClipToBounds="True">
                  <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="UniformToFill" />
                </Border>
                <TextBlock IsVisible="{Binding NoIcon}" Text="{Binding FallbackGlyph}"
                           FontSize="20" Foreground="#8899aa"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="{Binding TypeLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#e0e0ee" />
                <Grid ColumnDefinitions="70,*,70,*" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="dhdr" Text="Date" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DateText}"  FontSize="11" Foreground="#c8c8d8" Margin="0 0 12 0" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Classes="dhdr" Text="Read" />
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ReadText}"  FontSize="11" Foreground="#c8c8d8" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="dhdr" Text="Char" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Character}" FontSize="11" Foreground="#c8c8d8" Margin="0 0 12 0" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Classes="dhdr" Text="Sender" />
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Sender}"    FontSize="11" Foreground="#c8c8d8" />
                </Grid>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="#1e1e2a" Margin="0 2" />
            <SelectableTextBlock Text="{Binding Body}" FontSize="12" Foreground="#aab8c8"
                                 FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        <TextBlock Text="Select a notification to view its details."
                   IsVisible="{Binding Detail, Converter={x:Static conv:ObjectConverters.IsNull}}"
                   FontSize="12" Foreground="#444455"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </Border>

    <!-- Pager -->
    <Border Grid.Row="4" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="0 1 0 0" Padding="12 6">
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <Button Command="{Binding Pager.FirstPageCommand}" IsEnabled="{Binding Pager.CanPrev}" Content="⏮ First" FontSize="11" Padding="8 2" />
        <Button Command="{Binding Pager.PrevPageCommand}"  IsEnabled="{Binding Pager.CanPrev}" Content="◀ Prev"  FontSize="11" Padding="8 2" />
        <TextBlock Text="{Binding Pager.PageInfo}" FontSize="11" Foreground="#aab" VerticalAlignment="Center" Margin="12 0" MinWidth="220" TextAlignment="Center" />
        <Button Command="{Binding Pager.NextPageCommand}"  IsEnabled="{Binding Pager.CanNext}" Content="Next ▶"  FontSize="11" Padding="8 2" />
        <Button Command="{Binding Pager.LastPageCommand}"  IsEnabled="{Binding Pager.CanNext}" Content="Last ⏭"  FontSize="11" Padding="8 2" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
