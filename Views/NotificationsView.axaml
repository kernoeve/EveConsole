<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="EveConsole.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.dhdr">
      <Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- A value in the detail pane. Colour from a style, never set on the element, so the
         good / bad classes (a standing going up or down) can replace it. -->
    <Style Selector=":is(TextBlock).val">
      <Setter Property="FontSize"   Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(TextBlock).val.good"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}" /></Style>
    <Style Selector=":is(TextBlock).val.bad"><Setter Property="Foreground" Value="{DynamicResource BadBrush}" /></Style>
    <Style Selector="StackPanel.flush"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- One value: its icon where it has one, then its name — a link when it opens something. -->
    <DataTemplate DataType="vm:NotifValueVm">
      <StackPanel Orientation="Horizontal" Spacing="6" Classes.flush="{Binding AlignRight}"
                  ToolTip.Tip="{Binding Tip}">
        <Border IsVisible="{Binding HasIconSlot}" Width="20" Height="20" CornerRadius="2" ClipToBounds="True"
                VerticalAlignment="Center">
          <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="UniformToFill" />
        </Border>
        <Button Classes="link" IsVisible="{Binding IsLink}" Click="OnOpenValue">
          <TextBlock Classes="linktext val" Text="{Binding Text}" />
        </Button>
        <SelectableTextBlock Classes="val" IsVisible="{Binding IsPlain}" Text="{Binding Text}"
                             Classes.good="{Binding IsGood}" Classes.bad="{Binding IsBad}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Resources>
    <!-- A labelled field. Labels share one width per column, so the values line up. -->
    <DataTemplate x:Key="FieldRow" x:DataType="vm:NotifFieldVm">
      <Grid Margin="0 1" MinHeight="22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="label" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Classes="flabel" Text="{Binding Label}" Margin="0 0 14 0" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Values}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,3*,4,2*,Auto">

    <!-- Filter bar -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 0 0 1" Padding="12 8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="flabel" Text="Character:" />
        <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                  MinWidth="150" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Classes="flabel" Text="Type:" />
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                  MinWidth="220" FontSize="11" VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NotifTypeOption">
              <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding RawTypes}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="flabel" Text="Sender:" />
        <ComboBox ItemsSource="{Binding SenderTypes}" SelectedItem="{Binding SelectedSenderType}"
                  MinWidth="120" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Classes="flabel" Text="From:" />
        <CalendarDatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" FontSize="11" Width="120" Height="24" />
        <TextBlock Classes="flabel" Text="Thru:" />
        <CalendarDatePicker SelectedDate="{Binding ThruDate, Mode=TwoWay}" FontSize="11" Width="120" Height="24" />
        <TextBlock Classes="flabel" Text="Sort:" />
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                  MinWidth="150" FontSize="11" VerticalAlignment="Center" />
        <CheckBox IsChecked="{Binding ShowUnreadOnly}" Content="Unread only"
                  FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Button Command="{Binding ClearFiltersCommand}" Content="Clear" FontSize="10" Padding="8 2" Height="24"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                VerticalAlignment="Center" />
        <TextBlock Text="{Binding UnreadText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" Classes="flabel" Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
    </Border>

    <!-- Grid -->
    <DataGrid Grid.Row="1" x:Name="NotifGrid"
              ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
              Background="{DynamicResource SurfaceBaseBrush}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Date"        Binding="{Binding DateText}"   Width="130" />
        <DataGridTextColumn Header="Type"        Binding="{Binding TypeLabel}"  Width="220" />
        <DataGridTemplateColumn Header="Character" Width="150" SortMemberPath="Character" ClipboardContentBinding="{Binding Character}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:NotificationRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenNotifCharacter" IsVisible="{Binding HasCharacterLink}"
                        ToolTip.Tip="Open in the entity browser">
                  <TextBlock Text="{Binding Character}" Classes="linktext"
                             TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Character}" IsVisible="{Binding !HasCharacterLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Sender" Width="160" SortMemberPath="Sender" ClipboardContentBinding="{Binding Sender}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:NotificationRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenNotifSender" IsVisible="{Binding HasSenderLink}"
                        ToolTip.Tip="Open in the entity browser">
                  <TextBlock Text="{Binding Sender}" Classes="linktext"
                             TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Sender}" IsVisible="{Binding !HasSenderLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Sender Type" Binding="{Binding SenderType}" Width="100" />
        <DataGridTextColumn Header="Read"        Binding="{Binding ReadText}"   Width="70" />
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" Background="{DynamicResource BorderSubtleBrush}" />

    <!-- Detail (selected row) -->
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0">
      <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding Detail, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <StackPanel Margin="12 10" Spacing="10" DataContext="{Binding Detail}"
                      x:DataType="vm:NotificationDetailVm">

            <!-- Header, packed to the left rather than spread across the pane: the sender's
                 icon, the sender and date (room for the longest names), read state and the
                 characters it came to, then their portraits. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                  HorizontalAlignment="Left">
              <Panel Grid.RowSpan="3" Width="44" Height="44" Margin="0 0 12 0" VerticalAlignment="Top">
                <Border IsVisible="{Binding HasIcon}" Width="44" Height="44" CornerRadius="3" ClipToBounds="True">
                  <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="UniformToFill" />
                </Border>
                <TextBlock IsVisible="{Binding NoIcon}" Text="{Binding FallbackGlyph}"
                           FontSize="22" Foreground="{DynamicResource InfoBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>

              <TextBlock Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Title}" Margin="0 0 0 4"
                         FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}" />

              <TextBlock Grid.Row="1" Grid.Column="1" Classes="dhdr" Text="Sender" Margin="0 0 10 0" />
              <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                          MinWidth="340" Margin="0 0 28 0">
                <ContentControl Content="{Binding Sender}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SenderType}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <!-- Row 2 hangs from the top: a long list of characters wraps downwards without
                   dragging the date and its label into the middle of it. -->
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="dhdr" Text="Date" Margin="0 3 10 0" VerticalAlignment="Top" />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="val" Text="{Binding DateText}" VerticalAlignment="Top" />

              <TextBlock Grid.Row="1" Grid.Column="3" Classes="dhdr" Text="Read" Margin="0 0 10 0" />
              <TextBlock Grid.Row="1" Grid.Column="4" Classes="val" Text="{Binding ReadText}" />
              <TextBlock Grid.Row="2" Grid.Column="3" Classes="dhdr" Text="Character" Margin="0 3 10 0" VerticalAlignment="Top" />
              <ItemsControl Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Recipients}"
                            MaxWidth="420" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NotifValueVm">
                    <Panel Margin="0 0 10 0">
                      <Button Classes="link" IsVisible="{Binding IsLink}" Click="OnOpenValue" ToolTip.Tip="{Binding Tip}">
                        <TextBlock Classes="linktext val" Text="{Binding Text}" />
                      </Button>
                      <TextBlock Classes="val" IsVisible="{Binding IsPlain}" Text="{Binding Text}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Grid.Column="5" Grid.RowSpan="3" Orientation="Horizontal" Spacing="4"
                          Margin="28 0 0 0" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Portraits}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotifValueVm">
                      <Button Classes="link" Click="OnOpenValue" ToolTip.Tip="{Binding Text}">
                        <Border Width="44" Height="44" CornerRadius="3" ClipToBounds="True"
                                Background="{DynamicResource SurfacePanelBrush}">
                          <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="UniformToFill" />
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MoreRecipients}" IsVisible="{Binding HasMoreRecipients}"
                           FontSize="12" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

            <!-- Body, laid out for the type: a sentence where one helps, then the fields (two
                 columns once there are many), then any lists, then long text. -->
            <TextBlock Text="{Binding Body.Summary}" IsVisible="{Binding Body.HasSummary}"
                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                       MaxWidth="900" HorizontalAlignment="Left" />

            <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left" IsVisible="{Binding Body.HasFields}">
              <ItemsControl Grid.Column="0" ItemsSource="{Binding Body.FieldsLeft}"
                            ItemTemplate="{StaticResource FieldRow}" Grid.IsSharedSizeScope="True" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Body.FieldsRight}" Margin="48 0 0 0"
                            ItemTemplate="{StaticResource FieldRow}" Grid.IsSharedSizeScope="True" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Body.Tables}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NotifTableVm">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="dhdr" Text="{Binding Title}" />

                    <!-- A plain list flows across the pane in columns. -->
                    <ItemsControl IsVisible="{Binding IsList}" ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotifRowVm">
                          <ContentControl Content="{Binding Cell1}" Width="330" Margin="0 1" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- A table: one width per column across the header and every row. -->
                    <StackPanel IsVisible="{Binding !IsList}" Grid.IsSharedSizeScope="True" HorizontalAlignment="Left">
                      <Grid Margin="0 0 0 2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="c1" />
                          <ColumnDefinition Width="Auto" SharedSizeGroup="c2" />
                          <ColumnDefinition Width="Auto" SharedSizeGroup="c3" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="dhdr" Text="{Binding Header1}" Margin="0 0 28 0" />
                        <TextBlock Grid.Column="1" Classes="dhdr" Text="{Binding Header2}" IsVisible="{Binding HasCol2}"
                                   HorizontalAlignment="Right" Margin="0 0 28 0" />
                        <TextBlock Grid.Column="2" Classes="dhdr" Text="{Binding Header3}" IsVisible="{Binding HasCol3}"
                                   HorizontalAlignment="Right" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NotifRowVm">
                            <Grid Margin="0 1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c1" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c2" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c3" />
                              </Grid.ColumnDefinitions>
                              <ContentControl Content="{Binding Cell1}" Margin="0 0 28 0" />
                              <ContentControl Grid.Column="1" Content="{Binding Cell2}" HorizontalAlignment="Right" Margin="0 0 28 0" />
                              <ContentControl Grid.Column="2" Content="{Binding Cell3}" HorizontalAlignment="Right" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Body.Notes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NotifFieldVm">
                  <StackPanel Spacing="3" Margin="0 2 0 0">
                    <TextBlock Classes="dhdr" Text="{Binding Label}" />
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         MaxWidth="900" HorizontalAlignment="Left" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No further details." IsVisible="{Binding NoBody}"
                       FontSize="12" Foreground="{DynamicResource TextFaintBrush}" />

            <!-- The notification as ESI sent it, for checking a translation against the source. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasRawText}">
              <CheckBox x:Name="RawToggle" Content="Show the original text" FontSize="11"
                        Foreground="{DynamicResource TextFaintBrush}" />
              <SelectableTextBlock Text="{Binding RawText}" IsVisible="{Binding #RawToggle.IsChecked}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   FontFamily="Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <TextBlock Text="Select a notification to view its details."
                   IsVisible="{Binding Detail, Converter={x:Static conv:ObjectConverters.IsNull}}"
                   FontSize="12" Foreground="{DynamicResource BorderStrongBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </Border>

    <!-- Pager -->
    <Border Grid.Row="4" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0" Padding="12 6">
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <Button Command="{Binding Pager.FirstPageCommand}" IsEnabled="{Binding Pager.CanPrev}" Content="⏮ First" FontSize="11" Padding="8 2" />
        <Button Command="{Binding Pager.PrevPageCommand}"  IsEnabled="{Binding Pager.CanPrev}" Content="◀ Prev"  FontSize="11" Padding="8 2" />
        <TextBlock Text="{Binding Pager.PageInfo}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12 0" MinWidth="220" TextAlignment="Center" />
        <Button Command="{Binding Pager.NextPageCommand}"  IsEnabled="{Binding Pager.CanNext}" Content="Next ▶"  FontSize="11" Padding="8 2" />
        <Button Command="{Binding Pager.LastPageCommand}"  IsEnabled="{Binding Pager.CanNext}" Content="Last ⏭"  FontSize="11" Padding="8 2" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
