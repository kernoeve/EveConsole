<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.SchedulerCalendarView"
             x:DataType="vm:SchedulerCalendarViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <!-- The controls along the top. -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10 3" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.nav.on">
      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InfoSurfaceBrush}" />
    </Style>

    <!-- A run on the calendar. Height and margin add up to SchedulerCalendarViewModel.ChipHeight. -->
    <Style Selector="Button.chip">
      <Setter Property="Height" Value="17" />
      <Setter Property="Margin" Value="0 0 0 1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4 0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.chip.alert">
      <Setter Property="Background" Value="{DynamicResource WarnSurfaceBrush}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- A day number or heading that opens the day. -->
    <Style Selector="Button.day">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="3 0" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.day.today">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A cell: in the month grid, or an hour of a day. -->
    <Style Selector="Border.cell">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0 0 1 1" />
    </Style>
    <Style Selector="Border.cell.outside">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    </Style>
    <Style Selector="Border.cell.past">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    </Style>
    <Style Selector="Border.cell.today">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    </Style>
    <Style Selector="TextBlock.hour">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin" Value="0 4 6 0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.hour.now">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.weekday">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin" Value="6 4" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:CalendarChip">
      <Button Classes="chip" Classes.alert="{Binding IsAlert}" Command="{Binding OpenCommand}"
              ToolTip.Tip="{Binding Tip}">
        <TextBlock TextTrimming="CharacterEllipsis">
          <Run Text="{Binding Time}" Foreground="{DynamicResource TextMutedBrush}" />
          <Run Text="{Binding Name}" />
          <Run Text="{Binding CountText}" Foreground="{DynamicResource TextMutedBrush}" />
        </TextBlock>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ── Where we are, and how to move ──────────────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="12 8">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
        <Button Classes="nav" Content="‹" Command="{Binding PreviousCommand}"
                ToolTip.Tip="{x:Static loc:AlarmsText.CalendarPrevious}" />
        <Button Classes="nav" Content="{x:Static loc:AlarmsText.CalendarToday}" Command="{Binding TodayCommand}" />
        <Button Classes="nav" Content="›" Command="{Binding NextCommand}"
                ToolTip.Tip="{x:Static loc:AlarmsText.CalendarNext}" />
      </StackPanel>

      <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                 Margin="14 0" TextTrimming="CharacterEllipsis" />

      <!-- What the two colours mean, in the words the task editor uses. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0 0 16 0">
        <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource InfoSurfaceBrush}" />
        <TextBlock Text="{x:Static loc:AlarmsText.TaskTypeSlackOrDiscordPost}" FontSize="10.5"
                   Foreground="{DynamicResource TextDimBrush}" Margin="0 0 8 0" />
        <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource WarnSurfaceBrush}" />
        <TextBlock Text="{x:Static loc:AlarmsText.TaskTypeRaiseAlert}" FontSize="10.5"
                   Foreground="{DynamicResource TextDimBrush}" />
      </StackPanel>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
        <Button Classes="nav" Classes.on="{Binding IsMonth}" Content="{x:Static loc:AlarmsText.CalendarMonth}"
                Command="{Binding ShowMonthCommand}" />
        <Button Classes="nav" Classes.on="{Binding IsWeek}" Content="{x:Static loc:AlarmsText.CalendarWeek}"
                Command="{Binding ShowWeekCommand}" />
        <Button Classes="nav" Classes.on="{Binding IsDay}" Content="{x:Static loc:AlarmsText.CalendarDay}"
                Command="{Binding ShowDayCommand}" />
      </StackPanel>
    </Grid>

    <!-- ── Month ──────────────────────────────────────────────────────── -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsMonth}" Margin="12 0">
      <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekdayNames}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="weekday" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl x:Name="MonthGrid" Grid.Row="1" ItemsSource="{Binding MonthCells}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1 1 0 0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CalendarDayCell">
            <Border Classes="cell" Classes.today="{Binding IsToday}" Classes.past="{Binding IsPast}"
                    Classes.outside="{Binding IsOutside}" ClipToBounds="True" Padding="2">
              <StackPanel Spacing="1">
                <Button Classes="day" Classes.today="{Binding IsToday}" Content="{Binding DayNumber}"
                        Command="{Binding OpenCommand}" HorizontalAlignment="Left" />
                <ItemsControl ItemsSource="{Binding Chips}" />
                <Button Classes="day" IsVisible="{Binding HasMore}" Content="{Binding MoreText}"
                        Command="{Binding OpenCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- ── Week and day: an hour to a row, a day to a column ──────────── -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsHourGrid}" Margin="12 0">
      <Grid Grid.Row="0" ColumnDefinitions="48,*" IsVisible="{Binding IsWeek}">
        <ItemsControl Grid.Column="1" ItemsSource="{Binding DayHeaders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CalendarDayHeader">
              <Button Classes="day" Classes.today="{Binding IsToday}" Command="{Binding OpenCommand}"
                      HorizontalAlignment="Left" Margin="3 4">
                <TextBlock>
                  <Run Text="{Binding Name}" FontWeight="SemiBold" />
                  <Run Text="{Binding Number}" />
                </TextBlock>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding HourRows}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CalendarHourRow">
              <Grid ColumnDefinitions="48,*">
                <TextBlock Grid.Column="0" Classes="hour" Classes.now="{Binding IsNowHour}" Text="{Binding Label}" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}"
                              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1 0 0 0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarHourCell">
                      <Border Classes="cell" Classes.today="{Binding IsToday}" Classes.past="{Binding IsPast}"
                              MinHeight="23" Padding="2">
                        <ItemsControl ItemsSource="{Binding Chips}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="2" Text="{x:Static loc:AlarmsText.CalendarNote}" FontSize="10"
               Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="12 6" />
  </Grid>
</UserControl>
