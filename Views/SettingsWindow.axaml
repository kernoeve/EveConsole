<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        xmlns:models="clr-namespace:EveConsole.Models"
        xmlns:agent="clr-namespace:EveConsole.Agent"
        xmlns:views="clr-namespace:EveConsole.Views"
        xmlns:loc="using:EveConsole.Localization"
        x:Class="EveConsole.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{x:Static loc:SettingsText.WindowTitle}"
        Width="940" Height="820"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Window.Resources>
    <views:DbEngineLogoConverter x:Key="DbEngineLogo" />
  </Window.Resources>

  <Window.Styles>
    <!-- Make the "Find Location" Expander header match the other form controls -->
    <Style Selector="Expander /template/ ToggleButton#PART_toggle">
      <Setter Property="FontSize"        Value="12" />
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Padding"         Value="8 5" />
      <Setter Property="MinHeight"       Value="0" />
      <Setter Property="Background"      Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius"    Value="3" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#PART_toggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelAltBrush}" />
    </Style>

    <!-- Worn by the copy panel when the destination already holds data, so the button in it
         destroys what is there rather than filling an empty database. -->
    <Style Selector="Border.danger">
      <Setter Property="BorderBrush" Value="{DynamicResource BadSurfaceBrush}" />
      <Setter Property="Background"  Value="{DynamicResource SurfaceBaseBrush}" />
    </Style>
  </Window.Styles>

  <TabControl x:Name="Tabs" Margin="8">

    <!-- ══ ESI Tokens ══════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabEsiTokens}">
      <Grid RowDefinitions="*,8,*,Auto" Margin="0 8 0 0">

        <!-- Characters row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,8,280">

          <!-- Left: list + buttons -->
          <Border Grid.Column="0"
                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.Characters}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <ListBox Grid.Row="1"
                       ItemsSource="{Binding CharacterVm.CharacterListItems}"
                       SelectedItem="{Binding CharacterVm.SelectedCharacterListItem}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:CharacterListItem">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Character.Name}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="4 2" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                                 Foreground="{Binding StatusBrush}"
                                 ToolTip.Tip="{Binding StatusTip}"
                                 FontSize="11" VerticalAlignment="Center" Margin="8 0 4 0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="8 6">
                <Button Content="{x:Static loc:SettingsText.Add}"    Command="{Binding CharacterVm.AddCharacterCommand}"    Padding="14 4" />
                <Button Content="{x:Static loc:SettingsText.Update}" Command="{Binding CharacterVm.UpdateCharacterCommand}" Padding="14 4" />
                <Button Content="{x:Static loc:SettingsText.Remove}" Command="{Binding CharacterVm.RemoveCharacterCommand}" Padding="14 4" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Right: character details (visible when one is selected) -->
          <Border Grid.Column="2"
                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding CharacterVm.SelectedCharacterInSettings,
                              Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
              <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{Binding CharacterVm.SelectedCharacterInSettings.Name}"
                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Grid.Row="1" Margin="10 6 10 0" Spacing="2">
                <TextBlock Text="{Binding CharacterVm.SelectedCharacterInSettings.LastUpdated,
                                          StringFormat={x:Static loc:SettingsText.FmtLastAuthenticated}}"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock Text="{Binding CharacterVm.SelectedCharacterScopeSummary}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="{x:Static loc:SettingsText.GrantedScopesLabel}"
                         FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                         Margin="10 6 10 2" />

              <ScrollViewer Grid.Row="3" Margin="10 0 10 8">
                <ItemsControl ItemsSource="{Binding CharacterVm.SelectedCharacterScopeGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScopeDisplayGroup">
                      <StackPanel Margin="0 0 0 6">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 1" />
                        <ItemsControl ItemsSource="{Binding Items}" Margin="8 0 0 0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScopeDisplayItem">
                              <CheckBox IsChecked="{Binding IsGranted}"
                                        IsEnabled="False"
                                        Content="{Binding FriendlyName}"
                                        FontSize="11"
                                        Padding="4 1" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Corporations row -->
        <Grid Grid.Row="2" ColumnDefinitions="*,8,280">

          <!-- Left: list + buttons -->
          <Border Grid.Column="0"
                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.Corporations}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <ListBox Grid.Row="1"
                       ItemsSource="{Binding CharacterVm.CorpListItems}"
                       SelectedItem="{Binding CharacterVm.SelectedCorpListItem}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:CorpListItem">
                    <Grid ColumnDefinitions="14,Auto,*,Auto">
                      <!-- Personal corp indicator dot -->
                      <Ellipse Grid.Column="0" Width="6" Height="6"
                               Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Corp.IsPersonal}"
                               ToolTip.Tip="{x:Static loc:SettingsText.TipPersonalCorporation}" />
                      <TextBlock Grid.Column="1" Text="{Binding Corp.Ticker}"
                                 Foreground="{DynamicResource TextDimBrush}" Padding="0 2" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Corp.Name}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="4 2" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding StatusLabel}"
                                 Foreground="{Binding StatusBrush}"
                                 ToolTip.Tip="{Binding StatusTip}"
                                 FontSize="11" VerticalAlignment="Center" Margin="8 0 4 0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="8 6">
                <Button Content="{x:Static loc:SettingsText.Add}"    Command="{Binding CharacterVm.AddCorporationCommand}"     Padding="14 4" />
                <Button Content="{x:Static loc:SettingsText.Update}" Command="{Binding CharacterVm.UpdateCorporationCommand}" Padding="14 4" />
                <Button Content="{x:Static loc:SettingsText.Remove}" Command="{Binding CharacterVm.RemoveCorporationCommand}" Padding="14 4" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Right: corp details (visible when one is selected) -->
          <Border Grid.Column="2"
                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding CharacterVm.SelectedCorp,
                              Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
              <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{Binding CharacterVm.SelectedCorp.Name}"
                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Grid.Row="1" Margin="10 6 10 0" Spacing="2">
                <TextBlock Text="{Binding CharacterVm.SelectedCorp.LastUpdated,
                                          StringFormat={x:Static loc:SettingsText.FmtLastAuthenticated}}"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock Text="{Binding CharacterVm.SelectedCorpScopeSummary}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>

              <CheckBox Grid.Row="2"
                        Margin="10 6 10 4"
                        IsChecked="{Binding CharacterVm.SelectedCorpIsPersonal}"
                        Content="{x:Static loc:SettingsText.PersonalCorporation}"
                        FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                        ToolTip.Tip="{x:Static loc:SettingsText.TipPersonalCorpsCountToward}" />

              <TextBlock Grid.Row="3" Text="{x:Static loc:SettingsText.AuthCharacterScopesLabel}"
                         FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                         Margin="10 6 10 2" />

              <ScrollViewer Grid.Row="4" Margin="10 0 10 8">
                <ItemsControl ItemsSource="{Binding CharacterVm.SelectedCorpScopeGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScopeDisplayGroup">
                      <StackPanel Margin="0 0 0 6">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 1" />
                        <ItemsControl ItemsSource="{Binding Items}" Margin="8 0 0 0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScopeDisplayItem">
                              <CheckBox IsChecked="{Binding IsGranted}"
                                        IsEnabled="False"
                                        Content="{Binding FriendlyName}"
                                        FontSize="11"
                                        Padding="4 1" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Auth busy strip -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4" Padding="10 6" Margin="0 4 0 0"
                IsVisible="{Binding CharacterVm.IsAuthBusy}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <ProgressBar IsIndeterminate="True" Height="3" />
              <TextBlock Text="{Binding CharacterVm.StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{x:Static loc:SettingsText.Cancel}"
                    Command="{Binding CharacterVm.CancelAddCommand}"
                    Padding="12 4" VerticalAlignment="Center" Margin="10 0 0 0" />
          </Grid>
        </Border>

      </Grid>
    </TabItem>

    <!-- ══ Characters ════════════════════════════════════════════════════════ -->
    <!-- What each character is used for: industry slots and skill-queue alerts. Moved out of the
         Industry tab, since the skill queue column is not about industry at all. -->
    <TabItem Header="{x:Static loc:SettingsText.TabCharacters}">
      <!-- Horizontal scrolling off explicitly: the grid sizes its Free / total column with a star,
           and an unbounded width would push the columns after it out of view. -->
      <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="0 0 4 0">
          <Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12 10">
            <StackPanel Spacing="8" DataContext="{Binding IndustryVm}">
              <TextBlock Text="{x:Static loc:SettingsText.Characters}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
              <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                         Text="{x:Static loc:SettingsText.WhichCharactersMayBeNote}" />

              <DataGrid ItemsSource="{Binding Chars}" MinHeight="160" MaxHeight="480"
                        IsReadOnly="True" AutoGenerateColumns="False" FontSize="11"
                        Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{x:Static loc:SettingsText.ColCharacter}" Binding="{Binding CharacterName}" FontSize="11" Width="200"
                                      IsReadOnly="True" />

                  <!-- Editable in place, saving on change. -->
                  <DataGridTemplateColumn Header="{x:Static loc:SettingsText.ColSlotsUsedFor}" Width="260" SortMemberPath="Activities" IsReadOnly="True" ClipboardContentBinding="{Binding Activities}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:IndyCharRow">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <CheckBox Content="{x:Static loc:SettingsText.Mfg}"  IsChecked="{Binding Manufacturing, Mode=TwoWay}" FontSize="11"
                                    MinHeight="0" ToolTip.Tip="{x:Static loc:SettingsText.TipManufacturing}" />
                          <CheckBox Content="{x:Static loc:SettingsText.Rxn}"  IsChecked="{Binding Reactions, Mode=TwoWay}"     FontSize="11"
                                    MinHeight="0" ToolTip.Tip="{x:Static loc:SettingsText.TipReactions}" />
                          <CheckBox Content="{x:Static loc:SettingsText.Sci}"  IsChecked="{Binding Science, Mode=TwoWay}"       FontSize="11"
                                    MinHeight="0" ToolTip.Tip="{x:Static loc:SettingsText.TipScienceCopyingResearchInvention}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTextColumn Header="{x:Static loc:SettingsText.ColFreeTotal}" Binding="{Binding Slots}" FontSize="11" Width="*"
                                      IsReadOnly="True" />

                  <DataGridTemplateColumn Header="{x:Static loc:SettingsText.ColSkillQueue}" Width="110" SortMemberPath="SkillQueue"
                                          IsReadOnly="True" ClipboardContentBinding="{Binding SkillQueue}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:IndyCharRow">
                        <CheckBox IsChecked="{Binding SkillQueue, Mode=TwoWay}" FontSize="11" MinHeight="0"
                                  HorizontalAlignment="Center"
                                  ToolTip.Tip="{x:Static loc:SettingsText.TipCharacterSkillQueueShould}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ SDE ══════════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabSde}">
      <ScrollViewer>
        <StackPanel Margin="0 12 0 0" Spacing="14">

          <!-- Eve Static Data -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.EveStaticData}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <Grid Grid.Row="1" ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" Margin="12 10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.LoadedLabel}" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0 0 0 6" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SdeVm.LoadedBuild}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0 0 0 6" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.LatestLabel}" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SdeVm.LatestBuild}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
              </Grid>

              <StackPanel Grid.Row="2" Margin="12 0 12 10" Spacing="6">
                <ProgressBar Value="{Binding SdeVm.Fraction}" Minimum="0" Maximum="1" Height="6" IsVisible="{Binding SdeVm.IsBusy}" />
                <TextBlock Text="{Binding SdeVm.StatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                <Button Content="{x:Static loc:SettingsText.UpdateSde}" Command="{Binding SdeVm.RefreshSdeCommand}" Padding="14 4" HorizontalAlignment="Left"
                        ToolTip.Tip="{x:Static loc:SettingsText.TipDownloadAndImportThe}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Hoboleaks -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.HoboleaksComplement}" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" />
              </Border>

              <StackPanel Grid.Row="1" Margin="12 10 12 0" Spacing="4">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.BlueprintsReprocessingCompressionAndNote2}" />
                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" Margin="0 6 0 0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.LoadedLabel}" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0 0 0 6" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SdeVm.HoboImportedAt}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0 0 0 6" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.LatestLabel}" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SdeVm.HoboLatest}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="12 6 12 10" Spacing="6">
                <ProgressBar Value="{Binding SdeVm.HoboFraction}" Minimum="0" Maximum="1" Height="6"
                             IsVisible="{Binding SdeVm.HoboIsBusy}" />
                <TextBlock Text="{Binding SdeVm.HoboStatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding SdeVm.HoboIsBusy}" />
                <Button Content="{x:Static loc:SettingsText.ImportFromHoboleaks}"
                        Command="{Binding SdeVm.RefreshHoboCommand}"
                        IsEnabled="{Binding !SdeVm.HoboIsBusy}"
                        Padding="14 4" HorizontalAlignment="Left"
                        ToolTip.Tip="{x:Static loc:SettingsText.TipDownloadBlueprintReprocessingCompression}" />
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Market ════════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabMarket}">
      <Grid RowDefinitions="*,Auto,Auto" Margin="0 8 0 0">

        <Grid Grid.Row="0" ColumnDefinitions="*,8,300">

          <!-- Left: config list -->
          <Border Grid.Column="0" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.PriceSources}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <ListBox Grid.Row="1"
                       ItemsSource="{Binding MarketVm.Configs}"
                       SelectedItem="{Binding MarketVm.Selected}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarketPricingConfigVm">
                    <Grid ColumnDefinitions="*,Auto" Margin="2 3">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Method}"
                                 FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                                 VerticalAlignment="Center" Margin="6 0 2 0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="8 6">
                <Button Content="{x:Static loc:SettingsText.Add}"    Command="{Binding MarketVm.AddCommand}"    Padding="14 4" />
                <Button Content="{x:Static loc:SettingsText.Remove}" Command="{Binding MarketVm.RemoveCommand}" Padding="14 4"
                        IsEnabled="{Binding MarketVm.HasSelected}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Right: edit panel -->
          <Border Grid.Column="2" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding MarketVm.HasSelected}">
            <ScrollViewer>
              <StackPanel Margin="12 10" Spacing="6">

                <TextBlock Text="{x:Static loc:SettingsText.Method}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                <ComboBox ItemsSource="{Binding MarketVm.Methods}"
                          SelectedItem="{Binding MarketVm.Selected.Method}"
                          HorizontalAlignment="Stretch" />

                <!-- Per-method guidance -->
                <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="8 6" Margin="0 2 0 0"
                        IsVisible="{Binding MarketVm.Selected.IsFuzzwork}">
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                             Text="{x:Static loc:SettingsText.FuzzworkFetchesPreComputedNote}" />
                </Border>
                <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="8 6" Margin="0 2 0 0"
                        IsVisible="{Binding MarketVm.Selected.IsEsiRegion}">
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                             Text="{x:Static loc:SettingsText.EsiRegionFetchesAllNote}" />
                </Border>
                <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="8 6" Margin="0 2 0 0"
                        IsVisible="{Binding MarketVm.Selected.IsPlayerStructure}">
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                             Text="{x:Static loc:SettingsText.PlayerStructureFetchesAllNote}" />
                </Border>

                <TextBlock Text="{x:Static loc:SettingsText.LocationName}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 6 0 0" />
                <TextBox Text="{Binding MarketVm.Selected.LocationName}"
                         Watermark="{x:Static loc:SettingsText.HintEGJita44}" />

                <!-- Region dropdown — ESI Region method only -->
                <TextBlock Text="{x:Static loc:SettingsText.Region}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 6 0 0"
                           IsVisible="{Binding MarketVm.Selected.IsEsiRegion}" />
                <ComboBox ItemsSource="{Binding MarketVm.RegionOptions}"
                          SelectedItem="{Binding MarketVm.Selected.SelectedRegion}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding MarketVm.Selected.IsEsiRegion}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SdeRegionOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Location ID — hidden when using ESI Region (replaced by region dropdown) -->
                <TextBlock Text="{x:Static loc:SettingsText.LocationId}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 6 0 0"
                           IsVisible="{Binding !MarketVm.Selected.IsEsiRegion}" />
                <TextBox Text="{Binding MarketVm.Selected.LocationIdText}"
                         Watermark="{x:Static loc:SettingsText.HintStationOrStructureId}"
                         IsVisible="{Binding !MarketVm.Selected.IsEsiRegion}" />
                <!-- Resolved name updates automatically after you stop typing -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="2 3 0 4"
                            IsVisible="{Binding MarketVm.Selected.ResolvedLocationName,
                                        Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <ProgressBar IsIndeterminate="True" Width="10" Height="10"
                               IsVisible="{Binding MarketVm.Selected.IsResolvingLocation}" />
                  <TextBlock Text="{Binding MarketVm.Selected.ResolvedLocationName}"
                             FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Expander Margin="0 6 0 0"
                          FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                          Background="{DynamicResource SurfaceRaisedBrush}"
                          IsVisible="{Binding !MarketVm.Selected.IsEsiRegion}">
                  <!-- Wraps: the side panel is 300 wide, and the name runs longer in other languages. -->
                  <Expander.Header>
                    <TextBlock Text="{x:Static loc:SettingsText.SectionFindLocationByName}" TextWrapping="Wrap" />
                  </Expander.Header>
                  <StackPanel Spacing="6" Margin="0 8 0 0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                               Text="{x:Static loc:SettingsText.SearchForAStationNote}"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,6,Auto">
                      <TextBox Grid.Column="0"
                               Text="{Binding MarketVm.LocationSearch}"
                               Watermark="{x:Static loc:SettingsText.HintStationOrStructureName}" />
                      <Button Grid.Column="2" Content="{x:Static loc:SettingsText.Search}"
                              Command="{Binding MarketVm.SearchLocationsCommand}"
                              Padding="10 4" />
                    </Grid>

                    <ListBox ItemsSource="{Binding MarketVm.LocationResults}"
                             SelectedItem="{Binding MarketVm.SelectedLocationResult}"
                             MaxHeight="140" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocationResult">
                          <Grid ColumnDefinitions="52,*" Margin="2 2">
                            <TextBlock Grid.Column="0" Text="{Binding Category}"
                                       FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="{x:Static loc:SettingsText.UseSelected}"
                              Command="{Binding MarketVm.UseSelectedLocationCommand}"
                              IsEnabled="{Binding MarketVm.HasLocationResult}"
                              Padding="12 4" />
                      <TextBlock Text="{Binding MarketVm.SearchStatus}"
                                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Expander>

                <!-- Station filter — only for ESI Region (populated from raw orders after first refresh) -->
                <TextBlock Text="{x:Static loc:SettingsText.StationFilter}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 6 0 0"
                           IsVisible="{Binding MarketVm.Selected.IsEsiRegion}" />
                <ComboBox ItemsSource="{Binding MarketVm.StationFilterOptions}"
                          SelectedItem="{Binding MarketVm.SelectedStationFilter}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding MarketVm.Selected.IsEsiRegion}" />
                <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.RestrictPricesToANote}"
                           IsVisible="{Binding MarketVm.Selected.IsEsiRegion}"
                           Margin="0 2 0 0" />

                <TextBlock Text="{x:Static loc:SettingsText.AuthCharacter}"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 6 0 0"
                           IsVisible="{Binding MarketVm.Selected.IsPlayerStructure}" />
                <ComboBox ItemsSource="{Binding MarketVm.CharacterOptions}"
                          SelectedItem="{Binding MarketVm.Selected.SelectedAuthChar}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding MarketVm.Selected.IsPlayerStructure}" />

                <!-- Percentile filter -->
                <Separator Margin="0 8 0 4" />
                <CheckBox Content="{x:Static loc:SettingsText.FilterHighLowOrders}"
                          IsChecked="{Binding MarketVm.Selected.UsePercentileFilter}"
                          Margin="0 0 0 2" />
                <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.RemovesAnomaliesCausedByNote}" />
                <Grid ColumnDefinitions="*,8,120"
                      IsVisible="{Binding MarketVm.Selected.UsePercentileFilter}"
                      Margin="0 4 0 0">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.Filter}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="2"
                                 Value="{Binding MarketVm.Selected.PercentilePercent}"
                                 Minimum="0.1" Maximum="25" Increment="0.5"
                                 FormatString="0.0" />
                </Grid>

                <CheckBox Content="{x:Static loc:SettingsText.Enabled}"
                          IsChecked="{Binding MarketVm.Selected.IsEnabled}"
                          Margin="0 6 0 0" />

                <Separator Margin="0 8" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0 0 0 4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.LastRefreshLabel}"
                             FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0 0 8 3" />
                  <TextBlock Grid.Row="0" Grid.Column="1"
                             Text="{Binding MarketVm.Selected.LastRefreshedText}"
                             FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.StatusLabel}"
                             FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0 0 8 0" />
                  <TextBlock Grid.Row="1" Grid.Column="1"
                             Text="{Binding MarketVm.Selected.LastStatus}"
                             FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 8 0 0">
                  <Button Content="{x:Static loc:SettingsText.Save}"
                          Command="{Binding MarketVm.SaveCommand}"
                          Padding="14 4" />
                  <Button Content="{x:Static loc:SettingsText.RefreshThis}"
                          Command="{Binding MarketVm.RefreshSelectedCommand}"
                          Padding="14 4" />
                </StackPanel>

              </StackPanel>
            </ScrollViewer>
          </Border>

        </Grid>

        <!-- Default Pricing -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12 10" Margin="0 8 0 0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="{x:Static loc:SettingsText.DefaultPricing}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0 0 0 8" />

            <!-- Asset Value -->
            <Grid Grid.Row="1" ColumnDefinitions="190,*,8,140" Margin="0 0 0 6">
              <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.AssetValueLabel}"
                         FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding MarketVm.Configs}"
                        SelectedItem="{Binding MarketVm.SelectedAssetConfig}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarketPricingConfigVm">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding MarketVm.PriceTypes}"
                        SelectedItem="{Binding MarketVm.AssetValuePriceType}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <TextBlock Text="{Binding Converter={x:Static views:PriceTypeLabelConverter.Instance}}" FontSize="12" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <!-- Manufacturing Cost -->
            <Grid Grid.Row="2" ColumnDefinitions="190,*,8,140" Margin="0 0 0 8">
              <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.ManufacturingCostLabel}"
                         FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding MarketVm.Configs}"
                        SelectedItem="{Binding MarketVm.SelectedManufacturingConfig}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarketPricingConfigVm">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding MarketVm.PriceTypes}"
                        SelectedItem="{Binding MarketVm.ManufacturingPriceType}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <TextBlock Text="{Binding Converter={x:Static views:PriceTypeLabelConverter.Instance}}" FontSize="12" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <!-- Missing Price Markup -->
            <Grid Grid.Row="3" ColumnDefinitions="190,120,Auto,*" Margin="0 0 0 8">
              <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.MissingPriceMarkupLabel}"
                         FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding MarketVm.MissingPriceMarkupPct}"
                             Minimum="0" Maximum="500" Increment="1"
                             FormatString="0" FontSize="12"
                             HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="%" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="5 0 12 0" />
              <TextBlock Grid.Column="3"
                         Text="{x:Static loc:SettingsText.AppliedWhenTheMarketNote}"
                         FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </Grid>

            <!-- Lowball Buy Order Filter -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,120,Auto,*" Margin="0 0 0 8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding MarketVm.FilterLowballBuyOrders}"
                        Content="{x:Static loc:SettingsText.FilterLowballBuyOrdersBelow}"
                        FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                        Margin="0 0 6 0" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding MarketVm.LowballBuyOrderThresholdPct}"
                             Minimum="1" Maximum="100" Increment="5"
                             FormatString="0" FontSize="12"
                             IsEnabled="{Binding MarketVm.FilterLowballBuyOrders}"
                             HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.OfBuildCost}"
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="5 0 12 0" />
              <TextBlock Grid.Column="3"
                         Text="{x:Static loc:SettingsText.AppliesToEsiRegionNote}"
                         FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </Grid>

            <!-- Save row -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10">
              <Button Content="{x:Static loc:SettingsText.SaveDefaults}" Command="{Binding MarketVm.SaveDefaultsCommand}" Padding="14 4" />
              <TextBlock Text="{Binding MarketVm.DefaultsStatus}"
                         FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Bottom status bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4" Padding="10 6" Margin="0 8 0 0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="3">
              <ProgressBar IsIndeterminate="True" Height="3"
                           IsVisible="{Binding MarketVm.IsBusy}" />
              <TextBlock Text="{Binding MarketVm.Status}"
                         FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static loc:SettingsText.RefreshAll}"
                    Command="{Binding MarketVm.RefreshAllCommand}"
                    Padding="14 4" VerticalAlignment="Center" Margin="8 0 0 0" />
          </Grid>
        </Border>

      </Grid>
    </TabItem>

  <!-- ── Price History ──────────────────────────────────────────────────── -->
  <TabItem Header="{x:Static loc:SettingsText.TabPriceHistory}">
    <ScrollViewer>
      <StackPanel Spacing="16" Margin="24 16">

        <TextBlock Text="{x:Static loc:SettingsText.PriceHistoryRegions}"
                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                   Text="{x:Static loc:SettingsText.ABackgroundJobRefreshesNote}" />

        <!-- Configured regions grid -->
        <DataGrid ItemsSource="{Binding PriceHistoryVm.ConfiguredRegions}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  MaxHeight="200">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static loc:SettingsText.ColRegionId}"   Binding="{ReflectionBinding RegionId}"   Width="100" />
            <DataGridTextColumn Header="{x:Static loc:SettingsText.ColRegionName}" Binding="{ReflectionBinding DisplayName}" Width="*" />
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:PriceHistoryRegion">
                  <Button Content="{x:Static loc:SettingsText.Remove}"
                          Command="{Binding $parent[Window].DataContext.PriceHistoryVm.RemoveCommand}"
                          CommandParameter="{Binding}"
                          Padding="6 2" FontSize="11"
                          Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                          BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Add region row -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding PriceHistoryVm.AllRegions}"
                    SelectedItem="{Binding PriceHistoryVm.SelectedNewRegion}"
                    Width="260" PlaceholderText="{x:Static loc:SettingsText.HintSelectARegionToAdd}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SdeRegionOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{x:Static loc:SettingsText.AddRegion}"
                  Command="{Binding PriceHistoryVm.AddCommand}"
                  Padding="12 6" FontSize="12"
                  Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="0 4 0 0"
                   Text="{x:Static loc:SettingsText.TipWatchLivePerNote}" />

      </StackPanel>
    </ScrollViewer>
  </TabItem>

    <!-- ══ Industry ══════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabIndustry}">
      <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="0 0 4 0">

          <!-- Build Costs -->
          <Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12 10">
            <StackPanel Spacing="8">
              <TextBlock Text="{x:Static loc:SettingsText.BuildCosts}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
              <TextBlock Text="{x:Static loc:SettingsText.RecalculateStoredBuildCostsNote}"
                         FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*" Margin="0 2 0 0">
                <Button Grid.Column="0"
                        Content="{x:Static loc:SettingsText.RecalculateBuildCosts}"
                        Command="{Binding MarketVm.RecalculateBuildCostsCommand}"
                        Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
                        Padding="12 4" FontSize="11" />
                <TextBlock Grid.Column="1"
                           Text="{Binding MarketVm.BuildCostStatus}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="10 0 0 0"
                           TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Production Calc behaviour -->
          <Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12 10">
            <StackPanel Spacing="8">
              <TextBlock Text="{x:Static loc:SettingsText.ProductionCalculator}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />

              <Grid ColumnDefinitions="Auto,120,Auto,*">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding MarketVm.PurchaseWhenCheaper}"
                          Content="{x:Static loc:SettingsText.PurchaseAComponentInstead}"
                          FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                          Margin="0 0 6 0" />
                <NumericUpDown Grid.Column="1"
                               Value="{Binding MarketVm.PurchaseThresholdPct}"
                               Minimum="1" Maximum="500" Increment="5"
                               FormatString="0" FontSize="12"
                               IsEnabled="{Binding MarketVm.PurchaseWhenCheaper}"
                               HorizontalAlignment="Stretch" />
                <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.OfBuildValue}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="5 0 12 0" />
              </Grid>

              <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                         Text="{x:Static loc:SettingsText.OffByDefaultComponentNote}"/>
            </StackPanel>
          </Border>

          <!-- Save row -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{x:Static loc:SettingsText.Save}" Command="{Binding MarketVm.SaveDefaultsCommand}" Padding="14 4" />
            <TextBlock Text="{Binding MarketVm.DefaultsStatus}"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Timers ════════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabTimers}">
      <Grid RowDefinitions="*,Auto" Margin="0 8 0 0">

        <ScrollViewer Grid.Row="0">
          <StackPanel Spacing="16" Margin="0 0 12 0">

            <TextBlock Text="{x:Static loc:SettingsText.AdjustHowOftenEachNote}"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 0 0 4" TextWrapping="Wrap" />

            <!-- Character endpoints -->
            <StackPanel Spacing="2">
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="3" Padding="8 5" Margin="0 0 0 4">
                <TextBlock Text="{x:Static loc:SettingsText.CharacterEndpoints}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
              </Border>
              <ItemsControl ItemsSource="{Binding TimerVm.CharRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimerRowVm">
                    <Grid ColumnDefinitions="200,70,Auto,Auto,*" Margin="4 3">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                 FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{ReflectionBinding Interval, Mode=TwoWay}"
                               FontSize="12" Padding="4 3"
                               HorizontalContentAlignment="Right"
                               VerticalContentAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Unit, StringFormat=' {0}'}"
                                 FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center" Margin="4 0 12 0" />
                      <Button Grid.Column="3"
                              Content="{x:Static loc:SettingsText.ForceNow}"
                              Command="{Binding ForceNowCommand}"
                              FontSize="11" Padding="8 2" Margin="0 0 10 0"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{x:Static loc:SettingsText.TipResetTheInMemory}" />
                      <TextBlock Grid.Column="4" Text="{Binding ForceStatus}"
                                 FontSize="10" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 Text="{Binding MinText}"
                                 FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Corp endpoints -->
            <StackPanel Spacing="2">
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="3" Padding="8 5" Margin="0 0 0 4">
                <TextBlock Text="{x:Static loc:SettingsText.CorporationEndpoints}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
              </Border>
              <ItemsControl ItemsSource="{Binding TimerVm.CorpRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimerRowVm">
                    <Grid ColumnDefinitions="200,70,Auto,Auto,*" Margin="4 3">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                 FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{ReflectionBinding Interval, Mode=TwoWay}"
                               FontSize="12" Padding="4 3"
                               HorizontalContentAlignment="Right"
                               VerticalContentAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Unit, StringFormat=' {0}'}"
                                 FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center" Margin="4 0 12 0" />
                      <Button Grid.Column="3"
                              Content="{x:Static loc:SettingsText.ForceNow}"
                              Command="{Binding ForceNowCommand}"
                              FontSize="11" Padding="8 2" Margin="0 0 10 0"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{x:Static loc:SettingsText.TipResetTheInMemory}" />
                      <TextBlock Grid.Column="4" Text="{Binding ForceStatus}"
                                 FontSize="10" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 Text="{Binding MinText}"
                                 FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Other -->
            <StackPanel Spacing="2">
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="3" Padding="8 5" Margin="0 0 0 4">
                <TextBlock Text="{x:Static loc:SettingsText.Other}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
              </Border>
              <ItemsControl ItemsSource="{Binding TimerVm.OtherRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimerRowVm">
                    <Grid ColumnDefinitions="200,70,Auto,Auto,*" Margin="4 3">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                 FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{ReflectionBinding Interval, Mode=TwoWay}"
                               FontSize="12" Padding="4 3"
                               HorizontalContentAlignment="Right"
                               VerticalContentAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Unit, StringFormat=' {0}'}"
                                 FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center" Margin="4 0 12 0" />
                      <Button Grid.Column="3"
                              Content="{x:Static loc:SettingsText.ForceNow}"
                              Command="{Binding ForceNowCommand}"
                              FontSize="11" Padding="8 2" Margin="0 0 10 0"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{x:Static loc:SettingsText.TipResetTheInMemory}" />
                      <TextBlock Grid.Column="4" Text="{Binding ForceStatus}"
                                 FontSize="10" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 Text="{Binding MinText}"
                                 FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4" Padding="10 8" Margin="0 8 0 0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding TimerVm.SaveStatus}"
                       FontSize="11" Foreground="{DynamicResource GoodBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{x:Static loc:SettingsText.SaveTimers}"
                    Command="{Binding TimerVm.SaveCommand}"
                    Padding="14 4" />
          </Grid>
        </Border>

      </Grid>
    </TabItem>

    <!-- ══ Polling ══════════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabPolling}">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14">

          <!-- Structure Name Resolution -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.StructureNameResolution}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.WhenResolvingUnknownStructureNote}" />

                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.CharacterLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding PollingVm.StructureNameChars}"
                            SelectedItem="{Binding PollingVm.SelectedStructureNameChar}"
                            HorizontalAlignment="Stretch"
                            MaxDropDownHeight="200" />
                </Grid>

                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.SelectNoneTryAllNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Hidden entirely where neither a Windows service nor systemd is available, rather than
               shown disabled: a control that can never do anything is worse than no control at all.
               The wording comes from the view model because the two platforms differ in substance —
               when it starts, what it costs, and what it can reach — not only in the name. -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding PollingVm.ServiceSupported}">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{Binding PollingVm.ServiceSectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{Binding PollingVm.ServiceIntro}" />

                <TextBlock FontSize="11" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                           Text="{Binding PollingVm.ServiceDatabaseNote}" />

                <!-- ⚠️ Reachable by switching to SQLite after installing, and broken once it is: the
                     worker holds the file and this application cannot open it. Said here rather
                     than left to be discovered as an app that will not start. -->
                <Border Background="{DynamicResource BadSurfaceBrush}" BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="8 6"
                        IsVisible="{Binding PollingVm.ServiceStrandedOnSqlite}">
                  <TextBlock FontSize="11" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap"
                             Text="{x:Static loc:SettingsText.ABackgroundServiceIsNote}" />
                </Border>

                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.StatusLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBlock Grid.Column="1" Text="{Binding PollingVm.ServiceStatus}"
                             Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                </Grid>

                <!-- Which executable it actually launches. Shown whenever one is installed, not
                     only when it is wrong: "running" means nothing until you know which copy is
                     running — and on Linux this is the line that goes stale, because a tarball can
                     be moved and an AppImage is downloaded again under a new filename. -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                      IsVisible="{Binding PollingVm.ServiceInstalled}">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PollingVm.ServiceRunsLabel}"
                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Top" Margin="0 0 10 0" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PollingVm.ServiceExePath}"
                             Foreground="{DynamicResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" />

                  <!-- Which database, because that is the mismatch that costs something. Windows
                       only: a systemd user unit reads the same settings this window does, so there
                       is no second copy of the connection to fall out of step. -->
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.DatabaseLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Top" Margin="0 2 10 0"
                             IsVisible="{Binding PollingVm.ServiceIsWindows}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PollingVm.ServiceDatabase}"
                             Foreground="{DynamicResource TextDimBrush}" FontSize="11" TextWrapping="Wrap"
                             IsVisible="{Binding PollingVm.ServiceIsWindows}" />
                </Grid>

                <Border Background="{DynamicResource WarnSurfaceBrush}" BorderBrush="{DynamicResource WarnSurfaceBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="8 6"
                        IsVisible="{Binding PollingVm.ServiceNeedsUpdate}">
                  <StackPanel Spacing="4">
                    <TextBlock FontSize="11" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                               Text="{Binding PollingVm.ServiceUpdateReason}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                               Text="{Binding PollingVm.ServiceUpdateNote}" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0"
                            IsEnabled="{Binding PollingVm.ServiceIdle}">
                  <!-- Disabled rather than hidden on SQLite: the note above says why it cannot be
                       used, and a button that vanishes leaves that explanation pointing at
                       nothing. Remove and Stop stay enabled either way — they are how you get out
                       of the state this prevents you entering. -->
                  <Button x:Name="ServiceInstallButton" Content="{Binding PollingVm.ServiceInstallButtonText}"
                          Click="OnServiceInstallClick"
                          IsVisible="{Binding !PollingVm.ServiceInstalled}"
                          IsEnabled="{Binding PollingVm.ServiceAvailable}" />

                  <Button x:Name="ServiceRepointButton" Content="{Binding PollingVm.ServiceRepointButtonText}"
                          Click="OnServiceRepointClick"
                          IsVisible="{Binding PollingVm.ServiceNeedsUpdate}" />

                  <Button x:Name="ServiceStartButton" Content="{x:Static loc:SettingsText.Start}"
                          Click="OnServiceStartClick"
                          IsVisible="{Binding PollingVm.ServiceInstalled}"
                          IsEnabled="{Binding !PollingVm.ServiceRunning}" />

                  <Button x:Name="ServiceStopButton" Content="{x:Static loc:SettingsText.Stop}"
                          Click="OnServiceStopClick"
                          IsVisible="{Binding PollingVm.ServiceInstalled}"
                          IsEnabled="{Binding PollingVm.ServiceRunning}" />

                  <Button x:Name="ServiceRemoveButton" Content="{Binding PollingVm.ServiceRemoveButtonText}"
                          Click="OnServiceRemoveClick"
                          IsVisible="{Binding PollingVm.ServiceInstalled}" />
                </StackPanel>

                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{Binding PollingVm.ServiceInstallNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ⚠️ Its own section, not a line at the bottom of the service one. The tray icon has
               nothing to do with the service: it is useful with no service installed at all, and it
               was previously nested inside a border that is hidden where no service mechanism
               exists — so on a machine without one it silently could not be turned on. -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.NotificationAreaIcon}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <!-- A separate process, and it has to be: a Windows service runs in session 0 with
                     no desktop and cannot draw, and an icon inside this window would vanish exactly
                     when somebody wants it — while the application is closed. -->
                <CheckBox IsChecked="{Binding PollingVm.TrayAtLogon}"
                          Content="{Binding PollingVm.TrayCheckboxText}"
                          FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0 -2 0 0"
                           Text="{x:Static loc:SettingsText.ASmallSeparateProcessNote}" />

                <TextBlock Text="{Binding PollingVm.TrayStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding PollingVm.TrayStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Game Logs ══════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabGameLogs}">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14">

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.GameLogImport}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.ReadsEvesOwnGameNote}" />

                <CheckBox IsChecked="{Binding GameLogVm.Enabled}"
                          Content="{x:Static loc:SettingsText.ImportGameLogsOnBy}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />

                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.ThisCapturesActivityFromNote}" />

                <TextBlock Text="{Binding GameLogVm.Status}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />

                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.ParsePositionIsRememberedNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.LogFolders}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.LeaveTheListEmptyNote}" />

                <ListBox ItemsSource="{Binding GameLogVm.Directories}"
                         SelectedItem="{Binding GameLogVm.SelectedDirectory}"
                         MaxHeight="110" FontSize="11" Background="{DynamicResource SurfacePanelAltBrush}" />

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding GameLogVm.NewDirectory}"
                           Watermark="C:\Users\you\Documents\EVE\logs\Gamelogs  or  \\PC2\eve-logs" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6 0 0 0">
                    <Button Content="{x:Static loc:SettingsText.Add}"    Command="{Binding GameLogVm.AddDirectoryCommand}"    Padding="10 3" />
                    <Button Content="{x:Static loc:SettingsText.Remove}" Command="{Binding GameLogVm.RemoveDirectoryCommand}" Padding="10 3" />
                    <Button Content="{x:Static loc:SettingsText.Detect}" Command="{Binding GameLogVm.DetectDirectoryCommand}" Padding="10 3" />
                    <Button Content="{x:Static loc:SettingsText.Open}"   Command="{Binding GameLogVm.OpenDirectoryCommand}"   Padding="10 3" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="{x:Static loc:SettingsText.CurrentlyReadingLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 4 0 0" />
                <SelectableTextBlock Text="{Binding GameLogVm.ResolvedPaths}" FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                     FontFamily="Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Historical import: an explicit, user-initiated action. Enabling the
               importer above only picks up NEW activity, so the amount of history to
               process is chosen here BEFORE anything runs, with the cost shown. -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.ImportPastLogs}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.TurningTheImporterOnNote}" />

                <Grid ColumnDefinitions="Auto,80,Auto" IsEnabled="{Binding !GameLogVm.IsImporting}">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.ImportLogsFromTheLastLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding GameLogVm.HistoryDays}" />
                  <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.N0AllHistory}" Foreground="{DynamicResource TextDimBrush}"
                             FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>

                <TextBlock Text="{Binding GameLogVm.EstimateText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{x:Static loc:SettingsText.StartImport}" Command="{Binding GameLogVm.ImportHistoryCommand}"
                          IsEnabled="{Binding !GameLogVm.IsImporting}" Padding="14 4" />
                  <Button Content="{x:Static loc:SettingsText.Recount}" Command="{Binding GameLogVm.EstimateCommand}"
                          IsEnabled="{Binding !GameLogVm.IsImporting}" Padding="14 4" />
                  <Button Content="{x:Static loc:SettingsText.Cancel}" Command="{Binding GameLogVm.CancelImportCommand}"
                          IsVisible="{Binding GameLogVm.IsImporting}" Padding="14 4" />
                </StackPanel>

                <!-- Real determinate progress: file X of Y, so a large historical
                     import shows how much is left rather than just spinning. -->
                <StackPanel Spacing="4" IsVisible="{Binding GameLogVm.IsImporting}">
                  <ProgressBar Minimum="0"
                               Maximum="{Binding GameLogVm.ProgressTotal}"
                               Value="{Binding GameLogVm.ProgressCurrent}"
                               Height="14" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfacePanelAltBrush}" />
                  <TextBlock Text="{Binding GameLogVm.ProgressText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding GameLogVm.ProgressText}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.Options}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <Grid ColumnDefinitions="Auto,80,Auto">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.CheckForNewLinesEveryLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding GameLogVm.ScanSeconds}" />
                </Grid>

                <CheckBox IsChecked="{Binding GameLogVm.StoreUnmatched}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                          Content="{x:Static loc:SettingsText.KeepLinesThatNoRule}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.RecommendedEvesLogFormatNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Chat Logs ══════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabChatLogs}">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14">

          <Border BorderBrush="{DynamicResource WarnSurfaceBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfacePanelBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.ChatLogImport}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.UnlikeGameLogsChatNote}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.NotePrivateConversationsAppearNote}" />

                <CheckBox IsChecked="{Binding ChatLogVm.Enabled}"
                          Content="{x:Static loc:SettingsText.ImportChatLogs}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />

                <TextBlock Text="{Binding ChatLogVm.Status}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.LogFolders}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.LeaveTheListEmptyNote2}" />

                <ListBox ItemsSource="{Binding ChatLogVm.Directories}"
                         SelectedItem="{Binding ChatLogVm.SelectedDirectory}"
                         MaxHeight="110" FontSize="11" Background="{DynamicResource SurfacePanelAltBrush}" />

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding ChatLogVm.NewDirectory}"
                           Watermark="C:\Users\you\Documents\EVE\logs\Chatlogs  or  \\PC2\eve-logs" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6 0 0 0">
                    <Button Content="{x:Static loc:SettingsText.Add}"    Command="{Binding ChatLogVm.AddDirectoryCommand}"    Padding="10 3" />
                    <Button Content="{x:Static loc:SettingsText.Remove}" Command="{Binding ChatLogVm.RemoveDirectoryCommand}" Padding="10 3" />
                    <Button Content="{x:Static loc:SettingsText.Detect}" Command="{Binding ChatLogVm.DetectDirectoryCommand}" Padding="10 3" />
                    <Button Content="{x:Static loc:SettingsText.Open}"   Command="{Binding ChatLogVm.OpenDirectoryCommand}"   Padding="10 3" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="{x:Static loc:SettingsText.CurrentlyReadingLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0 4 0 0" />
                <SelectableTextBlock Text="{Binding ChatLogVm.ResolvedPaths}" FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                     FontFamily="Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.ChannelsToStore}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.OnlyTickedChannelsAreNote}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{x:Static loc:SettingsText.DiscoverChannels}" Command="{Binding ChatLogVm.DiscoverCommand}"
                          IsEnabled="{Binding !ChatLogVm.IsBusy}" Padding="14 4" />
                  <Button Content="{x:Static loc:SettingsText.UntickAll}" Command="{Binding ChatLogVm.SelectNoneCommand}"
                          IsEnabled="{Binding !ChatLogVm.IsBusy}" Padding="14 4" />
                </StackPanel>

                <Grid ColumnDefinitions="*,84" Margin="8 0 8 0">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.ChannelLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" />
                  <TextBlock Grid.Column="1" Text="{x:Static loc:SettingsText.IntelLabel}"   FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}"
                             HorizontalAlignment="Center" />
                </Grid>

                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="3"
                        Background="{DynamicResource SurfacePanelAltBrush}" MaxHeight="220">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatLogVm.Channels}" Margin="8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatChannelViewModel">
                          <Grid ColumnDefinitions="*,84" Margin="0 1">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Content="{Binding Name}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsIntel}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip.Tip="{x:Static loc:SettingsText.TipParseThisChannelForSightings}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>

                <TextBlock Text="{Binding ChatLogVm.SelectionText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />

                <!-- Intel parsing -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0 1 0 0" Padding="0 8 0 0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static loc:SettingsText.IntelLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ChatLogVm.IntelHelp}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{x:Static loc:SettingsText.ParseStoredHistory}"
                              Command="{Binding ChatLogVm.ParseIntelHistoryCommand}"
                              IsEnabled="{Binding !ChatLogVm.IsBusy}" Padding="14 4" />
                      <TextBlock Text="{Binding ChatLogVm.IntelStatus}" FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.ImportPastChat}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.AsWithGameLogsNote}" />

                <Grid ColumnDefinitions="Auto,80,Auto" IsEnabled="{Binding !ChatLogVm.IsBusy}">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.ImportChatFromTheLastLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding ChatLogVm.HistoryDays}" />
                  <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.N0AllHistory}" Foreground="{DynamicResource TextDimBrush}"
                             FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>

                <TextBlock Text="{Binding ChatLogVm.EstimateText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{x:Static loc:SettingsText.StartImport}" Command="{Binding ChatLogVm.ImportHistoryCommand}"
                          IsEnabled="{Binding !ChatLogVm.IsBusy}" Padding="14 4" />
                  <Button Content="{x:Static loc:SettingsText.Cancel}" Command="{Binding ChatLogVm.CancelImportCommand}"
                          IsVisible="{Binding ChatLogVm.IsBusy}" Padding="14 4" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding ChatLogVm.IsBusy}">
                  <ProgressBar Minimum="0"
                               Maximum="{Binding ChatLogVm.ProgressTotal}"
                               Value="{Binding ChatLogVm.ProgressCurrent}"
                               Height="14" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfacePanelAltBrush}" />
                  <TextBlock Text="{Binding ChatLogVm.ProgressText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding ChatLogVm.ProgressText}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Map Data ══════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabMapData}">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14" x:DataType="vm:MapStatsSettingsViewModel" DataContext="{Binding MapStatsVm}">

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="14" Spacing="10">
              <TextBlock Text="{x:Static loc:SettingsText.MapStatistics}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                         Text="{x:Static loc:SettingsText.JumpsKillsSovereigntyIndustryNote}" />

              <CheckBox IsChecked="{Binding Enabled}" Content="{x:Static loc:SettingsText.CollectMapStatistics}"
                        FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

              <Grid ColumnDefinitions="Auto,90,Auto,90,*" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.BackfillDays}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0 0 8 0" />
                <TextBox Grid.Column="1" Text="{Binding BackfillDays}" FontSize="11.5" />
                <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.KeepHourlyDetailDays}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="16 0 8 0" />
                <TextBox Grid.Column="3" Text="{Binding KeepHourlyDays}" FontSize="11.5" />
              </Grid>

              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                         Text="{x:Static loc:SettingsText.PastTheHourlyWindowNote}" />
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="14" Spacing="10">
              <TextBlock Text="{x:Static loc:SettingsText.History}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

              <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
              <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"
                           Foreground="{DynamicResource InfoBrush}" Background="{DynamicResource SurfacePanelBrush}" />
              <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="Wrap" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static loc:SettingsText.BackfillNow}" Command="{Binding StartBackfillCommand}"
                        IsEnabled="{Binding !IsRunning}"
                        Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}"
                        BorderThickness="1" Padding="12 4" FontSize="11" />
                <Button Content="{x:Static loc:SettingsText.Cancel}" Command="{Binding CancelBackfillCommand}"
                        IsEnabled="{Binding IsRunning}"
                        Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource BadBrush}" BorderBrush="{DynamicResource BadSurfaceBrush}"
                        BorderThickness="1" Padding="12 4" FontSize="11" />
                <Button Content="{x:Static loc:SettingsText.RefreshCurrentHour}" Command="{Binding RefreshNowCommand}"
                        Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" Padding="12 4" FontSize="11" />
              </StackPanel>

              <TextBlock Text="{Binding PollStatus}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="14" Spacing="8">
              <TextBlock Text="{x:Static loc:SettingsText.Coverage}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding Coverage}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         FontFamily="Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace" TextWrapping="NoWrap" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Kill Mails ═════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabKillMails}">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14" x:DataType="vm:ZkillboardSettingsViewModel" DataContext="{Binding ZkbVm}">

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.ZkillboardKillImport}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.EsiOnlyReturnsANote}" />

                <CheckBox IsChecked="{Binding Enabled}"
                          Content="{x:Static loc:SettingsText.EnableZkillboardKillImport}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />

                <TextBlock Text="{Binding LiveStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.Scope}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <RadioButton GroupName="ZkbScope" IsChecked="{Binding ScopeIsMineAndCorp}"
                             Content="{x:Static loc:SettingsText.MyCharactersCorpOnly}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="22 0 0 0" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.LiveCapturePollsZkillboardNote}" />

                <RadioButton GroupName="ZkbScope" IsChecked="{Binding ScopeIsAll}"
                             Content="{x:Static loc:SettingsText.CaptureAllKills}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 6 0 0" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="22 0 0 0" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.LiveCaptureSwitchesToNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.LivePollInterval}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8" IsEnabled="{Binding ScopeIsMineAndCorp}">
                <Grid ColumnDefinitions="Auto,80,Auto">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.CheckZkillboardForNewNote}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding PollIntervalSeconds}" />
                  <TextBlock Grid.Column="2" Text="60–3600" Foreground="{DynamicResource TextDimBrush}"
                             FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.NotUsedInAllNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Backfill: manual button for initial history, plus an automatic hourly
               check that catches up on any gap since the app last ran — both drive the
               same progress state below. -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.BackfillHistory}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.PullsZkillboardsDailyKillNote}" />

                <Grid ColumnDefinitions="Auto,80,Auto" IsEnabled="{Binding !IsImporting}">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.BackfillTheLastDaysLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding BackfillDays}" />
                  <TextBlock Grid.Column="2" Text="{Binding LastFullDayText, StringFormat={x:Static loc:SettingsText.FmtLastFullDay}}"
                             Foreground="{DynamicResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{x:Static loc:SettingsText.StartBackfill}" Command="{Binding BackfillCommand}"
                          IsEnabled="{Binding !IsImporting}" Padding="14 4" />
                  <Button Content="{x:Static loc:SettingsText.Cancel}" Command="{Binding CancelBackfillCommand}"
                          IsVisible="{Binding IsImporting}" Padding="14 4" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding IsImporting}">
                  <ProgressBar Minimum="0"
                               Maximum="{Binding ProgressTotal}"
                               Value="{Binding ProgressCurrent}"
                               Height="14" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfacePanelAltBrush}" />
                  <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProgressText}" />
                </StackPanel>

                <TextBlock Text="{Binding BackfillStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Submission runs the other direction: kills we have that zKillboard doesn't.
               Only considers kills inside the backfilled/live coverage window, since a
               kill from before we ever looked at zKillboard tells us nothing. -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.PostKillsToZkillboard}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.SubmitsKillmailsThisAppNote}" />

                <CheckBox IsChecked="{Binding PostEnabled}"
                          Content="{x:Static loc:SettingsText.PostKillmailsToZkillboard}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />

                <TextBlock Text="{Binding CoverageFromText, StringFormat={x:Static loc:SettingsText.FmtCoveredFrom}}"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.ThatIsTheOldestNote}" />

                <TextBlock Text="{Binding PostStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Corp Top 10 ════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabCorpTop10}">
      <Grid ColumnDefinitions="*,8,*" Margin="0 8 0 0" DataContext="{Binding CorpTop10Vm}">

        <!-- Left: what every section is called. Scrolls, because twelve fields and a
             prefix do not fit a settings pane at every window height. -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
              <TextBlock Text="{x:Static loc:SettingsText.Top10ListTitles}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <TextBlock Grid.Row="1" Margin="10 8 10 6" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Text="{x:Static loc:SettingsText.TheHeadingEachSectionNote}" />

            <ScrollViewer Grid.Row="2" Margin="10 0 10 6">
              <StackPanel Spacing="10">

                <ItemsControl ItemsSource="{Binding Titles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Top10TitleRowVm">
                      <StackPanel Margin="0 0 0 8">
                        <TextBlock Text="{Binding DefaultTitle}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFaintBrush}" Margin="2 0 0 2" />
                        <TextBox Text="{Binding Title}" Watermark="{Binding DefaultTitle}"
                                 FontSize="11" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDefaultBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="3" Padding="8 5">
                  <TextBlock Text="{x:Static loc:SettingsText.SummaryTitles}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                             FontSize="12" />
                </Border>

                <StackPanel>
                  <TextBlock Text="{x:Static loc:SettingsText.SummaryHeaderPrefixLabel}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextFaintBrush}" Margin="2 0 0 2" />
                  <TextBox Text="{Binding HeaderPrefix}"
                           Watermark="{x:Static loc:SettingsText.HintPutInFrontOf}"
                           FontSize="11" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                           BorderBrush="{DynamicResource BorderDefaultBrush}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding SummaryTitles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Top10TitleRowVm">
                      <StackPanel Margin="0 0 0 8">
                        <TextBlock Text="{Binding DefaultTitle}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFaintBrush}" Margin="2 0 0 2" />
                        <TextBox Text="{Binding Title}" Watermark="{Binding DefaultTitle}"
                                 FontSize="11" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDefaultBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="3" Content="{x:Static loc:SettingsText.SaveTitles}" Command="{Binding SaveTitlesCommand}"
                    Margin="10 0 10 10" HorizontalAlignment="Left"
                    FontSize="11" Padding="12 4"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                    BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
          </Grid>
        </Border>

        <!-- Right: who is left out. The picker sits directly over the list it feeds. -->
        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
          <Grid RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
              <TextBlock Text="{x:Static loc:SettingsText.Top10ExcludeList}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <StackPanel Grid.Row="1" Margin="10 8 10 6" Spacing="6">
              <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                         Text="{x:Static loc:SettingsText.AnyoneHereIsLeftNote}" />

              <Grid ColumnDefinitions="120,8,*,8,Auto">
                <ComboBox Grid.Column="0" ItemsSource="{Binding EntityTypes}"
                          SelectedItem="{Binding EntityType}"
                          HorizontalAlignment="Stretch" FontSize="11"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />

                <AutoCompleteBox Grid.Column="2"
                                 AsyncPopulator="{Binding SearchPopulator}"
                                 SelectedItem="{Binding SearchMatch}"
                                 Text="{Binding SearchText}"
                                 ValueMemberBinding="{Binding EntityName}"
                                 FilterMode="None" MinimumPrefixLength="2"
                                 Watermark="{x:Static loc:SettingsText.HintTypeTwoLettersOfThe}"
                                 FontSize="11" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDefaultBrush}" />

                <Button Grid.Column="4" Content="{x:Static loc:SettingsText.Add}" Command="{Binding AddCommand}"
                        FontSize="11" Padding="12 4"
                        Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                        BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
              </Grid>

              <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <ListBox Grid.Row="2" ItemsSource="{Binding Excludes}"
                     Background="Transparent" SelectionMode="Single" Margin="4 0 4 4">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CorpTop10ExcludeRowVm">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Display}"
                               FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Static loc:SettingsText.Remove}"
                            Command="{Binding $parent[ListBox].((vm:CorpTop10SettingsViewModel)DataContext).RemoveCommand}"
                            CommandParameter="{Binding}"
                            FontSize="10" Padding="8 2"
                            Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

      </Grid>
    </TabItem>

    <!-- ══ Agent ═══════════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabAiAgent}">
      <!-- Four sub-tabs over one view model and ONE save bar: the tab had grown to two hundred
           lines of sections, and Save applies to all of them, so it stays outside the sub-tabs
           where it is visible whichever one is showing. -->
      <Grid RowDefinitions="*,Auto" Margin="0 8 0 0"
            x:DataType="vm:AgentSettingsViewModel" DataContext="{Binding AgentVm}">
        <TabControl Grid.Row="0" Padding="0">

        <TabItem Header="{x:Static loc:SettingsText.TabAgent}">
          <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0 0 8 0">
                <!-- Master enable -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{Binding HeaderTitleText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="6">
                      <CheckBox Content="{Binding EnableCheckboxText}"
                                IsChecked="{Binding IsEnabled}" />
                      <TextBlock Text="{Binding EnableHelpText}"
                                 FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- The models -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{x:Static loc:SettingsText.Models}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.EveryModelTheAgentNote}" />

                      <Grid ColumnDefinitions="*,Auto" Margin="0 4 0 0">
                        <ListBox Grid.Column="0" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                                 MinHeight="60" MaxHeight="150"
                                 Background="{DynamicResource SurfaceInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelProfileVm">
                              <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="8 0 0 0">
                          <Button Content="{x:Static loc:SettingsText.Add}" Command="{Binding AddModelCommand}" Padding="10 3" HorizontalAlignment="Stretch" />
                          <Button Content="{x:Static loc:SettingsText.Remove}" Command="{Binding RemoveModelCommand}" IsEnabled="{Binding CanRemoveModel}"
                                  Padding="10 3" HorizontalAlignment="Stretch" ToolTip.Tip="{x:Static loc:SettingsText.TipAtLeastOneModelStays}" />
                        </StackPanel>
                      </Grid>

                      <!-- The selected model -->
                      <Border IsVisible="{Binding HasSelectedModel}" Margin="0 6 0 0" Padding="10 8"
                              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel Spacing="8" DataContext="{Binding SelectedModel}" x:DataType="vm:ModelProfileVm">
                          <TextBlock Text="{x:Static loc:SettingsText.Name}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                          <TextBox Text="{Binding Name}" Watermark="{Binding NameWatermark}" />

                          <TextBlock Text="{x:Static loc:SettingsText.Service}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                          <ComboBox ItemsSource="{Binding ServiceOptions}" SelectedItem="{Binding SelectedService}" HorizontalAlignment="Stretch" />

                          <!-- The service's key, before the model: the list of models is asked for with
                               it. One key per service, shared by every model on it. -->
                          <StackPanel IsVisible="{Binding ShowClaude}" Spacing="8">
                            <TextBlock Text="{x:Static loc:SettingsText.ClaudeAnthropicApiKey}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding Owner.ClaudeApiKey}" Watermark="{x:Static loc:SettingsText.HintSkAnt}" PasswordChar="•" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                       Text="{x:Static loc:SettingsText.OneKeyForEveryNote}" />
                            <HyperlinkButton Content="{x:Static loc:SettingsText.GetYourAnthropicApi}"
                                             NavigateUri="https://console.anthropic.com/settings/keys"
                                             FontSize="10" Padding="0" HorizontalAlignment="Left" />
                          </StackPanel>

                          <StackPanel IsVisible="{Binding ShowOpenAi}" Spacing="8">
                            <TextBlock Text="{x:Static loc:SettingsText.OpenaiApiKey}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding Owner.OpenAiApiKey}" Watermark="{x:Static loc:SettingsText.HintSk}" PasswordChar="•" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                       Text="{x:Static loc:SettingsText.OneKeyForEveryNote2}" />
                            <HyperlinkButton Content="{x:Static loc:SettingsText.GetYourOpenaiApi}"
                                             NavigateUri="https://platform.openai.com/api-keys"
                                             FontSize="10" Padding="0" HorizontalAlignment="Left" />
                          </StackPanel>

                          <StackPanel IsVisible="{Binding ShowEndpoint}" Spacing="8">
                            <TextBlock Text="{x:Static loc:SettingsText.ServerAddress}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding Endpoint}" Watermark="http://gpu-box:11434" />
                          </StackPanel>

                          <!-- The model, from the service's own list; typed only when there is no list. -->
                          <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                          <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" IsVisible="{Binding ModelList.IsListed}"
                                      ItemsSource="{Binding ModelList.Listings}" SelectedItem="{Binding ModelList.Selected}"
                                      HorizontalAlignment="Stretch" MaxDropDownHeight="360">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="agent:ModelListing">
                                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="0" IsVisible="{Binding !ModelList.IsListed}"
                                     Text="{Binding Model}" Watermark="{Binding ModelWatermark}" />
                            <Button Grid.Column="1" Content="↺" Command="{Binding ModelList.RefreshCommand}"
                                    Padding="8 4" Margin="6 0 0 0" VerticalAlignment="Stretch"
                                    ToolTip.Tip="{x:Static loc:SettingsText.TipAskTheServiceFor}" />
                          </Grid>
                          <TextBlock Text="{Binding ModelList.Status}" IsVisible="{Binding ModelList.HasStatus}"
                                     FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ModelHelp}" IsVisible="{Binding ModelHelp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />

                          <StackPanel IsVisible="{Binding ShowEndpoint}" Spacing="4">
                            <CheckBox IsChecked="{Binding Think}" Content="{x:Static loc:SettingsText.LetItThinkBeforeAnswering}" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                       Text="{x:Static loc:SettingsText.ForModelsThatThinkNote}" />
                          </StackPanel>

                          <StackPanel IsVisible="{Binding ShowClaude}" Spacing="8" Margin="0 4 0 0">
                            <TextBlock Text="{x:Static loc:SettingsText.PromptCacheLifetime}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <ComboBox ItemsSource="{Binding Owner.ClaudeCacheTtlOptions}"
                                      SelectedItem="{Binding Owner.ClaudeCacheTtlOption}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                       Text="{x:Static loc:SettingsText.AnthropicKeepsTheInstructionsNote}" />
                          </StackPanel>

                          <StackPanel Spacing="6" Margin="0 4 0 0">
                            <StackPanel.Styles>
                              <!-- Classes, not a local Foreground: a local value would beat these. -->
                              <Style Selector="TextBlock.test">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                              </Style>
                              <Style Selector="TextBlock.test.ok">
                                <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                              </Style>
                              <Style Selector="TextBlock.test.failed">
                                <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                              </Style>
                            </StackPanel.Styles>
                            <Button Content="{x:Static loc:SettingsText.TestThisModel}" Command="{Binding TestModelCommand}"
                                    Padding="12 4" HorizontalAlignment="Left"
                                    ToolTip.Tip="{x:Static loc:SettingsText.TipAsksItForOne}" />
                            <TextBlock Classes="test" Classes.ok="{Binding TestOk}" Classes.failed="{Binding TestFailed}"
                                       Text="{Binding TestStatus}" IsVisible="{Binding HasTestStatus}"
                                       FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- The roles -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{x:Static loc:SettingsText.Roles}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                      <StackPanel.DataTemplates>
                        <DataTemplate x:DataType="vm:ModelChoice">
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </StackPanel.DataTemplates>

                      <!-- Conversation -->
                      <TextBlock Text="{x:Static loc:SettingsText.Conversation}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.TalksWithYouAndNote}" />
                      <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <ComboBox ItemsSource="{Binding ConversationChoices}" SelectedItem="{Binding SelectedConversationModel}"
                                HorizontalAlignment="Stretch" />
                      <TextBlock Text="{x:Static loc:SettingsText.IfItStopsAnsweringNote}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <ComboBox ItemsSource="{Binding FallbackChoices}" SelectedItem="{Binding SelectedConversationFallback}"
                                HorizontalAlignment="Stretch" />
                      <CheckBox IsChecked="{Binding ConversationAnnounce}"
                                Content="{x:Static loc:SettingsText.SaySoWhenIt}" />

                      <!-- Data -->
                      <TextBlock Text="{x:Static loc:SettingsText.QuestionsAboutYourData}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 10 0 0" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.AnythingThatNeedsYourNote}" />
                      <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <ComboBox ItemsSource="{Binding AnalystChoices}" SelectedItem="{Binding SelectedAnalystModel}"
                                HorizontalAlignment="Stretch" />
                      <StackPanel IsVisible="{Binding IsSplit}" Spacing="8">
                        <TextBlock Text="{x:Static loc:SettingsText.IfItStopsAnsweringNote}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                        <ComboBox ItemsSource="{Binding FallbackChoices}" SelectedItem="{Binding SelectedAnalystFallback}"
                                  HorizontalAlignment="Stretch" />
                        <CheckBox IsChecked="{Binding AnalystAnnounce}"
                                  Content="{x:Static loc:SettingsText.SaySoWhenIt}" />

                        <TextBlock Text="{x:Static loc:SettingsText.SendAMessageToNote}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                        <TextBox Text="{Binding HandOffWhen}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="70" VerticalContentAlignment="Top" />
                        <Button Content="{x:Static loc:SettingsText.ResetToTheDefault}" Command="{Binding ResetHandOffWhenCommand}"
                                Padding="10 3" HorizontalAlignment="Left" />
                      </StackPanel>

                      <!-- Summaries -->
                      <TextBlock Text="{x:Static loc:SettingsText.Summaries}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 10 0 0" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.CompactsOlderMessagesWhenNote}" />
                      <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <ComboBox ItemsSource="{Binding AnalystChoices}" SelectedItem="{Binding SelectedSummaryModel}"
                                HorizontalAlignment="Stretch" />

                      <TextBlock Text="{Binding RoleSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextWrapping="Wrap" Margin="0 8 0 0" />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- When a model changes -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{x:Static loc:SettingsText.WhenAModelChanges}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.SaidForARoleNote}" />
                      <TextBlock Text="{x:Static loc:SettingsText.FallingOver}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <TextBox Text="{Binding ModelFailoverMessage}" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Static loc:SettingsText.ComingBack}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <TextBox Text="{Binding ModelReturnMessage}" TextWrapping="Wrap" />

                      <Grid ColumnDefinitions="Auto,130,Auto" RowDefinitions="Auto,Auto" Margin="0 4 0 0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.AtLeast}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="0 0 8 0" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ModelSwitchGapMinutes}"
                                       Minimum="0" Maximum="240" Increment="1" FormatString="0" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static loc:SettingsText.MinutesBetweenOneChangeNote}"
                                   FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8 0 0 0" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.UpFor}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="0 6 8 0" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ModelPreferredUpMinutes}"
                                       Minimum="0" Maximum="240" Increment="1" FormatString="0" Margin="0 6 0 0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static loc:SettingsText.MinutesWithoutABreakNote}"
                                   FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8 6 0 0" />
                      </Grid>
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.AModelThatStopsNote}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Context management -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{x:Static loc:SettingsText.ContextManagement}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">

                      <CheckBox Content="{x:Static loc:SettingsText.PersistConversationHistoryAcrossSessions}"
                                IsChecked="{Binding PersistHistory}" />
                      <TextBlock Text="{Binding HistoryHelpText}"
                                 FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />

                      <TextBlock Text="{x:Static loc:SettingsText.SummarizationThresholdEstimatedTokens}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                      <Grid ColumnDefinitions="120,*">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SummarizationThreshold}"
                                 Watermark="50000" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Static loc:SettingsText.Tokens}"
                                   FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                                   VerticalAlignment="Center" Margin="8 0 0 0" />
                      </Grid>
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{Binding SummarizationHelpText}" />

                    </StackPanel>
                  </Grid>
                </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{x:Static loc:SettingsText.TabPersonalisation}">
          <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0 0 8 0">
                <!-- Personalisation -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{x:Static loc:SettingsText.Personalisation}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.EverythingOnThisTabNote}" />
                      <TextBlock Text="{x:Static loc:SettingsText.AgentName}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <TextBox Text="{Binding AgentName}"
                               Watermark="{x:Static agent:AgentSettings.DefaultAgentName}" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{Binding DefaultAgentNameHelpText}" />

                      <TextBlock Text="{x:Static loc:SettingsText.ResponseVerbosity}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                      <ComboBox ItemsSource="{Binding VerbosityOptions}"
                                SelectedItem="{Binding Verbosity}"
                                HorizontalAlignment="Stretch" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.ConciseShortDirectAnswersNote}" />

                      <TextBlock Text="{x:Static loc:SettingsText.YourName}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 6 0 0" />
                      <TextBox Text="{Binding UserName}"
                               Watermark="{x:Static agent:AgentSettings.DefaultUserName}" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{Binding UserNameHelpText}" />

                      <TextBlock Text="{x:Static loc:SettingsText.StandingInstructions}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 6 0 0" />
                      <TextBox Text="{Binding UserGuidance}"
                               AcceptsReturn="True" TextWrapping="Wrap"
                               MinHeight="150" MaxHeight="400" VerticalContentAlignment="Top"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
 />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{Binding UserGuidanceHelpText}" />
                    </StackPanel>
                  </Grid>
                </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{x:Static loc:SettingsText.TabVoice}">
          <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0 0 8 0">

                <!-- The voices, in order of preference -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{x:Static loc:SettingsText.Voices}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                      <CheckBox IsChecked="{Binding SpeechOn}" Content="{x:Static loc:SettingsText.SpeakTheAgentsReplies}" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.InOrderOfPreferenceNote}" />

                      <Grid ColumnDefinitions="*,Auto" Margin="0 4 0 0">
                        <ListBox Grid.Column="0" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                                 MinHeight="70" MaxHeight="170"
                                 Background="{DynamicResource SurfaceInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VoiceProfileVm">
                              <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="8 0 0 0">
                          <Button Content="{x:Static loc:SettingsText.Add}" Command="{Binding AddVoiceCommand}" Padding="10 3" HorizontalAlignment="Stretch" />
                          <Button Content="{x:Static loc:SettingsText.Remove}" Command="{Binding RemoveVoiceCommand}" IsEnabled="{Binding HasSelectedVoice}"
                                  Padding="10 3" HorizontalAlignment="Stretch" />
                          <Button Content="{x:Static loc:SettingsText.Up}" Command="{Binding MoveVoiceUpCommand}" IsEnabled="{Binding HasSelectedVoice}"
                                  Padding="10 3" HorizontalAlignment="Stretch" ToolTip.Tip="{x:Static loc:SettingsText.TipPreferThisVoiceOver}" />
                          <Button Content="{x:Static loc:SettingsText.Down}" Command="{Binding MoveVoiceDownCommand}" IsEnabled="{Binding HasSelectedVoice}"
                                  Padding="10 3" HorizontalAlignment="Stretch" />
                        </StackPanel>
                      </Grid>

                      <!-- The selected voice -->
                      <Border IsVisible="{Binding HasSelectedVoice}" Margin="0 6 0 0" Padding="10 8"
                              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel Spacing="8" DataContext="{Binding SelectedVoice}" x:DataType="vm:VoiceProfileVm">
                          <TextBlock Text="{x:Static loc:SettingsText.Name}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                          <TextBox Text="{Binding Name}" Watermark="{Binding NameWatermark}" />

                          <TextBlock Text="{x:Static loc:SettingsText.Engine}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                          <ComboBox ItemsSource="{Binding EngineOptions}" SelectedItem="{Binding SelectedEngine}" HorizontalAlignment="Stretch" />

                          <!-- Kokoro -->
                          <StackPanel IsVisible="{Binding ShowKokoro}" Spacing="8">
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BorderStrongBrush}"
                                       Text="{x:Static loc:SettingsText.Kokoro82mRunsFullyNote}" />
                            <TextBlock Text="{x:Static loc:SettingsText.Voice}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <ComboBox ItemsSource="{Binding KokoroVoiceLabels}" SelectedItem="{Binding SelectedKokoroVoiceLabel}"
                                      HorizontalAlignment="Stretch" />

                            <!-- The model: one for every Kokoro voice, shown with whichever is selected. -->
                            <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="{x:Static loc:SettingsText.LoadModel}" Command="{Binding Owner.DownloadKokoroModelCommand}"
                                      IsEnabled="{Binding !Owner.IsDownloadingKokoroModel}" Padding="12 4" />
                              <TextBlock Text="{x:Static loc:SettingsText.ModelLoaded}" FontSize="11" Foreground="{DynamicResource GoodBrush}"
                                         VerticalAlignment="Center" IsVisible="{Binding Owner.IsKokoroModelDownloaded}" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding Owner.IsDownloadingKokoroModel}" />
                            <TextBlock Text="{Binding Owner.KokoroModelStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                       IsVisible="{Binding Owner.KokoroModelStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BorderStrongBrush}"
                                       Text="{x:Static loc:SettingsText.OneModelServesEveryNote}" />
                          </StackPanel>

                          <!-- A server of our own -->
                          <StackPanel IsVisible="{Binding ShowLocalServer}" Spacing="8">
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BorderStrongBrush}"
                                       Text="{x:Static loc:SettingsText.AnyServerThatSpeaksNote}" />
                            <TextBlock Text="{x:Static loc:SettingsText.ServerAddressUpToNote}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding ServerUrl}" Watermark="http://gpu-box:8880/v1" />
                            <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding ServerModel}" Watermark="{x:Static loc:SettingsText.HintAsTheServerNames}" />
                            <TextBlock Text="{x:Static loc:SettingsText.Voice}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding ServerVoice}" Watermark="{x:Static loc:SettingsText.HintAsTheServerNames2}" />
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BorderStrongBrush}"
                                       Text="{x:Static loc:SettingsText.ChatterboxAFileFromNote}" />
                            <TextBlock Text="{x:Static loc:SettingsText.Speed}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <Grid ColumnDefinitions="*,52">
                              <Slider Grid.Column="0" Minimum="0.25" Maximum="4.0" Value="{Binding ServerSpeed}"
                                      TickFrequency="0.25" IsSnapToTickEnabled="True" />
                              <TextBlock Grid.Column="1" Text="{Binding ServerSpeed, StringFormat='{}{0:F2}x'}"
                                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{x:Static loc:SettingsText.ApiKeyOnlyIfNote}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding ServerApiKey}" PasswordChar="•" />
                          </StackPanel>

                          <!-- Piper -->
                          <StackPanel IsVisible="{Binding ShowPiper}" Spacing="8">
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BorderStrongBrush}"
                                       Text="{x:Static loc:SettingsText.PiperIsAFastNote}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{x:Static loc:SettingsText.RuntimeLabel}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="{x:Static loc:SettingsText.Bundled}" FontSize="11" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center"
                                         IsVisible="{Binding IsPiperBinaryAvailable}" />
                              <TextBlock Text="{x:Static loc:SettingsText.NotFoundInAppDirectory}" FontSize="11" Foreground="{DynamicResource WarnBrush}"
                                         VerticalAlignment="Center" IsVisible="{Binding !IsPiperBinaryAvailable}" />
                            </StackPanel>
                            <TextBlock Text="{x:Static loc:SettingsText.Voice}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <ComboBox ItemsSource="{Binding PiperVoiceLabels}" SelectedItem="{Binding SelectedPiperVoiceLabel}"
                                      HorizontalAlignment="Stretch" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="{x:Static loc:SettingsText.DownloadVoiceModel}" Command="{Binding DownloadPiperVoiceCommand}"
                                      IsEnabled="{Binding !IsDownloadingPiper}" Padding="12 4" />
                              <TextBlock Text="{x:Static loc:SettingsText.VoiceReady}" FontSize="11" Foreground="{DynamicResource GoodBrush}"
                                         VerticalAlignment="Center" IsVisible="{Binding IsPiperVoiceDownloaded}" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="{Binding IsDownloadingPiper}" Height="4" IsVisible="{Binding IsDownloadingPiper}" />
                            <TextBlock Text="{Binding PiperDownloadStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                       IsVisible="{Binding PiperDownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>

                          <!-- OpenAI -->
                          <StackPanel IsVisible="{Binding ShowOpenAi}" Spacing="8">
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BorderStrongBrush}"
                                       Text="{x:Static loc:SettingsText.OpenaisVoicesBilledPerCharacter}" />
                            <TextBlock Text="{x:Static loc:SettingsText.OpenaiApiKey}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding Owner.OpenAiApiKey}" Watermark="{x:Static loc:SettingsText.HintSk}" PasswordChar="•" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                       Text="{x:Static loc:SettingsText.OneKeyForEveryNote3}" />
                            <HyperlinkButton Content="{x:Static loc:SettingsText.GetYourOpenaiApi}"
                                             NavigateUri="https://platform.openai.com/api-keys"
                                             FontSize="10" Padding="0" HorizontalAlignment="Left" />
                            <!-- The model from OpenAI's own list; the voices it documents for that model. -->
                            <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                            <Grid ColumnDefinitions="*,Auto">
                              <ComboBox Grid.Column="0" IsVisible="{Binding OpenAiModelList.IsListed}"
                                        ItemsSource="{Binding OpenAiModelList.Listings}" SelectedItem="{Binding OpenAiModelList.Selected}"
                                        HorizontalAlignment="Stretch" MaxDropDownHeight="360">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="agent:ModelListing">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBox Grid.Column="0" IsVisible="{Binding !OpenAiModelList.IsListed}"
                                       Text="{Binding OpenAiModel}" Watermark="{x:Static loc:SettingsText.HintAsOpenaiNamesIt}" />
                              <Button Grid.Column="1" Content="↺" Command="{Binding OpenAiModelList.RefreshCommand}"
                                      Padding="8 4" Margin="6 0 0 0" VerticalAlignment="Stretch"
                                      ToolTip.Tip="{x:Static loc:SettingsText.TipAskOpenaiForIts}" />
                            </Grid>
                            <TextBlock Text="{Binding OpenAiModelList.Status}" IsVisible="{Binding OpenAiModelList.HasStatus}"
                                       FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="{x:Static loc:SettingsText.Voice}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                            <ComboBox ItemsSource="{Binding OpenAiVoiceList.Listings}" SelectedItem="{Binding OpenAiVoiceList.Selected}"
                                      HorizontalAlignment="Stretch" MaxDropDownHeight="360">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="agent:ModelListing">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding OpenAiVoiceList.Status}" IsVisible="{Binding OpenAiVoiceList.HasStatus}"
                                       FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static loc:SettingsText.Speed}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <Grid ColumnDefinitions="*,52">
                              <Slider Grid.Column="0" Minimum="0.25" Maximum="4.0" Value="{Binding OpenAiSpeed}"
                                      TickFrequency="0.25" IsSnapToTickEnabled="True" />
                              <TextBlock Grid.Column="1" Text="{Binding OpenAiSpeed, StringFormat='{}{0:F2}x'}"
                                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                          </StackPanel>

                          <!-- ElevenLabs -->
                          <StackPanel IsVisible="{Binding ShowElevenLabs}" Spacing="8">
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BorderStrongBrush}"
                                       Text="{x:Static loc:SettingsText.ElevenlabsVoicesBilledPerCharacter}" />
                            <TextBlock Text="{x:Static loc:SettingsText.ElevenlabsApiKey}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBox Text="{Binding Owner.ElevenLabsApiKey}" PasswordChar="•" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                       Text="{x:Static loc:SettingsText.OneKeyForEveryElevenlabs}" />
                            <HyperlinkButton Content="{x:Static loc:SettingsText.GetYourElevenlabsApi}"
                                             NavigateUri="https://elevenlabs.io/app/settings/api-keys"
                                             FontSize="10" Padding="0" HorizontalAlignment="Left" />
                            <!-- The voice and the model, from the account's own lists. -->
                            <TextBlock Text="{x:Static loc:SettingsText.Voice}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                            <Grid ColumnDefinitions="*,Auto">
                              <ComboBox Grid.Column="0" IsVisible="{Binding ElevenLabsVoiceList.IsListed}"
                                        ItemsSource="{Binding ElevenLabsVoiceList.Listings}" SelectedItem="{Binding ElevenLabsVoiceList.Selected}"
                                        HorizontalAlignment="Stretch" MaxDropDownHeight="360">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="agent:ModelListing">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBox Grid.Column="0" IsVisible="{Binding !ElevenLabsVoiceList.IsListed}"
                                       Text="{Binding ElevenLabsVoiceId}" Watermark="{x:Static loc:SettingsText.HintTheVoicesId}" />
                              <Button Grid.Column="1" Content="↺" Command="{Binding ElevenLabsVoiceList.RefreshCommand}"
                                      Padding="8 4" Margin="6 0 0 0" VerticalAlignment="Stretch"
                                      ToolTip.Tip="{x:Static loc:SettingsText.TipAskElevenlabsForYour}" />
                            </Grid>
                            <TextBlock Text="{Binding ElevenLabsVoiceList.Status}" IsVisible="{Binding ElevenLabsVoiceList.HasStatus}"
                                       FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                            <Grid ColumnDefinitions="*,Auto">
                              <ComboBox Grid.Column="0" IsVisible="{Binding ElevenLabsModelList.IsListed}"
                                        ItemsSource="{Binding ElevenLabsModelList.Listings}" SelectedItem="{Binding ElevenLabsModelList.Selected}"
                                        HorizontalAlignment="Stretch" MaxDropDownHeight="360">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="agent:ModelListing">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBox Grid.Column="0" IsVisible="{Binding !ElevenLabsModelList.IsListed}"
                                       Text="{Binding ElevenLabsModel}" Watermark="{x:Static loc:SettingsText.HintTheModelsId}" />
                              <Button Grid.Column="1" Content="↺" Command="{Binding ElevenLabsModelList.RefreshCommand}"
                                      Padding="8 4" Margin="6 0 0 0" VerticalAlignment="Stretch"
                                      ToolTip.Tip="{x:Static loc:SettingsText.TipAskElevenlabsForIts}" />
                            </Grid>
                            <TextBlock Text="{Binding ElevenLabsModelList.Status}" IsVisible="{Binding ElevenLabsModelList.HasStatus}"
                                       FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />
                          </StackPanel>

                          <StackPanel Spacing="6" Margin="0 4 0 0">
                            <StackPanel.Styles>
                              <!-- Classes, not a local Foreground: a local value would beat these. -->
                              <Style Selector="TextBlock.test">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                              </Style>
                              <Style Selector="TextBlock.test.spoke">
                                <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                              </Style>
                              <Style Selector="TextBlock.test.failed">
                                <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                              </Style>
                            </StackPanel.Styles>
                            <Button Content="{x:Static loc:SettingsText.TestThisVoice}" Command="{Binding TestVoiceCommand}"
                                    Padding="12 4" HorizontalAlignment="Left"
                                    ToolTip.Tip="{x:Static loc:SettingsText.TipSpeaksWithThisVoice}" />
                            <TextBlock Classes="test" Classes.spoke="{Binding TestSpoke}" Classes.failed="{Binding TestFailed}"
                                       Text="{Binding TestStatus}" IsVisible="{Binding HasTestStatus}"
                                       FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{Binding TtsVolumeHelpText}"
                                 FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- When the voice changes -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{x:Static loc:SettingsText.WhenTheVoiceChanges}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                      <CheckBox IsChecked="{Binding AnnounceVoiceChanges}" Content="{x:Static loc:SettingsText.AnnounceItInTheNew}" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.SaidByTheVoiceNote}" />
                      <TextBlock Text="{x:Static loc:SettingsText.TakingOver}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <TextBox Text="{Binding VoiceHandoverMessage}" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Static loc:SettingsText.ComingBack}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <TextBox Text="{Binding VoiceReturnMessage}" TextWrapping="Wrap" />

                      <Grid ColumnDefinitions="Auto,130,Auto" RowDefinitions="Auto,Auto" Margin="0 4 0 0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.AtLeast}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="0 0 8 0" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding VoiceSwitchGapMinutes}"
                                       Minimum="0" Maximum="240" Increment="1" FormatString="0" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static loc:SettingsText.MinutesBetweenOneChangeNote}"
                                   FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8 0 0 0" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.UpFor}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="0 6 8 0" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding VoicePreferredUpMinutes}"
                                       Minimum="0" Maximum="240" Increment="1" FormatString="0" Margin="0 6 0 0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static loc:SettingsText.MinutesWithoutABreakNote2}"
                                   FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8 6 0 0" />
                      </Grid>
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{x:Static loc:SettingsText.AVoiceThatFailsNote}" />
                    </StackPanel>
                  </Grid>
                </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{x:Static loc:SettingsText.TabSpeechInput}">
          <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0 0 8 0">
                <!-- Speech Input (push-to-talk) -->
                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                      <TextBlock Text="{x:Static loc:SettingsText.SpeechInputPushToTalk}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">

                      <TextBlock Text="{x:Static loc:SettingsText.Provider}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                      <ComboBox ItemsSource="{Binding SpeechInputProviders}"
                                SelectedItem="{Binding SpeechInputProvider}"
                                HorizontalAlignment="Stretch" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                 Text="{Binding MicHelpText}" />

                      <!-- Microphone device selection (visible whenever a provider is chosen) -->
                      <StackPanel IsVisible="{Binding ShowMicrophoneSettings}" Spacing="8">
                        <TextBlock Text="{x:Static loc:SettingsText.MicrophoneDevice}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <ComboBox Grid.Column="0"
                                    ItemsSource="{Binding MicrophoneDevices}"
                                    SelectedItem="{Binding SelectedMicrophoneDevice}"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="{x:Static loc:SettingsText.HintSystemDefault}" />
                          <Button Grid.Column="1" Content="↺"
                                  Command="{Binding RefreshMicDevicesCommand}"
                                  Padding="8 4" Margin="6 0 0 0"
                                  ToolTip.Tip="{x:Static loc:SettingsText.TipRefreshTheListOfInput}" />
                        </Grid>
                        <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}"
                                   Text="{x:Static loc:SettingsText.SystemDefaultFollowsWhateverNote}" />
                      </StackPanel>

                      <!-- Global push-to-talk key -->
                      <StackPanel IsVisible="{Binding ShowMicrophoneSettings}" Spacing="8">
                        <TextBlock Text="{x:Static loc:SettingsText.GlobalPushToTalkKey}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                        <ComboBox ItemsSource="{Binding PushToTalkKeyNames}"
                                  SelectedItem="{Binding SelectedPushToTalkKeyName}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                   Text="{Binding PttHelpText}" />
                      </StackPanel>

                      <!-- OpenAI Whisper cloud -->
                      <StackPanel IsVisible="{Binding ShowCloudWhisperSettings}" Spacing="8">
                        <TextBlock Text="{x:Static loc:SettingsText.ApiKey}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="{x:Static loc:SettingsText.TheSameOpenaiKeyNote}"
                                   FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding OpenAiApiKey}"
                                 Watermark="{x:Static loc:SettingsText.HintSk}" PasswordChar="•" />

                        <!-- The model, from OpenAI's own list of transcription models. -->
                        <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                        <Grid ColumnDefinitions="*,Auto">
                          <ComboBox Grid.Column="0" IsVisible="{Binding TranscriptionList.IsListed}"
                                    ItemsSource="{Binding TranscriptionList.Listings}" SelectedItem="{Binding TranscriptionList.Selected}"
                                    HorizontalAlignment="Stretch" MaxDropDownHeight="360">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="agent:ModelListing">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBox Grid.Column="0" IsVisible="{Binding !TranscriptionList.IsListed}"
                                   Text="{Binding TranscriptionModel}" Watermark="{x:Static loc:SettingsText.HintAsOpenaiNamesIt}" />
                          <Button Grid.Column="1" Content="↺" Command="{Binding TranscriptionList.RefreshCommand}"
                                  Padding="8 4" Margin="6 0 0 0" VerticalAlignment="Stretch"
                                  ToolTip.Tip="{x:Static loc:SettingsText.TipAskOpenaiForIts2}" />
                        </Grid>
                        <TextBlock Text="{Binding TranscriptionList.Status}" IsVisible="{Binding TranscriptionList.HasStatus}"
                                   FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                   Text="{x:Static loc:SettingsText.SentToOpenaiToNote}" />
                      </StackPanel>

                      <!-- Local Whisper (Windows only) -->
                      <StackPanel IsVisible="{Binding ShowLocalWhisperSettings}" Spacing="8">
                        <TextBlock FontSize="10" Foreground="{DynamicResource BorderStrongBrush}" TextWrapping="Wrap"
                                   Text="{x:Static loc:SettingsText.RunsWhisperNetLocallyNote}" />

                        <TextBlock Text="{x:Static loc:SettingsText.Model}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                        <ComboBox ItemsSource="{Binding LocalWhisperModelLabels}"
                                  SelectedItem="{Binding SelectedWhisperModelLabel}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="{x:Static loc:SettingsText.Language}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 0" />
                        <TextBox Text="{Binding WhisperLanguage}" Watermark="{x:Static loc:SettingsText.HintEn}" Width="120" HorizontalAlignment="Left" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Text="{x:Static loc:SettingsText.ATwoLetterCodeNote}" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding LocalWhisperRuntime, StringFormat={x:Static loc:SettingsText.FmtTheModelRunsOn}}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0">
                          <Button Content="{x:Static loc:SettingsText.DownloadModel}"
                                  Command="{Binding DownloadModelCommand}"
                                  IsEnabled="{Binding !IsDownloadingModel}"
                                  Padding="12 4" />
                          <TextBlock Text="{x:Static loc:SettingsText.Downloaded}" FontSize="11" Foreground="{DynamicResource GoodBrush}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsSelectedModelDownloaded}" />
                        </StackPanel>

                        <ProgressBar Value="{Binding ModelDownloadProgress}"
                                     IsIndeterminate="{Binding IsDownloadingModel}"
                                     Height="4"
                                     IsVisible="{Binding IsDownloadingModel}" />
                        <TextBlock Text="{Binding ModelDownloadStatus}"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding ModelDownloadStatus,
                                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>

                    </StackPanel>
                  </Grid>
                </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        </TabControl>

        <Grid Grid.Row="1" Margin="0 8 0 0">
          <!-- Save bar -->
          <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4" Padding="10 8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="{Binding SaveStatus}"
                         FontSize="11" Foreground="{DynamicResource GoodBrush}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{x:Static loc:SettingsText.SaveAgentSettings}"
                      Command="{Binding SaveCommand}"
                      Padding="14 4" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

  <!-- ── Slack ─────────────────────────────────────────────────────────── -->
  <TabItem Header="{x:Static loc:SettingsText.TabSlack}">
    <ScrollViewer>
      <StackPanel Spacing="16" Margin="24 16">

        <TextBlock Text="{x:Static loc:SettingsText.SlackIntegration}"
                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                   Text="{x:Static loc:SettingsText.PostFromEveConsoleNote}" />

        <!-- Connect (one-click, PKCE) -->
        <StackPanel Spacing="8" IsVisible="{Binding SlackVm.CanConnect}">
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                     Text="{x:Static loc:SettingsText.ConnectingOpensSlackInNote}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static loc:SettingsText.ConnectToSlack}"
                    Command="{Binding SlackVm.ConnectCommand}"
                    IsEnabled="{Binding !SlackVm.IsBusy}"
                    Padding="14 5" FontSize="12"
                    Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
                    BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1" />
            <Button Content="{x:Static loc:SettingsText.Cancel}"
                    Command="{Binding SlackVm.CancelConnectCommand}"
                    IsVisible="{Binding SlackVm.IsConnecting}"
                    Padding="12 5" FontSize="12"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
            <Button Content="{x:Static loc:SettingsText.Disconnect}"
                    Command="{Binding SlackVm.DisconnectCommand}"
                    IsVisible="{Binding SlackVm.IsConnected}"
                    Padding="12 5" FontSize="12"
                    Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                    BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1" />
            <Button Content="{x:Static loc:SettingsText.ReloadChannels}"
                    Command="{Binding SlackVm.LoadChannelsCommand}"
                    IsEnabled="{Binding !SlackVm.IsBusy}"
                    Padding="12 5" FontSize="12"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                    BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1" />
          </StackPanel>
          <TextBlock Text="{Binding SlackVm.Status}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- Manual token — only when this build has no Slack Client ID compiled in -->
        <StackPanel Spacing="8" IsVisible="{Binding SlackVm.ShowManualToken}">
          <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="14 12">
            <StackPanel Spacing="8">
              <TextBlock Text="{x:Static loc:SettingsText.ManualSetup}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Text="{x:Static loc:SettingsText.N1OpenApiSlackNote}" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Text="{x:Static loc:SettingsText.N2GoToOauthNote}" />
              <SelectableTextBlock Text="{x:Static loc:SettingsText.ChatWriteChannelsReadNote}"
                                   FontFamily="Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="12" Foreground="{DynamicResource GoodBrush}"
                                   Margin="16 0 0 0" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Text="{x:Static loc:SettingsText.N3ClickInstallToNote}" />
              <Button Content="{x:Static loc:SettingsText.OpenApiSlackComApps}"
                      Command="{Binding SlackVm.OpenSlackAppsCommand}"
                      HorizontalAlignment="Left" Padding="10 3" FontSize="11"
                      Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
                      BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1" />
            </StackPanel>
          </Border>

          <TextBlock Text="{x:Static loc:SettingsText.UserOauthToken}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox Text="{Binding SlackVm.Token}" PasswordChar="●"
                   Watermark="{x:Static loc:SettingsText.HintXoxp}" FontSize="12"
                   Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                   BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                     Text="{x:Static loc:SettingsText.StoredLocallyInYourNote}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static loc:SettingsText.SaveTest}"
                    Command="{Binding SlackVm.SaveAndTestCommand}"
                    IsEnabled="{Binding !SlackVm.IsBusy}"
                    Padding="12 4" FontSize="11"
                    Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
                    BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1" />
            <Button Content="{x:Static loc:SettingsText.ReloadChannels}"
                    Command="{Binding SlackVm.LoadChannelsCommand}"
                    IsEnabled="{Binding !SlackVm.IsBusy}"
                    Padding="12 4" FontSize="11"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                    BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1" />
            <TextBlock Text="{Binding SlackVm.Status}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

        <!-- —— Named webhooks ——————————————————————————
             Defined once and picked by name everywhere after. A webhook URL is a long opaque
             secret bound to one channel: pasting it per area gave three copies of the same
             string with no way to tell whether they were the same hook, and no way to change it
             in one place when it was rotated. -->
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static loc:SettingsText.Webhooks}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                     Text="{x:Static loc:SettingsText.ForWorkspacesYouCannotNote}" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                     Text="{x:Static loc:SettingsText.AWebhookCannotThreadNote}" />

          <DataGrid ItemsSource="{Binding SlackVm.Webhooks}" AutoGenerateColumns="False"
                    IsReadOnly="True" MaxHeight="150" HeadersVisibility="Column"
                    Background="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static loc:SettingsText.ColName}" Binding="{Binding Name}" Width="200" />
              <DataGridTextColumn Header="URL"  Binding="{Binding Url}"  Width="*" />
              <DataGridTemplateColumn Header="" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="models:SlackWebhook">
                    <!-- ⚠️ $parent[Window]. Settings is a Window, and the UserControl this asked
                         for does not exist above it, so the command resolved to null: the button
                         rendered disabled, and inconsistently so as the grid recycled its cells
                         between one row and the next. -->
                    <Button Content="{x:Static loc:SettingsText.Remove}" FontSize="10" Padding="6 1" Cursor="Hand"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).SlackVm.RemoveWebhookCommand}"
                            CommandParameter="{Binding Id}"
                            Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                            BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <Grid ColumnDefinitions="200,*,Auto">
            <TextBox Grid.Column="0" Text="{Binding SlackVm.NewWebhookName}"
                     Watermark="{x:Static loc:SettingsText.HintName}" FontSize="12"
                     Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />
            <TextBox Grid.Column="1" Text="{Binding SlackVm.NewWebhookUrl}"
                     Watermark="https://hooks.slack.com/services/…" FontSize="12" Margin="8 0"
                     Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />
            <Button Grid.Column="2" Content="{x:Static loc:SettingsText.Add}" Command="{Binding SlackVm.AddWebhookCommand}"
                    Padding="14 5" FontSize="12"
                    Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource GoodBrush}"
                    BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1" />
          </Grid>

          <!-- This section speaks for itself rather than through the connection label above,
               where a "removed webhook" line replaced the workspace name. -->
          <TextBlock Text="{Binding SlackVm.WebhookStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" IsVisible="{Binding SlackVm.WebhookStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Channel assignment per area -->
        <StackPanel Spacing="6">
          <TextBlock Text="{x:Static loc:SettingsText.Channels}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                     Text="{x:Static loc:SettingsText.PickWhichChannelEachNote}" />
          <Grid ColumnDefinitions="200,*" Margin="0 4 0 0">
            <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.CorpActivityTop10}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SlackVm.Destinations}"
                      SelectedItem="{Binding SlackVm.CorpTop10Dest}"
                      PlaceholderText="{x:Static loc:SettingsText.HintSelectAChannel}"
                      HorizontalAlignment="Stretch" FontSize="12"
                      Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
          </Grid>
          <Grid ColumnDefinitions="200,*" Margin="0 4 0 0">
            <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.CorpActivityMonthlySummary}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SlackVm.Destinations}"
                      SelectedItem="{Binding SlackVm.CorpMonthlyDest}"
                      PlaceholderText="{x:Static loc:SettingsText.HintSelectAChannel}"
                      HorizontalAlignment="Stretch" FontSize="12"
                      Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
          </Grid>
          <Grid ColumnDefinitions="200,*" Margin="0 4 0 0">
            <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.SalePosting}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SlackVm.Destinations}"
                      SelectedItem="{Binding SlackVm.SalePostingDest}"
                      PlaceholderText="{x:Static loc:SettingsText.HintSelectAChannel}"
                      HorizontalAlignment="Stretch" FontSize="12"
                      Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
          </Grid>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                     Text="{x:Static loc:SettingsText.PrivateChannelsOnlyAppearNote}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </TabItem>

  <!-- ── Alerts ────────────────────────────────────────────────────────── -->
  <TabItem Header="{x:Static loc:SettingsText.TabAlerts}">
    <ScrollViewer>
      <StackPanel Spacing="20" Margin="24 16">

        <TextBlock Text="{x:Static loc:SettingsText.AlertRules}"
                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                   Text="{x:Static loc:SettingsText.ConfigureWhichConditionsTriggerNote}" />

        <!-- Skill Queue alerts -->
        <Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static loc:SettingsText.SkillQueue}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="{x:Static loc:SettingsText.CharacterSkillQueueIsEmpty}"
                      IsChecked="{Binding AlertsVm.SkillQueueEmpty}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

            <CheckBox Content="{x:Static loc:SettingsText.CharacterSkillQueueIs}"
                      IsChecked="{Binding AlertsVm.SkillQueuePaused}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <CheckBox Content="{x:Static loc:SettingsText.SkillQueueWillBeEmpty}"
                        IsChecked="{Binding AlertsVm.SkillQueueEmptyInDays}"
                        FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                        VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding AlertsVm.SkillQueueEmptyDays}"
                             IsEnabled="{Binding AlertsVm.SkillQueueEmptyInDays}"
                             Minimum="1" Maximum="365" Increment="1"
                             FormatString="0" FontSize="12"
                             Width="120" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static loc:SettingsText.Days}"
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 6 0 0">
              <Button Content="{x:Static loc:SettingsText.SaveAlerts}"
                      Command="{Binding AlertsVm.SaveCommand}"
                      Padding="14 4" />
              <TextBlock Text="{Binding AlertsVm.Status}"
                         FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Asset Safety alerts -->
        <Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static loc:SettingsText.AssetSafety}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="{x:Static loc:SettingsText.AlertWhenItemsAre}"
                      IsChecked="{Binding AlertsVm.AssetSafety}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{x:Static loc:SettingsText.TriggersWhenAStructureitemsmovedintosafetyNote}" />
          </StackPanel>
        </Border>

        <!-- Standing Projects alerts -->
        <Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static loc:SettingsText.StandingProjects}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="{x:Static loc:SettingsText.AlertWhenStandingProjects}"
                      IsChecked="{Binding AlertsVm.InactiveStandingProjects}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{x:Static loc:SettingsText.TriggersWhenOneOrNote}" />
          </StackPanel>
        </Border>

        <!-- Standing Buy Orders alerts -->
        <Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static loc:SettingsText.StandingBuyOrders}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="{x:Static loc:SettingsText.AlertWhenStandingBuy}"
                      IsChecked="{Binding AlertsVm.StandingBuyOrdersAttention}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{x:Static loc:SettingsText.TriggersWhenAStandingNote}" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                       Text="{x:Static loc:SettingsText.OutbidDetectionComparesAgainstNote}" />
          </StackPanel>
        </Border>

        <!-- Industry facility alerts -->
        <Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static loc:SettingsText.IndustryFacilities}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="{x:Static loc:SettingsText.AlertWhenRunningJobs}"
                      IsChecked="{Binding AlertsVm.UnriggedIndustryJobs}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{x:Static loc:SettingsText.CountsActiveManufacturingAndNote}" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                       Text="{x:Static loc:SettingsText.OnlyFacilitiesLinkedToNote}" />

            <CheckBox Content="{x:Static loc:SettingsText.AlertWhenIndustryJobs}"
                      IsChecked="{Binding AlertsVm.IndustryJobsReady}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 6 0 0" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{x:Static loc:SettingsText.CountsJobsPastTheirNote}" />

            <CheckBox Content="{x:Static loc:SettingsText.AlertAboutOutstandingContracts}"
                      IsChecked="{Binding AlertsVm.OutstandingContracts}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 6 0 0" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{x:Static loc:SettingsText.CountsActiveContractsAssignedNote}" />

            <CheckBox Content="{x:Static loc:SettingsText.AlertAboutContractsAboutTo}"
                      IsChecked="{Binding AlertsVm.ExpiringContracts}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 6 0 0" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{x:Static loc:SettingsText.CountsActiveContractsYouNote}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </TabItem>

    <!-- ══ Database ════════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabDatabase}">
      <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" DataContext="{Binding DatabaseVm}">

          <!-- DB type -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.DatabaseType}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <StackPanel Margin="12 10 12 12" Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.TypeLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" Margin="0 0 10 0" />
                  <!-- The same marks the title bar uses, so both can be seen side by side
                       without switching engines to find out what the other looks like. -->
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding DbTypes}"
                            SelectedItem="{Binding SelectedDbType}"
                            HorizontalAlignment="Left" MinWidth="160">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Image Width="16" Height="16" VerticalAlignment="Center"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 Source="{Binding Converter={StaticResource DbEngineLogo}}" />
                          <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <TextBlock Text="{Binding ConfigSourceText}"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" />

                <Border Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10 8"
                        IsVisible="{Binding EngineChanged}">
                  <TextBlock Foreground="{DynamicResource WarnBrush}" FontSize="11" TextWrapping="Wrap"
                             Text="{x:Static loc:SettingsText.ThisIsNotTheNote}" />
                </Border>

                <!-- ⚠️ Here, not in the PostgreSQL panel below. It saves the ENGINE, which is what
                     this panel is for, and the panel below is hidden whenever SQLite is selected —
                     so choosing SQLite left no way to save the choice at all, and reopening
                     Settings showed PostgreSQL again because nothing had been written. -->
                <Button Content="{x:Static loc:SettingsText.SaveAndRestart}"
                        Click="OnSaveDbChoiceClick"
                        IsVisible="{Binding CanSaveDbChoice}"
                        HorizontalAlignment="Left"
                        Padding="12 5" FontSize="12" Margin="0 2 0 0"
                        Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />

                <!-- The line PostgreSQL's trademark policy asks for wherever their marks are
                     shown. It sits here rather than on the title bar tooltip so it is somewhere
                     stable and readable, without crowding a hover. -->
                <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                           Margin="0 8 0 0"
                           Text="{x:Static loc:SettingsText.PostgresPostgresqlAndTheNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- PostgreSQL connection -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding IsPostgres}">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.PostgresqlServer}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.EveConsoleNeedsToNote}" />

                <Grid ColumnDefinitions="110,*,60,90" RowDefinitions="Auto,Auto,Auto" Margin="0 4 0 0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.HostLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                  <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding PgHost}" FontSize="12"
                             Watermark="192.168.1.10" Margin="0 2 8 2" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static loc:SettingsText.PortLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                  <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding PgPort}" FontSize="12"
                             Margin="0 2 0 2" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.DatabaseLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                  <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding PgDatabase}" FontSize="12" Margin="0 2 0 2" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:SettingsText.UsernameLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                  <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding PgUsername}" FontSize="12" Margin="0 2 0 2" />
                </Grid>

                <Grid ColumnDefinitions="90,*">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.PasswordLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                  <TextBox   Grid.Column="1" Text="{Binding PgPassword}" PasswordChar="*"
                             FontSize="12" Margin="0 2 0 2" />
                </Grid>

                <TextBlock FontSize="11" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                           Text="{Binding PasswordProtectionText}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0">
                  <Button Content="{x:Static loc:SettingsText.TestConnection}"
                          IsEnabled="{Binding CanTest}"
                          Click="OnTestPostgresClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                </StackPanel>

                <TextBlock Text="{Binding TestResultText}"
                           IsVisible="{Binding HasTestResult}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />

                <!-- Offered whenever the server answered and there is still a SQLite database to
                     read from. WHICH offer depends on what the test found there: an empty
                     database gets an ordinary copy, one that already holds tables gets the copy
                     that erases first, and the panel turns red to say so. -->
                <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource GoodSurfaceBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10 8"
                        Classes.danger="{Binding DestinationHasData}"
                        IsVisible="{Binding CanOfferCopy}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static loc:SettingsText.BringYourExistingDataAcross}" FontWeight="SemiBold"
                               IsVisible="{Binding DestinationIsEmpty}"
                               Foreground="{DynamicResource GoodBrush}" FontSize="12" />
                    <TextBlock Text="{x:Static loc:SettingsText.ReplaceWhatIsOnThe}" FontWeight="SemiBold"
                               IsVisible="{Binding DestinationHasData}"
                               Foreground="{DynamicResource BadBrush}" FontSize="12" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                               Text="{Binding CopyOfferText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{x:Static loc:SettingsText.CopyDataToPostgresql}"
                              IsVisible="{Binding ShowCopyButton}"
                              Click="OnCopyToPostgresClick"
                              Padding="12 5" FontSize="12"
                              Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
                      <Button Content="{x:Static loc:SettingsText.EraseServerDataAndCopy}"
                              IsVisible="{Binding ShowEraseButton}"
                              Click="OnCopyToPostgresClick"
                              Padding="12 5" FontSize="12"
                              Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                              BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1" />
                      <Button Content="{x:Static loc:SettingsText.Cancel}"
                              IsVisible="{Binding IsCopying}"
                              Click="OnCancelCopyClick"
                              Padding="12 5" FontSize="12"
                              Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Bar plus counter: the bar advances a table at a time and the tables are wildly
                     uneven, so during a large one only the row count shows anything happening. -->
                <StackPanel IsVisible="{Binding IsCopying}" Spacing="4" Margin="0 4 0 0">
                  <Grid ColumnDefinitions="*,Auto">
                    <ProgressBar Grid.Column="0" Value="{Binding CopyPercent}"
                                 Minimum="0" Maximum="100" Height="6"
                                 Foreground="{DynamicResource GoodBrush}" Background="{DynamicResource SurfacePanelBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding CopyTableText}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="10 0 0 0"
                               VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <TextBlock Text="{Binding CopyStatusText}"
                           IsVisible="{Binding CopyStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource InfoBrush}" FontSize="11" TextWrapping="Wrap" />

              </StackPanel>
            </StackPanel>
          </Border>

          <!-- SQLite section (shown when SQLite selected) -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding IsSqlite}">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static loc:SettingsText.SqliteDatabase}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{x:Static loc:SettingsText.MovingShrinkingAndBackingNote}"
                             Foreground="{DynamicResource TextDimBrush}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <!-- Path + size -->
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.PathLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12" VerticalAlignment="Top" Margin="0 0 10 0" />
                    <TextBlock Grid.Column="1" Text="{Binding DbPath}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.SizeLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                    <TextBlock Grid.Column="1" Text="{Binding DbFileSizeText}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <!-- Move-or-rename / Repoint buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <!-- One button: a rename is a move to the same folder under a different name,
                       and the file picker already lets the user choose both. -->
                  <Button Content="{x:Static loc:SettingsText.MoveRenameDatabase}"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnRelocateDatabaseClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                          ToolTip.Tip="{x:Static loc:SettingsText.TipMoveTheDatabaseTo}" />
                  <Button Content="{x:Static loc:SettingsText.PointToExistingDb}"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnPointToDbClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                  <Button Content="{x:Static loc:SettingsText.ShrinkDatabase}"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnShrinkDatabaseClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                          ToolTip.Tip="{x:Static loc:SettingsText.TipRebuildTheDatabaseFile}" />
                </StackPanel>

                <TextBlock Text="{x:Static loc:SettingsText.TheseOperationsCopyOrNote}"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />

                <Separator Background="{DynamicResource BorderDefaultBrush}" Height="1" Margin="0 4 0 4" />

                <!-- Backup settings -->
                <CheckBox Content="{x:Static loc:SettingsText.AutomaticallyBackUpDatabase}"
                          IsChecked="{Binding BackupEnabled}"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />

                <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto" Margin="16 0 0 0">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.IntervalLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0"
                             IsEnabled="{Binding BackupEnabled}" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding BackupIntervals}"
                            SelectedItem="{Binding SelectedInterval}"
                            MinWidth="120"
                            IsEnabled="{Binding BackupEnabled}" />

                  <TextBlock Grid.Column="3" Text="{x:Static loc:SettingsText.KeepLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0"
                             IsEnabled="{Binding BackupEnabled}" />
                  <NumericUpDown Grid.Column="4"
                                 Value="{Binding BackupsToKeep}"
                                 Minimum="1" Maximum="365"
                                 Width="120" FontSize="12"
                                 IsEnabled="{Binding BackupEnabled}" />
                </Grid>

                <!-- Last backup + manual backup button -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 4 0 0">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.LastBackupLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBlock Grid.Column="1" Text="{Binding LastBackupText}"
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="{x:Static loc:SettingsText.BackUpNow}"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnBackupNowClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
                </Grid>

                <!-- Status -->
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource GoodBrush}" FontSize="11"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

              </StackPanel>
            </StackPanel>
          </Border>


          <!-- PostgreSQL backups -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding IsPostgres}">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.PostgresqlBackups}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.AServersDatabaseCannotNote}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <!-- ⚠️ The text as a TextBlock, not as Content: a button draws a string's "_" as an
                       access key, and "pg_dump" showed as "pgdump". -->
                  <Button Click="OnCheckPgDumpClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1">
                    <TextBlock Text="{x:Static loc:SettingsText.CheckForPgDump}" />
                  </Button>
                  <TextBlock Text="{Binding PgDumpStatusText}"
                             IsVisible="{Binding HasPgDumpStatus}"
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Separator Background="{DynamicResource BorderDefaultBrush}" Height="1" Margin="0 4 0 4" />

                <CheckBox Content="{x:Static loc:SettingsText.AutomaticallyBackUpDatabase}"
                          IsChecked="{Binding BackupEnabled}"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />

                <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto" Margin="16 0 0 0">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.IntervalLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 8 0" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding BackupIntervals}"
                            SelectedItem="{Binding SelectedInterval}" MinWidth="110" FontSize="12" />
                  <TextBlock Grid.Column="3" Text="{x:Static loc:SettingsText.KeepLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 8 0" />
                  <NumericUpDown Grid.Column="4" Value="{Binding BackupsToKeep}"
                                 Minimum="1" Maximum="60" Increment="1"
                                 FormatString="0" MinWidth="90" FontSize="12" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 4 0 0">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.LastBackupLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBlock Grid.Column="1" Text="{Binding LastBackupText}"
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="{x:Static loc:SettingsText.BackUpNow}"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnBackupNowClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource GoodSurfaceBrush}" Foreground="{DynamicResource GoodBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" />
                </Grid>

                <Separator Background="{DynamicResource BorderDefaultBrush}" Height="1" Margin="0 4 0 4" />

                <!-- The one destructive action in the app, and styled as one. -->
                <StackPanel Spacing="6">
                  <TextBlock Text="{x:Static loc:SettingsText.RestoreFromABackup}" FontWeight="SemiBold"
                             Foreground="{DynamicResource BadBrush}" FontSize="12" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap"
                             Text="{x:Static loc:SettingsText.ReplacesEverythingInTheNote}" />
                  <Button Content="{x:Static loc:SettingsText.RestoreFromDump}"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnRestoreDumpClick"
                          HorizontalAlignment="Left"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding RestoreResultText}"
                             IsVisible="{Binding HasRestoreResult}"
                             Foreground="{DynamicResource InfoBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource GoodBrush}" FontSize="11"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Storage breakdown — both engines, measured differently; the summary says how. -->
          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.StorageBreakdown}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.WhatTheDatabaseIsNote}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="{x:Static loc:SettingsText.Load}"
                          IsEnabled="{Binding CanAnalyse}"
                          Click="OnAnalyseDbSizeClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding SizeStatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Text="{Binding SizeSummaryText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="{Binding SizeSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <DataGrid ItemsSource="{Binding TableSizes}"
                          IsVisible="{Binding HasTableSizes}"
                          AutoGenerateColumns="False" IsReadOnly="True" RowHeight="22"
                          MaxHeight="520"
                          CanUserReorderColumns="False" CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Background="{DynamicResource SurfaceBaseBrush}">
                  <DataGrid.Styles>
                    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
                    <Style Selector="DataGridColumnHeader">
                      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
                      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                      <Setter Property="FontSize"   Value="10" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="Padding"    Value="6 5 2 5" />
                    </Style>
                  </DataGrid.Styles>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static loc:SettingsText.ColTable}" Width="*" SortMemberPath="Name" ClipboardContentBinding="{Binding Name}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TableSizeVm">
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding Tooltip}"
                                     TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static loc:SettingsText.ColRows}"    Binding="{Binding RowsText}"  Width="110" />
                    <DataGridTextColumn Header="{x:Static loc:SettingsText.ColData}"    Binding="{Binding TableText}" Width="90"  />
                    <DataGridTextColumn Header="{x:Static loc:SettingsText.ColIndexes}" Binding="{Binding IndexText}" Width="90"  />
                    <DataGridTextColumn Header="{x:Static loc:SettingsText.ColTotal}"   Binding="{Binding TotalText}" Width="90"
                                        SortMemberPath="SharePercent" />
                    <DataGridTextColumn Header="{x:Static loc:SettingsText.ColShare}"   Binding="{Binding ShareText}" Width="80"
                                        SortMemberPath="SharePercent" />
                    <DataGridTextColumn Header="{x:Static loc:SettingsText.ColMethod}"  Binding="{Binding Method}"    Width="80"  />
                  </DataGrid.Columns>
                </DataGrid>

              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Data Retention ══════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabDataRetention}">
      <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" x:DataType="vm:DataRetentionSettingsViewModel"
                    DataContext="{Binding RetentionVm}">

          <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" Margin="2 0 2 0"
                     Text="{x:Static loc:SettingsText.RetentionIntroNote}" />

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding ErrorLog}" x:DataType="vm:RetentionSectionVm">
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.ErrorLog}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.TheErrorLogIsNote}" />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="{x:Static loc:SettingsText.PurgeEntriesOlderThan}"
                            Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.Days}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="{x:Static loc:SettingsText.PurgeNow}"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgeErrorLogClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.KillMails}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.RetentionKillmailsNote}" />

                <!-- Characters / Corps -->
                <StackPanel DataContext="{Binding OurKillmails}" x:DataType="vm:RetentionSectionVm" Spacing="8">
                  <TextBlock Text="{x:Static loc:SettingsText.RetentionOurKillmails}" FontWeight="SemiBold" FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                             Text="{x:Static loc:SettingsText.RetentionOurKillmailsNote}" />

                  <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding Enabled}"
                              Content="{x:Static loc:SettingsText.PurgeKillMailsOlderThan}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding Days}"
                                   Minimum="{Binding MinimumDays}" Maximum="3650"
                                   Increment="1" FormatString="0"
                                   Width="110" FontSize="12" Margin="8 0 8 0" />
                    <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.Days}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                               VerticalAlignment="Center" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="{x:Static loc:SettingsText.PurgeNow}"
                            IsEnabled="{Binding CanPurge}"
                            Click="OnPurgeOurKillmailsClick"
                            Padding="12 5" FontSize="12"
                            Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                            BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                    <TextBlock Text="{Binding LastRunText}" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </StackPanel>

                <!-- Others -->
                <StackPanel DataContext="{Binding OtherKillmails}" x:DataType="vm:RetentionSectionVm" Spacing="8"
                            Margin="0 6 0 0">
                  <TextBlock Text="{x:Static loc:SettingsText.RetentionOtherKillmails}" FontWeight="SemiBold" FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                             Text="{x:Static loc:SettingsText.RetentionOtherKillmailsNote}" />

                  <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding Enabled}"
                              Content="{x:Static loc:SettingsText.PurgeKillMailsOlderThan}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding Days}"
                                   Minimum="{Binding MinimumDays}" Maximum="3650"
                                   Increment="1" FormatString="0"
                                   Width="110" FontSize="12" Margin="8 0 8 0" />
                    <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.Days}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                               VerticalAlignment="Center" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="{x:Static loc:SettingsText.PurgeNow}"
                            IsEnabled="{Binding CanPurge}"
                            Click="OnPurgeOtherKillmailsClick"
                            Padding="12 5" FontSize="12"
                            Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                            BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                    <TextBlock Text="{Binding LastRunText}" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding PriceHistory}" x:DataType="vm:RetentionSectionVm">
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.PriceHistory}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.RemovesDailyMarketHistoryNote}" />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="{x:Static loc:SettingsText.PurgePriceHistoryOlderThan}"
                            Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.Days}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="{x:Static loc:SettingsText.PurgeNow}"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgePriceHistoryClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding GameLog}" x:DataType="vm:RetentionSectionVm">
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.GameLog}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.RemovesParsedGameLogNote}" />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="{x:Static loc:SettingsText.PurgeGameLogEventsOlder}"
                            Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.Days}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="{x:Static loc:SettingsText.PurgeNow}"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgeGameLogClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding ChatMessages}" x:DataType="vm:RetentionSectionVm">
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.ChatMessages}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.RemovesStoredChatMessagesNote}" />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="{x:Static loc:SettingsText.PurgeChatMessagesOlderThan}"
                            Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.Days}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="{x:Static loc:SettingsText.PurgeNow}"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgeChatClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding AgentTelemetry}" x:DataType="vm:RetentionSectionVm">
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.AgentActivity}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.RemovesTheRecordOfNote}" />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="{x:Static loc:SettingsText.PurgeAgentActivityOlderThan}"
                            Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="{x:Static loc:SettingsText.Days}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="{x:Static loc:SettingsText.PurgeNow}"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgeAgentTelemetryClick"
                          Padding="12 5" FontSize="12"
                          Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}"
                          BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Updates ═════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabUpdates}">
      <StackPanel Margin="16" Spacing="14" MaxWidth="560" HorizontalAlignment="Left">

        <CheckBox IsChecked="{Binding UpdateVm.AutoCheck}"
                  Content="{x:Static loc:SettingsText.AutomaticallyCheckForUpdates}"
                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
        <TextBlock Text="{x:Static loc:SettingsText.ChecksOnStartupAndNote}"
                   FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="24 -6 0 0" />

        <Border Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14 10">
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:SettingsText.CurrentVersion}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0 0 0 6" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UpdateVm.CurrentVersionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 0 6" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:SettingsText.LatestVersion}"  Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdateVm.LatestVersionText}"  Foreground="{DynamicResource WarnBrush}" FontSize="12" />
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="{x:Static loc:SettingsText.CheckNow}" Command="{Binding UpdateVm.CheckNowCommand}" Padding="14 5" />
          <Button Content="{x:Static loc:SettingsText.UpdateNow}" Command="{Binding UpdateVm.InstallUpdateCommand}"
                  IsVisible="{Binding UpdateVm.UpdateAvailable}"
                  IsEnabled="{Binding !UpdateVm.IsBusy}" Padding="14 5" />
        </StackPanel>

        <TextBlock Text="{Binding UpdateVm.StatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

      </StackPanel>
    </TabItem>

    <!-- ══ Other ══════════════════════════════════════════════════════════════ -->
    <TabItem Header="{x:Static loc:SettingsText.TabOther}">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14" x:DataType="vm:OtherSettingsViewModel" DataContext="{Binding OtherVm}">

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.AppearanceHeader}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.ThemeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             VerticalAlignment="Center" Margin="0 0 10 0" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Themes}"
                            SelectedItem="{Binding SelectedTheme}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.UiScaleLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             VerticalAlignment="Center" Margin="0 0 10 0" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding UiScales}"
                            SelectedItem="{Binding SelectedUiScale}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.LanguageLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             VerticalAlignment="Center" Margin="0 0 10 0" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding LanguageChoices}"
                            SelectedItem="{Binding SelectedLanguage}" />
                </Grid>

                <!-- A language shows from the next start, so a change offers one. -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding LanguageNeedsRestart}">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.LanguageRestartNote}" FontSize="11"
                             Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <Button Grid.Column="1" Content="{x:Static loc:SettingsText.RestartNow}" Command="{Binding RestartCommand}" Padding="14 4" />
                </Grid>
                <TextBlock Text="{Binding RestartError}" FontSize="11" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding RestartError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{x:Static loc:SettingsText.LanguagePreviewNote}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" IsVisible="{Binding LanguageIsPreview}" />

                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.AppearanceNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.EveTimeLinkHeader}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.EveTimeLinkNote}" />

                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:SettingsText.OpenLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             VerticalAlignment="Center" Margin="0 0 10 0" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding EveTimeSiteOptions}"
                            SelectedItem="{Binding SelectedEveTimeSite}" />
                </Grid>

                <TextBox Text="{Binding CustomEveTimeUrl}"
                         Watermark="https://example.com/"
                         IsVisible="{Binding IsCustomSelected}" />

                <TextBlock Text="{Binding EffectiveUrlText}"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{x:Static loc:SettingsText.ServerStatusHeader}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{x:Static loc:SettingsText.ServerStatusNote}" />
                <TextBlock Text="https://status.eveonline.com/" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

  </TabControl>
</Window>
