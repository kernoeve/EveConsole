<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        xmlns:models="clr-namespace:EveConsole.Models"
        xmlns:agent="clr-namespace:EveConsole.Agent"
        xmlns:views="clr-namespace:EveConsole.Views"
        x:Class="EveConsole.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="940" Height="820"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d12">

  <Window.Styles>
    <!-- Make the "Find Location" Expander header match the other form controls -->
    <Style Selector="Expander /template/ ToggleButton#PART_toggle">
      <Setter Property="FontSize"        Value="12" />
      <Setter Property="Foreground"      Value="#ccccdd" />
      <Setter Property="Padding"         Value="8 5" />
      <Setter Property="MinHeight"       Value="0" />
      <Setter Property="Background"      Value="#1a1a28" />
      <Setter Property="BorderBrush"     Value="#2a2a3a" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius"    Value="3" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#PART_toggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1e1e30" />
    </Style>
  </Window.Styles>

  <TabControl x:Name="Tabs" Margin="8">

    <!-- ══ ESI Tokens ══════════════════════════════════════════════════════ -->
    <TabItem Header="ESI Tokens">
      <Grid RowDefinitions="*,8,*,Auto" Margin="0 8 0 0">

        <!-- Characters row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,8,280">

          <!-- Left: list + buttons -->
          <Border Grid.Column="0"
                  BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Characters" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <ListBox Grid.Row="1"
                       ItemsSource="{Binding CharacterVm.CharacterListItems}"
                       SelectedItem="{Binding CharacterVm.SelectedCharacterListItem}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:CharacterListItem">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Character.Name}"
                                 Foreground="#ccc" Padding="4 2" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                                 Foreground="{Binding StatusBrush}"
                                 FontSize="11" VerticalAlignment="Center" Margin="8 0 4 0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="8 6">
                <Button Content="Add"    Command="{Binding CharacterVm.AddCharacterCommand}"    Padding="14 4" />
                <Button Content="Update" Command="{Binding CharacterVm.UpdateCharacterCommand}" Padding="14 4" />
                <Button Content="Remove" Command="{Binding CharacterVm.RemoveCharacterCommand}" Padding="14 4" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Right: character details (visible when one is selected) -->
          <Border Grid.Column="2"
                  BorderBrush="#252530" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding CharacterVm.SelectedCharacterInSettings,
                              Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{Binding CharacterVm.SelectedCharacterInSettings.Name}"
                           FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Grid.Row="1" Margin="10 6 10 0" Spacing="2">
                <TextBlock Text="{Binding CharacterVm.SelectedCharacterInSettings.LastUpdated,
                                          StringFormat='Last authenticated: {0:g}'}"
                           FontSize="11" Foreground="#666" />
                <TextBlock Text="{Binding CharacterVm.SelectedCharacterScopeSummary}"
                           FontSize="11" Foreground="#888" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="Granted Scopes:"
                         FontSize="11" FontWeight="SemiBold" Foreground="#999"
                         Margin="10 6 10 2" />

              <ScrollViewer Grid.Row="3" Margin="10 0 10 8">
                <ItemsControl ItemsSource="{Binding CharacterVm.SelectedCharacterScopeGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScopeDisplayGroup">
                      <StackPanel Margin="0 0 0 6">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#c8a84b" Margin="0 0 0 1" />
                        <ItemsControl ItemsSource="{Binding Items}" Margin="8 0 0 0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScopeDisplayItem">
                              <CheckBox IsChecked="{Binding IsGranted}"
                                        IsEnabled="False"
                                        Content="{Binding FriendlyName}"
                                        FontSize="11"
                                        Padding="4 1" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Corporations row -->
        <Grid Grid.Row="2" ColumnDefinitions="*,8,280">

          <!-- Left: list + buttons -->
          <Border Grid.Column="0"
                  BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Corporations" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <ListBox Grid.Row="1"
                       ItemsSource="{Binding CharacterVm.CorpListItems}"
                       SelectedItem="{Binding CharacterVm.SelectedCorpListItem}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:CorpListItem">
                    <Grid ColumnDefinitions="14,Auto,*,Auto">
                      <!-- Personal corp indicator dot -->
                      <Ellipse Grid.Column="0" Width="6" Height="6"
                               Fill="#c8a84b" VerticalAlignment="Center"
                               IsVisible="{Binding Corp.IsPersonal}"
                               ToolTip.Tip="Personal Corporation" />
                      <TextBlock Grid.Column="1" Text="{Binding Corp.Ticker}"
                                 Foreground="#777" Padding="0 2" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Corp.Name}"
                                 Foreground="#ccc" Padding="4 2" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding StatusLabel}"
                                 Foreground="{Binding StatusBrush}"
                                 FontSize="11" VerticalAlignment="Center" Margin="8 0 4 0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="8 6">
                <Button Content="Add"    Command="{Binding CharacterVm.AddCorporationCommand}"     Padding="14 4" />
                <Button Content="Update" Command="{Binding CharacterVm.UpdateCorporationCommand}" Padding="14 4" />
                <Button Content="Remove" Command="{Binding CharacterVm.RemoveCorporationCommand}" Padding="14 4" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Right: corp details (visible when one is selected) -->
          <Border Grid.Column="2"
                  BorderBrush="#252530" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding CharacterVm.SelectedCorp,
                              Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{Binding CharacterVm.SelectedCorp.Name}"
                           FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Grid.Row="1" Margin="10 6 10 0" Spacing="2">
                <TextBlock Text="{Binding CharacterVm.SelectedCorp.LastUpdated,
                                          StringFormat='Last authenticated: {0:g}'}"
                           FontSize="11" Foreground="#666" />
                <TextBlock Text="{Binding CharacterVm.SelectedCorpScopeSummary}"
                           FontSize="11" Foreground="#888" />
              </StackPanel>

              <CheckBox Grid.Row="2"
                        Margin="10 6 10 4"
                        IsChecked="{Binding CharacterVm.SelectedCorpIsPersonal}"
                        Content="Personal Corporation"
                        FontSize="12" Foreground="#ccccdd"
                        ToolTip.Tip="Personal corps count toward your individual net worth. Alliance or employer corps are treated as separate entities." />

              <TextBlock Grid.Row="3" Text="Auth Character Scopes:"
                         FontSize="11" FontWeight="SemiBold" Foreground="#999"
                         Margin="10 6 10 2" />

              <ScrollViewer Grid.Row="4" Margin="10 0 10 8">
                <ItemsControl ItemsSource="{Binding CharacterVm.SelectedCorpScopeGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScopeDisplayGroup">
                      <StackPanel Margin="0 0 0 6">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#c8a84b" Margin="0 0 0 1" />
                        <ItemsControl ItemsSource="{Binding Items}" Margin="8 0 0 0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScopeDisplayItem">
                              <CheckBox IsChecked="{Binding IsGranted}"
                                        IsEnabled="False"
                                        Content="{Binding FriendlyName}"
                                        FontSize="11"
                                        Padding="4 1" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Auth busy strip -->
        <Border Grid.Row="3"
                Background="#161620" CornerRadius="4" Padding="10 6" Margin="0 4 0 0"
                IsVisible="{Binding CharacterVm.IsAuthBusy}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <ProgressBar IsIndeterminate="True" Height="3" />
              <TextBlock Text="{Binding CharacterVm.StatusMessage}" FontSize="11" Foreground="#aaa" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CharacterVm.CancelAddCommand}"
                    Padding="12 4" VerticalAlignment="Center" Margin="10 0 0 0" />
          </Grid>
        </Border>

      </Grid>
    </TabItem>

    <!-- ══ SDE ══════════════════════════════════════════════════════════════ -->
    <TabItem Header="SDE">
      <ScrollViewer>
        <StackPanel Margin="0 12 0 0" Spacing="14">

          <!-- Eve Static Data -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Eve Static Data" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <Grid Grid.Row="1" ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" Margin="12 10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Loaded:" Foreground="#666" VerticalAlignment="Center" Margin="0 0 0 6" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SdeVm.LoadedBuild}" Foreground="#aaa" VerticalAlignment="Center" Margin="0 0 0 6" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Latest:" Foreground="#666" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SdeVm.LatestBuild}" Foreground="#e8a030" VerticalAlignment="Center" />
              </Grid>

              <StackPanel Grid.Row="2" Margin="12 0 12 10" Spacing="6">
                <ProgressBar Value="{Binding SdeVm.Fraction}" Minimum="0" Maximum="1" Height="6" IsVisible="{Binding SdeVm.IsBusy}" />
                <TextBlock Text="{Binding SdeVm.StatusText}" FontSize="11" Foreground="#888" TextWrapping="Wrap" />
                <Button Content="Update SDE" Command="{Binding SdeVm.RefreshSdeCommand}" Padding="14 4" HorizontalAlignment="Left"
                        ToolTip.Tip="Download and import the latest Eve static data. Can be run even if already up to date." />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Hoboleaks -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Hoboleaks Complement" FontWeight="SemiBold" Foreground="#5588aa" />
              </Border>

              <StackPanel Grid.Row="1" Margin="12 10 12 0" Spacing="4">
                <TextBlock FontSize="11" Foreground="#555566" TextWrapping="Wrap"
                           Text="Blueprints, reprocessing, compression, and repackaged volumes — updated shortly after each TQ patch, often ahead of the official SDE." />
                <Grid ColumnDefinitions="80,*" Margin="0 6 0 0">
                  <TextBlock Grid.Column="0" Text="Status:" Foreground="#666" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding SdeVm.HoboImportedAt}" Foreground="#888" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="12 6 12 10" Spacing="6">
                <ProgressBar Value="{Binding SdeVm.HoboFraction}" Minimum="0" Maximum="1" Height="6"
                             IsVisible="{Binding SdeVm.HoboIsBusy}" />
                <TextBlock Text="{Binding SdeVm.HoboStatusText}" FontSize="11" Foreground="#888"
                           TextWrapping="Wrap"
                           IsVisible="{Binding SdeVm.HoboIsBusy}" />
                <Button Content="Import from Hoboleaks"
                        Command="{Binding SdeVm.RefreshHoboCommand}"
                        IsEnabled="{Binding !SdeVm.HoboIsBusy}"
                        Padding="14 4" HorizontalAlignment="Left"
                        ToolTip.Tip="Download blueprint, reprocessing, compression, and repackaged-volume data from sde.hoboleaks.space." />
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Market ════════════════════════════════════════════════════════════ -->
    <TabItem Header="Market">
      <Grid RowDefinitions="*,Auto,Auto" Margin="0 8 0 0">

        <Grid Grid.Row="0" ColumnDefinitions="*,8,300">

          <!-- Left: config list -->
          <Border Grid.Column="0" BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Price Sources" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <ListBox Grid.Row="1"
                       ItemsSource="{Binding MarketVm.Configs}"
                       SelectedItem="{Binding MarketVm.Selected}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarketPricingConfigVm">
                    <Grid ColumnDefinitions="*,Auto" Margin="2 3">
                      <TextBlock Grid.Column="0" Text="{Binding LocationName}"
                                 Foreground="#ccc" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Method}"
                                 FontSize="10" Foreground="#555566"
                                 VerticalAlignment="Center" Margin="6 0 2 0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="8 6">
                <Button Content="Add"    Command="{Binding MarketVm.AddCommand}"    Padding="14 4" />
                <Button Content="Remove" Command="{Binding MarketVm.RemoveCommand}" Padding="14 4"
                        IsEnabled="{Binding MarketVm.HasSelected}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Right: edit panel -->
          <Border Grid.Column="2" BorderBrush="#252530" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding MarketVm.HasSelected}">
            <ScrollViewer>
              <StackPanel Margin="12 10" Spacing="6">

                <TextBlock Text="Method" FontSize="11" Foreground="#666" />
                <ComboBox ItemsSource="{Binding MarketVm.Methods}"
                          SelectedItem="{Binding MarketVm.Selected.Method}"
                          HorizontalAlignment="Stretch" />

                <!-- Per-method guidance -->
                <Border Background="#111120" BorderBrush="#2a2a3a" BorderThickness="1"
                        CornerRadius="3" Padding="8 6" Margin="0 2 0 0"
                        IsVisible="{Binding MarketVm.Selected.IsFuzzwork}">
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888"
                             Text="Fuzzwork: fetches pre-computed percentile prices from fuzzwork.co.uk. Fast, requires no auth, and stores very little data locally (one price row per item). Does not store individual orders — the Market Orders tab in the Item Browser requires ESI Region or ESI Structure." />
                </Border>
                <Border Background="#111120" BorderBrush="#2a2a3a" BorderThickness="1"
                        CornerRadius="3" Padding="8 6" Margin="0 2 0 0"
                        IsVisible="{Binding MarketVm.Selected.IsEsiRegion}">
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888"
                             Text="ESI Region: fetches all public orders for an entire region from ESI. Use this for NPC trade hubs (e.g. Jita → The Forge). Note: orders posted inside player-owned structures are not included — only regional buy orders placed in structures appear." />
                </Border>
                <Border Background="#111120" BorderBrush="#2a2a3a" BorderThickness="1"
                        CornerRadius="3" Padding="8 6" Margin="0 2 0 0"
                        IsVisible="{Binding MarketVm.Selected.IsPlayerStructure}">
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888"
                             Text="Player Structure: fetches all orders within a specific player-owned structure (citadel, engineering complex, etc.). Requires an auth character with docking access. Use this for null-sec staging keeps and other private markets." />
                </Border>

                <TextBlock Text="Location Name" FontSize="11" Foreground="#666" Margin="0 6 0 0" />
                <TextBox Text="{Binding MarketVm.Selected.LocationName}"
                         Watermark="e.g. Jita 4-4" />

                <!-- Region dropdown — ESI Region method only -->
                <TextBlock Text="Region" FontSize="11" Foreground="#666" Margin="0 6 0 0"
                           IsVisible="{Binding MarketVm.Selected.IsEsiRegion}" />
                <ComboBox ItemsSource="{Binding MarketVm.RegionOptions}"
                          SelectedItem="{Binding MarketVm.Selected.SelectedRegion}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding MarketVm.Selected.IsEsiRegion}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SdeRegionOption">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Location ID — hidden when using ESI Region (replaced by region dropdown) -->
                <TextBlock Text="Location ID" FontSize="11" Foreground="#666" Margin="0 6 0 0"
                           IsVisible="{Binding !MarketVm.Selected.IsEsiRegion}" />
                <TextBox Text="{Binding MarketVm.Selected.LocationIdText}"
                         Watermark="Station or Structure ID"
                         IsVisible="{Binding !MarketVm.Selected.IsEsiRegion}" />
                <!-- Resolved name updates automatically after you stop typing -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="2 3 0 4"
                            IsVisible="{Binding MarketVm.Selected.ResolvedLocationName,
                                        Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <ProgressBar IsIndeterminate="True" Width="10" Height="10"
                               IsVisible="{Binding MarketVm.Selected.IsResolvingLocation}" />
                  <TextBlock Text="{Binding MarketVm.Selected.ResolvedLocationName}"
                             FontSize="11" Foreground="#aaa" VerticalAlignment="Center" />
                </StackPanel>

                <Expander Header="Find Location by Name…" Margin="0 6 0 0"
                          FontSize="12" Foreground="#ccccdd"
                          Background="#1a1a28"
                          IsVisible="{Binding !MarketVm.Selected.IsEsiRegion}">
                  <StackPanel Spacing="6" Margin="0 8 0 0">
                    <TextBlock FontSize="11" Foreground="#666"
                               Text="Search for a station or structure by name. Results populate the Location ID above."
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,6,Auto">
                      <TextBox Grid.Column="0"
                               Text="{Binding MarketVm.LocationSearch}"
                               Watermark="Station or structure name…" />
                      <Button Grid.Column="2" Content="Search"
                              Command="{Binding MarketVm.SearchLocationsCommand}"
                              Padding="10 4" />
                    </Grid>

                    <ListBox ItemsSource="{Binding MarketVm.LocationResults}"
                             SelectedItem="{Binding MarketVm.SelectedLocationResult}"
                             MaxHeight="140" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocationResult">
                          <Grid ColumnDefinitions="52,*" Margin="2 2">
                            <TextBlock Grid.Column="0" Text="{Binding Category}"
                                       FontSize="10" Foreground="#555566"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       Foreground="#ccc" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Use Selected"
                              Command="{Binding MarketVm.UseSelectedLocationCommand}"
                              IsEnabled="{Binding MarketVm.HasLocationResult}"
                              Padding="12 4" />
                      <TextBlock Text="{Binding MarketVm.SearchStatus}"
                                 FontSize="11" Foreground="#888"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Expander>

                <!-- Station filter — only for ESI Region (populated from raw orders after first refresh) -->
                <TextBlock Text="Station Filter" FontSize="11" Foreground="#666" Margin="0 6 0 0"
                           IsVisible="{Binding MarketVm.Selected.IsEsiRegion}" />
                <ComboBox ItemsSource="{Binding MarketVm.StationFilterOptions}"
                          SelectedItem="{Binding MarketVm.SelectedStationFilter}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding MarketVm.Selected.IsEsiRegion}" />
                <TextBlock FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                           Text="Restrict prices to a single station (e.g. Jita 4-4). Refresh the source first to populate the list."
                           IsVisible="{Binding MarketVm.Selected.IsEsiRegion}"
                           Margin="0 2 0 0" />

                <TextBlock Text="Auth Character"
                           FontSize="11" Foreground="#666" Margin="0 6 0 0"
                           IsVisible="{Binding MarketVm.Selected.IsPlayerStructure}" />
                <ComboBox ItemsSource="{Binding MarketVm.CharacterOptions}"
                          SelectedItem="{Binding MarketVm.Selected.SelectedAuthChar}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding MarketVm.Selected.IsPlayerStructure}" />

                <!-- Percentile filter -->
                <Separator Margin="0 8 0 4" />
                <CheckBox Content="Filter High/Low Orders"
                          IsChecked="{Binding MarketVm.Selected.UsePercentileFilter}"
                          Margin="0 0 0 2" />
                <TextBlock FontSize="10" Foreground="#555566" TextWrapping="Wrap"
                           Text="Removes anomalies caused by small-volume orders at the extremes of the order book. Sell = Nth-percentile cheapest; Buy = (100-N)th-percentile highest." />
                <Grid ColumnDefinitions="*,8,120"
                      IsVisible="{Binding MarketVm.Selected.UsePercentileFilter}"
                      Margin="0 4 0 0">
                  <TextBlock Grid.Column="0" Text="Filter %" FontSize="11" Foreground="#ccc"
                             VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="2"
                                 Value="{Binding MarketVm.Selected.PercentilePercent}"
                                 Minimum="0.1" Maximum="25" Increment="0.5"
                                 FormatString="0.0" />
                </Grid>

                <CheckBox Content="Enabled"
                          IsChecked="{Binding MarketVm.Selected.IsEnabled}"
                          Margin="0 6 0 0" />

                <Separator Margin="0 8" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0 0 0 4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Last refresh:"
                             FontSize="11" Foreground="#555566" Margin="0 0 8 3" />
                  <TextBlock Grid.Row="0" Grid.Column="1"
                             Text="{Binding MarketVm.Selected.LastRefreshedText}"
                             FontSize="11" Foreground="#aaa" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:"
                             FontSize="11" Foreground="#555566" Margin="0 0 8 0" />
                  <TextBlock Grid.Row="1" Grid.Column="1"
                             Text="{Binding MarketVm.Selected.LastStatus}"
                             FontSize="11" Foreground="#aaa" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 8 0 0">
                  <Button Content="Save"
                          Command="{Binding MarketVm.SaveCommand}"
                          Padding="14 4" />
                  <Button Content="Refresh This"
                          Command="{Binding MarketVm.RefreshSelectedCommand}"
                          Padding="14 4" />
                </StackPanel>

              </StackPanel>
            </ScrollViewer>
          </Border>

        </Grid>

        <!-- Default Pricing -->
        <Border Grid.Row="1" Background="#161620" BorderBrush="#252530" BorderThickness="1"
                CornerRadius="4" Padding="12 10" Margin="0 8 0 0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Default Pricing" FontWeight="SemiBold"
                       Foreground="#c8a84b" FontSize="12" Margin="0 0 0 8" />

            <!-- Asset Value -->
            <Grid Grid.Row="1" ColumnDefinitions="160,*,8,140" Margin="0 0 0 6">
              <TextBlock Grid.Column="0" Text="Asset Value:"
                         FontSize="12" Foreground="#ccc" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding MarketVm.Configs}"
                        SelectedItem="{Binding MarketVm.SelectedAssetConfig}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarketPricingConfigVm">
                    <TextBlock Text="{Binding LocationName}" FontSize="12" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding MarketVm.PriceTypes}"
                        SelectedItem="{Binding MarketVm.AssetValuePriceType}"
                        HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Manufacturing Cost -->
            <Grid Grid.Row="2" ColumnDefinitions="160,*,8,140" Margin="0 0 0 8">
              <TextBlock Grid.Column="0" Text="Manufacturing Cost:"
                         FontSize="12" Foreground="#ccc" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding MarketVm.Configs}"
                        SelectedItem="{Binding MarketVm.SelectedManufacturingConfig}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarketPricingConfigVm">
                    <TextBlock Text="{Binding LocationName}" FontSize="12" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding MarketVm.PriceTypes}"
                        SelectedItem="{Binding MarketVm.ManufacturingPriceType}"
                        HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Missing Price Markup -->
            <Grid Grid.Row="3" ColumnDefinitions="160,120,Auto,*" Margin="0 0 0 8">
              <TextBlock Grid.Column="0" Text="Missing Price Markup:"
                         FontSize="12" Foreground="#ccc" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding MarketVm.MissingPriceMarkupPct}"
                             Minimum="0" Maximum="500" Increment="1"
                             FormatString="0" FontSize="12"
                             HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="%" FontSize="12" Foreground="#aaa"
                         VerticalAlignment="Center" Margin="5 0 12 0" />
              <TextBlock Grid.Column="3"
                         Text="Applied when the market has no sell orders for an item. Price = build cost × (1 + markup%). If no buy orders, buy defaults to sell."
                         FontSize="11" Foreground="#666" VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </Grid>

            <!-- Lowball Buy Order Filter -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,120,Auto,*" Margin="0 0 0 8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding MarketVm.FilterLowballBuyOrders}"
                        Content="Filter lowball buy orders below"
                        FontSize="12" Foreground="#ccc" VerticalAlignment="Center"
                        Margin="0 0 6 0" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding MarketVm.LowballBuyOrderThresholdPct}"
                             Minimum="1" Maximum="100" Increment="5"
                             FormatString="0" FontSize="12"
                             IsEnabled="{Binding MarketVm.FilterLowballBuyOrders}"
                             HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="% of build cost"
                         FontSize="12" Foreground="#aaa"
                         VerticalAlignment="Center" Margin="5 0 12 0" />
              <TextBlock Grid.Column="3"
                         Text="Applies to ESI region / structure markets only. Orders visible in the market UI but excluded from buy price calculation."
                         FontSize="11" Foreground="#666" VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </Grid>

            <!-- Save row -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10">
              <Button Content="Save Defaults" Command="{Binding MarketVm.SaveDefaultsCommand}" Padding="14 4" />
              <TextBlock Text="{Binding MarketVm.DefaultsStatus}"
                         FontSize="11" Foreground="#888" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Bottom status bar -->
        <Border Grid.Row="2" Background="#161620" CornerRadius="4" Padding="10 6" Margin="0 8 0 0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="3">
              <ProgressBar IsIndeterminate="True" Height="3"
                           IsVisible="{Binding MarketVm.IsBusy}" />
              <TextBlock Text="{Binding MarketVm.Status}"
                         FontSize="11" Foreground="#888" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh All"
                    Command="{Binding MarketVm.RefreshAllCommand}"
                    Padding="14 4" VerticalAlignment="Center" Margin="8 0 0 0" />
          </Grid>
        </Border>

      </Grid>
    </TabItem>

  <!-- ── Price History ──────────────────────────────────────────────────── -->
  <TabItem Header="Price History">
    <ScrollViewer>
      <StackPanel Spacing="16" Margin="24 16">

        <TextBlock Text="Price History Regions"
                   FontSize="14" FontWeight="SemiBold" Foreground="#c8a84b" />

        <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                   Text="A background job refreshes 30-day market history for every traded item in these regions, once per 24 hours per item, so the opportunity tools and item details read it straight from the DB. It paces itself against ESI's error limit, so it will never push the app over. Large regions (e.g. The Forge) fill in gradually across sessions." />

        <!-- Configured regions grid -->
        <DataGrid ItemsSource="{Binding PriceHistoryVm.ConfiguredRegions}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  MaxHeight="200">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Region ID"   Binding="{ReflectionBinding RegionId}"   Width="100" />
            <DataGridTextColumn Header="Region Name" Binding="{ReflectionBinding RegionName}" Width="*" />
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:PriceHistoryRegion">
                  <Button Content="Remove"
                          Command="{Binding $parent[Window].DataContext.PriceHistoryVm.RemoveCommand}"
                          CommandParameter="{Binding}"
                          Padding="6 2" FontSize="11"
                          Background="#2a1010" Foreground="#cc4444"
                          BorderBrush="#3a1515" BorderThickness="1" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Add region row -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding PriceHistoryVm.AllRegions}"
                    SelectedItem="{Binding PriceHistoryVm.SelectedNewRegion}"
                    Width="260" PlaceholderText="Select a region to add…">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SdeRegionOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Add Region"
                  Command="{Binding PriceHistoryVm.AddCommand}"
                  Padding="12 6" FontSize="12"
                  Background="#1a2a1a" Foreground="#70ad47"
                  BorderBrush="#253525" BorderThickness="1" />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="#666677" FontSize="11" Margin="0 4 0 0"
                   Text="Tip: watch live per-region sweep progress (refreshed vs queued, and whether it's running) on the Background Processes → Price History tab." />

      </StackPanel>
    </ScrollViewer>
  </TabItem>

    <!-- ══ Industry ══════════════════════════════════════════════════════════ -->
    <TabItem Header="Industry">
      <!-- Horizontal scrolling off explicitly: the characters grid below sizes its last column
           with a star, and an unbounded width would push that column out of view rather than
           fitting it. -->
      <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="0 0 4 0">

          <!-- Build Costs -->
          <Border Background="#161620" BorderBrush="#252530" BorderThickness="1"
                  CornerRadius="4" Padding="12 10">
            <StackPanel Spacing="8">
              <TextBlock Text="Build Costs" FontWeight="SemiBold" Foreground="#c8a84b" FontSize="12" />
              <TextBlock Text="Recalculate stored build costs for every manufacturable item. Runs automatically after a market refresh; use this to force an update after changing pricing or overrides."
                         FontSize="11" Foreground="#666" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*" Margin="0 2 0 0">
                <Button Grid.Column="0"
                        Content="Recalculate Build Costs"
                        Command="{Binding MarketVm.RecalculateBuildCostsCommand}"
                        Background="#1a1a28" Foreground="#c8a84b"
                        BorderBrush="#3a3020" BorderThickness="1"
                        Padding="12 4" FontSize="11" />
                <TextBlock Grid.Column="1"
                           Text="{Binding MarketVm.BuildCostStatus}"
                           FontSize="11" Foreground="#888"
                           VerticalAlignment="Center" Margin="10 0 0 0"
                           TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Production Calc behaviour -->
          <Border Background="#161620" BorderBrush="#252530" BorderThickness="1"
                  CornerRadius="4" Padding="12 10">
            <StackPanel Spacing="8">
              <TextBlock Text="Production Calculator" FontWeight="SemiBold" Foreground="#c8a84b" FontSize="12" />

              <Grid ColumnDefinitions="Auto,120,Auto,*">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding MarketVm.PurchaseWhenCheaper}"
                          Content="Purchase a component instead of building when its market value is ≤"
                          FontSize="12" Foreground="#ccc" VerticalAlignment="Center"
                          Margin="0 0 6 0" />
                <NumericUpDown Grid.Column="1"
                               Value="{Binding MarketVm.PurchaseThresholdPct}"
                               Minimum="1" Maximum="500" Increment="5"
                               FormatString="0" FontSize="12"
                               IsEnabled="{Binding MarketVm.PurchaseWhenCheaper}"
                               HorizontalAlignment="Stretch" />
                <TextBlock Grid.Column="2" Text="% of build value"
                           FontSize="12" Foreground="#aaa"
                           VerticalAlignment="Center" Margin="5 0 12 0" />
              </Grid>

              <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                         Text="Off by default. Component markets bounce around, and a few units listed cheap don't guarantee the quantity you need is available at that price — nor that it's worth tracking down and hauling. When off, the calculators build every component they can (items that genuinely can't be costed are still bought). Turn it on to let cheaper-of-build-vs-buy decide."/>
            </StackPanel>
          </Border>

          <!-- Industry characters. Moved here from the Worklist tool: it is configuration, and
               the tool itself is for reading the work rather than setting up who does it. -->
          <Border Background="#161620" BorderBrush="#252530" BorderThickness="1"
                  CornerRadius="4" Padding="12 10">
            <StackPanel Spacing="8" DataContext="{Binding IndustryVm}">
              <TextBlock Text="Industry Characters" FontWeight="SemiBold" Foreground="#c8a84b" FontSize="12" />
              <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                         Text="Which characters may be given jobs, and on what. Every authorised character is listed automatically with all three activities on — clear the ones a character should not be given, which is how an alt is taken out of consideration. Jobs go to the least capable character who can run them, keeping the high-skill alts free for the work only they can do." />

              <DataGrid ItemsSource="{Binding Chars}" MinHeight="160" MaxHeight="320"
                        IsReadOnly="True" AutoGenerateColumns="False" FontSize="11"
                        Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Character" Binding="{Binding CharacterName}" FontSize="11" Width="200"
                                      IsReadOnly="True" />

                  <!-- Editable in place, saving on change. -->
                  <DataGridTemplateColumn Header="Slots used for" Width="260" SortMemberPath="Activities" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:IndyCharRow">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <CheckBox Content="Mfg"  IsChecked="{Binding Manufacturing, Mode=TwoWay}" FontSize="11"
                                    MinHeight="0" ToolTip.Tip="Manufacturing" />
                          <CheckBox Content="Rxn"  IsChecked="{Binding Reactions, Mode=TwoWay}"     FontSize="11"
                                    MinHeight="0" ToolTip.Tip="Reactions" />
                          <CheckBox Content="Sci"  IsChecked="{Binding Science, Mode=TwoWay}"       FontSize="11"
                                    MinHeight="0" ToolTip.Tip="Science — copying, research, invention" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTextColumn Header="Free / total" Binding="{Binding Slots}" FontSize="11" Width="*"
                                      IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <!-- Save row -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Save" Command="{Binding MarketVm.SaveDefaultsCommand}" Padding="14 4" />
            <TextBlock Text="{Binding MarketVm.DefaultsStatus}"
                       FontSize="11" Foreground="#888" VerticalAlignment="Center" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Timers ════════════════════════════════════════════════════════════ -->
    <TabItem Header="Timers">
      <Grid RowDefinitions="*,Auto" Margin="0 8 0 0">

        <ScrollViewer Grid.Row="0">
          <StackPanel Spacing="16" Margin="0 0 12 0">

            <TextBlock Text="Adjust how often each endpoint is polled. Changes take effect on the next poll cycle."
                       FontSize="11" Foreground="#888" Margin="0 0 0 4" TextWrapping="Wrap" />

            <!-- Character endpoints -->
            <StackPanel Spacing="2">
              <Border Background="#161620" CornerRadius="3" Padding="8 5" Margin="0 0 0 4">
                <TextBlock Text="Character Endpoints" FontWeight="SemiBold" Foreground="#c8a84b" FontSize="12" />
              </Border>
              <ItemsControl ItemsSource="{Binding TimerVm.CharRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimerRowVm">
                    <Grid ColumnDefinitions="200,70,Auto,Auto,*" Margin="4 3">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                 FontSize="12" Foreground="#ccc"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{ReflectionBinding IntervalMinutes, Mode=TwoWay}"
                               FontSize="12" Padding="4 3"
                               HorizontalContentAlignment="Right"
                               VerticalContentAlignment="Center" />
                      <TextBlock Grid.Column="2" Text=" min"
                                 FontSize="12" Foreground="#888"
                                 VerticalAlignment="Center" Margin="4 0 12 0" />
                      <Button Grid.Column="3"
                              Content="Force Now"
                              Command="{Binding ForceNowCommand}"
                              FontSize="11" Padding="8 2" Margin="0 0 10 0"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Reset the in-memory timer so this endpoint fires on the next poll cycle (within ~10 seconds)." />
                      <TextBlock Grid.Column="4" Text="{Binding ForceStatus}"
                                 FontSize="10" Foreground="#6a8a5a" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 Text="{Binding MinMinutes, StringFormat='(min: {0} min)'}"
                                 FontSize="11" Foreground="#555"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Corp endpoints -->
            <StackPanel Spacing="2">
              <Border Background="#161620" CornerRadius="3" Padding="8 5" Margin="0 0 0 4">
                <TextBlock Text="Corporation Endpoints" FontWeight="SemiBold" Foreground="#c8a84b" FontSize="12" />
              </Border>
              <ItemsControl ItemsSource="{Binding TimerVm.CorpRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimerRowVm">
                    <Grid ColumnDefinitions="200,70,Auto,Auto,*" Margin="4 3">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                 FontSize="12" Foreground="#ccc"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{ReflectionBinding IntervalMinutes, Mode=TwoWay}"
                               FontSize="12" Padding="4 3"
                               HorizontalContentAlignment="Right"
                               VerticalContentAlignment="Center" />
                      <TextBlock Grid.Column="2" Text=" min"
                                 FontSize="12" Foreground="#888"
                                 VerticalAlignment="Center" Margin="4 0 12 0" />
                      <Button Grid.Column="3"
                              Content="Force Now"
                              Command="{Binding ForceNowCommand}"
                              FontSize="11" Padding="8 2" Margin="0 0 10 0"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Reset the in-memory timer so this endpoint fires on the next poll cycle (within ~10 seconds)." />
                      <TextBlock Grid.Column="4" Text="{Binding ForceStatus}"
                                 FontSize="10" Foreground="#6a8a5a" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 Text="{Binding MinMinutes, StringFormat='(min: {0} min)'}"
                                 FontSize="11" Foreground="#555"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Other -->
            <StackPanel Spacing="2">
              <Border Background="#161620" CornerRadius="3" Padding="8 5" Margin="0 0 0 4">
                <TextBlock Text="Other" FontWeight="SemiBold" Foreground="#c8a84b" FontSize="12" />
              </Border>
              <ItemsControl ItemsSource="{Binding TimerVm.OtherRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimerRowVm">
                    <Grid ColumnDefinitions="200,70,Auto,Auto,*" Margin="4 3">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                 FontSize="12" Foreground="#ccc"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{ReflectionBinding IntervalMinutes, Mode=TwoWay}"
                               FontSize="12" Padding="4 3"
                               HorizontalContentAlignment="Right"
                               VerticalContentAlignment="Center" />
                      <TextBlock Grid.Column="2" Text=" min"
                                 FontSize="12" Foreground="#888"
                                 VerticalAlignment="Center" Margin="4 0 12 0" />
                      <Button Grid.Column="3"
                              Content="Force Now"
                              Command="{Binding ForceNowCommand}"
                              FontSize="11" Padding="8 2" Margin="0 0 10 0"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Reset the in-memory timer so this endpoint fires on the next poll cycle (within ~10 seconds)." />
                      <TextBlock Grid.Column="4" Text="{Binding ForceStatus}"
                                 FontSize="10" Foreground="#6a8a5a" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 Text="{Binding MinMinutes, StringFormat='(min: {0} min)'}"
                                 FontSize="11" Foreground="#555"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="1" Background="#161620" CornerRadius="4" Padding="10 8" Margin="0 8 0 0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding TimerVm.SaveStatus}"
                       FontSize="11" Foreground="#4caf81"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Save Timers"
                    Command="{Binding TimerVm.SaveCommand}"
                    Padding="14 4" />
          </Grid>
        </Border>

      </Grid>
    </TabItem>

    <!-- ══ Polling ══════════════════════════════════════════════════════════════ -->
    <TabItem Header="Polling">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14">

          <!-- Structure Name Resolution -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Structure Name Resolution" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="When resolving unknown structure names, EVE Console tries each authenticated character in turn until one succeeds. If most structures deny access to your characters, choosing a single character here prevents unnecessary failed calls and avoids burning your ESI error budget." />

                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0">
                  <TextBlock Grid.Column="0" Text="Character:" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding PollingVm.StructureNameChars}"
                            SelectedItem="{Binding PollingVm.SelectedStructureNameChar}"
                            HorizontalAlignment="Stretch"
                            MaxDropDownHeight="200" />
                </Grid>

                <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                           Text="Select '(none — try all)' to fall back to the original behaviour of trying every character. The choice takes effect immediately — no restart required." />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Game Logs ══════════════════════════════════════════════════════════ -->
    <TabItem Header="Game Logs">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14">

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Game Log Import" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Reads EVE's own game logs and stores what it finds — combat, mining, bounties, jumps, undocking — so other tools can query it. Logs are opened read-only; nothing is ever written back and nothing is sent to the game client." />

                <CheckBox IsChecked="{Binding GameLogVm.Enabled}"
                          Content="Import game logs (on by default)" Foreground="#ccc" FontSize="12" />

                <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                           Text="This captures activity from now on. Logs EVE has already written are only loaded if you run an import below." />

                <TextBlock Text="{Binding GameLogVm.Status}" FontSize="11" Foreground="#888899"
                           TextWrapping="Wrap" />

                <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                           Text="Parse position is remembered per file, so anything logged while EVE Console was closed is picked up the next time it starts." />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Log Folders" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Leave the list empty to use the local folder automatically. Add a network path (\\MACHINE\share\Gamelogs) to import logs from EVE clients running on other computers — nothing needs to be installed on them." />

                <ListBox ItemsSource="{Binding GameLogVm.Directories}"
                         SelectedItem="{Binding GameLogVm.SelectedDirectory}"
                         MaxHeight="110" FontSize="11" Background="#131320" />

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding GameLogVm.NewDirectory}"
                           Watermark="C:\Users\you\Documents\EVE\logs\Gamelogs  or  \\PC2\eve-logs" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6 0 0 0">
                    <Button Content="Add"    Command="{Binding GameLogVm.AddDirectoryCommand}"    Padding="10 3" />
                    <Button Content="Remove" Command="{Binding GameLogVm.RemoveDirectoryCommand}" Padding="10 3" />
                    <Button Content="Detect" Command="{Binding GameLogVm.DetectDirectoryCommand}" Padding="10 3" />
                    <Button Content="Open"   Command="{Binding GameLogVm.OpenDirectoryCommand}"   Padding="10 3" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="Currently reading:" FontSize="11" Foreground="#888" Margin="0 4 0 0" />
                <SelectableTextBlock Text="{Binding GameLogVm.ResolvedPaths}" FontSize="11"
                                     Foreground="#999" TextWrapping="Wrap"
                                     FontFamily="Consolas, Menlo, monospace" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Historical import: an explicit, user-initiated action. Enabling the
               importer above only picks up NEW activity, so the amount of history to
               process is chosen here BEFORE anything runs, with the cost shown. -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Import Past Logs" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Turning the importer on only picks up new activity from that point. To also load what EVE has already logged, choose how far back to go and start the import. This runs once — afterwards new activity is picked up automatically." />

                <Grid ColumnDefinitions="Auto,80,Auto" IsEnabled="{Binding !GameLogVm.IsImporting}">
                  <TextBlock Grid.Column="0" Text="Import logs from the last (days):" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding GameLogVm.HistoryDays}" />
                  <TextBlock Grid.Column="2" Text="0 = all history" Foreground="#666"
                             FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>

                <TextBlock Text="{Binding GameLogVm.EstimateText}" FontSize="11" Foreground="#c8a84b"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Start Import" Command="{Binding GameLogVm.ImportHistoryCommand}"
                          IsEnabled="{Binding !GameLogVm.IsImporting}" Padding="14 4" />
                  <Button Content="Recount" Command="{Binding GameLogVm.EstimateCommand}"
                          IsEnabled="{Binding !GameLogVm.IsImporting}" Padding="14 4" />
                  <Button Content="Cancel" Command="{Binding GameLogVm.CancelImportCommand}"
                          IsVisible="{Binding GameLogVm.IsImporting}" Padding="14 4" />
                </StackPanel>

                <!-- Real determinate progress: file X of Y, so a large historical
                     import shows how much is left rather than just spinning. -->
                <StackPanel Spacing="4" IsVisible="{Binding GameLogVm.IsImporting}">
                  <ProgressBar Minimum="0"
                               Maximum="{Binding GameLogVm.ProgressTotal}"
                               Value="{Binding GameLogVm.ProgressCurrent}"
                               Height="14" Foreground="#c8a84b" Background="#131320" />
                  <TextBlock Text="{Binding GameLogVm.ProgressText}" FontSize="11" Foreground="#888899"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding GameLogVm.ProgressText}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Options" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <Grid ColumnDefinitions="Auto,80,Auto">
                  <TextBlock Grid.Column="0" Text="Check for new lines every (s):" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding GameLogVm.ScanSeconds}" />
                </Grid>

                <CheckBox IsChecked="{Binding GameLogVm.StoreUnmatched}" Foreground="#ccc" FontSize="12"
                          Content="Keep lines that no rule recognised" />
                <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                           Text="Recommended. EVE's log format is undocumented and varies by client version, and recognition rules can only cover activity someone has actually done. Keeping unrecognised lines (as kind 'unmatched') means missing coverage shows up in your own data instead of going unnoticed." />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Chat Logs ══════════════════════════════════════════════════════════ -->
    <TabItem Header="Chat Logs">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14">

          <Border BorderBrush="#4a3a20" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#241a10" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Chat Log Import" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#c8a84b" TextWrapping="Wrap"
                           Text="Unlike game logs, chat logs contain what other people wrote. Nothing is stored unless you both enable this and tick specific channels below." />
                <TextBlock FontSize="11" Foreground="#c8a84b" TextWrapping="Wrap"
                           Text="Note: private conversations appear as &quot;Private Chat (2)&quot;, &quot;Private Chat (3)&quot; and so on. EVE reuses those names for different people over time, so ticking one can capture direct messages with many different players." />

                <CheckBox IsChecked="{Binding ChatLogVm.Enabled}"
                          Content="Import chat logs" Foreground="#ccc" FontSize="12" />

                <TextBlock Text="{Binding ChatLogVm.Status}" FontSize="11" Foreground="#888899"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Log Folders" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Leave the list empty to use the local folder automatically. Add a network path (\\MACHINE\share\Chatlogs) to import logs from EVE clients running on other computers — nothing needs to be installed on them. Channel discovery below only sees channels from the folder(s) configured here." />

                <ListBox ItemsSource="{Binding ChatLogVm.Directories}"
                         SelectedItem="{Binding ChatLogVm.SelectedDirectory}"
                         MaxHeight="110" FontSize="11" Background="#131320" />

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding ChatLogVm.NewDirectory}"
                           Watermark="C:\Users\you\Documents\EVE\logs\Chatlogs  or  \\PC2\eve-logs" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6 0 0 0">
                    <Button Content="Add"    Command="{Binding ChatLogVm.AddDirectoryCommand}"    Padding="10 3" />
                    <Button Content="Remove" Command="{Binding ChatLogVm.RemoveDirectoryCommand}" Padding="10 3" />
                    <Button Content="Detect" Command="{Binding ChatLogVm.DetectDirectoryCommand}" Padding="10 3" />
                    <Button Content="Open"   Command="{Binding ChatLogVm.OpenDirectoryCommand}"   Padding="10 3" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="Currently reading:" FontSize="11" Foreground="#888" Margin="0 4 0 0" />
                <SelectableTextBlock Text="{Binding ChatLogVm.ResolvedPaths}" FontSize="11"
                                     Foreground="#999" TextWrapping="Wrap"
                                     FontFamily="Consolas, Menlo, monospace" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Channels to Store" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Only ticked channels are read at all — files for other channels are never opened. Discovery reads filenames only; it can take a moment as these folders hold tens of thousands of files." />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Discover Channels" Command="{Binding ChatLogVm.DiscoverCommand}"
                          IsEnabled="{Binding !ChatLogVm.IsBusy}" Padding="14 4" />
                  <Button Content="Untick All" Command="{Binding ChatLogVm.SelectNoneCommand}"
                          IsEnabled="{Binding !ChatLogVm.IsBusy}" Padding="14 4" />
                </StackPanel>

                <Grid ColumnDefinitions="*,70" Margin="8 0 8 0">
                  <TextBlock Grid.Column="0" Text="CHANNEL" FontSize="9" FontWeight="SemiBold" Foreground="#666677" />
                  <TextBlock Grid.Column="1" Text="INTEL"   FontSize="9" FontWeight="SemiBold" Foreground="#666677"
                             HorizontalAlignment="Center" />
                </Grid>

                <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="3"
                        Background="#131320" MaxHeight="220">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatLogVm.Channels}" Margin="8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatChannelViewModel">
                          <Grid ColumnDefinitions="*,70" Margin="0 1">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Content="{Binding Name}"
                                      Foreground="#ccc" FontSize="11" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsIntel}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip.Tip="Parse this channel for sightings" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>

                <TextBlock Text="{Binding ChatLogVm.SelectionText}" FontSize="11" Foreground="#888899" />

                <!-- Intel parsing -->
                <Border BorderBrush="#252530" BorderThickness="0 1 0 0" Padding="0 8 0 0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="INTEL" FontSize="10" FontWeight="SemiBold" Foreground="#888899" />
                    <TextBlock Text="{Binding ChatLogVm.IntelHelp}" FontSize="11" Foreground="#888"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Parse Stored History"
                              Command="{Binding ChatLogVm.ParseIntelHistoryCommand}"
                              IsEnabled="{Binding !ChatLogVm.IsBusy}" Padding="14 4" />
                      <TextBlock Text="{Binding ChatLogVm.IntelStatus}" FontSize="11"
                                 Foreground="#888899" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Import Past Chat" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="As with game logs, enabling only captures new messages. Use this to also load past chat for the selected channels." />

                <Grid ColumnDefinitions="Auto,80,Auto" IsEnabled="{Binding !ChatLogVm.IsBusy}">
                  <TextBlock Grid.Column="0" Text="Import chat from the last (days):" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding ChatLogVm.HistoryDays}" />
                  <TextBlock Grid.Column="2" Text="0 = all history" Foreground="#666"
                             FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>

                <TextBlock Text="{Binding ChatLogVm.EstimateText}" FontSize="11" Foreground="#c8a84b"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Start Import" Command="{Binding ChatLogVm.ImportHistoryCommand}"
                          IsEnabled="{Binding !ChatLogVm.IsBusy}" Padding="14 4" />
                  <Button Content="Cancel" Command="{Binding ChatLogVm.CancelImportCommand}"
                          IsVisible="{Binding ChatLogVm.IsBusy}" Padding="14 4" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding ChatLogVm.IsBusy}">
                  <ProgressBar Minimum="0"
                               Maximum="{Binding ChatLogVm.ProgressTotal}"
                               Value="{Binding ChatLogVm.ProgressCurrent}"
                               Height="14" Foreground="#c8a84b" Background="#131320" />
                  <TextBlock Text="{Binding ChatLogVm.ProgressText}" FontSize="11" Foreground="#888899"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding ChatLogVm.ProgressText}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Map Data ══════════════════════════════════════════════════════════ -->
    <TabItem Header="Map Data">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14" x:DataType="vm:MapStatsSettingsViewModel" DataContext="{Binding MapStatsVm}">

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="14" Spacing="10">
              <TextBlock Text="Map statistics" FontSize="14" FontWeight="SemiBold" Foreground="#d0d0dc" />
              <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#8a8a9a"
                         Text="Jumps, kills, sovereignty, industry indices, faction warfare and incursions, used by the Universe map overlays. ESI serves only the current hour, so history comes from the EVE Ref archive — which means closing the app does not leave permanent gaps." />

              <CheckBox IsChecked="{Binding Enabled}" Content="Collect map statistics"
                        FontSize="12" Foreground="#c0c0cc" />

              <Grid ColumnDefinitions="Auto,90,Auto,90,*" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="Backfill days" FontSize="11.5" Foreground="#9a9aaa"
                           VerticalAlignment="Center" Margin="0 0 8 0" />
                <TextBox Grid.Column="1" Text="{Binding BackfillDays}" FontSize="11.5" />
                <TextBlock Grid.Column="2" Text="Keep hourly detail (days)" FontSize="11.5" Foreground="#9a9aaa"
                           VerticalAlignment="Center" Margin="16 0 8 0" />
                <TextBox Grid.Column="3" Text="{Binding KeepHourlyDays}" FontSize="11.5" />
              </Grid>

              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#6a6a7a"
                         Text="Past the hourly window, jumps and kills are totalled per day, and sovereignty, industry and structure data keep one snapshot a day. Industry indices are still refreshed every hour, so the current value stays current — only the older hours are thinned." />
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="14" Spacing="10">
              <TextBlock Text="History" FontSize="14" FontWeight="SemiBold" Foreground="#d0d0dc" />

              <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#c8a84b" TextWrapping="Wrap" />
              <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"
                           Foreground="#5599aa" Background="#1a1a24" />
              <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#8a8a9a"
                         TextWrapping="Wrap" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Backfill now" Command="{Binding StartBackfillCommand}"
                        IsEnabled="{Binding !IsRunning}"
                        Background="#1a1a28" Foreground="#5599aa" BorderBrush="#2a3a44"
                        BorderThickness="1" Padding="12 4" FontSize="11" />
                <Button Content="Cancel" Command="{Binding CancelBackfillCommand}"
                        IsEnabled="{Binding IsRunning}"
                        Background="#1a1a28" Foreground="#aa6655" BorderBrush="#442a2a"
                        BorderThickness="1" Padding="12 4" FontSize="11" />
                <Button Content="Refresh current hour" Command="{Binding RefreshNowCommand}"
                        Background="#1a1a28" Foreground="#888" BorderBrush="#2a2a3a"
                        BorderThickness="1" Padding="12 4" FontSize="11" />
              </StackPanel>

              <TextBlock Text="{Binding PollStatus}" FontSize="11" Foreground="#6a6a7a" />
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="14" Spacing="8">
              <TextBlock Text="Coverage" FontSize="14" FontWeight="SemiBold" Foreground="#d0d0dc" />
              <TextBlock Text="{Binding Coverage}" FontSize="11" Foreground="#9a9aaa"
                         FontFamily="Consolas,Menlo,monospace" TextWrapping="NoWrap" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Kill Mails ═════════════════════════════════════════════════════════ -->
    <TabItem Header="Kill Mails">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14" x:DataType="vm:ZkillboardSettingsViewModel" DataContext="{Binding ZkbVm}">

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="zKillboard Kill Import" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="ESI only returns a killmail when you were the victim or got the final blow — participating in a kill without the final blow is invisible to it. zKillboard tracks every participant, so merging it in fills that gap. Optional; off by default. Merges into the same Kills data used everywhere else, never duplicates or overwrites what ESI already provided." />

                <CheckBox IsChecked="{Binding Enabled}"
                          Content="Enable zKillboard kill import" Foreground="#ccc" FontSize="12" />

                <TextBlock Text="{Binding LiveStatus}" FontSize="11" Foreground="#888899" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Scope" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <RadioButton GroupName="ZkbScope" IsChecked="{Binding ScopeIsMineAndCorp}"
                             Content="My characters &amp; corp only" Foreground="#ccc" FontSize="12" />
                <TextBlock FontSize="11" Foreground="#666" Margin="22 0 0 0" TextWrapping="Wrap"
                           Text="Live capture polls zKillboard for just the characters and corps already tracked in this app, at the interval below." />

                <RadioButton GroupName="ZkbScope" IsChecked="{Binding ScopeIsAll}"
                             Content="Capture all kills" Foreground="#ccc" FontSize="12" Margin="0 6 0 0" />
                <TextBlock FontSize="11" Foreground="#666" Margin="22 0 0 0" TextWrapping="Wrap"
                           Text="Live capture switches to zKillboard's real-time firehose, which has no interval to set — it streams continuously. Database size will grow substantially faster than Mine+Corp mode, since every kill in New Eden is stored, not just your own." />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Live Poll Interval" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8" IsEnabled="{Binding ScopeIsMineAndCorp}">
                <Grid ColumnDefinitions="Auto,80,Auto">
                  <TextBlock Grid.Column="0" Text="Check zKillboard for new kills every (s):" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding PollIntervalSeconds}" />
                  <TextBlock Grid.Column="2" Text="60–3600" Foreground="#666"
                             FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>
                <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                           Text="Not used in All-kills scope — the firehose paces itself instead." />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Backfill: manual button for initial history, plus an automatic hourly
               check that catches up on any gap since the app last ran — both drive the
               same progress state below. -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Backfill History" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Pulls zKillboard's daily kill dumps for the chosen range and merges in anything matching the scope above. Also runs automatically once an hour to catch up on any gap since the app was last running — this button is mainly for pulling in history from before tracking started." />

                <Grid ColumnDefinitions="Auto,80,Auto" IsEnabled="{Binding !IsImporting}">
                  <TextBlock Grid.Column="0" Text="Backfill the last (days):" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBox Grid.Column="1" Text="{Binding BackfillDays}" />
                  <TextBlock Grid.Column="2" Text="{Binding LastFullDayText, StringFormat='last full day: {0}'}"
                             Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Start Backfill" Command="{Binding BackfillCommand}"
                          IsEnabled="{Binding !IsImporting}" Padding="14 4" />
                  <Button Content="Cancel" Command="{Binding CancelBackfillCommand}"
                          IsVisible="{Binding IsImporting}" Padding="14 4" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding IsImporting}">
                  <ProgressBar Minimum="0"
                               Maximum="{Binding ProgressTotal}"
                               Value="{Binding ProgressCurrent}"
                               Height="14" Foreground="#c8a84b" Background="#131320" />
                  <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#888899"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProgressText}" />
                </StackPanel>

                <TextBlock Text="{Binding BackfillStatus}" FontSize="11" Foreground="#888899"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Submission runs the other direction: kills we have that zKillboard doesn't.
               Only considers kills inside the backfilled/live coverage window, since a
               kill from before we ever looked at zKillboard tells us nothing. -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Post Kills to zKillboard" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Submits killmails this app has that zKillboard is missing — typically ESI kills that nobody else uploaded. Only kills from the covered date range below are considered, and only once they are a few hours old, so a kill still working its way through zKillboard is never submitted needlessly. Nothing is ever submitted twice." />

                <CheckBox IsChecked="{Binding PostEnabled}"
                          Content="Post killmails to zKillboard" Foreground="#ccc" FontSize="12" />

                <TextBlock Text="{Binding CoverageFromText, StringFormat='Covered from: {0}'}"
                           FontSize="11" Foreground="#666" TextWrapping="Wrap" />
                <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                           Text="That is the oldest kill confirmed present on zKillboard. Anything older predates everything zKillboard has shown us, so it can't be judged missing and is left alone — backfill further back to widen the range." />

                <TextBlock Text="{Binding PostStatus}" FontSize="11" Foreground="#888899" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Corp Top 10 ════════════════════════════════════════════════════════ -->
    <TabItem Header="Corp Top 10">
      <Grid RowDefinitions="*,Auto" Margin="0 8 0 0">

        <Grid Grid.Row="0" ColumnDefinitions="*,8,*">

          <!-- Left: Search + Results -->
          <Border Grid.Column="0" BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto,*">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Add to Exclude List" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Grid.Row="1" Margin="10 8 10 6" Spacing="6"
                          DataContext="{Binding CorpTop10Vm}">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Excluded members/corps will not appear in any Top 10 list. They still appear in all other Corp Activity views." />

                <Grid ColumnDefinitions="*,8,Auto" Margin="0 4 0 0">
                  <TextBox Grid.Column="0"
                           Text="{Binding SearchText}"
                           Watermark="Name to search…"
                           FontSize="11" />
                  <ComboBox Grid.Column="2"
                            ItemsSource="{Binding EntityTypes}"
                            SelectedItem="{Binding EntityType}"
                            MinWidth="120" FontSize="11"
                            Background="#1a1a28" Foreground="#c8c8d8"
                            BorderBrush="#2a2a3a" />
                </Grid>

                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        HorizontalAlignment="Left"
                        Background="#1a1a28" Foreground="#5599aa"
                        BorderBrush="#2a3a44" BorderThickness="1"
                        Padding="14 4" FontSize="11" />

                <TextBlock Text="{Binding StatusText}"
                           FontSize="11" Foreground="#c8a84b"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <!-- Search results list -->
              <Border Grid.Row="2" Margin="10 0 10 10"
                      BorderBrush="#252530" BorderThickness="1" CornerRadius="3">
                <ListBox ItemsSource="{Binding CorpTop10Vm.SearchResults}"
                         Background="Transparent"
                         SelectionMode="Single">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CorpTop10ExcludeRowVm">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Display}"
                                   FontSize="11" Foreground="#c8c8d8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="+ Add"
                                Command="{Binding $parent[ListBox].((vm:SettingsViewModel)DataContext).CorpTop10Vm.AddCommand}"
                                CommandParameter="{Binding}"
                                FontSize="10" Padding="8 2"
                                Background="#1a2a1a" Foreground="#6aaa88"
                                BorderBrush="#2a3a2a" BorderThickness="1" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Grid>
          </Border>

          <!-- Right: Current Excludes -->
          <Border Grid.Column="2" BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Current Exclude List" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <ListBox Grid.Row="1"
                       ItemsSource="{Binding CorpTop10Vm.Excludes}"
                       Background="Transparent"
                       SelectionMode="Single"
                       Margin="4 4 4 4">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CorpTop10ExcludeRowVm">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Display}"
                                 FontSize="11" Foreground="#c8c8d8"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Remove"
                              Command="{Binding $parent[ListBox].((vm:SettingsViewModel)DataContext).CorpTop10Vm.RemoveCommand}"
                              CommandParameter="{Binding}"
                              FontSize="10" Padding="8 2"
                              Background="#2a1a1a" Foreground="#cc7766"
                              BorderBrush="#3a2a2a" BorderThickness="1" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

        </Grid>

      </Grid>
    </TabItem>

    <!-- ══ Agent ═══════════════════════════════════════════════════════════════ -->
    <TabItem Header="AI Agent">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="12" x:DataType="vm:AgentSettingsViewModel"
                    DataContext="{Binding AgentVm}">

          <!-- Personalisation -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Personalisation" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>
              <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                <TextBlock Text="Agent Name" FontSize="11" Foreground="#666" />
                <TextBox Text="{Binding AgentName}"
                         Watermark="{x:Static agent:AgentSettings.DefaultAgentName}" />
                <TextBlock FontSize="10" Foreground="#444455" TextWrapping="Wrap"
                           Text="{Binding DefaultAgentNameHelpText}" />

                <TextBlock Text="Response Verbosity" FontSize="11" Foreground="#666" Margin="0 4 0 0" />
                <ComboBox ItemsSource="{Binding VerbosityOptions}"
                          SelectedItem="{Binding Verbosity}"
                          HorizontalAlignment="Stretch" />
                <TextBlock FontSize="10" Foreground="#444455" TextWrapping="Wrap"
                           Text="Concise: short, direct answers (1-3 sentences). Balanced: complete but not padded. Detailed: thorough with context and reasoning. This is injected into the system prompt every time you send a message." />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Master enable -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="{Binding HeaderTitleText}" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>
              <StackPanel Grid.Row="1" Margin="12 10" Spacing="6">
                <CheckBox Content="{Binding EnableCheckboxText}"
                          IsChecked="{Binding IsEnabled}" />
                <TextBlock Text="{Binding EnableHelpText}"
                           FontSize="11" Foreground="#555566" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Provider selection -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Provider" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>
              <Grid Grid.Row="1" ColumnDefinitions="120,*" Margin="12 10">
                <TextBlock Grid.Column="0" Text="LLM Provider:"
                           FontSize="12" Foreground="#ccc" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={x:Static views:AgentProviderDisplayConverter.Instance}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Grid>
          </Border>

          <!-- Claude settings -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding ShowClaude}">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Claude (Anthropic)" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>
              <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                <TextBlock Text="API Key" FontSize="11" Foreground="#666" />
                <TextBox Text="{Binding ClaudeApiKey}"
                         Watermark="sk-ant-…"
                         PasswordChar="•" />
                <HyperlinkButton Content="Get your Anthropic API key at console.anthropic.com"
                                 NavigateUri="https://console.anthropic.com/settings/keys"
                                 FontSize="10"
                                 Padding="0"
                                 HorizontalAlignment="Left" />
                <TextBlock Text="Model" FontSize="11" Foreground="#666" />
                <TextBox Text="{Binding ClaudeModel}"
                         Watermark="claude-sonnet-4-6" />
                <TextBlock Text="Available models: claude-opus-4-8, claude-sonnet-4-6, claude-haiku-4-5-20251001"
                           FontSize="10" Foreground="#444455" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- OpenAI settings -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding ShowOpenAi}">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="OpenAI" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>
              <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                <TextBlock Text="API Key" FontSize="11" Foreground="#666" />
                <TextBox Text="{Binding OpenAiApiKey}"
                         Watermark="sk-…"
                         PasswordChar="•" />
                <HyperlinkButton Content="Get your OpenAI API key at platform.openai.com"
                                 NavigateUri="https://platform.openai.com/api-keys"
                                 FontSize="10"
                                 Padding="0"
                                 HorizontalAlignment="Left" />
                <TextBlock Text="Model" FontSize="11" Foreground="#666" />
                <TextBox Text="{Binding OpenAiModel}"
                         Watermark="gpt-4o" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Local LLM settings -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding ShowLocal}">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Local LLM (Ollama / LM Studio)" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>
              <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">
                <TextBlock Text="API Endpoint" FontSize="11" Foreground="#666" />
                <TextBox Text="{Binding LocalEndpoint}"
                         Watermark="http://localhost:11434" />
                <TextBlock Text="Model Name" FontSize="11" Foreground="#666" />
                <TextBox Text="{Binding LocalModel}"
                         Watermark="llama3.1" />
                <TextBlock Text="Must expose an OpenAI-compatible /v1/chat/completions endpoint (Ollama, LM Studio, and most local runners do by default)."
                           FontSize="10" Foreground="#444455" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Context management -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Context Management" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>
              <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">

                <CheckBox Content="Persist conversation history across sessions"
                          IsChecked="{Binding PersistHistory}" />
                <TextBlock Text="{Binding HistoryHelpText}"
                           FontSize="10" Foreground="#444455" TextWrapping="Wrap" />

                <TextBlock Text="Summarization threshold (estimated tokens)" FontSize="11" Foreground="#666" Margin="0 4 0 0" />
                <Grid ColumnDefinitions="120,*">
                  <TextBox Grid.Column="0"
                           Text="{Binding SummarizationThreshold}"
                           Watermark="50000" />
                  <TextBlock Grid.Column="1"
                             Text="tokens"
                             FontSize="11" Foreground="#555566"
                             VerticalAlignment="Center" Margin="8 0 0 0" />
                </Grid>
                <TextBlock FontSize="10" Foreground="#444455" TextWrapping="Wrap"
                           Text="{Binding SummarizationHelpText}" />

              </StackPanel>
            </Grid>
          </Border>

          <!-- Voice (TTS) -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Voice (TTS)" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">

                <TextBlock Text="Provider" FontSize="11" Foreground="#666" />
                <ComboBox ItemsSource="{Binding TtsProviders}"
                          SelectedItem="{Binding TtsProvider}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding TtsVolumeHelpText}"
                           FontSize="10" Foreground="#444455" TextWrapping="Wrap" />

                <!-- OpenAI TTS settings -->
                <StackPanel IsVisible="{Binding ShowOpenAiTtsSettings}" Spacing="8">
                  <TextBlock Text="API Key" FontSize="11" Foreground="#666" />
                  <TextBlock Text="Shared with the OpenAI LLM provider setting above."
                             FontSize="10" Foreground="#444455" />
                  <TextBox Text="{Binding OpenAiApiKey}"
                           Watermark="sk-…" PasswordChar="•" />
                  <HyperlinkButton Content="Get your OpenAI API key at platform.openai.com"
                                   NavigateUri="https://platform.openai.com/api-keys"
                                   FontSize="10"
                                   Padding="0"
                                   HorizontalAlignment="Left" />
                  <TextBlock Text="Voice" FontSize="11" Foreground="#666" />
                  <ComboBox ItemsSource="{Binding OpenAiTtsVoices}"
                            SelectedItem="{Binding OpenAiTtsVoice}"
                            HorizontalAlignment="Stretch" />
                  <TextBlock Text="Model" FontSize="11" Foreground="#666" />
                  <ComboBox ItemsSource="{Binding OpenAiTtsModels}"
                            SelectedItem="{Binding OpenAiTtsModel}"
                            HorizontalAlignment="Stretch" />
                  <TextBlock Text="Speed" FontSize="11" Foreground="#666" />
                  <Grid ColumnDefinitions="*,52">
                    <Slider Grid.Column="0"
                            Minimum="0.25" Maximum="4.0"
                            Value="{Binding OpenAiTtsSpeed}"
                            TickFrequency="0.25" IsSnapToTickEnabled="True" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding OpenAiTtsSpeed, StringFormat='{}{0:F2}x'}"
                               FontSize="12" Foreground="#aaa"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </Grid>
                  <Button Content="Test Voice"
                          Command="{Binding TestVoiceCommand}"
                          Padding="12 4" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- ElevenLabs TTS settings -->
                <StackPanel IsVisible="{Binding ShowElevenLabsTtsSettings}" Spacing="8">
                  <TextBlock Text="API Key" FontSize="11" Foreground="#666" />
                  <TextBox Text="{Binding ElevenLabsApiKey}"
                           Watermark="Your ElevenLabs API key" PasswordChar="•" />
                  <HyperlinkButton Content="Get your ElevenLabs API key at elevenlabs.io"
                                   NavigateUri="https://elevenlabs.io/app/settings/api-keys"
                                   FontSize="10"
                                   Padding="0"
                                   HorizontalAlignment="Left" />
                  <TextBlock Text="Voice ID" FontSize="11" Foreground="#666" />
                  <TextBox Text="{Binding ElevenLabsVoiceId}"
                           Watermark="21m00Tcm4TlvDq8ikWAM (Rachel)" />
                  <TextBlock FontSize="10" Foreground="#444455"
                             Text="Find voice IDs in your ElevenLabs account under My Voices or the Voice Library." />
                  <TextBlock Text="Model" FontSize="11" Foreground="#666" />
                  <ComboBox ItemsSource="{Binding ElevenLabsModels}"
                            SelectedItem="{Binding ElevenLabsModel}"
                            HorizontalAlignment="Stretch" />
                  <Button Content="Test Voice"
                          Command="{Binding TestVoiceCommand}"
                          Padding="12 4" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Kokoro local TTS settings -->
                <StackPanel IsVisible="{Binding ShowKokoroTtsSettings}" Spacing="8">
                  <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#444455"
                             Text="Kokoro 82M is a high-quality neural TTS model that runs fully offline. On first use, the ONNX model weight file (~320 MB) is downloaded and cached automatically — no executable code is downloaded, only the neural network weights. Voice embeddings are bundled with the application." />

                  <TextBlock Text="Voice" FontSize="11" Foreground="#666" />
                  <ComboBox ItemsSource="{Binding KokoroVoiceLabels}"
                            SelectedItem="{Binding SelectedKokoroVoiceLabel}"
                            HorizontalAlignment="Stretch" />

                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0">
                    <Button Content="Load Model (downloads ~320 MB on first use)"
                            Command="{Binding DownloadKokoroModelCommand}"
                            IsEnabled="{Binding !IsDownloadingKokoroModel}"
                            Padding="12 4" />
                    <TextBlock Text="✔ Model loaded" FontSize="11" Foreground="#4caf81"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsKokoroModelDownloaded}" />
                  </StackPanel>

                  <ProgressBar IsIndeterminate="True"
                               Height="4"
                               IsVisible="{Binding IsDownloadingKokoroModel}" />
                  <TextBlock Text="{Binding KokoroModelStatus}"
                             FontSize="10" Foreground="#888"
                             IsVisible="{Binding KokoroModelStatus,
                                         Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <Button Content="Test Voice"
                          Command="{Binding TestVoiceCommand}"
                          IsEnabled="{Binding IsKokoroModelDownloaded}"
                          Padding="12 4" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Piper local TTS settings -->
                <StackPanel IsVisible="{Binding ShowPiperTtsSettings}" Spacing="8">
                  <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#444455"
                             Text="Piper is a fast offline neural TTS engine. The Piper runtime is bundled with the application — no executable downloads. Only the voice model (a data file) is downloaded on demand." />

                  <!-- Binary status -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Runtime:" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Text="✔ Bundled" FontSize="11" Foreground="#4caf81"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsPiperBinaryAvailable}" />
                    <TextBlock Text="⚠ Not found in app directory" FontSize="11" Foreground="#cc8844"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsPiperBinaryAvailable}" />
                  </StackPanel>

                  <TextBlock Text="Voice" FontSize="11" Foreground="#666" />
                  <ComboBox ItemsSource="{Binding PiperVoiceLabels}"
                            SelectedItem="{Binding SelectedPiperVoiceLabel}"
                            HorizontalAlignment="Stretch" />

                  <!-- Piper voice download -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Download Voice Model"
                            Command="{Binding DownloadPiperVoiceCommand}"
                            IsEnabled="{Binding !IsDownloadingPiper}"
                            Padding="12 4" />
                    <TextBlock Text="✔ Voice ready" FontSize="11" Foreground="#4caf81"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsPiperVoiceDownloaded}" />
                  </StackPanel>

                  <ProgressBar IsIndeterminate="{Binding IsDownloadingPiper}"
                               Height="4"
                               IsVisible="{Binding IsDownloadingPiper}" />
                  <TextBlock Text="{Binding PiperDownloadStatus}"
                             FontSize="10" Foreground="#888"
                             IsVisible="{Binding PiperDownloadStatus,
                                         Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <Button Content="Test Voice"
                          Command="{Binding TestVoiceCommand}"
                          IsEnabled="{Binding IsPiperVoiceDownloaded}"
                          Padding="12 4" HorizontalAlignment="Left" />
                </StackPanel>

              </StackPanel>
            </Grid>
          </Border>

          <!-- Speech Input (push-to-talk) -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Speech Input (Push-to-Talk)" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Grid.Row="1" Margin="12 10" Spacing="8">

                <TextBlock Text="Provider" FontSize="11" Foreground="#666" />
                <ComboBox ItemsSource="{Binding SpeechInputProviders}"
                          SelectedItem="{Binding SpeechInputProvider}"
                          HorizontalAlignment="Stretch" />
                <TextBlock FontSize="10" Foreground="#444455" TextWrapping="Wrap"
                           Text="{Binding MicHelpText}" />

                <!-- Microphone device selection (visible whenever a provider is chosen) -->
                <StackPanel IsVisible="{Binding ShowMicrophoneSettings}" Spacing="8">
                  <TextBlock Text="Microphone Device" FontSize="11" Foreground="#666" />
                  <Grid ColumnDefinitions="*,Auto">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding MicrophoneDevices}"
                              SelectedItem="{Binding SelectedMicrophoneDevice}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="(system default)" />
                    <Button Grid.Column="1" Content="↺"
                            Command="{Binding RefreshMicDevicesCommand}"
                            Padding="8 4" Margin="6 0 0 0"
                            ToolTip.Tip="Refresh the list of input devices" />
                  </Grid>
                  <TextBlock FontSize="10" Foreground="#444455"
                             Text="Works on both Windows and Linux (PortAudio). If the list is empty, click ↺ to refresh after your audio driver initialises." />
                </StackPanel>

                <!-- Global push-to-talk key -->
                <StackPanel IsVisible="{Binding ShowMicrophoneSettings}" Spacing="8">
                  <TextBlock Text="Global Push-to-Talk Key" FontSize="11" Foreground="#666" />
                  <ComboBox ItemsSource="{Binding PushToTalkKeyNames}"
                            SelectedItem="{Binding SelectedPushToTalkKeyName}"
                            HorizontalAlignment="Stretch" />
                  <TextBlock FontSize="10" Foreground="#444455" TextWrapping="Wrap"
                             Text="{Binding PttHelpText}" />
                </StackPanel>

                <!-- OpenAI Whisper cloud -->
                <StackPanel IsVisible="{Binding ShowCloudWhisperSettings}" Spacing="8">
                  <TextBlock Text="API Key" FontSize="11" Foreground="#666" />
                  <TextBlock Text="Shared with the OpenAI LLM provider setting above."
                             FontSize="10" Foreground="#444455" />
                  <TextBox Text="{Binding OpenAiApiKey}"
                           Watermark="sk-…" PasswordChar="•" />
                  <TextBlock FontSize="10" Foreground="#444455" TextWrapping="Wrap"
                             Text="Uses OpenAI Whisper API. Works on Windows and Linux." />
                </StackPanel>

                <!-- Local Whisper (Windows only) -->
                <StackPanel IsVisible="{Binding ShowLocalWhisperSettings}" Spacing="8">
                  <TextBlock FontSize="10" Foreground="#444455" TextWrapping="Wrap"
                             Text="Runs Whisper.net locally on this machine (Windows only). No API key required. A model file must be downloaded before first use." />

                  <TextBlock Text="Model" FontSize="11" Foreground="#666" />
                  <ComboBox ItemsSource="{Binding LocalWhisperModelLabels}"
                            SelectedItem="{Binding SelectedWhisperModelLabel}"
                            HorizontalAlignment="Stretch" />

                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0">
                    <Button Content="Download Model"
                            Command="{Binding DownloadModelCommand}"
                            IsEnabled="{Binding !IsDownloadingModel}"
                            Padding="12 4" />
                    <TextBlock Text="✔ Downloaded" FontSize="11" Foreground="#4caf81"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSelectedModelDownloaded}" />
                  </StackPanel>

                  <ProgressBar Value="{Binding ModelDownloadProgress}"
                               IsIndeterminate="{Binding IsDownloadingModel}"
                               Height="4"
                               IsVisible="{Binding IsDownloadingModel}" />
                  <TextBlock Text="{Binding ModelDownloadStatus}"
                             FontSize="10" Foreground="#888"
                             IsVisible="{Binding ModelDownloadStatus,
                                         Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </Grid>
          </Border>

          <!-- Save bar -->
          <Border Background="#161620" CornerRadius="4" Padding="10 8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="{Binding SaveStatus}"
                         FontSize="11" Foreground="#4caf81"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Save Agent Settings"
                      Command="{Binding SaveCommand}"
                      Padding="14 4" />
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

  <!-- ── Slack ─────────────────────────────────────────────────────────── -->
  <TabItem Header="Slack">
    <ScrollViewer>
      <StackPanel Spacing="16" Margin="24 16">

        <TextBlock Text="Slack Integration"
                   FontSize="14" FontWeight="SemiBold" Foreground="#c8a84b" />

        <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                   Text="Post from EVE Console straight into Slack. Posts are made with your own user token, so they appear as you — not as a bot. Nothing is posted automatically; you choose when to send." />

        <!-- Connect (one-click, PKCE) -->
        <StackPanel Spacing="8" IsVisible="{Binding SlackVm.CanConnect}">
          <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                     Text="Connecting opens Slack in your browser. Choose the workspace, approve access, and you're done — EVE Console never sees your Slack password, and you can revoke it any time from your Slack account settings." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect to Slack"
                    Command="{Binding SlackVm.ConnectCommand}"
                    IsEnabled="{Binding !SlackVm.IsBusy}"
                    Padding="14 5" FontSize="12"
                    Background="#1a2a1a" Foreground="#6aaa88"
                    BorderBrush="#2a3a2a" BorderThickness="1" />
            <Button Content="Cancel"
                    Command="{Binding SlackVm.CancelConnectCommand}"
                    IsVisible="{Binding SlackVm.IsConnecting}"
                    Padding="12 5" FontSize="12"
                    Background="#1a1a28" Foreground="#888899"
                    BorderBrush="#2a2a3a" BorderThickness="1" />
            <Button Content="Disconnect"
                    Command="{Binding SlackVm.DisconnectCommand}"
                    IsVisible="{Binding SlackVm.IsConnected}"
                    Padding="12 5" FontSize="12"
                    Background="#2a1010" Foreground="#cc4444"
                    BorderBrush="#3a1515" BorderThickness="1" />
            <Button Content="Reload Channels"
                    Command="{Binding SlackVm.LoadChannelsCommand}"
                    IsEnabled="{Binding !SlackVm.IsBusy}"
                    Padding="12 5" FontSize="12"
                    Background="#1a1a28" Foreground="#8888cc"
                    BorderBrush="#2a2a4a" BorderThickness="1" />
          </StackPanel>
          <TextBlock Text="{Binding SlackVm.Status}" FontSize="11" Foreground="#888899"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- Manual token — only when this build has no Slack Client ID compiled in -->
        <StackPanel Spacing="8" IsVisible="{Binding SlackVm.ShowManualToken}">
          <Border Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1" CornerRadius="4" Padding="14 12">
            <StackPanel Spacing="8">
              <TextBlock Text="Manual setup" FontSize="12" FontWeight="SemiBold" Foreground="#c8c8d8" />
              <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                         Text="1.  Open api.slack.com/apps and choose Create New App → From scratch. Name it (e.g. EVE Console) and pick your workspace." />
              <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                         Text="2.  Go to OAuth &amp; Permissions and add these under User Token Scopes (not Bot Token Scopes):" />
              <SelectableTextBlock Text="chat:write     channels:read     groups:read     im:read     mpim:read"
                                   FontFamily="Consolas, Menlo, monospace" FontSize="12" Foreground="#6aaa88"
                                   Margin="16 0 0 0" />
              <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                         Text="3.  Click Install to Workspace and approve, then copy the User OAuth Token (it starts with xoxp-)." />
              <Button Content="Open api.slack.com/apps"
                      Command="{Binding SlackVm.OpenSlackAppsCommand}"
                      HorizontalAlignment="Left" Padding="10 3" FontSize="11"
                      Background="#1a2a1a" Foreground="#6aaa88"
                      BorderBrush="#2a3a2a" BorderThickness="1" />
            </StackPanel>
          </Border>

          <TextBlock Text="User OAuth Token" FontSize="12" Foreground="#c8c8d8" />
          <TextBox Text="{Binding SlackVm.Token}" PasswordChar="●"
                   Watermark="xoxp-…" FontSize="12"
                   Background="#131320" Foreground="#ccccdd"
                   BorderBrush="#2a2a3a" BorderThickness="1" />
          <TextBlock TextWrapping="Wrap" Foreground="#666677" FontSize="11"
                     Text="Stored locally in your EVE Console database. Treat it like a password — it can post as you in any channel you can reach." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save &amp; Test"
                    Command="{Binding SlackVm.SaveAndTestCommand}"
                    IsEnabled="{Binding !SlackVm.IsBusy}"
                    Padding="12 4" FontSize="11"
                    Background="#1a2a1a" Foreground="#6aaa88"
                    BorderBrush="#2a3a2a" BorderThickness="1" />
            <Button Content="Reload Channels"
                    Command="{Binding SlackVm.LoadChannelsCommand}"
                    IsEnabled="{Binding !SlackVm.IsBusy}"
                    Padding="12 4" FontSize="11"
                    Background="#1a1a28" Foreground="#8888cc"
                    BorderBrush="#2a2a4a" BorderThickness="1" />
            <TextBlock Text="{Binding SlackVm.Status}" FontSize="11" Foreground="#888899"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <Border Height="1" Background="#1e1e2a" />

        <!-- Channel assignment per area -->
        <StackPanel Spacing="6">
          <TextBlock Text="Channels" FontSize="12" FontWeight="SemiBold" Foreground="#c8c8d8" />
          <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                     Text="Pick which channel each part of EVE Console posts to. A section's post button only appears once its channel is set." />
          <Grid ColumnDefinitions="200,*" Margin="0 4 0 0">
            <TextBlock Grid.Column="0" Text="Corp Activity — Top 10" FontSize="12" Foreground="#c8c8d8"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SlackVm.Channels}"
                      SelectedItem="{Binding SlackVm.CorpTop10Channel}"
                      PlaceholderText="Select a channel…"
                      HorizontalAlignment="Stretch" FontSize="12"
                      Background="#131320" Foreground="#ccccdd"
                      BorderBrush="#2a2a3a" BorderThickness="1" />
          </Grid>
          <Grid ColumnDefinitions="200,*" Margin="0 4 0 0">
            <TextBlock Grid.Column="0" Text="Corp Activity — Monthly Summary" FontSize="12" Foreground="#c8c8d8"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SlackVm.Channels}"
                      SelectedItem="{Binding SlackVm.CorpMonthlyChannel}"
                      PlaceholderText="Select a channel…"
                      HorizontalAlignment="Stretch" FontSize="12"
                      Background="#131320" Foreground="#ccccdd"
                      BorderBrush="#2a2a3a" BorderThickness="1" />
          </Grid>
          <Grid ColumnDefinitions="200,*" Margin="0 4 0 0">
            <TextBlock Grid.Column="0" Text="Sale Posting" FontSize="12" Foreground="#c8c8d8"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SlackVm.Channels}"
                      SelectedItem="{Binding SlackVm.SalePostingChannel}"
                      PlaceholderText="Select a channel…"
                      HorizontalAlignment="Stretch" FontSize="12"
                      Background="#131320" Foreground="#ccccdd"
                      BorderBrush="#2a2a3a" BorderThickness="1" />
          </Grid>
          <TextBlock TextWrapping="Wrap" Foreground="#666677" FontSize="11"
                     Text="Private channels only appear if you are a member of them. If a channel is missing, use Reload Channels." />
        </StackPanel>

        <!-- ── Incoming webhooks ──────────────────────────────────────────
             The reason these exist: a user token is granted by the workspace that issued it, and
             an alliance will hand out a webhook where it would never hand out a token for its own
             Slack. -->
        <StackPanel Spacing="8">
          <TextBlock Text="Incoming Webhooks" FontSize="14" FontWeight="SemiBold"
                     Foreground="#c8a84b" />
          <TextBlock TextWrapping="Wrap" Foreground="#8a8a99" FontSize="11"
                     Text="For workspaces you cannot connect to as yourself — an alliance Slack, typically. A webhook URL is created in that workspace and is bound to one channel, so setting one here overrides the channel chosen above for that area. Posts arrive as the webhook's own app rather than as you." />
          <TextBlock TextWrapping="Wrap" Foreground="#8a8a99" FontSize="11"
                     Text="⚠ A webhook cannot thread. Nothing posted through one returns a message id, so a sale posting's detail arrives as a second message instead of a reply under the first." />

          <Grid ColumnDefinitions="200,*" Margin="0 4 0 0">
            <TextBlock Grid.Column="0" Text="Corp Top 10" FontSize="12" Foreground="#c8c8d8"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SlackVm.Top10Webhook, UpdateSourceTrigger=LostFocus}"
                     Watermark="https://hooks.slack.com/services/…" FontSize="12"
                     Background="#131320" Foreground="#ccccdd" BorderBrush="#2a2a3a" />
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0" Text="Monthly Summary" FontSize="12" Foreground="#c8c8d8"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SlackVm.MonthlyWebhook, UpdateSourceTrigger=LostFocus}"
                     Watermark="https://hooks.slack.com/services/…" FontSize="12"
                     Background="#131320" Foreground="#ccccdd" BorderBrush="#2a2a3a" />
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0" Text="Sale Posting" FontSize="12" Foreground="#c8c8d8"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SlackVm.SalePostingWebhook, UpdateSourceTrigger=LostFocus}"
                     Watermark="https://hooks.slack.com/services/…" FontSize="12"
                     Background="#131320" Foreground="#ccccdd" BorderBrush="#2a2a3a" />
          </Grid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </TabItem>

  <!-- ── Alerts ────────────────────────────────────────────────────────── -->
  <TabItem Header="Alerts">
    <ScrollViewer>
      <StackPanel Spacing="20" Margin="24 16">

        <TextBlock Text="Alert Rules"
                   FontSize="14" FontWeight="SemiBold" Foreground="#c8a84b" />
        <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                   Text="Configure which conditions trigger alerts on the Overview tab. Alerts are re-evaluated each time the Overview is refreshed." />

        <!-- Skill Queue alerts -->
        <Border Background="#161620" BorderBrush="#252530" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="10">
            <TextBlock Text="Skill Queue" FontWeight="SemiBold"
                       Foreground="#c8a84b" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="Character skill queue is empty"
                      IsChecked="{Binding AlertsVm.SkillQueueEmpty}"
                      FontSize="12" Foreground="#ccccdd" />

            <CheckBox Content="Character skill queue is paused (has entries but nothing training)"
                      IsChecked="{Binding AlertsVm.SkillQueuePaused}"
                      FontSize="12" Foreground="#ccccdd" />

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <CheckBox Content="Skill queue will be empty within"
                        IsChecked="{Binding AlertsVm.SkillQueueEmptyInDays}"
                        FontSize="12" Foreground="#ccccdd"
                        VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding AlertsVm.SkillQueueEmptyDays}"
                             IsEnabled="{Binding AlertsVm.SkillQueueEmptyInDays}"
                             Minimum="1" Maximum="365" Increment="1"
                             FormatString="0" FontSize="12"
                             Width="120" VerticalAlignment="Center" />
              <TextBlock Text="days"
                         FontSize="12" Foreground="#aaa"
                         VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 6 0 0">
              <Button Content="Save Alerts"
                      Command="{Binding AlertsVm.SaveCommand}"
                      Padding="14 4" />
              <TextBlock Text="{Binding AlertsVm.Status}"
                         FontSize="11" Foreground="#888"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Asset Safety alerts -->
        <Border Background="#161620" BorderBrush="#252530" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="8">
            <TextBlock Text="Asset Safety" FontWeight="SemiBold"
                       Foreground="#c8a84b" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="Alert when items are moved into Asset Safety"
                      IsChecked="{Binding AlertsVm.AssetSafety}"
                      FontSize="12" Foreground="#ccccdd" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888899"
                       Text="Triggers when a StructureItemsMovedIntoSafety notification is received for any authenticated character. The alert persists until you manually dismiss it." />
          </StackPanel>
        </Border>

        <!-- Standing Projects alerts -->
        <Border Background="#161620" BorderBrush="#252530" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="8">
            <TextBlock Text="Standing Projects" FontWeight="SemiBold"
                       Foreground="#c8a84b" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="Alert when standing projects are not currently active"
                      IsChecked="{Binding AlertsVm.InactiveStandingProjects}"
                      FontSize="12" Foreground="#ccccdd" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888899"
                       Text="Triggers when one or more standing projects (Corp Activity → Projects → Standing Projects) have no matching active ESI corp project. Re-evaluated each time the Overview refreshes." />
          </StackPanel>
        </Border>

        <!-- Standing Buy Orders alerts -->
        <Border Background="#161620" BorderBrush="#252530" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="8">
            <TextBlock Text="Standing Buy Orders" FontWeight="SemiBold"
                       Foreground="#c8a84b" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="Alert when standing buy orders need attention"
                      IsChecked="{Binding AlertsVm.StandingBuyOrdersAttention}"
                      FontSize="12" Foreground="#ccccdd" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888899"
                       Text="Triggers when a standing buy order (Market / Trade → Standing Buy Orders) has no matching live order, has been outbid at that station, has fallen below 10% of its original volume, or has under 20% of its duration left. The alert says which, since placing an order, raising a price, topping one up and renewing one are different jobs. Re-evaluated each time the Overview refreshes." />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666"
                       Text="Outbid detection compares against the public order book, which only covers stations and structures configured as market sources under Settings → Market. Anywhere else shows a dash rather than claiming there is no competition." />
          </StackPanel>
        </Border>

        <!-- Industry facility alerts -->
        <Border Background="#161620" BorderBrush="#252530" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <StackPanel Spacing="8">
            <TextBlock Text="Industry Facilities" FontWeight="SemiBold"
                       Foreground="#c8a84b" FontSize="12" Margin="0 0 0 4" />

            <CheckBox Content="Alert when running jobs are in a facility not rigged for them"
                      IsChecked="{Binding AlertsVm.UnriggedIndustryJobs}"
                      FontSize="12" Foreground="#ccccdd" />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888899"
                       Text="Counts active manufacturing and reaction jobs whose facility has no rig bonusing that kind of work. Research, copying and invention are not counted — they use rigs this check does not model." />

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666"
                       Text="Only facilities linked to an Indy Parks structure can be judged: ESI cannot report what rigs a structure has fitted, so the rigs are whatever you described in Indy Parks. Link a structure to a real facility there to include it. Unlinked facilities are ignored rather than reported as unrigged." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </TabItem>

    <!-- ══ Database ════════════════════════════════════════════════════════════ -->
    <TabItem Header="Database">
      <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" DataContext="{Binding DatabaseVm}">

          <!-- DB type -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Database Type" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>
              <StackPanel Margin="12 10 12 12" Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="Type:" Foreground="#ccc" FontSize="12"
                             VerticalAlignment="Center" Margin="0 0 10 0" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding DbTypes}"
                            SelectedItem="{Binding SelectedDbType}"
                            HorizontalAlignment="Left" MinWidth="160" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- SQLite section (shown when SQLite selected) -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding IsSqlite}">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="SQLite Database" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <!-- Path + size -->
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="Path:" Foreground="#ccc"
                               FontSize="12" VerticalAlignment="Top" Margin="0 0 10 0" />
                    <TextBlock Grid.Column="1" Text="{Binding DbPath}"
                               Foreground="#aaa" FontSize="11" TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="Size:" Foreground="#ccc"
                               FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                    <TextBlock Grid.Column="1" Text="{Binding DbFileSizeText}"
                               Foreground="#888" FontSize="11" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <!-- Move-or-rename / Repoint buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <!-- One button: a rename is a move to the same folder under a different name,
                       and the file picker already lets the user choose both. -->
                  <Button Content="Move / Rename Database…"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnRelocateDatabaseClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1"
                          ToolTip.Tip="Move the database to another folder or drive, or give it a different name. The application restarts to do it." />
                  <Button Content="Point to Existing DB…"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnPointToDbClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1" />
                  <Button Content="Shrink Database…"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnShrinkDatabaseClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1"
                          ToolTip.Tip="Rebuild the database file so space freed by deleted data is returned to your drive. Restarts the application." />
                </StackPanel>

                <TextBlock Text="These operations copy or move the database file and restart the application."
                           FontSize="11" Foreground="#666" TextWrapping="Wrap" />

                <Separator Background="#252530" Height="1" Margin="0 4 0 4" />

                <!-- Backup settings -->
                <CheckBox Content="Automatically back up database"
                          IsChecked="{Binding BackupEnabled}"
                          Foreground="#ccc" FontSize="12" />

                <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto" Margin="16 0 0 0">
                  <TextBlock Grid.Column="0" Text="Interval:" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0"
                             IsEnabled="{Binding BackupEnabled}" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding BackupIntervals}"
                            SelectedItem="{Binding SelectedInterval}"
                            MinWidth="120"
                            IsEnabled="{Binding BackupEnabled}" />

                  <TextBlock Grid.Column="3" Text="Keep:" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0"
                             IsEnabled="{Binding BackupEnabled}" />
                  <NumericUpDown Grid.Column="4"
                                 Value="{Binding BackupsToKeep}"
                                 Minimum="1" Maximum="365"
                                 Width="120" FontSize="12"
                                 IsEnabled="{Binding BackupEnabled}" />
                </Grid>

                <!-- Last backup + manual backup button -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 4 0 0">
                  <TextBlock Grid.Column="0" Text="Last backup:" Foreground="#ccc"
                             FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0" />
                  <TextBlock Grid.Column="1" Text="{Binding LastBackupText}"
                             Foreground="#aaa" FontSize="12" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="Back Up Now"
                          IsEnabled="{Binding !IsBusy}"
                          Click="OnBackupNowClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a2a1a" Foreground="#70ad47"
                          BorderBrush="#253525" BorderThickness="1" />
                </Grid>

                <!-- Status -->
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#70ad47" FontSize="11"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

              </StackPanel>
            </StackPanel>
          </Border>


          <!-- Storage breakdown -->
          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding IsSqlite}">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Storage Breakdown" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap"
                           Text="What the database file is spent on, table data and indexes separately. Figures are measured from the data and scaled to match the file's used pages — accurate enough to decide what is worth keeping, not a page-level audit. Large tables are sampled rather than read in full." />

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Load"
                          IsEnabled="{Binding CanAnalyse}"
                          Click="OnAnalyseDbSizeClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1" />
                  <TextBlock Text="{Binding SizeStatusText}" Foreground="#888" FontSize="11"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Text="{Binding SizeSummaryText}" Foreground="#aaa" FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="{Binding SizeSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <DataGrid ItemsSource="{Binding TableSizes}"
                          IsVisible="{Binding HasTableSizes}"
                          AutoGenerateColumns="False" IsReadOnly="True" RowHeight="22"
                          MaxHeight="520"
                          CanUserReorderColumns="False" CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Background="#0d0d12">
                  <DataGrid.Styles>
                    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
                    <Style Selector="DataGridColumnHeader">
                      <Setter Property="Background" Value="#12121a" />
                      <Setter Property="Foreground" Value="#555566" />
                      <Setter Property="FontSize"   Value="10" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="Padding"    Value="6 5 2 5" />
                    </Style>
                  </DataGrid.Styles>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Table" Width="*" SortMemberPath="Name">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TableSizeVm">
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding Tooltip}"
                                     TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Rows"    Binding="{Binding RowsText}"  Width="110" />
                    <DataGridTextColumn Header="Data"    Binding="{Binding TableText}" Width="90"  />
                    <DataGridTextColumn Header="Indexes" Binding="{Binding IndexText}" Width="90"  />
                    <DataGridTextColumn Header="Total"   Binding="{Binding TotalText}" Width="90"
                                        SortMemberPath="SharePercent" />
                    <DataGridTextColumn Header="Share"   Binding="{Binding ShareText}" Width="70"
                                        SortMemberPath="SharePercent" />
                    <DataGridTextColumn Header="Method"  Binding="{Binding Method}"    Width="80"  />
                  </DataGrid.Columns>
                </DataGrid>

              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Data Retention ══════════════════════════════════════════════════ -->
    <TabItem Header="Data Retention">
      <ScrollViewer Margin="0 8 0 0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" x:DataType="vm:DataRetentionSettingsViewModel"
                    DataContext="{Binding RetentionVm}">

          <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="2 0 2 0"
                     Text="How long EVE Console keeps data it can afford to forget. Every rule here is off until you turn it on, and each runs once at startup. Purging removes rows, but SQLite reuses the freed pages rather than returning them, so the file itself only gets smaller after a compaction — see Database → Shrink Database. Database → Storage Breakdown shows where the space actually went." />

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding ErrorLog}" x:DataType="vm:RetentionSectionVm">
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Error Log" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="The error log is for reading the last few hours, not for keeping history. Left unattended it grows past a hundred thousand entries, at which point nobody looks at it. Under 1% of a measured 4 GB database, so this keeps the log readable rather than reclaiming space." />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="Purge entries older than"
                            Foreground="#ccc" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="days" Foreground="#ccc" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Purge Now"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgeErrorLogClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="#666" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="#888" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding Killmails}" x:DataType="vm:RetentionSectionVm">
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Kill Mails" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Removes the kill and everything attached to it — attackers, items, references and zKillboard flags. Kill mails and their indexes are the largest thing in a typical database (61% of a measured 4 GB file), so this is the rule that actually reclaims space. ⚠️ Deleted kills are gone locally; getting them back means re-fetching from ESI or zKillboard, and ESI only serves recent ones." />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="Purge kill mails older than"
                            Foreground="#ccc" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="days" Foreground="#ccc" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Purge Now"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgeKillmailsClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="#666" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="#888" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding PriceHistory}" x:DataType="vm:RetentionSectionVm">
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Price History" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Removes daily market history per region and type, together with the derived per-type price snapshots built from it — both together, because keeping one without the other leaves a history that disagrees with itself. About 15% of a measured 4 GB file. ESI serves roughly a year of history, so recent rows can be re-fetched." />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="Purge price history older than"
                            Foreground="#ccc" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="days" Foreground="#ccc" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Purge Now"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgePriceHistoryClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="#666" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="#888" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding GameLog}" x:DataType="vm:RetentionSectionVm">
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Game Log" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Removes parsed game-log events — ratting, mining and industry activity read from your EVE client logs. The .log files on disk are left alone, so anything purged here can be re-imported with Game Logs → Import Past Logs for as long as those files survive." />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="Purge game log events older than"
                            Foreground="#ccc" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="days" Foreground="#ccc" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Purge Now"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgeGameLogClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="#666" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="#888" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel DataContext="{Binding ChatMessages}" x:DataType="vm:RetentionSectionVm">
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Chat Messages" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="10">

                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Removes stored chat messages. Intel reports already parsed from them are kept — reports older than the oldest surviving message are treated as history that cannot be rebuilt, both by the startup cleanup and by Chat Logs → parse stored history, which rebuilds only the period it can actually reproduce. The .log files on disk are untouched, so a re-import stays possible while they exist." />

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            Content="Purge chat messages older than"
                            Foreground="#ccc" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1"
                                 Value="{Binding Days}"
                                 Minimum="{Binding MinimumDays}" Maximum="3650"
                                 Increment="1" FormatString="0"
                                 Width="110" FontSize="12" Margin="8 0 8 0" />
                  <TextBlock Grid.Column="2" Text="days" Foreground="#ccc" FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Purge Now"
                          IsEnabled="{Binding CanPurge}"
                          Click="OnPurgeChatClick"
                          Padding="12 5" FontSize="12"
                          Background="#1a1a28" Foreground="#aac8ff"
                          BorderBrush="#2a2a48" BorderThickness="1" />
                  <TextBlock Text="{Binding LastRunText}" Foreground="#666" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="#888" FontSize="11"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ══ Updates ═════════════════════════════════════════════════════════ -->
    <TabItem Header="Updates">
      <StackPanel Margin="16" Spacing="14" MaxWidth="560" HorizontalAlignment="Left">

        <CheckBox IsChecked="{Binding UpdateVm.AutoCheck}"
                  Content="Automatically check for updates"
                  Foreground="#ccccdd" FontSize="12" />
        <TextBlock Text="Checks on startup and once an hour. When a new version is found you'll be prompted; declining won't ask again until the next version."
                   FontSize="11" Foreground="#555566" TextWrapping="Wrap" Margin="24 -6 0 0" />

        <Border Background="#131320" BorderBrush="#252535" BorderThickness="1" CornerRadius="4" Padding="14 10">
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Current version" Foreground="#888899" FontSize="12" Margin="0 0 0 6" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UpdateVm.CurrentVersionText}" Foreground="#ccccdd" FontSize="12" Margin="0 0 0 6" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Latest version"  Foreground="#888899" FontSize="12" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdateVm.LatestVersionText}"  Foreground="#e8a030" FontSize="12" />
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Check Now" Command="{Binding UpdateVm.CheckNowCommand}" Padding="14 5" />
          <Button Content="Update Now" Command="{Binding UpdateVm.InstallUpdateCommand}"
                  IsVisible="{Binding UpdateVm.UpdateAvailable}"
                  IsEnabled="{Binding !UpdateVm.IsBusy}" Padding="14 5" />
        </StackPanel>

        <TextBlock Text="{Binding UpdateVm.StatusText}" FontSize="11" Foreground="#888899" TextWrapping="Wrap" />

      </StackPanel>
    </TabItem>

    <!-- ══ Other ══════════════════════════════════════════════════════════════ -->
    <TabItem Header="Other">
      <ScrollViewer Margin="0 8 0 0">
        <StackPanel Spacing="14" x:DataType="vm:OtherSettingsViewModel" DataContext="{Binding OtherVm}">

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="EVE Time Link" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Clicking the EVE clock in the title bar opens this site. Pick one of the suggestions or choose Custom URL and enter your own." />

                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="Open:" Foreground="#ccc" FontSize="12"
                             VerticalAlignment="Center" Margin="0 0 10 0" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding EveTimeSiteOptions}"
                            SelectedItem="{Binding SelectedEveTimeSite}" />
                </Grid>

                <TextBox Text="{Binding CustomEveTimeUrl}"
                         Watermark="https://example.com/"
                         IsVisible="{Binding IsCustomSelected}" />

                <TextBlock Text="{Binding EffectiveUrl, StringFormat='Clicking the clock opens: {0}'}"
                           FontSize="11" Foreground="#666" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="#252530" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Border Background="#161620" CornerRadius="4 4 0 0" Padding="10 6">
                <TextBlock Text="Server Status Link" FontWeight="SemiBold" Foreground="#c8a84b" />
              </Border>

              <StackPanel Margin="12 10 12 12" Spacing="8">
                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Clicking the Tranquility indicator beside the clock opens CCP's official service status page. Not configurable — no other site carries the same information." />
                <TextBlock Text="https://status.eveonline.com/" FontSize="11" Foreground="#666" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

  </TabControl>
</Window>
