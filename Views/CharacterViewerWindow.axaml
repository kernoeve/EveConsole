<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveConsole.Views"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.CharacterViewerWindow"
        x:DataType="vm:CharacterViewerViewModel"
        Title="Character Viewer"
        Width="1100" Height="720"
        MinWidth="860" MinHeight="520"
        Background="#0d0d12">
  <views:CharacterViewerView DataContext="{Binding}" />
</Window>
