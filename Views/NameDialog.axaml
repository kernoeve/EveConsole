<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.NameDialog"
        Width="360" Height="160"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d12">

  <Grid RowDefinitions="*,Auto" Margin="20">

    <StackPanel Grid.Row="0" Spacing="8">
      <TextBlock x:Name="LabelText" FontSize="10" FontWeight="SemiBold"
                 Foreground="#555566" LetterSpacing="1" />
      <TextBox x:Name="NameBox"
               Background="#1a1a28" BorderBrush="#2a2a3a" BorderThickness="1"
               CornerRadius="3" Foreground="#e8e8f0" CaretBrush="#c8a84b"
               FontSize="13" Padding="8 5" />
      <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#aa4444"
                 IsVisible="False" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0 12 0 0">
      <Button Grid.Column="1" Content="Cancel"
              Background="#1a1a28" Foreground="#888899"
              BorderBrush="#2a2a3a" BorderThickness="1"
              Padding="14 6" Margin="0 0 8 0"
              Click="OnCancelClick" />
      <Button Grid.Column="2" Content="OK"
              Background="#1a2030" Foreground="#c8a84b"
              BorderBrush="#3a3020" BorderThickness="1"
              Padding="14 6"
              Click="OnOkClick" />
    </Grid>

  </Grid>
</Window>
