<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.AgentDocumentView"
             x:DataType="vm:AgentDocumentViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="Button.bar">
      <Setter Property="FontSize"        Value="10" />
      <Setter Property="Padding"         Value="10 3" />
      <Setter Property="Background"      Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ══ Markdown ══════════════════════════════════════════════════════════
         Every class here is applied by MarkdownRenderer, which sets no colours
         or sizes of its own. Keeping the appearance in the theme means a report
         follows a palette change like any other screen. -->

    <Style Selector="SelectableTextBlock.md-h1">
      <Setter Property="FontSize"   Value="21" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Margin"     Value="0 4 0 10" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h2">
      <Setter Property="FontSize"   Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
      <Setter Property="Margin"     Value="0 16 0 6" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h3">
      <Setter Property="FontSize"   Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
      <Setter Property="Margin"     Value="0 12 0 4" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h4">
      <Setter Property="FontSize"   Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Margin"     Value="0 10 0 3" />
    </Style>

    <Style Selector="SelectableTextBlock.md-p">
      <Setter Property="FontSize"   Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Margin"     Value="0 0 0 9" />
    </Style>

    <Style Selector="StackPanel.md-list">      <Setter Property="Margin" Value="4 0 0 9" /></Style>
    <Style Selector="SelectableTextBlock.md-marker">
      <Setter Property="FontSize"   Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin"     Value="0 0 8 0" />
      <Setter Property="MinWidth"   Value="18" />
    </Style>
    <!-- A paragraph inside a list item carries the list's own rhythm, not the body's. -->
    <Style Selector="StackPanel.md-list SelectableTextBlock.md-p">
      <Setter Property="Margin" Value="0 0 0 3" />
    </Style>

    <Style Selector="Run.md-codespan">
      <Setter Property="FontFamily" Value="Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Span.md-link">
      <Setter Property="Foreground"     Value="{DynamicResource InfoBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Span.md-strike">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground"      Value="{DynamicResource TextFaintBrush}" />
    </Style>

    <Style Selector="Border.md-code">
      <Setter Property="Background"      Value="{DynamicResource SurfacePanelAltBrush}" />
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius"    Value="3" />
      <Setter Property="Padding"         Value="10 8" />
      <Setter Property="Margin"          Value="0 0 0 10" />
    </Style>
    <Style Selector="SelectableTextBlock.md-codetext">
      <Setter Property="FontFamily"    Value="Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace" />
      <Setter Property="FontSize"      Value="11" />
      <Setter Property="Foreground"    Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextWrapping"  Value="NoWrap" />
    </Style>

    <Style Selector="Border.md-quote">
      <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3 0 0 0" />
      <Setter Property="Padding"         Value="12 2 0 0" />
      <Setter Property="Margin"          Value="0 0 0 10" />
    </Style>

    <Style Selector="Border.md-hr">
      <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="Height"     Value="1" />
      <Setter Property="Margin"     Value="0 6 0 16" />
    </Style>

    <Style Selector="Grid.md-table">         <Setter Property="Margin" Value="0 0 0 12" /></Style>
    <Style Selector="Border.md-th">
      <Setter Property="Background"      Value="{DynamicResource SurfaceHeaderBrush}" />
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding"         Value="9 5" />
    </Style>
    <Style Selector="Border.md-td">
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding"         Value="9 4" />
    </Style>
    <!-- Table cells hold paragraphs; they must not carry the body's bottom margin. -->
    <Style Selector="Border.md-th SelectableTextBlock.md-p">
      <Setter Property="Margin" Value="0" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="Border.md-td SelectableTextBlock.md-p">
      <Setter Property="Margin" Value="0" /><Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="SelectableTextBlock.md-error">
      <Setter Property="FontSize"   Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
      <Setter Property="Margin"     Value="0 0 0 10" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="10 6"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SubtitleText}" IsVisible="{Binding HasSubtitle}"
                     FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" FontSize="11"
                     Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                     IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Classes="bar" Content="Copy Markdown" Command="{Binding CopyCommand}" />
          <Button Classes="bar" Content="Save"          Click="OnSaveClick"
                  Foreground="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <!-- Held to a readable measure and centred, so a report on a wide monitor reads as a
           document rather than as one very long line. -->
      <Border MaxWidth="860" HorizontalAlignment="Left" Margin="24 18 24 40">
        <ContentControl x:Name="Body" />
      </Border>
    </ScrollViewer>

  </Grid>
</UserControl>
