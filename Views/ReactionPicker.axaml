<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:views="using:EveConsole.Views"
             x:Class="EveConsole.Views.ReactionPicker"
             x:DataType="views:ReactionPicker"
             Width="372" Height="360">

  <UserControl.Styles>
    <Style Selector="ListBox#RowList ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#RowList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox#RowList ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <!-- ⚠️ Named, each system's colour one: left to the font search, Windows finds Segoe UI Symbol first and draws most in grey outline. -->
    <Style Selector="Button.emoji"><Setter Property="FontFamily" Value="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji" /><Setter Property="Width" Value="38" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="20" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button.quick"><Setter Property="Width" Value="42" /><Setter Property="FontSize" Value="22" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <!-- The ones most used, first, as every client offers them. -->
    <ItemsControl x:Name="QuickRow" Grid.Row="0" Margin="0 0 0 4">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Button Classes="emoji quick" Content="{Binding}" Click="OnPick" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBox x:Name="SearchBox" Grid.Row="1" Classes="clearButton" Margin="2 0 2 6" FontSize="12" Watermark="{x:Static loc:JabberText.ReactionSearchHint}" />

    <ListBox x:Name="RowList" Grid.Row="2" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.DataTemplates>
        <DataTemplate x:DataType="views:ReactionHeading">
          <TextBlock Text="{Binding Text}" FontSize="11" Margin="4 6 0 2" Foreground="{DynamicResource TextFaintBrush}" />
        </DataTemplate>
        <DataTemplate x:DataType="views:ReactionRow">
          <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:ReactionCell">
                <Button Classes="emoji" Content="{Binding Emoji}" Click="OnPick" ToolTip.Tip="{Binding Name}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>
  </Grid>
</UserControl>
