<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:views="clr-namespace:EveConsole.Views"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.ProductionCalculatorWindow"
        x:DataType="vm:ProductionCalculatorViewModel"
        Title="{x:Static loc:IndustryText.TitleProductionCalculator}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource SurfaceBaseBrush}">
  <views:ProductionCalculatorView DataContext="{Binding}" />
</Window>
