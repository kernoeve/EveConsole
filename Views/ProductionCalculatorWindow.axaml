<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveCortex.Views"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.ProductionCalculatorWindow"
        x:DataType="vm:ProductionCalculatorViewModel"
        Title="Production Calculator"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        Background="#0d0d12">
  <views:ProductionCalculatorView DataContext="{Binding}" />
</Window>
