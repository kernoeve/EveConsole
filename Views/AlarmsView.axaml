<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.AlarmsView"
             x:DataType="vm:AlarmsViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin" Value="2 0 0 2" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
      <Setter Property="Margin" Value="0 0 0 6" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InfoSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12 4" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
          <DataTemplate x:Key="ActionTemplate" x:DataType="vm:AlarmActionVm">
            <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="10 8" Margin="0 0 0 6">
              <StackPanel Spacing="8">

                <Grid ColumnDefinitions="220,*,Auto">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableKinds}"
                            SelectedItem="{Binding Kind}" FontSize="11"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding, Converter={x:Static views:AlarmActionKindNameConverter.Instance}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Content="Remove" FontSize="10.5"
                          Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WarnBrush}"
                          Command="{Binding RemoveCommand}" />
                </Grid>

                <!-- Sound -->
                <StackPanel IsVisible="{Binding IsSound}" Spacing="3">
                  <Grid ColumnDefinitions="*,80,Auto,Auto">
                    <StackPanel Grid.Column="0" Margin="0 0 8 0">
                      <TextBlock Classes="flabel" Text="SOUND" />
                      <ComboBox ItemsSource="{Binding AvailableSounds}" SelectedItem="{Binding Sound}"
                                HorizontalAlignment="Stretch" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0 0 8 0">
                      <TextBlock Classes="flabel" Text="VOLUME" />
                      <TextBox Text="{Binding Volume}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="tool" Content="▶ Preview"
                            Command="{Binding PreviewCommand}" VerticalAlignment="Bottom" />
                    <Button Grid.Column="3" Classes="tool" Content="Add Sound…"
                            Command="{Binding AddSoundCommand}" VerticalAlignment="Bottom"
                            Margin="6 0 0 0" />
                  </Grid>
                  <TextBlock Text="{Binding ImportError}" FontSize="9.5" Foreground="{DynamicResource BadBrush}" />
                  <CheckBox IsChecked="{Binding Loop}" IsVisible="{Binding HasStages}"
                            Content="Repeat until acknowledged, or until the situation ends on its own"
                            FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <!-- TTS direct: the check's own words, or the user's, straight to the voice -->
                <StackPanel IsVisible="{Binding IsTts}">
                  <TextBlock Classes="flabel" Text="WORDS TO SAY (OPTIONAL)" />
                  <TextBox Text="{Binding Body}" AcceptsReturn="True" MinHeight="40"
                           Watermark="leave empty to say what the check composed" />
                  <TextBlock FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="2 3 0 0"
                             Text="Spoken at once by text-to-speech, no agent involved — needs a voice under Settings → Agent, not a model, and works with the agent switched off. Shows in the agent window as the application's own line. Placeholders: {alarm} {summary} {count} {time} {date}" />
                </StackPanel>

                <!-- Agent -->
                <StackPanel IsVisible="{Binding IsAgent}">
                  <TextBlock Classes="flabel" Text="EXTRA INSTRUCTION FOR THE AGENT (OPTIONAL)" />
                  <TextBox Text="{Binding Instruction}"
                           Watermark="e.g. mention which system, and keep it short" />
                  <TextBlock FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="2 3 0 0"
                             Text="The agent is told what fired and phrases it itself. It will speak aloud if you have text-to-speech configured; if the agent is not set up, this is recorded as an alert instead." />
                </StackPanel>

                <!-- Alert / Dialog -->
                <StackPanel Spacing="6" IsVisible="{Binding HasText}">
                  <CheckBox IsChecked="{Binding UseDefaultText}"
                            Content="Use the default wording for this check"
                            FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                             IsVisible="{Binding UseDefaultText}"
                             Text="{Binding DefaultTextPreview}" />

                  <StackPanel Spacing="6" IsVisible="{Binding !UseDefaultText}">
                    <StackPanel>
                      <TextBlock Classes="flabel" Text="TITLE" />
                      <TextBox Text="{Binding Title}" Watermark="{}{alarm}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Classes="flabel" Text="MESSAGE" />
                      <TextBox Text="{Binding Body}" AcceptsReturn="True" MinHeight="54"
                               Watermark="{}{summary}" />
                    </StackPanel>
                    <TextBlock FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                               Text="Placeholders: {alarm} {summary} {count} {time} {date}" />
                  </StackPanel>
                </StackPanel>

              </StackPanel>
            </Border>
          </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,1,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <StackPanel Spacing="5">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <Button Grid.Column="0" Classes="tool" Command="{Binding NewCommand}" Content="New Alarm" />
        <Button Grid.Column="1" Classes="tool" Command="{Binding RefreshCommand}"
                Content="Refresh" Margin="8 0 0 0" />
        <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="16 0 0 0" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="4" Text="{Binding Service.StatusText}" FontSize="10.5"
                   Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="12 0 0 0" />

        <!-- Muting this machine, where the alarms themselves are edited. The same state the
             beacon's right-click menu changes — this is a second way to reach it, not a second
             copy of it. -->
        <Button Grid.Column="5" x:Name="MuteButton" Classes="tool"
                Content="{Binding AlarmsMuteText}" Margin="12 0 0 0"
                Click="OnMuteClick"
                Foreground="{Binding AlarmsMuted,
                             Converter={x:Static views:AlarmMuteBrushConverter.Instance}}"
                ToolTip.Tip="Sound, dialogs and agent notifications on this machine only. Alerts go on being recorded either way, and other clients are unaffected." />
      </Grid>
        <TextBlock Text="Early development — this tool is still taking shape, and its behaviour, layout and stored settings are all subject to change."
                   FontSize="10.5" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="1 0 0 0" />
      </StackPanel>
    </Border>

    <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtleBrush}" />

    <Grid Grid.Row="2" ColumnDefinitions="360,1,*">

      <!-- ── Left: alarm list, then open alerts ─────────────────────────── -->
      <Grid Grid.Column="0" RowDefinitions="*,Auto">

        <ListBox Grid.Row="0" ItemsSource="{Binding Alarms}"
                 SelectedItem="{Binding SelectedAlarm}"
                 Background="{DynamicResource SurfaceBaseBrush}" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AlarmRowVm">
              <Grid ColumnDefinitions="Auto,*" Margin="0 3">
                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" IsHitTestVisible="False"
                          VerticalAlignment="Top" Margin="0 2 6 0" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="2" Padding="4 0"
                            IsVisible="{Binding IsAgentCreated}" VerticalAlignment="Center">
                      <TextBlock Text="agent" FontSize="8.5" Foreground="{DynamicResource InfoBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Condition}" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" />
                    <TextBlock Text="{Binding LastFiredText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBaseBrush}" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                Padding="10 8" MaxHeight="260"
                IsVisible="{Binding HasAlerts}">
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="OPEN ALERTS" />
            <ItemsControl ItemsSource="{Binding Alerts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AlarmAlertVm">
                  <Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="3" Padding="8 6" Margin="0 0 0 4">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Body}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WhenText}" FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="✕" Command="{Binding DismissCommand}"
                              Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextDimBrush}"
                              Padding="6 0" VerticalAlignment="Top" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <Rectangle Grid.Column="1" Fill="{DynamicResource BorderSubtleBrush}" />

      <!-- ── Right: editor, a fixed action bar, then history ─────────────── -->
      <Grid Grid.Column="2" RowDefinitions="*,Auto,1,Auto">

        <!-- Margin on the content rather than Padding on the ScrollViewer: padding is not
             counted in the scrollable extent, so the last thing in the panel stays clipped
             however far down you scroll. -->
        <ScrollViewer Grid.Row="0" IsVisible="{Binding HasEditor}">
          <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left" Margin="16 14 16 14">

            <!-- Name / enabled -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0">
                <TextBlock Classes="flabel" Text="NAME" />
                <TextBox Text="{Binding Name}" Watermark="What is this alarm for?" />
              </StackPanel>
              <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Content="Enabled"
                        FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom"
                        Margin="14 0 0 4" />
            </Grid>

            <!-- Condition -->
            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="WHEN" />

              <StackPanel>
                <TextBlock Classes="flabel" Text="CHECK" />
                <ComboBox ItemsSource="{Binding Conditions}"
                          SelectedItem="{Binding SelectedCondition}"
                          HorizontalAlignment="Stretch" FontSize="11">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding SelectedCondition.Description}" FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                           TextWrapping="Wrap" Margin="2 4 0 0" />
              </StackPanel>

              <!-- Schema-derived parameter fields -->
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlarmFieldVm">
                    <StackPanel Margin="0 0 0 8" IsVisible="{Binding !IsStage}">
                      <TextBlock Classes="flabel" Text="{Binding Label}" />

                      <TextBox Text="{Binding Text}" IsVisible="{Binding IsText}"
                               AcceptsReturn="{Binding IsMultiline}"
                               MinHeight="{Binding MinHeight}" />

                      <AutoCompleteBox IsVisible="{Binding IsItem}"
                                       Text="{Binding Text}"
                                       AsyncPopulator="{Binding Populator}"
                                       FilterMode="None"
                                       MinimumPrefixLength="2"
                                       MinimumPopulateDelay="0:0:0.2"
                                       MaxDropDownHeight="260"
                                       FontSize="11"
                                       Watermark="start typing an item name…" />

                      <CheckBox IsChecked="{Binding Flag}" IsVisible="{Binding IsBoolean}"
                                FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />

                      <!-- A list: type-ahead entry, Add, then each entry as a chip with its × -->
                      <StackPanel IsVisible="{Binding IsList}" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                          <AutoCompleteBox Grid.Column="0"
                                           Text="{Binding Text}"
                                           AsyncPopulator="{Binding Populator}"
                                           FilterMode="None"
                                           MinimumPrefixLength="2"
                                           MinimumPopulateDelay="0:0:0.2"
                                           MaxDropDownHeight="260"
                                           FontSize="11"
                                           Watermark="start typing a name, then Add…">
                            <AutoCompleteBox.KeyBindings>
                              <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                            </AutoCompleteBox.KeyBindings>
                          </AutoCompleteBox>
                          <Button Grid.Column="1" Classes="tool" Content="Add" Margin="6 0 0 0"
                                  Command="{Binding AddCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                                   FontSize="9.5" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Margin="0 2 4 2" Padding="7 2 4 2" CornerRadius="3"
                                      Background="{DynamicResource SurfaceRaisedBrush}"
                                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center" />
                                  <Button Content="×" FontSize="12" Padding="3 0" MinHeight="0"
                                          Background="Transparent" BorderThickness="0"
                                          Foreground="{DynamicResource TextDimBrush}"
                                          Command="{Binding $parent[ItemsControl].((vm:AlarmFieldVm)DataContext).RemoveCommand}"
                                          CommandParameter="{Binding}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- A threshold: the box arms the number -->
                      <StackPanel IsVisible="{Binding IsThreshold}" Orientation="Horizontal" Spacing="6">
                        <CheckBox IsChecked="{Binding Flag}" FontSize="11"
                                  Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Text}" Width="100" IsEnabled="{Binding Flag}" />
                        <TextBlock Text="{Binding Suffix}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsEnum}">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Options}" SelectedItem="{Binding Text}"
                                  HorizontalAlignment="Stretch" FontSize="11" />
                        <!-- A choice that carries a number: "Lower than [5,000] units" -->
                        <TextBox Grid.Column="1" Text="{Binding UnitsText}" Width="100" Margin="6 0 0 0"
                                 IsVisible="{Binding HasUnits}" IsEnabled="{Binding UnitsEnabled}" />
                        <TextBlock Grid.Column="2" Text="{Binding Suffix}" FontSize="11" Margin="6 0 0 0"
                                   IsVisible="{Binding HasUnits}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}" />
                      </Grid>

                      <StackPanel IsVisible="{Binding IsDateTime}" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <DatePicker SelectedDate="{Binding Date}" />
                          <TimePicker SelectedTime="{Binding Time}" ClockIdentifier="24HourClock" />
                          <ComboBox ItemsSource="{Binding ZoneOptions}" SelectedItem="{Binding SelectedZone}"
                                    IsVisible="{Binding HasZone}" FontSize="11" MinWidth="110"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding EquivalentText}" FontSize="9.5" Foreground="{DynamicResource TextDimBrush}"
                                   Margin="2 0 0 0" />
                      </StackPanel>

                      <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}"
                                 TextWrapping="Wrap" Margin="2 3 0 0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0" Margin="0 0 5 0" IsVisible="{Binding !IsStaged}">
                  <TextBlock Classes="flabel" Text="AFTER FIRING" />
                  <ComboBox ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding Repeat}"
                            HorizontalAlignment="Stretch" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5 0">
                  <TextBlock Classes="flabel" Text="CHECK EVERY (SEC)" />
                  <TextBox Text="{Binding PollSeconds}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="5 0 0 0" IsVisible="{Binding !IsStaged}">
                  <TextBlock Classes="flabel" Text="COOLDOWN (SEC)" />
                  <TextBox Text="{Binding CooldownSeconds}" />
                </StackPanel>
              </Grid>

              <TextBlock FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                         Text="An alarm only announces things it has not announced before, so a condition that stays true does not repeat. Continuous stays armed until you disable it; One shot disables itself after firing once. Cooldown adds a minimum gap on top." />
            </StackPanel>

            <!-- Actions: one flat list for an ordinary check … -->
            <StackPanel Spacing="8" IsVisible="{Binding !IsStaged}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="section" Text="THEN" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="tool" Content="Add Action"
                        Command="{Binding AddActionCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionTemplate}" />
            </StackPanel>

            <!-- … and, for a staged check, a section per stage: when it fires, and what runs at it. -->
            <ItemsControl ItemsSource="{Binding Stages}" IsVisible="{Binding IsStaged}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AlarmStageVm">
                  <StackPanel Spacing="6" Margin="0 0 0 14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Classes="section" Text="{Binding Title}" VerticalAlignment="Center" Margin="0" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="14 0 0 0"
                                  VerticalAlignment="Center" IsVisible="{Binding HasField}">
                        <CheckBox IsChecked="{Binding Field.Flag}" FontSize="11"
                                  Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="after" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Field.Text}" Width="80" IsEnabled="{Binding Field.Flag}" />
                        <TextBlock Text="{Binding Field.Suffix}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="tool" Content="Add Action"
                              Command="{Binding AddActionCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Field.Description}" IsVisible="{Binding HasField}"
                               FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="2 0 0 2" />
                    <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionTemplate}" />
                    <TextBlock Text="No actions at this stage — add one, or leave the stage unticked."
                               IsVisible="{Binding IsEmpty}"
                               FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" Margin="2 0 0 0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="0" IsVisible="{Binding !HasEditor}"
                   Text="Select an alarm, or create one."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource TextFaintBrush}" />

        <!-- Action bar. Outside the scroll region on purpose: Save must not be something you
             have to scroll to find, and it was being clipped by the history panel below. -->
        <Border Grid.Row="1" IsVisible="{Binding HasEditor}"
                Background="{DynamicResource SurfaceBaseBrush}" Padding="16 8"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="tool" Content="Save" Command="{Binding SaveCommand}" />
            <Button Classes="tool" Content="Test Sounds" Command="{Binding TestFireCommand}" />
            <TextBlock Text="{Binding AudioUnavailableText}"
                       IsVisible="{Binding AudioUnavailable}"
                       Foreground="{DynamicResource WarnBrush}" FontSize="11" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="12 0 0 0" />
            <Button Content="Delete" Command="{Binding DeleteCommand}"
                    Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource BadBrush}" BorderBrush="{DynamicResource BadSurfaceBrush}"
                    BorderThickness="1" Padding="12 4" FontSize="11" />
          </StackPanel>
        </Border>

        <Rectangle Grid.Row="2" Fill="{DynamicResource BorderSubtleBrush}" />

        <!-- History -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBaseBrush}" Padding="12 10" MaxHeight="200">
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="RECENT FIRINGS (EVE TIME)" />
            <ScrollViewer MaxHeight="150">
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlarmEventVm">
                    <Grid ColumnDefinitions="130,180,*" Margin="0 1">
                      <TextBlock Grid.Column="0" Text="{Binding WhenText}" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding AlarmName}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

      </Grid>
    </Grid>
  </Grid>
</UserControl>
