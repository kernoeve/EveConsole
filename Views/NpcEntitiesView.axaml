<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.NpcEntitiesView"
             x:DataType="vm:NpcEntitiesViewModel">
  <TabControl SelectedIndex="{Binding SelectedTabIndex}" Padding="0" Background="Transparent">
    <TabItem Header="Agents">
      <views:EntityTabView DataContext="{Binding Agents}"/>
    </TabItem>
    <TabItem Header="Stations">
      <views:EntityTabView DataContext="{Binding Stations}"/>
    </TabItem>
    <TabItem Header="Corporations">
      <views:EntityTabView DataContext="{Binding Corps}"/>
    </TabItem>
    <TabItem Header="Factions">
      <views:EntityTabView DataContext="{Binding Factions}"/>
    </TabItem>
  </TabControl>
</UserControl>
