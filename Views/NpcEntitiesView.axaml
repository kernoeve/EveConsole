<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.NpcEntitiesView"
             x:DataType="vm:NpcEntitiesViewModel">
  <TabControl SelectedIndex="{Binding SelectedTabIndex}" Padding="0" Background="Transparent">
    <TabItem Header="{x:Static loc:CorpText.TabAgents}">
      <views:EntityTabView DataContext="{Binding Agents}"/>
    </TabItem>
    <TabItem Header="{x:Static loc:CorpText.TabStations}">
      <views:EntityTabView DataContext="{Binding Stations}"/>
    </TabItem>
    <TabItem Header="{x:Static loc:CorpText.TabCorporations}">
      <views:EntityTabView DataContext="{Binding Corps}"/>
    </TabItem>
    <TabItem Header="{x:Static loc:CorpText.TabFactions}">
      <views:EntityTabView DataContext="{Binding Factions}"/>
    </TabItem>
  </TabControl>
</UserControl>
