<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.ExistingShipsWindow"
        x:DataType="vm:ExistingShipsViewModel"
        Title="{x:Static loc:FittingText.TitleExistingShips}"
        Width="1000" Height="620"
        MinWidth="700" MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Window.Styles>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="DataGridCell.num TextBlock">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="14">

    <!-- Narrows the list as typed: ship, hull, system or owner. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
      <TextBox x:Name="Filter" Grid.Column="0" Text="{Binding FilterText}" FontSize="12"
               Watermark="{x:Static loc:FittingText.ShipsFilterWatermark}" />
      <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11" Margin="12 0 0 0"
                 Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="1" CornerRadius="3">
      <Panel>
        <DataGrid x:CompileBindings="False"
                  ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                  CanUserResizeColumns="True" CanUserReorderColumns="False" SelectionMode="Single"
                  Background="Transparent" GridLinesVisibility="None"
                  DoubleTapped="OnGridDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static loc:FittingText.ColShip}"   Binding="{Binding ShipName}"   Width="2*" SortMemberPath="ShipName" />
            <DataGridTextColumn Header="{x:Static loc:FittingText.ColHull}"   Binding="{Binding HullName}"   Width="1.4*" SortMemberPath="HullName" />
            <DataGridTextColumn Header="{x:Static loc:FittingText.ColOwner}"  Binding="{Binding OwnerName}"  Width="1.4*" SortMemberPath="OwnerName" />
            <DataGridTextColumn Header="{x:Static loc:FittingText.ColSystem}" Binding="{Binding SystemName}" Width="*"    SortMemberPath="SystemName" />
            <DataGridTextColumn Header="{x:Static loc:FittingText.ColHullValue}"  Binding="{Binding HullValueText}"  Width="100" SortMemberPath="HullValue"  CellStyleClasses="num" />
            <DataGridTextColumn Header="{x:Static loc:FittingText.ColFitValue}"   Binding="{Binding FitValueText}"   Width="100" SortMemberPath="FitValue"   CellStyleClasses="num" />
            <DataGridTextColumn Header="{x:Static loc:FittingText.ColTotalValue}" Binding="{Binding TotalValueText}" Width="100" SortMemberPath="TotalValue" CellStyleClasses="num" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{x:Static loc:FittingText.ShipsLoading}" IsVisible="{Binding IsLoading}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </Panel>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0 8 0 0"
               Foreground="{DynamicResource TextFaintBrush}" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 10 0 0">
      <Button Content="{x:Static loc:CommonText.Cancel}" Click="OnCancelClick" Padding="14 5" />
      <Button Content="{x:Static loc:FittingText.OpenShip}" Click="OnOpenClick" Padding="14 5"
              IsEnabled="{Binding CanOpen}" IsDefault="True"
              ToolTip.Tip="{x:Static loc:FittingText.TipOpenShip}" />
    </StackPanel>
  </Grid>
</Window>
