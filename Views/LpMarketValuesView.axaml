<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EveConsole.Views.LpMarketValuesView"
             x:DataType="vm:LpMarketValuesViewModel">

  <UserControl.Styles>
    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <TabControl SelectedIndex="{Binding SelectedTabIndex}" Padding="0" Background="Transparent">

    <!-- ── Current Values ──────────────────────────────────────────────────── -->
    <TabItem Header="{x:Static loc:MarketText.TabCurrentValues}">
      <Grid RowDefinitions="Auto,*" Margin="14 12">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0 0 0 8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="{x:Static loc:MarketText.Recalculate}" Click="OnRecalculateClick"
                    IsEnabled="{Binding CanRecalculate}"
                    Padding="10 4" FontSize="11" Margin="10 0 0 0"
                    ToolTip.Tip="{x:Static loc:MarketText.TipRePriceEveryOffer}"/>
          </Grid>
          <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                     Text="{x:Static loc:MarketText.MeanIskPerLoyaltyNote}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="CorpGrid"
                  ItemsSource="{Binding Corps}"
                  IsReadOnly="True" AutoGenerateColumns="False" FontSize="11"
                  Background="Transparent" GridLinesVisibility="None" RowBackground="Transparent"
                  DoubleTapped="OnCorpDoubleTapped">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColCorporation}" Width="240" SortMemberPath="CorporationName" ClipboardContentBinding="{Binding CorporationName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:LpCorpValueVm">
                  <Panel>
                    <Button Classes="link" Click="OnOpenCorporation" IsVisible="{Binding HasCorpLink}"
                            ToolTip.Tip="{x:Static loc:MarketText.TipOpenInNpcEntities}">
                      <TextBlock Text="{Binding CorporationName}" Classes="linktext"
                                 TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Text="{Binding CorporationName}" IsVisible="{Binding !HasCorpLink}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColIskLp}" Width="130" SortMemberPath="IskPerLp" ClipboardContentBinding="{Binding IskPerLpText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:LpCorpValueVm">
                  <TextBlock Text="{Binding IskPerLpText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                             TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"
                             ToolTip.Tip="{x:Static loc:MarketText.TipMeanIskPerLp}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColMedian}" Width="120" SortMemberPath="MedianIskPerLp" ClipboardContentBinding="{Binding MedianText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:LpCorpValueVm">
                  <TextBlock Text="{Binding MedianText}" FontSize="11"
                             Foreground="{Binding MedianColor}"
                             TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"
                             ToolTip.Tip="{x:Static loc:MarketText.TipTheMiddleOfferOver}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColBestOffer}" Width="110" SortMemberPath="BestIskPerLp" ClipboardContentBinding="{Binding BestText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:LpCorpValueVm">
                  <TextBlock Text="{Binding BestText}" FontSize="11" Foreground="{DynamicResource GoodBrush}"
                             TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColBestItem}" Width="*" SortMemberPath="BestOfferName" ClipboardContentBinding="{Binding BestOfferName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:LpCorpValueVm">
                  <Button Content="{Binding BestOfferName}"
                          Command="{Binding $parent[UserControl].((vm:LpMarketValuesViewModel)DataContext).OpenInItemBrowserCommand}"
                          CommandParameter="{Binding BestTypeId}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          FontSize="11" Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                          HorizontalContentAlignment="Left" VerticalAlignment="Center"
                          ToolTip.Tip="{x:Static loc:MarketText.TipOpenInItemBrowser}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColCounted}" Width="90" SortMemberPath="ValuedOffers" ClipboardContentBinding="{Binding CoverageText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:LpCorpValueVm">
                  <TextBlock Text="{Binding CoverageText}" FontSize="11"
                             Foreground="{Binding CoverageColor}"
                             TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"
                             ToolTip.Tip="{x:Static loc:MarketText.TipOffersBehindTheseFigures}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static loc:MarketText.ColYourLp}" Width="110" SortMemberPath="LpHeld" ClipboardContentBinding="{Binding HeldText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:LpCorpValueVm">
                  <TextBlock Text="{Binding HeldText}" FontSize="11" Foreground="{Binding HeldColor}"
                             TextAlignment="Right" Margin="0 0 6 0" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static loc:MarketText.ColHoldingWorth}" Binding="{Binding HoldingValueText}" Width="150"
                                SortMemberPath="HoldingValue"/>
            <!-- Sorted on the timestamp, not the "d MMM HH:mm" text, which would order by day
                 number and put 1 April ahead of 2 March. -->
            <DataGridTextColumn Header="{x:Static loc:MarketText.ColUpdated}"       Binding="{Binding UpdatedText}"      Width="130"
                                SortMemberPath="ComputedAt"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <!-- ── History ─────────────────────────────────────────────────────────── -->
    <TabItem Header="{x:Static loc:MarketText.TabHistory}">
      <Grid RowDefinitions="Auto,Auto,*" Margin="14 12">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0 0 0 8">
          <TextBlock Text="{x:Static loc:MarketText.CorporationLabel}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding HistoryCorps}"
                    SelectedItem="{Binding SelectedHistoryCorp}"
                    MinWidth="240" FontSize="12">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LpCorpValueVm">
                <TextBlock Text="{Binding CorporationName}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{x:Static loc:MarketText.PeriodLabel}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="10 0 0 0"/>
          <ComboBox ItemsSource="{x:Static vm:LpMarketValuesViewModel.Periods}"
                    SelectedItem="{Binding SelectedPeriod}"
                    MinWidth="150" FontSize="12">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LpHistoryPeriod">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding HistoryStatus}" FontSize="11"
                   Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0 0 0 8"/>

        <lvc:CartesianChart Grid.Row="2"
                            Series="{Binding Series}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            TooltipPosition="Top"/>
      </Grid>
    </TabItem>

  </TabControl>
</UserControl>
