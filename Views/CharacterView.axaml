                  <TextBlock Text="Worklist →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <!-- No filters, no summary strip, no refresh button and no blocked/waiting/snoozed
                   toggles: this is a dashboard panel, and the tool is one click away for all of
                   that. It refreshes with the rest of the Overview. -->
              <DataGrid Grid.Row="1" ItemsSource="{Binding WorklistHaul}" Classes="wl"
                        AutoGenerateColumns="False" IsReadOnly="True" RowHeight="19"
                        AreRowDetailsFrozen="False" RowDetailsVisibilityMode="Collapsed"
                        CanUserReorderColumns="False" CanUserResizeColumns="True"
                        CanUserSortColumns="True" Background="Transparent">
                <!-- ⚠️ A resource, not a style. DataGridDetailsPresenter takes its background
                     straight from this brush in the stock template, so a style selector on it never
                     wins. Left at the theme default it paints a grey several steps lighter than the
                     grid across the full width of the expanded row, which reads as a selection
                     highlight rather than an expanded detail. Same fix as the Worklist tool. -->
                <DataGrid.Resources>
                  <SolidColorBrush x:Key="DataGridDetailsPresenterBackgroundBrush" Color="Transparent" />
                </DataGrid.Resources>

                <!-- The task's items, shown on demand — same manifest the tool expands, sized for a
                     dashboard cell. Collapsed by default: the point of the panel is the task list. -->
