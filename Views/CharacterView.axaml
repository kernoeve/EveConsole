<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveCortex.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EveCortex.Views.CharacterView"
             x:DataType="vm:OverviewViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="Button.newslink">
      <Setter Property="Background"      Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding"         Value="0" />
      <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Button.newslink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.newslink:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#12121a" Padding="14 10"
            BorderThickness="0 0 0 1" BorderBrush="#1e1e2a">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Column="0" Text="Period:" FontSize="12"
                   Foreground="#888899" VerticalAlignment="Center"
                   Margin="0 0 8 0" />

        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Periods}"
                  SelectedItem="{Binding SelectedPeriod}"
                  MinWidth="160" FontSize="12"
                  VerticalAlignment="Center" />

        <!-- status / step feedback — shows current step during load, result or error after -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="14 0 0 0">
          <TextBlock Text="{Binding LoadStatus}"
                     IsVisible="{Binding !HasLoadError}"
                     FontSize="11" Foreground="#888899" />
          <TextBlock Text="{Binding LoadStatus}"
                     IsVisible="{Binding HasLoadError}"
                     FontSize="11" Foreground="#e07070" />
        </StackPanel>

        <Button Grid.Column="3" Content="⚙ Customize Layout"
                Click="OnCustomizeClick"
                FontSize="11" Padding="10 4" VerticalAlignment="Center"
                Background="#1a1a28" Foreground="#c8a84b"
                BorderBrush="#2a2a3a" BorderThickness="1" />
      </Grid>
    </Border>

    <!-- ── Dynamic section layout ────────────────────────────────────────────
         Sections live off-stage in SectionStore and are placed into LayoutHost at
         runtime from the saved OverviewLayout (see CharacterView.axaml.cs). -->
    <Grid x:Name="LayoutHost" Grid.Row="1" Margin="8" />

    <Panel x:Name="SectionStore" Grid.Row="1" IsVisible="False">

        <!-- ════ Activity Summary ════════════════════════════════════════ -->
        <Border x:Name="SectionActivitySummary"
                Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">

            <TextBlock Text="Activity Summary" FontSize="13" FontWeight="SemiBold"
                       Foreground="#c8a84b" />

            <!-- Two-column metric grid -->
            <Grid ColumnDefinitions="*,24,*">

              <!-- Left column: period-based metrics -->
              <Border Grid.Column="0" Background="#0d0d12" CornerRadius="3"
                      BorderBrush="#1e1e2a" BorderThickness="1" Padding="10 8">
                <StackPanel Spacing="0">

                  <!-- Header row -->
                  <Grid ColumnDefinitions="*,60,80" Margin="0 0 0 6">
                    <TextBlock Grid.Column="0" Text="In Period" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566" />
                    <TextBlock Grid.Column="1" Text="Count" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="ISK" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566"
                               HorizontalAlignment="Right" />
                  </Grid>

                  <!-- Rows -->
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Market Sales"       FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding MktSellCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding MktSellIsk}"   FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Market Purchases"   FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding MktBuyCount}"  FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding MktBuyIsk}"    FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Completed Jobs"     FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding CompletedJobCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                    FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Player Ship Kills"  FontSize="12" Foreground="#aaaacc"
                               ToolTip.Tip="Requires full kill mail fetch to distinguish kills from losses" />
                    <TextBlock Grid.Column="1" Text="{Binding ShipKillCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                    FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Ships Lost"         FontSize="12" Foreground="#aaaacc"
                               ToolTip.Tip="Requires full kill mail fetch to distinguish kills from losses" />
                    <TextBlock Grid.Column="1" Text="{Binding ShipLossCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                    FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>

                </StackPanel>
              </Border>

              <!-- Right column: current-state metrics -->
              <Border Grid.Column="2" Background="#0d0d12" CornerRadius="3"
                      BorderBrush="#1e1e2a" BorderThickness="1" Padding="10 8">
                <StackPanel Spacing="0">

                  <Grid ColumnDefinitions="*,60,80" Margin="0 0 0 6">
                    <TextBlock Grid.Column="0" Text="Current State" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566" />
                    <TextBlock Grid.Column="1" Text="Count" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Value" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566"
                               HorizontalAlignment="Right" />
                  </Grid>

                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Outstanding Sell Orders" FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding SellOrderCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding SellOrderIsk}"   FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Outstanding Buy Orders"  FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding BuyOrderCount}"  FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding BuyOrderIsk}"    FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Outstanding Contracts"   FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding CtrActiveCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                         FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Active Indy Jobs"        FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding ActiveJobCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                         FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>

                </StackPanel>
              </Border>

            </Grid>

            <!-- Pie charts row -->
            <Grid ColumnDefinitions="*,16,*" Margin="0 8 0 0">

              <!-- Income pie -->
              <Border Grid.Column="0" Background="#0d0d12" CornerRadius="3"
                      BorderBrush="#1e1e2a" BorderThickness="1" Padding="10 8">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Income" FontSize="11" FontWeight="SemiBold"
                               Foreground="#555566" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding IncomeTotalText}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#c8a84b" VerticalAlignment="Center" />
                  </Grid>
                  <lvc:PieChart x:Name="IncomeChart"
                                IsVisible="{Binding HasIncomeData}"
                                Series="{Binding IncomeSeries}"
                                Height="200"
                                LegendPosition="Right"
                                LegendTextSize="10"
                                Background="Transparent" />
                  <TextBlock IsVisible="{Binding !HasIncomeData}"
                             Text="No income data for this period."
                             FontSize="11" Foreground="#444455"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0 60" />
                </StackPanel>
              </Border>

              <!-- Expenses pie -->
              <Border Grid.Column="2" Background="#0d0d12" CornerRadius="3"
                      BorderBrush="#1e1e2a" BorderThickness="1" Padding="10 8">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Expenses" FontSize="11" FontWeight="SemiBold"
                               Foreground="#555566" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ExpenseTotalText}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#c8a84b" VerticalAlignment="Center" />
                  </Grid>
                  <lvc:PieChart x:Name="ExpenseChart"
                                IsVisible="{Binding HasExpenseData}"
                                Series="{Binding ExpenseSeries}"
                                Height="200"
                                LegendPosition="Right"
                                LegendTextSize="10"
                                Background="Transparent" />
                  <TextBlock IsVisible="{Binding !HasExpenseData}"
                             Text="No expense data for this period."
                             FontSize="11" Foreground="#444455"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0 60" />
                </StackPanel>
              </Border>

            </Grid>

          </StackPanel>
          </ScrollViewer>
        </Border>

          <!-- ════ Alerts ═══════════════════════════════════════════════ -->
          <Border x:Name="SectionAlerts" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">

              <TextBlock Grid.Row="0" Text="Alerts" FontSize="13" FontWeight="SemiBold"
                         Foreground="#c8a84b" Margin="0 0 0 8" />

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

              <TextBlock IsVisible="{Binding NoAlerts}"
                         Text="No active alerts."
                         FontSize="12" Foreground="#444455"
                         FontStyle="Italic" />

              <ItemsControl IsVisible="{Binding HasAlerts}"
                            ItemsSource="{Binding Alerts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlertRowVm">
                    <Border Background="#1a1208" BorderBrush="#3a2c10"
                            BorderThickness="1" CornerRadius="3"
                            Padding="8 6" Margin="0 2">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Leading icon: alert-specific (e.g. character portrait) or the default warning glyph -->
                        <Panel Grid.Column="0" Width="32" Height="32"
                               VerticalAlignment="Center" Margin="0 0 8 0">
                          <TextBlock Text="⚠" FontSize="16" Foreground="#c8a84b"
                                     IsVisible="{Binding NoIcon}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Border IsVisible="{Binding HasIcon}"
                                  Width="32" Height="32" CornerRadius="16" ClipToBounds="True">
                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                   Stretch="UniformToFill" />
                          </Border>
                        </Panel>
                        <TextBlock Grid.Column="1" Text="{Binding Message}"
                                   IsVisible="{Binding !IsClickable}"
                                   FontSize="12" Foreground="#ddccaa"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                IsVisible="{Binding IsClickable}"
                                Classes="newslink"
                                Command="{Binding NavigateCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left">
                          <TextBlock Text="{Binding Message}"
                                     FontSize="12" Foreground="#ddccaa"
                                     TextDecorations="Underline"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap" />
                        </Button>
                        <Button Grid.Column="2"
                                IsVisible="{Binding IsDismissible}"
                                Command="{Binding DismissCommand}"
                                Content="Dismiss"
                                FontSize="10" Padding="8 2" Margin="8 0 0 0"
                                Background="#2a1a10" Foreground="#c8a84b"
                                BorderBrush="#3a2c10" BorderThickness="1" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Eve News Feed -->
          <Border x:Name="SectionNews" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">

              <TextBlock Grid.Row="0" Text="Eve Online News" FontSize="13" FontWeight="SemiBold"
                         Foreground="#c8a84b" Margin="0 0 0 8" />

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

              <TextBlock IsVisible="{Binding NoNews}"
                         Text="News unavailable — will retry next refresh."
                         FontSize="12" Foreground="#444455"
                         FontStyle="Italic" />

              <ItemsControl IsVisible="{Binding HasNews}"
                            ItemsSource="{Binding NewsItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NewsItemVm">
                    <Border Background="#0e0e16" BorderBrush="#1e1e2a" BorderThickness="1"
                            CornerRadius="3" Padding="8 6" Margin="0 2">
                      <StackPanel Spacing="4">

                        <!-- Title row: clickable link + date -->
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Grid.Column="0"
                                  Classes="newslink"
                                  Command="{Binding OpenCommand}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="12" Foreground="#5599dd"
                                       TextDecorations="Underline"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding PubDateText}"
                                     FontSize="10" Foreground="#555566"
                                     Margin="12 0 0 0"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <!-- Collapsed preview -->
                        <TextBlock IsVisible="{Binding IsCollapsed}"
                                   Text="{Binding PreviewText}"
                                   FontSize="11" Foreground="#667788"
                                   TextWrapping="Wrap" />

                        <!-- Full body -->
                        <TextBlock IsVisible="{Binding IsExpanded}"
                                   Text="{Binding FullText}"
                                   FontSize="11" Foreground="#8899aa"
                                   TextWrapping="Wrap" />

                        <!-- Expand/collapse toggle -->
                        <Button IsVisible="{Binding CanExpand}"
                                Classes="newslink"
                                Command="{Binding ToggleCommand}"
                                HorizontalAlignment="Left">
                          <TextBlock Text="{Binding ExpandLabel}"
                                     FontSize="10" Foreground="#445566" />
                        </Button>

                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Recent Notifications -->
          <Border x:Name="SectionNotifications" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
          <Grid RowDefinitions="Auto,*">

            <TextBlock Grid.Row="0" Text="Recent Notifications" FontSize="13" FontWeight="SemiBold"
                       Foreground="#c8a84b" Margin="0 0 0 8" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8">

            <TextBlock IsVisible="{Binding NoNotifications}"
                       Text="No recent notifications."
                       FontSize="12" Foreground="#444455" FontStyle="Italic" />

            <ItemsControl IsVisible="{Binding HasNotifications}"
                          ItemsSource="{Binding RecentNotifications}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationBoxVm">
                  <Border Background="#0e0e16" BorderBrush="#1e1e2a" BorderThickness="1"
                          CornerRadius="3" Padding="8 6" Margin="0 2">
                    <ToolTip.Tip>
                      <TextBlock Text="{Binding TooltipText}" FontSize="11" MaxWidth="440"
                                 FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
                    </ToolTip.Tip>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <!-- Icon: portrait / structure-type / logo, or a fallback glyph -->
                      <Panel Grid.Column="0" Width="32" Height="32" Margin="0 0 8 0"
                             VerticalAlignment="Top">
                        <Border IsVisible="{Binding HasIcon}" Width="32" Height="32"
                                CornerRadius="3" ClipToBounds="True">
                          <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock IsVisible="{Binding NoIcon}" Text="{Binding FallbackGlyph}"
                                   FontSize="16" Foreground="#8899aa"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>

                      <!-- One-liner + relative age -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding OneLiner}" FontSize="12" Foreground="#dfe4ee"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AgeText}" FontSize="10" Foreground="#667" />
                      </StackPanel>

                      <!-- Unread marker -->
                      <TextBlock Grid.Column="2" Text="{Binding UnreadDot}" Foreground="#c8a84b"
                                 FontSize="12" VerticalAlignment="Top" Margin="6 0 0 0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

              </StackPanel>
            </ScrollViewer>
          </Grid>
          </Border>

          <!-- ════ Personal Killmails ═══════════════════════════════════ -->
          <Border x:Name="SectionPersonalKillmails" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,Auto,*">

              <TextBlock Grid.Row="0" Text="Personal Killmails" FontSize="13" FontWeight="SemiBold"
                         Foreground="#c8a84b" Margin="0 0 0 8" />

              <!-- Kill / Loss counts + ISK -->
              <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0 0 0 8">
                <Border Grid.Column="0" Background="#0d0d12" CornerRadius="3" BorderBrush="#1e1e2a"
                        BorderThickness="1" Padding="10 6" Margin="0 0 4 0">
                  <StackPanel Spacing="2">
                    <TextBlock Text="KILLS" FontSize="9" Foreground="#888899"
                               FontWeight="SemiBold" LetterSpacing="1" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding PersonalKillCount}" FontSize="16"
                                 Foreground="#70ad47" FontWeight="Bold" />
                      <TextBlock Text="{Binding PersonalKillIsk}" FontSize="12" Foreground="#8899aa"
                                 VerticalAlignment="Bottom" Margin="0 0 0 2" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0d0d12" CornerRadius="3" BorderBrush="#1e1e2a"
                        BorderThickness="1" Padding="10 6" Margin="4 0 0 0">
                  <StackPanel Spacing="2">
                    <TextBlock Text="LOSSES" FontSize="9" Foreground="#888899"
                               FontWeight="SemiBold" LetterSpacing="1" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding PersonalLossCount}" FontSize="16"
                                 Foreground="#cc4444" FontWeight="Bold" />
                      <TextBlock Text="{Binding PersonalLossIsk}" FontSize="12" Foreground="#8899aa"
                                 VerticalAlignment="Bottom" Margin="0 0 0 2" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Empty state -->
              <TextBlock Grid.Row="2" IsVisible="{Binding NoPersonalKills}"
                         Text="No killmails in this period."
                         FontSize="12" Foreground="#444455" FontStyle="Italic"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />

              <!-- Killmail list (zkillboard style, like Corp Activity) -->
              <ListBox Grid.Row="2" IsVisible="{Binding HasPersonalKills}"
                       ItemsSource="{Binding PersonalKills}"
                       Background="Transparent" BorderThickness="0"
                       DoubleTapped="OnKillmailDoubleTapped"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding"    Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#141420" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:Activity24hKillRowVm">
                    <Border BorderBrush="#1a1a26" BorderThickness="0 0 0 1"
                            Background="{Binding RowTint}">
                      <Grid ColumnDefinitions="70,50,*,160,160" Margin="4">

                        <!-- Date / Time / ISK -->
                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Margin="0 0 6 0">
                          <TextBlock Text="{Binding DateText}" FontSize="10" Foreground="#888899" />
                          <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#c8c8d8" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding TotalIskText}" FontSize="10" Foreground="#c8a84b"
                                     IsVisible="{Binding TotalIskText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Ship render -->
                        <Image Grid.Column="1" Source="{Binding ShipRender}" Width="48" Height="48"
                               Stretch="Uniform" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding ShipName}" Margin="0 0 6 0" />

                        <!-- System / Constellation / Region -->
                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" Margin="0 0 6 0">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="{Binding SecurityText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding SecurityColor}" />
                            <TextBlock Text="{Binding SystemName}" FontSize="10" Foreground="#c8c8d8"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Text="{Binding ConstellationName}" FontSize="9" Foreground="#888899"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding ConstellationName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="{Binding RegionName}" FontSize="9" Foreground="#666677"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding RegionName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Victim -->
                        <Grid Grid.Column="3" ColumnDefinitions="32,*" Margin="0 0 4 0">
                          <Image Grid.Column="0" Source="{Binding VictimLogo}" Width="32" Height="32"
                                 Stretch="Uniform" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding VictimAlliance}" Margin="0 0 4 0" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VictimName}" FontSize="10" Foreground="#c8c8d8"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding VictimCorp}" FontSize="9" Foreground="#888899"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding VictimAlliance}" FontSize="9" Foreground="#666677"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding VictimAlliance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </Grid>

                        <!-- Final blow -->
                        <Grid Grid.Column="4" ColumnDefinitions="32,*">
                          <Image Grid.Column="0" Source="{Binding FbLogo}" Width="32" Height="32"
                                 Stretch="Uniform" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding FbAlliance}" Margin="0 0 4 0" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FbName}" FontSize="10" Foreground="#c8c8d8"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FbCorp}" FontSize="9" Foreground="#888899"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FbAlliance}" FontSize="9" Foreground="#666677"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding FbAlliance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </Grid>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </Grid>
          </Border>

    </Panel>

    <!-- ── Status bar ───────────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="#0d0d12" Padding="14 4"
            BorderThickness="0 1 0 0" BorderBrush="#1e1e2a">
      <TextBlock Text="Overview data reflects characters and personal corporations only."
                 FontSize="11" Foreground="#444455" />
    </Border>

  </Grid>
</UserControl>
