                            <TextBlock Text="{Binding RouteText}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RouteText}"/>
                            <TextBlock Text="{Binding Title}" Foreground="#8a8a99" FontSize="9"
                                       VerticalAlignment="Center"/>
                          </StackPanel>

                          <!-- Job: what is being made, where, and by whom. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsJob}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding LocationName}" Foreground="#7a7a88" FontSize="9"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CharacterName}" Foreground="#8a8a99" FontSize="9"
                                       VerticalAlignment="Center"/>
                          </StackPanel>

                          <!-- Buy: what to buy, how much, and where. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBuy}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding LocationName}" Foreground="#7a7a88" FontSize="9"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>

                          <!-- Corp projects, asset safety, skill queues: no shared shape, so the
                               plain title, plus the character where there is one. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOther}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding CharacterName}" Foreground="#8a8a99" FontSize="9"
                                       IsVisible="{Binding HasCharacterLink}" VerticalAlignment="Center"/>
                          </StackPanel>

                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Value"     Binding="{Binding ValueText}"     Width="80"
                                      SortMemberPath="Value" />
                  <DataGridTextColumn Header="Volume"    Binding="{Binding VolumeText}"    Width="90"
                                      SortMemberPath="VolumeRaw" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <!-- Worklist (Jobs) -->
          <Border x:Name="SectionWorklistJobs" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Worklist (Jobs)" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenWorklist" VerticalAlignment="Center">
                  <TextBlock Text="Worklist →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <!-- No filters, no summary strip, no refresh button and no blocked/waiting/snoozed
                   toggles: this is a dashboard panel, and the tool is one click away for all of
                   that. It refreshes with the rest of the Overview. -->
              <DataGrid Grid.Row="1" ItemsSource="{Binding WorklistJobs}" Classes="wl"
                        AutoGenerateColumns="False" IsReadOnly="True" RowHeight="19"
                        AreRowDetailsFrozen="False" RowDetailsVisibilityMode="Collapsed"
                        CanUserReorderColumns="False" CanUserResizeColumns="True"
                        CanUserSortColumns="True" Background="Transparent">
                <!-- ⚠️ A resource, not a style. DataGridDetailsPresenter takes its background
                     straight from this brush in the stock template, so a style selector on it never
                     wins. Left at the theme default it paints a grey several steps lighter than the
                     grid across the full width of the expanded row, which reads as a selection
                     highlight rather than an expanded detail. Same fix as the Worklist tool. -->
                <DataGrid.Resources>
                  <SolidColorBrush x:Key="DataGridDetailsPresenterBackgroundBrush" Color="Transparent" />
                </DataGrid.Resources>

                <!-- The task's items, shown on demand — same manifest the tool expands, sized for a
                     dashboard cell. Collapsed by default: the point of the panel is the task list. -->
                <DataGrid.RowDetailsTemplate>
                  <DataTemplate x:DataType="vm:WorklistRowVm">
                    <Border Margin="30 0 0 6" Padding="8 6"
                            Background="#0f0f16" BorderBrush="#22222e" BorderThickness="1"
                            CornerRadius="3" HorizontalAlignment="Left" MinWidth="220">
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="wl:WorklistLine">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 1">
                              <Panel Grid.Column="0" Margin="0 0 16 0">
                                <Button Classes="link" Click="OnOpenManifestItem"
                                        IsVisible="{Binding HasItemLink}"
                                        ToolTip.Tip="Open in the Item Browser">
                                  <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                             FontSize="10" Foreground="#c8c8d8"/>
                                </Button>
                                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                           FontSize="10" Foreground="#c8c8d8" VerticalAlignment="Center"/>
                              </Panel>
                              <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N0}}"
                                         FontSize="10" Foreground="#8a8a99"
                                         MinWidth="48" TextAlignment="Right"/>
                              <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                         FontSize="10" Foreground="#6e6e80"
                                         MinWidth="62" TextAlignment="Right" Margin="10 0 0 0"/>
                              <TextBlock Grid.Column="3" Text="{Binding VolumeText}"
                                         FontSize="10" Foreground="#6e6e80"
                                         MinWidth="62" TextAlignment="Right" Margin="10 0 0 0"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
