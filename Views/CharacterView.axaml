<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="clr-namespace:EveConsole.Views"
             xmlns:collections="clr-namespace:Avalonia.Collections;assembly=Avalonia.Controls.DataGrid"
             xmlns:wl="clr-namespace:EveConsole.Services.Worklist"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EveConsole.Views.CharacterView"
             x:DataType="vm:OverviewViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="Button.newslink">
      <Setter Property="Background"      Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding"         Value="0" />
      <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Button.newslink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.newslink:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour it already
         had, and the cursor plus the hover underline carry the affordance — the same rule the
         Killmail tool, the system page and Corp Activity follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- The worklist dashboard sections. A smaller row than the tool's own grids: these panels
         are read at a glance and share a cell with five others, so fitting more rows matters more
         than comfortable spacing. -->
    <Style Selector="DataGrid.wl DataGridCell TextBlock">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="DataGrid.wl DataGridCell">
      <Setter Property="Padding" Value="4 0" />
    </Style>
    <Style Selector="DataGrid.wl DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" />
      <Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize"   Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="4 4 2 4" />
    </Style>

    <!-- ⚠️ Group headers, mirroring the tool's own so a section reads the same as the grid it came
         from — including the per-group totals, which are most of why the grouping is worth having.
         Scoped to DataGrid.wl so none of this reaches the tools themselves.

         Sized at about three quarters of the tool's: these panels share the window with five
         others, and the tool's 34px header and 16px key eat a dashboard cell. -->
    <Style Selector="DataGrid.wl DataGridRowGroupHeader">
      <Setter Property="Background" Value="#12121a"/>
      <Setter Property="Foreground" Value="#c8a84b"/>
      <Setter Property="MinHeight"  Value="28"/>
      <Setter Property="Template">
        <ControlTemplate x:DataType="collections:DataGridCollectionViewGroup">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="#1e1e2a" BorderThickness="0 1 0 1">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="5 0"
                        VerticalAlignment="Center">
              <!-- DynamicResource: the theme lives in the DataGrid's own dictionary, merged through
                   Application.Styles, which a parse-time StaticResource lookup cannot see. -->
              <ToggleButton Name="PART_ExpanderButton" Width="10" Height="10"
                            Theme="{DynamicResource FluentDataGridRowGroupExpanderButtonTheme}"
                            Background="Transparent" BorderThickness="0"/>
              <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="SemiBold"
                         Foreground="#c8a84b" VerticalAlignment="Center"/>
              <TextBlock FontSize="11" Foreground="#8a8a99" VerticalAlignment="Center"
                         Text="{Binding Items, Converter={x:Static views:GroupTotalConverter.Instance},
                                         ConverterParameter=Count}"/>
              <TextBlock FontSize="11" Foreground="#7a7a88" VerticalAlignment="Center"
                         Text="{Binding Items, Converter={x:Static views:GroupTotalConverter.Instance},
                                         ConverterParameter=Volume}"/>
              <TextBlock FontSize="11" Foreground="#7a7a88" VerticalAlignment="Center"
                         Text="{Binding Items, Converter={x:Static views:GroupTotalConverter.Instance},
                                         ConverterParameter=Value}"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Station Needs: the same header without the volume and value totals, which the needs rows
         do not carry in the same sense. -->
    <Style Selector="DataGrid.wlneeds DataGridRowGroupHeader">
      <Setter Property="MinHeight" Value="23"/>
      <Setter Property="Template">
        <ControlTemplate x:DataType="collections:DataGridCollectionViewGroup">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="#1e1e2a" BorderThickness="0 1 0 1">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="5 0"
                        VerticalAlignment="Center">
              <ToggleButton Name="PART_ExpanderButton" Width="10" Height="10"
                            Theme="{DynamicResource FluentDataGridRowGroupExpanderButtonTheme}"
                            Background="Transparent" BorderThickness="0"/>
              <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="SemiBold"
                         Foreground="#c8a84b" VerticalAlignment="Center"/>
              <TextBlock FontSize="10" Foreground="#8a8a99" VerticalAlignment="Center"
                         Text="{Binding Items, Converter={x:Static views:GroupTotalConverter.Instance},
                                         ConverterParameter=Count}"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- The manifest expander. A glyph, not a button: the default chrome draws a filled box on
         hover and press, which reads as a selected cell sitting in the row. -->
    <Style Selector="Button.expander /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.expander:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="TextElement.Foreground" Value="#c8a84b"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#12121a" Padding="14 10"
            BorderThickness="0 0 0 1" BorderBrush="#1e1e2a">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Column="0" Text="Period:" FontSize="12"
                   Foreground="#888899" VerticalAlignment="Center"
                   Margin="0 0 8 0" />

        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Periods}"
                  SelectedItem="{Binding SelectedPeriod}"
                  MinWidth="160" FontSize="12"
                  VerticalAlignment="Center" />

        <!-- status / step feedback — shows current step during load, result or error after -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="14 0 0 0">
          <TextBlock Text="{Binding LoadStatus}"
                     IsVisible="{Binding !HasLoadError}"
                     FontSize="11" Foreground="#888899" />
          <TextBlock Text="{Binding LoadStatus}"
                     IsVisible="{Binding HasLoadError}"
                     FontSize="11" Foreground="#e07070" />
        </StackPanel>

        <Button Grid.Column="3" Content="⚙ Customize Layout"
                Click="OnCustomizeClick"
                FontSize="11" Padding="10 4" VerticalAlignment="Center"
                Background="#1a1a28" Foreground="#c8a84b"
                BorderBrush="#2a2a3a" BorderThickness="1" />
      </Grid>
    </Border>

    <!-- ── Dynamic section layout ────────────────────────────────────────────
         Sections live off-stage in SectionStore and are placed into LayoutHost at
         runtime from the saved OverviewLayout (see CharacterView.axaml.cs). -->
    <Grid x:Name="LayoutHost" Grid.Row="1" Margin="8" />

    <Panel x:Name="SectionStore" Grid.Row="1" IsVisible="False">

        <!-- ════ Activity Summary ════════════════════════════════════════ -->
        <Border x:Name="SectionActivitySummary"
                Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                CornerRadius="4" Padding="14 12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">

            <TextBlock Text="Activity Summary" FontSize="13" FontWeight="SemiBold"
                       Foreground="#c8a84b" />

            <!-- Two-column metric grid -->
            <Grid ColumnDefinitions="*,24,*">

              <!-- Left column: period-based metrics -->
              <Border Grid.Column="0" Background="#0d0d12" CornerRadius="3"
                      BorderBrush="#1e1e2a" BorderThickness="1" Padding="10 8">
                <StackPanel Spacing="0">

                  <!-- Header row -->
                  <Grid ColumnDefinitions="*,60,80" Margin="0 0 0 6">
                    <TextBlock Grid.Column="0" Text="In Period" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566" />
                    <TextBlock Grid.Column="1" Text="Count" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="ISK" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566"
                               HorizontalAlignment="Right" />
                  </Grid>

                  <!-- Rows -->
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Market Sales"       FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding MktSellCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding MktSellIsk}"   FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Market Purchases"   FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding MktBuyCount}"  FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding MktBuyIsk}"    FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Completed Jobs"     FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding CompletedJobCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                    FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Player Ship Kills"  FontSize="12" Foreground="#aaaacc"
                               ToolTip.Tip="Requires full kill mail fetch to distinguish kills from losses" />
                    <TextBlock Grid.Column="1" Text="{Binding ShipKillCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                    FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Ships Lost"         FontSize="12" Foreground="#aaaacc"
                               ToolTip.Tip="Requires full kill mail fetch to distinguish kills from losses" />
                    <TextBlock Grid.Column="1" Text="{Binding ShipLossCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                    FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>

                </StackPanel>
              </Border>

              <!-- Right column: current-state metrics -->
              <Border Grid.Column="2" Background="#0d0d12" CornerRadius="3"
                      BorderBrush="#1e1e2a" BorderThickness="1" Padding="10 8">
                <StackPanel Spacing="0">

                  <Grid ColumnDefinitions="*,60,80" Margin="0 0 0 6">
                    <TextBlock Grid.Column="0" Text="Current State" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566" />
                    <TextBlock Grid.Column="1" Text="Count" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Value" FontSize="11"
                               FontWeight="SemiBold" Foreground="#555566"
                               HorizontalAlignment="Right" />
                  </Grid>

                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Outstanding Sell Orders" FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding SellOrderCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding SellOrderIsk}"   FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Outstanding Buy Orders"  FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding BuyOrderCount}"  FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding BuyOrderIsk}"    FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Outstanding Contracts"   FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding CtrActiveCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                         FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="*,60,80" Margin="0 3">
                    <TextBlock Grid.Column="0" Text="Active Indy Jobs"        FontSize="12" Foreground="#aaaacc" />
                    <TextBlock Grid.Column="1" Text="{Binding ActiveJobCount}" FontSize="12" Foreground="#c8a84b" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text=""                         FontSize="12" Foreground="#aaaacc" HorizontalAlignment="Right" />
                  </Grid>

                </StackPanel>
              </Border>

            </Grid>

          </StackPanel>
          </ScrollViewer>
        </Border>

          <!-- ════ Alerts ═══════════════════════════════════════════════ -->
          <Border x:Name="SectionAlerts" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Alerts" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenAlertSettings" VerticalAlignment="Center">
                  <TextBlock Text="Alert Settings →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

              <TextBlock IsVisible="{Binding NoAlerts}"
                         Text="No active alerts."
                         FontSize="12" Foreground="#444455"
                         FontStyle="Italic" />

              <ItemsControl IsVisible="{Binding HasAlerts}"
                            ItemsSource="{Binding Alerts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlertRowVm">
                    <Border Background="#1a1208" BorderBrush="#3a2c10"
                            BorderThickness="1" CornerRadius="3"
                            Padding="8 6" Margin="0 2">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Leading icon: alert-specific (e.g. character portrait) or the default warning glyph -->
                        <Panel Grid.Column="0" Width="32" Height="32"
                               VerticalAlignment="Center" Margin="0 0 8 0">
                          <TextBlock Text="⚠" FontSize="16" Foreground="#c8a84b"
                                     IsVisible="{Binding NoIcon}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Border IsVisible="{Binding HasIcon}"
                                  Width="32" Height="32" CornerRadius="16" ClipToBounds="True">
                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                   Stretch="UniformToFill" />
                          </Border>
                        </Panel>
                        <TextBlock Grid.Column="1" Text="{Binding Message}"
                                   IsVisible="{Binding !IsClickable}"
                                   FontSize="12" Foreground="#ddccaa"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                IsVisible="{Binding IsClickable}"
                                Classes="newslink"
                                Command="{Binding NavigateCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left">
                          <TextBlock Text="{Binding Message}"
                                     FontSize="12" Foreground="#ddccaa"
                                     TextDecorations="Underline"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap" />
                        </Button>
                        <Button Grid.Column="2"
                                IsVisible="{Binding IsDismissible}"
                                Command="{Binding DismissCommand}"
                                Content="Dismiss"
                                FontSize="10" Padding="8 2" Margin="8 0 0 0"
                                Background="#2a1a10" Foreground="#c8a84b"
                                BorderBrush="#3a2c10" BorderThickness="1" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Eve News Feed -->
          <Border x:Name="SectionNews" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">

              <TextBlock Grid.Row="0" Text="Eve Online News" FontSize="13" FontWeight="SemiBold"
                         Foreground="#c8a84b" Margin="0 0 0 8" />

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

              <TextBlock IsVisible="{Binding NoNews}"
                         Text="News unavailable — will retry next refresh."
                         FontSize="12" Foreground="#444455"
                         FontStyle="Italic" />

              <ItemsControl IsVisible="{Binding HasNews}"
                            ItemsSource="{Binding NewsItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NewsItemVm">
                    <Border Background="#0e0e16" BorderBrush="#1e1e2a" BorderThickness="1"
                            CornerRadius="3" Padding="8 6" Margin="0 2">
                      <StackPanel Spacing="4">

                        <!-- Title row: clickable link + date -->
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Grid.Column="0"
                                  Classes="newslink"
                                  Command="{Binding OpenCommand}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="12" Foreground="#5599dd"
                                       TextDecorations="Underline"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding PubDateText}"
                                     FontSize="10" Foreground="#555566"
                                     Margin="12 0 0 0"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <!-- Collapsed preview -->
                        <TextBlock IsVisible="{Binding IsCollapsed}"
                                   Text="{Binding PreviewText}"
                                   FontSize="11" Foreground="#667788"
                                   TextWrapping="Wrap" />

                        <!-- Full body -->
                        <TextBlock IsVisible="{Binding IsExpanded}"
                                   Text="{Binding FullText}"
                                   FontSize="11" Foreground="#8899aa"
                                   TextWrapping="Wrap" />

                        <!-- Expand/collapse toggle -->
                        <Button IsVisible="{Binding CanExpand}"
                                Classes="newslink"
                                Command="{Binding ToggleCommand}"
                                HorizontalAlignment="Left">
                          <TextBlock Text="{Binding ExpandLabel}"
                                     FontSize="10" Foreground="#445566" />
                        </Button>

                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Recent Notifications -->
          <Border x:Name="SectionNotifications" Background="#12121a" BorderBrush="#1e1e2a" BorderThickness="1"
                  CornerRadius="4" Padding="14 12">
          <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
              <TextBlock Text="Notifications" FontSize="13" FontWeight="SemiBold"
                         Foreground="#c8a84b" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="newslink" Click="OnOpenNotifications" VerticalAlignment="Center">
                <TextBlock Text="Notifications →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
              </Button>
            </Grid>

            <Grid Grid.Row="1">

            <TextBlock IsVisible="{Binding NoNotifications}"
                       Text="No recent notifications."
                       FontSize="12" Foreground="#444455" FontStyle="Italic"
                       VerticalAlignment="Top" />

            <!-- ListBox virtualizes by default (VirtualizingStackPanel), so a long period stays
                 cheap; styled to read like a plain list with no selection chrome. -->
            <ListBox IsVisible="{Binding HasNotifications}"
                     ItemsSource="{Binding RecentNotifications}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationBoxVm">
                  <Border Background="#0e0e16" BorderBrush="#1e1e2a" BorderThickness="1"
                          CornerRadius="3" Padding="8 6" Margin="0 0 0 6">
                    <ToolTip.Tip>
                      <TextBlock Text="{Binding TooltipText}" FontSize="11" MaxWidth="440"
                                 FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
                    </ToolTip.Tip>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <!-- Icon: portrait / structure-type / logo, or a fallback glyph -->
                      <Panel Grid.Column="0" Width="32" Height="32" Margin="0 0 8 0"
                             VerticalAlignment="Top">
                        <Border IsVisible="{Binding HasIcon}" Width="32" Height="32"
                                CornerRadius="3" ClipToBounds="True">
                          <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock IsVisible="{Binding NoIcon}" Text="{Binding FallbackGlyph}"
                                   FontSize="16" Foreground="#8899aa"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>

                      <!-- One-liner + relative age -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding OneLiner}" FontSize="12" Foreground="#dfe4ee"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AgeText}" FontSize="10" Foreground="#667" />
                      </StackPanel>

                      <!-- Unread marker -->
                      <TextBlock Grid.Column="2" Text="{Binding UnreadDot}" Foreground="#c8a84b"
                                 FontSize="12" VerticalAlignment="Top" Margin="6 0 0 0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            </Grid>
          </Grid>
          </Border>

          <!-- ════ Personal Killmails ═══════════════════════════════════ -->
          <Border x:Name="SectionPersonalKillmails" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,Auto,*">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Personal Killmails" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenKillmailsTool" VerticalAlignment="Center">
                  <TextBlock Text="Killmails →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <!-- Kill / Loss counts + ISK -->
              <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0 0 0 8">
                <Border Grid.Column="0" Background="#0d0d12" CornerRadius="3" BorderBrush="#1e1e2a"
                        BorderThickness="1" Padding="10 6" Margin="0 0 4 0">
                  <StackPanel Spacing="2">
                    <TextBlock Text="KILLS" FontSize="9" Foreground="#888899"
                               FontWeight="SemiBold" LetterSpacing="1" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding PersonalKillCount}" FontSize="16"
                                 Foreground="#70ad47" FontWeight="Bold" />
                      <TextBlock Text="{Binding PersonalKillIsk}" FontSize="12" Foreground="#8899aa"
                                 VerticalAlignment="Bottom" Margin="0 0 0 2" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0d0d12" CornerRadius="3" BorderBrush="#1e1e2a"
                        BorderThickness="1" Padding="10 6" Margin="4 0 0 0">
                  <StackPanel Spacing="2">
                    <TextBlock Text="LOSSES" FontSize="9" Foreground="#888899"
                               FontWeight="SemiBold" LetterSpacing="1" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding PersonalLossCount}" FontSize="16"
                                 Foreground="#cc4444" FontWeight="Bold" />
                      <TextBlock Text="{Binding PersonalLossIsk}" FontSize="12" Foreground="#8899aa"
                                 VerticalAlignment="Bottom" Margin="0 0 0 2" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Empty state -->
              <TextBlock Grid.Row="2" IsVisible="{Binding NoPersonalKills}"
                         Text="No killmails in this period."
                         FontSize="12" Foreground="#444455" FontStyle="Italic"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />

              <!-- Killmail list (zkillboard style, like Corp Activity) -->
              <ListBox Grid.Row="2" IsVisible="{Binding HasPersonalKills}"
                       ItemsSource="{Binding PersonalKills}"
                       Background="Transparent" BorderThickness="0"
                       DoubleTapped="OnKillmailDoubleTapped"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding"    Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#141420" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:Activity24hKillRowVm">
                    <Border BorderBrush="#1a1a26" BorderThickness="0 0 0 1"
                            Background="{Binding RowTint}">
                      <Grid ColumnDefinitions="70,50,*,160,160" Margin="4">

                        <!-- Date / Time / ISK -->
                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Margin="0 0 6 0">
                          <TextBlock Text="{Binding DateText}" FontSize="10" Foreground="#888899" />
                          <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#c8c8d8" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding TotalIskText}" FontSize="10" Foreground="#c8a84b"
                                     IsVisible="{Binding TotalIskText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Ship render -->
                        <Image Grid.Column="1" Source="{Binding ShipRender}" Width="48" Height="48"
                               Stretch="Uniform" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding ShipName}" Margin="0 0 6 0" />

                        <!-- System / Constellation / Region -->
                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" Margin="0 0 6 0">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="{Binding SecurityText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding SecurityColor}" />
                            <Panel>
                            <Button Classes="link" Click="OnOpenKillSystem" IsVisible="{Binding HasSystemLink}">
                              <TextBlock Text="{Binding SystemName}" Classes="linktext" FontSize="10" Foreground="#c8c8d8"
                                         FontWeight="SemiBold"  TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding SystemName}" IsVisible="{Binding ShowSystemPlain}" FontSize="10" Foreground="#c8c8d8"
                                       FontWeight="SemiBold"  TextTrimming="CharacterEllipsis" />
                          </Panel>
                          </StackPanel>
                          <TextBlock Text="{Binding ConstellationName}" FontSize="9" Foreground="#888899"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding ConstellationName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <Panel>
                            <Button Classes="link" Click="OnOpenKillRegion" IsVisible="{Binding HasRegionLink}">
                              <TextBlock Text="{Binding RegionName}" Classes="linktext" FontSize="9" Foreground="#666677"
                                          TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding RegionName}" IsVisible="{Binding ShowRegionPlain}" FontSize="9" Foreground="#666677"
                                        TextTrimming="CharacterEllipsis" />
                          </Panel>
                        </StackPanel>

                        <!-- Victim -->
                        <Grid Grid.Column="3" ColumnDefinitions="32,*" Margin="0 0 4 0">
                          <Image Grid.Column="0" Source="{Binding VictimLogo}" Width="32" Height="32"
                                 Stretch="Uniform" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding VictimAlliance}" Margin="0 0 4 0" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <Panel>
                            <Button Classes="link" Click="OnOpenKillVictim" IsVisible="{Binding HasVictimLink}">
                              <TextBlock Text="{Binding VictimName}" Classes="linktext" FontSize="10" Foreground="#c8c8d8"
                                         FontWeight="SemiBold"  TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding VictimName}" IsVisible="{Binding ShowVictimPlain}" FontSize="10" Foreground="#c8c8d8"
                                       FontWeight="SemiBold"  TextTrimming="CharacterEllipsis" />
                          </Panel>
                            <Panel>
                            <Button Classes="link" Click="OnOpenKillVictimCorp" IsVisible="{Binding HasVictimCorpLink}">
                              <TextBlock Text="{Binding VictimCorp}" Classes="linktext" FontSize="9" Foreground="#888899"
                                          TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding VictimCorp}" IsVisible="{Binding ShowVictimCorpPlain}" FontSize="9" Foreground="#888899"
                                        TextTrimming="CharacterEllipsis" />
                          </Panel>
                            <Panel>
                            <Button Classes="link" Click="OnOpenKillVictimAlliance" IsVisible="{Binding HasVictimAllianceLink}">
                              <TextBlock Text="{Binding VictimAlliance}" Classes="linktext" FontSize="9" Foreground="#666677"
                                          TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding VictimAlliance}" IsVisible="{Binding ShowVictimAlliancePlain}" FontSize="9" Foreground="#666677"
                                        TextTrimming="CharacterEllipsis" />
                          </Panel>
                          </StackPanel>
                        </Grid>

                        <!-- Final blow -->
                        <Grid Grid.Column="4" ColumnDefinitions="32,*">
                          <Image Grid.Column="0" Source="{Binding FbLogo}" Width="32" Height="32"
                                 Stretch="Uniform" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding FbAlliance}" Margin="0 0 4 0" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <Panel>
                            <Button Classes="link" Click="OnOpenKillFb" IsVisible="{Binding HasFbLink}">
                              <TextBlock Text="{Binding FbName}" Classes="linktext" FontSize="10" Foreground="#c8c8d8"
                                         FontWeight="SemiBold"  TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding FbName}" IsVisible="{Binding ShowFbPlain}" FontSize="10" Foreground="#c8c8d8"
                                       FontWeight="SemiBold"  TextTrimming="CharacterEllipsis" />
                          </Panel>
                            <Panel>
                            <Button Classes="link" Click="OnOpenKillFbCorp" IsVisible="{Binding HasFbCorpLink}">
                              <TextBlock Text="{Binding FbCorp}" Classes="linktext" FontSize="9" Foreground="#888899"
                                          TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding FbCorp}" IsVisible="{Binding ShowFbCorpPlain}" FontSize="9" Foreground="#888899"
                                        TextTrimming="CharacterEllipsis" />
                          </Panel>
                            <Panel>
                            <Button Classes="link" Click="OnOpenKillFbAlliance" IsVisible="{Binding HasFbAllianceLink}">
                              <TextBlock Text="{Binding FbAlliance}" Classes="linktext" FontSize="9" Foreground="#666677"
                                          TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Text="{Binding FbAlliance}" IsVisible="{Binding ShowFbAlliancePlain}" FontSize="9" Foreground="#666677"
                                        TextTrimming="CharacterEllipsis" />
                          </Panel>
                          </StackPanel>
                        </Grid>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </Grid>
          </Border>

          <!-- ════ Sale Listing (Build) ═════════════════════════════════ -->
          <Border x:Name="SectionSaleListingBuild" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <views:SaleListingView DataContext="{Binding SaleListingBuild}" />
          </Border>

          <!-- ════ Sale Listing (Market) ════════════════════════════════ -->
          <Border x:Name="SectionSaleListingMarket" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <views:SaleListingView DataContext="{Binding SaleListingMarket}" />
          </Border>

          <!-- ════ Income (Pie) ═════════════════════════════════════════ -->
          <Border x:Name="SectionIncomePie" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Income" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding IncomeTotalText}" FontSize="12"
                           FontWeight="SemiBold" Foreground="#c8a84b" VerticalAlignment="Center" />
              </Grid>
              <lvc:PieChart Grid.Row="1" x:Name="IncomeChart"
                            IsVisible="{Binding HasIncomeData}"
                            Series="{Binding IncomeSeries}"
                            LegendPosition="Right" LegendTextSize="10"
                            Background="Transparent" />
              <TextBlock Grid.Row="1" IsVisible="{Binding !HasIncomeData}"
                         Text="No income data for this period."
                         FontSize="12" Foreground="#444455"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- ════ Expenses (Pie) ═══════════════════════════════════════ -->
          <Border x:Name="SectionExpensePie" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Expenses" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ExpenseTotalText}" FontSize="12"
                           FontWeight="SemiBold" Foreground="#c8a84b" VerticalAlignment="Center" />
              </Grid>
              <lvc:PieChart Grid.Row="1" x:Name="ExpenseChart"
                            IsVisible="{Binding HasExpenseData}"
                            Series="{Binding ExpenseSeries}"
                            LegendPosition="Right" LegendTextSize="10"
                            Background="Transparent" />
              <TextBlock Grid.Row="1" IsVisible="{Binding !HasExpenseData}"
                         Text="No expense data for this period."
                         FontSize="12" Foreground="#444455"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- ════ Income & Expense ═════════════════════════════════════ -->
          <Border x:Name="SectionIncomeExpense" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <views:IncomeExpenseView DataContext="{Binding IncomeExpense}" />
          </Border>

          <!-- ════ Standing Buy Orders ══════════════════════════════════ -->
          <!-- ———— Orders ———————————————————————————— -->
          <Border x:Name="SectionOrders" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Orders" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenOrderTracker" VerticalAlignment="Center">
                  <TextBlock Text="Order Tracker →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <TextBlock Grid.Row="1" IsVisible="{Binding NoOrders}"
                         Text="No active orders." FontSize="12" Foreground="#444455" FontStyle="Italic"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />

              <DataGrid Grid.Row="1" IsVisible="{Binding HasOrders}"
                        ItemsSource="{Binding Orders}"
                        AutoGenerateColumns="False" IsReadOnly="True" RowHeight="22"
                        CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                        Background="Transparent">
                <DataGrid.Styles>
                  <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                    <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="6 5 2 5" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Created on" Binding="{Binding Created}"
                                      SortMemberPath="CreatedSort" Width="90" />
                  <DataGridTextColumn Header="Item"       Binding="{Binding Item}"    Width="*" />
                  <!-- Sorted on the number, shown with separators: 9 sorts below 50, which it
                       would not if the column sorted the text it displays. -->
                  <DataGridTextColumn Header="Units"      Binding="{Binding UnitsText}"
                                      SortMemberPath="Units" Width="70" CellStyleClasses="num" />
                  <DataGridTextColumn Header="Buyer"      Binding="{Binding Buyer}"   Width="140" />
                  <!-- ⚠️ Sorts on EstSortKey, not on the text. An empty date sorts as earliest,
                       which put the orders nobody has answered at the top of a list ordered by
                       what is due soonest. -->
                  <DataGridTextColumn Header="Est date"   Binding="{Binding EstDate}"
                                      SortMemberPath="EstSortKey" Width="85" />
                  <!-- The column that moves while an order is open. Status is beside it because
                       it was asked for and stays correct if this ever shows more than active
                       orders, but here it reads "Pending" on every row by construction. -->
                  <DataGridTextColumn Header="Source"     Binding="{Binding Source}"  Width="95" />
                  <DataGridTextColumn Header="Status"     Binding="{Binding Status}"  Width="80" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <Border x:Name="SectionStandingBuyOrders" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Standing Buy Orders" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenStandingBuyOrders" VerticalAlignment="Center">
                  <TextBlock Text="Standing Buy Orders →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <TextBlock Grid.Row="1" IsVisible="{Binding NoStandingBuyOrders}"
                         Text="No standing buy orders." FontSize="12" Foreground="#444455" FontStyle="Italic"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />

              <DataGrid Grid.Row="1" IsVisible="{Binding HasStandingBuyOrders}"
                        ItemsSource="{Binding StandingBuyOrders}"
                        AutoGenerateColumns="False" IsReadOnly="True" RowHeight="22"
                        CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                        Background="Transparent">
                <DataGrid.Styles>
                  <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                    <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="6 5 2 5" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Item" SortMemberPath="TypeName" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
                        <Panel>
                          <Button Classes="link" Click="OnOpenBuyOrderItem"
                                  IsVisible="{Binding HasItemLink}"
                                  ToolTip.Tip="Open in the Item Browser">
                            <TextBlock Text="{Binding TypeName}" Classes="linktext" FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                     FontSize="11" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Status" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Padding="6 0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Our bid" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
                        <TextBlock Text="{Binding Price}" Foreground="{Binding PriceColor}"
                                   FontSize="11" VerticalAlignment="Center" Padding="6 0"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PriceTooltip}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Rem." Binding="{Binding RemainingPct}" Width="70" />
                  <DataGridTemplateColumn Header="Expires" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StandingBuyOrderRowVm">
                        <TextBlock Text="{Binding Expiry}" Foreground="{Binding ExpiryColor}"
                                   FontSize="11" VerticalAlignment="Center" Padding="6 0"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <!-- Worklist (All) -->
          <Border x:Name="SectionWorklistAll" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Worklist (All)" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenWorklist" VerticalAlignment="Center">
                  <TextBlock Text="Worklist →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <!-- No filters, no summary strip, no refresh button and no blocked/waiting/snoozed
                   toggles: this is a dashboard panel, and the tool is one click away for all of
                   that. It refreshes with the rest of the Overview. -->
              <DataGrid Grid.Row="1" ItemsSource="{Binding WorklistAllView}" Classes="wl"
                        AutoGenerateColumns="False" IsReadOnly="True" RowHeight="19"
                        AreRowDetailsFrozen="False" RowDetailsVisibilityMode="Collapsed"
                        CanUserReorderColumns="False" CanUserResizeColumns="True"
                        CanUserSortColumns="True" Background="Transparent">
                <!-- ⚠️ A resource, not a style. DataGridDetailsPresenter takes its background
                     straight from this brush in the stock template, so a style selector on it never
                     wins. Left at the theme default it paints a grey several steps lighter than the
                     grid across the full width of the expanded row, which reads as a selection
                     highlight rather than an expanded detail. Same fix as the Worklist tool. -->
                <DataGrid.Resources>
                  <SolidColorBrush x:Key="DataGridDetailsPresenterBackgroundBrush" Color="Transparent" />
                </DataGrid.Resources>

                <!-- The task's items, shown on demand — same manifest the tool expands, sized for a
                     dashboard cell. Collapsed by default: the point of the panel is the task list. -->
                <DataGrid.RowDetailsTemplate>
                  <DataTemplate x:DataType="vm:WorklistRowVm">
                    <Border Margin="30 0 0 6" Padding="8 6"
                            Background="#0f0f16" BorderBrush="#22222e" BorderThickness="1"
                            CornerRadius="3" HorizontalAlignment="Left" MinWidth="220">
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="wl:WorklistLine">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 1">
                              <Panel Grid.Column="0" Margin="0 0 16 0">
                                <Button Classes="link" Click="OnOpenManifestItem"
                                        IsVisible="{Binding HasItemLink}"
                                        ToolTip.Tip="Open in the Item Browser">
                                  <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                             FontSize="10" Foreground="#c8c8d8"/>
                                </Button>
                                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                           FontSize="10" Foreground="#c8c8d8" VerticalAlignment="Center"/>
                              </Panel>
                              <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N0}}"
                                         FontSize="10" Foreground="#8a8a99"
                                         MinWidth="48" TextAlignment="Right"/>
                              <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                         FontSize="10" Foreground="#6e6e80"
                                         MinWidth="62" TextAlignment="Right" Margin="10 0 0 0"/>
                              <TextBlock Grid.Column="3" Text="{Binding VolumeText}"
                                         FontSize="10" Foreground="#6e6e80"
                                         MinWidth="62" TextAlignment="Right" Margin="10 0 0 0"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
                </DataGrid.RowDetailsTemplate>

                <DataGrid.Columns>
                  <!-- Only drawn where there is a manifest, so an empty cell reads as "nothing to
                       expand" rather than a broken button. -->
                  <DataGridTemplateColumn Header="" Width="18" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:WorklistRowVm">
                        <Button Classes="expander" Click="OnOverviewManifestToggle"
                                IsVisible="{Binding HasLines}"
                                Content="{Binding ExpandGlyph}" FontSize="11" FontWeight="Bold"
                                Padding="0" Width="14" Height="14" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0" Foreground="#7a8896"
                                Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Show the items on this task"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- One column carrying whatever the row's kind actually needs, as the tool's
                       grid does. Separate station and character columns were mostly empty: a haul
                       has two stations and no character, a job has a character and one station, a
                       buy has neither in the same sense. Value and Volume stay as their own columns
                       because every kind has them and they are read down the list. -->
                  <DataGridTemplateColumn Header="Task" Width="*" SortMemberPath="TaskSortText">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:WorklistRowVm">
                        <Panel VerticalAlignment="Center">

                          <!-- Haul: where from, where to, and how much of it. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsHaul}">
                            <TextBlock Text="{Binding RouteText}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RouteText}"/>
                            <TextBlock Text="{Binding Title}" Foreground="#8a8a99" FontSize="9"
                                       VerticalAlignment="Center"/>
                          </StackPanel>

                          <!-- Job: what is being made, where, and by whom. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsJob}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding LocationName}" Foreground="#7a7a88" FontSize="9"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CharacterName}" Foreground="#8a8a99" FontSize="9"
                                       VerticalAlignment="Center"/>
                          </StackPanel>

                          <!-- Buy: what to buy, how much, and where. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBuy}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding LocationName}" Foreground="#7a7a88" FontSize="9"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>

                          <!-- Reprocess and decompress: what to do, and the one station to do it
                               at. ⚠️ Its own branch, because IsOther excludes refining —
                               without this the row matched none of the four and drew an empty
                               cell, which is indistinguishable from a task with nothing to say. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsRefining}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding LocationName}" Foreground="#7a7a88" FontSize="9"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>

                          <!-- Corp projects, asset safety, skill queues: no shared shape, so the
                               plain title, plus the character where there is one. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOther}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding CharacterName}" Foreground="#8a8a99" FontSize="9"
                                       IsVisible="{Binding HasCharacterLink}" VerticalAlignment="Center"/>
                          </StackPanel>

                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Value"     Binding="{Binding ValueText}"     Width="80"
                                      SortMemberPath="Value" />
                  <DataGridTextColumn Header="Volume"    Binding="{Binding VolumeText}"    Width="90"
                                      SortMemberPath="VolumeRaw" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <!-- Worklist (Buy) -->
          <Border x:Name="SectionWorklistBuy" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Worklist (Buy)" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenWorklist" VerticalAlignment="Center">
                  <TextBlock Text="Worklist →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <!-- No filters, no summary strip, no refresh button and no blocked/waiting/snoozed
                   toggles: this is a dashboard panel, and the tool is one click away for all of
                   that. It refreshes with the rest of the Overview. -->
              <DataGrid Grid.Row="1" ItemsSource="{Binding WorklistBuy}" Classes="wl"
                        AutoGenerateColumns="False" IsReadOnly="True" RowHeight="19"
                        AreRowDetailsFrozen="False" RowDetailsVisibilityMode="Collapsed"
                        CanUserReorderColumns="False" CanUserResizeColumns="True"
                        CanUserSortColumns="True" Background="Transparent">
                <!-- ⚠️ A resource, not a style. DataGridDetailsPresenter takes its background
                     straight from this brush in the stock template, so a style selector on it never
                     wins. Left at the theme default it paints a grey several steps lighter than the
                     grid across the full width of the expanded row, which reads as a selection
                     highlight rather than an expanded detail. Same fix as the Worklist tool. -->
                <DataGrid.Resources>
                  <SolidColorBrush x:Key="DataGridDetailsPresenterBackgroundBrush" Color="Transparent" />
                </DataGrid.Resources>

                <!-- The task's items, shown on demand — same manifest the tool expands, sized for a
                     dashboard cell. Collapsed by default: the point of the panel is the task list. -->
                <DataGrid.RowDetailsTemplate>
                  <DataTemplate x:DataType="vm:WorklistRowVm">
                    <Border Margin="30 0 0 6" Padding="8 6"
                            Background="#0f0f16" BorderBrush="#22222e" BorderThickness="1"
                            CornerRadius="3" HorizontalAlignment="Left" MinWidth="220">
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="wl:WorklistLine">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 1">
                              <Panel Grid.Column="0" Margin="0 0 16 0">
                                <Button Classes="link" Click="OnOpenManifestItem"
                                        IsVisible="{Binding HasItemLink}"
                                        ToolTip.Tip="Open in the Item Browser">
                                  <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                             FontSize="10" Foreground="#c8c8d8"/>
                                </Button>
                                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                           FontSize="10" Foreground="#c8c8d8" VerticalAlignment="Center"/>
                              </Panel>
                              <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N0}}"
                                         FontSize="10" Foreground="#8a8a99"
                                         MinWidth="48" TextAlignment="Right"/>
                              <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                         FontSize="10" Foreground="#6e6e80"
                                         MinWidth="62" TextAlignment="Right" Margin="10 0 0 0"/>
                              <TextBlock Grid.Column="3" Text="{Binding VolumeText}"
                                         FontSize="10" Foreground="#6e6e80"
                                         MinWidth="62" TextAlignment="Right" Margin="10 0 0 0"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
                </DataGrid.RowDetailsTemplate>

                <DataGrid.Columns>
                  <!-- Only drawn where there is a manifest, so an empty cell reads as "nothing to
                       expand" rather than a broken button. -->
                  <DataGridTemplateColumn Header="" Width="18" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:WorklistRowVm">
                        <Button Classes="expander" Click="OnOverviewManifestToggle"
                                IsVisible="{Binding HasLines}"
                                Content="{Binding ExpandGlyph}" FontSize="11" FontWeight="Bold"
                                Padding="0" Width="14" Height="14" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0" Foreground="#7a8896"
                                Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Show the items on this task"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- One column carrying whatever the row's kind actually needs, as the tool's
                       grid does. Separate station and character columns were mostly empty: a haul
                       has two stations and no character, a job has a character and one station, a
                       buy has neither in the same sense. Value and Volume stay as their own columns
                       because every kind has them and they are read down the list. -->
                  <DataGridTemplateColumn Header="Task" Width="*" SortMemberPath="TaskSortText">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:WorklistRowVm">
                        <Panel VerticalAlignment="Center">

                          <!-- Haul: where from, where to, and how much of it. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsHaul}">
                            <TextBlock Text="{Binding RouteText}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RouteText}"/>
                            <TextBlock Text="{Binding Title}" Foreground="#8a8a99" FontSize="9"
                                       VerticalAlignment="Center"/>
                          </StackPanel>

                          <!-- Job: what is being made, where, and by whom. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsJob}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding LocationName}" Foreground="#7a7a88" FontSize="9"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CharacterName}" Foreground="#8a8a99" FontSize="9"
                                       VerticalAlignment="Center"/>
                          </StackPanel>

                          <!-- Buy: what to buy, how much, and where. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBuy}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding LocationName}" Foreground="#7a7a88" FontSize="9"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>

                          <!-- Corp projects, asset safety, skill queues: no shared shape, so the
                               plain title, plus the character where there is one. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOther}">
                            <TextBlock Text="{Binding Title}" Foreground="#e0e0ea" FontSize="10"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Text="{Binding CharacterName}" Foreground="#8a8a99" FontSize="9"
                                       IsVisible="{Binding HasCharacterLink}" VerticalAlignment="Center"/>
                          </StackPanel>

                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Value"     Binding="{Binding ValueText}"     Width="80"
                                      SortMemberPath="Value" />
                  <DataGridTextColumn Header="Volume"    Binding="{Binding VolumeText}"    Width="90"
                                      SortMemberPath="VolumeRaw" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <!-- Worklist (Haul) -->
          <Border x:Name="SectionWorklistHaul" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
