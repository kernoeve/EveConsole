                  <DataGridTextColumn Header="Volume"    Binding="{Binding VolumeText}"    Width="90"
                                      SortMemberPath="VolumeRaw" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <!-- Worklist (Station Needs) -->
          <Border x:Name="SectionWorklistNeeds" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Worklist (Station Needs)" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenWorklistNeeds" VerticalAlignment="Center">
                  <TextBlock Text="Station Needs →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <!-- ⚠️ Columns are shown or hidden by width in code-behind (OnNeedsGridSizeChanged).
                   A dashboard cell can be a third of the window or the whole of it, and a fixed
                   column set either wastes a wide panel or squeezes the three that matter out of a
                   narrow one. Station, Item and Short always survive; the rest earn their place in
                   the order the widths below allow. -->
              <DataGrid Grid.Row="1" x:Name="NeedsGrid" Classes="wl wlneeds"
                        ItemsSource="{Binding WorklistNeedsView}"
                        SizeChanged="OnNeedsGridSizeChanged"
                        AutoGenerateColumns="False" IsReadOnly="True" RowHeight="19"
                        CanUserReorderColumns="False" CanUserResizeColumns="True"
                        CanUserSortColumns="True" Background="Transparent">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Item" Width="*" SortMemberPath="Item">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StationNeedRowVm">
                        <Panel>
                          <Button Classes="link" Click="OnOpenNeedItem" IsVisible="{Binding HasItemLink}"
                                  ToolTip.Tip="Open in the Item Browser">
                            <TextBlock Text="{Binding Item}" Classes="linktext"
                                       TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="{Binding Item}" IsVisible="{Binding !HasItemLink}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Short"   Binding="{Binding Short}"   Width="80"
                                      SortMemberPath="ShortRaw" />
                  <DataGridTextColumn Header="Total"   Binding="{Binding Total}"   Width="80"
                                      SortMemberPath="TotalRaw" />
                  <DataGridTextColumn Header="On hand" Binding="{Binding OnHand}"  Width="80"
                                      SortMemberPath="OnHandRaw" />
                  <DataGridTextColumn Header="Order jobs"       Binding="{Binding OrderJobs}" Width="80"
                                      SortMemberPath="OrderJobsRaw" />
                  <DataGridTextColumn Header="Jobs"             Binding="{Binding Jobs}"      Width="70"
                                      SortMemberPath="JobsRaw" />
                  <DataGridTextColumn Header="Inv levels"       Binding="{Binding InvLevels}" Width="90"
                                      SortMemberPath="InvLevelsRaw" />
                  <DataGridTextColumn Header="Stn levels"       Binding="{Binding StnLevels}" Width="90"
                                      SortMemberPath="StnLevelsRaw" />
                  <DataGridTextColumn Header="Short value"  Binding="{Binding ShortValue}"  Width="100"
                                      SortMemberPath="ShortValueRaw" />
                  <DataGridTextColumn Header="Short volume" Binding="{Binding ShortVolume}" Width="110"
                                      SortMemberPath="ShortVolumeRaw" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <!-- ════ Standing Projects ════════════════════════════════════ -->
          <Border x:Name="SectionStandingProjects" Background="#12121a" BorderBrush="#1e1e2a"
                  BorderThickness="1" CornerRadius="4" Padding="14 12">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                <TextBlock Text="Standing Projects" FontSize="13" FontWeight="SemiBold"
                           Foreground="#c8a84b" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="newslink" Click="OnOpenStandingProjects" VerticalAlignment="Center">
                  <TextBlock Text="Corp Activity →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
                </Button>
              </Grid>

              <TextBlock Grid.Row="1" IsVisible="{Binding NoStandingProjects}"
                         Text="No standing projects." FontSize="12" Foreground="#444455" FontStyle="Italic"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />

              <DataGrid Grid.Row="1" IsVisible="{Binding HasStandingProjects}"
                        ItemsSource="{Binding StandingProjects}"
                        AutoGenerateColumns="False" IsReadOnly="True" RowHeight="22"
                        CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                        Background="Transparent">
                <DataGrid.Styles>
                  <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
                  <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
                    <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="6 5 2 5" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <!-- One line for the whole project, since the panel has one column: the type,
                       then whatever identifies that type. Still opens the Item Browser where the
                       project names an item; the rest stay plain text. -->
                  <DataGridTemplateColumn Header="Project" SortMemberPath="SummaryText" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StandingProjectRowVm">
                        <Panel>
                          <Button Click="OnOpenProjectItem" IsVisible="{Binding HasItemLink}"
                                  Background="Transparent" BorderThickness="0" Padding="6 0"
                                  Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ToolTip.Tip="Open in the Item Browser">
                            <TextBlock Text="{Binding SummaryText}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <TextBlock Text="{Binding SummaryText}" IsVisible="{Binding !HasItemLink}"
                                     FontSize="11" VerticalAlignment="Center" Padding="6 0"
                                     TextTrimming="CharacterEllipsis" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Project Status" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StandingProjectRowVm">
                        <TextBlock Text="{Binding ProjectStatusText}" Foreground="{Binding ProjectStatusColor}"
                                   FontSize="11" VerticalAlignment="Center" Padding="6 0" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Remaining" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StandingProjectRowVm">
                        <!-- ⚠️ TextAlignment, not HorizontalAlignment. A template column's cell
                             does not stretch its content the way a text column's does, so
                             HorizontalAlignment="Right" has nothing to align against. -->
                        <TextBlock Text="{Binding RemainingText}" Foreground="{Binding RemainingColor}"
                                   FontSize="11" VerticalAlignment="Center" Padding="6 0"
                                   HorizontalAlignment="Stretch" TextAlignment="Right" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Rem. %" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:StandingProjectRowVm">
                        <TextBlock Text="{Binding RemainingPercentText}" Foreground="{Binding RemainingColor}"
                                   FontSize="11" VerticalAlignment="Center" Padding="6 0"
                                   HorizontalAlignment="Stretch" TextAlignment="Right" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

    </Panel>

    <!-- ── Status bar ───────────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="#0d0d12" Padding="14 4"
            BorderThickness="0 1 0 0" BorderBrush="#1e1e2a">
      <TextBlock Text="Overview data reflects characters and personal corporations only."
                 FontSize="11" Foreground="#444455" />
    </Border>

  </Grid>
</UserControl>
