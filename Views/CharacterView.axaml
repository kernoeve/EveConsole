                    <Border Margin="30 0 0 6" Padding="8 6"
                            Background="#0f0f16" BorderBrush="#22222e" BorderThickness="1"
                            CornerRadius="3" HorizontalAlignment="Left" MinWidth="220">
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="wl:WorklistLine">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 1">
                              <Panel Grid.Column="0" Margin="0 0 16 0">
                                <Button Classes="link" Click="OnOpenManifestItem"
                                        IsVisible="{Binding HasItemLink}"
                                        ToolTip.Tip="Open in the Item Browser">
                                  <TextBlock Text="{Binding TypeName}" Classes="linktext"
                                             FontSize="10" Foreground="#c8c8d8"/>
                                </Button>
                                <TextBlock Text="{Binding TypeName}" IsVisible="{Binding !HasItemLink}"
                                           FontSize="10" Foreground="#c8c8d8" VerticalAlignment="Center"/>
                              </Panel>
                              <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N0}}"
                                         FontSize="10" Foreground="#8a8a99"
                                         MinWidth="48" TextAlignment="Right"/>
                              <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                         FontSize="10" Foreground="#6e6e80"
                                         MinWidth="62" TextAlignment="Right" Margin="10 0 0 0"/>
                              <TextBlock Grid.Column="3" Text="{Binding VolumeText}"
                                         FontSize="10" Foreground="#6e6e80"
                                         MinWidth="62" TextAlignment="Right" Margin="10 0 0 0"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
                </DataGrid.RowDetailsTemplate>

                <DataGrid.Columns>
                  <!-- Only drawn where there is a manifest, so an empty cell reads as "nothing to
                       expand" rather than a broken button. -->
                  <DataGridTemplateColumn Header="" Width="18" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:WorklistRowVm">
                        <Button Classes="expander" Click="OnOverviewManifestToggle"
                                IsVisible="{Binding HasLines}"
                                Content="{Binding ExpandGlyph}" FontSize="11" FontWeight="Bold"
                                Padding="0" Width="14" Height="14" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0" Foreground="#7a8896"
                                Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Show the items on this task"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- One column carrying whatever the row's kind actually needs, as the tool's
                       grid does. Separate station and character columns were mostly empty: a haul
                       has two stations and no character, a job has a character and one station, a
                       buy has neither in the same sense. Value and Volume stay as their own columns
                       because every kind has them and they are read down the list. -->
                  <DataGridTemplateColumn Header="Task" Width="*" SortMemberPath="TaskSortText">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:WorklistRowVm">
                        <Panel VerticalAlignment="Center">

                          <!-- Haul: where from, where to, and how much of it. -->
