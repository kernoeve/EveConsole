<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.ChatBadges"
             x:DataType="vm:MainWindowViewModel">

  <!-- The Eve Mail, direct messages and group chat icons, for the main window's bar and for panels.
       Only the one asked for shows (see Badge). -->
  <UserControl.Resources>
    <StreamGeometry x:Key="MailIcon">M1.5 3.5 h13 v9 h-13 z</StreamGeometry>
    <StreamGeometry x:Key="MailFlap">M1.5 3.5 L8 8.6 L14.5 3.5</StreamGeometry>
    <StreamGeometry x:Key="MessagesIcon">M2 2.5 h12 a1 1 0 0 1 1 1 v7 a1 1 0 0 1 -1 1 H7 l-3.2 3 v-3 H2 a1 1 0 0 1 -1 -1 v-7 a1 1 0 0 1 1 -1 z</StreamGeometry>
    <StreamGeometry x:Key="GroupChatIcon">M3 5 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0 z M0.8 13.8 v-1.3 a3.5 3.5 0 0 1 3.5 -3.5 h2.4 a3.5 3.5 0 0 1 3.5 3.5 v1.3 z M10.2 2.6 a2.5 2.5 0 0 1 0 4.8 M11.8 9.1 a3.4 3.4 0 0 1 3.4 3.4 v1.3 h-2.6</StreamGeometry>
  </UserControl.Resources>

  <Panel>
    <!-- Eve Mail: a dim envelope with nothing unread; white, with a count, when there is. -->
    <StackPanel x:Name="MailItem" Orientation="Horizontal" Spacing="4" IsVisible="False">
      <Grid Width="16" Height="16" VerticalAlignment="Center">
        <Path IsVisible="{Binding !EveMailVm.HasUnread}" Data="{StaticResource MailIcon}"
              Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.2" StrokeJoin="Round" />
        <Path IsVisible="{Binding !EveMailVm.HasUnread}" Data="{StaticResource MailFlap}"
              Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.2" StrokeJoin="Round" />
        <Path IsVisible="{Binding EveMailVm.HasUnread}" Data="{StaticResource MailIcon}"
              Fill="{DynamicResource TextBrightBrush}" />
        <Path IsVisible="{Binding EveMailVm.HasUnread}" Data="{StaticResource MailFlap}"
              Stroke="{DynamicResource SurfaceHeaderBrush}" StrokeThickness="1.2" StrokeJoin="Round" />
      </Grid>
      <TextBlock IsVisible="{Binding EveMailVm.HasUnread}" Text="{Binding EveMailVm.UnreadText}" FontSize="11" FontWeight="SemiBold"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrightBrush}" />
    </StackPanel>

    <!-- Direct messages: dim with nothing new, lit with a count when something is waiting. -->
    <StackPanel x:Name="MessagesItem" Orientation="Horizontal" Spacing="4" IsVisible="False">
      <Grid>
        <Path IsVisible="{Binding !MessagesVm.HasUnread}" Data="{StaticResource MessagesIcon}"
              Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.2" Width="16" Height="16" VerticalAlignment="Center" />
        <Path IsVisible="{Binding MessagesVm.HasUnread}" Data="{StaticResource MessagesIcon}"
              Fill="{DynamicResource WarnBrush}" Width="16" Height="16" VerticalAlignment="Center" />
      </Grid>
      <TextBlock IsVisible="{Binding MessagesVm.HasUnread}" Text="{Binding MessagesVm.UnreadText}" FontSize="11" FontWeight="SemiBold"
                 VerticalAlignment="Center" Foreground="{DynamicResource WarnBrush}" />
    </StackPanel>

    <!-- Group chat: dim with nothing new; lit with a count for new messages; in warning colours only when named. -->
    <StackPanel x:Name="GroupChatItem" Orientation="Horizontal" Spacing="4" IsVisible="False">
      <Grid>
        <Path IsVisible="{Binding !GroupChatVm.HasUnread}" Data="{StaticResource GroupChatIcon}"
              Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.2" Width="16" Height="16" VerticalAlignment="Center" />
        <Path IsVisible="{Binding GroupChatVm.HasOnlyUnread}" Data="{StaticResource GroupChatIcon}"
              Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center" />
        <Path IsVisible="{Binding GroupChatVm.HasMentions}" Data="{StaticResource GroupChatIcon}"
              Fill="{DynamicResource WarnBrush}" Width="16" Height="16" VerticalAlignment="Center" />
      </Grid>
      <TextBlock IsVisible="{Binding GroupChatVm.HasUnread}" Text="{Binding GroupChatVm.UnreadText}" FontSize="11" FontWeight="SemiBold"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock IsVisible="{Binding GroupChatVm.HasMentions}" Text="{Binding GroupChatVm.MentionsText}" FontSize="11" FontWeight="SemiBold"
                 VerticalAlignment="Center" Foreground="{DynamicResource WarnBrush}" />
    </StackPanel>
  </Panel>
</UserControl>
