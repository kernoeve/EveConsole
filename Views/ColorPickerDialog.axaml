<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.ColorPickerDialog"
        Title="Custom colour"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <StackPanel Margin="14" Spacing="12">

    <!-- ColorView rather than ColorPicker: the picker is a dropdown wrapper, and this is already
         inside a dialog whose whole purpose is choosing. Alpha is hidden — EVE takes ARGB but the
         alpha is not a choice here, it is always fully opaque, and offering it would let someone
         pick an invisible colour. -->
    <!-- ⚠️ Saturation across, Value down — so the slider beside the box is HUE.
         The default puts hue in the box and value on the slider, and Avalonia draws that slider
         as a ramp from black to the current hue at FULL saturation, ignoring where you are
         vertically. Slide it and the sample goes black to white while the slider itself stays
         blue, which reads as the control being broken. Hue on the slider has no such coupling:
         it is a rainbow whatever the box says, and this is the arrangement most pickers use. -->
    <ColorView x:Name="Picker"
               ColorSpectrumComponents="SaturationValue"
               IsAlphaEnabled="False"
               IsAlphaVisible="False"
               Height="330" />

    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
               Text="EVE mail is drawn on a near-black background, so very dark colours all but disappear in it. The swatch below is on that background rather than on this dialog's." />

    <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="3" Padding="10 8"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
      <TextBlock x:Name="Sample" Text="Archon  (10,0,0) - 2.12B" FontSize="12" />
    </Border>

    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBlock Grid.Column="0" x:Name="HexLabel" Text="" FontSize="11"
                 Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              Padding="14 5" FontSize="12" Margin="0 0 8 0" />
      <Button Grid.Column="2" x:Name="OkButton" Content="Use this colour"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
              Padding="14 5" FontSize="12" />
    </Grid>
  </StackPanel>
</Window>
