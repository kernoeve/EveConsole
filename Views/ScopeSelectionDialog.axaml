<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.ScopeSelectionDialog"
        x:DataType="vm:CharacterViewModel"
        Width="520" Height="580"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" Padding="18 14">
      <StackPanel Spacing="6">
        <TextBlock x:Name="DialogTitle"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{x:Static loc:SettingsText.ABrowserTabWillNote}"
                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Select All / None + warning -->
    <StackPanel Grid.Row="1" Spacing="6" Margin="16 10 16 4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{x:Static loc:SettingsText.SelectAll}"
                Command="{Binding SelectAllScopesCommand}"
                Padding="10 3" FontSize="11" />
        <Button Content="{x:Static loc:SettingsText.ClearAll}"
                Command="{Binding ClearAllScopesCommand}"
                Padding="10 3" FontSize="11" />
      </StackPanel>
      <TextBlock Text="{x:Static loc:SettingsText.RemovingScopesWillDisableNote}"
                 FontSize="11" Foreground="{DynamicResource AccentBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <!-- Grouped scope checklist -->
    <ScrollViewer Grid.Row="2" Margin="16 0">
      <ItemsControl ItemsSource="{Binding DialogScopeGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ScopeGroup">
            <StackPanel Margin="0 0 0 10">

              <!-- Group header — label only, not a scope itself -->
              <TextBlock Text="{Binding Category}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         Margin="0 0 0 2" />

              <!-- Individual scope checkboxes -->
              <ItemsControl ItemsSource="{Binding Items}" Margin="8 0 0 0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScopeItem">
                    <CheckBox IsChecked="{Binding IsSelected}"
                              Content="{Binding FriendlyName}"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Margin="0 1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Action buttons -->
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBaseBrush}" Padding="16 12">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button Content="{x:Static loc:SettingsText.Cancel}"
                Click="OnCancel"
                Padding="16 5" />
        <Button Content="{x:Static loc:SettingsText.ContinueToBrowser}"
                Click="OnContinue"
                Padding="16 5" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
