<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveConsole.Views.ComposeMailDialog"
        Title="Compose Mail"
        Width="620" Height="540"
        MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16 12">

    <!-- Header fields -->
    <StackPanel Grid.Row="0" Spacing="8">

      <TextBlock Text="FROM" FontSize="9" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1.2" />
      <ComboBox x:Name="FromCombo"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                HorizontalAlignment="Stretch" Padding="6 3" Margin="0 0 0 4"
                SelectionChanged="OnFromCharacterChanged" />

      <TextBlock Text="TO  (search name, press Enter to add)" FontSize="9" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1.2" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" x:Name="RecipientSearchBox"
                 Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                 CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                 FontSize="12" Padding="8 4"
                 Watermark="Character name…"
                 KeyDown="OnRecipientKeyDown" />
        <Button Grid.Column="1" Content="Add"
                Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource InfoBrush}"
                BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1"
                Padding="10 4" Margin="6 0 0 0" FontSize="11"
                Click="OnAddRecipientClick" />
      </Grid>
      <TextBlock x:Name="RecipientSearchStatus"
                 FontSize="10" Foreground="{DynamicResource BadBrush}" IsVisible="False" />

      <!-- Recipient chips -->
      <ItemsControl x:Name="RecipientList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource SurfaceSelectedBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="6 2" Margin="0 2 4 2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:CompileBindings="False" Text="{Binding Name}"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Button x:CompileBindings="False" Tag="{Binding}"
                        Content="×" FontSize="12"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextFaintBrush}" Padding="0" Cursor="Hand"
                        Click="OnRemoveRecipientClick" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="SUBJECT" FontSize="9" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1.2" Margin="0 4 0 0" />
      <TextBox x:Name="SubjectBox"
               Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
               CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
               FontSize="12" Padding="8 4" />
    </StackPanel>

    <!-- Body -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0 10 0 0">
      <TextBlock Grid.Row="0" Text="BODY" FontSize="9" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1.2" Margin="0 0 0 4" />
      <TextBox Grid.Row="1" x:Name="BodyBox"
               AcceptsReturn="True" TextWrapping="Wrap"
               Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
               CornerRadius="3" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
               FontSize="12" Padding="8" />
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0 10 0 0">
      <TextBlock Grid.Column="0" x:Name="StatusLabel"
                 FontSize="11" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Cancel"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              Padding="14 6" Margin="0 0 8 0"
              Click="OnCancelClick" />
      <Button Grid.Column="2" Content="Send"
              Background="{DynamicResource SurfaceSelectedBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
              Padding="14 6"
              Click="OnSendClick" />
    </Grid>

  </Grid>
</Window>
