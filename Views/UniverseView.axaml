<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:ctrl="clr-namespace:EveConsole.Controls"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.UniverseView"
             x:DataType="vm:UniverseViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin" Value="2 0 0 1" />
    </Style>
    <Style Selector="Button.crumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
      <Setter Property="Padding" Value="4 2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.crumb:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.dlabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.dvalue">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.cardtitle">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin" Value="0 0 0 4" />
    </Style>
    <Style Selector="Button.linkrow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0 2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.linkrow:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,1,Auto,1,*">

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" Padding="12 8"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{x:Static loc:MapText.OverlayLabel}" Classes="flabel"
                   VerticalAlignment="Center" Margin="0 0 6 0" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding OverlayModes}"
                  SelectedItem="{Binding SelectedOverlay}"
                  FontSize="11" MinWidth="140" />

        <Button Grid.Column="2" Command="{Binding RefreshCommand}" Content="{x:Static loc:MapText.Refresh}"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}"
                BorderThickness="1" Padding="12 4" FontSize="11" Margin="16 0 0 0" />

        <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="16 0 0 0"
                   TextTrimming="CharacterEllipsis" />

        <!-- Takes a planned route off this map. -->
        <Button Grid.Column="4" Command="{Binding ClearRouteCommand}" Content="{x:Static loc:MapText.ClearRoute}"
                IsVisible="{Binding HasRoute}" ToolTip.Tip="{x:Static loc:MapText.TipClearRoute}"
                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1" Padding="10 4" FontSize="11" Margin="12 0 0 0" />

        <!-- Shows or hides the details and legend on the right, so the map can have the room. -->
        <ToggleButton Grid.Column="5" IsChecked="{Binding ShowBridges}" Content="{x:Static loc:MapText.JumpBridgesToggle}"
                      ToolTip.Tip="{x:Static loc:MapText.TipJumpBridgesToggle}"
                      Padding="10 4" FontSize="11" Margin="12 0 0 0" />
        <ToggleButton Grid.Column="6" IsChecked="{Binding ShowHoles}" Content="{x:Static loc:MapText.WormholesToggle}"
                      ToolTip.Tip="{x:Static loc:MapText.TipWormholesToggle}" IsVisible="{Binding HolesAvailable}"
                      Padding="10 4" FontSize="11" Margin="12 0 0 0" />
        <ToggleButton Grid.Column="7" IsChecked="{Binding ShowStorms}" Content="{x:Static loc:MapText.StormsToggle}"
                      ToolTip.Tip="{x:Static loc:MapText.TipStormsToggle}" IsVisible="{Binding HolesAvailable}"
                      Padding="10 4" FontSize="11" Margin="12 0 0 0" />
        <ToggleButton Grid.Column="8" IsChecked="{Binding ShowCampaigns}" Content="{x:Static loc:MapText.CampaignsToggle}"
                      ToolTip.Tip="{x:Static loc:MapText.TipCampaignsToggle}" IsVisible="{Binding CampaignsAvailable}"
                      Padding="10 4" FontSize="11" Margin="12 0 0 0" />
        <ToggleButton Grid.Column="9" IsChecked="{Binding ShowSidePanel}" Content="{x:Static loc:MapText.SidePanel}"
                      ToolTip.Tip="{x:Static loc:MapText.TipSidePanel}"
                      Padding="10 4" FontSize="11" Margin="12 0 0 0" />
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="{DynamicResource BorderSubtleBrush}" />

    <!-- ── Breadcrumb ───────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBaseBrush}" Padding="10 4">
      <ItemsControl ItemsSource="{Binding Crumbs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:CrumbVm">
            <StackPanel Orientation="Horizontal">
              <!-- The trailing crumb is where you already are, so it is shown but not clickable. -->
              <Button Classes="crumb" Content="{Binding Text}"
                      Command="{Binding GoCommand}" IsEnabled="{Binding !IsLast}" />
              <TextBlock Text="›" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"
                         VerticalAlignment="Center" Margin="2 0"
                         IsVisible="{Binding !IsLast}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Rectangle Grid.Row="3" Fill="{DynamicResource BorderSubtleBrush}" />

    <!-- ── Map + side panel ─────────────────────────────────────────── -->
    <!-- The panel's column sizes to its content, so hiding it gives the map the whole width. -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto">

      <!-- A system's page opens in a tab of its own (the map tool's), so this is always the map. -->
      <ctrl:MapCanvas Grid.Column="0"
                      Graph="{Binding Graph}"
                      Overlay="{Binding Overlay}"
                      Badges="{Binding Badges}"
                      Markers="{Binding Markers}"
                      Bridges="{Binding VisibleBridges}"
                      Routes="{Binding Routes}"
                      Avoided="{Binding Avoided}"
                      Holes="{Binding VisibleHoles}"
                      Storms="{Binding VisibleStorms}"
                      Campaigns="{Binding VisibleCampaigns}"
                      HoleLinks="{Binding VisibleHoleLinks}"
                      ContextRequested="OnMapContextRequested"
                      Camera="{Binding Camera, Mode=TwoWay}"
                      SelectedId="{Binding SelectedId, Mode=TwoWay}"
                      FocusBounds="{Binding FocusBounds, Mode=TwoWay}"
                      ActivateCommand="{Binding DrillDownCommand}" />

      <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderSubtleBrush}" IsVisible="{Binding ShowSidePanel}" />

      <Border Grid.Column="2" Width="220" Background="{DynamicResource SurfaceBaseBrush}" Padding="12 10"
              IsVisible="{Binding ShowSidePanel}">
        <StackPanel Spacing="10">

          <StackPanel IsVisible="{Binding DetailTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding DetailTitle}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrightBrush}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding DetailRows}" Margin="0 6 0 0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                    <TextBlock Grid.Column="0" Classes="dlabel" Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="dvalue" Text="{Binding Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="{x:Static loc:MapText.ClickANodeForNote}"
                     FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding DetailTitle, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

          <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" IsVisible="{Binding Legend.Count}" />

          <StackPanel IsVisible="{Binding Legend.Count}">
            <TextBlock Classes="flabel" Text="{x:Static loc:MapText.LegendLabel}" Margin="0 0 0 4" />
            <ItemsControl ItemsSource="{Binding Legend}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:LegendEntryVm">
                  <StackPanel Orientation="Horizontal" Spacing="7" Margin="0 3">
                    <!-- A band may cover several steps of the ramp, so the swatch is a strip. -->
                    <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Rectangle Width="9" Height="9" Fill="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" />

          <!-- Box marks. Always shown, because unlike the overlay legend above these do not
               change with the overlay — and a row of small coloured squares with nothing
               explaining them is decoration rather than information. -->
          <StackPanel Spacing="4">
            <TextBlock Classes="flabel" Text="{x:Static loc:MapText.DockingBarAboveTheBoxLabel}" />
            <ItemsControl ItemsSource="{Binding DockLegend}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:LegendEntryVm">
                  <StackPanel Orientation="Horizontal" Spacing="7" Margin="0 2">
                    <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <!-- A wide bar, matching the map. Thickness is the rank there; here the
                               three sit in a fixed order, so one height reads cleanly. -->
                          <Rectangle Width="18" Height="5" Fill="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="flabel" Text="{x:Static loc:MapText.ServicesUnderTheBoxLabel}" Margin="0 6 0 0" />
            <ItemsControl ItemsSource="{Binding ServiceLegend}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:LegendEntryVm">
                  <StackPanel Orientation="Horizontal" Spacing="7" Margin="0 2">
                    <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Rectangle Width="9" Height="9" Fill="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0 4 0 0"
                       Text="{x:Static loc:MapText.MergedFromNpcStationsNote}" />
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" />

          <!-- The live marks, drawn the same way as on the map: round and right for hostiles,
               square and left for your own characters. -->
          <StackPanel Spacing="4">
            <TextBlock Classes="flabel" Text="{x:Static loc:MapText.LiveMarksLabel}" />
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="11" Height="11" Fill="{DynamicResource BadBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static loc:MapText.LiveMarkHostiles}" FontSize="10.5" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="170" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static loc:MapText.LiveMarkOwn}" FontSize="10.5" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="170" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Line StartPoint="0,6" EndPoint="11,6" Stroke="#c084fc" StrokeThickness="1.8" StrokeDashArray="2,1.5"
                    VerticalAlignment="Center" />
              <TextBlock Text="{x:Static loc:MapText.LegendJumpBridge}" FontSize="10.5" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="170" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding HolesAvailable}">
              <Border Width="13" Height="13" CornerRadius="3" Background="#2DD4BF" VerticalAlignment="Center">
                <TextBlock Text="Θ" FontSize="9" FontWeight="Bold" Foreground="#062925"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static loc:MapText.LegendWormholes}" FontSize="10.5" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="170" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding HolesAvailable}">
              <Border Width="13" Height="13" CornerRadius="3" Background="#F5B83D" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="9" FontWeight="Bold" Foreground="#2b1d00"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static loc:MapText.LegendStorms}" FontSize="10.5" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="170" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding CampaignsAvailable}">
              <Border Width="13" Height="13" CornerRadius="3" Background="#DC2626" VerticalAlignment="Center">
                <TextBlock Text="⚔" FontSize="9" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static loc:MapText.LegendCampaigns}" FontSize="10.5" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="170" />
            </StackPanel>
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" />

          <TextBlock FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                     Text="{x:Static loc:MapText.ScrollToZoomDragNote}" />

        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
