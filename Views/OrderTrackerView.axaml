<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.OrderTrackerView"
             x:DataType="vm:OrderTrackerViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="6 5 2 5" />
    </Style>
    <Style Selector="DataGridCell.num TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Margin" Value="0 0 8 0" />
    </Style>
    <Style Selector="TextBlock.fl">
      <Setter Property="Foreground" Value="#555566" /><Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="#131320" /><Setter Property="BorderBrush" Value="#2a2a3a" />
      <Setter Property="Foreground" Value="#ccccdd" /><Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Background="#0d0d12" Padding="10 6" BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
      <StackPanel Spacing="7">

        <!-- Title + actions -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="Order Tracker" FontSize="13" FontWeight="SemiBold"
                     Foreground="#c8a84b" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#888899"
                     VerticalAlignment="Center" Margin="12 0 0 0" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Content="Add Order" Command="{Binding AddCommand}" Padding="12 4"
                    Background="#1a2030" Foreground="#c8a84b" BorderBrush="#3a3020" BorderThickness="1" />
            <Button Content="Edit"   Command="{Binding EditCommand}"   Padding="12 4"
                    IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="12 4"
                    IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>

        <!-- Filters -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="fl" Text="Status" />
          <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" MinWidth="110" />
          <TextBlock Classes="fl" Text="Created" Margin="8 0 0 0" />
          <TextBox Text="{Binding CreatedFrom}" Watermark="from yyyy-MM-dd" Width="115" />
          <TextBox Text="{Binding CreatedThru}" Watermark="thru yyyy-MM-dd" Width="115" />
          <TextBlock Classes="fl" Text="Type" Margin="8 0 0 0" />
          <TextBox Text="{Binding TypeFilter}" Watermark="item name" Width="150" />
          <TextBlock Classes="fl" Text="Buyer" Margin="8 0 0 0" />
          <TextBox Text="{Binding BuyerFilter}" Watermark="buyer" Width="130" />
        </StackPanel>

      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              Background="#0d0d12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Created"        Binding="{Binding CreatedText}" SortMemberPath="CreatedSort" Width="100" />
        <DataGridTextColumn Header="Type"           Binding="{Binding Type}"        Width="230" />
        <DataGridTextColumn Header="Units"          Binding="{Binding UnitsText}"   SortMemberPath="Units"       Width="90"  CellStyleClasses="num" />
        <DataGridTextColumn Header="Buyer"          Binding="{Binding Buyer}"       Width="150" />
        <DataGridTextColumn Header="Est. Date"      Binding="{Binding EstDate}"     Width="100" />
        <DataGridTextColumn Header="Purchase Price" Binding="{Binding Purchase}"    SortMemberPath="PurchaseRaw" Width="120" CellStyleClasses="num" />
        <DataGridTextColumn Header="Status"         Binding="{Binding Status}"      Width="100" />
        <DataGridTextColumn Header="Build Cost"     Binding="{Binding Build}"       SortMemberPath="BuildRaw"    Width="120" CellStyleClasses="num" />
        <DataGridTextColumn Header="Profit"         Binding="{Binding Profit}"      SortMemberPath="ProfitRaw"   Width="120" CellStyleClasses="num" />
        <DataGridTextColumn Header="Profit %"       Binding="{Binding ProfitPct}"   SortMemberPath="ProfitPctRaw" Width="90" CellStyleClasses="num" />
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
