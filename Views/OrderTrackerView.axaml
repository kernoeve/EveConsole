<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.OrderTrackerView"
             x:DataType="vm:OrderTrackerViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <!-- A settled order quotes the cost from the day it settled, so the cell says which day. -->
    <Style Selector="DataGridCell.build"><Setter Property="ToolTip.Tip" Value="{Binding BuildBasis}" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" /><Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="6 5 2 5" />
    </Style>
    <Style Selector="TextBlock.fl">
      <Setter Property="Foreground" Value="#555566" /><Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="#131320" /><Setter Property="BorderBrush" Value="#2a2a3a" />
      <Setter Property="Foreground" Value="#ccccdd" /><Setter Property="FontSize" Value="11" />
    </Style>

    <!-- A name that opens something. ⚠️ No Foreground: a link keeps whatever colour its column
         already had, with the cursor and a hover underline as the only cues — the same rule the
         Killmail tool, Corp Activity and the system page follow. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Background="#0d0d12" Padding="10 6" BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
      <StackPanel Spacing="7">

        <!-- Title + actions -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="Order Tracker" FontSize="13" FontWeight="SemiBold"
                     Foreground="#c8a84b" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#888899"
                     VerticalAlignment="Center" Margin="12 0 0 0" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <!-- The grid loads on startup and after an edit; the fulfilment poll changes rows
                 behind it every five minutes, so there has to be a way to pick that up. -->
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12 4" />
            <Button Content="Add Order" Command="{Binding AddCommand}" Padding="12 4"
                    Background="#1a2030" Foreground="#c8a84b" BorderBrush="#3a3020" BorderThickness="1" />
            <Button Content="Edit"   Command="{Binding EditCommand}"   Padding="12 4"
                    IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="12 4"
                    IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>

        <!-- Filters -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="fl" Text="Status" />
          <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" MinWidth="110" />
          <TextBlock Classes="fl" Text="Created" Margin="8 0 0 0" />
          <TextBox Text="{Binding CreatedFrom}" Watermark="from yyyy-MM-dd" Width="115" />
          <TextBox Text="{Binding CreatedThru}" Watermark="thru yyyy-MM-dd" Width="115" />
          <TextBlock Classes="fl" Text="Type" Margin="8 0 0 0" />
          <TextBox Text="{Binding TypeFilter}" Watermark="item name" Width="150" />
          <TextBlock Classes="fl" Text="Buyer" Margin="8 0 0 0" />
          <TextBox Text="{Binding BuyerFilter}" Watermark="buyer" Width="130" />
        </StackPanel>

      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              Background="#0d0d12" DoubleTapped="OnRowDoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Created"        Binding="{Binding CreatedText}" SortMemberPath="CreatedSort" Width="100" />
        <DataGridTemplateColumn Header="Type" SortMemberPath="Type" Width="230">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TrackedOrderRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenRowType" IsVisible="{Binding HasTypeLink}" ToolTip.Tip="Open in the Item Browser">
                  <TextBlock Text="{Binding Type}" Classes="linktext"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Type}" IsVisible="{Binding !HasTypeLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Units"          Binding="{Binding UnitsText}"   SortMemberPath="Units"       Width="90"  CellStyleClasses="num" />
        <DataGridTemplateColumn Header="Buyer" SortMemberPath="Buyer" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TrackedOrderRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenRowBuyer" IsVisible="{Binding HasBuyerLink}" ToolTip.Tip="Open in the entity browser">
                  <TextBlock Text="{Binding Buyer}" Classes="linktext"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Buyer}" IsVisible="{Binding !HasBuyerLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Blank means entered by hand rather than taken by mail. -->
        <DataGridTextColumn Header="Store" Binding="{Binding Store}" Width="130" />
        <!-- Blank means the buyer, not "unknown": a contract with nobody named goes to whoever
             ordered. Only orders where someone said otherwise carry a name here. -->
        <DataGridTemplateColumn Header="Contract To" SortMemberPath="ContractTo" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TrackedOrderRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenRowContractTo" IsVisible="{Binding HasContractToLink}" ToolTip.Tip="Open in the entity browser">
                  <TextBlock Text="{Binding ContractTo}" Classes="linktext"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding ContractTo}" IsVisible="{Binding !HasContractToLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Three separate facts, deliberately not one "source" field: what is on the shelf, what
             is making it, and what delivered it. Folding them together meant linking a contract
             erased the job that built the thing. -->
        <DataGridTextColumn Header="Stock" Binding="{Binding FromStock}" Width="55"
                            SortMemberPath="FromStock" />
        <DataGridTextColumn Header="Indy Job" Binding="{Binding IndyJob}" Width="110"
                            SortMemberPath="IndyJob" />
        <DataGridTemplateColumn Header="Contract" Width="220" SortMemberPath="Contract">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TrackedOrderRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenContract" IsVisible="{Binding HasContractLink}"
                        ToolTip.Tip="Open this contract in the Contracts tool">
                  <TextBlock Text="{Binding Contract}" Classes="linktext"
                             TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Contract}" IsVisible="{Binding !HasContractLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Est. Date"      Binding="{Binding EstDate}"     Width="100" />
        <DataGridTextColumn Header="Pri"            Binding="{Binding PriorityMark}" SortMemberPath="IsPriority" Width="44" />
        <DataGridTextColumn Header="Purchase Price" Binding="{Binding Purchase}"    SortMemberPath="PurchaseRaw" Width="120" CellStyleClasses="num" />
        <DataGridTextColumn Header="Status"         Binding="{Binding Status}"      Width="100" />
        <DataGridTextColumn Header="Completed"      Binding="{Binding CompletedOn}" Width="100" />
        <DataGridTextColumn Header="Build Cost"     Binding="{Binding Build}"       SortMemberPath="BuildRaw"    Width="120" CellStyleClasses="num build" />
        <DataGridTextColumn Header="Profit"         Binding="{Binding Profit}"      SortMemberPath="ProfitRaw"   Width="120" CellStyleClasses="num" />
        <DataGridTextColumn Header="Profit %"       Binding="{Binding ProfitPct}"   SortMemberPath="ProfitPctRaw" Width="90" CellStyleClasses="num" />
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
