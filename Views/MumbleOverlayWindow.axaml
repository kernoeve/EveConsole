<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="clr-namespace:EveConsole.ViewModels"
        x:Class="EveConsole.Views.MumbleOverlayWindow"
        x:DataType="vm:MumbleViewModel"
        Title="{x:Static loc:MumbleText.OverlayTitle}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SystemDecorations="None"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        MinWidth="150">

  <!-- Dragged by anywhere on it, and small: it sits over a game. -->
  <Border Background="#C8101418" CornerRadius="5" Padding="8 6" PointerPressed="OnDrag">
    <StackPanel Spacing="2">
      <TextBlock Text="{x:Static loc:MumbleText.OverlayNobody}" IsVisible="{Binding NobodyTalking}" FontSize="11" Foreground="#80FFFFFF" />
      <ItemsControl ItemsSource="{Binding Talkers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MumbleOverlayLine">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 1">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#5CD672" />
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="{Binding Server}" FontSize="10" VerticalAlignment="Center" Foreground="#A0FFFFFF" />
              <TextBlock Text="{x:Static loc:MumbleText.OverlayShout}" IsVisible="{Binding IsShout}" FontSize="10" VerticalAlignment="Center" Foreground="#FFD27A" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
