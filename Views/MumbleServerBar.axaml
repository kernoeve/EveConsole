<!-- One connected server's controls: the channels on the left, then who or where this client is, then mute, deafen and the
     sound settings. The same on the always-on-top window and the main window's toolbar, which differ only in the middle. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:views="using:EveConsole.Views"
             x:Class="EveConsole.Views.MumbleServerBar"
             x:DataType="vm:MumbleOverlayColumn">

  <UserControl.Styles>
    <StyleInclude Source="avares://EveConsole/Views/MumbleStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Orientation="Horizontal" Spacing="2">
    <Button x:Name="TreeButton" Classes="icon tree" ToolTip.Tip="{x:Static loc:MumbleText.OverlayChannels}">
      <Path Classes="menu" Data="M1 3h10M1 6h10M1 9h10" />
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="mumblepopup" Opening="OnTreeOpening" Opened="OnTreeOpened" Closed="OnTreeClosed">
          <Grid RowDefinitions="Auto,*,Auto,Auto" Width="280">
          <!-- Finding someone, and whether the people under each channel show at all. -->
          <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 6">
            <TextBox Classes="clearButton" Text="{Binding Owner.FindPerson}" Watermark="{x:Static loc:MumbleText.FindPersonHint}" FontSize="11" MinHeight="26" Padding="6 3" />
            <ToggleButton Grid.Column="1" Classes="icon people" IsChecked="{Binding Owner.ShowPeople}" Margin="4 0 0 0" ToolTip.Tip="{x:Static loc:MumbleText.ShowPeopleTip}">
              <Path Data="M4 3.5 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0 z M1.5 12 v-1 a3.5 3.5 0 0 1 3.5 -3.5 h3 a3.5 3.5 0 0 1 3.5 3.5 v1 z"
                    Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" />
            </ToggleButton>
          </Grid>
          <ScrollViewer Grid.Row="1" MaxHeight="460" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <!-- Its rows start one step in, under the server they are not showing here. -->
            <ItemsControl x:Name="Tree" ItemsSource="{Binding Rows}" Margin="-14 0 0 0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MumbleRowVm">
                  <Grid Margin="{Binding Indent}" Background="Transparent" ContextRequested="OnRowMenu">
                    <Grid IsVisible="{Binding IsChannel}" ColumnDefinitions="14,*,Auto">
                      <Button Classes="chevron" IsVisible="{Binding HasChildren}" Click="OnToggleChannel">
                        <Panel>
                          <Path IsVisible="{Binding !IsOpen}" Data="M1 0 L6 4.5 L1 9 Z" Fill="{DynamicResource TextMutedBrush}" />
                          <Path IsVisible="{Binding IsOpen}" Data="M0 1 L9 1 L4.5 6 Z" Fill="{DynamicResource TextMutedBrush}" />
                        </Panel>
                      </Button>
                      <Button Grid.Column="1" Classes="channel" Click="OnChannelClick">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <TextBlock Classes="channelname" Classes.here="{Binding IsHere}" Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          <Path IsVisible="{Binding IsListening}" Data="M3 7a4 4 0 1 1 7 2.6c-.8.9-1.5 1.4-1.5 2.4a1.8 1.8 0 0 1-3.2 1" Stroke="{DynamicResource GoodBrush}" StrokeThickness="1.1" Width="12" Height="14" VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:MumbleText.StopListening}" />
                        </StackPanel>
                      </Button>
                      <!-- Who is in it, and how many of them can hear. -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasPeople}" Margin="6 0 2 0" VerticalAlignment="Center"
                                  Background="Transparent" ToolTip.Tip="{Binding PeopleTip}">
                        <Path Data="M4 3.5 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0 z M1.5 12 v-1 a3.5 3.5 0 0 1 3.5 -3.5 h3 a3.5 3.5 0 0 1 3.5 3.5 v1 z"
                              Fill="{DynamicResource TextDimBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Classes="count" Text="{Binding People}" />
                        <Path Data="M2 7V6a4 4 0 0 1 8 0v1M2 7v2a1 1 0 0 0 2 0V7a1 1 0 0 0-2 0zM10 7v2a1 1 0 0 1-2 0V7a1 1 0 0 1 2 0z"
                              Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.1" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="3 0 0 0" />
                        <TextBlock Classes="count" Text="{Binding Hearing}" />
                      </StackPanel>
                    </Grid>
                    <Grid IsVisible="{Binding IsUser}" ColumnDefinitions="14,Auto,*,Auto" Margin="4 2">
                      <Ellipse Classes="talker" Classes.channel="{Binding TalksChannel}" Classes.shout="{Binding TalksShout}" Classes.direct="{Binding TalksDirect}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" />
                      <views:AvatarView Grid.Column="1" Of="{Binding Avatar}" Size="18" VerticalAlignment="Center" Margin="0 0 6 0" />
                      <TextBlock Grid.Column="2" Classes="person" Classes.me="{Binding IsMe}" Text="{Binding Text}" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" Margin="6 0 0 0">
                        <Path IsVisible="{Binding IsPriority}" Data="M1 4.2 V7.8 H3 L8.5 10.8 V1.2 L3 4.2 Z M3.2 8 L4.2 11 H5.8 L5 8.6 M9.8 4 A2.4 2.4 0 0 1 9.8 8" Fill="#44A3F2" Stroke="#44A3F2" StrokeThickness="0.8" Width="12" Height="12" ToolTip.Tip="{x:Static loc:MumbleText.PrioritySpeaker}" />
                        <Path IsVisible="{Binding IsLocalMuted}" Data="M1.5 4.5h2l3-3v9l-3-3h-2zM8.5 4.5l3 3M11.5 4.5l-3 3" Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.1" Width="12" Height="12" VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:MumbleText.LocalMute}" />
                        <Path Classes="state" IsVisible="{Binding IsMuted}" Data="M6 1a2 2 0 0 0-2 2v3a2 2 0 0 0 4 0V3a2 2 0 0 0-2-2zM3 6a3 3 0 0 0 6 0M6 9v2M4 11h4M1.5 1.5l9 9" ToolTip.Tip="{x:Static loc:MumbleText.FlagMuted}" />
                        <Path Classes="state" IsVisible="{Binding IsDeaf}" Data="M2 7V6a4 4 0 0 1 8 0v1M2 7v2a1 1 0 0 0 2 0V7a1 1 0 0 0-2 0zM10 7v2a1 1 0 0 1-2 0V7a1 1 0 0 1 2 0zM1.5 1.5l9 9" ToolTip.Tip="{x:Static loc:MumbleText.FlagDeaf}" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="2" IsVisible="{Binding NoneFound}" Text="{x:Static loc:MumbleText.NobodyFound}" FontSize="11" Margin="4 4" Foreground="{DynamicResource TextFaintBrush}" />
          <!-- What the server said no to: what is done from here has to be answered here. -->
          <TextBlock Grid.Row="3" DataContext="{Binding Owner}" x:DataType="vm:MumbleViewModel" IsVisible="{Binding HasStatus}" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11" Margin="0 6 0 0" Foreground="{DynamicResource WarnBrush}" />
          </Grid>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- On the always-on-top window: this client's name, lit as it talks. -->
    <StackPanel x:Name="Who" Orientation="Horizontal" Spacing="2">
      <Ellipse Classes="talker" Classes.channel="{Binding Me.TalksChannel}" Classes.shout="{Binding Me.TalksShout}" Classes.direct="{Binding Me.TalksDirect}" Width="8" Height="8" VerticalAlignment="Center" Margin="2 0" />
      <TextBlock Classes="talker" Classes.channel="{Binding Me.TalksChannel}" Classes.shout="{Binding Me.TalksShout}" Classes.direct="{Binding Me.TalksDirect}" Text="{Binding Me.Name}" FontSize="13" VerticalAlignment="Center" Margin="0 0 4 0" />
    </StackPanel>

    <!-- On the toolbar: where this client is, and how many there can hear. -->
    <StackPanel x:Name="Where" IsVisible="False" Orientation="Horizontal" Spacing="5" Margin="2 0 4 0" Background="Transparent"
                ToolTip.Tip="{Binding StatusTip}" ToolTip.Placement="Bottom">
      <TextBlock Text="{Binding Server}" FontSize="11" MaxWidth="110" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" />
      <TextBlock Text="{Binding Channel}" FontSize="11" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
      <Path Data="M4 3.5 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0 z M1.5 12 v-1 a3.5 3.5 0 0 1 3.5 -3.5 h3 a3.5 3.5 0 0 1 3.5 3.5 v1 z"
            Fill="{DynamicResource TextDimBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Listening}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
    </StackPanel>

    <Button Classes="icon mute" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="{x:Static loc:MumbleText.Mute}">
      <Path Classes="state" Classes.off="{Binding !Me.IsMuted}" Data="M6 1a2 2 0 0 0-2 2v3a2 2 0 0 0 4 0V3a2 2 0 0 0-2-2zM3 6a3 3 0 0 0 6 0M6 9v2M4 11h4M1.5 1.5l9 9" />
    </Button>
    <Button Classes="icon deaf" Command="{Binding ToggleDeafenCommand}" ToolTip.Tip="{x:Static loc:MumbleText.Deafen}">
      <Path Classes="state" Classes.off="{Binding !Me.IsDeaf}" Data="M2 7V6a4 4 0 0 1 8 0v1M2 7v2a1 1 0 0 0 2 0V7a1 1 0 0 0-2 0zM10 7v2a1 1 0 0 1-2 0V7a1 1 0 0 1 2 0zM1.5 1.5l9 9" />
    </Button>

    <Button Classes="icon gear" ToolTip.Tip="{x:Static loc:MumbleText.AudioSettings}">
      <Path Classes="menu" Data="M6 4.2a1.8 1.8 0 1 0 0 3.6a1.8 1.8 0 0 0 0-3.6zM5.2 1h1.6l.3 1.5 1 .4 1.3-.8 1.1 1.1-.8 1.3.4 1 1.5.3v1.6l-1.5.3-.4 1-.8 1.3-1.1 1.1-1.3-.8-1 .4-.3 1.5H5.2l-.3-1.5-1-.4-1.3.8-1.1-1.1.8-1.3-.4-1L.4 6.8V5.2l1.5-.3.4-1-.8-1.3 1.1-1.1 1.3.8 1-.4z" />
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="mumblepopup" Opening="OnSoundOpening">
          <StackPanel Width="260" Spacing="1" DataContext="{Binding Owner}" x:DataType="vm:MumbleViewModel">
            <TextBlock Classes="label" Margin="0 0 0 2" Text="{x:Static loc:MumbleText.Microphone}" />
            <ComboBox Classes="small" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding InputChoice}" />
            <TextBlock Classes="label" Text="{x:Static loc:MumbleText.MicVolume}" />
            <Slider Minimum="0" Maximum="300" Value="{Binding MicGain}" />
            <TextBlock Classes="label" Text="{x:Static loc:MumbleText.Speakers}" />
            <ComboBox Classes="small" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding OutputChoice}" />
            <TextBlock Classes="label" Text="{x:Static loc:MumbleText.SpeakerVolume}" />
            <Slider Minimum="0" Maximum="200" Value="{Binding SpeakerVolume}" />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </StackPanel>
</UserControl>
