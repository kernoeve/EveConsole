<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:agent="clr-namespace:EveConsole.Agent"
             xmlns:views="clr-namespace:EveConsole.Views"
             x:Class="EveConsole.Views.AgentPanel"
             x:DataType="vm:AgentPanelViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">
  <!-- No fixed width: the dock in MainWindow sizes this, and the capsuleer drags its edge. -->

  <UserControl.Resources>
    <views:MessageRoleAlignmentConverter  x:Key="RoleAlignment"/>
    <views:MessageRoleBackgroundConverter x:Key="RoleBg"/>
    <views:IsSummaryBorderConverter       x:Key="SummaryBorder"/>
    <views:IsSummaryForegroundConverter   x:Key="SummaryFg"/>
    <views:WidthLessConverter             x:Key="LessBy"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- ── Header ──────────────────────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBaseBrush}"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}"
            BorderThickness="0 0 0 1"
            Padding="14 9">
      <Grid ColumnDefinitions="*,Auto">

        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding AgentNameUpper}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontSize="14"
                     FontWeight="Bold"
                     LetterSpacing="4"/>
          <TextBlock Text="AI Companion"
                     Foreground="{DynamicResource TextFaintBrush}"
                     FontSize="9"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

          <!-- TTS mute + volume — visible only when a TTS provider is configured -->
          <StackPanel Orientation="Horizontal" Spacing="4"
                      IsVisible="{Binding HasTts}"
                      VerticalAlignment="Center">
            <!-- Mute toggle: filled gold diamond = active, hollow gray = muted -->
            <Button Background="Transparent"
                    BorderThickness="0"
                    FontSize="11"
                    Padding="5 2"
                    ToolTip.Tip="{Binding AgentName, StringFormat='Mute / unmute {0} voice'}"
                    Click="OnMuteClick">
              <Panel>
                <TextBlock Text="♦" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding !IsMuted}" />
                <TextBlock Text="◇" Foreground="{DynamicResource InfoBrush}" IsVisible="{Binding IsMuted}"  />
              </Panel>
            </Button>
            <Slider Value="{Binding Volume}"
                    Minimum="0" Maximum="1"
                    Width="64"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Voice volume (independent of system volume)" />
          </StackPanel>

          <Button Content="⌫"
                  ToolTip.Tip="Clear conversation"
                  Background="Transparent"
                  Foreground="{DynamicResource InfoBrush}"
                  BorderThickness="0"
                  FontSize="13"
                  Padding="6 2"
                  Click="OnClearClick"/>
          <Button Content="✕"
                  ToolTip.Tip="Close panel"
                  Background="Transparent"
                  Foreground="{DynamicResource InfoBrush}"
                  BorderThickness="0"
                  FontSize="13"
                  Padding="6 2"
                  Click="OnCloseClick"/>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ── Message list ─────────────────────────────────────────────────────── -->
    <ScrollViewer Grid.Row="1"
                  x:Name="MessageScroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="MessageStack" Margin="0 6 0 6">

        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="agent:AgentMessage">
              <StackPanel>

                <!-- Summary separator label -->
                <TextBlock IsVisible="{Binding IsSummary}"
                           Text="— earlier context summarized —"
                           Foreground="{DynamicResource GoodBrush}"
                           FontSize="9"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           Margin="0 6 0 2"/>

                <!-- When it was said, on the same side as the bubble — and for the agent's replies,
                     how many tools the turn called and which. The zero is the point: an answer
                     full of figures that called nothing did not read the database. -->
                <TextBlock Text="{Binding MetaText}"
                           IsVisible="{Binding !IsSummary}"
                           FontSize="9" Foreground="{DynamicResource TextFaintBrush}"
                           HorizontalAlignment="{Binding Role, Converter={StaticResource RoleAlignment}}"
                           Margin="16 5 16 0"/>

                <Border Margin="10 3"
                        Padding="10 7"
                        CornerRadius="8"
                        MaxWidth="{Binding $parent[views:AgentPanel].Bounds, Converter={StaticResource LessBy}, ConverterParameter=70}"
                        HorizontalAlignment="{Binding Role, Converter={StaticResource RoleAlignment}}"
                        Background="{Binding Role, Converter={StaticResource RoleBg}}"
                        BorderBrush="{Binding IsSummary, Converter={StaticResource SummaryBorder}}"
                        BorderThickness="1">
                  <!-- Selectable, so a figure or a name the agent produced can be copied out
                       rather than retyped. -->
                  <SelectableTextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding IsSummary, Converter={StaticResource SummaryFg}}"
                                       FontSize="11"
                                       LineHeight="17"/>
                </Border>

              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- In-progress streaming bubble -->
        <Border IsVisible="{Binding StreamingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Margin="10 3"
                Padding="10 7"
                CornerRadius="8"
                MaxWidth="{Binding $parent[views:AgentPanel].Bounds, Converter={StaticResource LessBy}, ConverterParameter=70}"
                HorizontalAlignment="Left"
                Background="{DynamicResource SurfaceInputBrush}">
          <SelectableTextBlock Text="{Binding StreamingText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11"
                               LineHeight="17"/>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ── Status / error banners ──────────────────────────────────────────── -->
    <StackPanel Grid.Row="2">

      <Border IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Background="{DynamicResource SurfaceBaseBrush}"
              BorderBrush="{DynamicResource GoodSurfaceBrush}"
              BorderThickness="0 1 0 0"
              Padding="10 5">
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource GoodBrush}"
                   FontSize="10"
                   FontStyle="Italic"/>
      </Border>

      <Border IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Background="{DynamicResource BadSurfaceBrush}"
              BorderBrush="{DynamicResource BadSurfaceBrush}"
              BorderThickness="0 1 0 0"
              Padding="10 6">
        <TextBlock Text="{Binding ErrorText}"
                   Foreground="{DynamicResource BadBrush}"
                   FontSize="10"
                   TextWrapping="Wrap"/>
      </Border>

    </StackPanel>

    <!-- ── Input area ───────────────────────────────────────────────────────── -->
    <Border Grid.Row="3"
            Background="{DynamicResource SurfaceBaseBrush}"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}"
            BorderThickness="0 1 0 0"
            Padding="8">
      <Grid ColumnDefinitions="*,Auto,Auto">

        <TextBox x:Name="InputBox"
                 Grid.Column="0"
                 Text="{Binding Input}"
                 Watermark="{Binding AskWatermark}"
                 AcceptsReturn="False"
                 Background="{DynamicResource SurfaceInputBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                 BorderThickness="1"
                 CornerRadius="6"
                 FontSize="11"
                 Padding="8 6"
                 IsEnabled="{Binding !IsBusy}"
                 KeyDown="OnInputKeyDown"/>

        <!-- Mic button — click to start recording, click again to stop + transcribe -->
        <Button x:Name="MicButton"
                Grid.Column="1"
                Margin="6 0 0 0"
                Background="{DynamicResource SurfacePanelBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}"
                BorderThickness="1"
                CornerRadius="6"
                FontSize="13"
                Padding="8 5"
                IsEnabled="{Binding !IsBusy}"
                IsVisible="{Binding HasSpeechInput}"
                Click="OnMicClick"
                ToolTip.Tip="Click to start recording; click again to transcribe. Or hold the global hotkey.">
          <Panel>
            <TextBlock Text="🎙" IsVisible="{Binding !IsRecording}" />
            <TextBlock Text="⏹" Foreground="{DynamicResource BadBrush}" IsVisible="{Binding IsRecording}" />
          </Panel>
        </Button>

        <Button Grid.Column="2"
                Content="▶"
                Margin="6 0 0 0"
                Background="{DynamicResource SurfacePanelBrush}"
                Foreground="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentSurfaceBrush}"
                BorderThickness="1"
                CornerRadius="6"
                FontSize="14"
                Padding="10 5"
                IsEnabled="{Binding !IsBusy}"
                Click="OnSendClick"/>

      </Grid>
    </Border>

  </Grid>
</UserControl>
