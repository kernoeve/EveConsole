<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveConsole.Views"
        x:Class="EveConsole.Views.ToolHostWindow"
        Width="1200" Height="760"
        MinWidth="640" MinHeight="420"
        Background="{DynamicResource SurfaceBaseBrush}">
  <!-- A window of tabs dragged out of the main window: its own strips, and a split of its own.
       ⚠️ The window's DataContext stays the main view model — each tab's close button reaches
       CloseTabCommand through it — and the tabs are the inner view's. -->
  <views:WorkspaceView x:Name="Tabs" />
</Window>
