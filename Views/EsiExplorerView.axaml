<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveCortex.ViewModels"
             x:Class="EveCortex.Views.EsiExplorerView"
             x:DataType="vm:EsiExplorerViewModel"
             Background="#0d0d12">

  <Grid ColumnDefinitions="220,Auto,*">

    <!-- ── Left sidebar ──────────────────────────────────────────────── -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*" Background="#111117">

      <Border Grid.Row="0" Background="#161620" Padding="10 8">
        <TextBlock Text="ESI Tables"
                   FontSize="12" FontWeight="SemiBold" Foreground="#c8a84b" />
      </Border>

      <ListBox x:Name="TableList"
               Grid.Row="1"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="Padding"    Value="10 5" />
            <Setter Property="Foreground" Value="#a0a0b0" />
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^:selected">
              <Setter Property="Background" Value="#1c1c2a" />
              <Setter Property="Foreground" Value="#c8a84b" />
            </Style>
            <Style Selector="^:pointerover:not(:selected)">
              <Setter Property="Background" Value="#16161e" />
              <Setter Property="Foreground" Value="#c8c8cc" />
            </Style>
          </ControlTheme>
        </ListBox.ItemContainerTheme>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:TableEntry">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ListBox.ItemTemplate>

      </ListBox>
    </Grid>

    <!-- Divider -->
    <Border Grid.Column="1" Width="1" Background="#252530" />

    <!-- ── Right panel ────────────────────────────────────────────────── -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

      <!-- Filter bar -->
      <Border Grid.Row="0" Background="#0d0d12" Padding="8 6"
              BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
        <Grid ColumnDefinitions="*,Auto">

          <StackPanel x:Name="FilterRowsPanel"
                      Grid.Column="0"
                      Orientation="Vertical"
                      Spacing="4"
                      VerticalAlignment="Center" />

          <StackPanel Grid.Column="1"
                      Orientation="Vertical"
                      Spacing="4"
                      Margin="8 0 0 0"
                      VerticalAlignment="Top">
            <Button Content="Apply"
                    Click="OnApplyFilterClick"
                    HorizontalAlignment="Stretch"
                    Padding="12 3"
                    Background="#1e1e28"
                    Foreground="#c8a84b"
                    BorderThickness="1"
                    BorderBrush="#3a3020"
                    FontSize="11" />
            <Button Content="Clear"
                    Click="OnClearFilterClick"
                    HorizontalAlignment="Stretch"
                    Padding="12 3"
                    FontSize="11" />
            <Button x:Name="AddFilterButton"
                    Content="+ Filter"
                    Click="OnAddFilterClick"
                    HorizontalAlignment="Stretch"
                    Padding="12 3"
                    Foreground="#5588aa"
                    FontSize="11" />
          </StackPanel>
        </Grid>
      </Border>

      <DataGrid x:Name="EsiGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                RowHeight="24"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                Sorting="OnGridSorting"
                KeyDown="OnGridKeyDown" />

      <!-- Status bar -->
      <Border Grid.Row="2" Background="#111117" Padding="12 6">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Content="Load More"
                  IsVisible="{Binding HasMore}"
                  Click="OnLoadMoreClick"
                  Padding="14 4"
                  Background="#1e1e28"
                  Foreground="#c8a84b"
                  BorderBrush="#3a3020"
                  Margin="8 0 0 0"
                  FontSize="11" />
          <TextBlock Text="{Binding StatusText}"
                     Foreground="#555566"
                     FontSize="11"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>

    </Grid>
  </Grid>

</UserControl>
