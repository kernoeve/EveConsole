<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.EsiExplorerView"
             x:DataType="vm:EsiExplorerViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <Grid ColumnDefinitions="220,Auto,*">

    <!-- ── Left sidebar ──────────────────────────────────────────────── -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*" Background="{DynamicResource SurfaceInputBrush}">

      <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBrush}" Padding="10 8">
        <TextBlock Text="{x:Static loc:DataText.EsiTables}"
                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
      </Border>

      <ListBox x:Name="TableList"
               Grid.Row="1"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="Padding"    Value="10 5" />
            <Setter Property="Foreground" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^:selected">
              <Setter Property="Background" Value="{DynamicResource SurfacePanelAltBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Style>
            <Style Selector="^:pointerover:not(:selected)">
              <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
          </ControlTheme>
        </ListBox.ItemContainerTheme>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:TableEntry">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ListBox.ItemTemplate>

      </ListBox>
    </Grid>

    <!-- Divider -->
    <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderDefaultBrush}" />

    <!-- ── Right panel ────────────────────────────────────────────────── -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

      <!-- Filter bar -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="8 6"
              BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
        <Grid ColumnDefinitions="*,Auto">

          <StackPanel x:Name="FilterRowsPanel"
                      Grid.Column="0"
                      Orientation="Vertical"
                      Spacing="4"
                      VerticalAlignment="Center" />

          <StackPanel Grid.Column="1"
                      Orientation="Vertical"
                      Spacing="4"
                      Margin="8 0 0 0"
                      VerticalAlignment="Top">
            <Button Content="{x:Static loc:DataText.Apply}"
                    Click="OnApplyFilterClick"
                    HorizontalAlignment="Stretch"
                    Padding="12 3"
                    Background="{DynamicResource BorderSubtleBrush}"
                    Foreground="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AccentSurfaceBrush}"
                    FontSize="11" />
            <Button Content="{x:Static loc:DataText.Clear}"
                    Click="OnClearFilterClick"
                    HorizontalAlignment="Stretch"
                    Padding="12 3"
                    FontSize="11" />
            <Button x:Name="AddFilterButton"
                    Content="{x:Static loc:DataText.Filter}"
                    Click="OnAddFilterClick"
                    HorizontalAlignment="Stretch"
                    Padding="12 3"
                    Foreground="{DynamicResource InfoBrush}"
                    FontSize="11" />
          </StackPanel>
        </Grid>
      </Border>

      <DataGrid x:Name="EsiGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                RowHeight="24"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                ClipboardCopyMode="IncludeHeader"
                Sorting="OnGridSorting" />

      <!-- Status bar -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceInputBrush}" Padding="12 6">
        <DockPanel>
          <!-- The whole table as the filters and order leave it, not the rows loaded here. -->
          <Button DockPanel.Dock="Right"
                  Content="{Binding ExportButtonText}"
                  IsEnabled="{Binding HasTable}"
                  Click="OnExportCsvClick"
                  Padding="14 4"
                  Margin="8 0 0 0"
                  FontSize="11"
                  ToolTip.Tip="{x:Static loc:DataText.TipWriteEveryRowThat}" />
          <Button DockPanel.Dock="Right"
                  Content="{x:Static loc:DataText.LoadMore}"
                  IsVisible="{Binding HasMore}"
                  Click="OnLoadMoreClick"
                  Padding="14 4"
                  Background="{DynamicResource BorderSubtleBrush}"
                  Foreground="{DynamicResource AccentBrush}"
                  BorderBrush="{DynamicResource AccentSurfaceBrush}"
                  Margin="8 0 0 0"
                  FontSize="11" />
          <TextBlock Text="{Binding StatusText}"
                     Foreground="{DynamicResource TextFaintBrush}"
                     FontSize="11"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>

    </Grid>
  </Grid>

</UserControl>
