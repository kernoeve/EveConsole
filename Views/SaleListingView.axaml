<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.SaleListingView"
             x:DataType="vm:SaleListingViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" />
      <Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background"      Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding"         Value="0" />
      <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- ⚠️ No Foreground. A link in a cell keeps the colour its column already had; the cursor
         and the hover underline carry the affordance. Same rule as the killmail tool and the
         system page — recolouring every clickable name says nothing about which ones matter. -->
    <Style Selector="TextBlock.linktext">
      <Setter Property="FontSize"          Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Header -->
    <Border Grid.Row="0" Background="#0d0d12" Padding="10 6" BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#c8a84b"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#888899"
                   VerticalAlignment="Center" Margin="12 0 12 0" />
        <Button Grid.Column="2" Classes="link" Click="OnOpenSalesTracker" VerticalAlignment="Center">
          <TextBlock Text="Sales Tracker →" FontSize="11" Foreground="#5599dd" TextDecorations="Underline" />
        </Button>
      </Grid>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              Background="#0d0d12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Date / Time" Binding="{Binding WhenText}" SortMemberPath="WhenSort" Width="130" />
        <!-- Buyer and Item are links. The item cell links only the named type: on a contract it
             reads "Revelation +3 more items", and that tail stands for items this row carries no
             ids for, so linking the whole string would promise a page it cannot open. -->
        <DataGridTemplateColumn Header="Buyer" SortMemberPath="Buyer" Width="144">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleListingRowVm">
              <Panel>
                <Button Classes="link" Click="OnOpenBuyer" IsVisible="{Binding HasBuyerLink}"
                        HorizontalAlignment="Left" ToolTip.Tip="Open in the entity browser">
                  <TextBlock Text="{Binding Buyer}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Buyer}" IsVisible="{Binding !HasBuyerLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Item" SortMemberPath="Item" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleListingRowVm">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="link" Click="OnOpenItem" IsVisible="{Binding HasItemLink}"
                        HorizontalAlignment="Left" ToolTip.Tip="Open in the Item Browser">
                  <TextBlock Text="{Binding ItemName}" Classes="linktext" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding ItemName}" IsVisible="{Binding !HasItemLink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ItemExtra}" Foreground="#77778a" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Amount"      Binding="{Binding Amount}"   SortMemberPath="AmountRaw" Width="60" CellStyleClasses="num" />
        <!-- ⚠️ TextAlignment, not HorizontalAlignment. A template column's cell does not stretch
             its content the way a text column's does, so HorizontalAlignment="Right" had nothing
             to align against and these two read as left-aligned beside the Amount column. -->
        <DataGridTemplateColumn Header="Profit"   SortMemberPath="ProfitRaw"    Width="60">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleListingRowVm">
              <TextBlock Text="{Binding Profit}" Foreground="{Binding ProfitBrush}" FontSize="11"
                         HorizontalAlignment="Stretch" TextAlignment="Right"
                         Margin="0 0 8 0" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Profit %" SortMemberPath="ProfitPctRaw" Width="64">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleListingRowVm">
              <TextBlock Text="{Binding ProfitPct}" Foreground="{Binding ProfitBrush}" FontSize="11"
                         HorizontalAlignment="Stretch" TextAlignment="Right"
                         Margin="0 0 8 0" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
