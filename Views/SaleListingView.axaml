<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveCortex.ViewModels"
             x:Class="EveCortex.Views.SaleListingView"
             x:DataType="vm:SaleListingViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" />
      <Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="DataGridCell.num TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0 0 8 0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Header -->
    <Border Grid.Row="0" Background="#0d0d12" Padding="10 6" BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#c8a84b"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#888899"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              Background="#0d0d12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Date / Time" Binding="{Binding WhenText}" SortMemberPath="WhenSort" Width="130" />
        <DataGridTextColumn Header="Buyer"       Binding="{Binding Buyer}"    Width="144" />
        <DataGridTextColumn Header="Item"        Binding="{Binding Item}"     Width="*" />
        <DataGridTextColumn Header="Amount"      Binding="{Binding Amount}"   SortMemberPath="AmountRaw" Width="60" CellStyleClasses="num" />
        <DataGridTemplateColumn Header="Profit"   SortMemberPath="ProfitRaw"    Width="60">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleListingRowVm">
              <TextBlock Text="{Binding Profit}" Foreground="{Binding ProfitBrush}" FontSize="11"
                         HorizontalAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Profit %" SortMemberPath="ProfitPctRaw" Width="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SaleListingRowVm">
              <TextBlock Text="{Binding ProfitPct}" Foreground="{Binding ProfitBrush}" FontSize="11"
                         HorizontalAlignment="Right" Margin="0 0 8 0" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
