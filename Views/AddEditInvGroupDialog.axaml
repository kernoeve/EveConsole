<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        x:Class="EveConsole.Views.AddEditInvGroupDialog"
        Title="{x:Static loc:AssetsText.TitleGroup}"
        Width="460" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="*,Auto" Margin="20">

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <!-- Group Name -->
        <StackPanel Spacing="5">
          <TextBlock Text="{x:Static loc:AssetsText.GroupNameLabel}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <TextBox x:Name="NameBox"
                   Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                   CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                   FontSize="13" Padding="8 5" />
        </StackPanel>

        <!-- Collection -->
        <StackPanel Spacing="5">
          <TextBlock Text="{x:Static loc:AssetsText.CollectionLabel}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <ComboBox x:Name="CollectionBox"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="12" HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Scope -->
        <StackPanel Spacing="5">
          <TextBlock Text="{x:Static loc:AssetsText.ScopeLabel}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <WrapPanel>
            <RadioButton x:Name="ScopeStation"    Content="{x:Static loc:AssetsText.Station}"    GroupName="Scope"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 16 4" />
            <RadioButton x:Name="ScopeSystem"     Content="{x:Static loc:AssetsText.System}"     GroupName="Scope"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 16 4" />
            <RadioButton x:Name="ScopeRegion"     Content="{x:Static loc:AssetsText.Region}"     GroupName="Scope"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 16 4" />
            <RadioButton x:Name="ScopeEverywhere" Content="{x:Static loc:AssetsText.Everywhere}" GroupName="Scope"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" IsChecked="True" />
          </WrapPanel>
        </StackPanel>

        <!-- Location picker (hidden for Everywhere) -->
        <StackPanel x:Name="LocationPanel" Spacing="5" IsVisible="False">
          <TextBlock x:Name="LocationLabel"
                     Text="{x:Static loc:AssetsText.LocationLabel}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <TextBox x:Name="LocationSearchBox"
                   Watermark="{x:Static loc:AssetsText.HintTypeToSearch}"
                   Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                   CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                   FontSize="12" Padding="8 5" />
          <Border x:Name="LocationResultsBorder"
                  Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  CornerRadius="3" MaxHeight="120" IsVisible="False">
            <ListBox x:Name="LocationListBox"
                     Background="Transparent" BorderThickness="0"
                     FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- A system's region beside it, as every system picker shows it. -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Region}" FontSize="10" Margin="10 0 0 0"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <TextBlock x:Name="SelectedLocationText"
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <!-- Include -->
        <StackPanel Spacing="5">
          <TextBlock Text="{x:Static loc:AssetsText.IncludeLabel}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <CheckBox x:Name="IncludeAssetsBox"
                    Content="{x:Static loc:AssetsText.Assets}" IsChecked="True"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="IncludeJobsBox"
                    Content="{x:Static loc:AssetsText.IndustryJobsProducts}"
                    IsChecked="True"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="IncludeBuyOrdersBox"
                    Content="{x:Static loc:AssetsText.MarketBuyOrders}"
                    IsChecked="True"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="IncludeContractsBox"
                    Content="{x:Static loc:AssetsText.ContractsBuying}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="IncludeSellOrdersBox"
                    Content="{x:Static loc:AssetsText.MarketSellOrders}"
                    ToolTip.Tip="{x:Static loc:AssetsText.TipMarketSellOrders}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="IncludeContractsSellingBox"
                    Content="{x:Static loc:AssetsText.ContractsSelling}"
                    ToolTip.Tip="{x:Static loc:AssetsText.TipContractsSelling}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="PackagedOnlyBox"
                    Content="{x:Static loc:AssetsText.OnlyCountPackagedItems}"
                    ToolTip.Tip="{x:Static loc:AssetsText.TipBlueprintsAreNeverFiltered}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
        </StackPanel>

        <!-- Multiplier -->
        <StackPanel Spacing="5">
          <TextBlock Text="{x:Static loc:AssetsText.MultiplierLabel}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <NumericUpDown x:Name="MultiplierBox"
                           Value="1" Minimum="1" Maximum="9999"
                           Increment="1" ShowButtonSpinner="True"
                           Width="120" FontSize="12"
                           Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{x:Static loc:AssetsText.TargetQuantitiesForAllItems}"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Buttons -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0 16 0 0">
      <TextBlock Grid.Column="0" x:Name="ErrorText"
                 Foreground="{DynamicResource BadBrush}" FontSize="11"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{x:Static loc:AssetsText.Cancel}"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              Padding="14 6" Margin="0 0 8 0"
              Click="OnCancelClick" />
      <Button Grid.Column="2" Content="{x:Static loc:AssetsText.Ok}"
              Background="{DynamicResource SurfaceSelectedBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
              Padding="14 6"
              Click="OnOkClick" />
    </Grid>

  </Grid>
</Window>
