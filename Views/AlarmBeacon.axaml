<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             x:Class="EveConsole.Views.AlarmBeacon"
             x:DataType="vm:MainWindowViewModel">

  <!-- The alarm light, for the main window's bar and for panels. Lit while anything is armed, with
       the count of armed alarms in the corner. Drawn rather than set as a glyph so the colour is
       ours to control. -->
  <Grid Width="29" Height="22">
    <!-- A beacon: dome on a stacked base, with light thrown off it while armed.
         Drawn on a 24x22 canvas so the pieces line up at any size. -->
    <Canvas Width="24" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">

      <!-- Light rays. Only present when something is actually armed. -->
      <Canvas IsVisible="{Binding HasActiveAlarms}">
        <Path Data="M 12,7.2 L 12,3.0"     Stroke="{Binding AlarmLightRing}" StrokeThickness="1.7" StrokeLineCap="Round" />
        <Path Data="M 7.4,8.9 L 4.4,5.6"   Stroke="{Binding AlarmLightRing}" StrokeThickness="1.5" StrokeLineCap="Round" />
        <Path Data="M 16.6,8.9 L 19.6,5.6" Stroke="{Binding AlarmLightRing}" StrokeThickness="1.5" StrokeLineCap="Round" />
        <Path Data="M 5.2,13.4 L 1.2,12.6" Stroke="{Binding AlarmLightRing}" StrokeThickness="1.5" StrokeLineCap="Round" />
        <Path Data="M 18.8,13.4 L 22.8,12.6" Stroke="{Binding AlarmLightRing}" StrokeThickness="1.5" StrokeLineCap="Round" />
      </Canvas>

      <!-- Dome -->
      <Path Data="M 6,16.2 A 6,6 0 0 1 18,16.2 Z" Fill="{Binding AlarmLightColor}" />

      <!-- Glass highlight, the curved gleam on the left of the dome -->
      <Path Data="M 8.7,15.4 A 4.3,4.3 0 0 1 10.9,11.5"
            Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.3" StrokeLineCap="Round"
            Opacity="{Binding AlarmGleamOpacity}" />

      <!-- Housing: two stacked tiers, the lower one wider -->
      <Rectangle Canvas.Left="4.6" Canvas.Top="16.2" Width="14.8" Height="2.5"
                 RadiusX="0.7" RadiusY="0.7" Fill="{DynamicResource SurfaceHeaderBrush}" />
      <Rectangle Canvas.Left="3.0" Canvas.Top="18.7" Width="18.0" Height="2.7"
                 RadiusX="0.9" RadiusY="0.9" Fill="{DynamicResource SurfaceHeaderBrush}" />

      <!-- ⚠️ Struck through while this machine is muted, and drawn last so it lies over
           the beacon. Muting has to be visible from across the room: a client silenced
           since Tuesday otherwise looks exactly like one with nothing to report, and the
           beacon goes on being lit either way because the alarms really are armed.
           Backed by a dark stroke so it reads against the lit dome as well as the housing. -->
      <Path Data="M 3.4,20.2 L 20.6,3.4" IsVisible="{Binding AlarmsMuted}"
            Stroke="{DynamicResource SurfacePanelBrush}" StrokeThickness="3.6" StrokeLineCap="Round" />
      <Path Data="M 3.4,20.2 L 20.6,3.4" IsVisible="{Binding AlarmsMuted}"
            Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.8" StrokeLineCap="Round" />
    </Canvas>

    <Border IsVisible="{Binding HasActiveAlarms}"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Background="{DynamicResource SurfacePanelBrush}" CornerRadius="6"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            MinWidth="12" Height="12" Padding="2 0">
      <TextBlock Text="{Binding ActiveAlarmCount}"
                 FontSize="8" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
