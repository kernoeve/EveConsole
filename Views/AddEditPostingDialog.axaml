<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:EveConsole.Controls"
        x:Class="EveConsole.Views.AddEditPostingDialog"
        Title="Posting"
        Width="560" Height="720"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Grid RowDefinitions="*,Auto" Margin="20">

    <!-- ⚠️ The right margin is the scrollbar's lane. Avalonia's scrollbar is an overlay drawn on
         top of the content rather than beside it, so without this the rightmost control on every
         row sits underneath it — which is where the colour swatches ended up. -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16" Margin="0 0 14 0">

        <!-- Posting Name -->
        <StackPanel Spacing="5">
          <TextBlock Text="POSTING NAME" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <TextBox x:Name="NameBox"
                   Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                   CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                   FontSize="13" Padding="8 5" />
        </StackPanel>

        <!-- Inventory Scope -->
        <StackPanel Spacing="5">
          <TextBlock Text="INVENTORY SCOPE (In Stock / In Build)" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <WrapPanel>
            <RadioButton x:Name="ScopeStation"    Content="Station"    GroupName="Scope"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 16 4" />
            <RadioButton x:Name="ScopeSystem"     Content="System"     GroupName="Scope"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 16 4" />
            <RadioButton x:Name="ScopeRegion"     Content="Region"     GroupName="Scope"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 16 4" />
            <RadioButton x:Name="ScopeEverywhere" Content="Everywhere" GroupName="Scope"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" IsChecked="True" />
          </WrapPanel>
        </StackPanel>

        <!-- Location picker (hidden for Everywhere) -->
        <StackPanel x:Name="LocationPanel" Spacing="5" IsVisible="False">
          <TextBlock x:Name="LocationLabel" Text="LOCATION" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <TextBox x:Name="LocationSearchBox" Watermark="Type to search…"
                   Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                   CornerRadius="3" Foreground="{DynamicResource TextBrightBrush}" CaretBrush="{DynamicResource AccentBrush}"
                   FontSize="12" Padding="8 5" />
          <Border x:Name="LocationResultsBorder"
                  Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  CornerRadius="3" MaxHeight="120" IsVisible="False">
            <ListBox x:Name="LocationListBox" Background="Transparent" BorderThickness="0"
                     FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
          </Border>
          <TextBlock x:Name="SelectedLocationText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" />

        <!-- Pricing basis -->
        <StackPanel Spacing="5">
          <TextBlock Text="SALE PRICE BASIS" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <WrapPanel>
            <RadioButton x:Name="BasisBuild"    Content="Build Cost"      GroupName="Basis"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 16 4" IsChecked="True" />
            <RadioButton x:Name="BasisContract" Content="Contract Cost"   GroupName="Basis"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 0 16 4" />
            <RadioButton x:Name="BasisMarket"   Content="Specific Market" GroupName="Basis"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          </WrapPanel>
        </StackPanel>

        <!-- Market station + price type (Specific Market only) -->
        <StackPanel x:Name="MarketPanel" Spacing="5" IsVisible="False">
          <TextBlock Text="MARKET (current orders — same list as Trade Opportunities)"
                     FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <ComboBox x:Name="MarketStationBox"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="12" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock x:Name="NoStationsText"
                     Text="No polled markets yet — add a Market config under Market Overview first."
                     FontSize="11" Foreground="{DynamicResource TextFaintBrush}" IsVisible="False" TextWrapping="Wrap" />
          <TextBlock Text="PRICE TYPE" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" Margin="0 6 0 0" />
          <ComboBox x:Name="PriceTypeBox"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="12" HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Percent -->
        <StackPanel Spacing="5">
          <TextBlock Text="SALE PRICE = BASIS ×  %" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <NumericUpDown x:Name="PercentBox"
                           Value="110" Minimum="0" Maximum="100000"
                           Increment="5" ShowButtonSpinner="True"
                           Width="120" FontSize="12"
                           Background="{DynamicResource SurfacePanelAltBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="%  (Build defaults 110%, Contract/Market 100%)"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" />

        <!-- Show quantities -->
        <StackPanel Spacing="5">
          <TextBlock Text="SHOW QUANTITIES IN POSTING" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <CheckBox x:Name="ShowInStockBox"  Content="In Stock"  IsChecked="True"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="ShowInBuildBox"  Content="In Build"  IsChecked="True"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="ShowReservedBox" Content="Reserved"  IsChecked="True"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <CheckBox x:Name="IncludeCompletionBox"
                    Content="Include earliest job completion date (when In Stock = 0 and In Build ≥ 1)"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 4 0 0" />
          <CheckBox x:Name="OnlyPackagedBox"
                    Content="Only include packaged items (skip assembled / fitted hulls)"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0 4 0 0" />
        </StackPanel>

        <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" />

        <!-- Colour by state (EVE mail only) -->
        <StackPanel Spacing="6">
          <TextBlock Text="COLOUR  (EVE mail only — other formats ignore it)" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
          <CheckBox x:Name="ColorByStateBox"
                    Content="Colour each item line by whether it is in stock, in build, or neither"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
          <!-- ⚠️ Label above field, not beside it. Three colour fields on one line need three
               hex boxes at their 92px floor, three swatch buttons and three labels — about forty
               pixels more than the dialog has, so the row overflowed and the labels drew over the
               fields beside them, clipping the leading "#". Stacking gives each cell a third of
               the width, which is more than any of them needs. -->
          <Grid ColumnDefinitions="*,*,*" Margin="0 2 0 0">
            <StackPanel Grid.Column="0" Spacing="3" Margin="0 0 5 0">
              <TextBlock Text="IN STOCK" FontSize="9" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
              <controls:ColorField x:Name="ColorInStockField" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3" Margin="5 0 5 0">
              <TextBlock Text="IN BUILD" FontSize="9" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
              <controls:ColorField x:Name="ColorInBuildField" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="3" Margin="5 0 0 0">
              <TextBlock Text="NEITHER" FontSize="9" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
              <controls:ColorField x:Name="ColorNoneField" />
            </StackPanel>
          </Grid>
          <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                     Text="A colour set on an item beats this; a section's colour applies where neither is set. In header, footer and static text, write [color=#rrggbb]text[/color] — every other format strips it." />
        </StackPanel>

        <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" />

        <!-- Post blocks -->
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="POST BLOCKS  (first = parent; rest = thread detail)"
                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="+ Add Post" Command="{Binding AddPostCommand}"
                    Background="{DynamicResource SurfaceBaseBrush}" Foreground="{DynamicResource GoodBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    Padding="8 3" FontSize="11" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Posts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="6" Margin="0 0 0 6">
                  <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ComboBox ItemsSource="{Binding PostTypeOptions}"
                                SelectedItem="{Binding PostType, Mode=TwoWay}" Width="100" FontSize="12"
                                Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" />
                      <TextBox Text="{Binding Name}" Watermark="Name" Width="210" FontSize="12"
                               Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextBrightBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="6 3" />
                      <Button Content="▲" ToolTip.Tip="Move up"
                              Command="{Binding $parent[Window].DataContext.MoveUpCommand}" CommandParameter="{Binding}"
                              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                              Padding="7 2" FontSize="10" />
                      <Button Content="▼" ToolTip.Tip="Move down"
                              Command="{Binding $parent[Window].DataContext.MoveDownCommand}" CommandParameter="{Binding}"
                              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                              Padding="7 2" FontSize="10" />
                      <Button Content="✕" ToolTip.Tip="Delete"
                              Command="{Binding $parent[Window].DataContext.DeletePostCommand}" CommandParameter="{Binding}"
                              Background="{DynamicResource BadSurfaceBrush}" Foreground="{DynamicResource BadBrush}" BorderBrush="{DynamicResource BadSurfaceBrush}" BorderThickness="1"
                              Padding="7 2" FontSize="10" />
                    </StackPanel>
                    <TextBox IsVisible="{Binding IsStatic}" Text="{Binding StaticContent}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="150"
                             Watermark="Static content…" FontSize="12"
                             Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextBrightBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="6 4" />
                    <TextBox IsVisible="{Binding ShowHeaderFooter}" Text="{Binding Header}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                             Watermark="Header — text before the content…" FontSize="12"
                             Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextBrightBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="6 4" />
                    <TextBox IsVisible="{Binding ShowHeaderFooter}" Text="{Binding Footer}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                             Watermark="Footer — text after the content…" FontSize="12"
                             Background="{DynamicResource SurfacePanelAltBrush}" Foreground="{DynamicResource TextBrightBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="6 4" />

                    <!-- One label, two meanings: on a Static block there is no header, so the
                         field colours the content instead — see HeaderColorLabel. -->
                    <Grid ColumnDefinitions="*,*" Margin="0 4 0 0">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0 0 4 0">
                        <TextBlock Text="{Binding HeaderColorLabel}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
                        <controls:ColorField Value="{Binding HeaderColor, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="3" Margin="4 0 0 0"
                                  IsVisible="{Binding ShowHeaderFooter}">
                        <TextBlock Text="FOOTER COLOUR" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFaintBrush}" LetterSpacing="1" />
                        <controls:ColorField Value="{Binding FooterColor, Mode=TwoWay}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Buttons -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0 16 0 0">
      <TextBlock Grid.Column="0" x:Name="ErrorText"
                 Foreground="{DynamicResource BadBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Cancel"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              Padding="14 6" Margin="0 0 8 0" Click="OnCancelClick" />
      <Button Grid.Column="2" Content="OK"
              Background="{DynamicResource SurfaceSelectedBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
              Padding="14 6" Click="OnOkClick" />
    </Grid>

  </Grid>
</Window>
