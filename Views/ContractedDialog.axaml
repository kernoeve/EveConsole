<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EveConsole.Localization"
        xmlns:vm="using:EveConsole.ViewModels"
        x:Class="EveConsole.Views.ContractedDialog"
        x:DataType="vm:ContractedCargoVm"
        Title="{x:Static loc:WorklistText.ContractedDialogTitle}"
        Width="620" Height="620" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <Window.Styles>
    <!-- Item names as links, the way the Contracts tool shows them. -->
    <Style Selector="Button.link">
      <Setter Property="Background"          Value="Transparent" />
      <Setter Property="BorderThickness"     Value="0" />
      <Setter Property="Padding"             Value="0" />
      <Setter Property="MinHeight"           Value="0" />
      <Setter Property="Cursor"              Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock.linktext">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Window.Styles>

  <!-- The cargo a hauling-service trip is ticked off with: the plan to start from, corrected to
       what went into the contract before anything is recorded. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="20">

    <TextBlock Grid.Row="0" Text="{Binding Route}" FontSize="12" FontWeight="SemiBold"
               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Text="{x:Static loc:WorklistText.ContractedDialogNote}" FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextDimBrush}" Margin="0 4 0 10" />

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="2">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ContractedLineVm">
              <Grid ColumnDefinitions="*,120,100,Auto" Margin="0 1 8 1">
                <Button Grid.Column="0" Classes="link" Click="OnOpenItem"
                        ToolTip.Tip="{x:Static loc:MarketText.TipOpenInTheItemBrowser}">
                  <TextBlock Text="{Binding TypeName}" Classes="linktext" FontSize="11" TextTrimming="CharacterEllipsis" />
                </Button>
                <NumericUpDown Grid.Column="1" Value="{Binding Quantity, Mode=TwoWay}" Minimum="0" Increment="1"
                               FormatString="N0" ShowButtonSpinner="False" FontSize="11" Margin="6 0"
                               ToolTip.Tip="{x:Static loc:MarketText.TipCourierCargoQuantity}" />
                <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="11" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                <Button Grid.Column="3" Content="✕" FontSize="10" Padding="6 1" Margin="8 0 0 0" Click="OnRemove"
                        ToolTip.Tip="{x:Static loc:MarketText.TipCourierCargoRemove}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Static loc:WorklistText.ContractedEmpty}" FontSize="11" IsVisible="{Binding !HasRows}"
                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Panel Grid.Row="3" Margin="0 8 0 0">
      <TextBlock Text="{Binding TotalsText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                 IsVisible="{Binding !IsOver}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding TotalsText}" FontSize="11" Foreground="{DynamicResource WarnBrush}"
                 IsVisible="{Binding IsOver}" TextWrapping="Wrap" />
    </Panel>

    <TextBox Grid.Row="4" Text="{Binding PasteText}" AcceptsReturn="True" TextWrapping="NoWrap" Height="90" FontSize="11"
             Margin="0 8 0 0" Watermark="{x:Static loc:MarketText.CourierCargoPasteHint}" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0 6 0 0">
      <Button Content="{x:Static loc:MarketText.CourierCargoAdd}" Command="{Binding AddPastedAsync}"
              FontSize="11" Padding="10 3" ToolTip.Tip="{x:Static loc:WorklistText.TipContractedAdd}" />
      <Button Content="{x:Static loc:MarketText.CourierCargoReplace}" Command="{Binding ReplacePastedAsync}"
              FontSize="11" Padding="10 3" ToolTip.Tip="{x:Static loc:WorklistText.TipContractedReplace}" />
      <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                 VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
    </StackPanel>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 14 0 0">
      <Button Content="{x:Static loc:CommonText.Cancel}"
              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              Padding="14 6" Click="OnCancel" />
      <Button Content="{x:Static loc:WorklistText.ContractedRecord}" IsEnabled="{Binding HasRows}"
              Background="{DynamicResource SurfaceSelectedBrush}" Foreground="{DynamicResource AccentBrush}"
              BorderBrush="{DynamicResource AccentSurfaceBrush}" BorderThickness="1"
              Padding="14 6" Click="OnRecord" />
    </StackPanel>
  </Grid>
</Window>
