<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="EveConsole.Views.GameLogViewerView"
             x:DataType="vm:GameLogViewerViewModel"
             Background="#0d0d12">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#12121a" />
      <Setter Property="Foreground" Value="#555566" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="TextBlock.fl">
      <Setter Property="Foreground" Value="#555566" /><Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#131320" /><Setter Property="BorderBrush" Value="#2a2a3a" />
      <Setter Property="Foreground" Value="#ccccdd" /><Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,2*,4,1*">

    <Border Grid.Row="0" Background="#0d0d12" Padding="10 6" BorderBrush="#1c1c28" BorderThickness="0 0 0 1">
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Game Log" FontSize="13" FontWeight="SemiBold" Foreground="#c8a84b"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#888899"
                     VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="fl" Text="From" />
          <TextBox Text="{Binding DateFrom}" Watermark="yyyy-MM-dd" Width="120" />
          <TextBlock Classes="fl" Text="Thru" />
          <TextBox Text="{Binding DateThru}" Watermark="(now)" Width="120" />
          <TextBlock Classes="fl" Text="Type" />
          <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                    Width="200" FontSize="11" MaxDropDownHeight="320" />
          <TextBlock Classes="fl" Text="Find" />
          <TextBox Text="{Binding Search}" Watermark="name or text…" Width="170" />
          <Button Command="{Binding RefreshCommand}" Content="Refresh" FontSize="10" Padding="8 2"
                  Background="#1a1a2a" Foreground="#888899" BorderBrush="#2a2a3a" BorderThickness="1"
                  VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              Background="#0d0d12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time"      Binding="{Binding Time}"      Width="145" />
        <DataGridTextColumn Header="Type"      Binding="{Binding Kind}"      Width="180" />
        <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="140" />
        <DataGridTextColumn Header="Amount"    Binding="{Binding Amount}"    Width="90"  />
        <DataGridTextColumn Header="Source"    Binding="{Binding Source}"    Width="180" />
        <DataGridTextColumn Header="Target"    Binding="{Binding Target}"    Width="180" />
        <DataGridTextColumn Header="Detail"    Binding="{Binding Summary}"   Width="*"   />
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" Background="#1e1e2a" />

    <Border Grid.Row="3" Background="#0b0b10" BorderBrush="#1e1e2a" BorderThickness="0 1 0 0">
      <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <SelectableTextBlock Text="{Binding Selected.Detail}" Margin="12 8" FontSize="12"
                               Foreground="#a0c8a0" FontFamily="Consolas, Menlo, monospace"
                               TextWrapping="Wrap" />
        </ScrollViewer>
        <TextBlock Text="Select an entry to view its full detail."
                   IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNull}}"
                   FontSize="12" Foreground="#444455"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </Border>

  </Grid>
</UserControl>
