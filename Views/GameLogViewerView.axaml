<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EveConsole.Localization"
             xmlns:vm="clr-namespace:EveConsole.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="EveConsole.Views.GameLogViewerView"
             x:DataType="vm:GameLogViewerViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="FontSize"   Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding"    Value="6 5 2 5" />
    </Style>
    <Style Selector="TextBlock.fl">
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelAltBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,2*,4,1*">

    <Border Grid.Row="0" Background="{DynamicResource SurfaceBaseBrush}" Padding="10 6" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0 0 0 1">
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{x:Static loc:DataText.GameLog}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="fl" Text="{x:Static loc:DataText.From}" />
          <TextBox Text="{Binding DateFrom}" Watermark="yyyy-MM-dd" Width="120" />
          <TextBlock Classes="fl" Text="{x:Static loc:DataText.Thru}" />
          <TextBox Text="{Binding DateThru}" Watermark="{x:Static loc:DataText.HintNow}" Width="120" />
          <TextBlock Classes="fl" Text="{x:Static loc:DataText.Type}" />
          <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                    Width="200" FontSize="11" MaxDropDownHeight="320" />
          <TextBlock Classes="fl" Text="{x:Static loc:DataText.Find}" />
          <TextBox Text="{Binding Search}" Watermark="{x:Static loc:DataText.HintNameOrText}" Width="170" />
          <Button Command="{Binding RefreshCommand}" Content="{x:Static loc:DataText.Refresh}" FontSize="10" Padding="8 2"
                  Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                  VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24"
              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
              Background="{DynamicResource SurfaceBaseBrush}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static loc:DataText.ColTime}"      Binding="{Binding Time}"      Width="145" />
        <DataGridTextColumn Header="{x:Static loc:DataText.ColType}"      Binding="{Binding Kind}"      Width="180" />
        <DataGridTextColumn Header="{x:Static loc:DataText.ColCharacter}" Binding="{Binding Character}" Width="140" />
        <DataGridTextColumn Header="{x:Static loc:DataText.ColAmount}"    Binding="{Binding Amount}"    Width="90"  />
        <DataGridTextColumn Header="{x:Static loc:DataText.ColSource}"    Binding="{Binding Source}"    Width="180" />
        <DataGridTextColumn Header="{x:Static loc:DataText.ColTarget}"    Binding="{Binding Target}"    Width="180" />
        <DataGridTextColumn Header="{x:Static loc:DataText.ColDetail}"    Binding="{Binding Summary}"   Width="*"   />
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" Background="{DynamicResource BorderSubtleBrush}" />

    <Border Grid.Row="3" Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0">
      <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <SelectableTextBlock Text="{Binding Selected.Detail}" Margin="12 8" FontSize="12"
                               Foreground="{DynamicResource GoodBrush}" FontFamily="Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace"
                               TextWrapping="Wrap" />
        </ScrollViewer>
        <TextBlock Text="{x:Static loc:DataText.SelectAnEntryToNote}"
                   IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNull}}"
                   FontSize="12" Foreground="{DynamicResource BorderStrongBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </Border>

  </Grid>
</UserControl>
