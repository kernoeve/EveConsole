<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EveCortex.Views"
        xmlns:vm="clr-namespace:EveCortex.ViewModels"
        x:Class="EveCortex.Views.IndustryBrowserWindow"
        x:DataType="vm:IndustryBrowserViewModel"
        Title="Industry Jobs"
        Width="1500" Height="850"
        MinWidth="900" MinHeight="580"
        Background="#0d0d12">
  <views:IndustryBrowserView DataContext="{Binding}" />
</Window>
