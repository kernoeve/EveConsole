# Copy to .env beside docker-compose.yml and fill in. ⚠️ .env holds the database password: keep
# it out of version control and readable by you alone.

# The PostgreSQL password, for the server and the worker both. Desktop clients sign in with
# user "eveconsole" and this.
POSTGRES_PASSWORD=

# The port desktop clients connect to on this machine.
POSTGRES_PORT=5432

# The EVE Console release to run, without the leading v: the one your desktop clients run.
# "latest" follows the newest release each time the image is rebuilt.
EVECONSOLE_VERSION=latest

# Time zone for the worker's log timestamps.
TZ=UTC
