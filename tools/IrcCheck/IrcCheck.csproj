<Project Sdk="Microsoft.NET.Sdk">

  <!-- The IRC client's rules, against a scripted server in this process: no network, no real server. What a real
       server does was tried by hand against a throwaway local one. Excluded from the app by its tools/** removal. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EveConsole.Tools.IrcCheck</RootNamespace>
    <AssemblyName>IrcCheck</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EveConsole.csproj" />
  </ItemGroup>

</Project>
