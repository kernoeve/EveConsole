<Project Sdk="Microsoft.NET.Sdk">

  <!-- Excluded from the app: EveConsole.csproj sits at the repo root and globs **/*.cs, and the
       <Compile Remove="tools/**" /> there keeps this out of the shipped application.
       No reference to the app: this reads the .resx and .axaml files as XML, so it builds in
       seconds and runs before anything else would. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EveConsole.Tools.LocCheck</RootNamespace>
    <AssemblyName>LocCheck</AssemblyName>
  </PropertyGroup>

</Project>
