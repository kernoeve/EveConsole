<Project Sdk="Microsoft.NET.Sdk">

  <!-- Excluded from the app: EveConsole.csproj sits at the repo root and globs **/*.cs, and the
       <Compile Remove="tools/**" /> there keeps this out of the shipped application. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EveConsole.Tools.PiEngineCheck</RootNamespace>
    <AssemblyName>PiEngineCheck</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EveConsole.csproj" />
  </ItemGroup>

</Project>
