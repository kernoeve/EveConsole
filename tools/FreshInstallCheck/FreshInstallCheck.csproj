<Project Sdk="Microsoft.NET.Sdk">

  <!-- Excluded from the app: EveConsole.csproj sits at the repo root and globs **/*.cs, so
       without the matching <Compile Remove="tools/**" /> there this file's code would be
       compiled into the shipped application. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EveConsole.Tools.FreshInstallCheck</RootNamespace>
    <AssemblyName>FreshInstallCheck</AssemblyName>
    <!-- The app targets Windows; referencing it drags the platform check along. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EveConsole.csproj" />
  </ItemGroup>

</Project>
