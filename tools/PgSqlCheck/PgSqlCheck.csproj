<Project Sdk="Microsoft.NET.Sdk">

  <!-- Excluded from the app: EveConsole.csproj sits at the repo root and globs **/*.cs, and
       removes tools/** for exactly this reason. No project reference either — this checker reads
       source as text and talks to PostgreSQL, so it stays runnable even when the app does not
       build, which is when you most want to know whether the SQL is sound. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EveConsole.Tools.PgSqlCheck</RootNamespace>
    <AssemblyName>PgSqlCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.2" />
  </ItemGroup>

</Project>
